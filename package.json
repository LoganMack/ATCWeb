    "prettier": "^3.3.3",
    "prettier-plugin-astro": "^0.14.1",
    "prettier-plugin-tailwindcss": "^0.6.8",
    "supabase": "2.120.0",
    "typescript": "^5.6.3",
    "typescript-eslint": "8.72.0",
