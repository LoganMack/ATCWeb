{
  // Cloudflare deploys Git-connected projects via `wrangler deploy` rather
  // than the old Pages-specific bundler, so it needs this file to know
  // where the built worker + static assets are.
  //
  // "name" must match the Worker name Cloudflare's CI expects for this
  // project (shown in its "Failed to match Worker name" warning if wrong —
  // check your Cloudflare dashboard project name if you renamed it).
  "name": "alphatouringchallenge-web",
  // A small wrapper (src/worker/entry.ts) around the built Astro handler in dist/_worker.js/index.js: it
  // passes every request through unchanged and adds the scheduled handler for the email notifications.
  // Wrangler bundles it after `astro build`.
  "main": "./src/worker/entry.ts",
  "compatibility_date": "2026-07-22",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist",
  },
  "observability": {
    "enabled": true,
  },
  // Email notifications: every 15 minutes the Worker queues due reminders and sends one batch through
  // Resend (src/lib/notifications/run.ts). Removing this line stops the runs.
  "triggers": {
    "crons": ["*/15 * * * *"],
  },
  // NOTE on Error 1102 ("Worker exceeded resource limits"): tried setting
  // limits.cpu_ms here to raise the per-request CPU budget above the
  // platform default, but Cloudflare's deploy API rejects it outright on
  // the Workers FREE plan ("CPU limits are not supported for the Free
  // plan", code 100328) — this account is confirmed on Free, which is
  // hard-capped at 10ms CPU per request with no way to raise it from
  // config. That makes the actual fix code-side only: reduce how much work
  // each request does (see standings.astro/team-standings.astro sharing
  // one getSeasonOverallContext() build across their several calls instead
  // of rebuilding it 2-3x per request) rather than asking for a bigger
  // budget. Upgrading to Workers Paid ($5/mo) would also raise this to
  // 50ms default / up to 30000ms configurable, if the 10ms ceiling turns
  // out to still be too tight after the code-side fixes.
  //
  // Found the real bug: once a "vars" block exists here at all, Wrangler
  // treats it as the *complete* set of runtime vars for the Worker and
  // silently drops anything set only in the dashboard that isn't also
  // listed here — that's what was actually eating PUBLIC_SUPABASE_ANON_KEY
  // on every deploy (confirmed by it vanishing from the "Your Worker has
  // access to the following bindings" list in the deploy log), regardless
  // of whether it was typed as Secret or Text on the dashboard side.
  //
  // All four of these are safe to commit: three are just public URLs, and
  // a Supabase *anon* key is specifically designed to be public/client-side
  // — it's not a secret, it's meant to sit in the shipped JS bundle, and
  // access is controlled by the Row Level Security policies in
  // supabase/migrations/0001_init.sql, not by keeping this value hidden.
  //
  // The four EMAIL_*/SITE_URL vars are not secrets either. RESEND_API_KEY is a Cloudflare secret, never
  // listed here; without it the runs send nothing. EMAIL_FROM is part of every batch's idempotent body, so
  // do not change it while emails are queued or sending (the admin home shows the queue). EMAIL_DAILY_CAP
  // matches the Resend plan (free tier: 100 a day); EMAIL_BATCH_SIZE (1-100) is lowered if runs near the CPU
  // limit.
  "vars": {
    "PUBLIC_DISCORD_URL": "https://discord.com/invite/TXa3nnUYzJ",
    "PUBLIC_REDBUBBLE_URL": "https://www.redbubble.com/people/Bot14/shop?asc=u",
    "PUBLIC_SUPABASE_URL": "https://hqatqfftlmqmjtusyfhz.supabase.co",
    "PUBLIC_SUPABASE_ANON_KEY": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImhxYXRxZmZ0bG1xbWp0dXN5Zmh6Iiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODQ3NDE3NTAsImV4cCI6MjEwMDMxNzc1MH0.os87u33v-ufzEgBerqmdbCA8TMddnu0jtzqRwlXwg3s",
    "EMAIL_FROM": "Alpha Touring Challenge <noreply@alphatouringchallenge.com>",
    "EMAIL_DAILY_CAP": "100",
    "EMAIL_BATCH_SIZE": "50",
    "SITE_URL": "https://alphatouringchallenge.com",
  },
}
