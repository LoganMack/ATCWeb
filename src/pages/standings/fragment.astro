                                <tr
                                  data-round-col={f.colIndex}
                                  class={`border-b border-white/5 text-xs last:border-b-0 ${f.entry.counted ? '' : 'opacity-40'}`}
                                  title={f.entry.counted ? undefined : "Didn't count toward the team's score (not one of its top 2 scorers that race)"}
                                >
                                  <td class="py-2 pl-3 pr-3 text-white/80">
                                    <span class="font-semibold">R{f.col.roundNumber ?? '?'}{f.raceTag}</span>
                                    <span class="ml-1.5 text-white/50">{f.col.trackName}</span>
                                  </td>
                                  <td class="py-2 pr-3 font-display text-base leading-none text-white/70">{f.entry.dsq ? 'DSQ' : (f.entry.position ?? '—')}</td>
                                  <td class="py-2 pr-3 font-semibold">
                                    <span class="flex items-center gap-1.5 whitespace-nowrap">
                                      {driver && <DriverFlag nationality1={driver.nationality_1} nationality2={driver.nationality_2} />}
                                      {driver ? <DriverLink id={driver.id} hidden={driver.is_hidden}>{displayDriverName(driver.name)}</DriverLink> : <span>Unknown driver</span>}
                                      {driver && driver.car_number !== null && <span class="text-white/40">#{driver.car_number}</span>}
                                    </span>
                                  </td>
                                  {teamShowClass && (
                                    <td class="hidden py-2 pr-3 sm:table-cell">
                                      <span class={classTagFull(className ?? '')}>{className ?? '—'}</span>
                                    </td>
                                  )}
                                  <td class="hidden py-2 pr-3 text-center text-white/60 sm:table-cell">{f.entry.startingPosition ?? '—'}</td>
                                  <td class="hidden py-2 pr-3 text-center text-white/60 sm:table-cell">{f.entry.incidents ?? '—'}</td>
                                  <td class="hidden py-2 pr-3 text-center text-white/60 md:table-cell">{f.entry.laps ?? '—'}</td>
                                  <td class="hidden py-2 pr-3 text-center text-white/60 lg:table-cell">{f.entry.lapsLed ?? 0}</td>
                                  <td class="hidden py-2 pr-3 text-center text-white/60 lg:table-cell">{formatLapTime(f.entry.bestLapTenThousandths !== null ? f.entry.bestLapTenThousandths / 10000 : null)}</td>
                                  <td class="py-2 pr-3 text-center font-semibold">{f.entry.points}</td>
                                </tr>
                              );
                            })}
                          </tbody>
                        </table>
                      </div>
                    );
                  })()}
                </td>
              </tr>
              </>
              );
            })}
          </tbody>
        </table>
      </div>
      <div class="mt-3 flex justify-end">
        <button
          type="button"
          data-csv-export="standings-table"
          data-csv-filename={csvFilenameBase}
          class="btn btn-neutral btn-sm inline-block self-start"
        >
          Export CSV
        </button>
      </div>
    )}

    {!loadError && !deltaNotActiveForSeason && championship === 'teams' && mode === 'matrix' && teamStandings.length > 0 && (
      <div class="mt-8 rounded-xl border border-white/10" data-sticky-thead>
        <table id="standings-table" class="w-full border-collapse text-sm" data-kind="teams" data-drop-weeks="0" data-min-drop-rounds={MIN_ROUNDS_FOR_DROPS} data-can-drop-final={String(matrixCanDropFinalRound)} data-driver-drop-weeks={driverDropWeeks}>
          <thead>
            <tr class="border-b border-white/10 text-left text-xs uppercase tracking-wide text-white/40">
              <th class="py-3 pl-4 pr-3 font-medium">Pos</th>
              <th class="py-3 pr-4 font-medium">Team</th>
              {matrixColumns.map((col, i) => (
                <th
                  class="px-2 py-3 text-center font-medium"
                  data-round-col={i}
                  data-csv-value={`R${col.roundNumber ?? '?'}`}
                  title={`Round ${col.roundNumber ?? '?'} — ${matrixColumnTitle(col.trackName, col.format)}`}
                >
                  <span class="inline-flex items-center justify-center">
                    <TeamLogo name={col.trackName} logoUrl={matrixLogoBySubsession.get(col.subsessionId) ?? null} size="h-7 w-7" title={`Round ${col.roundNumber ?? '?'} — ${matrixColumnTitle(col.trackName, col.format)}`} logoBg={matrixLogoBgBySubsession.get(col.subsessionId) ?? null} />
                  </span>
                </th>
              ))}
              <th class="px-3 py-3 text-center font-medium">Total</th>
            </tr>
          </thead>
          <tbody>
            {teamStandings.map((row, rowIndex) => (
              <tr
                class="border-b border-white/5"
                data-standings-row
                data-orig-index={rowIndex}
                data-orig-total={row.totalPoints}
                data-name={row.teamName}
                data-rounds={teamRoundsJson(row)}
              >
                <td class="py-2.5 pl-4 pr-3 font-display text-lg leading-none text-white/70" data-live="pos">{row.position}</td>
                <td class="py-2.5 pr-4 font-semibold" data-csv-value={row.teamName}>
                  <span class="flex items-center gap-2 whitespace-nowrap">
                    <TeamLogo name={row.teamName} logoUrl={row.logoUrl} size="h-5 w-5" />
                    {row.teamName}
                  </span>
                </td>
                {matrixColumns.map((col, i) => {
                  const cell = row.roundCells.get(col.subsessionId);
                  return (
                    <td class="relative px-2 py-2.5 text-center" data-round-col={i}>
                      {cell ? (
                        <span data-cell-points data-orig-dropped="false" class="text-white/80" title={`${cell.points} pts`}>
                          {cell.points}
                        </span>
                      ) : (
                        <span class="text-white/20">—</span>
                      )}
                      {cell && cell.penalties.length > 0 && (
                        <span
                          class="absolute right-1 top-1 text-[8px] leading-none text-brand-pink"
                          aria-hidden="false"
                          role="img"
                          title={cell.penalties.join('\n')}
                        >
                          ●
                        </span>
                      )}
                    </td>
                  );
                })}
                <td class="px-3 py-2.5 text-center font-semibold text-white/90" data-live="total">{row.totalPoints}</td>
              </tr>
            ))}
          </tbody>
        </table>
        <p class="border-t border-white/10 px-4 py-3 text-xs text-white/40">
          Hover a round's logo for the circuit and format. Teams don't drop rounds — every round scored counts toward the total.
          <span class="text-brand-pink">●</span> marks a round with a penalty logged against a driver who raced for that team this season — hover it
          for details.
        </p>
      </div>
      <div class="mt-3 flex justify-end">
        <button
          type="button"
          data-csv-export="standings-table"
          data-csv-filename={csvFilenameBase}
          class="btn btn-neutral btn-sm inline-block self-start"
        >
          Export CSV
        </button>
      </div>
    )}
