---
export const prerender = false;

import { safeJson, markUncacheable } from '../../lib/security';
import LoadError from '../../components/LoadError.astro';
import CarLogos from '../../components/CarLogos.astro';
import TeamLogo from '../../components/TeamLogo.astro';
import DriverFlag from '../../components/DriverFlag.astro';
import DriverLink from '../../components/DriverLink.astro';
import { seasonOptionAttrs } from '../../lib/seasonSelect';
import { resolveSupabaseEnv } from '../../lib/db/client';
import { getDriverClasses } from '../../lib/db/lookups';
import { getSeasons, getScoringRulesets, resolveSeasonRuleset } from '../../lib/db/seasons';
import { getStandingsExcludedRoundIds } from '../../lib/db/rounds';
import {
  displayDriverName,
  shortDriverName,
  getCircuits,
  getAllCircuitLayouts,
  getCircuitLogoBackgrounds,
  type LogoBackground,
  formatLapTime,
  type Circuit,
  type CircuitLayout,
} from '../../lib/db/circuits';
import { getCarLogos } from '../../lib/db/assets';
import { computeOverallSeasonStandings } from '../../lib/results/standings';
import { computeTeamSeasonStandings, type TeamSeasonStanding } from '../../lib/results/teamStandings';
import {
  computeSeasonStandingsRoundColumns,
  BASELINE_DROP_WEEKS,
  seasonDropWeeks,
  MIN_ROUNDS_FOR_DROPS,
  type DriverSeasonStanding,
  type SeasonStandingsRoundColumn,
} from '../../lib/results/standingsCore';
import { computeDisplayRoundNumbers } from '../../lib/results/rounds';
import { normalizeTrackOrLayoutName } from '../../lib/results/layouts';
import type { DriverSeasonExtras } from '../../lib/results/seasonCarTeam';
import type { DriverSeasonExtendedStats } from '../../lib/results/extendedStats';
import { getSeasonOverallContext } from '../../lib/results/seasonContext';
import { driversSelect, getTeamsBasic, getAllTeamSeasonLogosSafe } from '../../lib/results/rows';
import { loadDriverStandingsView, type StandingsViewRefs } from '../../lib/results/standingsView';
import { isChampionshipSeason } from '../../lib/results/shared';
import { formatDistanceKm } from '../../lib/results/format';
import { classTagFull } from '../../lib/classColors';
import { slugify } from '../../lib/slug';

const supabaseEnv = resolveSupabaseEnv(Astro.locals);
const championshipParam: 'drivers' | 'teams' = Astro.url.searchParams.get('championship') === 'teams' ? 'teams' : 'drivers';

// Stage 1: the filters and every reference read the views below use, in parallel (BR4.2). Circuits, layouts
// and logo backgrounds only decorate (track logos, km and corners), so their failure is logged, not fatal.
function optional<T>(what: string, fallback: T) {
  return (err: unknown) => {
    console.error(`Failed to load ${what} for standings:`, err);
    return fallback;
  };
}
let classes: Awaited<ReturnType<typeof getDriverClasses>> = [];
let seasons: Awaited<ReturnType<typeof getSeasons>> = [];
let viewRefs: StandingsViewRefs | null = null;
let headerCircuits: Circuit[] = [];
let headerLogoBackgrounds: Record<string, LogoBackground> = {};
let loadError: string | null = null;
try {
  const forDrivers = championshipParam === 'drivers';
  const [classList, seasonList, drivers, excludedIds, rulesets, circuits, layouts, logoBackgrounds, teams, carLogos, seasonLogoRows] =
    await Promise.all([
      getDriverClasses(supabaseEnv),
      getSeasons(supabaseEnv),
      driversSelect(supabaseEnv),
      getStandingsExcludedRoundIds(supabaseEnv),
      getScoringRulesets(supabaseEnv),
      getCircuits(supabaseEnv).catch(optional('circuits', [] as Circuit[])),
      forDrivers ? getAllCircuitLayouts(supabaseEnv).catch(optional('circuit layouts', [] as CircuitLayout[])) : Promise.resolve([]),
      getCircuitLogoBackgrounds(supabaseEnv).catch(optional('circuit logo backgrounds', {} as Record<string, LogoBackground>)),
      forDrivers ? getTeamsBasic(supabaseEnv) : Promise.resolve([]),
      forDrivers ? getCarLogos(supabaseEnv) : Promise.resolve([]),
      forDrivers ? getAllTeamSeasonLogosSafe(supabaseEnv) : Promise.resolve([]),
    ]);
  classes = classList;
  seasons = seasonList;
  headerCircuits = circuits;
  headerLogoBackgrounds = logoBackgrounds;
  viewRefs = { classes, drivers, excludedIds, rulesets, teams, carLogos, seasonLogoRows, circuits, layouts };
} catch (err) {
  console.error('Failed to load standings page filters:', err);
  loadError = err instanceof Error ? err.message : String(err);
}

// Exhibition seasons never have standings (computeSeasonStandings returns
// [] for them — see isChampionshipSeason), so the picker only offers real
// championship seasons in the first place.
const championshipSeasons = seasons.filter((s) => isChampionshipSeason(s.name));

const requestedSeasonNumber = Astro.url.searchParams.get('season');
const activeSeason =
  championshipSeasons.find((s) => String(s.number) === requestedSeasonNumber) ??
  championshipSeasons.find((s) => s.is_current) ??
  championshipSeasons[0];

// Only classes that raced in the active season (0037); Alpha is always there.
const classesForActiveSeason = classes.filter(
  (c) => (c.name !== 'Gamma' || activeSeason?.gamma_enabled) && (c.name !== 'Delta' || activeSeason?.delta_enabled)
);

// Championship dropdown: Drivers (default) or Teams — the old separate Team
// Standings tab now lives here (/team-standings just redirects).
const championship = championshipParam;

// Class dropdown: "All" (every class combined — the old Overall view) or one
// class (the old Per Class view). Old links still work: `?view=class` with
// no/unknown class falls back to Alpha like before, `?view=overall` is
// always All.
const requestedClassName = Astro.url.searchParams.get('class');
const legacyView = Astro.url.searchParams.get('view');
const driverActiveClass =
  legacyView === 'overall' || (requestedClassName === 'all') || (!requestedClassName && legacyView !== 'class')
    ? undefined
    : (classesForActiveSeason.find((c) => c.name === requestedClassName) ??
      classesForActiveSeason.find((c) => c.name === 'Alpha') ??
      classesForActiveSeason[0]);

const activeClass = championship === 'drivers' ? driverActiveClass : undefined;
// Teams: "All" = the overall team championship, "Delta" = the separate Delta
// Team championship (see computeTeamSeasonStandings). Old `?view=delta` links
// land here via the /team-standings redirect.
const teamView: 'overall' | 'delta' = requestedClassName === 'Delta' || (!requestedClassName && legacyView === 'delta') ? 'delta' : 'overall';

const classNameById = new Map(classes.map((c) => [c.id, c.name]));

// "overall" = All classes combined (see computeOverallSeasonStandings);
// "class" = one class's own standings.
const view: 'overall' | 'class' = activeClass ? 'class' : 'overall';

// "List" (existing table, default) vs "Matrix" (drivers down the left, one
// column per round across the top, penalty/drop flags on each cell — see
// DriverSeasonStanding.roundCells), same URL-param pattern as before.
const requestedMode = Astro.url.searchParams.get('mode');
const mode: 'list' | 'matrix' | 'graph' = requestedMode === 'matrix' ? 'matrix' : requestedMode === 'graph' ? 'graph' : 'list';

let standings: DriverSeasonStanding[] = [];
let teamStandings: TeamSeasonStanding[] = [];
// Keyed by driver id — looks up the driver behind each finish in a team row's
// expanded results table (always the cross-class overall standing, whichever
// team view is showing).
let overallStandingByDriverId = new Map<string, DriverSeasonStanding>();
let extrasByDriverId: Map<string, DriverSeasonExtras> = new Map();
let extendedStatsByDriverId: Map<string, DriverSeasonExtendedStats> = new Map();
let matrixColumns: SeasonStandingsRoundColumn[] = [];
const matrixLogoBySubsession = new Map<number, string | null>();
const matrixLogoBgBySubsession = new Map<number, LogoBackground>();
// Timeline Slider inputs (see the script at the bottom): the drop rules the
// real standings use, so the client can recompute "as of round N" totals the
// same way finalizeStandings does.
let matrixDropWeeks = BASELINE_DROP_WEEKS;
let matrixCanDropFinalRound = false;
// "Standings by Round" slider inputs (both List and Matrix): per-column
// denominators for the "x of y" Starts/Apps cells.
let colDenoms: { s: number; a: number }[] = [];
// Season-wide denominators for Starts/Apps ("x of y"), the same for every driver and view: starts are races
// run, appearances are rounds run, excluding exhibitions.
let maxStarts = 0;
// Car and team slots for the List view's driver cell, as many as the busiest driver needs, so every row's
// logos line up.
let maxTeamSlots = 1;
let maxAppearances = 0;
if (!loadError && viewRefs && activeSeason && championship === 'drivers') {
  try {
    // Stages 2 and 3: the season's stored round stats (live path if incomplete), then the penalty summaries.
    const driverView = await loadDriverStandingsView(supabaseEnv, activeSeason, view === 'class' && activeClass ? activeClass.id : undefined, viewRefs);
    standings = driverView.standings;
    extrasByDriverId = driverView.extras;
    for (const e of driverView.extras.values()) {
      maxTeamSlots = Math.max(maxTeamSlots, e.teams.length);
    }
    extendedStatsByDriverId = driverView.extendedStats;
    // Matrix columns: every round this view raced, in order, headed by the round number (Logan: keep them
    // narrow). "x of y" denominators: races and rounds the whole season (every class) had run.
    matrixColumns = driverView.matrixColumns;
    colDenoms = driverView.colDenoms;
    maxAppearances = driverView.maxAppearances;
    maxStarts = driverView.maxStarts;
  } catch (err) {
    console.error('Failed to compute standings:', err);
    loadError = err instanceof Error ? err.message : String(err);
  }
}

// Delta Team championship didn't start until ATC10 (see
// 0052_delta_team_enabled.sql) — skipped entirely for an out-of-range season
// so the template can show a specific explanation instead of a bare "No results."
const deltaNotActiveForSeason = championship === 'teams' && teamView === 'delta' && activeSeason ? !activeSeason.delta_team_enabled : false;

if (!loadError && viewRefs && activeSeason && championship === 'teams' && !deltaNotActiveForSeason) {
  try {
    // The Teams view keeps the live per-race path: its expanded rows list every finish.
    const { drivers: driversBasic, excludedIds: exhibitionRoundIds } = viewRefs;
    const deltaClassId = teamView === 'delta' ? classes.find((c) => c.name === 'Delta')?.id : undefined;
    // Built once and shared with both calls (see the driver branch above for why).
    const overallContext = await getSeasonOverallContext(supabaseEnv, activeSeason, exhibitionRoundIds, driversBasic);
    const [teamResult, overallStandings] = await Promise.all([
      computeTeamSeasonStandings(supabaseEnv, activeSeason, exhibitionRoundIds, deltaClassId, driversBasic, undefined, undefined, classes, overallContext),
      computeOverallSeasonStandings(supabaseEnv, activeSeason, driversBasic, exhibitionRoundIds, overallContext, viewRefs.rulesets),
    ]);
    teamStandings = teamResult;
    overallStandingByDriverId = new Map(overallStandings.map((s) => [s.driver.id, s]));

    const matrixSubsessionIds = new Set(
      (teamView === 'delta' && deltaClassId !== undefined
        ? overallContext.overallScores.filter((s) => s.class_id === deltaClassId)
        : overallContext.overallScores
      ).map((s) => s.subsession_id)
    );
    const displayRoundNumbers = computeDisplayRoundNumbers(overallContext.seasonRounds, exhibitionRoundIds, new Set());
    matrixColumns = computeSeasonStandingsRoundColumns(overallContext.seasonRounds, matrixSubsessionIds, displayRoundNumbers);
  } catch (err) {
    console.error('Failed to compute team standings:', err);
    loadError = err instanceof Error ? err.message : String(err);
  }
}

// Matrix-only extras shared by both championships: the drop rules the
// Timeline Slider needs (teams never drop rounds), and a track logo for each
// column header — matched to a circuit by track name, same normalisation the
// rest of the site uses; a track with no logo falls back to an initials tile.
let driverDropWeeks = activeSeason ? BASELINE_DROP_WEEKS + (activeSeason.extra_drop_weeks ?? 0) : BASELINE_DROP_WEEKS;
if (!loadError && viewRefs && activeSeason && matrixColumns.length > 0) {
  // Base drop weeks come from the season's ruleset (rules.drops.base), plus the season's extra_drop_weeks.
  matrixCanDropFinalRound = resolveSeasonRuleset(activeSeason, viewRefs.rulesets)?.can_drop_final_round ?? false;
  driverDropWeeks = seasonDropWeeks(activeSeason, viewRefs.rulesets);
  matrixDropWeeks = championship === 'drivers' ? driverDropWeeks : 0;
}
// Matrix headers, plus the round strips in the driver and team rows' expanded details (List view).
if (!loadError && activeSeason && mode !== 'graph' && matrixColumns.length > 0) {
  const circuitByName = new Map<string, Circuit>(headerCircuits.map((c) => [normalizeTrackOrLayoutName(c.name), c]));
  for (const col of matrixColumns) {
    const circuit = circuitByName.get(normalizeTrackOrLayoutName(col.trackName));
    matrixLogoBySubsession.set(col.subsessionId, circuit?.logo_url ?? null);
    const bg = circuit ? headerLogoBackgrounds[circuit.id] : undefined;
    if (bg) matrixLogoBgBySubsession.set(col.subsessionId, bg);
  }
}

// ---- "Standings by Round" slider ----
// The slider's value is "show the first N rounds"; it's carried across
// dropdown changes in the `round` URL param as a round NUMBER (so it survives
// switching to a class that raced a different set of rounds). No param, or a
// round at/after the latest one, means all rounds.
const sliderCols = matrixColumns.map((c) => ({ r: c.roundNumber, t: c.startTime }));
const requestedRound = Number(Astro.url.searchParams.get('round'));
const sliderValue =
  Number.isFinite(requestedRound) && requestedRound > 0 && matrixColumns.length > 0
    ? Math.max(1, matrixColumns.filter((c) => (c.roundNumber ?? 0) <= requestedRound).length)
    : matrixColumns.length;

/** One driver's per-column data for the client: null for a round they skipped, else [points, wins, podiums, top5s, top10s, poles, starts, laps-led, laps, detail-laps, detail-led, net positions, incidents, bonus, distance km|null, corners|null]. */
function driverRoundsJson(row: DriverSeasonStanding): string {
  const ext = extendedStatsByDriverId.get(row.driver.id);
  return JSON.stringify(
    matrixColumns.map((col) => {
      const cell = row.roundCells.get(col.subsessionId);
      if (!cell) return null;
      const st = row.roundStats.get(col.subsessionId);
      const ex = ext?.byRound.get(col.subsessionId);
      return [
        cell.points,
        st?.wins ?? 0,
        st?.podiums ?? 0,
        st?.top5s ?? 0,
        st?.top10s ?? 0,
        st?.poles ?? 0,
        st?.starts ?? 0,
        st?.lapsLed ?? 0,
        st?.laps ?? 0,
        ex?.laps ?? 0,
        ex?.lapsLed ?? 0,
        ex?.netPositionsChange ?? 0,
        ex?.incidents ?? 0,
        ex?.bonusPoints ?? 0,
        ex && ex.km !== null ? ex.laps * ex.km : null,
        ex && ex.corners !== null ? ex.laps * ex.corners : null,
      ];
    })
  );
}
function driverPenaltyJson(row: DriverSeasonStanding): string {
  const ext = extendedStatsByDriverId.get(row.driver.id);
  return JSON.stringify(matrixColumns.map((col) => ext?.byRound.get(col.subsessionId)?.penaltyPoints ?? 0));
}
// Team rows' expanded results table: every finish by the team's drivers,
// newest round first (then race, then points), each tied to its round's column
// so the Standings by Round slider can hide rounds that haven't happened yet.
const matrixColIndexBySubsession = new Map(matrixColumns.map((c, i) => [c.subsessionId, i]));
// The Delta team competition is scored within one class, so its table has no Class column.
const teamShowClass = teamView !== 'delta';
function teamFinishRows(row: TeamSeasonStanding) {
  const racesPerRound = new Map<number, Set<number>>();
  for (const e of row.raceEntries) {
    if (!racesPerRound.has(e.subsessionId)) racesPerRound.set(e.subsessionId, new Set());
    racesPerRound.get(e.subsessionId)!.add(e.raceNumber);
  }
  return row.raceEntries
    .map((entry) => {
      const colIndex = matrixColIndexBySubsession.get(entry.subsessionId);
      return colIndex === undefined
        ? null
        : { entry, colIndex, col: matrixColumns[colIndex], raceTag: (racesPerRound.get(entry.subsessionId)?.size ?? 1) > 1 ? ` · Race ${entry.raceNumber}` : '' };
    })
    .filter((f): f is NonNullable<typeof f> => f !== null)
    .sort((a, b) => b.colIndex - a.colIndex || a.entry.raceNumber - b.entry.raceNumber || b.entry.points - a.entry.points);
}

function teamRoundsJson(row: TeamSeasonStanding): string {
  return JSON.stringify(
    matrixColumns.map((col) => {
      const cell = row.roundCells.get(col.subsessionId);
      return cell ? [cell.points, row.roundStarts.get(col.subsessionId) ?? 0] : null;
    })
  );
}

// Graph view data: running (cumulative) points per driver/team across the
// visible rounds, in standings order — which is also each entity's fixed colour
// slot (the first 8 get a named hue; the rest are muted grey lines).
const graphSeries = (
  championship === 'drivers'
    ? standings.map((row) => ({
        id: row.driver.id,
        // Graph view shows drivers as "F. Lastname" everywhere (legend, tooltip, end labels) to save space; the full name is kept for hover titles.
        name: shortDriverName(row.driver.name),
        full: displayDriverName(row.driver.name),
        short: shortDriverName(row.driver.name),
        tag: row.classId !== undefined ? (classNameById.get(row.classId) ?? '') : '',
        logo: '',
        cells: row.roundCells,
      }))
    : teamStandings.map((row) => ({ id: row.teamId, name: row.teamName, full: row.teamName, short: row.teamName, tag: '', logo: row.logoUrl ?? '', cells: row.roundCells }))
).map((e) => {
  let run = 0;
  let started = false;
  const cum = matrixColumns.map((col) => {
    const cell = e.cells.get(col.subsessionId);
    if (cell) {
      run += cell.points;
      started = true;
    }
    return started ? run : null;
  });
  // Per-round points (null = didn't race that round), for the Drop Weeks checkbox, which re-totals each point with the worst rounds dropped.
  const pts = matrixColumns.map((col) => e.cells.get(col.subsessionId)?.points ?? null);
  return { id: e.id, name: e.name, full: e.full, short: e.short, tag: e.tag, logo: e.logo, cum, pts };
});
const graphJson = JSON.stringify({
  cols: matrixColumns.map((c) => ({ r: c.roundNumber, t: c.startTime, k: matrixColumnTitle(c.trackName, c.format) })),
  series: graphSeries,
  // Same drop rules the List/Matrix totals use (see totalAsOf in src/lib/seasonTotals.ts): drivers drop their worst N rounds once the season has run MIN_ROUNDS_FOR_DROPS rounds; teams never drop.
  drops: championship === 'drivers' ? driverDropWeeks : 0,
  minDropRounds: MIN_ROUNDS_FOR_DROPS,
  canDropFinal: matrixCanDropFinalRound,
});

// The CSV filename names the season, class and view, so exports don't overwrite each other.
const csvFilenameBase = slugify(
  championship === 'teams'
    ? `team standings ${activeSeason?.name ?? ''} ${teamView} ${mode}`
    : `standings ${activeSeason?.name ?? ''} ${view === 'class' && activeClass ? activeClass.name : 'overall'} ${mode}`
);

function raceWord(n: number): string {
  return `${n} race${n === 1 ? '' : 's'}`;
}

// Matrix column header's hover tooltip — "Track Name — Sprint"/"Track Name
// — Endurance", or just the track name when the round has no format on
// file yet.
function matrixColumnTitle(trackName: string, format: 'endurance' | 'sprint' | null): string {
  if (!format) return trackName;
  return `${trackName} — ${format.charAt(0).toUpperCase()}${format.slice(1)}`;
}

Astro.response.headers.set('Cache-Control', 'public, s-maxage=60, stale-while-revalidate=300');
if (loadError) markUncacheable(Astro);
---

    <div class="mt-8"></div>

    {loadError && <LoadError />}

    {!loadError && (
      <div class="relative z-30 mt-8 rounded-xl border border-white/10 bg-brand-ink p-4">
        <form method="GET" class="flex flex-wrap items-end justify-between gap-x-4 gap-y-4">
          {/* Carries the Standings by Round slider across dropdown changes (the slider keeps this up to date; the Season dropdown disables it so a new season starts at all rounds). */}
          <input type="hidden" name="round" id="timeline-round" value={sliderCols[sliderValue - 1]?.r ?? ''} disabled={sliderValue >= matrixColumns.length} />
          <label class="flex flex-col gap-1.5">
            <span class="text-xs font-semibold uppercase tracking-wide text-white/40">Season</span>
            <select
              name="season"
              data-logo-select
              data-submit-on-change data-disable-on-submit="round"
              class="w-44 h-9 rounded-md border border-white/15 bg-transparent px-3 text-sm text-white outline-none hover:bg-white/5 focus:border-brand-primary focus:bg-white/5"
            >
              {championshipSeasons.map((s) => (
                <option value={s.number} selected={s.id === activeSeason?.id} {...seasonOptionAttrs(s)} class="bg-brand-ink text-white">{s.name}</option>
              ))}
            </select>
          </label>
          <div class="flex flex-wrap items-end gap-4 sm:ml-auto">
            {matrixColumns.length > 1 && (
              <div class="group relative hidden flex-col gap-1.5 sm:flex">
                <span class="text-xs font-semibold uppercase tracking-wide text-white/40">Standings by Round</span>
                {/* Ticks + hover-only round tag (styles: .round-slider in global.css). The tag is the live
                    readout — standings.astro's slider script writes its text and the --p / --steps vars. */}
                <div class="round-slider" style={`--p: ${matrixColumns.length > 1 ? ((sliderValue - 1) / (matrixColumns.length - 1)) * 100 : 100}%; --f: ${matrixColumns.length > 1 ? (sliderValue - 1) / (matrixColumns.length - 1) : 1}; --steps: ${Math.max(1, matrixColumns.length - 1)}`}>
                  <div class="round-slider-ticks" aria-hidden="true"></div>
                  <input
                    type="range"
                    id="timeline-slider"
                    min="1"
                    max={matrixColumns.length}
                    step="1"
                    value={sliderValue}
                    aria-label="Standings by Round"
                    data-cols={JSON.stringify(sliderCols)}
                  />
                  <span id="timeline-slider-value" class="round-slider-tag" aria-live="polite">
                    Round {sliderCols[sliderValue - 1]?.r ?? sliderValue}
                  </span>
                </div>
              </div>
            )}
            <label class="flex flex-col gap-1.5">
              <span class="text-xs font-semibold uppercase tracking-wide text-white/40">View</span>
              <select
                name="mode"
                data-submit-on-change
                class="h-9 w-44 rounded-md border border-white/15 bg-transparent px-3 text-sm text-white outline-none hover:bg-white/5 focus:border-brand-primary focus:bg-white/5"
              >
                <option value="list" selected={mode === 'list'} class="bg-brand-ink text-white">List</option>
                <option value="matrix" selected={mode === 'matrix'} class="bg-brand-ink text-white">Matrix</option>
                <option value="graph" selected={mode === 'graph'} class="bg-brand-ink text-white">Graph</option>
              </select>
            </label>
            <label class="flex flex-col gap-1.5">
              <span class="text-xs font-semibold uppercase tracking-wide text-white/40">Championship</span>
              <select
                name="championship"
                data-submit-on-change
                class="h-9 w-44 rounded-md border border-white/15 bg-transparent px-3 text-sm text-white outline-none hover:bg-white/5 focus:border-brand-primary focus:bg-white/5"
              >
                <option value="drivers" selected={championship === 'drivers'} class="bg-brand-ink text-white">Drivers</option>
                <option value="teams" selected={championship === 'teams'} class="bg-brand-ink text-white">Teams</option>
              </select>
            </label>
            <label class="flex flex-col gap-1.5">
              <span class="text-xs font-semibold uppercase tracking-wide text-white/40">Class</span>
              <select
                name="class"
                data-submit-on-change
                class="h-9 w-44 rounded-md border border-white/15 bg-transparent px-3 text-sm text-white outline-none hover:bg-white/5 focus:border-brand-primary focus:bg-white/5"
              >
                {championship === 'drivers' ? (
                  <>
                    <option value="all" selected={!activeClass} class="bg-brand-ink text-white">All</option>
                    {classesForActiveSeason.map((c) => (
                      <option value={c.name} selected={c.id === activeClass?.id} class="bg-brand-ink text-white">{c.name}</option>
                    ))}
                  </>
                ) : (
                  <>
                    <option value="all" selected={teamView === 'overall'} class="bg-brand-ink text-white">All</option>
                    <option value="Delta" selected={teamView === 'delta'} class="bg-brand-ink text-white">Delta</option>
                  </>
                )}
              </select>
            </label>
          </div>
        </form>
      </div>
    )}

    {!loadError && deltaNotActiveForSeason && (
      <p class="mt-10 text-white/60">The Delta Team championship began in ATC10 — no standings for {activeSeason?.name}.</p>
    )}

    {!loadError && !deltaNotActiveForSeason && (championship === 'drivers' ? standings.length === 0 : teamStandings.length === 0) && (
      <p class="mt-10 text-white/60">No results.</p>
    )}

    {!loadError && !deltaNotActiveForSeason && mode === 'graph' && graphSeries.length > 0 && matrixColumns.length > 0 && (
      <div id="standings-graph" class="graph-root mt-8 rounded-xl border border-white/10 p-4 sm:p-5">
        <div class="flex flex-wrap items-center justify-between gap-3">
          <h2 class="font-semibold">Cumulative points</h2>
          <div class="flex flex-wrap items-center gap-3 text-xs">
            {championship === 'drivers' && driverDropWeeks > 0 && (
              <label class="flex h-7 items-center gap-2 text-white/70" title={`Re-totals every point on the graph with each driver's worst ${driverDropWeeks} rounds dropped, starting at round ${MIN_ROUNDS_FOR_DROPS}`}>
