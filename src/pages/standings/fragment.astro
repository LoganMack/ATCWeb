---
export const prerender = false;

import CarLogos from '../../components/CarLogos.astro';
import TeamLogo from '../../components/TeamLogo.astro';
import DriverFlag from '../../components/DriverFlag.astro';
import SeasonLogo from '../../components/SeasonLogo.astro';
import {
  resolveSupabaseEnv,
  getDriverClasses,
  getSeasons,
  getStandingsExcludedRoundIds,
  displayDriverName,
  shortDriverName,
  getCircuits,
  getScoringRulesets,
  resolveSeasonRuleset,
  type Circuit,
} from '../../lib/supabase';
import {
  computeSeasonStandings,
  computeTeamSeasonStandings,
  computeOverallSeasonStandings,
  computeSeasonStandingsRoundColumns,
  computeDisplayRoundNumbers,
  normalizeTrackOrLayoutName,
  BASELINE_DROP_WEEKS,
  MIN_ROUNDS_FOR_DROPS,
  getSeasonCarTeamStats,
  getSeasonDriverExtendedStats,
  getSeasonOverallContext,
  driversSelect,
  isChampionshipSeason,
  type DriverSeasonStanding,
  type TeamSeasonStanding,
  type DriverSeasonExtras,
  type DriverSeasonExtendedStats,
  type SeasonStandingsRoundColumn,
} from '../../lib/results';
import { classTagFull } from '../../lib/classColors';
import { slugify } from '../../lib/slug';

const supabaseEnv = resolveSupabaseEnv(Astro.locals);

let classes: Awaited<ReturnType<typeof getDriverClasses>> = [];
let seasons: Awaited<ReturnType<typeof getSeasons>> = [];
let loadError: string | null = null;
try {
  [classes, seasons] = await Promise.all([getDriverClasses(supabaseEnv), getSeasons(supabaseEnv)]);
} catch (err) {
  console.error('Failed to load standings page filters:', err);
  loadError = err instanceof Error ? err.message : String(err);
}

// Exhibition seasons never have standings (computeSeasonStandings returns
// [] for them — see isChampionshipSeason), so the picker only offers real
// championship seasons in the first place.
const championshipSeasons = seasons.filter((s) => isChampionshipSeason(s.name));

const requestedSeasonNumber = Astro.url.searchParams.get('season');
const activeSeason =
  championshipSeasons.find((s) => String(s.number) === requestedSeasonNumber) ??
  championshipSeasons.find((s) => s.is_current) ??
  championshipSeasons[0];

// Gamma/Delta didn't exist for every season (see seasons.gamma_enabled/
// delta_enabled, 0037_class_and_scoring_fixes.sql) — the Class picker for
// the active season only offers classes that actually competed that
// season, so there's no "Gamma" option to pick for a season Gamma never
// raced in. Alpha has no flag — every championship season has it.
const classesForActiveSeason = classes.filter(
  (c) => (c.name !== 'Gamma' || activeSeason?.gamma_enabled) && (c.name !== 'Delta' || activeSeason?.delta_enabled)
);

// Championship dropdown: Drivers (default) or Teams — the old separate Team
// Standings tab now lives here (/team-standings just redirects).
const championship: 'drivers' | 'teams' = Astro.url.searchParams.get('championship') === 'teams' ? 'teams' : 'drivers';

// Class dropdown: "All" (every class combined — the old Overall view) or one
// class (the old Per Class view). Old links still work: `?view=class` with
// no/unknown class falls back to Alpha like before, `?view=overall` is
// always All.
const requestedClassName = Astro.url.searchParams.get('class');
const legacyView = Astro.url.searchParams.get('view');
const driverActiveClass =
  legacyView === 'overall' || (requestedClassName === 'all') || (!requestedClassName && legacyView !== 'class')
    ? undefined
    : (classesForActiveSeason.find((c) => c.name === requestedClassName) ??
      classesForActiveSeason.find((c) => c.name === 'Alpha') ??
      classesForActiveSeason[0]);

const activeClass = championship === 'drivers' ? driverActiveClass : undefined;
// Teams: "All" = the overall team championship, "Delta" = the separate Delta
// Team championship (see computeTeamSeasonStandings). Old `?view=delta` links
// land here via the /team-standings redirect.
const teamView: 'overall' | 'delta' = requestedClassName === 'Delta' || (!requestedClassName && legacyView === 'delta') ? 'delta' : 'overall';

const classNameById = new Map(classes.map((c) => [c.id, c.name]));

// "overall" = All classes combined (see computeOverallSeasonStandings);
// "class" = one class's own standings.
const view: 'overall' | 'class' = activeClass ? 'class' : 'overall';

// "List" (existing table, default) vs "Matrix" (drivers down the left, one
// column per round across the top, penalty/drop flags on each cell — see
// DriverSeasonStanding.roundCells), same URL-param pattern as before.
const requestedMode = Astro.url.searchParams.get('mode');
const mode: 'list' | 'matrix' | 'graph' = requestedMode === 'matrix' ? 'matrix' : requestedMode === 'graph' ? 'graph' : 'list';

let standings: DriverSeasonStanding[] = [];
let teamStandings: TeamSeasonStanding[] = [];
// Keyed by driver id — powers each team row's expanded roster detail (always
// the cross-class overall standing, whichever team view is showing).
let overallStandingByDriverId = new Map<string, DriverSeasonStanding>();
let extrasByDriverId: Map<string, DriverSeasonExtras> = new Map();
let extendedStatsByDriverId: Map<string, DriverSeasonExtendedStats> = new Map();
let matrixColumns: SeasonStandingsRoundColumn[] = [];
const matrixLogoBySubsession = new Map<number, string | null>();
// Timeline Slider inputs (see the script at the bottom): the drop rules the
// real standings use, so the client can recompute "as of round N" totals the
// same way finalizeStandings does.
let matrixDropWeeks = BASELINE_DROP_WEEKS;
let matrixCanDropFinalRound = false;
// "Standings by Round" slider inputs (both List and Matrix): per-column
// denominators for the "x of y" Starts/Apps cells, and (Teams list) the
// driver round data behind each team's expandable roster.
let colDenoms: { s: number; a: number }[] = [];
let rosterJson = '';
// The season-wide denominators for the Starts/Apps columns below ("x of y")
// — y is the same for every driver regardless of view (Overall vs Per
// Class) or how many rounds any one driver personally attended, so it's
// derived once from overallContext.overallScores (every class's race_scores
// rows for the season, already filtered to exclude exhibition/excluded
// rounds — see getSeasonOverallContext) rather than per-driver. "Starts" =
// one per (subsession_id, race_number) actually run — a sprint round with
// two races contributes 2, an endurance round's single race contributes 1.
// "Appearances" = one per distinct subsession_id (round) run, regardless of
// how many races it had.
let maxStarts = 0;
// Slots reserved for the right-aligned flag / car logo / team logo group in the
// List view's driver cell — a driver can have raced more than one car or team
// this season, so reserve as many car and team slots as the busiest driver
// needs (at least one each) and pad every other row up to that. Filled in
// once `extrasByDriverId` is loaded below.
let maxTeamSlots = 1;
let maxAppearances = 0;
if (!loadError && activeSeason && championship === 'drivers') {
  try {
    const [driversBasic, exhibitionRoundIds] = await Promise.all([driversSelect(supabaseEnv), getStandingsExcludedRoundIds(supabaseEnv)]);
    // Built ONCE and shared across all three calls below instead of each
    // independently re-fetching its own copy (curated_race_results,
    // penalties, curated_rounds, lap stats) — this page used to rebuild
    // that ~4-query context three separate times per request (once each
    // for standings/car-team-stats/extended-stats), which was enough to
    // trip Cloudflare Workers' per-request resource limit (Error 1102) on
    // seasons with more than a handful of rounds on file. Same
    // already-proven sharing pattern computeDriverCareerStats uses across
    // every class + team + extended-stats view at once — see this
    // repo's README/computeDriverCareerStats' own doc comment for why
    // sharing this way is safe.
    const overallContext = await getSeasonOverallContext(supabaseEnv, activeSeason, exhibitionRoundIds, driversBasic);
    const [standingsResult, extras, extendedStats] = await Promise.all([
      view === 'class' && activeClass
        ? computeSeasonStandings(supabaseEnv, activeSeason, activeClass.id, driversBasic, exhibitionRoundIds, classes, overallContext)
        : computeOverallSeasonStandings(supabaseEnv, activeSeason, driversBasic, exhibitionRoundIds, overallContext),
      getSeasonCarTeamStats(supabaseEnv, activeSeason, exhibitionRoundIds, driversBasic, undefined, undefined, undefined, overallContext),
      getSeasonDriverExtendedStats(supabaseEnv, activeSeason, exhibitionRoundIds, driversBasic, overallContext),
    ]);
    standings = standingsResult;
    extrasByDriverId = extras;
    for (const e of extras.values()) {
      maxTeamSlots = Math.max(maxTeamSlots, e.teams.length);
    }
    extendedStatsByDriverId = extendedStats;
    maxAppearances = new Set(overallContext.overallScores.map((s) => s.subsession_id)).size;
    maxStarts = new Set(overallContext.overallScores.map((s) => `${s.subsession_id}:${s.race_number}`)).size;

    // Matrix view's column headers — every round the view being shown
    // actually raced (Per Class narrows this to that class's own rounds,
    // same pool computeSeasonStandings itself used to build that view's
    // standings), chronologically ordered. Column headers are just the
    // round number (Logan: keep them narrow) — computeDisplayRoundNumbers
    // needs the season's full round list plus the site-wide exhibition/test
    // exclusion set (exhibitionRoundIds here is actually already that
    // union — see getStandingsExcludedRoundIds — so the second arg is left
    // empty rather than fetching test round ids separately).
    const matrixSubsessionIds = new Set(
      (view === 'class' && activeClass
        ? overallContext.overallScores.filter((s) => s.class_id === activeClass.id)
        : overallContext.overallScores
      ).map((s) => s.subsession_id)
    );
    const displayRoundNumbers = computeDisplayRoundNumbers(overallContext.seasonRounds, exhibitionRoundIds, new Set());
    matrixColumns = computeSeasonStandingsRoundColumns(overallContext.seasonRounds, matrixSubsessionIds, displayRoundNumbers);

    // As-of denominators for the List view's "x of y" Starts/Apps cells —
    // how many races/rounds the WHOLE season (every class) had run by each
    // column's round, matching the season-wide maxStarts/maxAppearances above.
    const startTimeBySubsession = new Map(overallContext.seasonRounds.map((r) => [r.subsession_id, r.start_time]));
    const racesBySubsession = new Map<number, Set<number>>();
    for (const sc of overallContext.overallScores) {
      if (!racesBySubsession.has(sc.subsession_id)) racesBySubsession.set(sc.subsession_id, new Set());
      racesBySubsession.get(sc.subsession_id)!.add(sc.race_number);
    }
    const seasonRoundList = [...racesBySubsession].map(([id, races]) => ({ t: startTimeBySubsession.get(id) ?? '', races: races.size }));
    colDenoms = matrixColumns.map((col) => {
      const through = seasonRoundList.filter((r) => r.t <= col.startTime);
      return { s: through.reduce((sum, r) => sum + r.races, 0), a: through.length };
    });
  } catch (err) {
    console.error('Failed to compute standings:', err);
    loadError = err instanceof Error ? err.message : String(err);
  }
}

// Delta Team championship didn't start until ATC10 (see
// 0052_delta_team_enabled.sql) — skipped entirely for an out-of-range season
// so the template can show a specific explanation instead of a bare "No results."
const deltaNotActiveForSeason = championship === 'teams' && teamView === 'delta' && activeSeason ? !activeSeason.delta_team_enabled : false;

if (!loadError && activeSeason && championship === 'teams' && !deltaNotActiveForSeason) {
  try {
    const [driversBasic, exhibitionRoundIds] = await Promise.all([driversSelect(supabaseEnv), getStandingsExcludedRoundIds(supabaseEnv)]);
    const deltaClassId = teamView === 'delta' ? classes.find((c) => c.name === 'Delta')?.id : undefined;
    // Built once and shared with both calls (see the driver branch above for why).
    const overallContext = await getSeasonOverallContext(supabaseEnv, activeSeason, exhibitionRoundIds, driversBasic);
    const [teamResult, overallStandings] = await Promise.all([
      computeTeamSeasonStandings(supabaseEnv, activeSeason, exhibitionRoundIds, deltaClassId, driversBasic, undefined, undefined, classes, overallContext),
      computeOverallSeasonStandings(supabaseEnv, activeSeason, driversBasic, exhibitionRoundIds, overallContext),
    ]);
    teamStandings = teamResult;
    overallStandingByDriverId = new Map(overallStandings.map((s) => [s.driver.id, s]));

    const matrixSubsessionIds = new Set(
      (teamView === 'delta' && deltaClassId !== undefined
        ? overallContext.overallScores.filter((s) => s.class_id === deltaClassId)
        : overallContext.overallScores
      ).map((s) => s.subsession_id)
    );
    const displayRoundNumbers = computeDisplayRoundNumbers(overallContext.seasonRounds, exhibitionRoundIds, new Set());
    matrixColumns = computeSeasonStandingsRoundColumns(overallContext.seasonRounds, matrixSubsessionIds, displayRoundNumbers);

    // Every driver's round-by-round overall points/starts, so each team's
    // expandable roster can show "as of round N" positions too.
    const overallColumns = computeSeasonStandingsRoundColumns(
      overallContext.seasonRounds,
      new Set(overallContext.overallScores.map((sc) => sc.subsession_id)),
      displayRoundNumbers
    );
    rosterJson = JSON.stringify({
      t: overallColumns.map((c) => c.startTime),
      d: Object.fromEntries(
        overallStandings.map((st) => [
          st.driver.id,
          {
            o: st.position,
            r: overallColumns.map((c) => {
              const cell = st.roundCells.get(c.subsessionId);
              return cell ? [cell.points, st.roundStats.get(c.subsessionId)?.starts ?? 0] : null;
            }),
          },
        ])
      ),
    });
  } catch (err) {
    console.error('Failed to compute team standings:', err);
    loadError = err instanceof Error ? err.message : String(err);
  }
}

// Matrix-only extras shared by both championships: the drop rules the
// Timeline Slider needs (teams never drop rounds), and a track logo for each
// column header — matched to a circuit by track name, same normalisation the
// rest of the site uses; a track with no logo falls back to an initials tile.
const driverDropWeeks = activeSeason ? BASELINE_DROP_WEEKS + (activeSeason.extra_drop_weeks ?? 0) : BASELINE_DROP_WEEKS;
if (!loadError && activeSeason && matrixColumns.length > 0) {
  matrixDropWeeks = championship === 'drivers' ? driverDropWeeks : 0;
  try {
    const rulesets = await getScoringRulesets(supabaseEnv);
    matrixCanDropFinalRound = resolveSeasonRuleset(activeSeason, rulesets)?.can_drop_final_round ?? false;
  } catch (err) {
    console.error('Failed to load scoring rulesets for standings:', err);
  }
}
if (!loadError && activeSeason && mode !== 'graph' && (mode === 'matrix' || championship === 'drivers') && matrixColumns.length > 0) {
  try {
    const circuits = await getCircuits(supabaseEnv);
    const circuitByName = new Map<string, Circuit>(circuits.map((c) => [normalizeTrackOrLayoutName(c.name), c]));
    for (const col of matrixColumns) {
      matrixLogoBySubsession.set(col.subsessionId, circuitByName.get(normalizeTrackOrLayoutName(col.trackName))?.logo_url ?? null);
    }
  } catch (err) {
    console.error('Failed to load circuits for standings matrix headers:', err);
  }
}

// ---- "Standings by Round" slider ----
// The slider's value is "show the first N rounds"; it's carried across
// dropdown changes in the `round` URL param as a round NUMBER (so it survives
// switching to a class that raced a different set of rounds). No param, or a
// round at/after the latest one, means all rounds.
const sliderCols = matrixColumns.map((c) => ({ r: c.roundNumber, t: c.startTime }));
const requestedRound = Number(Astro.url.searchParams.get('round'));
const sliderValue =
  Number.isFinite(requestedRound) && requestedRound > 0 && matrixColumns.length > 0
    ? Math.max(1, matrixColumns.filter((c) => (c.roundNumber ?? 0) <= requestedRound).length)
    : matrixColumns.length;

/** One driver's per-column data for the client: null for a round they skipped, else [points, wins, podiums, top5s, top10s, poles, starts, laps-led, laps, detail-laps, detail-led, net positions, incidents, bonus, distance km|null, corners|null]. */
function driverRoundsJson(row: DriverSeasonStanding): string {
  const ext = extendedStatsByDriverId.get(row.driver.id);
  return JSON.stringify(
    matrixColumns.map((col) => {
      const cell = row.roundCells.get(col.subsessionId);
      if (!cell) return null;
      const st = row.roundStats.get(col.subsessionId);
      const ex = ext?.byRound.get(col.subsessionId);
      return [
        cell.points,
        st?.wins ?? 0,
        st?.podiums ?? 0,
        st?.top5s ?? 0,
        st?.top10s ?? 0,
        st?.poles ?? 0,
        st?.starts ?? 0,
        st?.lapsLed ?? 0,
        st?.laps ?? 0,
        ex?.laps ?? 0,
        ex?.lapsLed ?? 0,
        ex?.netPositionsChange ?? 0,
        ex?.incidents ?? 0,
        ex?.bonusPoints ?? 0,
        ex && ex.km !== null ? ex.laps * ex.km : null,
        ex && ex.corners !== null ? ex.laps * ex.corners : null,
      ];
    })
  );
}
function driverPenaltyJson(row: DriverSeasonStanding): string {
  const ext = extendedStatsByDriverId.get(row.driver.id);
  return JSON.stringify(matrixColumns.map((col) => ext?.byRound.get(col.subsessionId)?.penaltyPoints ?? 0));
}
function teamRoundsJson(row: TeamSeasonStanding): string {
  return JSON.stringify(
    matrixColumns.map((col) => {
      const cell = row.roundCells.get(col.subsessionId);
      return cell ? [cell.points, row.roundStarts.get(col.subsessionId) ?? 0] : null;
    })
  );
}

// Graph view data: running (cumulative) points per driver/team across the
// visible rounds, in standings order — which is also each entity's fixed colour
// slot (the first 8 get a named hue; the rest are muted grey lines).
const graphSeries = (
  championship === 'drivers'
    ? standings.map((row) => ({
        id: row.driver.id,
        name: displayDriverName(row.driver.name),
        short: shortDriverName(row.driver.name),
        tag: row.classId !== undefined ? (classNameById.get(row.classId) ?? '') : '',
        cells: row.roundCells,
      }))
    : teamStandings.map((row) => ({ id: row.teamId, name: row.teamName, short: row.teamName, tag: '', cells: row.roundCells }))
).map((e) => {
  let run = 0;
  let started = false;
  const cum = matrixColumns.map((col) => {
    const cell = e.cells.get(col.subsessionId);
    if (cell) {
      run += cell.points;
      started = true;
    }
    return started ? run : null;
  });
  return { id: e.id, name: e.name, short: e.short, tag: e.tag, cum };
});
const graphJson = JSON.stringify({
  cols: matrixColumns.map((c) => ({ r: c.roundNumber, t: c.startTime, k: matrixColumnTitle(c.trackName, c.format) })),
  series: graphSeries,
});

// CSV export filename — reflects whichever view is actually on screen
// (season, Overall/Per Class + which class, List/Matrix) so exporting after
// changing a filter doesn't silently overwrite a previous, differently-
// scoped download under the same name.
const csvFilenameBase = slugify(
  championship === 'teams'
    ? `team standings ${activeSeason?.name ?? ''} ${teamView} ${mode}`
    : `standings ${activeSeason?.name ?? ''} ${view === 'class' && activeClass ? activeClass.name : 'overall'} ${mode}`
);

function raceWord(n: number): string {
  return `${n} race${n === 1 ? '' : 's'}`;
}

// Matrix column header's hover tooltip — "Track Name — Sprint"/"Track Name
// — Endurance", or just the track name when the round has no format on
// file yet.
function matrixColumnTitle(trackName: string, format: 'endurance' | 'sprint' | null): string {
  if (!format) return trackName;
  return `${trackName} — ${format.charAt(0).toUpperCase()}${format.slice(1)}`;
}

Astro.response.headers.set('Cache-Control', 'public, s-maxage=60, stale-while-revalidate=300');
---

    <div class="mt-8"></div>

    {loadError && (
      <p class="mt-4 rounded-lg border border-brand-pink/30 bg-brand-pink/10 p-4 text-sm text-white/80">
        Couldn't load standings right now. If this mentions permission/RLS, race_scores or curated_race_results
        likely still need the public-read policy from <code>supabase/migrations/0004_champions.sql</code> —
        it has to be run manually in the Supabase SQL editor.
        <br /><span class="mt-1 block text-white/50">{loadError}</span>
      </p>
    )}

    {!loadError && (
      <div class="relative z-30 mt-8">
        <form method="GET" class="flex flex-wrap items-end justify-between gap-x-4 gap-y-4">
          {/* Carries the Standings by Round slider across dropdown changes (the slider keeps this up to date; the Season dropdown disables it so a new season starts at all rounds). */}
          <input type="hidden" name="round" id="timeline-round" value={sliderCols[sliderValue - 1]?.r ?? ''} disabled={sliderValue >= matrixColumns.length} />
          <label class="flex flex-col gap-1.5 text-sm">
            <span class="text-white/60">Season</span>
            <div class="flex items-center gap-2">
              <select
                name="season"
                onchange="var r = this.form.elements.round; if (r) r.disabled = true; this.form.submit()"
                class="h-10 w-44 rounded-md border border-white/15 bg-white/5 px-3 text-white outline-none focus:border-brand-primary"
              >
                {championshipSeasons.map((s) => (
                  <option value={s.number} selected={s.id === activeSeason?.id} class="bg-brand-ink text-white">{s.name}</option>
                ))}
              </select>
              <SeasonLogo darkUrl={activeSeason?.logo_url ?? null} lightUrl={activeSeason?.logo_url_light} />
            </div>
          </label>
          <div class="flex flex-wrap items-end gap-4 sm:ml-auto">
            {matrixColumns.length > 1 && (
              <div class="group relative flex flex-col gap-1.5 text-sm">
                <span class="text-white/60">Standings by Round</span>
                <div class="flex h-10 items-center gap-3">
                  <input
                    type="range"
                    id="timeline-slider"
                    min="1"
                    max={matrixColumns.length}
                    step="1"
                    value={sliderValue}
                    aria-label="Standings by Round"
                    data-cols={JSON.stringify(sliderCols)}
                    class="w-40 accent-brand-primary"
                  />
                  <span id="timeline-slider-value" class="min-w-[4.5rem] text-white/70">
                    Round {sliderCols[sliderValue - 1]?.r ?? sliderValue}
                  </span>
                </div>
                <span
                  role="tooltip"
                  class="pointer-events-none absolute left-0 top-full z-40 mt-1 hidden w-64 rounded-md border border-white/15 bg-brand-ink px-3 py-2 text-xs text-white/80 shadow-lg group-hover:block group-focus-within:block"
                >
                  Move this slider to view the standings as they were, round-by-round.
                </span>
              </div>
            )}
            <label class="flex flex-col gap-1.5 text-sm">
              <span class="text-white/60">View</span>
              <select
                name="mode"
                onchange="this.form.submit()"
                class="h-10 w-44 rounded-md border border-white/15 bg-white/5 px-3 text-white outline-none focus:border-brand-primary"
              >
                <option value="list" selected={mode === 'list'} class="bg-brand-ink text-white">List</option>
                <option value="matrix" selected={mode === 'matrix'} class="bg-brand-ink text-white">Matrix</option>
                <option value="graph" selected={mode === 'graph'} class="bg-brand-ink text-white">Graph</option>
              </select>
            </label>
            <label class="flex flex-col gap-1.5 text-sm">
              <span class="text-white/60">Championship</span>
              <select
                name="championship"
                onchange="this.form.submit()"
                class="h-10 w-44 rounded-md border border-white/15 bg-white/5 px-3 text-white outline-none focus:border-brand-primary"
              >
                <option value="drivers" selected={championship === 'drivers'} class="bg-brand-ink text-white">Drivers</option>
                <option value="teams" selected={championship === 'teams'} class="bg-brand-ink text-white">Teams</option>
              </select>
            </label>
            <label class="flex flex-col gap-1.5 text-sm">
              <span class="text-white/60">Class</span>
              <select
                name="class"
                onchange="this.form.submit()"
                class="h-10 w-44 rounded-md border border-white/15 bg-white/5 px-3 text-white outline-none focus:border-brand-primary"
              >
                {championship === 'drivers' ? (
                  <>
                    <option value="all" selected={!activeClass} class="bg-brand-ink text-white">All</option>
                    {classesForActiveSeason.map((c) => (
                      <option value={c.name} selected={c.id === activeClass?.id} class="bg-brand-ink text-white">{c.name}</option>
                    ))}
                  </>
                ) : (
                  <>
                    <option value="all" selected={teamView === 'overall'} class="bg-brand-ink text-white">All</option>
                    <option value="Delta" selected={teamView === 'delta'} class="bg-brand-ink text-white">Delta</option>
                  </>
                )}
              </select>
            </label>
          </div>
        </form>
      </div>
    )}

    {!loadError && deltaNotActiveForSeason && (
      <p class="mt-10 text-white/60">The Delta Team championship began in ATC10 — no standings for {activeSeason?.name}.</p>
    )}

    {!loadError && !deltaNotActiveForSeason && (championship === 'drivers' ? standings.length === 0 : teamStandings.length === 0) && (
      <p class="mt-10 text-white/60">No results.</p>
    )}

    {!loadError && !deltaNotActiveForSeason && mode === 'graph' && graphSeries.length > 0 && matrixColumns.length > 0 && (
      <div id="standings-graph" class="graph-root mt-8 rounded-xl border border-white/10 p-4 sm:p-5">
        <div class="flex flex-wrap items-center justify-between gap-3">
          <h2 class="font-semibold">Cumulative points</h2>
          <div class="flex gap-2 text-xs">
            <button type="button" data-graph-preset="top" class="btn btn-neutral btn-sm">Top 8</button>
