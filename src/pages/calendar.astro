---
export const prerender = false;

import Layout from '../layouts/Layout.astro';
import PageBanner from '../components/PageBanner.astro';
import { resolveSupabaseEnv, getPageBanners } from '../lib/supabase';
import { bannerUrlFor } from '../lib/pageBanners';

// Shell-then-skeleton split (same pattern as results.astro / standings.astro):
// this file only fetches the page banner and paints the heading plus a loading
// skeleton right away. The events, rounds, layouts and rulesets the calendar
// needs (several Supabase round trips) live in calendar/fragment.astro and are
// fetched client-side once this shell has painted. The page's interaction
// script below (List/Calendar toggle, month grid, recaps) stays here, since a
// <script> inside fetched HTML never executes; every init function in it
// bails out when its elements don't exist yet and binds when the fragment's
// astro:page-load re-dispatch fires.
const supabaseEnv = resolveSupabaseEnv(Astro.locals);

let bannerUrl: string | null = null;
try {
  bannerUrl = bannerUrlFor(await getPageBanners(supabaseEnv), 'calendar');
} catch (err) {
  console.error('Failed to load page banner:', err);
}

Astro.response.headers.set('Cache-Control', 'public, s-maxage=60, stale-while-revalidate=300');
---

<Layout title="Calendar" description="The Alpha Touring Challenge race calendar.">
  <section class="relative mx-auto max-w-5xl overflow-hidden px-6 pb-24 pt-8">
    <PageBanner imageUrl={bannerUrl} />
    <h1 class="reveal font-display text-2xl sm:text-5xl">Calendar</h1>

    <div data-calendar-results data-fragment-url={`/calendar/fragment${Astro.url.search}`}>
      <div class="mt-6" aria-live="polite" aria-busy="true">
        <span class="sr-only">Loading calendar…</span>
        <div class="flex flex-wrap items-center gap-2">
          <div class="h-9 w-28 animate-pulse rounded-md border border-white/10 bg-white/[0.03]"></div>
        </div>
        <div class="mt-6 flex flex-col gap-4">
          <div class="h-32 animate-pulse rounded-xl border border-white/10 bg-white/[0.03]"></div>
          <div class="h-32 animate-pulse rounded-xl border border-white/10 bg-white/[0.03]"></div>
          <div class="h-32 animate-pulse rounded-xl border border-white/10 bg-white/[0.03]"></div>
        </div>
      </div>
    </div>
  </section>

  <script>
    // Two independent bits of interactivity on this page: the List/Calendar
    // view toggle, and (when Calendar is showing) the month-grid itself.
    // Kept as one self-contained script (no imports from src/lib — same
    // "duplicate small helpers rather than import into the client bundle"
    // convention every other interactive script on this site follows, e.g.
    // ResultsTable.astro/team-standings.astro's own copies of the
    // expand-row toggle) so this page doesn't pull the whole supabase.ts
    // module into client JS just for two tiny formatting helpers. The one
    // exception is pageProgress.ts below — it's already a pure client
    // script with no server/data-layer baggage (same thing
    // hard-form-submit.ts imports), so pulling it in doesn't violate that
    // convention.
    import { showProgress, hideProgress } from '../scripts/pageProgress';

    interface CalendarEventLite {
      date: string; // 'YYYY-MM-DD'
      circuit: string;
      logoUrl: string | null;
      layout: string | null;
      format: string;
      category: string;
    }

    const FORMAT_LABELS: Record<string, string> = { endurance: 'Endurance', sprint: 'Sprint', special: 'Special' };
    const FORMAT_BADGE_CLASSES: Record<string, string> = {
      endurance: 'bg-brand-blue/15 text-brand-blue',
      special: 'bg-brand-pink/15 text-brand-pink',
      sprint: 'bg-brand-gold/15 text-brand-gold',
    };
    // Test/Holiday/iRacing events don't use the format field (see
    // eventFormatting.ts's usesFormatBadge() server-side) — same neutral
    // grey override applied here for the day-cell pill (mirrors
    // CATEGORY_BADGE_CLASSES in eventFormatting.ts — duplicated rather than
    // imported per this script's own "no src/lib imports" convention above).
    const CATEGORY_ONLY_BADGE_CLASSES: Record<string, string> = {
      test: 'bg-white/10 text-white/50',
      holiday: 'bg-white/10 text-white/50',
      iracing: 'bg-white/10 text-white/50',
    };

    // Same format-vs-category branch as usesFormatBadge() in
    // eventFormatting.ts, duplicated here for the same "no src/lib imports"
    // reason as the badge maps above.
    function usesFormatBadge(category: string): boolean {
      return category === 'championship' || category === 'exhibition';
    }

    // Card-background accent for a day cell that has events — mirrors
    // FORMAT_CARD_CLASSES/CATEGORY_CARD_CLASSES in eventFormatting.ts (same
    // border+bg-instead-of-text+bg shape as the badge maps above), so a day
    // highlights in the same color its event's tag shows instead of always
    // being blue. A day with 2+ events uses the first event's color — same
    // "first event wins" simplification the pill loop below already applies
    // by only rendering 2 pills max.
    const FORMAT_CARD_CLASSES: Record<string, string> = {
      endurance: 'border-brand-blue/40 bg-brand-blue/10 hover:bg-brand-blue/20',
      special: 'border-brand-pink/40 bg-brand-pink/10 hover:bg-brand-pink/20',
      sprint: 'border-brand-gold/40 bg-brand-gold/10 hover:bg-brand-gold/20',
    };
    const CATEGORY_ONLY_CARD_CLASSES: Record<string, string> = {
      test: 'border-white/10 bg-brand-ink hover:bg-white/[0.03]',
      holiday: 'border-white/10 bg-brand-ink hover:bg-white/[0.03]',
      iracing: 'border-white/10 bg-brand-ink hover:bg-white/[0.03]',
    };

    function dayCardClasses(ev: CalendarEventLite): string {
      return usesFormatBadge(ev.category)
        ? (FORMAT_CARD_CLASSES[ev.format] ?? 'border-brand-primary/40 bg-brand-primary/10 hover:bg-brand-primary/20')
        : (CATEGORY_ONLY_CARD_CLASSES[ev.category] ?? 'border-brand-primary/40 bg-brand-primary/10 hover:bg-brand-primary/20');
    }

    /** Same "N/A" -> "Full Course" display-only substitution as displayLayoutName() in src/lib/supabase.ts. */
    function displayLayoutName(name: string): string {
      return name === 'N/A' ? 'Full Course' : name;
    }

    /** Same local-date-components parsing as eventFormatting.ts's parseDateOnly — avoids new Date('YYYY-MM-DD') silently shifting a day in negative-offset timezones. */
    function parseDateOnly(dateStr: string): Date {
      const [year, month, day] = dateStr.split('-').map(Number);
      return new Date(year, month - 1, day);
    }

    function formatEventDate(dateStr: string): string {
      return parseDateOnly(dateStr).toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' });
    }

    function pad(n: number): string {
      return String(n).padStart(2, '0');
    }

    function initViewToggle() {
      const select = document.querySelector<HTMLSelectElement>('select[data-view-toggle]');
      const panels = document.querySelectorAll<HTMLElement>('[data-view-panel]');
      if (!select || panels.length === 0) return;

      const showPanel = () => {
        panels.forEach((p) => {
          p.classList.toggle('hidden', p.dataset.viewPanel !== select.value);
        });
      };
      select.addEventListener('change', showPanel);
      showPanel();
    }

    function initCalendarGrid() {
      const gridPanel = document.querySelector<HTMLElement>('[data-view-panel="calendar"]');
      const grid = document.getElementById('cal-grid');
      const monthLabelEl = document.getElementById('cal-month-label');
      const detailPanel = document.getElementById('cal-day-detail');
      const prevBtn = document.getElementById('cal-prev');
      const nextBtn = document.getElementById('cal-next');
      const todayBtn = document.getElementById('cal-today');
      if (!gridPanel || !grid || !monthLabelEl || !detailPanel || !prevBtn || !nextBtn) return;

      let allEvents: CalendarEventLite[] = [];
      try {
        allEvents = JSON.parse(gridPanel.dataset.events ?? '[]');
      } catch {
        allEvents = [];
      }

      const eventsByDate = new Map<string, CalendarEventLite[]>();
      for (const ev of allEvents) {
        if (!eventsByDate.has(ev.date)) eventsByDate.set(ev.date, []);
        eventsByDate.get(ev.date)!.push(ev);
      }

      // Pinned to the 1st so setMonth() navigation can never skip/repeat a
      // month due to day-of-month overflow (e.g. Jan 31 + 1 month -> Mar 3).
      let current = new Date();
      current.setDate(1);

      // Shows the SAME full event card(s) the List view renders for this
      // day — not a second, cut-down summary built from the lean
      // `calendarEvents` payload (date/circuit/logo/layout/format only,
      // still used above just to know which days have events and what to
      // show in each day cell's small pills). Every event, upcoming or
      // past, is already fully rendered somewhere in the List view's DOM
      // (see EventDetailCard.astro's `data-event-date` attribute) — this
      // just finds and deep-clones whichever card(s) match the clicked
      // date, so Calendar view can never drift out of sync with List view
      // on what a "full" event card actually shows.
      function showDayDetail(dateStr: string) {
        detailPanel!.classList.remove('hidden');
        detailPanel!.innerHTML = '';

        const heading = document.createElement('h3');
        heading.className = 'font-display text-xl';
        heading.textContent = formatEventDate(dateStr);
        detailPanel!.appendChild(heading);

        const list = document.createElement('div');
        list.className = 'mt-3 flex flex-col gap-3';

        const originals = document.querySelectorAll<HTMLElement>(`[data-event-date="${dateStr}"]`);
        originals.forEach((original) => {
          const clone = original.cloneNode(true) as HTMLElement;
          // The original may not have scrolled into view yet (reveal.ts
          // only reveals on scroll, and this clone can appear well before
          // that happens if List view was never scrolled through) — force
          // it visible rather than risk an invisible/stuck-at-opacity-0 card.
          clone.classList.add('is-visible');
          list.appendChild(clone);
        });
        detailPanel!.appendChild(list);

        // The clones' own "Race Recaps at this Layout" <details> (if any)
        // are brand new nodes, never seen by initRoundRecaps()/
        // initLayoutRounds() before — as opposed to attributes/classes,
        // addEventListener bindings are never copied by cloneNode(), so
        // this re-runs both same guarded initializers to bind just these
        // new ones (already-bound elements elsewhere on the page are
        // unaffected — see each one's own WeakSet guard).
        initRoundRecaps();
        initLayoutRounds();
      }

      function renderCalendar() {
        const year = current.getFullYear();
        const month = current.getMonth();
        monthLabelEl!.textContent = current.toLocaleDateString('en-US', { month: 'long', year: 'numeric' });

        const todayIso = new Date().toISOString().slice(0, 10);
        const numDays = new Date(year, month + 1, 0).getDate();
        const startWeekday = new Date(year, month, 1).getDay();

        grid!.innerHTML = '';

        ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'].forEach((wd) => {
          const el = document.createElement('div');
          el.className = 'pb-1 text-center text-[10px] font-semibold uppercase tracking-wide text-white/40';
          el.textContent = wd;
          grid!.appendChild(el);
        });

        // Leading blanks pad the 1st of the month out to its actual weekday
        // column — deliberately not showing the previous month's trailing
        // days here (that month is one click away via Prev, fully
        // interactive there instead of a half-rendered preview here).
        for (let i = 0; i < startWeekday; i++) {
          grid!.appendChild(document.createElement('div'));
        }

        for (let day = 1; day <= numDays; day++) {
          const dateStr = `${year}-${pad(month + 1)}-${pad(day)}`;
          const dayEvents = eventsByDate.get(dateStr) ?? [];
          const isToday = dateStr === todayIso;
          const hasEvents = dayEvents.length > 0;

          const cell = document.createElement('button');
          cell.type = 'button';
          cell.className = [
            'flex min-h-[64px] flex-col items-start gap-1 rounded-lg border p-1.5 text-left transition',
            hasEvents ? `${dayCardClasses(dayEvents[0])} cursor-pointer` : 'border-white/10 bg-brand-ink cursor-default',
            isToday ? 'ring-1 ring-brand-primary' : '',
          ].join(' ');
          if (!hasEvents) cell.disabled = true;

          const dayNum = document.createElement('span');
          dayNum.className = 'font-display text-sm text-white/70';
          dayNum.textContent = String(day);
          cell.appendChild(dayNum);

          dayEvents.slice(0, 2).forEach((ev) => {
            const pill = document.createElement('span');
            const badgeClasses = CATEGORY_ONLY_BADGE_CLASSES[ev.category] ?? FORMAT_BADGE_CLASSES[ev.format] ?? 'bg-white/10 text-white/60';
            pill.className = `w-full truncate rounded px-1 py-0.5 text-[10px] font-semibold ${badgeClasses}`;
            pill.textContent = ev.circuit;
            cell.appendChild(pill);
          });

          if (hasEvents) {
            cell.addEventListener('click', () => showDayDetail(dateStr));
          }

          grid!.appendChild(cell);
        }
      }

      prevBtn.addEventListener('click', () => {
        current.setMonth(current.getMonth() - 1);
        detailPanel!.classList.add('hidden');
        renderCalendar();
      });
      nextBtn.addEventListener('click', () => {
        current.setMonth(current.getMonth() + 1);
        detailPanel!.classList.add('hidden');
        renderCalendar();
      });
      todayBtn?.addEventListener('click', () => {
        current = new Date();
        current.setDate(1);
        detailPanel!.classList.add('hidden');
        renderCalendar();
      });

      renderCalendar();
    }

    // --- "Race Recaps at this Layout" lazy loading (EventDetailCard.astro) ---
    //
    // One native <details data-round-recap> per historical round; its
    // content div (`[data-recap-body]`) starts empty and is only filled in
    // the first time that round's <details> is actually opened, via
    // /api/round-recap/[subsessionId] (see that route's own doc comment for
    // why this can't just be computed up front for every round on the
    // page). A WeakSet (not a `dataset` flag) tracks which elements are
    // already bound — a `dataset` flag would survive `cloneNode()` (it
    // copies attributes) even though the actual listener does NOT get
    // copied, which would make a cloned round-recap panel (see
    // showDayDetail() above) permanently un-clickable; a WeakSet correctly
    // treats a clone as a distinct, not-yet-bound node.
    interface RecapDriverLite {
      name: string;
      car_number: number | null;
    }
    interface RoundRecapLite {
      races: {
        raceNumber: number;
        topByClass: { className: string; top3: { position: number; driver: RecapDriverLite }[] }[];
        fastestLap: { driver: RecapDriverLite; formatted: string; isTrackRecord: boolean } | null;
      }[];
      topTeamOverall: { teamName: string; points: number } | null;
    }

    const recapCache = new Map<number, Promise<RoundRecapLite | null>>();
    const boundRecapDetails = new WeakSet<HTMLDetailsElement>();

    /** Same trailing-digit-stripping display rule as displayDriverName() in src/lib/supabase.ts. */
    function displayDriverName(name: string): string {
      return name.replace(/\d+$/, '');
    }

    /** Same "F. Lastname" formatting rule as shortDriverName() in src/lib/supabase.ts — these recap cards are narrow, so short names avoid wrapping. */
    function shortDriverName(name: string): string {
      const parts = displayDriverName(name).trim().split(/\s+/).filter(Boolean);
      if (parts.length === 0) return '';
      if (parts.length === 1) return parts[0];
      return `${parts[0].charAt(0)}. ${parts[parts.length - 1]}`;
    }

    function fetchRoundRecap(subsessionId: number): Promise<RoundRecapLite | null> {
      if (!recapCache.has(subsessionId)) {
        recapCache.set(
          subsessionId,
          fetch(`/api/round-recap/${subsessionId}`)
            .then((res) => (res.ok ? (res.json() as Promise<RoundRecapLite>) : null))
            .catch(() => null)
        );
      }
      return recapCache.get(subsessionId)!;
    }

    // This request bypasses Astro's router entirely (it's a plain fetch()
    // fired from a <details> toggle, not a navigation), so — same reasoning
    // as hard-form-submit.ts — it's invisible to pageProgress.ts's own
    // astro:before-preparation/astro:page-load listeners and needs the
    // global bar driven directly.
    function fetchRoundRecapWithProgress(subsessionId: number): Promise<RoundRecapLite | null> {
      const alreadyCached = recapCache.has(subsessionId);
      if (alreadyCached) return fetchRoundRecap(subsessionId);
      showProgress();
      return fetchRoundRecap(subsessionId).finally(() => hideProgress());
    }

    function renderRoundRecap(container: HTMLElement, recap: RoundRecapLite | null, subsessionId: number) {
      if (!recap) {
        container.innerHTML = '<p class="text-xs text-white/40">Couldn’t load this recap.</p>';
        return;
      }
      container.innerHTML = '';
      const wrap = document.createElement('div');
      wrap.className = 'flex flex-col gap-2 text-xs';

      if (recap.races.length === 0) {
        wrap.innerHTML = '<p class="text-white/40">No results on file for this round.</p>';
      }

      recap.races.forEach((race) => {
        const raceEl = document.createElement('div');
        const heading = document.createElement('p');
        heading.className = 'font-semibold text-white/70';
        heading.textContent = `Race ${race.raceNumber}`;
        raceEl.appendChild(heading);

        // One driver per line (not comma-joined) per Logan — easier to
        // scan than a single run-on line once a class has 3 names in it.
        race.topByClass.forEach((cls) => {
          const clsHeading = document.createElement('p');
          clsHeading.className = 'mt-0.5 font-semibold text-white/50';
          clsHeading.textContent = `${cls.className}:`;
          raceEl.appendChild(clsHeading);

          cls.top3.forEach((t) => {
            const driverLine = document.createElement('p');
            driverLine.className = 'pl-2 text-white/50';
            driverLine.textContent = `${t.position}. ${shortDriverName(t.driver.name)}`;
            raceEl.appendChild(driverLine);
          });
        });

        if (race.fastestLap) {
          const fl = document.createElement('p');
          fl.className = 'mt-0.5 text-white/50';
          fl.textContent = `Fastest Lap: ${shortDriverName(race.fastestLap.driver.name)} — ${race.fastestLap.formatted}${
            race.fastestLap.isTrackRecord ? ' (Track Record!)' : ''
          }`;
          raceEl.appendChild(fl);
        }

        wrap.appendChild(raceEl);
      });

      if (recap.topTeamOverall) {
        const teamP = document.createElement('p');
        teamP.className = 'font-semibold text-white/60';
        teamP.textContent = `Top Team: ${recap.topTeamOverall.teamName} (${recap.topTeamOverall.points} pts)`;
        wrap.appendChild(teamP);
      }

      const resultLink = document.createElement('a');
      resultLink.href = `/results/${subsessionId}`;
      resultLink.className = 'mt-1 inline-block text-xs text-brand-primary hover:underline';
      resultLink.textContent = 'Full race result →';
      wrap.appendChild(resultLink);

      container.appendChild(wrap);
    }

    function initRoundRecaps() {
      document.querySelectorAll<HTMLDetailsElement>('[data-round-recap]').forEach((details) => {
        if (boundRecapDetails.has(details)) return;
        boundRecapDetails.add(details);

        details.addEventListener('toggle', () => {
          if (!details.open) return;
          const subsessionId = Number(details.dataset.roundRecap);
          const container = details.querySelector<HTMLElement>('[data-recap-body]');
          if (!container || !Number.isFinite(subsessionId) || container.dataset.loaded === 'true') return;
          container.dataset.loaded = 'true';
          container.innerHTML = '<p class="text-xs text-white/40">Loading…</p>';
          fetchRoundRecapWithProgress(subsessionId).then((recap) => renderRoundRecap(container, recap, subsessionId));
        });
      });
    }

    // --- "Race Recaps at this Layout" lazy loading (one level up from the
    // recap content above) ---
    //
    // Each event card's outer collapsible (`[data-layout-rounds-summary]`,
    // see EventDetailCard.astro) starts with an EMPTY body
    // (`[data-layout-rounds-body]`) and a server-rendered count in its
    // summary — the actual list of matching historical rounds is only
    // fetched, via /api/layout-rounds.ts, the first time a visitor expands
    // it. Same recapCache-style memoization (keyed by circuitId+layout
    // rather than subsessionId) and the same WeakSet-not-dataset-flag
    // reasoning as boundRecapDetails above — a cloned card (see
    // showDayDetail()) must be treated as a distinct, not-yet-bound node.
    interface LayoutRoundLite {
      subsessionId: number;
      trackName: string;
      startTime: string;
      seasonLabel: string | null;
      /** Null for an exhibition/test/non-championship round — same meaning as everywhere else this display numbering is used (see computeDisplayRoundNumbers' own doc comment, src/lib/results.ts). */
      displayRoundNumber: number | null;
    }

    const layoutRoundsCache = new Map<string, Promise<LayoutRoundLite[] | null>>();
    const boundLayoutRoundsDetails = new WeakSet<HTMLDetailsElement>();

    /** Same date-only-vs-timestamp parsing as formatDate() in src/lib/supabase.ts. */
    function formatDate(dateInput: string | null): string {
      if (!dateInput) return '—';
      const dateOnlyMatch = /^(\d{4})-(\d{2})-(\d{2})$/.exec(dateInput);
      const date = dateOnlyMatch
        ? new Date(Number(dateOnlyMatch[1]), Number(dateOnlyMatch[2]) - 1, Number(dateOnlyMatch[3]))
        : new Date(dateInput);
      return date.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' });
    }

    function fetchLayoutRounds(circuitId: string, layout: string): Promise<LayoutRoundLite[] | null> {
      const key = `${circuitId}:${layout}`;
      if (!layoutRoundsCache.has(key)) {
        const params = new URLSearchParams({ circuitId });
        if (layout) params.set('layout', layout);
        layoutRoundsCache.set(
          key,
          fetch(`/api/layout-rounds?${params.toString()}`)
            .then((res) => (res.ok ? (res.json() as Promise<LayoutRoundLite[]>) : null))
            .catch(() => null)
        );
      }
      return layoutRoundsCache.get(key)!;
    }

    // Same "bypasses Astro's router, so drive the progress bar directly"
    // reasoning as fetchRoundRecapWithProgress above.
    function fetchLayoutRoundsWithProgress(circuitId: string, layout: string): Promise<LayoutRoundLite[] | null> {
      const key = `${circuitId}:${layout}`;
      const alreadyCached = layoutRoundsCache.has(key);
      if (alreadyCached) return fetchLayoutRounds(circuitId, layout);
      showProgress();
      return fetchLayoutRounds(circuitId, layout).finally(() => hideProgress());
    }

    function renderLayoutRounds(container: HTMLElement, rounds: LayoutRoundLite[] | null) {
      if (!rounds) {
        container.innerHTML = '<p class="text-xs text-white/40">Couldn’t load race recaps for this layout.</p>';
        return;
      }
      container.innerHTML = '';
      if (rounds.length === 0) {
        container.innerHTML = '<p class="text-xs text-white/40">No results on file for this layout.</p>';
        return;
      }

      rounds.forEach((r) => {
        const details = document.createElement('details');
        details.dataset.roundRecap = String(r.subsessionId);
        details.className = 'rounded-lg border border-white/10 bg-brand-ink px-3 py-2';

        const summary = document.createElement('summary');
        summary.className = 'cursor-pointer list-none text-xs font-semibold text-white/60 transition hover:text-white';
        // "Date: ATCX, Round X" per Logan — season label already comes back
        // in the "ATCxx" short form (season name), and displayRoundNumber
        // is the same app-computed "Round N" every other results view
        // shows; either half falls back to "Exhibition" when this round
        // isn't a numbered championship round.
        const roundLabel = r.displayRoundNumber !== null ? `Round ${r.displayRoundNumber}` : 'Exhibition';
        summary.textContent = `${formatDate(r.startTime)}: ${r.seasonLabel ?? 'Exhibition'}, ${roundLabel}`;
        details.appendChild(summary);

        const body = document.createElement('div');
        body.className = 'mt-2';
        body.dataset.recapBody = '';
        details.appendChild(body);

        container.appendChild(details);
      });

      // These <details data-round-recap> nodes are brand new — never seen by
      // initRoundRecaps() before — so re-run that same guarded initializer
      // to bind just these (already-bound ones elsewhere on the page are
      // unaffected, same as showDayDetail()'s identical call).
      initRoundRecaps();
    }

    function initLayoutRounds() {
      document.querySelectorAll<HTMLDetailsElement>('[data-layout-rounds-summary]').forEach((details) => {
        if (boundLayoutRoundsDetails.has(details)) return;
        boundLayoutRoundsDetails.add(details);

        details.addEventListener('toggle', () => {
          if (!details.open) return;
          const circuitId = details.dataset.circuitId;
          const layout = details.dataset.layout ?? '';
          const container = details.querySelector<HTMLElement>('[data-layout-rounds-body]');
          if (!container || !circuitId || container.dataset.loaded === 'true') return;
          container.dataset.loaded = 'true';
          container.innerHTML = '<p class="text-xs text-white/40">Loading…</p>';
          fetchLayoutRoundsWithProgress(circuitId, layout).then((rounds) => renderLayoutRounds(container, rounds));
        });
      });
    }

    // Pure client-side show/hide, same as the search-box filters elsewhere
    // on the site — the Past Events block is already fully rendered in the
    // DOM (see the template above), so this never needs a server round
    // trip and correctly doesn't trigger the pageProgress.ts loading bar.
    function initHidePastEventsToggle() {
      const checkbox = document.getElementById('hide-past-events') as HTMLInputElement | null;
      const block = document.getElementById('past-events-block');
      if (!checkbox || !block) return;

      checkbox.addEventListener('change', () => {
        block.classList.toggle('hidden', checkbox.checked);
      });
    }

    function initCalendarPage() {
      initViewToggle();
      initCalendarGrid();
      initHidePastEventsToggle();
      initRoundRecaps();
      initLayoutRounds();
    }

    document.addEventListener('astro:page-load', initCalendarPage);
  </script>
</Layout>

<script>
  // Shell-then-skeleton: fetches the calendar fragment (the expensive data work)
  // client-side once this shell has already painted — same pattern as
  // results.astro / standings.astro; see the matching fragment.astro for the
  // full explanation.
  function initCalendarResults() {
    const container = document.querySelector<HTMLElement>('[data-calendar-results]');
    const url = container?.dataset.fragmentUrl;
    if (!container || !url) return;
    // Cleared immediately so the synthetic astro:page-load dispatched below
    // doesn't see this same data-fragment-url and fetch it all over again.
    delete container.dataset.fragmentUrl;

    fetch(url)
      .then((res) => {
        if (!res.ok) throw new Error(`calendar fragment request failed (${res.status})`);
        return res.text();
      })
      .then((html) => {
        container.innerHTML = html;
        // reveal.ts only observes `.reveal` elements present at page-load
        // time; this content lands later, so mark it visible right away.
        container.querySelectorAll('.reveal').forEach((el) => el.classList.add('is-visible'));
        // Sortable tables, row expanders and this page's own scripts bind
        // against whatever exists at astro:page-load, so re-dispatch it now
        // that the real content is in place.
        document.dispatchEvent(new Event('astro:page-load'));
      })
      .catch((err) => {
        console.error('Failed to load calendar:', err);
        container.innerHTML = '<p class="mt-10 text-white/60">Couldn’t load this page right now — try refreshing.</p>';
      });
  }

  document.addEventListener('astro:page-load', initCalendarResults);
</script>
