---
export const prerender = false;

import Layout from '../layouts/Layout.astro';
import { resolveSupabaseEnv } from '../lib/supabase';
import { updatePassword, ACCESS_TOKEN_COOKIE, REFRESH_TOKEN_COOKIE, authCookieOptions } from '../lib/auth';

// The email link from /forgot-password redirects here with
// `#access_token=...&refresh_token=...&type=recovery` in the URL FRAGMENT,
// not a query string — fragments never reach the server, so there's no way
// to read them in this frontmatter. An inline script below (see the
// template) picks them out of location.hash on load and copies them into
// hidden fields on the form, which is what actually reaches this page's own
// POST handler. That access token is a normal, short-lived session token,
// so on a successful password change it's also used to sign the person in
// directly rather than sending them back to /login.

const supabaseEnv = resolveSupabaseEnv(Astro.locals);

let error: string | null = null;

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const password = String(form.get('password') ?? '');
  const confirmPassword = String(form.get('confirm_password') ?? '');
  const recoveryAccessToken = String(form.get('recovery_access_token') ?? '');
  const recoveryRefreshToken = String(form.get('recovery_refresh_token') ?? '');

  if (!recoveryAccessToken) {
    error = 'This reset link is invalid or has expired — request a new one.';
  } else if (password.length < 8) {
    error = 'Password must be at least 8 characters.';
  } else if (password !== confirmPassword) {
    error = "Passwords don't match.";
  } else {
    try {
      await updatePassword(supabaseEnv, recoveryAccessToken, password);
      // The recovery access token is already a valid session — sign them
      // straight in rather than making them log in again with the password
      // they just set.
      const cookieOptions = authCookieOptions(Astro.url);
      Astro.cookies.set(ACCESS_TOKEN_COOKIE, recoveryAccessToken, { ...cookieOptions, maxAge: 60 * 60 });
      if (recoveryRefreshToken) {
        Astro.cookies.set(REFRESH_TOKEN_COOKIE, recoveryRefreshToken, {
          ...cookieOptions,
          maxAge: 60 * 60 * 24 * 30,
        });
      }
      return Astro.redirect('/', 302);
    } catch (err) {
      console.error('Failed to update password:', err);
      error = err instanceof Error ? err.message : 'Failed to update your password — the link may have expired.';
    }
  }
}
---

<Layout title="Reset Password">
  <section class="mx-auto flex max-w-sm flex-col px-6 pb-24 pt-28 sm:pt-36">
    <h1 class="reveal font-display text-4xl">Reset Password</h1>
    <p class="reveal mt-2 text-sm text-white/60" style="transition-delay: 60ms">Choose a new password below.</p>

    {error && (
      <p class="reveal mt-6 break-words rounded-lg border border-brand-pink/30 bg-brand-pink/10 p-4 text-sm text-white/80">{error}</p>
    )}

    <p
      id="no-token-message"
      hidden
      class="reveal mt-6 rounded-lg border border-brand-pink/30 bg-brand-pink/10 p-4 text-sm text-white/80"
      style="transition-delay: 60ms"
    >
      This reset link is invalid, expired, or already used. <a href="/forgot-password" class="text-brand-primary hover:underline">Request a new one</a>.
    </p>

    <form
      id="reset-form"
      method="POST"
      data-astro-reload
      class="reveal mt-8 flex flex-col gap-4"
      style="transition-delay: 120ms"
    >
      <input type="hidden" name="recovery_access_token" id="recovery_access_token" value="" />
      <input type="hidden" name="recovery_refresh_token" id="recovery_refresh_token" value="" />
      <label class="flex flex-col gap-1.5 text-sm">
        <span class="text-white/70">New password</span>
        <input
          type="password"
          name="password"
          required
          minlength="8"
          autocomplete="new-password"
          class="rounded-md border border-white/15 bg-white/5 px-3 py-2 text-white outline-none focus:border-brand-primary"
        />
      </label>
      <label class="flex flex-col gap-1.5 text-sm">
        <span class="text-white/70">Confirm new password</span>
        <input
          type="password"
          name="confirm_password"
          required
          minlength="8"
          autocomplete="new-password"
          class="rounded-md border border-white/15 bg-white/5 px-3 py-2 text-white outline-none focus:border-brand-primary"
        />
      </label>
      <button
        type="submit"
        class="mt-2 rounded-lg bg-brand-primary px-6 py-3 font-semibold transition hover:brightness-110"
      >
        Set New Password
      </button>
    </form>
  </section>
</Layout>

<script>
  // Pulls access_token/refresh_token out of the URL fragment GoTrue's
  // recovery-email link redirects to (see the frontmatter's comment for why
  // this can't just be read server-side) and wires them into the form's
  // hidden fields before it can be submitted. Runs on real navigation to
  // this page — astro:page-load fires for the initial load too, not just
  // client-side transitions (see hard-form-submit.ts's own doc comment) —
  // but this page is only ever reached via the one-shot email link, so it's
  // not expected to run again after a submit.
  function initResetPassword() {
    const form = document.getElementById('reset-form') as HTMLFormElement | null;
    const noTokenMessage = document.getElementById('no-token-message');
    const accessField = document.getElementById('recovery_access_token') as HTMLInputElement | null;
    const refreshField = document.getElementById('recovery_refresh_token') as HTMLInputElement | null;
    if (!form || !noTokenMessage || !accessField || !refreshField) return;

    const params = new URLSearchParams(window.location.hash.slice(1));
    const accessToken = params.get('access_token');
    const type = params.get('type');

    if (accessToken && type === 'recovery') {
      accessField.value = accessToken;
      refreshField.value = params.get('refresh_token') ?? '';
      // The token doesn't need to sit in the address bar/history once it's
      // been captured into the form.
      history.replaceState(null, '', window.location.pathname);
    } else {
      form.hidden = true;
      noTokenMessage.hidden = false;
    }
  }

  document.addEventListener('astro:page-load', initResetPassword);
</script>
