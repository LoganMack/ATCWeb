---
export const prerender = false;

import Layout from '../layouts/Layout.astro';
import PageBanner from '../components/PageBanner.astro';
import { resolveSupabaseEnv, getPageBanners } from '../lib/supabase';
import { bannerUrlFor } from '../lib/pageBanners';

// Shell-then-skeleton split (same pattern as champions.astro / incidents.astro):
// this file only fetches the page banner and paints the heading plus a loading
// skeleton right away; the rounds list itself — which needs several Supabase
// round trips — lives in results/fragment.astro and is fetched client-side by
// the script below once this shell has already painted.
const supabaseEnv = resolveSupabaseEnv(Astro.locals);

let bannerUrl: string | null = null;
try {
  bannerUrl = bannerUrlFor(await getPageBanners(supabaseEnv), 'results');
} catch (err) {
  console.error('Failed to load page banner:', err);
}

Astro.response.headers.set('Cache-Control', 'public, s-maxage=60, stale-while-revalidate=300');
---

<Layout title="Race Results" description="Historical race-by-race results for every Alpha Touring Challenge round.">
  <section class="relative mx-auto max-w-5xl overflow-hidden px-6 pb-24 pt-8">
    <PageBanner imageUrl={bannerUrl} />
    <h1 class="reveal font-display text-2xl sm:text-5xl">Race Results</h1>

    <div data-results-results data-fragment-url={`/results/fragment${Astro.url.search}`}>
      <div class="mt-8" aria-live="polite" aria-busy="true">
        <span class="sr-only">Loading results…</span>
        <div class="h-[4.5rem] max-w-xs animate-pulse rounded-lg border border-white/10 bg-white/[0.03]"></div>
        <div class="mt-8 divide-y divide-white/10 rounded-xl border border-white/10">
          <div class="h-[4.5rem] animate-pulse bg-white/[0.03]"></div>
          <div class="h-[4.5rem] animate-pulse bg-white/[0.03]"></div>
          <div class="h-[4.5rem] animate-pulse bg-white/[0.03]"></div>
          <div class="h-[4.5rem] animate-pulse bg-white/[0.03]"></div>
          <div class="h-[4.5rem] animate-pulse bg-white/[0.03]"></div>
        </div>
      </div>
    </div>
  </section>
</Layout>

<script>
  // Shell-then-skeleton: fetches /results/fragment (the expensive data work) client-side
  // once this shell has already painted — same pattern as champions.astro /
  // incidents.astro; see results/fragment.astro for the full explanation.
  function initResultsResults() {
    const container = document.querySelector<HTMLElement>('[data-results-results]');
    const url = container?.dataset.fragmentUrl;
    if (!container || !url) return;
    // Cleared immediately so the synthetic astro:page-load dispatched below
    // doesn't see this same data-fragment-url and fetch it all over again.
    delete container.dataset.fragmentUrl;

    fetch(url)
      .then((res) => {
        if (!res.ok) throw new Error(`results fragment request failed (${res.status})`);
        return res.text();
      })
      .then((html) => {
        container.innerHTML = html;
        // reveal.ts only observes `.reveal` elements present at page-load
        // time; this content lands later, so mark it visible right away.
        container.querySelectorAll('.reveal').forEach((el) => el.classList.add('is-visible'));
        // Sortable tables, row expanders and this page's own filter/slider
        // scripts bind against whatever exists at astro:page-load, so
        // re-dispatch it now that the real content is in place.
        document.dispatchEvent(new Event('astro:page-load'));
      })
      .catch((err) => {
        console.error('Failed to load results:', err);
        container.innerHTML = '<p class="mt-10 text-white/60">Couldn’t load this page right now — try refreshing.</p>';
      });
  }

  document.addEventListener('astro:page-load', initResultsResults);
</script>
