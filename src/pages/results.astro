---
export const prerender = false;

import Layout from '../layouts/Layout.astro';
import PageBanner from '../components/PageBanner.astro';
import { resolveSupabaseEnv, getSeasons, getExhibitionRoundIds, getTestRoundIds, getPageBanners, formatDate } from '../lib/supabase';
import { getRoundsForSeason, isChampionshipSeason, computeDisplayRoundNumbers } from '../lib/results';
import { bannerUrlFor } from '../lib/pageBanners';

const supabaseEnv = resolveSupabaseEnv(Astro.locals);

let seasons: Awaited<ReturnType<typeof getSeasons>> = [];
let loadError = false;
try {
  seasons = await getSeasons(supabaseEnv);
} catch (err) {
  console.error('Failed to load results page seasons:', err);
  loadError = true;
}

// Any season whose name doesn't follow the "ATCxx" championship-naming
// format is a non-points-paying/for-fun exhibition — split the picker so
// it's obvious which is which, rather than mixing them into one list.
const championshipSeasons = seasons.filter((s) => isChampionshipSeason(s.name));
const exhibitionSeasons = seasons.filter((s) => !isChampionshipSeason(s.name));

const requestedSeasonNumber = Astro.url.searchParams.get('season');
const activeSeason =
  seasons.find((s) => String(s.number) === requestedSeasonNumber) ?? seasons.find((s) => s.is_current) ?? seasons[0];

let rounds: Awaited<ReturnType<typeof getRoundsForSeason>> = [];
let exhibitionRoundIds: Set<number> = new Set();
let testRoundIds: Set<number> = new Set();
if (!loadError && activeSeason) {
  try {
    [rounds, exhibitionRoundIds, testRoundIds] = await Promise.all([
      getRoundsForSeason(supabaseEnv, activeSeason.id),
      getExhibitionRoundIds(supabaseEnv),
      getTestRoundIds(supabaseEnv),
    ]);
  } catch (err) {
    console.error('Failed to load rounds:', err);
    loadError = true;
  }
}

// Displayed round numbers skip exhibitions entirely — see
// computeDisplayRoundNumbers — so an exhibition round just shows the
// "Exhibition" label instead of a "Round N" that would otherwise shift
// every later round's number. Computed from the FULL round list, before
// either filter below removes anything from what's actually rendered —
// hiding exhibition/test rounds from view shouldn't renumber the
// championship rounds still showing.
const displayRoundNumbers = computeDisplayRoundNumbers(rounds, exhibitionRoundIds);

// Opt-in hide filters — unchecked (i.e. show everything) is the default,
// matching this page's existing behavior before either filter existed, so
// nobody's view changes unless they actually check a box. Both checked
// against the same round list computeDisplayRoundNumbers already used
// above, not applied until after that numbering is settled.
const hideExhibition = Astro.url.searchParams.get('hideExhibition') === '1';
const hideTest = Astro.url.searchParams.get('hideTest') === '1';
const visibleRounds = rounds.filter((r) => {
  if (hideExhibition && exhibitionRoundIds.has(r.subsession_id)) return false;
  if (hideTest && testRoundIds.has(r.subsession_id)) return false;
  return true;
});

let bannerUrl: string | null = null;
try {
  bannerUrl = bannerUrlFor(await getPageBanners(supabaseEnv), 'results');
} catch (err) {
  console.error('Failed to load page banner:', err);
}

Astro.response.headers.set('Cache-Control', 'public, s-maxage=60, stale-while-revalidate=300');
---

<Layout title="Race Results" description="Historical race-by-race results for every Alpha Touring Challenge round.">
  <section class="relative mx-auto max-w-5xl overflow-hidden px-6 pb-24 pt-28 sm:pt-36">
    <PageBanner imageUrl={bannerUrl} />
    <h1 class="reveal font-display text-5xl">Race Results</h1>

    {loadError && (
      <p class="mt-4 rounded-lg border border-brand-pink/30 bg-brand-pink/10 p-4 text-sm text-white/80">
        Couldn't load results right now — check that PUBLIC_SUPABASE_URL and PUBLIC_SUPABASE_ANON_KEY are set.
      </p>
    )}

    {!loadError && (
      <form method="GET" class="mt-8 max-w-xs">
        <label class="flex flex-col gap-1.5 text-sm">
          <span class="text-white/60">Season</span>
          <div class="flex items-center gap-2">
            <select
              name="season"
              onchange="this.form.submit()"
              class="w-full rounded-md border border-white/15 bg-white/5 px-3 py-2 text-white outline-none focus:border-brand-primary"
            >
              <optgroup label="Championships" class="bg-brand-ink text-white">
                {championshipSeasons.map((s) => (
                  <option value={s.number} selected={s.id === activeSeason?.id} class="bg-brand-ink text-white">{s.name}</option>
                ))}
              </optgroup>
              {exhibitionSeasons.length > 0 && (
                <optgroup label="Exhibitions" class="bg-brand-ink text-white">
                  {exhibitionSeasons.map((s) => (
                    <option value={s.number} selected={s.id === activeSeason?.id} class="bg-brand-ink text-white">{s.name}</option>
                  ))}
                </optgroup>
              )}
            </select>
            {activeSeason?.logo_url && (
              <img src={activeSeason.logo_url} alt="" class="h-9 w-9 flex-none rounded object-contain" />
            )}
          </div>
        </label>
        <div class="mt-3 flex flex-wrap gap-x-5 gap-y-1.5">
          <label class="flex items-center gap-2 text-sm text-white/60">
            <input
              type="checkbox"
              name="hideExhibition"
              value="1"
              checked={hideExhibition}
              onchange="this.form.submit()"
              class="h-4 w-4 rounded border-white/20 bg-white/5 accent-brand-primary"
            />
            Hide exhibition rounds
          </label>
          <label class="flex items-center gap-2 text-sm text-white/60">
            <input
              type="checkbox"
              name="hideTest"
              value="1"
              checked={hideTest}
              onchange="this.form.submit()"
              class="h-4 w-4 rounded border-white/20 bg-white/5 accent-brand-primary"
            />
            Hide test rounds
          </label>
        </div>
      </form>
    )}

    {!loadError && rounds.length === 0 && (
      <p class="mt-10 text-white/60">No results.</p>
    )}

    {!loadError && rounds.length > 0 && visibleRounds.length === 0 && (
      <p class="mt-10 text-white/60">No rounds match the current filters.</p>
    )}

    {!loadError && visibleRounds.length > 0 && (
      <div class="mt-8 divide-y divide-white/10 rounded-xl border border-white/10">
        {visibleRounds.map((round) => {
          const displayNumber = displayRoundNumbers.get(round.subsession_id) ?? null;
          const isExhibition = displayNumber === null;
          const isTest = testRoundIds.has(round.subsession_id);
          return (
          <a
            href={`/results/${round.subsession_id}`}
            class="flex flex-wrap items-center justify-between gap-2 px-6 py-4 transition hover:bg-white/[0.03]"
          >
            <div>
              <p class="font-semibold">
                {isExhibition ? 'Exhibition — ' : `Round ${displayNumber} — `}{round.track_name}
              </p>
              <p class="text-sm text-white/50">
                {formatDate(round.start_time)}
                {round.format && ` · ${round.format === 'endurance' ? 'Endurance' : 'Sprint'}`}
              </p>
            </div>
            <div class="flex items-center gap-3 text-sm text-white/50">
              {isTest && (
                <span class="rounded-lg bg-white/10 px-2.5 py-1 text-xs font-semibold uppercase tracking-wide text-white/60">
                  Test
                </span>
              )}
              {round.strength_of_field !== null && <span>SoF {round.strength_of_field}</span>}
              {round.status !== 'official' && (
                <span class="rounded-lg bg-brand-gold/15 px-2.5 py-1 text-xs font-semibold uppercase tracking-wide text-brand-gold">
                  {round.status}
                </span>
              )}
            </div>
          </a>
          );
        })}
      </div>
    )}
  </section>
</Layout>
