---
export const prerender = false;

import Layout from '../layouts/Layout.astro';
import HistoryTabs from '../components/HistoryTabs.astro';
import { resolveSupabaseEnv, getSeasons, getExhibitionRoundIds, formatDate } from '../lib/supabase';
import { getRoundsForSeason, isChampionshipSeason, computeDisplayRoundNumbers } from '../lib/results';

const supabaseEnv = resolveSupabaseEnv(Astro.locals);

let seasons: Awaited<ReturnType<typeof getSeasons>> = [];
let loadError = false;
try {
  seasons = await getSeasons(supabaseEnv);
} catch (err) {
  console.error('Failed to load results page seasons:', err);
  loadError = true;
}

// Any season whose name doesn't follow the "ATCxx" championship-naming
// format is a non-points-paying/for-fun exhibition — split the picker so
// it's obvious which is which, rather than mixing them into one list.
const championshipSeasons = seasons.filter((s) => isChampionshipSeason(s.name));
const exhibitionSeasons = seasons.filter((s) => !isChampionshipSeason(s.name));

const requestedSeasonNumber = Astro.url.searchParams.get('season');
const activeSeason =
  seasons.find((s) => String(s.number) === requestedSeasonNumber) ?? seasons.find((s) => s.is_current) ?? seasons[0];

let rounds: Awaited<ReturnType<typeof getRoundsForSeason>> = [];
let exhibitionRoundIds: Set<number> = new Set();
if (!loadError && activeSeason) {
  try {
    [rounds, exhibitionRoundIds] = await Promise.all([
      getRoundsForSeason(supabaseEnv, activeSeason.id),
      getExhibitionRoundIds(supabaseEnv),
    ]);
  } catch (err) {
    console.error('Failed to load rounds:', err);
    loadError = true;
  }
}

// Displayed round numbers skip exhibitions entirely — see
// computeDisplayRoundNumbers — so an exhibition round just shows the
// "Exhibition" label instead of a "Round N" that would otherwise shift
// every later round's number.
const displayRoundNumbers = computeDisplayRoundNumbers(rounds, exhibitionRoundIds);

Astro.response.headers.set('Cache-Control', 'public, s-maxage=60, stale-while-revalidate=300');
---

<Layout title="Race Results" description="Historical race-by-race results for every Alpha Touring Challenge round.">
  <section class="mx-auto max-w-5xl px-6 pb-24 pt-28 sm:pt-36">
    <h1 class="reveal font-display text-5xl">Race Results</h1>

    <HistoryTabs active="results" />

    {loadError && (
      <p class="mt-4 rounded-lg border border-brand-pink/30 bg-brand-pink/10 p-4 text-sm text-white/80">
        Couldn't load results right now — check that PUBLIC_SUPABASE_URL and PUBLIC_SUPABASE_ANON_KEY are set.
      </p>
    )}

    {!loadError && (
      <form method="GET" class="max-w-xs">
        <label class="flex flex-col gap-1.5 text-sm">
          <span class="text-white/60">Season</span>
          <select
            name="season"
            onchange="this.form.submit()"
            class="rounded-md border border-white/15 bg-white/5 px-3 py-2 text-white outline-none focus:border-brand-primary"
          >
            <optgroup label="Championships" class="bg-brand-ink text-white">
              {championshipSeasons.map((s) => (
                <option value={s.number} selected={s.id === activeSeason?.id} class="bg-brand-ink text-white">{s.name}</option>
              ))}
            </optgroup>
            {exhibitionSeasons.length > 0 && (
              <optgroup label="Exhibitions" class="bg-brand-ink text-white">
                {exhibitionSeasons.map((s) => (
                  <option value={s.number} selected={s.id === activeSeason?.id} class="bg-brand-ink text-white">{s.name}</option>
                ))}
              </optgroup>
            )}
          </select>
        </label>
      </form>
    )}

    {!loadError && rounds.length === 0 && (
      <p class="mt-10 text-white/60">No results.</p>
    )}

    {!loadError && rounds.length > 0 && (
      <div class="mt-8 divide-y divide-white/10 rounded-xl border border-white/10">
        {rounds.map((round) => {
          const displayNumber = displayRoundNumbers.get(round.subsession_id) ?? null;
          const isExhibition = displayNumber === null;
          return (
          <a
            href={`/results/${round.subsession_id}`}
            class="flex flex-wrap items-center justify-between gap-2 px-6 py-4 transition hover:bg-white/[0.03]"
          >
            <div>
              <p class="font-semibold">
                {isExhibition ? 'Exhibition — ' : `Round ${displayNumber} — `}{round.track_name}
              </p>
              <p class="text-sm text-white/50">
                {formatDate(round.start_time)}
                {round.format && ` · ${round.format === 'endurance' ? 'Endurance' : 'Sprint'}`}
              </p>
            </div>
            <div class="flex items-center gap-3 text-sm text-white/50">
              {round.strength_of_field !== null && <span>SoF {round.strength_of_field}</span>}
              {round.status !== 'official' && (
                <span class="rounded-lg bg-brand-gold/15 px-2.5 py-1 text-xs font-semibold uppercase tracking-wide text-brand-gold">
                  {round.status}
                </span>
              )}
            </div>
          </a>
          );
        })}
      </div>
    )}
  </section>
</Layout>
