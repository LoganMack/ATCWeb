---
export const prerender = false;

import Layout from '../layouts/Layout.astro';
import HistoryTabs from '../components/HistoryTabs.astro';
import TeamLogo from '../components/TeamLogo.astro';
import { resolveSupabaseEnv, getDriverClasses, getSeasons, getExhibitionRoundIds, displayDriverName } from '../lib/supabase';
import {
  computeSeasonStandings,
  computeOverallSeasonStandings,
  getSeasonCarTeamStats,
  isChampionshipSeason,
  type DriverSeasonStanding,
  type DriverSeasonExtras,
} from '../lib/results';
import { classBadgeClasses } from '../lib/classColors';

const supabaseEnv = resolveSupabaseEnv(Astro.locals);

let classes: Awaited<ReturnType<typeof getDriverClasses>> = [];
let seasons: Awaited<ReturnType<typeof getSeasons>> = [];
let loadError: string | null = null;
try {
  [classes, seasons] = await Promise.all([getDriverClasses(supabaseEnv), getSeasons(supabaseEnv)]);
} catch (err) {
  console.error('Failed to load standings page filters:', err);
  loadError = err instanceof Error ? err.message : String(err);
}

// Exhibition seasons never have standings (computeSeasonStandings returns
// [] for them — see isChampionshipSeason), so the picker only offers real
// championship seasons in the first place.
const championshipSeasons = seasons.filter((s) => isChampionshipSeason(s.name));

const requestedSeasonNumber = Astro.url.searchParams.get('season');
const activeSeason =
  championshipSeasons.find((s) => String(s.number) === requestedSeasonNumber) ??
  championshipSeasons.find((s) => s.is_current) ??
  championshipSeasons[0];

const requestedClassName = Astro.url.searchParams.get('class');
const activeClass = classes.find((c) => c.name === requestedClassName) ?? classes.find((c) => c.name === 'Alpha') ?? classes[0];

const classNameById = new Map(classes.map((c) => [c.id, c.name]));

// Same "Overall combines every class, Per Class is the original view"
// toggle as the race results page, defaulting to Overall for the same
// reason — it's the table that actually matches how points work when
// class-only bonuses (class_points) are taken out of the mix (see
// computeOverallSeasonStandings).
const view = Astro.url.searchParams.get('view') === 'class' ? 'class' : 'overall';

let standings: DriverSeasonStanding[] = [];
let extrasByDriverId: Map<string, DriverSeasonExtras> = new Map();
if (!loadError && activeSeason) {
  try {
    const exhibitionRoundIds = await getExhibitionRoundIds(supabaseEnv);
    const [standingsResult, extras] = await Promise.all([
      view === 'class' && activeClass
        ? computeSeasonStandings(supabaseEnv, activeSeason, activeClass.id, undefined, exhibitionRoundIds, classes)
        : computeOverallSeasonStandings(supabaseEnv, activeSeason, undefined, exhibitionRoundIds),
      getSeasonCarTeamStats(supabaseEnv, activeSeason, exhibitionRoundIds),
    ]);
    standings = standingsResult;
    extrasByDriverId = extras;
  } catch (err) {
    console.error('Failed to compute standings:', err);
    loadError = err instanceof Error ? err.message : String(err);
  }
}

function raceWord(n: number): string {
  return `${n} race${n === 1 ? '' : 's'}`;
}

Astro.response.headers.set('Cache-Control', 'public, s-maxage=60, stale-while-revalidate=300');
---

<Layout title="Season Standings" description="Full season standings for every Alpha Touring Challenge season and class.">
  <section class="mx-auto max-w-6xl px-6 pb-24 pt-28 sm:pt-36">
    <h1 class="reveal font-display text-5xl">Season Standings</h1>

    <HistoryTabs active="standings" />

    {loadError && (
      <p class="mt-4 rounded-lg border border-brand-pink/30 bg-brand-pink/10 p-4 text-sm text-white/80">
        Couldn't load standings right now. If this mentions permission/RLS, race_scores or curated_race_results
        likely still need the public-read policy from <code>supabase/migrations/0004_champions.sql</code> —
        it has to be run manually in the Supabase SQL editor.
        <br /><span class="mt-1 block text-white/50">{loadError}</span>
      </p>
    )}

    {!loadError && (
      <div class="mt-8 flex flex-wrap items-end justify-between gap-4">
        <form method="GET" class="flex flex-wrap items-end gap-4">
          <input type="hidden" name="view" value={view} />
          <label class="flex flex-col gap-1.5 text-sm">
            <span class="text-white/60">Season</span>
            <select
              name="season"
              onchange="this.form.submit()"
              class="rounded-md border border-white/15 bg-white/5 px-3 py-2 text-white outline-none focus:border-brand-primary"
            >
              {championshipSeasons.map((s) => (
                <option value={s.number} selected={s.id === activeSeason?.id} class="bg-brand-ink text-white">{s.name}</option>
              ))}
            </select>
          </label>
          {view === 'class' && (
            <label class="flex flex-col gap-1.5 text-sm">
              <span class="text-white/60">Class</span>
              <select
                name="class"
                onchange="this.form.submit()"
                class="rounded-md border border-white/15 bg-white/5 px-3 py-2 text-white outline-none focus:border-brand-primary"
              >
                {classes.map((c) => (
                  <option value={c.name} selected={c.id === activeClass?.id} class="bg-brand-ink text-white">{c.name}</option>
                ))}
              </select>
            </label>
          )}
        </form>

        <div class="flex gap-2">
          <a
            href={`/standings?view=overall${activeSeason ? `&season=${activeSeason.number}` : ''}`}
            class={`rounded-lg px-4 py-1.5 text-sm font-semibold ring-1 ring-white/15 transition ${
              view === 'overall' ? 'bg-white text-brand-ink' : 'text-white/80 hover:bg-white/10'
            }`}
          >
            Overall
          </a>
          <a
            href={`/standings?view=class${activeSeason ? `&season=${activeSeason.number}` : ''}${activeClass ? `&class=${activeClass.name}` : ''}`}
            class={`rounded-lg px-4 py-1.5 text-sm font-semibold ring-1 ring-white/15 transition ${
              view === 'class' ? 'bg-white text-brand-ink' : 'text-white/80 hover:bg-white/10'
            }`}
          >
            Per Class
          </a>
        </div>
      </div>
    )}

    {!loadError && standings.length === 0 && (
      <p class="mt-10 text-white/60">No results.</p>
    )}

    {!loadError && standings.length > 0 && (
      <div class="mt-8 overflow-x-auto rounded-xl border border-white/10">
        <table class="w-full border-collapse" data-sortable>
          <thead>
            <tr class="border-b border-white/10 text-left text-xs uppercase tracking-wide text-white/40">
              <th class="py-3 pl-4 pr-2 font-medium" data-sort-key="position">Pos</th>
              <th class="py-3 pr-3 font-medium" data-sort-key="driver">Driver</th>
              {view === 'overall' && <th class="hidden py-3 pr-3 font-medium sm:table-cell">Class</th>}
              <th class="py-3 pr-3 text-center font-medium" data-sort-key="points">Points</th>
              <th class="hidden py-3 pr-3 text-center font-medium sm:table-cell" data-sort-key="wins">Wins</th>
              <th class="hidden py-3 pr-3 text-center font-medium sm:table-cell" data-sort-key="podiums">Podiums</th>
              <th class="hidden py-3 pr-3 text-center font-medium md:table-cell" data-sort-key="top5">Top 5<span class="lowercase">s</span></th>
              <th class="hidden py-3 pr-3 text-center font-medium md:table-cell" data-sort-key="top10">Top 10<span class="lowercase">s</span></th>
              <th class="hidden py-3 pr-3 text-center font-medium lg:table-cell" data-sort-key="poles">Poles</th>
              <th class="hidden py-3 pr-3 text-center font-medium lg:table-cell" data-sort-key="starts">Starts</th>
              <th class="py-3 pr-4 text-center font-medium" data-sort-key="appearances">Apps</th>
            </tr>
          </thead>
          <tbody>
            {standings.map((row) => {
              const extras = extrasByDriverId.get(row.driver.id);
              return (
                <tr class="border-b border-white/5 text-sm transition hover:bg-white/[0.04]">
                  <td class="py-2.5 pl-4 pr-2 font-display text-lg leading-none text-white/70" data-col="position">{row.position}</td>
                  <td class="py-2.5 pr-3 font-semibold" data-col="driver" data-sort-value={row.driver.name}>
                    <div class="flex flex-wrap items-center gap-2">
                      <span>
                        {displayDriverName(row.driver.name)} {row.driver.car_number !== null && <span class="text-white/40">#{row.driver.car_number}</span>}
                      </span>
                      {/* Cars first, teams second — every driver has a car, not every driver has a team. */}
                      {extras?.cars.map((c) => (
                        <TeamLogo name={c.carName} logoUrl={c.logoUrl} size="h-5 w-5" title={`${c.carName} — ${raceWord(c.races)}`} />
                      ))}
                      {extras?.teams.map((t) => (
                        <TeamLogo
                          name={t.teamName}
                          logoUrl={t.logoUrl}
                          size="h-5 w-5"
                          title={`${t.teamName} — ${raceWord(t.racesUnderTeam)} under this team, ${raceWord(t.racesScoredForTeam)} scored for the team`}
                        />
                      ))}
                    </div>
                  </td>
                  {view === 'overall' && (
                    <td class="hidden py-2.5 pr-3 sm:table-cell">
                      {row.classId !== undefined && (
                        <span class={`rounded-lg border px-2 py-0.5 text-[11px] font-semibold uppercase tracking-wide ${classBadgeClasses(classNameById.get(row.classId) ?? '')}`}>
                          {classNameById.get(row.classId) ?? '—'}
                        </span>
                      )}
                    </td>
                  )}
                  <td class="py-2.5 pr-3 text-center font-semibold" data-col="points">{row.totalPoints}</td>
                  <td class="hidden py-2.5 pr-3 text-center text-white/60 sm:table-cell" data-col="wins">{row.wins}</td>
                  <td class="hidden py-2.5 pr-3 text-center text-white/60 sm:table-cell" data-col="podiums">{row.podiums}</td>
                  <td class="hidden py-2.5 pr-3 text-center text-white/60 md:table-cell" data-col="top5">{row.top5s}</td>
                  <td class="hidden py-2.5 pr-3 text-center text-white/60 md:table-cell" data-col="top10">{row.top10s}</td>
                  <td class="hidden py-2.5 pr-3 text-center text-white/60 lg:table-cell" data-col="poles">{row.poles}</td>
                  <td class="hidden py-2.5 pr-3 text-center text-white/60 lg:table-cell" data-col="starts">{row.starts}</td>
                  <td class="py-2.5 pr-4 text-center text-white/60" data-col="appearances">{row.appearances}</td>
                </tr>
              );
            })}
          </tbody>
        </table>
      </div>
    )}
  </section>
</Layout>
