---
export const prerender = false;

import Layout from '../layouts/Layout.astro';
import PageBanner from '../components/PageBanner.astro';
import { resolveSupabaseEnv, getPageBanners } from '../lib/supabase';
import { bannerUrlFor } from '../lib/pageBanners';

// Shell-then-skeleton split (same pattern as champions.astro / incidents.astro):
// this file only fetches the page banner and paints the heading plus a loading
// skeleton right away; the standings themselves (filters, season computation,
// graph/matrix data) live in standings/fragment.astro and are fetched
// client-side by the loader script at the bottom once this shell has painted.
// The page's own interaction scripts (Standings by Round slider, graph) also
// live here, since a <script> inside fetched HTML never executes — they bind
// to the fragment's elements when its astro:page-load re-dispatch fires.
const supabaseEnv = resolveSupabaseEnv(Astro.locals);
const championship: 'drivers' | 'teams' = Astro.url.searchParams.get('championship') === 'teams' ? 'teams' : 'drivers';

let bannerUrl: string | null = null;
try {
  const banners = await getPageBanners(supabaseEnv);
  const drivers = bannerUrlFor(banners, 'standings');
  const teams = bannerUrlFor(banners, 'team-standings');
  bannerUrl = championship === 'teams' ? (teams ?? drivers) : drivers;
} catch (err) {
  console.error('Failed to load page banner:', err);
}

Astro.response.headers.set('Cache-Control', 'public, s-maxage=60, stale-while-revalidate=300');
---

<Layout title="Season Standings" description="Full season driver and team standings for every Alpha Touring Challenge season and class.">
  <section class="relative mx-auto max-w-6xl px-6 pb-24 pt-8">
    <PageBanner imageUrl={bannerUrl} />
    <h1 class="reveal font-display text-2xl sm:text-5xl">Season Standings</h1>

    <div data-standings-results data-fragment-url={`/standings/fragment${Astro.url.search}`}>
      <div class="mt-16 flex flex-col gap-5" aria-live="polite" aria-busy="true">
        <span class="sr-only">Loading standings…</span>
        <div class="flex flex-wrap items-end gap-4">
          <div class="h-9 w-44 animate-pulse rounded-md border border-white/10 bg-white/[0.03]"></div>
          <div class="h-9 w-44 animate-pulse rounded-md border border-white/10 bg-white/[0.03]"></div>
          <div class="h-9 w-44 animate-pulse rounded-md border border-white/10 bg-white/[0.03]"></div>
        </div>
        <div class="h-[28rem] animate-pulse rounded-xl border border-white/10 bg-white/[0.02]"></div>
      </div>
    </div>
  </section>
</Layout>

<script>
  // Shell-then-skeleton: fetches /standings/fragment (the expensive data work) client-side
  // once this shell has already painted — same pattern as champions.astro /
  // incidents.astro; see standings/fragment.astro for the full explanation.
  function initStandingsResults() {
    const container = document.querySelector<HTMLElement>('[data-standings-results]');
    const url = container?.dataset.fragmentUrl;
    if (!container || !url) return;
    // Cleared immediately so the synthetic astro:page-load dispatched below
    // doesn't see this same data-fragment-url and fetch it all over again.
    delete container.dataset.fragmentUrl;

    fetch(url)
      .then((res) => {
        if (!res.ok) throw new Error(`standings fragment request failed (${res.status})`);
        return res.text();
      })
      .then((html) => {
        container.innerHTML = html;
        // reveal.ts only observes `.reveal` elements present at page-load
        // time; this content lands later, so mark it visible right away.
        container.querySelectorAll('.reveal').forEach((el) => el.classList.add('is-visible'));
        // Sortable tables, row expanders and this page's own filter/slider
        // scripts bind against whatever exists at astro:page-load, so
        // re-dispatch it now that the real content is in place.
        document.dispatchEvent(new Event('astro:page-load'));
      })
      .catch((err) => {
        console.error('Failed to load standings:', err);
        container.innerHTML = '<p class="mt-10 text-white/60">Couldn’t load this page right now — try refreshing.</p>';
      });
  }

  document.addEventListener('astro:page-load', initStandingsResults);
</script>


<script>
  // "Standings by Round" slider: shows the standings as they were after round
  // N, for both the List and Matrix views, Drivers and Teams.
  //  - Matrix: round columns after N are hidden.
  //  - Every number is recomputed from just the visible rounds. Driver totals
  //    use the same drop-week rules as the real standings (src/lib/results.ts
  //    finalizeStandings): skipped rounds count as 0 in the pool, no rounds
  //    drop until 5+ are visible, then baseline + the season's extra drop
  //    weeks, and (unless the ruleset allows it) the last visible round can't
  //    be dropped. Teams never drop rounds.
  //  - Rows are re-ranked with the real tiebreak order (wins, podiums, top 5s,
  //    top 10s, poles, laps led, laps, appearances, then name) and Pos
  //    renumbered; anyone who hadn't raced yet is hidden. Team rosters show
  //    each driver's as-of overall position (ties there fall back to the
  //    full-season order).
  //  - At the slider's max everything is restored to the server's exact values.
  function initStandingsSlider() {
    const slider = document.getElementById('timeline-slider') as HTMLInputElement | null;
    const table = document.getElementById('standings-table') as HTMLTableElement | null;
    if (!slider || slider.dataset.bound === 'true') return;
    slider.dataset.bound = 'true';
    // Position the floating round tag and the filled part of the track (CSS in
    // global.css under .round-slider reads --p / --steps from the wrapper).
    const sliderBox = slider.parentElement;
    const placeSlider = () => {
      const min = Number(slider.min);
      const max = Number(slider.max);
      const p = max > min ? (Number(slider.value) - min) / (max - min) : 1;
      sliderBox?.style.setProperty('--p', `${p * 100}%`);
      sliderBox?.style.setProperty('--f', String(p));
      sliderBox?.style.setProperty('--steps', String(Math.max(1, max - min)));
    };
    slider.addEventListener('input', placeSlider);
    placeSlider();
    if (!table) {
      // Graph view has no table — the graph script listens to the slider itself;
      // this just keeps the label and the carried-over `round` param current.
      const gCols: { r: number | null }[] = JSON.parse(slider.dataset.cols ?? '[]');
      const gLabel = document.getElementById('timeline-slider-value');
      const gInput = document.getElementById('timeline-round') as HTMLInputElement | null;
      const gApply = () => {
        const gn = Number(slider.value);
        const text = String(gCols[gn - 1]?.r ?? gn);
        if (gLabel) gLabel.textContent = `R${text}`;
        if (gInput) {
          gInput.disabled = gn >= gCols.length;
          gInput.value = text;
        }
      };
      slider.addEventListener('input', gApply);
      gApply();
      return;
    }

    const kind = table.dataset.kind === 'teams' ? 'teams' : 'drivers';
    const cols: { r: number | null; t: string }[] = JSON.parse(slider.dataset.cols ?? '[]');
    const maxN = cols.length;
    const label = document.getElementById('timeline-slider-value');
    const roundInput = document.getElementById('timeline-round') as HTMLInputElement | null;
    const tbody = table.tBodies[0];
    const baseDrops = Number(table.dataset.dropWeeks ?? 0);
    const driverDrops = Number(table.dataset.driverDropWeeks ?? 2);
    const minDropRounds = Number(table.dataset.minDropRounds ?? 5);
    const canDropFinal = table.dataset.canDropFinal === 'true';
    const denoms: { s: number; a: number }[] = JSON.parse(table.dataset.denoms ?? '[]');
    const DROPPED_CLASSES = ['text-white/35', 'line-through', 'decoration-white/25'];

    const rows = Array.from(tbody.querySelectorAll<HTMLTableRowElement>('tr[data-standings-row]')).map((row) => ({
      row,
      detail: row.nextElementSibling?.hasAttribute('data-detail-row') ? (row.nextElementSibling as HTMLElement) : null,
      origIndex: Number(row.dataset.origIndex),
      name: row.dataset.name ?? '',
      rounds: JSON.parse(row.dataset.rounds ?? '[]') as (number[] | null)[],
      pp: JSON.parse(row.dataset.pp ?? '[]') as number[],
    }));

    const rosterEl = document.getElementById('roster-data');
    const roster: { t: string[]; d: Record<string, { o: number; r: (number[] | null)[] }> } | null = rosterEl
      ? JSON.parse(rosterEl.textContent ?? 'null')
      : null;

    // Original server-rendered content of every live cell, to restore at max.
    const origHtml = new Map<Element, string>();
    document.querySelectorAll('[data-live], [data-roster-text]').forEach((el) => origHtml.set(el, el.innerHTML));
    const origSort = new Map<HTMLElement, string | undefined>();
    document.querySelectorAll<HTMLElement>('[data-live]').forEach((el) => origSort.set(el, el.dataset.sortValue));

    function totalAsOf(points: (number | null)[], n: number, drops: number) {
      const pool = points.slice(0, n).map((p, i) => ({ i, p: p ?? 0 }));
      const totalDrops = n >= minDropRounds ? drops : 0;
      const dropped = new Set<number>();
      let total: number;
      if (!canDropFinal && n >= 1) {
        const finalPts = pool[n - 1].p;
        const rest = pool.slice(0, n - 1).sort((a, b) => b.p - a.p || a.i - b.i);
        const dropCount = Math.min(totalDrops, Math.max(0, n - 1));
        const keep = Math.max(0, rest.length - dropCount);
        total = finalPts + rest.slice(0, keep).reduce((s, r) => s + r.p, 0);
        rest.slice(keep).forEach((r) => dropped.add(r.i));
      } else {
        const ranked = [...pool].sort((a, b) => b.p - a.p || a.i - b.i);
        const dropCount = Math.min(totalDrops, Math.max(0, ranked.length - 1));
        total = ranked.slice(0, ranked.length - dropCount).reduce((s, r) => s + r.p, 0);
        ranked.slice(ranked.length - dropCount).forEach((r) => dropped.add(r.i));
      }
      return { total, dropped };
    }

    const sumIdx = (rounds: (number[] | null)[], n: number, idx: number) => {
      let s = 0;
      for (let i = 0; i < n; i++) s += rounds[i]?.[idx] ?? 0;
      return s;
    };
    const live = (row: ParentNode, key: string) => row.querySelector<HTMLElement>(`[data-live="${key}"]`);
    const setText = (row: ParentNode | null, key: string, text: string, sortValue?: number) => {
      const el = row ? live(row, key) : null;
      if (!el) return;
      el.textContent = text;
      if (sortValue !== undefined) el.dataset.sortValue = String(sortValue);
    };
    const setOfText = (row: ParentNode, key: string, value: number, denom: number | undefined) => {
      const el = live(row, key);
      if (!el) return;
      el.innerHTML = `${value} <span class="text-white/30">of ${denom ?? ''}</span>`;
      el.dataset.sortValue = String(value);
    };

    function setDropped(span: HTMLElement, isDropped: boolean) {
      DROPPED_CLASSES.forEach((c) => span.classList.toggle(c, isDropped));
      span.classList.toggle('text-white/80', !isDropped);
      const pts = span.textContent?.trim() ?? '';
      span.title = `${isDropped ? 'Dropped round — ' : ''}${pts} pts`;
    }

    function restoreAll() {
      origHtml.forEach((html, el) => (el.innerHTML = html));
      origSort.forEach((v, el) => {
        if (v === undefined) delete el.dataset.sortValue;
        else el.dataset.sortValue = v;
      });
      rows.forEach((r) => {
        r.row.style.display = '';
        if (r.detail) r.detail.style.display = '';
        [...r.row.querySelectorAll<HTMLElement>('[data-cell-points]'), ...(r.detail ? r.detail.querySelectorAll<HTMLElement>('[data-cell-points]') : [])].forEach((span) =>
          setDropped(span, span.dataset.origDropped === 'true')
        );
      });
      [...rows]
        .sort((a, b) => a.origIndex - b.origIndex)
        .forEach((r) => {
          tbody.appendChild(r.row);
          if (r.detail) tbody.appendChild(r.detail);
        });
      table!.querySelectorAll<HTMLElement>('[data-roster]').forEach((box) => {
        const items = Array.from(box.querySelectorAll<HTMLElement>('[data-roster-driver]'));
        items.forEach((it) => (it.style.display = ''));
        items.sort((a, b) => Number(a.dataset.origPos) - Number(b.dataset.origPos)).forEach((it) => box.appendChild(it));
      });
    }

    function updateRosters(n: number) {
      if (!roster) return;
      const cutoff = Date.parse(cols[n - 1].t);
      const nOverall = roster.t.filter((t) => Date.parse(t) <= cutoff).length;
      const asOf = Object.entries(roster.d)
        .map(([id, d]) => {
          const pts = d.r.map((r) => (r ? r[0] : null));
          const attended = d.r.slice(0, nOverall).some((r) => r !== null);
          return { id, o: d.o, attended, total: totalAsOf(pts, nOverall, driverDrops).total, starts: sumIdx(d.r, nOverall, 1) };
        })
        .filter((d) => d.attended)
        .sort((a, b) => b.total - a.total || a.o - b.o);
      const byId = new Map(asOf.map((d, i) => [d.id, { ...d, pos: i + 1 }]));
      table!.querySelectorAll<HTMLElement>('[data-roster]').forEach((box) => {
        const items = Array.from(box.querySelectorAll<HTMLElement>('[data-roster-driver]'));
        items.forEach((it) => {
          const info = byId.get(it.dataset.rosterDriver ?? '');
          it.style.display = info ? '' : 'none';
          const text = it.querySelector('[data-roster-text]');
          if (info && text) text.textContent = `P${info.pos} — ${info.total} pts — ${info.starts} starts`;
          it.dataset.livePos = String(info ? info.pos : 9999);
        });
        items.sort((a, b) => Number(a.dataset.livePos) - Number(b.dataset.livePos)).forEach((it) => box.appendChild(it));
      });
    }

    function apply() {
      const n = Number(slider!.value);
      const atMax = n >= maxN;
      const roundText = String(cols[n - 1]?.r ?? n);
      if (label) label.textContent = `R${roundText}`;
      if (roundInput) {
        roundInput.disabled = atMax;
        roundInput.value = roundText;
      }
      document.querySelectorAll<HTMLElement>('[data-round-col]').forEach((el) => {
        el.classList.toggle('hidden', Number(el.dataset.roundCol) >= n);
      });

      if (atMax) {
        restoreAll();
        return;
      }

      const visible: { r: (typeof rows)[number]; keys: number[] }[] = [];
      for (const r of rows) {
        const attended = r.rounds.slice(0, n).some((x) => x !== null);
        r.row.style.display = attended ? '' : 'none';
        if (r.detail) r.detail.style.display = attended ? '' : 'none';
        if (!attended) continue;

        const pts = r.rounds.map((x) => (x ? x[0] : null));
        const { total, dropped } = totalAsOf(pts, n, baseDrops);
        const apps = r.rounds.slice(0, n).filter((x) => x !== null).length;
        let keys: number[];

        if (kind === 'drivers') {
          const wins = sumIdx(r.rounds, n, 1);
          const podiums = sumIdx(r.rounds, n, 2);
          const top5 = sumIdx(r.rounds, n, 3);
          const top10 = sumIdx(r.rounds, n, 4);
          const poles = sumIdx(r.rounds, n, 5);
          const starts = sumIdx(r.rounds, n, 6);
          const ledTb = sumIdx(r.rounds, n, 7);
          const lapsTb = sumIdx(r.rounds, n, 8);
          keys = [total, wins, podiums, top5, top10, poles, ledTb, lapsTb, apps];

          setText(r.row, 'total', String(total));
          setText(r.row, 'wins', String(wins));
          setText(r.row, 'podiums', String(podiums));
          setText(r.row, 'top5', String(top5));
          setText(r.row, 'top10', String(top10));
          setText(r.row, 'poles', String(poles));
          setOfText(r.row, 'starts', starts, denoms[n - 1]?.s);
          setOfText(r.row, 'apps', apps, denoms[n - 1]?.a);
          const pp = r.pp.slice(0, n).reduce((s, v) => s + v, 0);
          setText(r.row, 'pp', String(pp), pp);

          if (r.detail) {
            const laps = sumIdx(r.rounds, n, 9);
            const led = sumIdx(r.rounds, n, 10);
            const net = sumIdx(r.rounds, n, 11);
            const inc = sumIdx(r.rounds, n, 12);
            const bonus = sumIdx(r.rounds, n, 13);
            const visibleRounds = r.rounds.slice(0, n);
            const anyKm = visibleRounds.some((x) => x && x[14] !== null);
            const anyCor = visibleRounds.some((x) => x && x[15] !== null);
            const dist = sumIdx(r.rounds, n, 14);
            const cor = sumIdx(r.rounds, n, 15);
            setText(r.detail, 'mtotal', String(total));
            setText(r.detail, 'dlaps', String(laps));
            setText(r.detail, 'dled', String(led));
            setText(r.detail, 'dnet', `${net > 0 ? '+' : ''}${net}`);
            setText(r.detail, 'dipl', laps > 0 ? (inc / laps).toFixed(2) : '—');
            setText(r.detail, 'dcpi', anyCor && inc > 0 ? (cor / inc).toFixed(1) : '—');
            setText(r.detail, 'dpp', String(pp));
            setText(r.detail, 'dbonus', String(bonus));
            setText(r.detail, 'ddist', anyKm ? `${dist.toFixed(1)} km` : '—');
          }
        } else {
          keys = [total];
          setText(r.row, 'total', String(total));
          const starts = sumIdx(r.rounds, n, 1);
          setText(r.row, 'starts', String(starts), starts);
          setText(r.row, 'apps', String(apps), apps);
        }

        // Matrix cells (the Matrix view's row, and a driver's own line in the expanded detail): dropped-round styling as of this point in the season.
        const matrixCells = [...r.row.querySelectorAll<HTMLElement>('[data-cell-points]'), ...(r.detail ? r.detail.querySelectorAll<HTMLElement>('[data-cell-points]') : [])];
        matrixCells.forEach((span) => {
          const td = span.closest<HTMLElement>('[data-round-col]');
          if (td) setDropped(span, dropped.has(Number(td.dataset.roundCol)));
        });
        visible.push({ r, keys });
      }

      visible.sort((a, b) => {
        for (let i = 0; i < a.keys.length; i++) {
          if (b.keys[i] !== a.keys[i]) return b.keys[i] - a.keys[i];
        }
        return a.r.name.localeCompare(b.r.name);
      });
      const hiddenRows = rows.filter((r) => !visible.some((v) => v.r === r)).sort((a, b) => a.origIndex - b.origIndex);
      visible.forEach((v, i) => {
        setText(v.r.row, 'pos', String(i + 1));
        tbody.appendChild(v.r.row);
        if (v.r.detail) tbody.appendChild(v.r.detail);
      });
      hiddenRows.forEach((r) => {
        tbody.appendChild(r.row);
        if (r.detail) tbody.appendChild(r.detail);
      });
      if (kind === 'teams') updateRosters(n);
    }

    slider.addEventListener('input', apply);
    apply();
  }
  initStandingsSlider();
  document.addEventListener('astro:page-load', initStandingsSlider);
</script>

<script>
  // Graph view: cumulative points per driver/team (a running sum of each
  // round's points — drop weeks are NOT applied here, so lines can end above
  // the Total shown in List/Matrix). Hand-drawn SVG, no chart library. The
  // "Standings by Round" slider trims the x-axis to the first N rounds.
  function initStandingsGraph() {
    const root = document.getElementById('standings-graph');
    const dataEl = document.getElementById('graph-data');
    const plot = document.getElementById('graph-plot');
    const legend = document.getElementById('graph-legend');
    if (!root || !dataEl || !plot || !legend || root.dataset.bound === 'true') return;
    root.dataset.bound = 'true';

    type Series = { id: string; name: string; short: string; tag: string; cum: (number | null)[] };
    const data = JSON.parse(dataEl.textContent ?? '{}') as { cols: { r: number | null; t: string; k: string }[]; series: Series[] };
    const slider = document.getElementById('timeline-slider') as HTMLInputElement | null;
    const SVG = 'http://www.w3.org/2000/svg';
    const TOP = 8;
    const colorOf = (idx: number) => (idx < TOP ? `var(--g-${idx + 1})` : 'var(--g-muted)');
    const shown = new Set(data.series.slice(0, TOP).map((s) => s.id));

    function el<K extends keyof SVGElementTagNameMap>(tag: K, attrs: Record<string, string | number>) {
      const e = document.createElementNS(SVG, tag);
      for (const [k, v] of Object.entries(attrs)) e.setAttribute(k, String(v));
      return e;
    }
    function niceStep(raw: number) {
      const pow = Math.pow(10, Math.floor(Math.log10(raw)));
      const f = raw / pow;
      return (f <= 1 ? 1 : f <= 2 ? 2 : f <= 5 ? 5 : 10) * pow;
    }

    let n = slider ? Number(slider.value) : data.cols.length;
    let highlight: string | null = null;

    const tip = document.createElement('div');
    tip.className =
      'pointer-events-none absolute z-20 hidden min-w-[11rem] max-w-[16rem] rounded-md border border-white/15 bg-brand-ink px-3 py-2 text-xs shadow-lg';
    plot.appendChild(tip);

    function render() {
      plot!.querySelector('svg')?.remove();
      const w = Math.max(280, plot!.clientWidth);
      const h = w < 520 ? 300 : 420;
      const m = { l: 44, r: w < 520 ? 12 : 104, t: 12, b: 30 };
      const iw = w - m.l - m.r;
      const ih = h - m.t - m.b;
      const visible = data.series.map((s, idx) => ({ s, idx })).filter((x) => shown.has(x.s.id));
      const pool = visible.length ? visible : data.series.map((s, idx) => ({ s, idx }));
      let ymax = 10;
      for (const { s } of pool) for (let i = 0; i < n; i++) ymax = Math.max(ymax, s.cum[i] ?? 0);
      const step = niceStep(ymax / 5);
      const top = Math.ceil(ymax / step) * step;
      const X = (i: number) => m.l + (n > 1 ? (i / (n - 1)) * iw : iw / 2);
      const Y = (v: number) => m.t + ih - (v / top) * ih;

      const svg = el('svg', { width: w, height: h, viewBox: `0 0 ${w} ${h}`, role: 'img', 'aria-label': 'Cumulative points by round' });
      svg.style.display = 'block';
      // Grid + y axis labels
      for (let v = 0; v <= top + 0.001; v += step) {
        svg.appendChild(el('line', { x1: m.l, x2: w - m.r, y1: Y(v), y2: Y(v), stroke: 'var(--g-grid)', 'stroke-width': 1 }));
        const t = el('text', { x: m.l - 8, y: Y(v) + 4, 'text-anchor': 'end', fill: 'var(--g-axis)', 'font-size': 11 });
        t.textContent = String(Math.round(v));
        svg.appendChild(t);
      }
      // x axis labels (thinned so they never collide)
      const every = Math.max(1, Math.ceil(n / Math.max(2, Math.floor(iw / 36))));
      for (let i = 0; i < n; i++) {
        if (i % every !== 0 && i !== n - 1) continue;
        const t = el('text', { x: X(i), y: h - 10, 'text-anchor': 'middle', fill: 'var(--g-axis)', 'font-size': 11 });
        t.textContent = `R${data.cols[i].r ?? i + 1}`;
        svg.appendChild(t);
      }
      // Lines — muted (beyond the 8 named hues) first so coloured ones sit on top
      const ordered = [...visible].sort((a, b) => Number(b.idx >= TOP) - Number(a.idx >= TOP));
      const paths = new Map<string, SVGPathElement>();
      for (const { s, idx } of ordered) {
        let d = '';
        for (let i = 0; i < n; i++) {
          const v = s.cum[i];
          if (v === null) continue;
          d += `${d ? 'L' : 'M'}${X(i).toFixed(1)},${Y(v).toFixed(1)}`;
        }
        if (!d) continue;
        const p = el('path', {
          d,
          fill: 'none',
          stroke: colorOf(idx),
          'stroke-width': highlight === s.id ? 3.5 : 2,
          'stroke-linejoin': 'round',
          'stroke-linecap': 'round',
          opacity: highlight && highlight !== s.id ? 0.35 : 1,
        });
        paths.set(s.id, p);
        svg.appendChild(p);
        // end marker with a surface ring
        const last = (() => {
          for (let i = n - 1; i >= 0; i--) if (s.cum[i] !== null) return i;
          return -1;
        })();
        if (last >= 0) svg.appendChild(el('circle', { cx: X(last), cy: Y(s.cum[last] as number), r: 3.5, fill: colorOf(idx), stroke: 'var(--g-surface)', 'stroke-width': 2 }));
      }
      // Direct labels on the four leaders (only where there's room on the right)
      if (m.r > 60) {
        const leaders = visible
          .filter((x) => x.s.cum[n - 1] !== null)
          .sort((a, b) => (b.s.cum[n - 1] as number) - (a.s.cum[n - 1] as number))
          .slice(0, 4);
        let lastY = -99;
        for (const { s } of leaders) {
          const y = Math.max(Y(s.cum[n - 1] as number) + 4, lastY + 13);
          lastY = y;
          const t = el('text', { x: w - m.r + 8, y, fill: 'var(--g-ink)', 'font-size': 11 });
          t.textContent = s.short.length > 14 ? `${s.short.slice(0, 13)}…` : s.short;
          svg.appendChild(t);
        }
      }
      // Crosshair + hit layer
      const cross = el('line', { y1: m.t, y2: m.t + ih, stroke: 'var(--g-axis)', 'stroke-width': 1, opacity: 0 });
      svg.appendChild(cross);
      const hit = el('rect', { x: m.l, y: m.t, width: iw, height: ih, fill: 'transparent' });
      svg.appendChild(hit);
      hit.addEventListener('pointermove', (e) => {
        const box = svg.getBoundingClientRect();
        const px = (e as PointerEvent).clientX - box.left;
        const py = (e as PointerEvent).clientY - box.top;
        const i = n > 1 ? Math.min(n - 1, Math.max(0, Math.round(((px - m.l) / iw) * (n - 1)))) : 0;
        cross.setAttribute('x1', String(X(i)));
        cross.setAttribute('x2', String(X(i)));
        cross.setAttribute('opacity', '0.5');
        // nearest line to the pointer at this x
        let near: string | null = null;
        let best = 28;
        const rows = visible
          .map(({ s, idx }) => ({ s, idx, v: s.cum[i] }))
          .filter((r): r is { s: Series; idx: number; v: number } => r.v !== null);
        for (const r of rows) {
          const dist = Math.abs(Y(r.v) - py);
          if (dist < best) {
            best = dist;
            near = r.s.id;
          }
        }
        if (near !== highlight) {
          highlight = near;
          paths.forEach((p, id) => {
            p.setAttribute('stroke-width', id === highlight ? '3.5' : '2');
            p.setAttribute('opacity', highlight && id !== highlight ? '0.35' : '1');
          });
        }
        rows.sort((a, b) => b.v - a.v);
        tip.replaceChildren();
        const head = document.createElement('div');
        head.className = 'mb-1 font-semibold text-white/90';
        head.textContent = `Round ${data.cols[i].r ?? i + 1} — ${data.cols[i].k}`;
        tip.appendChild(head);
        rows.slice(0, 10).forEach((r) => {
          const line = document.createElement('div');
          line.className = 'flex items-center gap-2 py-0.5';
          if (r.s.id === highlight) line.style.fontWeight = '700';
          const key = document.createElement('span');
          key.style.cssText = `display:inline-block;width:12px;height:2px;flex:none;background:${colorOf(r.idx)}`;
          const val = document.createElement('strong');
          val.className = 'w-10 flex-none text-right tabular-nums text-white';
          val.textContent = String(r.v);
          const name = document.createElement('span');
          name.className = 'truncate text-white/60';
          name.textContent = r.s.name;
          line.append(key, val, name);
          tip.appendChild(line);
        });
        if (rows.length > 10) {
          const more = document.createElement('div');
          more.className = 'pt-1 text-white/40';
          more.textContent = `+${rows.length - 10} more`;
          tip.appendChild(more);
        }
        tip.classList.remove('hidden');
        const tw = tip.offsetWidth;
        const left = X(i) + 14 + tw > w ? X(i) - 14 - tw : X(i) + 14;
        tip.style.left = `${Math.max(0, left)}px`;
        tip.style.top = `${Math.max(0, Math.min(py - 20, h - tip.offsetHeight - 4))}px`;
      });
      hit.addEventListener('pointerleave', () => {
        cross.setAttribute('opacity', '0');
        tip.classList.add('hidden');
        if (highlight) {
          highlight = null;
          paths.forEach((p) => {
            p.setAttribute('stroke-width', '2');
            p.setAttribute('opacity', '1');
          });
        }
      });
      plot!.insertBefore(svg, tip);
    }

    function renderLegend() {
      legend!.replaceChildren();
      data.series.forEach((s, idx) => {
        const b = document.createElement('button');
        b.type = 'button';
        b.setAttribute('aria-pressed', String(shown.has(s.id)));
        b.className = 'flex items-center gap-1.5 rounded px-1.5 py-0.5 text-white/70 transition hover:bg-white/10';
        b.style.opacity = shown.has(s.id) ? '1' : '0.4';
        const key = document.createElement('span');
        key.style.cssText = `display:inline-block;width:14px;height:3px;border-radius:2px;flex:none;background:${colorOf(idx)}`;
        const name = document.createElement('span');
        name.textContent = s.name;
        b.append(key, name);
        b.addEventListener('click', () => {
          if (shown.has(s.id)) shown.delete(s.id);
          else shown.add(s.id);
          renderLegend();
          render();
        });
        legend!.appendChild(b);
      });
    }

    root.querySelectorAll<HTMLButtonElement>('[data-graph-preset]').forEach((btn) => {
      btn.addEventListener('click', () => {
        shown.clear();
        const preset = btn.dataset.graphPreset;
        if (preset === 'top') data.series.slice(0, TOP).forEach((s) => shown.add(s.id));
        if (preset === 'all') data.series.forEach((s) => shown.add(s.id));
        renderLegend();
        render();
      });
    });

    slider?.addEventListener('input', () => {
      n = Number(slider.value);
      render();
    });
    new ResizeObserver(() => render()).observe(plot);
    renderLegend();
    render();
  }
  initStandingsGraph();
  document.addEventListener('astro:page-load', initStandingsGraph);
</script>

