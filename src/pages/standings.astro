---
export const prerender = false;

import Layout from '../layouts/Layout.astro';
import StandingsTabs from '../components/StandingsTabs.astro';
import TeamLogo from '../components/TeamLogo.astro';
import DriverFlag from '../components/DriverFlag.astro';
import PageBanner from '../components/PageBanner.astro';
import SeasonLogo from '../components/SeasonLogo.astro';
import {
  resolveSupabaseEnv,
  getDriverClasses,
  getSeasons,
  getStandingsExcludedRoundIds,
  displayDriverName,
  shortDriverName,
  getPageBanners,
  getCircuits,
  getScoringRulesets,
  resolveSeasonRuleset,
  type Circuit,
} from '../lib/supabase';
import {
  computeSeasonStandings,
  computeOverallSeasonStandings,
  computeSeasonStandingsRoundColumns,
  computeDisplayRoundNumbers,
  normalizeTrackOrLayoutName,
  BASELINE_DROP_WEEKS,
  MIN_ROUNDS_FOR_DROPS,
  getSeasonCarTeamStats,
  getSeasonDriverExtendedStats,
  getSeasonOverallContext,
  driversSelect,
  isChampionshipSeason,
  type DriverSeasonStanding,
  type DriverSeasonExtras,
  type DriverSeasonExtendedStats,
  type SeasonStandingsRoundColumn,
} from '../lib/results';
import { classTagFull } from '../lib/classColors';
import { bannerUrlFor } from '../lib/pageBanners';
import { slugify } from '../lib/slug';

const supabaseEnv = resolveSupabaseEnv(Astro.locals);

// Independent of everything else on this page — kicked off immediately and
// awaited just before the template needs it (right before the closing ---),
// so it runs concurrently with the classes/seasons fetch and the standings
// computation below instead of sequentially after them.
const bannerPromise = (async () => {
  try {
    return bannerUrlFor(await getPageBanners(supabaseEnv), 'standings');
  } catch (err) {
    console.error('Failed to load page banner:', err);
    return null;
  }
})();

let classes: Awaited<ReturnType<typeof getDriverClasses>> = [];
let seasons: Awaited<ReturnType<typeof getSeasons>> = [];
let loadError: string | null = null;
try {
  [classes, seasons] = await Promise.all([getDriverClasses(supabaseEnv), getSeasons(supabaseEnv)]);
} catch (err) {
  console.error('Failed to load standings page filters:', err);
  loadError = err instanceof Error ? err.message : String(err);
}

// Exhibition seasons never have standings (computeSeasonStandings returns
// [] for them — see isChampionshipSeason), so the picker only offers real
// championship seasons in the first place.
const championshipSeasons = seasons.filter((s) => isChampionshipSeason(s.name));

const requestedSeasonNumber = Astro.url.searchParams.get('season');
const activeSeason =
  championshipSeasons.find((s) => String(s.number) === requestedSeasonNumber) ??
  championshipSeasons.find((s) => s.is_current) ??
  championshipSeasons[0];

// Gamma/Delta didn't exist for every season (see seasons.gamma_enabled/
// delta_enabled, 0037_class_and_scoring_fixes.sql) — the Class picker for
// the active season only offers classes that actually competed that
// season, so there's no "Gamma" option to pick for a season Gamma never
// raced in. Alpha has no flag — every championship season has it.
const classesForActiveSeason = classes.filter(
  (c) => (c.name !== 'Gamma' || activeSeason?.gamma_enabled) && (c.name !== 'Delta' || activeSeason?.delta_enabled)
);

// Class dropdown: "All" (every class combined — the old Overall view) or one
// class (the old Per Class view). Old links still work: `?view=class` with
// no/unknown class falls back to Alpha like before, `?view=overall` is
// always All.
const requestedClassName = Astro.url.searchParams.get('class');
const legacyView = Astro.url.searchParams.get('view');
const activeClass =
  legacyView === 'overall' || (requestedClassName === 'all') || (!requestedClassName && legacyView !== 'class')
    ? undefined
    : (classesForActiveSeason.find((c) => c.name === requestedClassName) ??
      classesForActiveSeason.find((c) => c.name === 'Alpha') ??
      classesForActiveSeason[0]);

const classNameById = new Map(classes.map((c) => [c.id, c.name]));

// "overall" = All classes combined (see computeOverallSeasonStandings);
// "class" = one class's own standings.
const view: 'overall' | 'class' = activeClass ? 'class' : 'overall';

// "List" (existing table, default) vs "Matrix" (drivers down the left, one
// column per round across the top, penalty/drop flags on each cell — see
// DriverSeasonStanding.roundCells), same URL-param pattern as before.
const mode = Astro.url.searchParams.get('mode') === 'matrix' ? 'matrix' : 'list';

let standings: DriverSeasonStanding[] = [];
let extrasByDriverId: Map<string, DriverSeasonExtras> = new Map();
let extendedStatsByDriverId: Map<string, DriverSeasonExtendedStats> = new Map();
let matrixColumns: SeasonStandingsRoundColumn[] = [];
const matrixLogoBySubsession = new Map<number, string | null>();
// Timeline Slider inputs (see the script at the bottom): the drop rules the
// real standings use, so the client can recompute "as of round N" totals the
// same way finalizeStandings does.
let matrixDropWeeks = BASELINE_DROP_WEEKS;
let matrixCanDropFinalRound = false;
// The season-wide denominators for the Starts/Apps columns below ("x of y")
// — y is the same for every driver regardless of view (Overall vs Per
// Class) or how many rounds any one driver personally attended, so it's
// derived once from overallContext.overallScores (every class's race_scores
// rows for the season, already filtered to exclude exhibition/excluded
// rounds — see getSeasonOverallContext) rather than per-driver. "Starts" =
// one per (subsession_id, race_number) actually run — a sprint round with
// two races contributes 2, an endurance round's single race contributes 1.
// "Appearances" = one per distinct subsession_id (round) run, regardless of
// how many races it had.
let maxStarts = 0;
// Slots reserved for the right-aligned flag / car logo / team logo group in the
// List view's driver cell — a driver can have raced more than one car or team
// this season, so reserve as many car and team slots as the busiest driver
// needs (at least one each) and pad every other row up to that. Filled in
// once `extrasByDriverId` is loaded below.
let maxCarSlots = 1;
let maxTeamSlots = 1;
let maxAppearances = 0;
if (!loadError && activeSeason) {
  try {
    const [driversBasic, exhibitionRoundIds] = await Promise.all([driversSelect(supabaseEnv), getStandingsExcludedRoundIds(supabaseEnv)]);
    // Built ONCE and shared across all three calls below instead of each
    // independently re-fetching its own copy (curated_race_results,
    // penalties, curated_rounds, lap stats) — this page used to rebuild
    // that ~4-query context three separate times per request (once each
    // for standings/car-team-stats/extended-stats), which was enough to
    // trip Cloudflare Workers' per-request resource limit (Error 1102) on
    // seasons with more than a handful of rounds on file. Same
    // already-proven sharing pattern computeDriverCareerStats uses across
    // every class + team + extended-stats view at once — see this
    // repo's README/computeDriverCareerStats' own doc comment for why
    // sharing this way is safe.
    const overallContext = await getSeasonOverallContext(supabaseEnv, activeSeason, exhibitionRoundIds, driversBasic);
    const [standingsResult, extras, extendedStats] = await Promise.all([
      view === 'class' && activeClass
        ? computeSeasonStandings(supabaseEnv, activeSeason, activeClass.id, driversBasic, exhibitionRoundIds, classes, overallContext)
        : computeOverallSeasonStandings(supabaseEnv, activeSeason, driversBasic, exhibitionRoundIds, overallContext),
      getSeasonCarTeamStats(supabaseEnv, activeSeason, exhibitionRoundIds, driversBasic, undefined, undefined, undefined, overallContext),
      getSeasonDriverExtendedStats(supabaseEnv, activeSeason, exhibitionRoundIds, driversBasic, overallContext),
    ]);
    standings = standingsResult;
    extrasByDriverId = extras;
    for (const e of extras.values()) {
      maxCarSlots = Math.max(maxCarSlots, e.cars.length);
      maxTeamSlots = Math.max(maxTeamSlots, e.teams.length);
    }
    extendedStatsByDriverId = extendedStats;
    maxAppearances = new Set(overallContext.overallScores.map((s) => s.subsession_id)).size;
    maxStarts = new Set(overallContext.overallScores.map((s) => `${s.subsession_id}:${s.race_number}`)).size;

    // Matrix view's column headers — every round the view being shown
    // actually raced (Per Class narrows this to that class's own rounds,
    // same pool computeSeasonStandings itself used to build that view's
    // standings), chronologically ordered. Column headers are just the
    // round number (Logan: keep them narrow) — computeDisplayRoundNumbers
    // needs the season's full round list plus the site-wide exhibition/test
    // exclusion set (exhibitionRoundIds here is actually already that
    // union — see getStandingsExcludedRoundIds — so the second arg is left
    // empty rather than fetching test round ids separately).
    const matrixSubsessionIds = new Set(
      (view === 'class' && activeClass
        ? overallContext.overallScores.filter((s) => s.class_id === activeClass.id)
        : overallContext.overallScores
      ).map((s) => s.subsession_id)
    );
    const displayRoundNumbers = computeDisplayRoundNumbers(overallContext.seasonRounds, exhibitionRoundIds, new Set());
    matrixColumns = computeSeasonStandingsRoundColumns(overallContext.seasonRounds, matrixSubsessionIds, displayRoundNumbers);

    // Track logo for each column header (Matrix view only — List never
    // needs circuits). Matched to a circuit by track name, same
    // normalisation the rest of the site uses; a track with no logo on file
    // falls back to an initials tile.
    if (mode === 'matrix') {
      matrixDropWeeks = BASELINE_DROP_WEEKS + (activeSeason.extra_drop_weeks ?? 0);
      try {
        const rulesets = await getScoringRulesets(supabaseEnv);
        matrixCanDropFinalRound = resolveSeasonRuleset(activeSeason, rulesets)?.can_drop_final_round ?? false;
      } catch (err) {
        console.error('Failed to load scoring rulesets for standings matrix:', err);
      }
      try {
        const circuits = await getCircuits(supabaseEnv);
        const circuitByName = new Map<string, Circuit>(circuits.map((c) => [normalizeTrackOrLayoutName(c.name), c]));
        for (const col of matrixColumns) {
          matrixLogoBySubsession.set(col.subsessionId, circuitByName.get(normalizeTrackOrLayoutName(col.trackName))?.logo_url ?? null);
        }
      } catch (err) {
        console.error('Failed to load circuits for standings matrix headers:', err);
      }
    }
  } catch (err) {
    console.error('Failed to compute standings:', err);
    loadError = err instanceof Error ? err.message : String(err);
  }
}

// CSV export filename — reflects whichever view is actually on screen
// (season, Overall/Per Class + which class, List/Matrix) so exporting after
// changing a filter doesn't silently overwrite a previous, differently-
// scoped download under the same name.
const csvFilenameBase = slugify(
  `standings ${activeSeason?.name ?? ''} ${view === 'class' && activeClass ? activeClass.name : 'overall'} ${mode}`
);

function raceWord(n: number): string {
  return `${n} race${n === 1 ? '' : 's'}`;
}

// Matrix column header's hover tooltip — "Track Name — Sprint"/"Track Name
// — Endurance", or just the track name when the round has no format on
// file yet.
function matrixColumnTitle(trackName: string, format: 'endurance' | 'sprint' | null): string {
  if (!format) return trackName;
  return `${trackName} — ${format.charAt(0).toUpperCase()}${format.slice(1)}`;
}

const bannerUrl = await bannerPromise;

Astro.response.headers.set('Cache-Control', 'public, s-maxage=60, stale-while-revalidate=300');
---

<Layout title="Season Standings" description="Full season standings for every Alpha Touring Challenge season and class.">
  <section class="relative mx-auto max-w-6xl px-6 pb-24 pt-8">
    <PageBanner imageUrl={bannerUrl} />
    <h1 class="reveal font-display text-2xl sm:text-5xl">Season Standings</h1>

    <StandingsTabs active="drivers" />

    {loadError && (
      <p class="mt-4 rounded-lg border border-brand-pink/30 bg-brand-pink/10 p-4 text-sm text-white/80">
        Couldn't load standings right now. If this mentions permission/RLS, race_scores or curated_race_results
        likely still need the public-read policy from <code>supabase/migrations/0004_champions.sql</code> —
        it has to be run manually in the Supabase SQL editor.
        <br /><span class="mt-1 block text-white/50">{loadError}</span>
      </p>
    )}

    {!loadError && (
      <div class="relative z-30 mt-8">
        <form method="GET" class="flex flex-wrap items-end justify-between gap-x-4 gap-y-4">
          <label class="flex flex-col gap-1.5 text-sm">
            <span class="text-white/60">Season</span>
            <div class="flex items-center gap-2">
              <select
                name="season"
                onchange="this.form.submit()"
                class="rounded-md border border-white/15 bg-white/5 px-3 py-2 text-white outline-none focus:border-brand-primary"
              >
                {championshipSeasons.map((s) => (
                  <option value={s.number} selected={s.id === activeSeason?.id} class="bg-brand-ink text-white">{s.name}</option>
                ))}
              </select>
              <SeasonLogo darkUrl={activeSeason?.logo_url ?? null} lightUrl={activeSeason?.logo_url_light} />
            </div>
          </label>
          <div class="flex flex-wrap items-end gap-4 sm:ml-auto">
            {mode === 'matrix' && matrixColumns.length > 1 && (
              <div class="group relative flex flex-col gap-1.5 text-sm">
                <span class="text-white/60">Timeline Slider</span>
                <div class="flex h-[42px] items-center gap-3">
                  <input
                    type="range"
                    id="timeline-slider"
                    min="1"
                    max={matrixColumns.length}
                    step="1"
                    value={matrixColumns.length}
                    aria-label="Timeline Slider"
                    class="w-40 accent-brand-primary"
                  />
                  <span id="timeline-slider-value" class="min-w-[4.5rem] text-white/70">
                    Round {matrixColumns[matrixColumns.length - 1]?.roundNumber ?? matrixColumns.length}
                  </span>
                </div>
                <span
                  role="tooltip"
                  class="pointer-events-none absolute left-0 top-full z-40 mt-1 hidden w-64 rounded-md border border-white/15 bg-brand-ink px-3 py-2 text-xs text-white/80 shadow-lg group-hover:block group-focus-within:block"
                >
                  Move this slider to view the standings as they were, round-by-round.
                </span>
              </div>
            )}
            <label class="flex flex-col gap-1.5 text-sm">
              <span class="text-white/60">View</span>
              <select
                name="mode"
                onchange="this.form.submit()"
                class="rounded-md border border-white/15 bg-white/5 px-3 py-2 text-white outline-none focus:border-brand-primary"
              >
                <option value="list" selected={mode === 'list'} class="bg-brand-ink text-white">List</option>
                <option value="matrix" selected={mode === 'matrix'} class="bg-brand-ink text-white">Matrix</option>
              </select>
            </label>
            <label class="flex flex-col gap-1.5 text-sm">
              <span class="text-white/60">Class</span>
              <select
                name="class"
                onchange="this.form.submit()"
                class="rounded-md border border-white/15 bg-white/5 px-3 py-2 text-white outline-none focus:border-brand-primary"
              >
                <option value="all" selected={!activeClass} class="bg-brand-ink text-white">All</option>
                {classesForActiveSeason.map((c) => (
                  <option value={c.name} selected={c.id === activeClass?.id} class="bg-brand-ink text-white">{c.name}</option>
                ))}
              </select>
            </label>
          </div>
        </form>
      </div>
    )}

    {!loadError && standings.length === 0 && (
      <p class="mt-10 text-white/60">No results.</p>
    )}

    {!loadError && mode === 'list' && standings.length > 0 && (
      <div class="mt-8 rounded-xl border border-white/10" data-sticky-thead>
        <table id="standings-table" class="w-full border-collapse" data-sortable>
          <thead>
            <tr class="border-b border-white/10 text-left text-xs uppercase tracking-wide text-white/40">
              <th class="py-3 pl-4 pr-2 font-medium" data-sort-key="position">Pos</th>
              <th class="py-3 pr-3 font-medium" data-sort-key="driver">Driver</th>
              {view === 'overall' && <th class="hidden py-3 pr-3 font-medium sm:table-cell">Class</th>}
              <th class="py-3 pr-3 text-center font-medium" data-sort-key="points">Points</th>
              <th class="hidden py-3 pr-3 text-center font-medium sm:table-cell" data-sort-key="wins">Wins</th>
              <th class="hidden py-3 pr-3 text-center font-medium sm:table-cell" data-sort-key="podiums">Podiums</th>
              <th class="hidden py-3 pr-3 text-center font-medium md:table-cell" data-sort-key="top5">Top 5<span class="lowercase">s</span></th>
              <th class="hidden py-3 pr-3 text-center font-medium md:table-cell" data-sort-key="top10">Top 10<span class="lowercase">s</span></th>
              <th class="hidden py-3 pr-3 text-center font-medium lg:table-cell" data-sort-key="poles">Poles</th>
              <th class="hidden py-3 pr-3 text-center font-medium lg:table-cell" data-sort-key="starts">Starts</th>
              <th class="hidden py-3 pr-3 text-center font-medium sm:table-cell" data-sort-key="appearances">Apps</th>
              <th class="py-3 pr-4 text-center font-medium" data-sort-key="penalty" title="Penalty Points">PP</th>
            </tr>
          </thead>
          <tbody>
            {standings.map((row) => {
              const extras = extrasByDriverId.get(row.driver.id);
              const ext = extendedStatsByDriverId.get(row.driver.id);
              return (
                <>
                <tr
                  data-expand-row
                  tabindex="0"
                  role="button"
                  aria-expanded="false"
                  class="cursor-pointer border-b border-white/5 text-sm transition hover:bg-white/[0.04]"
                >
                  <td class="py-2.5 pl-4 pr-2 font-display text-lg leading-none text-white/70" data-col="position">{row.position}</td>
                  <td class="py-2.5 pr-3 font-semibold" data-col="driver" data-sort-value={row.driver.name} data-csv-value={displayDriverName(row.driver.name)}>
                    <div class="flex flex-wrap items-center gap-2">
                      <span
                        data-chevron
                        class="inline-block shrink-0 text-[9px] text-white/30 transition-transform duration-150"
                        aria-hidden="true"
                      >
                        &#9654;
                      </span>
                      {/* Full name at sm+, "F. Lastname" below sm — same wrap fix as ResultsTable.astro's row (Matrix view above already shows short names unconditionally, since that column is tight at every width). */}
                      <span class="hidden sm:inline">
                        {displayDriverName(row.driver.name)} {row.driver.car_number !== null && <span class="text-white/40">#{row.driver.car_number}</span>}
                      </span>
                      <span class="sm:hidden">
                        {shortDriverName(row.driver.name)} {row.driver.car_number !== null && <span class="text-white/40">#{row.driver.car_number}</span>}
                      </span>
                      {/* Flag / car logos / team logos pinned to the right edge of the
                          cell (ml-auto) in FIXED-WIDTH slots, same as
                          ResultsTable.astro's row: a driver with fewer cars or
                          teams than the busiest driver (or none at all) gets
                          empty slots in their place, so every row's flag and
                          first car logo line up in columns. Hidden on mobile
                          (Logan). */}
                      <span class="ml-auto hidden items-center gap-2 sm:flex">
                        <span class="flex h-5 w-6 flex-none items-center justify-center">
                          <DriverFlag nationality1={row.driver.nationality_1} nationality2={row.driver.nationality_2} />
                        </span>
                        {/* Cars first, teams second — every driver has a car, not every driver has a team. */}
                        {Array.from({ length: maxCarSlots }, (_, i) => extras?.cars[i]).map((c) => (
                          <span class="flex h-5 w-5 flex-none items-center justify-center">
                            {c && <TeamLogo name={c.carName} logoUrl={c.logoUrl} size="h-5 w-5" title={`${c.carName} — ${raceWord(c.races)}`} tint />}
                          </span>
                        ))}
                        {Array.from({ length: maxTeamSlots }, (_, i) => extras?.teams[i]).map((t) => (
                          <span class="flex h-5 w-5 flex-none items-center justify-center">
                            {t && (
                              <TeamLogo
                                name={t.teamName}
                                logoUrl={t.logoUrl}
                                size="h-5 w-5"
                                title={`${t.teamName} — ${raceWord(t.racesUnderTeam)} under this team, ${raceWord(t.racesScoredForTeam)} scored for the team`}
                              />
                            )}
                          </span>
                        ))}
                      </span>
                    </div>
                  </td>
                  {view === 'overall' && (
                    <td class="hidden py-2.5 pr-3 sm:table-cell">
                      {row.classId !== undefined && (
                        <span class={classTagFull(classNameById.get(row.classId) ?? '')}>
                          {classNameById.get(row.classId) ?? '—'}
                        </span>
                      )}
                    </td>
                  )}
                  <td class="py-2.5 pr-3 text-center font-semibold" data-col="points">{row.totalPoints}</td>
                  <td class="hidden py-2.5 pr-3 text-center text-white/60 sm:table-cell" data-col="wins">{row.wins}</td>
                  <td class="hidden py-2.5 pr-3 text-center text-white/60 sm:table-cell" data-col="podiums">{row.podiums}</td>
                  <td class="hidden py-2.5 pr-3 text-center text-white/60 md:table-cell" data-col="top5">{row.top5s}</td>
                  <td class="hidden py-2.5 pr-3 text-center text-white/60 md:table-cell" data-col="top10">{row.top10s}</td>
                  <td class="hidden py-2.5 pr-3 text-center text-white/60 lg:table-cell" data-col="poles">{row.poles}</td>
                  <td class="hidden py-2.5 pr-3 text-center text-white/60 lg:table-cell" data-col="starts" data-sort-value={row.starts}>
                    {row.starts} <span class="text-white/30">of {maxStarts}</span>
                  </td>
                  <td class="hidden py-2.5 pr-3 text-center text-white/60 sm:table-cell" data-col="appearances" data-sort-value={row.appearances}>
                    {row.appearances} <span class="text-white/30">of {maxAppearances}</span>
                  </td>
                  <td class="py-2.5 pr-4 text-center text-white/60" data-col="penalty" data-sort-value={ext?.penaltyPoints ?? 0} title="Penalty Points">
                    {ext?.penaltyPoints ?? 0}
                  </td>
                </tr>
                <tr data-detail-row class="hidden border-b border-white/5 bg-white/[0.02] text-xs">
                  <td colspan={view === 'overall' ? 12 : 11} class="px-4 py-4 sm:pl-11">
                    <div class="grid grid-cols-2 gap-x-4 gap-y-3 sm:grid-cols-4">
                      <div>
                        <div class="text-[10px] uppercase tracking-wide text-white/30">Laps</div>
                        <div class="mt-0.5 font-display text-sm text-white/90">{ext?.laps ?? 0}</div>
                      </div>
                      <div>
                        <div class="text-[10px] uppercase tracking-wide text-white/30">Led</div>
                        <div class="mt-0.5 font-display text-sm text-white/90">{ext?.lapsLed ?? 0}</div>
                      </div>
                      <div>
                        <div class="text-[10px] uppercase tracking-wide text-white/30">Net Positions</div>
                        <div class="mt-0.5 font-display text-sm text-white/90">
                          {ext && ext.netPositionsChange > 0 ? '+' : ''}
                          {ext?.netPositionsChange ?? 0}
                        </div>
                      </div>
                      <div>
                        <div class="text-[10px] uppercase tracking-wide text-white/30">Incidents / Lap</div>
                        <div class="mt-0.5 font-display text-sm text-white/90">
                          {ext?.incidentsPerLap !== null && ext?.incidentsPerLap !== undefined ? ext.incidentsPerLap.toFixed(2) : '—'}
                        </div>
                      </div>
                      <div>
                        <div class="text-[10px] uppercase tracking-wide text-white/30">Corners / Incident</div>
                        <div class="mt-0.5 font-display text-sm text-white/90">
                          {ext?.cornersPerIncident !== null && ext?.cornersPerIncident !== undefined ? ext.cornersPerIncident.toFixed(1) : '—'}
                        </div>
                      </div>
                      <div>
                        <div class="text-[10px] uppercase tracking-wide text-white/30">Penalty Points</div>
                        <div class="mt-0.5 font-display text-sm text-white/90">{ext?.penaltyPoints ?? 0}</div>
                      </div>
                      <div>
                        <div class="text-[10px] uppercase tracking-wide text-white/30">Bonus Points</div>
                        <div class="mt-0.5 font-display text-sm text-white/90">{ext?.bonusPoints ?? 0}</div>
                      </div>
                      <div>
                        <div class="text-[10px] uppercase tracking-wide text-white/30">Distance Driven</div>
                        <div class="mt-0.5 font-display text-sm text-white/90">
                          {ext?.distanceKm !== null && ext?.distanceKm !== undefined ? `${ext.distanceKm.toFixed(1)} km` : '—'}
                        </div>
                      </div>
                    </div>
                  </td>
                </tr>
                </>
              );
            })}
          </tbody>
        </table>
      </div>
      <div class="mt-3 flex justify-end">
        <button
          type="button"
          data-csv-export="standings-table"
          data-csv-filename={csvFilenameBase}
          class="inline-block self-start rounded-lg bg-white/10 px-3 py-1.5 text-xs font-semibold text-white/70 transition hover:bg-white/20"
        >
          Export CSV
        </button>
      </div>
    )}

    {!loadError && mode === 'matrix' && standings.length > 0 && (
      <div class="mt-8 rounded-xl border border-white/10" data-sticky-thead>
        <table id="standings-table" class="w-full border-collapse text-sm" data-drop-weeks={matrixDropWeeks} data-min-drop-rounds={MIN_ROUNDS_FOR_DROPS} data-can-drop-final={String(matrixCanDropFinalRound)}>
          <thead>
            <tr class="border-b border-white/10 text-left text-xs uppercase tracking-wide text-white/40">
              <th class="py-3 pl-4 pr-3 font-medium">Pos</th>
              <th class="py-3 pr-4 font-medium">Driver</th>
              {matrixColumns.map((col, i) => (
                <th
                  class="px-2 py-3 text-center font-medium"
                  data-round-col={i}
                  data-csv-value={`R${col.roundNumber ?? '?'}`}
                  title={`Round ${col.roundNumber ?? '?'} — ${matrixColumnTitle(col.trackName, col.format)}`}
                >
                  <span class="inline-flex items-center justify-center">
                    <TeamLogo name={col.trackName} logoUrl={matrixLogoBySubsession.get(col.subsessionId) ?? null} size="h-7 w-7" title={`Round ${col.roundNumber ?? '?'} — ${matrixColumnTitle(col.trackName, col.format)}`} tint />
                  </span>
                </th>
              ))}
              <th class="px-3 py-3 text-center font-medium">Total</th>
            </tr>
          </thead>
          <tbody>
            {standings.map((row, rowIndex) => (
              <tr
                class="border-b border-white/5"
                data-matrix-row
                data-orig-index={rowIndex}
                data-orig-total={row.totalPoints}
                data-points={matrixColumns.map((col) => row.roundCells.get(col.subsessionId)?.points ?? '').join(',')}
              >
                <td class="py-2.5 pl-4 pr-3 font-display text-lg leading-none text-white/70" data-pos-cell>{row.position}</td>
                <td class="py-2.5 pr-4 font-semibold" data-csv-value={displayDriverName(row.driver.name)}>
                  <span class="flex items-center gap-1.5 whitespace-nowrap">
                    <DriverFlag nationality1={row.driver.nationality_1} nationality2={row.driver.nationality_2} />
                    {/* Full name at sm+, "F. Lastname" below sm — same wrap fix as the List view above. */}
                    <span class="hidden sm:inline">{displayDriverName(row.driver.name)}</span>
                    <span class="sm:hidden">{shortDriverName(row.driver.name)}</span>
                    {row.driver.car_number !== null && <span class="text-white/40">#{row.driver.car_number}</span>}
                  </span>
                </td>
                {matrixColumns.map((col, i) => {
                  const cell = row.roundCells.get(col.subsessionId);
                  return (
                    <td class="relative px-2 py-2.5 text-center" data-round-col={i}>
                      {cell ? (
                        <span
                          data-cell-points
                          data-orig-dropped={String(cell.dropped)}
                          class={cell.dropped ? 'text-white/35 line-through decoration-white/25' : 'text-white/80'}
                          title={`${cell.dropped ? 'Dropped round — ' : ''}${cell.points} pts`}
                        >
                          {cell.points}
                        </span>
                      ) : (
                        <span class="text-white/20">—</span>
                      )}
                      {cell && cell.penalties.length > 0 && (
                        <span
                          class="absolute right-1 top-1 text-[8px] leading-none text-brand-pink"
                          aria-hidden="false"
                          role="img"
                          title={cell.penalties.join('\n')}
                        >
                          ●
                        </span>
                      )}
                    </td>
                  );
                })}
                <td class="px-3 py-2.5 text-center font-semibold text-white/90" data-total-cell>{row.totalPoints}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <div class="mt-3 flex justify-end">
        <button
          type="button"
          data-csv-export="standings-table"
          data-csv-filename={csvFilenameBase}
          class="inline-block self-start rounded-lg bg-white/10 px-3 py-1.5 text-xs font-semibold text-white/70 transition hover:bg-white/20"
        >
          Export CSV
        </button>
      </div>
    )}
  </section>
</Layout>

<script>
  // Timeline Slider (Matrix view): shows the standings "as of" round N.
  //  - Round columns after N are hidden (data-round-col = chronological index).
  //  - Total is recomputed from only the visible rounds, using the same
  //    drop-week rules as the real standings (src/lib/results.ts
  //    finalizeStandings): a round a driver skipped counts as 0 in their
  //    pool, no rounds drop until 5+ are visible, the baseline + season's
  //    extra drop weeks apply from then on, and (unless the ruleset allows
  //    dropping it) the last visible round is protected from being dropped.
  //  - Rows are re-ordered by the recomputed total and Pos renumbered; ties
  //    keep the full-season order (the real tiebreakers — wins, podiums,
  //    etc. — aren't recomputed as-of). Drivers who hadn't raced yet are
  //    hidden. At the slider's max everything is restored to the server's
  //    exact numbers.
  function initTimelineSlider() {
    const slider = document.getElementById('timeline-slider') as HTMLInputElement | null;
    const table = document.getElementById('standings-table') as HTMLTableElement | null;
    if (!slider || !table || slider.dataset.bound === 'true') return;
    slider.dataset.bound = 'true';
    const label = document.getElementById('timeline-slider-value');
    const headers = Array.from(table.querySelectorAll<HTMLElement>('th[data-round-col]'));
    const tbody = table.tBodies[0];
    const rows = Array.from(tbody.querySelectorAll<HTMLTableRowElement>('tr[data-matrix-row]'));
    const maxRounds = Number(slider.max);
    const baseDrops = Number(table.dataset.dropWeeks ?? 2);
    const minDropRounds = Number(table.dataset.minDropRounds ?? 5);
    const canDropFinal = table.dataset.canDropFinal === 'true';
    const DROPPED_CLASSES = ['text-white/35', 'line-through', 'decoration-white/25'];

    const parsed = rows.map((row) => ({
      row,
      origIndex: Number(row.dataset.origIndex),
      origTotal: Number(row.dataset.origTotal),
      // '' = didn't attend that round (counts as 0 in the drop pool, but has no cell).
      points: (row.dataset.points ?? '').split(',').map((v) => (v === '' ? null : Number(v))),
    }));

    function totalAsOf(points: (number | null)[], n: number) {
      const pool = points.slice(0, n).map((p, i) => ({ i, p: p ?? 0 }));
      const totalDrops = n >= minDropRounds ? baseDrops : 0;
      const dropped = new Set<number>();
      let total: number;
      if (!canDropFinal && n >= 1) {
        const finalPts = pool[n - 1].p;
        const rest = pool.slice(0, n - 1).sort((a, b) => b.p - a.p || a.i - b.i);
        const dropCount = Math.min(totalDrops, Math.max(0, n - 1));
        const keep = Math.max(0, rest.length - dropCount);
        total = finalPts + rest.slice(0, keep).reduce((s, r) => s + r.p, 0);
        rest.slice(keep).forEach((r) => dropped.add(r.i));
      } else {
        const ranked = [...pool].sort((a, b) => b.p - a.p || a.i - b.i);
        const dropCount = Math.min(totalDrops, Math.max(0, ranked.length - 1));
        total = ranked.slice(0, ranked.length - dropCount).reduce((s, r) => s + r.p, 0);
        ranked.slice(ranked.length - dropCount).forEach((r) => dropped.add(r.i));
      }
      return { total, dropped };
    }

    function setDropped(span: HTMLElement, isDropped: boolean) {
      DROPPED_CLASSES.forEach((c) => span.classList.toggle(c, isDropped));
      span.classList.toggle('text-white/80', !isDropped);
      const pts = span.textContent?.trim() ?? '';
      span.title = `${isDropped ? 'Dropped round — ' : ''}${pts} pts`;
    }

    function apply() {
      const n = Number(slider!.value);
      const atMax = n >= maxRounds;
      document.querySelectorAll<HTMLElement>('[data-round-col]').forEach((el) => {
        el.classList.toggle('hidden', Number(el.dataset.roundCol) >= n);
      });
      const roundText = headers[n - 1]?.dataset.csvValue?.replace(/^R/, '') ?? String(n);
      if (label) label.textContent = `Round ${roundText}`;

      const visible: { row: HTMLTableRowElement; total: number; origIndex: number }[] = [];
      for (const r of parsed) {
        // Cells only exist for rounds the driver attended — map each back to
        // its column index via the parent td.
        const byCol = new Map<number, HTMLElement>();
        r.row.querySelectorAll<HTMLElement>('[data-cell-points]').forEach((span) => {
          const td = span.closest<HTMLElement>('td[data-round-col]');
          if (td) byCol.set(Number(td.dataset.roundCol), span);
        });
        if (atMax) {
          r.row.classList.remove('hidden');
          byCol.forEach((span) => setDropped(span, span.dataset.origDropped === 'true'));
          visible.push({ row: r.row, total: r.origTotal, origIndex: r.origIndex });
          continue;
        }
        const attended = r.points.slice(0, n).some((p) => p !== null);
        r.row.classList.toggle('hidden', !attended);
        if (!attended) continue;
        const { total, dropped } = totalAsOf(r.points, n);
        byCol.forEach((span, col) => setDropped(span, dropped.has(col)));
        visible.push({ row: r.row, total, origIndex: r.origIndex });
      }

      visible.sort((a, b) => b.total - a.total || a.origIndex - b.origIndex);
      visible.forEach((v, i) => {
        v.row.querySelector('[data-total-cell]')!.textContent = String(v.total);
        v.row.querySelector('[data-pos-cell]')!.textContent = String(i + 1);
        tbody.appendChild(v.row);
      });
    }
    slider.addEventListener('input', apply);
    apply();
  }
  initTimelineSlider();
  document.addEventListener('astro:page-load', initTimelineSlider);
</script>
