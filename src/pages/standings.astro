---
export const prerender = false;

import Layout from '../layouts/Layout.astro';
import StandingsTabs from '../components/StandingsTabs.astro';
import TeamLogo from '../components/TeamLogo.astro';
import DriverFlag from '../components/DriverFlag.astro';
import PageBanner from '../components/PageBanner.astro';
import {
  resolveSupabaseEnv,
  getDriverClasses,
  getSeasons,
  getStandingsExcludedRoundIds,
  displayDriverName,
  getPageBanners,
} from '../lib/supabase';
import {
  computeSeasonStandings,
  computeOverallSeasonStandings,
  getSeasonCarTeamStats,
  getSeasonDriverExtendedStats,
  getSeasonOverallContext,
  driversSelect,
  isChampionshipSeason,
  type DriverSeasonStanding,
  type DriverSeasonExtras,
  type DriverSeasonExtendedStats,
} from '../lib/results';
import { classBadgeClasses } from '../lib/classColors';
import { bannerUrlFor } from '../lib/pageBanners';

const supabaseEnv = resolveSupabaseEnv(Astro.locals);

let classes: Awaited<ReturnType<typeof getDriverClasses>> = [];
let seasons: Awaited<ReturnType<typeof getSeasons>> = [];
let loadError: string | null = null;
try {
  [classes, seasons] = await Promise.all([getDriverClasses(supabaseEnv), getSeasons(supabaseEnv)]);
} catch (err) {
  console.error('Failed to load standings page filters:', err);
  loadError = err instanceof Error ? err.message : String(err);
}

// Exhibition seasons never have standings (computeSeasonStandings returns
// [] for them — see isChampionshipSeason), so the picker only offers real
// championship seasons in the first place.
const championshipSeasons = seasons.filter((s) => isChampionshipSeason(s.name));

const requestedSeasonNumber = Astro.url.searchParams.get('season');
const activeSeason =
  championshipSeasons.find((s) => String(s.number) === requestedSeasonNumber) ??
  championshipSeasons.find((s) => s.is_current) ??
  championshipSeasons[0];

// Gamma/Delta didn't exist for every season (see seasons.gamma_enabled/
// delta_enabled, 0037_class_and_scoring_fixes.sql) — the Class picker for
// the active season only offers classes that actually competed that
// season, so there's no "Gamma" option to pick for a season Gamma never
// raced in. Alpha has no flag — every championship season has it.
const classesForActiveSeason = classes.filter(
  (c) => (c.name !== 'Gamma' || activeSeason?.gamma_enabled) && (c.name !== 'Delta' || activeSeason?.delta_enabled)
);

const requestedClassName = Astro.url.searchParams.get('class');
const activeClass =
  classesForActiveSeason.find((c) => c.name === requestedClassName) ??
  classesForActiveSeason.find((c) => c.name === 'Alpha') ??
  classesForActiveSeason[0];

const classNameById = new Map(classes.map((c) => [c.id, c.name]));

// Same "Overall combines every class, Per Class is the original view"
// toggle as the race results page, defaulting to Overall for the same
// reason — it's the table that actually matches how points work when
// class-only bonuses (class_points) are taken out of the mix (see
// computeOverallSeasonStandings).
const view = Astro.url.searchParams.get('view') === 'class' ? 'class' : 'overall';

let standings: DriverSeasonStanding[] = [];
let extrasByDriverId: Map<string, DriverSeasonExtras> = new Map();
let extendedStatsByDriverId: Map<string, DriverSeasonExtendedStats> = new Map();
// The season-wide denominators for the Starts/Apps columns below ("x of y")
// — y is the same for every driver regardless of view (Overall vs Per
// Class) or how many rounds any one driver personally attended, so it's
// derived once from overallContext.overallScores (every class's race_scores
// rows for the season, already filtered to exclude exhibition/excluded
// rounds — see getSeasonOverallContext) rather than per-driver. "Starts" =
// one per (subsession_id, race_number) actually run — a sprint round with
// two races contributes 2, an endurance round's single race contributes 1.
// "Appearances" = one per distinct subsession_id (round) run, regardless of
// how many races it had.
let maxStarts = 0;
let maxAppearances = 0;
if (!loadError && activeSeason) {
  try {
    const [driversBasic, exhibitionRoundIds] = await Promise.all([driversSelect(supabaseEnv), getStandingsExcludedRoundIds(supabaseEnv)]);
    // Built ONCE and shared across all three calls below instead of each
    // independently re-fetching its own copy (curated_race_results,
    // penalties, curated_rounds, lap stats) — this page used to rebuild
    // that ~4-query context three separate times per request (once each
    // for standings/car-team-stats/extended-stats), which was enough to
    // trip Cloudflare Workers' per-request resource limit (Error 1102) on
    // seasons with more than a handful of rounds on file. Same
    // already-proven sharing pattern computeDriverCareerStats uses across
    // every class + team + extended-stats view at once — see this
    // repo's README/computeDriverCareerStats' own doc comment for why
    // sharing this way is safe.
    const overallContext = await getSeasonOverallContext(supabaseEnv, activeSeason, exhibitionRoundIds, driversBasic);
    const [standingsResult, extras, extendedStats] = await Promise.all([
      view === 'class' && activeClass
        ? computeSeasonStandings(supabaseEnv, activeSeason, activeClass.id, driversBasic, exhibitionRoundIds, classes, overallContext)
        : computeOverallSeasonStandings(supabaseEnv, activeSeason, driversBasic, exhibitionRoundIds, overallContext),
      getSeasonCarTeamStats(supabaseEnv, activeSeason, exhibitionRoundIds, driversBasic, undefined, undefined, undefined, overallContext),
      getSeasonDriverExtendedStats(supabaseEnv, activeSeason, exhibitionRoundIds, driversBasic, overallContext),
    ]);
    standings = standingsResult;
    extrasByDriverId = extras;
    extendedStatsByDriverId = extendedStats;
    maxAppearances = new Set(overallContext.overallScores.map((s) => s.subsession_id)).size;
    maxStarts = new Set(overallContext.overallScores.map((s) => `${s.subsession_id}:${s.race_number}`)).size;
  } catch (err) {
    console.error('Failed to compute standings:', err);
    loadError = err instanceof Error ? err.message : String(err);
  }
}

function raceWord(n: number): string {
  return `${n} race${n === 1 ? '' : 's'}`;
}

let bannerUrl: string | null = null;
try {
  bannerUrl = bannerUrlFor(await getPageBanners(supabaseEnv), 'standings');
} catch (err) {
  console.error('Failed to load page banner:', err);
}

Astro.response.headers.set('Cache-Control', 'public, s-maxage=60, stale-while-revalidate=300');
---

<Layout title="Season Standings" description="Full season standings for every Alpha Touring Challenge season and class.">
  <section class="relative mx-auto max-w-6xl overflow-hidden px-6 pb-24 pt-28 sm:pt-36">
    <PageBanner imageUrl={bannerUrl} />
    <h1 class="reveal font-display text-5xl">Season Standings</h1>

    <StandingsTabs active="drivers" />

    {loadError && (
      <p class="mt-4 rounded-lg border border-brand-pink/30 bg-brand-pink/10 p-4 text-sm text-white/80">
        Couldn't load standings right now. If this mentions permission/RLS, race_scores or curated_race_results
        likely still need the public-read policy from <code>supabase/migrations/0004_champions.sql</code> —
        it has to be run manually in the Supabase SQL editor.
        <br /><span class="mt-1 block text-white/50">{loadError}</span>
      </p>
    )}

    {!loadError && (
      <div class="mt-8 flex flex-wrap items-end justify-between gap-4">
        <form method="GET" class="flex flex-wrap items-end gap-4">
          <input type="hidden" name="view" value={view} />
          <label class="flex flex-col gap-1.5 text-sm">
            <span class="text-white/60">Season</span>
            <div class="flex items-center gap-2">
              <select
                name="season"
                onchange="this.form.submit()"
                class="rounded-md border border-white/15 bg-white/5 px-3 py-2 text-white outline-none focus:border-brand-primary"
              >
                {championshipSeasons.map((s) => (
                  <option value={s.number} selected={s.id === activeSeason?.id} class="bg-brand-ink text-white">{s.name}</option>
                ))}
              </select>
              {activeSeason?.logo_url && (
                <img src={activeSeason.logo_url} alt="" class="h-9 w-9 flex-none rounded object-contain" />
              )}
            </div>
          </label>
          {view === 'class' && (
            <label class="flex flex-col gap-1.5 text-sm">
              <span class="text-white/60">Class</span>
              <select
                name="class"
                onchange="this.form.submit()"
                class="rounded-md border border-white/15 bg-white/5 px-3 py-2 text-white outline-none focus:border-brand-primary"
              >
                {classesForActiveSeason.map((c) => (
                  <option value={c.name} selected={c.id === activeClass?.id} class="bg-brand-ink text-white">{c.name}</option>
                ))}
              </select>
            </label>
          )}
        </form>

        <div class="flex gap-2">
          <a
            href={`/standings?view=overall${activeSeason ? `&season=${activeSeason.number}` : ''}`}
            class={`rounded-lg px-4 py-1.5 text-sm font-semibold ring-1 ring-white/15 transition ${
              view === 'overall' ? 'bg-white text-brand-ink' : 'text-white/80 hover:bg-white/10'
            }`}
          >
            Overall
          </a>
          <a
            href={`/standings?view=class${activeSeason ? `&season=${activeSeason.number}` : ''}${activeClass ? `&class=${activeClass.name}` : ''}`}
            class={`rounded-lg px-4 py-1.5 text-sm font-semibold ring-1 ring-white/15 transition ${
              view === 'class' ? 'bg-white text-brand-ink' : 'text-white/80 hover:bg-white/10'
            }`}
          >
            Per Class
          </a>
        </div>
      </div>
    )}

    {!loadError && standings.length === 0 && (
      <p class="mt-10 text-white/60">No results.</p>
    )}

    {!loadError && standings.length > 0 && (
      <div class="mt-8 overflow-x-auto rounded-xl border border-white/10">
        <table class="w-full border-collapse" data-sortable>
          <thead>
            <tr class="border-b border-white/10 text-left text-xs uppercase tracking-wide text-white/40">
              <th class="py-3 pl-4 pr-2 font-medium" data-sort-key="position">Pos</th>
              <th class="py-3 pr-3 font-medium" data-sort-key="driver">Driver</th>
              {view === 'overall' && <th class="hidden py-3 pr-3 font-medium sm:table-cell">Class</th>}
              <th class="py-3 pr-3 text-center font-medium" data-sort-key="points">Points</th>
              <th class="hidden py-3 pr-3 text-center font-medium sm:table-cell" data-sort-key="wins">Wins</th>
              <th class="hidden py-3 pr-3 text-center font-medium sm:table-cell" data-sort-key="podiums">Podiums</th>
              <th class="hidden py-3 pr-3 text-center font-medium md:table-cell" data-sort-key="top5">Top 5<span class="lowercase">s</span></th>
              <th class="hidden py-3 pr-3 text-center font-medium md:table-cell" data-sort-key="top10">Top 10<span class="lowercase">s</span></th>
              <th class="hidden py-3 pr-3 text-center font-medium lg:table-cell" data-sort-key="poles">Poles</th>
              <th class="hidden py-3 pr-3 text-center font-medium lg:table-cell" data-sort-key="starts">Starts</th>
              <th class="py-3 pr-4 text-center font-medium" data-sort-key="appearances">Apps</th>
            </tr>
          </thead>
          <tbody>
            {standings.map((row) => {
              const extras = extrasByDriverId.get(row.driver.id);
              const ext = extendedStatsByDriverId.get(row.driver.id);
              return (
                <>
                <tr
                  data-expand-row
                  tabindex="0"
                  role="button"
                  aria-expanded="false"
                  class="cursor-pointer border-b border-white/5 text-sm transition hover:bg-white/[0.04]"
                >
                  <td class="py-2.5 pl-4 pr-2 font-display text-lg leading-none text-white/70" data-col="position">{row.position}</td>
                  <td class="py-2.5 pr-3 font-semibold" data-col="driver" data-sort-value={row.driver.name}>
                    <div class="flex flex-wrap items-center gap-2">
                      <span
                        data-chevron
                        class="inline-block shrink-0 text-[9px] text-white/30 transition-transform duration-150"
                        aria-hidden="true"
                      >
                        &#9654;
                      </span>
                      <span>
                        {displayDriverName(row.driver.name)} {row.driver.car_number !== null && <span class="text-white/40">#{row.driver.car_number}</span>}
                      </span>
                      <DriverFlag nationality1={row.driver.nationality_1} nationality2={row.driver.nationality_2} />
                      {/* Cars first, teams second — every driver has a car, not every driver has a team. */}
                      {extras?.cars.map((c) => (
                        <TeamLogo name={c.carName} logoUrl={c.logoUrl} size="h-5 w-5" title={`${c.carName} — ${raceWord(c.races)}`} />
                      ))}
                      {extras?.teams.map((t) => (
                        <TeamLogo
                          name={t.teamName}
                          logoUrl={t.logoUrl}
                          size="h-5 w-5"
                          title={`${t.teamName} — ${raceWord(t.racesUnderTeam)} under this team, ${raceWord(t.racesScoredForTeam)} scored for the team`}
                        />
                      ))}
                    </div>
                  </td>
                  {view === 'overall' && (
                    <td class="hidden py-2.5 pr-3 sm:table-cell">
                      {row.classId !== undefined && (
                        <span class={`rounded-lg border px-2 py-0.5 text-[11px] font-semibold uppercase tracking-wide ${classBadgeClasses(classNameById.get(row.classId) ?? '')}`}>
                          {classNameById.get(row.classId) ?? '—'}
                        </span>
                      )}
                    </td>
                  )}
                  <td class="py-2.5 pr-3 text-center font-semibold" data-col="points">{row.totalPoints}</td>
                  <td class="hidden py-2.5 pr-3 text-center text-white/60 sm:table-cell" data-col="wins">{row.wins}</td>
                  <td class="hidden py-2.5 pr-3 text-center text-white/60 sm:table-cell" data-col="podiums">{row.podiums}</td>
                  <td class="hidden py-2.5 pr-3 text-center text-white/60 md:table-cell" data-col="top5">{row.top5s}</td>
                  <td class="hidden py-2.5 pr-3 text-center text-white/60 md:table-cell" data-col="top10">{row.top10s}</td>
                  <td class="hidden py-2.5 pr-3 text-center text-white/60 lg:table-cell" data-col="poles">{row.poles}</td>
                  <td class="hidden py-2.5 pr-3 text-center text-white/60 lg:table-cell" data-col="starts" data-sort-value={row.starts}>
                    {row.starts} <span class="text-white/30">of {maxStarts}</span>
                  </td>
                  <td class="py-2.5 pr-4 text-center text-white/60" data-col="appearances" data-sort-value={row.appearances}>
                    {row.appearances} <span class="text-white/30">of {maxAppearances}</span>
                  </td>
                </tr>
                <tr data-detail-row class="hidden border-b border-white/5 bg-white/[0.02] text-xs">
                  <td colspan={view === 'overall' ? 11 : 10} class="px-4 py-4 sm:pl-11">
                    <div class="grid grid-cols-2 gap-x-4 gap-y-3 sm:grid-cols-4">
                      <div>
                        <div class="text-[10px] uppercase tracking-wide text-white/30">Laps</div>
                        <div class="mt-0.5 font-display text-sm text-white/90">{ext?.laps ?? 0}</div>
                      </div>
                      <div>
                        <div class="text-[10px] uppercase tracking-wide text-white/30">Laps Led</div>
                        <div class="mt-0.5 font-display text-sm text-white/90">{ext?.lapsLed ?? 0}</div>
                      </div>
                      <div>
                        <div class="text-[10px] uppercase tracking-wide text-white/30">Net Positions</div>
                        <div class="mt-0.5 font-display text-sm text-white/90">
                          {ext && ext.netPositionsChange > 0 ? '+' : ''}
                          {ext?.netPositionsChange ?? 0}
                        </div>
                      </div>
                      <div>
                        <div class="text-[10px] uppercase tracking-wide text-white/30">Incidents / Lap</div>
                        <div class="mt-0.5 font-display text-sm text-white/90">
                          {ext?.incidentsPerLap !== null && ext?.incidentsPerLap !== undefined ? ext.incidentsPerLap.toFixed(2) : '—'}
                        </div>
                      </div>
                      <div>
                        <div class="text-[10px] uppercase tracking-wide text-white/30">Corners / Incident</div>
                        <div class="mt-0.5 font-display text-sm text-white/90">
                          {ext?.cornersPerIncident !== null && ext?.cornersPerIncident !== undefined ? ext.cornersPerIncident.toFixed(1) : '—'}
                        </div>
                      </div>
                      <div>
                        <div class="text-[10px] uppercase tracking-wide text-white/30">Penalty Points</div>
                        <div class="mt-0.5 font-display text-sm text-white/90">{ext?.penaltyPoints ?? 0}</div>
                      </div>
                      <div>
                        <div class="text-[10px] uppercase tracking-wide text-white/30">Bonus Points</div>
                        <div class="mt-0.5 font-display text-sm text-white/90">{ext?.bonusPoints ?? 0}</div>
                      </div>
                      <div>
                        <div class="text-[10px] uppercase tracking-wide text-white/30">Distance Driven</div>
                        <div class="mt-0.5 font-display text-sm text-white/90">
                          {ext?.distanceKm !== null && ext?.distanceKm !== undefined ? `${ext.distanceKm.toFixed(1)} km` : '—'}
                        </div>
                      </div>
                    </div>
                  </td>
                </tr>
                </>
              );
            })}
          </tbody>
        </table>
      </div>
    )}
  </section>
</Layout>
