---
export const prerender = false;

import Layout from '../layouts/Layout.astro';
import { resolveSupabaseEnv, getPageBanners } from '../lib/supabase';
import { bannerUrlFor } from '../lib/pageBanners';

// Shell-then-skeleton split (same pattern as results.astro / standings.astro):
// this file only fetches the admin-managed hero image and paints the page
// frame plus a loading skeleton right away. Everything data-heavy — latest
// news, upcoming events, previous result, standings widget — lives in
// home/fragment.astro and is fetched client-side by the loader script at the
// bottom once this shell has painted. The widget interaction scripts (also at
// the bottom) bind per-element at astro:page-load, so they pick up the
// fragment's dropdowns when it lands (a <script> inside fetched HTML would
// never execute, which is why they stay here).
const supabaseEnv = resolveSupabaseEnv(Astro.locals);

// No image configured just means no image: the section renders plain black
// (this site's bg-brand-ink), same as the body behind it.
let heroImageUrl: string | null = null;
try {
  heroImageUrl = bannerUrlFor(await getPageBanners(supabaseEnv), 'home');
} catch (err) {
  console.error('Failed to load homepage banner:', err);
}

Astro.response.headers.set('Cache-Control', 'public, s-maxage=60, stale-while-revalidate=300');
---

<Layout title="Home">
  <section class="relative px-6 pb-24 pt-8">
    {heroImageUrl && (
      <>
        <div
          class="pointer-events-none absolute inset-x-0 top-0 -z-20 h-[32rem] bg-cover bg-center sm:h-[40rem]"
          style={`background-image: url('${heroImageUrl}')`}
        >
        </div>
        <div class="banner-overlay pointer-events-none absolute inset-x-0 top-0 -z-10 h-[32rem] sm:h-[40rem]"></div>
      </>
    )}


    <div data-home-results data-fragment-url="/home/fragment">
      <div class="mx-auto mt-6 grid max-w-6xl gap-12 lg:grid-cols-2 lg:items-start lg:gap-16" aria-live="polite" aria-busy="true">
        <span class="sr-only">Loading…</span>
        <div class="min-w-0">
          <div class="h-9 w-48 animate-pulse rounded-md bg-white/[0.03]"></div>
          <div class="mt-4 h-72 animate-pulse rounded-xl border border-white/10 bg-white/[0.03]"></div>
          <div class="mt-4 h-5 w-3/4 animate-pulse rounded bg-white/[0.03]"></div>
          <div class="mt-12 h-9 w-40 animate-pulse rounded-md bg-white/[0.03]"></div>
          <div class="mt-4 flex flex-col gap-3">
            <div class="h-5 animate-pulse rounded bg-white/[0.03]"></div>
            <div class="h-5 animate-pulse rounded bg-white/[0.03]"></div>
            <div class="h-5 animate-pulse rounded bg-white/[0.03]"></div>
            <div class="h-5 animate-pulse rounded bg-white/[0.03]"></div>
          </div>
        </div>
        <div class="min-w-0">
          <div class="h-9 w-48 animate-pulse rounded-md bg-white/[0.03]"></div>
          <div class="mt-4 h-52 animate-pulse rounded-xl border border-white/10 bg-white/[0.03]"></div>
          <div class="mt-12 h-9 w-40 animate-pulse rounded-md bg-white/[0.03]"></div>
          <div class="mt-4 h-60 animate-pulse rounded-xl border border-white/10 bg-white/[0.03]"></div>
        </div>
      </div>
    </div>
  </section>
</Layout>

<script>
  // Shell-then-skeleton: fetches the home fragment (the expensive data work)
  // client-side once this shell has already painted — same pattern as
  // results.astro / standings.astro; see the matching fragment.astro for the
  // full explanation.
  function initHomeResults() {
    const container = document.querySelector<HTMLElement>('[data-home-results]');
    const url = container?.dataset.fragmentUrl;
    if (!container || !url) return;
    // Cleared immediately so the synthetic astro:page-load dispatched below
    // doesn't see this same data-fragment-url and fetch it all over again.
    delete container.dataset.fragmentUrl;

    fetch(url)
      .then((res) => {
        if (!res.ok) throw new Error(`home fragment request failed (${res.status})`);
        return res.text();
      })
      .then((html) => {
        container.innerHTML = html;
        // reveal.ts only observes `.reveal` elements present at page-load
        // time; this content lands later, so mark it visible right away.
        container.querySelectorAll('.reveal').forEach((el) => el.classList.add('is-visible'));
        // Sortable tables, row expanders and this page's own scripts bind
        // against whatever exists at astro:page-load, so re-dispatch it now
        // that the real content is in place.
        document.dispatchEvent(new Event('astro:page-load'));
      })
      .catch((err) => {
        console.error('Failed to load home:', err);
        container.innerHTML = '<p class="mt-10 text-white/60">Couldn’t load this page right now — try refreshing.</p>';
      });
  }

  document.addEventListener('astro:page-load', initHomeResults);
</script>


<script>
  function initStandingsWidget() {
    document.querySelectorAll<HTMLElement>('[data-standings-widget]').forEach((widget) => {
      if (widget.dataset.standingsInit === 'true') return;
      widget.dataset.standingsInit = 'true';

      const select = widget.querySelector<HTMLSelectElement>('[data-standings-select]');
      const panels = Array.from(widget.querySelectorAll<HTMLElement>('[data-standings-panel]'));
      if (!select) return;

      select.addEventListener('change', () => {
        panels.forEach((panel) => {
          panel.classList.toggle('hidden', panel.dataset.standingsPanel !== select.value);
        });
      });
    });
  }

  // Previous Result widget: a session dropdown (Practice/Qualifying/Race
  // 1/2/3...) and, per session, its own result-type dropdown (Overall/
  // Alpha/Delta/Gamma, plus Alpha/Delta Team on Race sessions only) — see
  // the long comment on the markup above for why there's one result-type
  // <select> per session rather than one shared <select> whose options get
  // rewritten in JS. Switching session shows that session's own
  // result-type <select> and resets it to its first option (a team-tab
  // selection from a Race session wouldn't exist on Practice/Qualifying),
  // then shows the matching result panel; switching result type just
  // toggles panels within the currently-visible session.
  function initPreviousResultWidget() {
    document.querySelectorAll<HTMLElement>('[data-previous-result-widget]').forEach((widget) => {
      if (widget.dataset.previousResultInit === 'true') return;
      widget.dataset.previousResultInit = 'true';

      const sessionSelect = widget.querySelector<HTMLSelectElement>('[data-session-select]');
      const resultTypeSelects = Array.from(widget.querySelectorAll<HTMLSelectElement>('[data-result-type-select]'));
      const sessionPanels = Array.from(widget.querySelectorAll<HTMLElement>('[data-session-panel]'));
      if (!sessionSelect) return;

      function showResultPanel(sessionPanel: HTMLElement, tabKey: string) {
        sessionPanel.querySelectorAll<HTMLElement>('[data-result-panel]').forEach((panel) => {
          panel.classList.toggle('hidden', panel.dataset.resultPanel !== tabKey);
        });
      }

      function activateSession(sessionKey: string) {
        sessionPanels.forEach((panel) => {
          panel.classList.toggle('hidden', panel.dataset.sessionPanel !== sessionKey);
        });
        resultTypeSelects.forEach((select) => {
          select.classList.toggle('hidden', select.dataset.session !== sessionKey);
        });
        const activeSelect = resultTypeSelects.find((select) => select.dataset.session === sessionKey);
        const activePanel = sessionPanels.find((panel) => panel.dataset.sessionPanel === sessionKey);
        if (activeSelect && activePanel) {
          activeSelect.selectedIndex = 0;
          showResultPanel(activePanel, activeSelect.value);
        }
      }

      sessionSelect.addEventListener('change', () => activateSession(sessionSelect.value));

      resultTypeSelects.forEach((select) => {
        select.addEventListener('change', () => {
          const panel = sessionPanels.find((p) => p.dataset.sessionPanel === select.dataset.session);
          if (panel) showResultPanel(panel, select.value);
        });
      });
    });
  }

  document.addEventListener('astro:page-load', initStandingsWidget);
  document.addEventListener('astro:page-load', initPreviousResultWidget);
</script>
