---
export const prerender = false;

// The Event Briefing page — linked only from the homepage's next-upcoming-
// event card (src/components/UpcomingEventCard.astro, left of "Add to
// Calendar"), for whichever event is chronologically next. Not otherwise
// restricted at this page's own level (reachable by URL for any real,
// track-having event) — same "not linked everywhere, but not gated either"
// approach as /results/[subsessionId].astro's own pages.
import Layout from '../../layouts/Layout.astro';
import {
  resolveSupabaseEnv,
  getEventById,
  getCircuits,
  getAllCircuitLayouts,
  getDriverClasses,
  getPenaltiesForSubsessions,
  getCarLogos,
  getRaceLinksForSubsessions,
  formatDate,
  formatLapTime,
  displayLayoutName,
  displayDriverName,
  layoutImageUrl,
  type EventRecord,
  type Circuit,
  type CircuitLayout,
  type CarLogo,
  type RaceLinks,
} from '../../lib/supabase';
import { getEventSessions, formatSessionTime, CATEGORY_LABELS } from '../../lib/eventFormatting';
import {
  resolveLayout,
  findRoundsForLayout,
  getAllRounds,
  getRoundLayoutsForSubsessions,
  getLayoutClassHighlights,
  getLayoutClassBestLaps,
  driversSelect,
  describePenaltyResolution,
  type LayoutRoundSummary,
  type LayoutHighlights,
  type ClassBestLap,
} from '../../lib/results';
import { classBadgeClasses } from '../../lib/classColors';
import WeatherIcon from '../../components/WeatherIcon.astro';

const supabaseEnv = resolveSupabaseEnv(Astro.locals);
const eventId = Astro.params.eventId ?? '';

let event: EventRecord | null = null;
let loadError: string | null = null;
try {
  event = await getEventById(supabaseEnv, eventId);
} catch (err) {
  console.error('Failed to load event for the Event Briefing page:', err);
  loadError = err instanceof Error ? err.message : String(err);
}

// No event, or a HOLIDAY/IRACING event (no track at all — nothing to brief;
// see EventRecord.circuit_id's own doc comment) — bounce home rather than
// showing an empty page.
if (!loadError && (!event || !event.circuit_id)) {
  return Astro.redirect('/', 302);
}

const sessions = event ? getEventSessions(event) : [];

let circuit: Circuit | null = null;
let layoutRow: CircuitLayout | null = null;
let imageUrl: string | null = null;
let classes: Awaited<ReturnType<typeof getDriverClasses>> = [];
let classNameById = new Map<number, string>();
let historicalRounds: LayoutRoundSummary[] = [];
let highlights: LayoutHighlights = { winnersByClass: new Map(), polesByClass: new Map() };
let classBestLaps: Map<number, ClassBestLap> = new Map();
interface IncidentEntry {
  round: LayoutRoundSummary;
  /** "#12", or the driver's display name as a fallback when they have no car_number on file, or "Racing Incident" when no driver is attached at all — see item 5/8 of Logan's briefing tweaks. */
  identityLabel: string;
  description: string;
  /** From describePenaltyResolution() — null when this penalty carries no consequence at all. */
  resolution: string | null;
}
let incidentEntries: IncidentEntry[] = [];
/** One race's broadcast or photo-album link, paired with the historical round it belongs to for date/season display — same shape for both new sections below, just holding whichever url applies. */
interface MediaEntry {
  round: LayoutRoundSummary;
  raceNumber: number;
  url: string;
}
let broadcastEntries: MediaEntry[] = [];
let photoAlbumEntries: MediaEntry[] = [];

if (!loadError && event && event.circuit_id) {
  try {
    const [circuits, layouts, driverClasses, allRounds, drivers, carLogos] = await Promise.all([
      getCircuits(supabaseEnv),
      getAllCircuitLayouts(supabaseEnv),
      getDriverClasses(supabaseEnv),
      getAllRounds(supabaseEnv),
      driversSelect(supabaseEnv, { includeAi: true }),
      getCarLogos(supabaseEnv),
    ]);

    circuit = circuits.find((c) => c.id === event!.circuit_id) ?? null;
    layoutRow = circuit ? resolveLayout(circuit.name, event.layout, circuits, layouts) : null;
    imageUrl = layoutRow ? layoutImageUrl(layoutRow, circuit) : (circuit?.logo_url ?? null);
    classes = driverClasses;
    classNameById = new Map(classes.map((c) => [c.id, c.name]));

    const roundLayoutBySubsession = await getRoundLayoutsForSubsessions(
      supabaseEnv,
      allRounds.map((r) => r.subsession_id)
    );
    historicalRounds = findRoundsForLayout(allRounds, roundLayoutBySubsession, circuits, layouts, event.circuit_id, event.layout);

    const [layoutHighlights, layoutClassBestLaps, penalties, raceLinks] = await Promise.all([
      getLayoutClassHighlights(supabaseEnv, historicalRounds, drivers),
      getLayoutClassBestLaps(supabaseEnv, historicalRounds, drivers, carLogos),
      getPenaltiesForSubsessions(
        supabaseEnv,
        historicalRounds.map((r) => r.subsessionId)
      ),
      getRaceLinksForSubsessions(
        supabaseEnv,
        historicalRounds.map((r) => r.subsessionId)
      ),
    ]);
    highlights = layoutHighlights;
    classBestLaps = layoutClassBestLaps;

    const driverById = new Map(drivers.map((d) => [d.id, d]));
    const roundBySubsession = new Map(historicalRounds.map((r) => [r.subsessionId, r]));
    incidentEntries = penalties
      .map((p): IncidentEntry | null => {
        const round = roundBySubsession.get(p.subsession_id);
        if (!round) return null;
        const driver = p.driver_id ? driverById.get(p.driver_id) : null;
        const identityLabel = driver
          ? driver.car_number !== null
            ? `#${driver.car_number}`
            : displayDriverName(driver.name)
          : 'Racing Incident';
        return {
          round,
          identityLabel,
          description: p.description?.trim() || 'No description provided.',
          resolution: describePenaltyResolution(p),
        };
      })
      .filter((x): x is IncidentEntry => x !== null)
      .sort((a, b) => b.round.startTime.localeCompare(a.round.startTime));

    const byRoundDesc = (a: MediaEntry, b: MediaEntry) => b.round.startTime.localeCompare(a.round.startTime);
    broadcastEntries = raceLinks
      .filter((l): l is RaceLinks & { broadcast_url: string } => l.broadcast_url !== null)
      .map((l): MediaEntry | null => {
        const round = roundBySubsession.get(l.subsession_id);
        return round ? { round, raceNumber: l.race_number, url: l.broadcast_url } : null;
      })
      .filter((x): x is MediaEntry => x !== null)
      .sort(byRoundDesc);
    photoAlbumEntries = raceLinks
      .filter((l): l is RaceLinks & { photo_album_url: string } => l.photo_album_url !== null)
      .map((l): MediaEntry | null => {
        const round = roundBySubsession.get(l.subsession_id);
        return round ? { round, raceNumber: l.race_number, url: l.photo_album_url } : null;
      })
      .filter((x): x is MediaEntry => x !== null)
      .sort(byRoundDesc);
  } catch (err) {
    console.error('Failed to load Event Briefing historical data:', err);
    loadError = err instanceof Error ? err.message : String(err);
  }
}

const orderedClassIdsWithWinners = classes.map((c) => c.id).filter((id) => highlights.winnersByClass.has(id) || highlights.polesByClass.has(id));

// Gamma/Delta only (per Logan) — Alpha's own class-best is typically
// indistinguishable from the plain fastest-lap-ever figure already shown
// above from circuit_layouts.lap_record_seconds, so a separate Alpha line
// would mostly just repeat it.
const gammaClass = classes.find((c) => c.name === 'Gamma') ?? null;
const deltaClass = classes.find((c) => c.name === 'Delta') ?? null;
const gammaBestLap = gammaClass ? (classBestLaps.get(gammaClass.id) ?? null) : null;
const deltaBestLap = deltaClass ? (classBestLaps.get(deltaClass.id) ?? null) : null;

const circuitName = circuit?.name ?? event?.title ?? 'TBA';
const layoutDisplayName = event?.layout ? displayLayoutName(event.layout) : event?.subtitle ?? null;

Astro.response.headers.set('Cache-Control', 'public, s-maxage=60, stale-while-revalidate=300');
---

<Layout title={event ? `Event Briefing — ${circuitName}` : 'Event Briefing'} description="Everything to know before the next race weekend.">
  <section class="mx-auto max-w-4xl px-6 pb-24 pt-28 sm:pt-36">
    <a href="/" class="text-sm text-white/50 hover:text-white">&larr; Back to Home</a>

    {loadError && (
      <p class="mt-4 rounded-lg border border-brand-pink/30 bg-brand-pink/10 p-4 text-sm text-white/80">
        Couldn't load this event's briefing right now.
        <br /><span class="mt-1 block text-white/50">{loadError}</span>
      </p>
    )}

    {event && (
      <>
        <div class="reveal mt-4 flex items-center gap-4" style="transition-delay: 40ms">
          {imageUrl && <img src={imageUrl} alt="" class="h-14 w-14 flex-none rounded object-contain" />}
          <div>
            <p class="font-display text-sm uppercase tracking-widest text-white/60">Event Briefing</p>
            <h1 class="font-display text-4xl leading-none sm:text-5xl">{circuitName}</h1>
            {layoutDisplayName && <p class="mt-1 text-white/50">{layoutDisplayName}</p>}
          </div>
        </div>

        {/* 1. Schedule breakdown — same session data as the homepage's
            featured event card (UpcomingEventCard.astro), split into
            separate IRL/In-Sim/Length columns here per Logan rather than
            that card's single combined text blob. */}
        <div class="reveal mt-8" style="transition-delay: 80ms">
          <h2 class="font-display text-2xl uppercase tracking-widest text-white/50">Schedule</h2>
          <div class="mt-3 overflow-x-auto rounded-xl border border-white/10">
            {sessions.length === 0 ? (
              <p class="p-4 text-sm text-white/40">No sessions scheduled yet.</p>
            ) : (
              <table class="w-full border-collapse text-sm">
                <thead>
                  <tr class="border-b border-white/10 text-left text-xs uppercase tracking-wide text-white/40">
                    <th class="py-3 pl-4 pr-2 font-medium">Session</th>
                    <th class="py-3 pr-2 font-medium">IRL</th>
                    <th class="py-3 pr-2 font-medium">In-Sim</th>
                    <th class="py-3 pr-4 font-medium">Length</th>
                  </tr>
                </thead>
                <tbody>
                  {sessions.map((s, i) => (
                    <tr class={i > 0 ? 'border-t border-white/5' : ''}>
                      <td class="py-3 pl-4 pr-2 font-semibold">
                        <span class="flex items-center gap-1.5">
                          <WeatherIcon condition={s.weather} class="text-base" />
                          {s.label}
                        </span>
                      </td>
                      <td class="py-3 pr-2 text-white/70">
                        {s.startTime ? <span data-utc-time={s.startTimeUtcIso ?? undefined}>{formatSessionTime(s.startTime)} ET</span> : '—'}
                      </td>
                      <td class="py-3 pr-2 text-white/70">{s.simTime ? formatSessionTime(s.simTime) : '—'}</td>
                      <td class="py-3 pr-4 text-white/70">{s.detail ?? '—'}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            )}
          </div>
        </div>

        {/* 2. Track record — the admin-curated circuit_layouts fields
            (lap_record_seconds/holder/date), same source/format
            circuits.astro already shows publicly; not re-derived from raw
            lap data here since this field is the site's one deliberately
            curated "official" record (may predate this league, or come
            from a source broader than ATC's own imported results). Below
            it, Gamma's and Delta's own fastest-lap-ever AT this layout —
            these ARE derived from ATC's own imported race results (see
            getLayoutClassBestLaps), since there's no curated per-class
            field for them to read from. Class is resolved per round from
            that driver's race_scores.class_id at the time, never off their
            current roster class. */}
        <div class="reveal mt-8" style="transition-delay: 100ms">
          <h2 class="font-display text-2xl uppercase tracking-widest text-white/50">Track Record</h2>
          <div class="mt-3 rounded-xl border border-white/10 p-4 text-sm">
            {layoutRow && layoutRow.lap_record_seconds !== null ? (
              <p>
                <span class="font-display text-2xl">{formatLapTime(layoutRow.lap_record_seconds)}</span>
                {layoutRow.lap_record_holder && <span class="ml-2 text-white/70">{layoutRow.lap_record_holder}</span>}
                {layoutRow.lap_record_date && <span class="ml-1 text-white/40">({formatDate(layoutRow.lap_record_date)})</span>}
              </p>
            ) : (
              <p class="text-white/40">No lap record on file for this layout.</p>
            )}

            {(gammaBestLap || deltaBestLap) && (
              <div class="mt-3 space-y-1.5 border-t border-white/10 pt-3">
                {gammaBestLap && gammaClass && (
                  <p class="flex flex-wrap items-center gap-2">
                    <span class={`rounded border px-1.5 py-0.5 text-[10px] font-semibold uppercase tracking-wide ${classBadgeClasses(gammaClass.name)}`}>
                      {gammaClass.name}
                    </span>
                    <span class="font-semibold">{formatLapTime(gammaBestLap.seconds)}</span>
                    <span class="text-white/70">{displayDriverName(gammaBestLap.driver.name)}</span>
                    {gammaBestLap.carLogoUrl && (
                      <img src={gammaBestLap.carLogoUrl} alt={gammaBestLap.carName ?? ''} class="h-5 w-5 flex-none rounded object-contain" />
                    )}
                    <span class="text-white/40">({formatDate(gammaBestLap.date)})</span>
                  </p>
                )}
                {deltaBestLap && deltaClass && (
                  <p class="flex flex-wrap items-center gap-2">
                    <span class={`rounded border px-1.5 py-0.5 text-[10px] font-semibold uppercase tracking-wide ${classBadgeClasses(deltaClass.name)}`}>
                      {deltaClass.name}
                    </span>
                    <span class="font-semibold">{formatLapTime(deltaBestLap.seconds)}</span>
                    <span class="text-white/70">{displayDriverName(deltaBestLap.driver.name)}</span>
                    {deltaBestLap.carLogoUrl && (
                      <img src={deltaBestLap.carLogoUrl} alt={deltaBestLap.carName ?? ''} class="h-5 w-5 flex-none rounded object-contain" />
                    )}
                    <span class="text-white/40">({formatDate(deltaBestLap.date)})</span>
                  </p>
                )}
              </div>
            )}
          </div>
        </div>

        {/* 3. Past winners & pole-sitters, per class — see
            getLayoutClassHighlights in src/lib/results.ts for how these are
            derived (race 1 only, scored_position for winner,
            starting_position for pole). */}
        <div class="reveal mt-8" style="transition-delay: 120ms">
          <h2 class="font-display text-2xl uppercase tracking-widest text-white/50">Past Winners &amp; Pole-Sitters</h2>
          {orderedClassIdsWithWinners.length === 0 ? (
            <p class="mt-3 text-sm text-white/40">No history at this layout yet.</p>
          ) : (
            <div class="mt-3 grid gap-4 sm:grid-cols-3">
              {orderedClassIdsWithWinners.map((classId) => {
                const winners = highlights.winnersByClass.get(classId) ?? [];
                const poles = highlights.polesByClass.get(classId) ?? [];
                return (
                  <div class="rounded-xl border border-white/10 p-4">
                    <span class={`rounded-lg border px-2 py-0.5 text-[11px] font-semibold uppercase tracking-wide ${classBadgeClasses(classNameById.get(classId) ?? '')}`}>
                      {classNameById.get(classId) ?? '—'}
                    </span>
                    <div class="mt-3">
                      <p class="text-[11px] font-medium uppercase tracking-wide text-white/40">Winners</p>
                      <ul class="mt-1 space-y-1 text-sm">
                        {winners.map((w) => (
                          <li class="flex items-center justify-between gap-2">
                            <a href={`/results/${w.round.subsessionId}`} class="hover:text-brand-primary">
                              {displayDriverName(w.driver.name)}
                            </a>
                            <span class="text-xs text-white/40">{formatDate(w.round.startTime)}</span>
                          </li>
                        ))}
                      </ul>
                    </div>
                    <div class="mt-3">
                      <p class="text-[11px] font-medium uppercase tracking-wide text-white/40">Pole-Sitters</p>
                      <ul class="mt-1 space-y-1 text-sm">
                        {poles.map((p) => (
                          <li class="flex items-center justify-between gap-2">
                            <a href={`/results/${p.round.subsessionId}?category=qualifying`} class="hover:text-brand-primary">
                              {displayDriverName(p.driver.name)}
                            </a>
                            <span class="text-xs text-white/40">{formatDate(p.round.startTime)}</span>
                          </li>
                        ))}
                      </ul>
                    </div>
                  </div>
                );
              })}
            </div>
          )}
        </div>

        {/* 4. Past results at this circuit layout — same round list
            findRoundsForLayout() already powers for the calendar page's
            "Race Recaps at this Layout," just rendered here as plain links
            into the full results page rather than an expandable recap.
            Starts collapsed, like every section below it — a <details>
            wraps the heading + list together, same group/rotate-caret
            convention used site-wide (see circuits.astro), rather than the
            per-item collapse Past Incidents' descriptions use. */}
        <div class="reveal mt-8" style="transition-delay: 140ms">
          <details class="group">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-2">
              <h2 class="font-display text-2xl uppercase tracking-widest text-white/50">Past Results</h2>
              <span class="text-white/40 transition group-open:rotate-180">▾</span>
            </summary>
            <div class="mt-3">
              {historicalRounds.length === 0 ? (
                <p class="text-sm text-white/40">No past rounds at this layout yet.</p>
              ) : (
                <div class="overflow-hidden rounded-xl border border-white/10">
                  {historicalRounds.map((r, i) => (
                    <a
                      href={`/results/${r.subsessionId}`}
                      class={`flex items-center justify-between gap-3 p-3 text-sm transition hover:bg-white/5 ${i > 0 ? 'border-t border-white/10' : ''}`}
                    >
                      <span class="font-semibold">{r.seasonLabel ?? CATEGORY_LABELS.championship}</span>
                      <span class="text-white/50">{formatDate(r.startTime)}</span>
                    </a>
                  ))}
                </div>
              )}
            </div>
          </details>
        </div>

        {/* 5. Past incidents at this circuit layout — every penalty logged
            against any round found above, newest first, uncapped. Shows car
            numbers rather than driver names (falls back to name if a
            driver has no car_number on file), and "Racing Incident" (no
            driver attached) gets the exact same bold-white treatment as a
            real number rather than being dimmed — both are the row's
            "who" identity, just one of two kinds. The free-text description
            starts collapsed (often long/narrative) with its own toggle; the
            resolution (time/points/PP/warning, from describePenaltyResolution)
            stays always visible on its own line below it. The whole section
            (heading + list) also starts collapsed, same as Past Results. */}
        <div class="reveal mt-8" style="transition-delay: 160ms">
          <details class="group">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-2">
              <h2 class="font-display text-2xl uppercase tracking-widest text-white/50">Past Incidents</h2>
              <span class="text-white/40 transition group-open:rotate-180">▾</span>
            </summary>
            <div class="mt-3">
              {incidentEntries.length === 0 ? (
                <p class="text-sm text-white/40">No incidents logged at this layout yet.</p>
              ) : (
                <div class="overflow-hidden rounded-xl border border-white/10">
                  {incidentEntries.map((inc, i) => (
                    <div class={`p-3 text-sm ${i > 0 ? 'border-t border-white/10' : ''}`}>
                      <div class="flex flex-wrap items-center justify-between gap-2">
                        <span class="font-semibold text-white">{inc.identityLabel}</span>
                        <a href={`/results/${inc.round.subsessionId}/incidents`} class="text-xs text-white/40 hover:text-white">
                          {formatDate(inc.round.startTime)}
                        </a>
                      </div>
                      <details class="group mt-1">
                        <summary class="flex cursor-pointer list-none items-center gap-1 text-xs font-medium uppercase tracking-wide text-white/40 hover:text-white/60">
                          Description
                          <span class="text-white/30 transition group-open:rotate-180">▾</span>
                        </summary>
                        <p class="mt-1 text-white/70">{inc.description}</p>
                      </details>
                      {inc.resolution && <p class="mt-1 text-xs text-white/50">{inc.resolution}</p>}
                    </div>
                  ))}
                </div>
              )}
            </div>
          </details>
        </div>

        {/* 6. Past broadcasts at this circuit layout — every race_links row
            with a broadcast_url set, across the same historical rounds Past
            Results/Incidents above use, newest first. Same collapsed-by-
            default section shape as Past Results/Incidents; a plain link
            list (no thumbnail) since this is a compact briefing summary,
            not the Media page's own Videos → Broadcasts gallery. */}
        <div class="reveal mt-8" style="transition-delay: 180ms">
          <details class="group">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-2">
              <h2 class="font-display text-2xl uppercase tracking-widest text-white/50">Past Broadcasts</h2>
              <span class="text-white/40 transition group-open:rotate-180">▾</span>
            </summary>
            <div class="mt-3">
              {broadcastEntries.length === 0 ? (
                <p class="text-sm text-white/40">No broadcasts on file for this layout yet.</p>
              ) : (
                <div class="overflow-hidden rounded-xl border border-white/10">
                  {broadcastEntries.map((b, i) => (
                    <a
                      href={b.url}
                      target="_blank"
                      rel="noopener noreferrer"
                      class={`flex items-center justify-between gap-3 p-3 text-sm transition hover:bg-white/5 ${i > 0 ? 'border-t border-white/10' : ''}`}
                    >
                      <span class="font-semibold">
                        {b.round.seasonLabel ?? CATEGORY_LABELS.championship}
                        {b.raceNumber > 1 && ` — Race ${b.raceNumber}`}
                      </span>
                      <span class="text-white/50">{formatDate(b.round.startTime)}</span>
                    </a>
                  ))}
                </div>
              )}
            </div>
          </details>
        </div>

        {/* 7. Past photo albums at this circuit layout — same shape as Past
            Broadcasts just above, against race_links.photo_album_url. */}
        <div class="reveal mt-8" style="transition-delay: 200ms">
          <details class="group">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-2">
              <h2 class="font-display text-2xl uppercase tracking-widest text-white/50">Past Photo Albums</h2>
              <span class="text-white/40 transition group-open:rotate-180">▾</span>
            </summary>
            <div class="mt-3">
              {photoAlbumEntries.length === 0 ? (
                <p class="text-sm text-white/40">No photo albums on file for this layout yet.</p>
              ) : (
                <div class="overflow-hidden rounded-xl border border-white/10">
                  {photoAlbumEntries.map((p, i) => (
                    <a
                      href={p.url}
                      target="_blank"
                      rel="noopener noreferrer"
                      class={`flex items-center justify-between gap-3 p-3 text-sm transition hover:bg-white/5 ${i > 0 ? 'border-t border-white/10' : ''}`}
                    >
                      <span class="font-semibold">
                        {p.round.seasonLabel ?? CATEGORY_LABELS.championship}
                        {p.raceNumber > 1 && ` — Race ${p.raceNumber}`}
                      </span>
                      <span class="text-white/50">{formatDate(p.round.startTime)}</span>
                    </a>
                  ))}
                </div>
              )}
            </div>
          </details>
        </div>
      </>
    )}
  </section>
</Layout>
