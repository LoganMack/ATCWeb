---
export const prerender = false;
import LoadError from '../../components/LoadError.astro';
import { markUncacheable } from '../../lib/security';

import { resolveSupabaseEnv } from '../../lib/db/client';
import { displayDriverName, formatDateShort } from '../../lib/db/circuits';
import HistoryTabs from '../../components/HistoryTabs.astro';
import IncidentsAllTable from '../../components/IncidentsAllTable.astro';
import IncidentDetailsDialog from '../../components/IncidentDetailsDialog.astro';
import { getAllIncidents } from '../../lib/incidents';
import { sessionLabel, roundLabel, driverNumberLabel } from '../../lib/incidentDisplay';

/**
 * The three incident tables as a fragment for the incidents.astro shell, all from one getAllIncidents()
 * fetch. No <script> here: it would never run, so the tab switch lives in the shell. Never linked directly.
 */

const supabaseEnv = resolveSupabaseEnv(Astro.locals);

let loadError: string | null = null;
let data: Awaited<ReturnType<typeof getAllIncidents>> = { all: [], byDriver: [], byOffense: [] };
try {
  data = await getAllIncidents(supabaseEnv);
} catch (err) {
  console.error('Failed to load incidents (fragment):', err);
  loadError = err instanceof Error ? err.message : String(err);
}

/** Inc/Race and Pen/Race columns on the By Driver table — a driver with no races on file (shouldn't normally happen, but avoids a divide-by-zero) shows an em dash instead of a rate. */
function perRace(count: number, races: number): string {
  if (races === 0) return '—';
  return (count / races).toFixed(2);
}

Astro.response.headers.set('Cache-Control', 'public, s-maxage=60, stale-while-revalidate=300');
if (loadError) markUncacheable(Astro);
---

{loadError && <LoadError />}

{!loadError && (
  <div data-incidents-widget>
    <div class="reveal is-visible relative z-30 mt-12 rounded-xl border border-white/10 bg-brand-ink p-4">
     <div class="flex flex-wrap items-end gap-3">
      <HistoryTabs active="incidents" />
      <label class="flex flex-col gap-1.5 sm:w-56">
        <span class="text-xs font-semibold uppercase tracking-wide text-white/40">View</span>
        <select aria-label="View" data-incidents-select class="h-9 w-full rounded-md border border-white/15 bg-transparent px-3 text-sm text-white outline-none hover:bg-white/5 focus:border-brand-primary focus:bg-white/5">
          <option value="all" selected class="bg-brand-ink text-white">All Incidents ({data.all.length})</option>
          <option value="byDriver" data-label-base="By Driver" class="bg-brand-ink text-white">By Driver ({data.byDriver.length})</option>
          <option value="byOffense" class="bg-brand-ink text-white">By Offense ({data.byOffense.length})</option>
        </select>
      </label>
      {/* By Driver only (shown by the view switch in incidents.astro): drivers with fewer starts than this are left out. */}
      <div class="hidden flex-col gap-1.5" data-min-starts-wrap>
        <span class="text-xs font-semibold uppercase tracking-wide text-white/40">Minimum Starts</span>
        <div class="flex h-9 items-stretch overflow-hidden rounded-md border border-white/15 focus-within:border-brand-primary">
          <button type="button" data-min-starts-step="-1" aria-label="Decrease minimum starts" class="w-9 text-lg leading-none text-white/70 hover:bg-white/5 hover:text-white">&minus;</button>
          <input
            type="number"
            inputmode="numeric"
            min="0"
            step="1"
            value="0"
            data-min-starts-input
            aria-label="Minimum Starts"
            class="w-14 border-x border-white/15 bg-transparent px-1 text-center text-sm text-white outline-none [appearance:textfield] [&::-webkit-inner-spin-button]:appearance-none [&::-webkit-outer-spin-button]:appearance-none"
          />
          <button type="button" data-min-starts-step="1" aria-label="Increase minimum starts" class="w-9 text-lg leading-none text-white/70 hover:bg-white/5 hover:text-white">+</button>
        </div>
      </div>
     </div>
    </div>

    <!-- ================= All Incidents ================= -->
    <div data-incidents-panel="all" class="mt-6">
      {data.all.length === 0 ? (
        <p class="mt-6 text-white/60">No incidents logged yet.</p>
      ) : (
        <IncidentsAllTable rows={data.all} />
      )}
    </div>

    <!-- ================= By Driver ================= -->
    <div data-incidents-panel="byDriver" class="mt-6 hidden">
      <p class="hidden text-white/60" data-min-starts-empty>No drivers have that many starts.</p>
      {data.byDriver.length === 0 ? (
        <p class="mt-6 text-white/60">No incidents logged yet.</p>
      ) : (
        <div class="rounded-xl border border-white/10" data-sticky-thead>
          <table class="w-full border-collapse" data-sortable>
            <thead>
              <tr class="border-b border-white/10 text-left text-xs uppercase tracking-wide text-white/40">
                <th class="py-3 pl-4 pr-3 font-medium" data-sort-key="name">Driver</th>
                <th class="py-3 pr-3 text-center font-medium" data-sort-key="incidents">Incidents</th>
                <th class="py-3 pr-3 text-center font-medium" data-sort-key="incperrace">Inc/Race</th>
                <th class="py-3 pr-3 text-center font-medium" data-sort-key="penalized">Penalties</th>
                <th class="py-3 pr-3 text-center font-medium" data-sort-key="penperrace">Pen/Race</th>
                <th class="py-3 pr-3 text-center font-medium" data-sort-key="pp">Penalty Points</th>
                <th class="py-3 pr-4 text-center font-medium" data-sort-key="pointslost">Points Lost</th>
              </tr>
            </thead>
            <tbody>
              {data.byDriver.map((agg) => {
                const name = displayDriverName(agg.driver.name);
                return (
                  <>
                    <tr
                      data-expand-row
                      data-starts={agg.racesStarted}
                      tabindex="0"
                      role="button"
                      aria-expanded="false"
                      class="cursor-pointer border-b border-white/5 text-sm transition hover:bg-white/[0.04]"
                    >
                      <td class="py-2.5 pl-4 pr-3 font-semibold" data-col="name" data-sort-value={name}>
                        <div class="flex items-center gap-2">
                          <span data-chevron class="inline-block shrink-0 text-[9px] text-white/30 transition-transform duration-150" aria-hidden="true">
                            &#9654;
                          </span>
                          <span>
                            {name}
                            {agg.driver.car_number !== null && <span class="text-white/40"> #{agg.driver.car_number}</span>}
                          </span>
                        </div>
                      </td>
                      <td class="py-2.5 pr-3 text-center text-white/60" data-col="incidents">{agg.incidentsInvolvedIn}</td>
                      <td class="py-2.5 pr-3 text-center text-white/60" data-col="incperrace">{perRace(agg.incidentsInvolvedIn, agg.racesStarted)}</td>
                      <td class="py-2.5 pr-3 text-center text-white/60" data-col="penalized">{agg.timesPenalized}</td>
                      <td class="py-2.5 pr-3 text-center text-white/60" data-col="penperrace">{perRace(agg.timesPenalized, agg.racesStarted)}</td>
                      <td class="py-2.5 pr-3 text-center text-white/60" data-col="pp">{agg.penaltyPoints}</td>
                      <td class="py-2.5 pr-4 text-center text-white/60" data-col="pointslost">{agg.pointsLost}</td>
                    </tr>
                    <tr data-detail-row class="hidden border-b border-white/5 bg-white/[0.02] text-xs">
                      <td colspan={7} class="px-4 py-4 sm:pl-11">
                        <div data-sticky-thead>
                          <table class="w-full min-w-[640px] border-collapse">
                            <thead>
                              <tr class="border-b border-white/10 text-left text-[10px] uppercase tracking-wide text-white/30">
                                <th class="py-2 pr-3 font-medium">Date</th>
                                <th class="py-2 pr-3 font-medium">Round</th>
                                <th class="py-2 pr-3 font-medium">Session</th>
                                <th class="py-2 pr-3 font-medium">Penalized</th>
                                <th class="py-2 pr-3 font-medium">Offenses</th>
                                <th class="py-2 pr-3 text-center font-medium">PP</th>
                                <th class="py-2 pr-3 text-center font-medium">Time</th>
                                <th class="py-2 pr-3 text-center font-medium">Pts</th>
                              </tr>
                            </thead>
                            <tbody>
                              {agg.incidents.map((row) => (
                                <tr data-history-incident={row.id} tabindex="0" role="button" class="cursor-pointer border-b border-white/5 transition hover:bg-white/[0.04]">
                                  <td class="py-2 pr-3 text-white/60">{formatDateShort(row.startTime)}</td>
                                  <td class="py-2 pr-3 text-white/70">{roundLabel(row)}</td>
                                  <td class="py-2 pr-3 text-white/60">{sessionLabel(row)}</td>
                                  <td class={`py-2 pr-3 ${row.driver?.id === agg.driver.id ? 'font-bold text-white' : 'text-white/60'}`} title={row.driver ? displayDriverName(row.driver.name) : 'Racing Incident — no driver at fault'}>{driverNumberLabel(row)}</td>
                                  <td class="py-2 pr-3 text-white/60">{row.offenseNames.length > 0 ? row.offenseNames.join(', ') : '—'}</td>
                                  <td class="py-2 pr-3 text-center text-white/70">{row.penaltyPoints || '—'}</td>
                                  <td class="py-2 pr-3 text-center text-white/70">{row.timePenaltySeconds ? `+${row.timePenaltySeconds}s` : '—'}</td>
                                  <td class="py-2 pr-3 text-center text-white/70">{row.pointsPenalty || '—'}</td>
                                </tr>
                              ))}
                            </tbody>
                          </table>
                        </div>
                      </td>
                    </tr>
                  </>
                );
              })}
            </tbody>
          </table>
        </div>
      )}
    </div>

    <!-- ================= By Offense ================= -->
    <div data-incidents-panel="byOffense" class="mt-6 hidden">
      {data.byOffense.length === 0 ? (
        <p class="mt-6 text-white/60">No incidents logged yet.</p>
      ) : (
        <div class="rounded-xl border border-white/10" data-sticky-thead>
          <table class="w-full border-collapse" data-sortable>
            <thead>
              <tr class="border-b border-white/10 text-left text-xs uppercase tracking-wide text-white/40">
                <th class="py-3 pl-4 pr-3 font-medium" data-sort-key="name">Offense</th>
                <th class="py-3 pr-3 text-center font-medium" data-sort-key="incidents">Incidents</th>
                <th class="py-3 pr-3 text-center font-medium" data-sort-key="pp">Penalty Points</th>
                <th class="py-3 pr-4 text-center font-medium" data-sort-key="pointslost">Points Lost</th>
              </tr>
            </thead>
            <tbody>
              {data.byOffense.map((agg) => (
                <>
                  <tr
                    data-expand-row
                    tabindex="0"
                    role="button"
                    aria-expanded="false"
                    class="cursor-pointer border-b border-white/5 text-sm transition hover:bg-white/[0.04]"
                  >
                    <td class="py-2.5 pl-4 pr-3 font-semibold" data-col="name" data-sort-value={agg.offenseName}>
                      <div class="flex items-center gap-2">
                        <span data-chevron class="inline-block shrink-0 text-[9px] text-white/30 transition-transform duration-150" aria-hidden="true">
                          &#9654;
                        </span>
                        <span>{agg.offenseName}</span>
                      </div>
                    </td>
                    <td class="py-2.5 pr-3 text-center text-white/60" data-col="incidents">{agg.incidentCount}</td>
                    <td class="py-2.5 pr-3 text-center text-white/60" data-col="pp">{agg.penaltyPoints}</td>
                    <td class="py-2.5 pr-4 text-center text-white/60" data-col="pointslost">{agg.pointsLost}</td>
                  </tr>
                  <tr data-detail-row class="hidden border-b border-white/5 bg-white/[0.02] text-xs">
                    <td colspan={4} class="px-4 py-4 sm:pl-11">
                      <div data-sticky-thead>
                        <table class="w-full min-w-[640px] border-collapse">
                          <thead>
                            <tr class="border-b border-white/10 text-left text-[10px] uppercase tracking-wide text-white/30">
                              <th class="py-2 pr-3 font-medium">Date</th>
                              <th class="py-2 pr-3 font-medium">Round</th>
                              <th class="py-2 pr-3 font-medium">Session</th>
                              <th class="py-2 pr-3 font-medium">Penalized</th>
                              <th class="py-2 pr-3 text-center font-medium">PP</th>
                              <th class="py-2 pr-3 text-center font-medium">Time</th>
                              <th class="py-2 pr-3 text-center font-medium">Pts</th>
                            </tr>
                          </thead>
                          <tbody>
                            {agg.incidents.map((row) => (
                              <tr data-history-incident={row.id} tabindex="0" role="button" class="cursor-pointer border-b border-white/5 transition hover:bg-white/[0.04]">
                                <td class="py-2 pr-3 text-white/60">{formatDateShort(row.startTime)}</td>
                                <td class="py-2 pr-3 text-white/70">{roundLabel(row)}</td>
                                <td class="py-2 pr-3 text-white/60">{sessionLabel(row)}</td>
                                <td class="py-2 pr-3 text-white/60" title={row.driver ? displayDriverName(row.driver.name) : 'Racing Incident — no driver at fault'}>{driverNumberLabel(row)}</td>
                                <td class="py-2 pr-3 text-center text-white/70">{row.penaltyPoints || '—'}</td>
                                <td class="py-2 pr-3 text-center text-white/70">{row.timePenaltySeconds ? `+${row.timePenaltySeconds}s` : '—'}</td>
                                <td class="py-2 pr-3 text-center text-white/70">{row.pointsPenalty || '—'}</td>
                              </tr>
                            ))}
                          </tbody>
                        </table>
                      </div>
                    </td>
                  </tr>
                </>
              ))}
            </tbody>
          </table>
        </div>
      )}
    </div>

    <IncidentDetailsDialog rows={data.all} />
  </div>
)}
