---
export const prerender = false;

import Layout from '../layouts/Layout.astro';
import { resolveSupabaseEnv } from '../lib/db/client';
import { safeNext } from '../lib/security';
import { signInWithPassword, ACCESS_TOKEN_COOKIE, REFRESH_TOKEN_COOKIE, authCookieOptions } from '../lib/auth';

// The one sign-in page for every account; middleware checks profiles.role on /admin, so there's no separate
// admin login.

const supabaseEnv = resolveSupabaseEnv(Astro.locals);
// Validated: `next` is attacker-controllable, so only same-site paths pass (open-redirect fix).
const next = safeNext(Astro.url.searchParams.get('next'), '/');
const session = Astro.locals.session;

// Already signed in as a non-admin with `next` in /admin: redirecting would bounce back here, so show a "no
// admin access" notice.
const needsPromotion = Boolean(session && next.startsWith('/admin') && session.profile?.role !== 'admin');
if (session && !needsPromotion) {
  return Astro.redirect(next, 302);
}

let error: string | null = null;
const LOGIN_FAILED_MESSAGE = "Email or password is incorrect, or the account isn't confirmed yet.";

if (!needsPromotion && Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const email = String(form.get('email') ?? '').trim();
  const password = String(form.get('password') ?? '');

  if (!email || !password) {
    error = 'Enter both an email and a password.';
  } else {
    try {
      const newSession = await signInWithPassword(supabaseEnv, email, password);
      const cookieOptions = authCookieOptions(Astro.url);
      Astro.cookies.set(ACCESS_TOKEN_COOKIE, newSession.accessToken, { ...cookieOptions, maxAge: 60 * 60 });
      Astro.cookies.set(REFRESH_TOKEN_COOKIE, newSession.refreshToken, {
        ...cookieOptions,
        maxAge: 60 * 60 * 24 * 30,
      });
      return Astro.redirect(next, 302);
    } catch (err) {
      // One message for every failure, so the page never reveals whether an
      // email has an account or is unconfirmed. The real reason goes to the log.
      console.error('Login failed:', err);
      error = LOGIN_FAILED_MESSAGE;
    }
  }
}
---

<Layout title="Sign In">
  <section class="mx-auto flex max-w-sm flex-col px-6 pb-24 pt-8">
    <h1 class="reveal font-display text-lg sm:text-4xl">Sign In</h1>

    {error && (
      <p class="reveal mt-6 break-words rounded-lg border border-brand-pink/30 bg-brand-pink/10 p-4 text-sm text-white/80">{error}</p>
    )}

    {needsPromotion && session && (
      <div class="reveal mt-6 rounded-lg border border-brand-tertiary/30 bg-brand-tertiary/10 p-4 text-sm text-white/80">
        <p>
          You're signed in as <strong>{session.user.email}</strong>, but this account doesn't have admin access yet.
        </p>
        <p class="mt-2 text-white/60">Ask a site admin to give it admin access, then reload this page.</p>
        <form method="POST" action="/api/logout" class="mt-3">
          <button
            type="submit"
            class="btn btn-neutral"
          >
            Sign out
          </button>
        </form>
      </div>
    )}

    {!needsPromotion && (
      <form method="POST" data-astro-reload class="reveal mt-8 flex flex-col gap-4" style="transition-delay: 120ms">
        <label class="flex flex-col gap-1.5 text-sm">
          <span class="text-white/70">Email</span>
          <input
            type="email"
            name="email"
            required
            autocomplete="email"
            class="rounded-md border border-white/15 bg-white/5 px-3 py-2 text-white outline-none focus:border-brand-primary"
          />
        </label>
        <label class="flex flex-col gap-1.5 text-sm">
          <div class="flex items-center justify-between">
            <span class="text-white/70">Password</span>
            <a href="/forgot-password" class="text-xs text-brand-primary hover:underline">Forgot password?</a>
          </div>
          <input
            type="password"
            name="password"
            required
            autocomplete="current-password"
            class="rounded-md border border-white/15 bg-white/5 px-3 py-2 text-white outline-none focus:border-brand-primary"
          />
        </label>
        <button
          type="submit"
          class="btn btn-primary btn-lg mt-2"
        >
          Sign In
        </button>
        <p class="text-center text-xs text-white/40">
          Don't have an account? <a href="/signup" class="text-brand-primary hover:underline">Sign up</a>
        </p>
      </form>
    )}
  </section>
</Layout>
