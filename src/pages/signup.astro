---
export const prerender = false;

import Layout from '../layouts/Layout.astro';
import { resolveSupabaseEnv } from '../lib/db/client';
import { signUp, ACCESS_TOKEN_COOKIE, REFRESH_TOKEN_COOKIE, authCookieOptions } from '../lib/auth';
import { validatePassword, PASSWORD_MIN_CHARS, PASSWORD_MAX_BYTES } from '../lib/password';

const supabaseEnv = resolveSupabaseEnv(Astro.locals);
const session = Astro.locals.session;

// Already signed in? Nothing more to do here.
if (session) {
  return Astro.redirect('/', 302);
}

let error: string | null = null;
let checkEmail = false;
let emailInUse = false;
let submittedEmail = '';
let submittedName = '';

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const email = String(form.get('email') ?? '').trim();
  const password = String(form.get('password') ?? '');
  const confirmPassword = String(form.get('confirm_password') ?? '');
  // Control characters stripped and length capped — this value is stored in
  // the profile and shown on the site, so it should never be unbounded.
  // eslint-disable-next-line no-control-regex
  const displayName = String(form.get('display_name') ?? '').replace(/[\u0000-\u001f\u007f]/g, '').trim().slice(0, 60);
  // Honeypot: a hidden field real people never see or fill in. Bots that
  // auto-fill every input trip it; they get the same "check your email"
  // screen as everyone else, but no account is created.
  const honeypot = String(form.get('website') ?? '').trim();
  submittedEmail = email.slice(0, 254);
  submittedName = displayName;
  const passwordProblem = validatePassword(password);

  if (honeypot) {
    checkEmail = true;
  } else if (!email || !password) {
    error = 'Enter an email and a password.';
  } else if (email.length > 254) {
    error = 'That email address is too long.';
  } else if (passwordProblem) {
    error = passwordProblem;
  } else if (password !== confirmPassword) {
    error = "Passwords don't match.";
  } else {
    try {
      const result = await signUp(
        supabaseEnv,
        email,
        password,
        displayName || undefined,
        `${Astro.url.origin}/login`
      );
      if (result.kind === 'session') {
        // No email confirmation required — sign them in immediately, same
        // cookies as the admin login flow.
        const cookieOptions = authCookieOptions(Astro.url);
        Astro.cookies.set(ACCESS_TOKEN_COOKIE, result.session.accessToken, { ...cookieOptions, maxAge: 60 * 60 });
        Astro.cookies.set(REFRESH_TOKEN_COOKIE, result.session.refreshToken, {
          ...cookieOptions,
          maxAge: 60 * 60 * 24 * 30,
        });
        // The "user added" activity row is written by the handle_new_user() trigger (0088), which also covers
        // the email-confirmation path this page can't reach.
        return Astro.redirect('/', 302);
      }
      if (result.kind === 'email-in-use') {
        emailInUse = true;
      } else {
        checkEmail = true;
      }
    } catch (err) {
      console.error('Sign-up failed:', err);
      error = "Sign-up didn't go through. Check your details and try again.";
    }
  }
}
---

<Layout title="Sign Up">
  <section class="mx-auto flex max-w-sm flex-col px-6 pb-24 pt-8">
    <h1 class="reveal font-display text-lg sm:text-4xl">Sign Up</h1>
    <p class="reveal mt-2 text-sm text-white/60" style="transition-delay: 60ms">
      Create an account with your email and a password.
    </p>

    {error && (
      <p class="reveal mt-6 break-words rounded-lg border border-brand-pink/30 bg-brand-pink/10 p-4 text-sm text-white/80">{error}</p>
    )}

    {emailInUse && (
      <div role="alert" class="reveal mt-6 flex gap-3 rounded-lg border border-brand-pink/30 bg-brand-pink/10 p-4 text-sm text-white/80" data-testid="signup-email-in-use">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="mt-0.5 h-4 w-4 shrink-0 text-brand-pink" aria-hidden="true">
          <circle cx="12" cy="12" r="10" />
          <line x1="12" y1="8" x2="12" y2="12" />
          <line x1="12" y1="16" x2="12.01" y2="16" />
        </svg>
        <div>
          <p>An account with this email already exists.</p>
          <p class="mt-2">
            <a href="/login" class="text-brand-primary hover:underline" data-testid="signup-email-in-use-login">Log in</a>
            <span class="text-white/40" aria-hidden="true"> · </span>
            <a href="/forgot-password" class="text-brand-primary hover:underline" data-testid="signup-email-in-use-forgot">Forgot password?</a>
          </p>
        </div>
      </div>
    )}

    {checkEmail && (
      <p class="reveal mt-6 rounded-lg border border-brand-primary/30 bg-brand-primary/10 p-4 text-sm text-white/80" data-signup-done>
        Check your email to confirm your account.
      </p>
    )}

    {!checkEmail && (
      <form method="POST" data-astro-reload class="reveal mt-8 flex flex-col gap-4" style="transition-delay: 120ms">
        <div aria-hidden="true" style="position:absolute;left:-10000px;top:auto;width:1px;height:1px;overflow:hidden">
          <label>Website <input type="text" name="website" tabindex="-1" autocomplete="off" /></label>
        </div>
        <label class="flex flex-col gap-1.5 text-sm">
          <span class="text-white/70">Display name</span>
          <input
            type="text"
            name="display_name"
            maxlength="60"
            autocomplete="name"
            value={submittedName}
            class="rounded-md border border-white/15 bg-white/5 px-3 py-2 text-white outline-none focus:border-brand-primary"
          />
        </label>
        <label class="flex flex-col gap-1.5 text-sm">
          <span class="text-white/70">Email</span>
          <input
            type="email"
            name="email"
            required
            maxlength="254"
            autocomplete="email"
            value={submittedEmail}
            class="rounded-md border border-white/15 bg-white/5 px-3 py-2 text-white outline-none focus:border-brand-primary"
          />
        </label>
        <label class="flex flex-col gap-1.5 text-sm">
          <span class="text-white/70">Password</span>
          <input
            type="password"
            name="password"
            required
            minlength={PASSWORD_MIN_CHARS} maxlength={PASSWORD_MAX_BYTES}
            autocomplete="new-password"
            class="rounded-md border border-white/15 bg-white/5 px-3 py-2 text-white outline-none focus:border-brand-primary"
          />
        </label>
        <label class="flex flex-col gap-1.5 text-sm">
          <span class="text-white/70">Confirm password</span>
          <input
            type="password"
            name="confirm_password"
            required
            minlength={PASSWORD_MIN_CHARS} maxlength={PASSWORD_MAX_BYTES}
            autocomplete="new-password"
            class="rounded-md border border-white/15 bg-white/5 px-3 py-2 text-white outline-none focus:border-brand-primary"
          />
        </label>
        <button
          type="submit"
          class="btn btn-primary btn-lg mt-2"
        >
          Sign Up
        </button>
        <p class="text-center text-xs text-white/40">
          Already have an account? <a href="/login" class="text-brand-primary hover:underline">Sign in</a>
        </p>
      </form>
    )}
  </section>
</Layout>
