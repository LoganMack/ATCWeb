---
export const prerender = false;

import Layout from '../layouts/Layout.astro';
import { resolveSupabaseEnv } from '../lib/supabase';
import { requestPasswordReset } from '../lib/auth';

const supabaseEnv = resolveSupabaseEnv(Astro.locals);

let error: string | null = null;
let sent = false;
let submittedEmail = '';

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const email = String(form.get('email') ?? '').trim();
  submittedEmail = email;

  if (!email) {
    error = 'Enter your email.';
  } else {
    try {
      // Reset link lands back on this same origin's /reset-password — see
      // requestPasswordReset's own doc comment for why this has to be
      // passed explicitly (and why an admin also has to add this origin to
      // the project's Redirect URLs allowlist in the Supabase dashboard for
      // the link to actually work rather than pointing at localhost).
      await requestPasswordReset(supabaseEnv, email, `${Astro.url.origin}/reset-password`);
    } catch (err) {
      console.error('Failed to request password reset:', err);
      error = err instanceof Error ? err.message : 'Something went wrong — try again.';
    }
    // Shown regardless of whether the email actually exists — see
    // requestPasswordReset's doc comment on why that's deliberate.
    if (!error) sent = true;
  }
}
---

<Layout title="Forgot Password">
  <section class="mx-auto flex max-w-sm flex-col px-6 pb-24 pt-28 sm:pt-36">
    <h1 class="reveal font-display text-4xl">Forgot Password</h1>
    <p class="reveal mt-2 text-sm text-white/60" style="transition-delay: 60ms">
      Enter your account's email and we'll send you a link to set a new password.
    </p>

    {error && (
      <p class="reveal mt-6 break-words rounded-lg border border-brand-pink/30 bg-brand-pink/10 p-4 text-sm text-white/80">{error}</p>
    )}

    {sent && (
      <p class="reveal mt-6 rounded-lg border border-brand-primary/30 bg-brand-primary/10 p-4 text-sm text-white/80">
        If an account exists for <strong>{submittedEmail}</strong>, a password reset link is on its way. Check spam if
        it doesn't show up in a few minutes.
      </p>
    )}

    {!sent && (
      <form method="POST" data-astro-reload class="reveal mt-8 flex flex-col gap-4" style="transition-delay: 120ms">
        <label class="flex flex-col gap-1.5 text-sm">
          <span class="text-white/70">Email</span>
          <input
            type="email"
            name="email"
            required
            autocomplete="email"
            value={submittedEmail}
            class="rounded-md border border-white/15 bg-white/5 px-3 py-2 text-white outline-none focus:border-brand-primary"
          />
        </label>
        <button
          type="submit"
          class="mt-2 rounded-lg bg-brand-primary px-6 py-3 font-semibold transition hover:brightness-110"
        >
          Send Reset Link
        </button>
        <p class="text-center text-xs text-white/40">
          <a href="/login" class="text-brand-primary hover:underline">Back to sign in</a>
        </p>
      </form>
    )}
  </section>
</Layout>
