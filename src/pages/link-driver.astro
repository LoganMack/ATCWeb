---
export const prerender = false;

// Link Driver (U2 driver-linking; broadcaster-staff-roles C6): a signed-in account without a driver picks one
// from the unlinked roster, once, becomes the Broadcaster, or asks for a new driver entry through the New Driver
// Sign-Up popup. The database decides every outcome (src/lib/driverAccount.ts); this page shapes input, posts,
// and explains the result. Signed-in only, so it is never edge-cached.
import Layout from '../layouts/Layout.astro';
import { resolveSupabaseEnv } from '../lib/db/client';
import { BROADCASTER_PATH, LINK_DRIVER_PATH } from '../lib/auth';
import { COUNTRIES } from '../lib/countries';
import { safeJson } from '../lib/security';
import {
  DriverAccountError,
  claimBroadcaster,
  errorCodeOf,
  linkErrorMessage,
  linkMyDriver,
  loadLinkPage,
  parseDriverId,
  requestErrorMessage,
  shapeRequestInput,
  submitDriverSignup,
  LOAD_ERROR_MESSAGE,
  type RequestField,
  type RequestFormValues,
} from '../lib/driverAccount';

const session = Astro.locals.session;
if (!session) return Astro.redirect(`/login?next=${LINK_DRIVER_PATH}`, 302);
if (session.profile?.driver_id) {
  return Astro.redirect(`/drivers/${encodeURIComponent(session.profile.driver_id)}`, 302);
}
if (session.profile?.is_broadcaster) return Astro.redirect(BROADCASTER_PATH, 302);

const supabaseEnv = resolveSupabaseEnv(Astro.locals);
const accessToken = session.accessToken;

let linkError: string | null = null;
let slotJustTaken = false;
let requestError: { field: RequestField | null; message: string } | null = null;
let requestValues: RequestFormValues = {
  name: '',
  car_number: '',
  irating: '',
  iracing_cust_id: '',
  nationality_1: '',
  nationality_2: '',
};

// Success redirects (so a refresh cannot post again); a failure re-renders with the message and, for a
// request, the values typed, which never go into a URL.
if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const intent = String(form.get('intent') ?? '');

  if (intent === 'link-driver') {
    const driverId = parseDriverId(form.get('driver_id'));
    // Display only, for the "just linked to another account" message.
    const driverName = String(form.get('driver_name') ?? '').slice(0, 80);
    if (!driverId) {
      linkError = linkErrorMessage('NOT_FOUND');
    } else {
      try {
        const linkedId = await linkMyDriver(supabaseEnv, accessToken, driverId);
        return Astro.redirect(`/drivers/${encodeURIComponent(linkedId)}`, 302);
      } catch (err) {
        const code = errorCodeOf(err);
        // The next request reads the profile again, so /my-profile finds the link.
        if (code === 'ALREADY_LINKED') return Astro.redirect('/my-profile', 302);
        if (code === 'NOT_AUTHENTICATED') return Astro.redirect(`/login?next=${LINK_DRIVER_PATH}`, 302);
        linkError = linkErrorMessage(code, driverName);
      }
    }
  } else if (intent === 'claim-broadcaster') {
    try {
      await claimBroadcaster(supabaseEnv, accessToken);
      return Astro.redirect(BROADCASTER_PATH, 302);
    } catch (err) {
      const code = errorCodeOf(err);
      if (code === 'ALREADY_LINKED') return Astro.redirect('/my-profile', 302);
      if (code === 'NOT_AUTHENTICATED') return Astro.redirect(`/login?next=${LINK_DRIVER_PATH}`, 302);
      slotJustTaken = code === 'BROADCASTER_TAKEN';
      linkError = linkErrorMessage(code);
    }
  } else if (intent === 'request-driver') {
    const shaped = shapeRequestInput({
      name: form.get('name'),
      car_number: form.get('car_number'),
      irating: form.get('irating'),
      iracing_cust_id: form.get('iracing_cust_id'),
      nationality_1: form.get('nationality_1'),
      nationality_2: form.get('nationality_2'),
    });
    requestValues = shaped.values;
    if (!shaped.ok) {
      requestError = { field: shaped.field, message: shaped.message };
    } else {
      try {
        await submitDriverSignup(supabaseEnv, accessToken, shaped.input);
        return Astro.redirect(`${LINK_DRIVER_PATH}?status=request-sent`, 302);
      } catch (err) {
        const code = errorCodeOf(err);
        if (code === 'ALREADY_LINKED') return Astro.redirect('/my-profile', 302);
        if (code === 'NOT_AUTHENTICATED') return Astro.redirect(`/login?next=${LINK_DRIVER_PATH}`, 302);
        requestError = requestErrorMessage(
          err instanceof DriverAccountError ? err : { code, field: null },
          shaped.input.carNumber,
        );
      }
    }
  }
}

const { state, drivers, takenNumbers, loadError } = await loadLinkPage(supabaseEnv, accessToken);
// Linked or made the Broadcaster since the session was read (another tab, or an admin).
if (state?.linked) return Astro.redirect('/my-profile', 302);
if (state?.broadcaster) return Astro.redirect(BROADCASTER_PATH, 302);

// Unknown (a failed state read) shows the slot free; the claim refuses anyway.
const slotTaken = state?.broadcasterSlotTaken === true || slotJustTaken;
const pendingRequest = state?.request?.status === 'pending' ? state.request : null;
const rejectedRequest = state?.request?.status === 'rejected' ? state.request : null;
const requestSent = Astro.url.searchParams.get('status') === 'request-sent' && pendingRequest !== null;
const fieldError = (field: RequestField) => (requestError?.field === field ? requestError.message : null);

const fieldClass =
  'h-9 rounded-md border border-white/15 bg-white/5 px-3 text-sm text-white outline-none focus:border-brand-primary';
const labelClass = 'flex flex-col gap-1 text-[11px] text-white/50';
const WARNING = 'This is a permanent action. Once linked, you must contact an admin to change linked drivers.';
---

<Layout title="Link Driver">
  <section class="mx-auto flex max-w-2xl flex-col px-6 pb-24 pt-8" data-link-driver>
    <h1 class="reveal font-display text-3xl sm:text-4xl">Link Driver</h1>
    <p class="reveal mt-2 text-sm text-white/60" style="transition-delay: 40ms">
      Link an existing driver to this account, or sign-up as a new driver.
    </p>

    {linkError && (
      <p
        class="mt-6 break-words rounded-lg border border-brand-pink/30 bg-brand-pink/10 p-4 text-sm text-white/80"
        role="alert"
        data-testid="link-driver-error"
      >
        {linkError}
      </p>
    )}

    {requestSent && (
      <p class="mt-6 rounded-lg border border-brand-primary/30 bg-brand-primary/10 p-4 text-sm text-white/80" role="status">
        Request sent.
      </p>
    )}

    {pendingRequest && (
      <div
        class="mt-6 flex gap-3 rounded-lg border border-brand-primary/30 bg-brand-primary/10 p-4 text-sm text-white/80"
        role="status"
        data-testid="link-driver-pending-banner"
      >
        <span aria-hidden="true" class="font-bold text-brand-primary">ⓘ</span>
        <p>
          Your request for “{pendingRequest.name}”{pendingRequest.carNumber !== null && ` (#${pendingRequest.carNumber})`} is
          waiting for an admin, so New Driver Sign-Up is closed for now. Linking an existing driver below cancels it.
        </p>
      </div>
    )}

    {rejectedRequest && (
      <div
        class="mt-6 flex gap-3 rounded-lg border border-brand-pink/30 bg-brand-pink/10 p-4 text-sm text-white/80"
        role="status"
        data-testid="link-driver-rejected-banner"
      >
        <span aria-hidden="true" class="font-bold text-brand-pink">ⓘ</span>
        <p>Your request was rejected: {rejectedRequest.reason ?? 'no reason given'}. You can send a new request.</p>
      </div>
    )}

    {loadError ? (
      <p
        class="mt-6 rounded-lg border border-brand-pink/30 bg-brand-pink/10 p-4 text-sm text-white/80"
        role="alert"
        data-testid="link-driver-load-error"
      >
        {LOAD_ERROR_MESSAGE}
      </p>
    ) : (
      <>
        <div class="reveal mt-8 rounded-xl border border-white/10 bg-brand-ink p-4" style="transition-delay: 60ms">
          <div class="flex flex-col gap-3 sm:flex-row sm:items-center">
            <input
              type="search"
              autocomplete="off"
              placeholder="Search names or numbers..."
              aria-label="Search drivers"
              data-link-driver-search
              data-testid="link-driver-search"
              class="search-input h-9 rounded-md border border-white/15 bg-transparent px-3 text-sm text-white outline-none hover:bg-white/5 focus:border-brand-primary focus:bg-white/5"
            />
            {!pendingRequest && (
              <button
                type="button"
                class="btn btn-primary sm:ml-auto"
                data-signup-open
                aria-haspopup="dialog"
                aria-controls="link-driver-signup-dialog"
                data-testid="link-driver-signup-open"
              >
                New Driver Sign-Up
              </button>
            )}
          </div>
        </div>

        <ul
          class="mt-4 divide-y divide-white/10 rounded-xl border border-white/10"
          data-link-driver-list
          data-testid="link-driver-list"
        >
          <li
            class="flex items-center justify-between gap-4 px-4 py-3 text-sm"
            data-link-driver-row
            data-always-shown
            data-testid="link-driver-broadcaster-row"
          >
            <span class="flex flex-col">
              <span class="font-semibold text-white">Broadcaster</span>
              <span class="text-xs text-white/50">View the site as a linked driver, without a driver profile</span>
            </span>
            {slotTaken ? (
              <button type="button" class="btn btn-neutral btn-sm ml-auto" disabled data-testid="link-driver-broadcaster-taken">
                Taken
              </button>
            ) : (
              <button
                type="button"
                class="btn btn-primary btn-sm ml-auto"
                data-link-driver-open
                data-broadcaster
                data-testid="link-driver-broadcaster-link"
                aria-label="Become the Broadcaster"
              >
                Link
              </button>
            )}
          </li>
          {drivers.map((d) => (
            <li
              class="flex items-center justify-between gap-4 px-4 py-3 text-sm"
              data-link-driver-row
              data-name={d.name}
              data-number={d.car_number ?? ''}
              data-testid="link-driver-row"
            >
              <span class="font-semibold text-white">{d.name}</span>
              <span class="ml-auto tabular-nums text-white/60">{d.car_number !== null ? `#${d.car_number}` : '—'}</span>
              <button
                type="button"
                class="btn btn-primary btn-sm"
                data-link-driver-open
                data-driver-id={d.id}
                data-driver-name={d.name}
                data-driver-number={d.car_number ?? ''}
                data-testid="link-driver-row-link"
                aria-label={`Link ${d.name}`}
              >
                Link
              </button>
            </li>
          ))}
        </ul>
        {drivers.length === 0 && (
          <p class="mt-4 text-sm text-white/50" data-testid="link-driver-empty">Every driver is already linked.</p>
        )}
        <p class="mt-4 text-sm text-white/50" data-link-driver-no-match hidden data-testid="link-driver-no-match">
          No driver matches “<span data-link-driver-query></span>”.
        </p>
      </>
    )}

    <dialog
      data-link-driver-dialog
      aria-labelledby="link-driver-dialog-title"
      class="w-full max-w-md rounded-xl border border-white/10 bg-brand-ink p-0 text-white backdrop:bg-black/60"
      data-testid="link-driver-dialog"
    >
      <form method="POST" data-astro-reload class="flex flex-col gap-4 p-5">
        <input type="hidden" name="intent" value="link-driver" />
        <input type="hidden" name="driver_id" value="" />
        <input type="hidden" name="driver_name" value="" />
        <div class="flex items-start justify-between gap-3">
          <h2 id="link-driver-dialog-title" class="font-display text-2xl" data-link-driver-dialog-title>
            Link to <span data-link-driver-dialog-name></span>?
          </h2>
          <button type="button" class="text-white/40 hover:text-white" data-link-driver-cancel aria-label="Close">✕</button>
        </div>
        <p class="text-sm text-white/70">{WARNING}</p>
        <div class="flex justify-end gap-2">
          <button type="button" class="btn btn-neutral" data-link-driver-cancel data-testid="link-driver-dialog-cancel">
            Cancel
          </button>
          <button type="submit" class="btn btn-primary" data-link-driver-confirm data-testid="link-driver-dialog-confirm">
            Link Driver
          </button>
        </div>
      </form>
    </dialog>

    {!pendingRequest && (
      <dialog
        id="link-driver-signup-dialog"
        data-signup-dialog
        data-open-on-load={requestError ? 'true' : undefined}
        aria-labelledby="link-driver-signup-title"
        class="w-full max-w-xl rounded-xl border border-white/10 bg-brand-ink p-0 text-white backdrop:bg-black/60"
        data-testid="link-driver-signup-dialog"
      >
        <form method="POST" data-astro-reload class="flex flex-col gap-4 p-5" data-testid="link-driver-request-form">
          <input type="hidden" name="intent" value="request-driver" />
          <div class="flex items-center justify-between">
            <h2 id="link-driver-signup-title" class="font-display text-2xl">New Driver Sign-Up</h2>
            <button type="button" class="text-white/40 hover:text-white" data-signup-close aria-label="Close">✕</button>
          </div>

          {requestError && requestError.field === null && (
            <p
              class="rounded-lg border border-brand-pink/30 bg-brand-pink/10 p-3 text-sm text-white/80"
              role="alert"
              data-testid="link-driver-request-error"
            >
              {requestError.message}
            </p>
          )}

          <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
            <label class={labelClass}>
              Full Name
              <input
                type="text"
                name="name"
                required
                maxlength="80"
                autocomplete="name"
                value={requestValues.name}
                aria-invalid={fieldError('name') ? 'true' : undefined}
                aria-describedby={fieldError('name') ? 'link-driver-name-error' : undefined}
                class={fieldClass}
                data-testid="link-driver-request-name"
              />
              {fieldError('name') && <span id="link-driver-name-error" class="text-xs text-brand-pink">{fieldError('name')}</span>}
            </label>
            <label class={labelClass}>
              Car Number
              <input
                type="text"
                name="car_number"
                required
                inputmode="numeric"
                pattern="[0-9]{1,3}"
                maxlength="3"
                value={requestValues.car_number}
                aria-invalid={fieldError('car_number') ? 'true' : undefined}
                aria-describedby="link-driver-number-status"
                class={fieldClass}
                data-signup-number
                data-testid="link-driver-request-number"
              />
              <span id="link-driver-number-status" aria-live="polite" class="min-h-4 text-xs" data-signup-number-status>
                {fieldError('car_number') && <span class="text-brand-pink">{fieldError('car_number')}</span>}
              </span>
            </label>
            <label class={labelClass}>
              iRating
              <input
                type="text"
                name="irating"
                required
                inputmode="numeric"
                pattern="[0-9]{1,5}"
                maxlength="5"
                value={requestValues.irating}
                aria-invalid={fieldError('irating') ? 'true' : undefined}
                aria-describedby={fieldError('irating') ? 'link-driver-irating-error' : undefined}
                class={fieldClass}
                data-testid="link-driver-request-irating"
              />
              {fieldError('irating') && <span id="link-driver-irating-error" class="text-xs text-brand-pink">{fieldError('irating')}</span>}
            </label>
            <label class={labelClass}>
              iRacing ID
              <input
                type="text"
                name="iracing_cust_id"
                required
                inputmode="numeric"
                pattern="[0-9]{1,16}"
                maxlength="16"
                value={requestValues.iracing_cust_id}
                aria-invalid={fieldError('iracing_cust_id') ? 'true' : undefined}
                aria-describedby={fieldError('iracing_cust_id') ? 'link-driver-iracing-error' : undefined}
                class={fieldClass}
                data-testid="link-driver-request-iracing"
              />
              {fieldError('iracing_cust_id') && (
                <span id="link-driver-iracing-error" class="text-xs text-brand-pink">{fieldError('iracing_cust_id')}</span>
              )}
            </label>
            {(['nationality_1', 'nationality_2'] as const).map((field, i) => (
              <label class={labelClass}>
                Nationality {i + 1}
                <select
                  name={field}
                  aria-invalid={fieldError(field) ? 'true' : undefined}
                  aria-describedby={fieldError(field) ? `link-driver-${field}-error` : undefined}
                  class={fieldClass}
                  data-testid={`link-driver-request-${field}`}
                >
                  <option value="" class="bg-brand-ink text-white">None</option>
                  {COUNTRIES.map((c) => (
                    <option value={c.code} selected={requestValues[field] === c.code} class="bg-brand-ink text-white">{c.name}</option>
                  ))}
                </select>
                {fieldError(field) && <span id={`link-driver-${field}-error`} class="text-xs text-brand-pink">{fieldError(field)}</span>}
              </label>
            ))}
          </div>

          <div class="flex justify-end gap-2">
            <button type="button" class="btn btn-neutral" data-signup-close data-testid="link-driver-request-cancel">Cancel</button>
            <button type="submit" class="btn btn-primary" data-testid="link-driver-request-submit">Send Request</button>
          </div>
        </form>
        <script type="application/json" data-taken-numbers set:html={safeJson(takenNumbers)} />
      </dialog>
    )}
  </section>
</Layout>

<script>
  import '../scripts/linkDriver';
</script>
