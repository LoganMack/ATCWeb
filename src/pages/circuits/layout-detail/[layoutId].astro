---
export const prerender = false;
import LoadError from '../../../components/LoadError.astro';
import { markUncacheable } from '../../../lib/security';

// A layout's expanded-row content on /circuits, fetched once on first expand
// (src/scripts/circuitLayoutDetail.ts) and dropped into the row. The Event Briefing's history sections,
// without Schedule and the curated record (already in the row); these per-layout queries are why it loads on
// demand.
import { resolveSupabaseEnv } from '../../../lib/db/client';
import {
  getCircuitById,
  getCircuitLayoutById,
  getCircuits,
  getAllCircuitLayouts,
  getAllTrackGuides,
  formatDate,
  formatLapTime,
  displayDriverName,
} from '../../../lib/db/circuits';
import { getDriverClasses } from '../../../lib/db/lookups';
import { getCarLogos } from '../../../lib/db/assets';
import { getRaceLinksForSubsessions, type RaceLinks } from '../../../lib/db/rounds';
import {
  findRoundsForLayout,
  emptyLayoutHighlights,
  getLayoutClassHighlights,
  getLayoutExcludedRoundIds,
  layoutHighlightGroups,
  formatPastResultDate,
  withoutExcludedRounds,
  withoutExcludedRoundRows,
  type LayoutRoundSummary,
  type LayoutHighlights,
} from '../../../lib/results/layouts';
import { getAllRounds } from '../../../lib/results/rounds';
import { getRoundLayoutsForSubsessions, type ClassBestLap } from '../../../lib/results/layoutLaps';
import { classBestLapsFor, loadLeagueRecords } from '../../../lib/results/trackRecords';
import { driversSelect } from '../../../lib/results/rows';
import { getIncidentsForSubsessions, type IncidentRow } from '../../../lib/incidents';
import DriverLink from '../../../components/DriverLink.astro';
import IncidentHistory from '../../../components/IncidentHistory.astro';
import IncidentDetailsDialog from '../../../components/IncidentDetailsDialog.astro';
import { CATEGORY_LABELS } from '../../../lib/eventFormatting';
import { classTagFull } from '../../../lib/classColors';
import ClassBadge from '../../../components/ClassBadge.astro';

const layoutId = Astro.params.layoutId ?? '';

const layoutRow = layoutId ? await getCircuitLayoutById(resolveSupabaseEnv(Astro.locals), layoutId) : null;
if (!layoutRow) {
  Astro.response.status = 404;
}

let circuitName = 'this layout';
let classNameById = new Map<number, string>();
let historicalRounds: LayoutRoundSummary[] = [];
/** The past rounds without test and exhibition rounds (BR8.5); broadcasts and albums keep every round. */
let pastRounds: LayoutRoundSummary[] = [];
let highlights: LayoutHighlights = emptyLayoutHighlights();
let classBestLaps: Map<number, ClassBestLap> = new Map();
let guideCount = 0;
/** Posted incidents at this layout outside test and exhibition rounds, in the loader's order. */
let incidentRows: IncidentRow[] = [];
interface MediaEntry {
  round: LayoutRoundSummary;
  raceNumber: number;
  url: string;
}
let broadcastEntries: MediaEntry[] = [];
let photoAlbumEntries: MediaEntry[] = [];
let loadError: string | null = null;

if (layoutRow) {
  try {
    const supabaseEnv = resolveSupabaseEnv(Astro.locals);
    const [circuit, circuits, layouts, driverClasses, allRounds, drivers, carLogos, allGuides] = await Promise.all([
      getCircuitById(supabaseEnv, layoutRow.circuit_id),
      getCircuits(supabaseEnv),
      getAllCircuitLayouts(supabaseEnv),
      getDriverClasses(supabaseEnv),
      getAllRounds(supabaseEnv),
      driversSelect(supabaseEnv, { includeAi: true }),
      getCarLogos(supabaseEnv),
      getAllTrackGuides(supabaseEnv),
    ]);

    circuitName = circuit?.name ?? circuitName;
    classNameById = new Map(driverClasses.map((c) => [c.id, c.name]));
    guideCount = allGuides.filter((g) => g.layout_id === layoutRow!.id).length;

    const roundLayoutBySubsession = await getRoundLayoutsForSubsessions(
      supabaseEnv,
      allRounds.map((r) => r.subsession_id)
    );
    historicalRounds = findRoundsForLayout(allRounds, roundLayoutBySubsession, circuits, layouts, layoutRow.circuit_id, layoutRow.name);

    const ids = historicalRounds.map((r) => r.subsessionId);
    const [excludedIds, layoutHighlights, leagueRecords, rawIncidents, raceLinks] = await Promise.all([
      // Test and exhibition rounds (BR8.5); no catch, so a failed read shows the error state (BR8.6).
      getLayoutExcludedRoundIds(supabaseEnv, ids),
      // Every race's winner, built exactly as the Event Briefing builds it (BR8.4).
      getLayoutClassHighlights(supabaseEnv, historicalRounds, drivers, { allRaces: true }),
      // Class bests from the league's laps (W3, BR1.6); a failure only leaves them out.
      loadLeagueRecords(supabaseEnv).catch((err) => {
        console.error('Failed to load league track records for a layout detail; omitting class bests:', err);
        return null;
      }),
      getIncidentsForSubsessions(supabaseEnv, ids),
      getRaceLinksForSubsessions(supabaseEnv, ids),
    ]);
    pastRounds = withoutExcludedRoundRows(historicalRounds, excludedIds);
    highlights = withoutExcludedRounds(layoutHighlights, excludedIds);
    incidentRows = withoutExcludedRoundRows(rawIncidents, excludedIds);
    if (leagueRecords) {
      const classIds = driverClasses.filter((c) => c.name === 'Gamma' || c.name === 'Delta').map((c) => c.id);
      classBestLaps = classBestLapsFor(leagueRecords.league, `layout:${layoutRow.id}`, classIds, drivers, carLogos);
    }

    const roundBySubsession = new Map(historicalRounds.map((r) => [r.subsessionId, r]));
    const byRoundDesc = (a: MediaEntry, b: MediaEntry) => b.round.startTime.localeCompare(a.round.startTime);
    broadcastEntries = raceLinks
      .filter((l): l is RaceLinks & { broadcast_url: string } => l.broadcast_url !== null)
      .map((l): MediaEntry | null => {
        const round = roundBySubsession.get(l.subsession_id);
        return round ? { round, raceNumber: l.race_number, url: l.broadcast_url } : null;
      })
      .filter((x): x is MediaEntry => x !== null)
      .sort(byRoundDesc);
    photoAlbumEntries = raceLinks
      .filter((l): l is RaceLinks & { photo_album_url: string } => l.photo_album_url !== null)
      .map((l): MediaEntry | null => {
        const round = roundBySubsession.get(l.subsession_id);
        return round ? { round, raceNumber: l.race_number, url: l.photo_album_url } : null;
      })
      .filter((x): x is MediaEntry => x !== null)
      .sort(byRoundDesc);
  } catch (err) {
    console.error('Failed to load circuit layout detail:', err);
    loadError = err instanceof Error ? err.message : String(err);
  }
}

// The Overall group (classless winner and pole, BR3.9) first, then each class.
const highlightGroups = layoutHighlightGroups(
  highlights,
  [...classNameById.entries()].map(([id, name]) => ({ id, name })),
);

// Gamma/Delta only (Logan, as on the Event Briefing): Alpha's class best would mostly repeat the Record
// column.
const gammaClassId = [...classNameById.entries()].find(([, name]) => name === 'Gamma')?.[0] ?? null;
const deltaClassId = [...classNameById.entries()].find(([, name]) => name === 'Delta')?.[0] ?? null;
const gammaBestLap = gammaClassId !== null ? (classBestLaps.get(gammaClassId) ?? null) : null;
const deltaBestLap = deltaClassId !== null ? (classBestLaps.get(deltaClassId) ?? null) : null;

Astro.response.headers.set('Cache-Control', 'public, s-maxage=120, stale-while-revalidate=600');
if (loadError) markUncacheable(Astro);
---

{!layoutRow && <p class="text-white/40">Layout not found.</p>}

{layoutRow && loadError && <LoadError class="mt-0" />}

{layoutRow && !loadError && (
  <div class="flex flex-col gap-6">
    {(guideCount > 0 || gammaBestLap || deltaBestLap) && (
      <div>
        <p class="text-[11px] font-medium uppercase tracking-wide text-white/40">Gamma &amp; Delta Best Laps</p>
        {gammaBestLap || deltaBestLap ? (
          <div class="mt-1.5 space-y-1.5">
            {gammaBestLap && gammaClassId !== null && (
              <p class="flex flex-wrap items-center gap-2">
                <ClassBadge className={classNameById.get(gammaClassId)} />
                <span class="font-semibold">{formatLapTime(gammaBestLap.seconds)}</span>
                <span class="text-white/70"><DriverLink id={gammaBestLap.driver.id} hidden={gammaBestLap.driver.is_hidden}>{displayDriverName(gammaBestLap.driver.name)}</DriverLink></span>
                {gammaBestLap.carLogoUrl && (
                  <img src={gammaBestLap.carLogoUrl} alt={gammaBestLap.carName ?? ''} title={gammaBestLap.carName ?? ''} class="h-5 w-5 flex-none rounded object-contain" />
                )}
                <span class="text-white/40">({formatDate(gammaBestLap.date)})</span>
              </p>
            )}
            {deltaBestLap && deltaClassId !== null && (
              <p class="flex flex-wrap items-center gap-2">
                <ClassBadge className={classNameById.get(deltaClassId)} />
                <span class="font-semibold">{formatLapTime(deltaBestLap.seconds)}</span>
                <span class="text-white/70"><DriverLink id={deltaBestLap.driver.id} hidden={deltaBestLap.driver.is_hidden}>{displayDriverName(deltaBestLap.driver.name)}</DriverLink></span>
                {deltaBestLap.carLogoUrl && (
                  <img src={deltaBestLap.carLogoUrl} alt={deltaBestLap.carName ?? ''} title={deltaBestLap.carName ?? ''} class="h-5 w-5 flex-none rounded object-contain" />
                )}
                <span class="text-white/40">({formatDate(deltaBestLap.date)})</span>
              </p>
            )}
          </div>
        ) : (
          <p class="mt-1.5 text-white/40">No class best laps on file yet.</p>
        )}
        {guideCount > 0 && (
          <a href={`/media?tab=videos&filter=trackguide&layout=${encodeURIComponent(layoutRow.id)}`} class="mt-1.5 inline-block font-semibold text-brand-primary hover:underline">
            {guideCount > 1 ? 'Watch Track Guides →' : 'Watch Track Guide →'}
          </a>
        )}
      </div>
    )}

    <div>
      <p class="text-[11px] font-medium uppercase tracking-wide text-white/40">Past Winners &amp; Pole-Sitters</p>
      {highlightGroups.length === 0 ? (
        <p class="mt-1.5 text-white/40">No history at {circuitName} yet.</p>
      ) : (
        <div class="mt-1.5 grid gap-3 sm:grid-cols-2 xl:grid-cols-4">
          {highlightGroups.map(({ key, label, winners, poles }) => {
            return (
              <div class="rounded-lg border border-white/10 p-3" data-highlight-group={key}>
                <span class={classTagFull(label)}>
                  {label}
                </span>
                <div class="mt-2">
                  <p class="text-[10px] font-medium uppercase tracking-wide text-white/40">Winners</p>
                  <ul class="mt-1 space-y-1">
                    {winners.map((w) => (
                      <li class="flex items-center justify-between gap-2">
                        <DriverLink id={w.driver.id} hidden={w.driver.is_hidden}>{displayDriverName(w.driver.name)}</DriverLink>
                        {/* The name goes to the driver's profile, so the race result link sits on the date. */}
                        <a
                          href={`/results/${w.round.subsessionId}${w.raceNumber > 1 ? `?session=race-${w.raceNumber}` : ''}`}
                          class="text-white/40 hover:text-brand-primary"
                        >{formatPastResultDate(w.round.startTime)}</a>
                      </li>
                    ))}
                  </ul>
                </div>
                <div class="mt-2">
                  <p class="text-[10px] font-medium uppercase tracking-wide text-white/40">Pole-Sitters</p>
                  <ul class="mt-1 space-y-1">
                    {poles.map((p) => (
                      <li class="flex items-center justify-between gap-2">
                        <DriverLink id={p.driver.id} hidden={p.driver.is_hidden}>{displayDriverName(p.driver.name)}</DriverLink>
                        <a href={`/results/${p.round.subsessionId}?category=qualifying`} class="text-white/40 hover:text-brand-primary">{formatPastResultDate(p.round.startTime)}</a>
                      </li>
                    ))}
                  </ul>
                </div>
              </div>
            );
          })}
        </div>
      )}
    </div>

    <details class="group">
      <summary class="flex cursor-pointer list-none items-center justify-between gap-2">
        <p class="text-[11px] font-medium uppercase tracking-wide text-white/40">Past Results</p>
        <span class="text-white/30 transition group-open:rotate-180">▾</span>
      </summary>
      <div class="mt-1.5">
        {pastRounds.length === 0 ? (
          <p class="text-white/40">No past rounds at this layout yet.</p>
        ) : (
          <div class="overflow-hidden rounded-lg border border-white/10">
            {pastRounds.map((r, i) => (
              <a href={`/results/${r.subsessionId}`} class={`flex items-center justify-between gap-3 p-2.5 transition hover:bg-white/5 ${i > 0 ? 'border-t border-white/10' : ''}`}>
                <span class="font-semibold">{r.seasonLabel ?? CATEGORY_LABELS.championship}</span>
                <span class="text-white/50">{formatPastResultDate(r.startTime)}</span>
              </a>
            ))}
          </div>
        )}
      </div>
    </details>

    <details class="group">
      <summary class="flex cursor-pointer list-none items-center justify-between gap-2">
        <p class="text-[11px] font-medium uppercase tracking-wide text-white/40">Past Incidents</p>
        <span class="text-white/30 transition group-open:rotate-180">▾</span>
      </summary>
      {/* The profile's table; each row opens this row's own popup (several layout rows may be open). */}
      <div class="mt-1.5" data-incident-details-scope>
        <IncidentHistory rows={incidentRows} details />
        {incidentRows.length > 0 && (
          <IncidentDetailsDialog rows={incidentRows} titleId={`incident-details-title-${layoutRow.id}`} />
        )}
      </div>
    </details>

    <details class="group">
      <summary class="flex cursor-pointer list-none items-center justify-between gap-2">
        <p class="text-[11px] font-medium uppercase tracking-wide text-white/40">Past Broadcasts</p>
        <span class="text-white/30 transition group-open:rotate-180">▾</span>
      </summary>
      <div class="mt-1.5">
        {broadcastEntries.length === 0 ? (
          <p class="text-white/40">No broadcasts on file for this layout yet.</p>
        ) : (
          <div class="overflow-hidden rounded-lg border border-white/10">
            {broadcastEntries.map((b, i) => (
              <a href={b.url} target="_blank" rel="noopener noreferrer" class={`flex items-center justify-between gap-3 p-2.5 transition hover:bg-white/5 ${i > 0 ? 'border-t border-white/10' : ''}`}>
                <span class="font-semibold">
                  {b.round.seasonLabel ?? CATEGORY_LABELS.championship}
                  {b.raceNumber > 1 && ` — Race ${b.raceNumber}`}
                </span>
                <span class="text-white/50">{formatDate(b.round.startTime)}</span>
              </a>
            ))}
          </div>
        )}
      </div>
    </details>

    <details class="group">
      <summary class="flex cursor-pointer list-none items-center justify-between gap-2">
        <p class="text-[11px] font-medium uppercase tracking-wide text-white/40">Past Photo Albums</p>
        <span class="text-white/30 transition group-open:rotate-180">▾</span>
      </summary>
      <div class="mt-1.5">
        {photoAlbumEntries.length === 0 ? (
          <p class="text-white/40">No photo albums on file for this layout yet.</p>
        ) : (
          <div class="overflow-hidden rounded-lg border border-white/10">
            {photoAlbumEntries.map((p, i) => (
              <a href={p.url} target="_blank" rel="noopener noreferrer" class={`flex items-center justify-between gap-3 p-2.5 transition hover:bg-white/5 ${i > 0 ? 'border-t border-white/10' : ''}`}>
                <span class="font-semibold">
                  {p.round.seasonLabel ?? CATEGORY_LABELS.championship}
                  {p.raceNumber > 1 && ` — Race ${p.raceNumber}`}
                </span>
                <span class="text-white/50">{formatDate(p.round.startTime)}</span>
              </a>
            ))}
          </div>
        )}
      </div>
    </details>
  </div>
)}
