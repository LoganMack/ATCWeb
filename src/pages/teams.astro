---
export const prerender = false;

import Layout from '../layouts/Layout.astro';
import { getTeams, resolveSupabaseEnv } from '../lib/supabase';
import TeamLogo from '../components/TeamLogo.astro';

const supabaseEnv = resolveSupabaseEnv(Astro.locals);

let teams: Awaited<ReturnType<typeof getTeams>> = [];
let loadError = false;
try {
  teams = await getTeams(supabaseEnv);
} catch (err) {
  console.error('Failed to load teams:', err);
  loadError = true;
}

Astro.response.headers.set('Cache-Control', 'public, s-maxage=60, stale-while-revalidate=300');

const activeCount = teams.filter((t) => t.status === 'active').length;
const inactiveCount = teams.length - activeCount;

// Default order: active teams first, alphabetical within each group. Once
// loaded, clicking a column header (src/scripts/sortable-table.ts) re-sorts
// the whole table client-side.
const sortedTeams = [...teams].sort((a, b) => {
  if (a.status !== b.status) return a.status === 'active' ? -1 : 1;
  return a.name.localeCompare(b.name);
});
---

<Layout title="Teams" description="Active and past teams competing in Alpha Touring Challenge.">
  <section class="mx-auto max-w-6xl px-6 pb-24 pt-28 sm:pt-36">
    <h1 class="reveal font-display text-5xl">Teams</h1>
    <p class="reveal mt-3 text-white/60" style="transition-delay: 80ms">
      {activeCount} active, {inactiveCount} inactive.
    </p>

    {loadError && (
      <p class="mt-8 rounded-lg border border-brand-pink/30 bg-brand-pink/10 p-4 text-sm text-white/80">
        Couldn't load teams right now — check that PUBLIC_SUPABASE_URL and PUBLIC_SUPABASE_ANON_KEY are set.
      </p>
    )}

    {!loadError && (
      <div class="mt-8 overflow-x-auto rounded-xl border border-white/10">
        <table class="w-full border-collapse" data-sortable>
          <thead>
            <tr class="border-b border-white/10 text-left text-xs uppercase tracking-wide text-white/40">
              <th class="py-3 pl-4 pr-3 font-medium" data-sort-key="name">Team</th>
              <th class="py-3 pr-4 font-medium" data-sort-key="status">Status</th>
            </tr>
          </thead>
          <tbody>
            {sortedTeams.map((team) => (
              <tr class={`border-b border-white/5 text-sm transition hover:bg-white/[0.04] ${team.status === 'inactive' ? 'opacity-60' : ''}`}>
                <td class="py-2.5 pl-4 pr-3" data-col="name">
                  <div class="flex items-center gap-3">
                    <TeamLogo name={team.name} logoUrl={team.logo_url} size="h-8 w-8" grayscale={team.status === 'inactive'} />
                    <span class="font-semibold">{team.name}</span>
                  </div>
                </td>
                <td class="py-2.5 pr-4" data-col="status" data-sort-value={team.status}>
                  <span
                    class={`rounded-lg px-2.5 py-1 text-xs font-semibold uppercase tracking-wide ${
                      team.status === 'active' ? 'bg-brand-blue/15 text-brand-blue' : 'bg-white/10 text-white/50'
                    }`}
                  >
                    {team.status}
                  </span>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    )}
  </section>
</Layout>
