---
export const prerender = false;

import Layout from '../layouts/Layout.astro';
import {
  getTeams,
  getDrivers,
  getSeasons,
  getTeamRosterForSeason,
  getPageBanners,
  displayDriverName,
  resolveSupabaseEnv,
  getOrganizations,
  getAllOrganizationTeamSeasons,
} from '../lib/supabase';
import { driversSelect, type DriverBasic } from '../lib/results';
import { bannerUrlFor } from '../lib/pageBanners';
import TeamLogo from '../components/TeamLogo.astro';
import PageBanner from '../components/PageBanner.astro';

const supabaseEnv = resolveSupabaseEnv(Astro.locals);

let teams: Awaited<ReturnType<typeof getTeams>> = [];
let loadError = false;
try {
  teams = await getTeams(supabaseEnv);
} catch (err) {
  console.error('Failed to load teams:', err);
  loadError = true;
}

// Team -> organization name, for the small subtitle under a renamed team's
// name (see 0043_organizations.sql). organization_team_seasons links a team
// to an org per-season, but in practice a given team_id only ever
// represents one era of one organization (a rename creates a brand-new
// team_id, it doesn't re-link an existing one) — so any one link found for
// a team_id is enough here; there's no need to pick a specific season the
// way computeTeamCareerStats does. A team with no link at all (the common
// case — most teams have never been renamed) just has no entry.
let orgNameByTeamId = new Map<string, string>();
try {
  const [organizations, orgTeamSeasons] = await Promise.all([getOrganizations(supabaseEnv), getAllOrganizationTeamSeasons(supabaseEnv)]);
  const orgNameById = new Map(organizations.map((o) => [o.id, o.name]));
  for (const link of orgTeamSeasons) {
    if (orgNameByTeamId.has(link.team_id)) continue;
    const orgName = orgNameById.get(link.organization_id);
    if (orgName) orgNameByTeamId.set(link.team_id, orgName);
  }
} catch (err) {
  console.error('Failed to load organizations for team subtitles:', err);
}

// Current roster (drivers.team_id — the same "current team" every driver's
// profile shows, not the season-scoped team_rosters table) grouped by team
// NAME (getDrivers's embedded `teams` has no id, just name/color/logo — see
// its own doc comment), so the search box below can match on a team's
// current member names too.
let memberNamesByTeamName = new Map<string, string[]>();
try {
  const drivers = await getDrivers(supabaseEnv);
  for (const d of drivers) {
    if (!d.teams?.name) continue;
    if (!memberNamesByTeamName.has(d.teams.name)) memberNamesByTeamName.set(d.teams.name, []);
    memberNamesByTeamName.get(d.teams.name)!.push(displayDriverName(d.name));
  }
} catch (err) {
  console.error('Failed to load drivers for team search:', err);
}

// The 3-driver-columns roster, sourced from the season-scoped team_rosters
// table (rulebook: max 3 drivers/team) for whichever season is marked
// current — deliberately NOT the same drivers.team_id list used for search
// above, since a driver's "current team" field can drift out of sync with
// which season roster they were actually locked into (team_rosters is the
// source of truth the scoring engine itself uses for team eligibility).
let rosterByTeamId = new Map<string, DriverBasic[]>();
try {
  const [seasons, driversBasic] = await Promise.all([getSeasons(supabaseEnv), driversSelect(supabaseEnv)]);
  const currentSeason = seasons.find((s) => s.is_current) ?? seasons[0];
  if (currentSeason) {
    const rosterEntries = await getTeamRosterForSeason(supabaseEnv, currentSeason.id);
    const driverById = new Map(driversBasic.map((d) => [d.id, d]));
    for (const entry of rosterEntries) {
      const driver = driverById.get(entry.driver_id);
      if (!driver) continue;
      if (!rosterByTeamId.has(entry.team_id)) rosterByTeamId.set(entry.team_id, []);
      rosterByTeamId.get(entry.team_id)!.push(driver);
    }
    for (const list of rosterByTeamId.values()) {
      list.sort((a, b) => (a.car_number ?? Number.MAX_SAFE_INTEGER) - (b.car_number ?? Number.MAX_SAFE_INTEGER) || a.name.localeCompare(b.name));
    }
  }
} catch (err) {
  console.error('Failed to load current-season team rosters:', err);
}

// Banner fetch failing shouldn't take down the whole page — worst case, no
// banner shows, same as if none were ever configured.
let bannerUrl: string | null = null;
try {
  bannerUrl = bannerUrlFor(await getPageBanners(supabaseEnv), 'teams');
} catch (err) {
  console.error('Failed to load page banner:', err);
}

Astro.response.headers.set('Cache-Control', 'public, s-maxage=60, stale-while-revalidate=300');

// Default order: active teams first, alphabetical within each group. Once
// loaded, clicking a column header (src/scripts/sortable-table.ts) re-sorts
// the whole table client-side.
const sortedTeams = [...teams].sort((a, b) => {
  if (a.status !== b.status) return a.status === 'active' ? -1 : 1;
  return a.name.localeCompare(b.name);
});
---

<Layout title="Teams" description="Active and past teams competing in Alpha Touring Challenge.">
  <section class="relative mx-auto max-w-6xl overflow-hidden px-6 pb-24 pt-28 sm:pt-36">
    <PageBanner imageUrl={bannerUrl} />
    <h1 class="reveal font-display text-5xl">Teams</h1>

    {loadError && (
      <p class="mt-8 rounded-lg border border-brand-pink/30 bg-brand-pink/10 p-4 text-sm text-white/80">
        Couldn't load teams right now — check that PUBLIC_SUPABASE_URL and PUBLIC_SUPABASE_ANON_KEY are set.
      </p>
    )}

    {!loadError && (
      <div class="reveal mt-8 max-w-sm" style="transition-delay: 80ms">
        <input
          type="search"
          id="team-search"
          placeholder="Search teams or drivers…"
          class="w-full rounded-md border border-white/15 bg-white/5 px-3 py-2 text-white outline-none focus:border-brand-primary"
        />
      </div>
    )}

    {!loadError && (
      <div class="reveal mt-4 flex flex-wrap gap-2" style="transition-delay: 100ms" data-filter-group="status">
        {['Active', 'Inactive', 'All'].map((s) => (
          <button
            type="button"
            data-filter-value={s}
            class="rounded-lg px-4 py-1.5 text-sm font-semibold ring-1 ring-white/15 transition data-[active=true]:bg-white data-[active=true]:text-brand-ink"
            data-active={s === 'Active' ? 'true' : 'false'}
          >
            {s}
          </button>
        ))}
      </div>
    )}

    {!loadError && (
      <div class="mt-4 overflow-x-auto rounded-xl border border-white/10">
        <table class="w-full border-collapse" data-sortable>
          <thead>
            <tr class="border-b border-white/10 text-left text-xs uppercase tracking-wide text-white/40">
              <th class="py-3 pl-4 pr-3 font-medium" data-sort-key="name">Team</th>
              <th class="py-3 pr-4 font-medium" data-sort-key="status">Status</th>
              <th class="py-3 pr-4 font-medium">Driver 1</th>
              <th class="py-3 pr-4 font-medium">Driver 2</th>
              <th class="py-3 pr-4 font-medium">Driver 3</th>
            </tr>
          </thead>
          <tbody id="team-list">
            {sortedTeams.map((team) => {
              const members = memberNamesByTeamName.get(team.name) ?? [];
              const roster = rosterByTeamId.get(team.id) ?? [];
              const orgName = orgNameByTeamId.get(team.id);
              const searchText = [team.name, ...members, ...roster.map((d) => displayDriverName(d.name))].join(' ').toLowerCase();
              return (
                <tr
                  class={`border-b border-white/5 text-sm transition hover:bg-white/[0.04] ${team.status === 'inactive' ? 'opacity-60' : ''}`}
                  data-search={searchText}
                  data-status={team.status}
                >
                  <td class="py-2.5 pl-4 pr-3" data-col="name">
                    <div class="flex items-center gap-3">
                      <TeamLogo name={team.name} logoUrl={team.logo_url} size="h-8 w-8" grayscale={team.status === 'inactive'} />
                      <div class="flex flex-col justify-center">
                        <span class="font-semibold leading-tight">{team.name}</span>
                        {/* Always rendered (invisible when there's no org) so every row is exactly the same height regardless of whether that team has an organization — see this page's own org-name-by-team-id comment above. */}
                        <span class={`text-[11px] leading-tight text-white/40 ${orgName ? '' : 'invisible'}`}>{orgName ?? ' '}</span>
                      </div>
                    </div>
                  </td>
                  <td class="py-2.5 pr-4" data-col="status" data-sort-value={team.status}>
                    <span
                      class={`rounded-lg px-2.5 py-1 text-xs font-semibold uppercase tracking-wide ${
                        team.status === 'active' ? 'bg-brand-blue/15 text-brand-blue' : 'bg-white/10 text-white/50'
                      }`}
                    >
                      {team.status}
                    </span>
                  </td>
                  {[0, 1, 2].map((i) => (
                    <td class="py-2.5 pr-4 text-white/70">
                      {roster[i] ? (
                        <>
                          {displayDriverName(roster[i].name)}
                          {roster[i].car_number !== null && <span class="text-white/40"> #{roster[i].car_number}</span>}
                        </>
                      ) : (
                        <span class="text-white/25">—</span>
                      )}
                    </td>
                  ))}
                </tr>
              );
            })}
          </tbody>
        </table>
      </div>
    )}

    {!loadError && <p id="team-search-empty" class="mt-4 hidden text-white/60">No results.</p>}
  </section>

  <script>
    // Combines the search box (substring match on data-search, lowercased
    // server-side) with the Active/Inactive/All status filter — same
    // state-object + show/hide-via-inline-style approach roster.astro's
    // initRosterFilters uses for its class/status/search combo.
    function initTeamFilters() {
      const input = document.getElementById('team-search') as HTMLInputElement | null;
      const list = document.getElementById('team-list');
      const empty = document.getElementById('team-search-empty');
      if (!list) return;

      // Matches whichever button starts data-active="true" in the markup —
      // Active by default.
      const state: Record<string, string> = { status: 'Active', search: '' };

      function statusMatches(row: HTMLElement) {
        if (state.status === 'All') return true;
        return row.dataset.status === state.status.toLowerCase();
      }

      function searchMatches(row: HTMLElement) {
        if (!state.search) return true;
        return (row.dataset.search ?? '').includes(state.search);
      }

      function applyFilters() {
        const rows = list!.querySelectorAll<HTMLElement>('[data-search]');
        let visibleCount = 0;
        rows.forEach((row) => {
          const visible = statusMatches(row) && searchMatches(row);
          row.style.display = visible ? '' : 'none';
          if (visible) visibleCount += 1;
        });
        if (empty) empty.classList.toggle('hidden', visibleCount > 0);
      }

      document.querySelectorAll<HTMLElement>('[data-filter-group="status"]').forEach((group) => {
        group.querySelectorAll<HTMLButtonElement>('button').forEach((btn) => {
          btn.addEventListener('click', () => {
            state.status = btn.dataset.filterValue!;
            group.querySelectorAll<HTMLButtonElement>('button').forEach((b) => {
              b.dataset.active = String(b === btn);
            });
            applyFilters();
          });
        });
      });

      input?.addEventListener('input', () => {
        state.search = input.value.trim().toLowerCase();
        applyFilters();
      });

      // Apply the default filter state immediately — otherwise every row is
      // visible (no inline style yet) until the visitor clicks a button.
      applyFilters();
    }

    document.addEventListener('astro:page-load', initTeamFilters);
  </script>
</Layout>
