---
export const prerender = false;

import Layout from '../layouts/Layout.astro';
import PageBanner from '../components/PageBanner.astro';
import { resolveSupabaseEnv, getPageBanners } from '../lib/supabase';
import { bannerUrlFor } from '../lib/pageBanners';

// Shell-then-skeleton split (same pattern as results.astro / standings.astro):
// this file only fetches the page banner and paints the heading plus a loading
// skeleton right away; the teams table, season picker and rosters lives in teams/fragment.astro and is
// fetched client-side by the loader script below once this shell has painted.
const supabaseEnv = resolveSupabaseEnv(Astro.locals);

let bannerUrl: string | null = null;
try {
  bannerUrl = bannerUrlFor(await getPageBanners(supabaseEnv), 'teams');
} catch (err) {
  console.error('Failed to load page banner:', err);
}

Astro.response.headers.set('Cache-Control', 'public, s-maxage=60, stale-while-revalidate=300');
---

<Layout title="Teams" description="Active and past teams competing in Alpha Touring Challenge.">
  <section class="relative mx-auto max-w-6xl px-6 pb-24 pt-8">
    <PageBanner imageUrl={bannerUrl} />
    <h1 class="reveal font-display text-2xl sm:text-5xl">Teams</h1>

    <div data-teams-results data-fragment-url={`/teams/fragment${Astro.url.search}`}>
      <div aria-live="polite" aria-busy="true">
        <span class="sr-only">Loading teams…</span>
        <div class="mt-8 flex flex-wrap items-end gap-4">
          <div class="h-10 w-full max-w-sm animate-pulse rounded-md border border-white/10 bg-white/[0.03]"></div>
          <div class="h-[4.5rem] w-44 animate-pulse rounded-md border border-white/10 bg-white/[0.03]"></div>
        </div>
        <div class="mt-4 h-[32rem] animate-pulse rounded-xl border border-white/10 bg-white/[0.02]"></div>
      </div>
    </div>
  </section>

  <script>
    // Search-only now — the Active/Inactive/All status filter (and the
    // Status/Founded shared-column toggle it drove) is gone; the current
    // season's team list is hard-filtered to active teams server-side (see
    // sortedTeams in the frontmatter above), so there's nothing left to
    // filter by on the client except the search box.
    function initTeamFilters() {
      const input = document.getElementById('team-search') as HTMLInputElement | null;
      const list = document.getElementById('team-list');
      const empty = document.getElementById('team-search-empty');
      if (!list) return;

      function applyFilters() {
        const search = input?.value.trim().toLowerCase() ?? '';
        const rows = list!.querySelectorAll<HTMLElement>('[data-search]');
        let visibleCount = 0;
        rows.forEach((row) => {
          const visible = !search || (row.dataset.search ?? '').includes(search);
          row.style.display = visible ? '' : 'none';
          if (visible) visibleCount += 1;
        });
        if (empty) empty.classList.toggle('hidden', visibleCount > 0);
      }

      input?.addEventListener('input', applyFilters);
    }

    document.addEventListener('astro:page-load', initTeamFilters);
  </script>
</Layout>

<script>
  // Shell-then-skeleton: fetches the teams fragment (the expensive data work)
  // client-side once this shell has already painted — same pattern as
  // results.astro / standings.astro; see the matching fragment.astro for the
  // full explanation.
  function initTeamsResults() {
    const container = document.querySelector<HTMLElement>('[data-teams-results]');
    const url = container?.dataset.fragmentUrl;
    if (!container || !url) return;
    // Cleared immediately so the synthetic astro:page-load dispatched below
    // doesn't see this same data-fragment-url and fetch it all over again.
    delete container.dataset.fragmentUrl;

    fetch(url)
      .then((res) => {
        if (!res.ok) throw new Error(`teams fragment request failed (${res.status})`);
        return res.text();
      })
      .then((html) => {
        container.innerHTML = html;
        // reveal.ts only observes `.reveal` elements present at page-load
        // time; this content lands later, so mark it visible right away.
        container.querySelectorAll('.reveal').forEach((el) => el.classList.add('is-visible'));
        // Sortable tables, row expanders and this page's own scripts bind
        // against whatever exists at astro:page-load, so re-dispatch it now
        // that the real content is in place.
        document.dispatchEvent(new Event('astro:page-load'));
      })
      .catch((err) => {
        console.error('Failed to load teams:', err);
        container.innerHTML = '<p class="mt-10 text-white/60">Couldn’t load this page right now — try refreshing.</p>';
      });
  }

  document.addEventListener('astro:page-load', initTeamsResults);
</script>
