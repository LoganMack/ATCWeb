---
export const prerender = false;

import DriverFlag from '../../components/DriverFlag.astro';
import { resolveSupabaseEnv, getSeasons, displayDriverName, type Season } from '../../lib/supabase';
import { computeSeasonAwardsHistory, type SeasonAwardWinner } from '../../lib/results';

/**
 * Pilot for the sitewide "shell renders instantly, data fills in after"
 * pattern (see champions/fragment.astro's own doc comment for the full
 * explanation) — awards.astro only renders the page banner and a loading
 * skeleton, then fetches THIS route client-side for the actual twelve
 * awards. computeSeasonAwardsHistory (src/lib/results.ts) is exactly the
 * kind of expensive, every-season-on-file computation that pattern exists
 * for.
 *
 * Returns a bare HTML fragment — no <Layout>, no <html>/<head> — meant only
 * to be dropped into awards.astro's results container via
 * `container.innerHTML = await res.text()`. Never linked to directly.
 */

const supabaseEnv = resolveSupabaseEnv(Astro.locals);

function trimNum(n: number, maxDecimals: number): string {
  const s = n.toFixed(maxDecimals);
  return s.includes('.') ? s.replace(/\.?0+$/, '').replace(/\.$/, '') : s;
}

function signed(n: number): string {
  const rounded = Math.round(n);
  return rounded > 0 ? `+${rounded}` : `${rounded}`;
}

interface AwardRow {
  seasonName: string;
  seasonLogoUrl: string | null;
  driverName: string | null;
  carNumber: number | null;
  nationality1: string | null;
  nationality2: string | null;
  valueText: string | null;
  link?: { href: string; label: string };
}

interface AwardSection {
  key: string;
  label: string;
  description: string;
  hasLinks: boolean;
  rows: AwardRow[];
}

function row(
  season: Season,
  winner: SeasonAwardWinner | null,
  valueText: string | null,
  link?: { href: string; label: string }
): AwardRow {
  return {
    seasonName: season.name,
    seasonLogoUrl: season.logo_url,
    driverName: winner ? displayDriverName(winner.driver.name) : null,
    carNumber: winner?.driver.car_number ?? null,
    nationality1: winner?.driver.nationality_1 ?? null,
    nationality2: winner?.driver.nationality_2 ?? null,
    valueText,
    link,
  };
}

let sections: AwardSection[] = [];
let loadError: string | null = null;
try {
  const seasons = await getSeasons(supabaseEnv);
  const seasonAwardsList = await computeSeasonAwardsHistory(supabaseEnv, seasons);

  sections = [
    {
      key: 'rookieOfTheSeason',
      label: 'Rookie of the Season',
      description: 'Highest-scoring rookie.',
      hasLinks: false,
      rows: seasonAwardsList.map((sa) =>
        row(sa.season, sa.rookieOfTheSeason, sa.rookieOfTheSeason ? `${trimNum(sa.rookieOfTheSeason.value, 1)} pts` : null)
      ),
    },
    {
      key: 'sublimeFinesse',
      label: 'Sublime Finesse',
      description: "Most corners per incident — minimum 50% of the season's rounds attended, by appearances.",
      hasLinks: false,
      rows: seasonAwardsList.map((sa) =>
        row(sa.season, sa.sublimeFinesse, sa.sublimeFinesse ? `${trimNum(sa.sublimeFinesse.value, 1)} corners/incident` : null)
      ),
    },
    {
      key: 'leader',
      label: 'Leader',
      description: 'Most laps led.',
      hasLinks: false,
      rows: seasonAwardsList.map((sa) => row(sa.season, sa.leader, sa.leader ? `${trimNum(sa.leader.value, 0)} laps led` : null)),
    },
    {
      key: 'ironman',
      label: 'Ironman',
      description: 'Most distance covered, using circuit lengths.',
      hasLinks: false,
      rows: seasonAwardsList.map((sa) =>
        row(
          sa.season,
          sa.ironman,
          sa.ironman ? `${trimNum(sa.ironman.value, 1)} km of ${trimNum(sa.ironman.maxPossibleKm, 1)} km possible` : null
        )
      ),
    },
    {
      key: 'consistency',
      label: 'Consistency',
      description: 'Best average finish per race.',
      hasLinks: false,
      rows: seasonAwardsList.map((sa) =>
        row(sa.season, sa.consistency, sa.consistency ? `${trimNum(sa.consistency.value, 2)} avg finish` : null)
      ),
    },
    {
      key: 'bonusFeature',
      label: 'Bonus Feature',
      description: 'Most bonus points.',
      hasLinks: false,
      rows: seasonAwardsList.map((sa) =>
        row(sa.season, sa.bonusFeature, sa.bonusFeature ? `${trimNum(sa.bonusFeature.value, 1)} bonus pts` : null)
      ),
    },
    {
      key: 'nakedAggression',
      label: 'Naked Aggression',
      description: 'Most net positions gained.',
      hasLinks: false,
      rows: seasonAwardsList.map((sa) =>
        row(sa.season, sa.nakedAggression, sa.nakedAggression ? `${signed(sa.nakedAggression.value)} net positions` : null)
      ),
    },
    {
      key: 'speedDemon',
      label: 'Speed Demon',
      description: 'Most fastest laps.',
      hasLinks: false,
      rows: seasonAwardsList.map((sa) =>
        row(sa.season, sa.speedDemon, sa.speedDemon ? `${sa.speedDemon.value} fastest lap${sa.speedDemon.value === 1 ? '' : 's'}` : null)
      ),
    },
    {
      key: 'dominator',
      label: 'Dominator',
      description: 'Biggest class-winning margin of the season, in any single race.',
      hasLinks: true,
      rows: seasonAwardsList.map((sa) =>
        row(
          sa.season,
          sa.dominator,
          sa.dominator ? `${(sa.dominator.value / 10000).toFixed(3)}s margin` : null,
          sa.dominator
            ? {
                href: `/results/${sa.dominator.subsessionId}`,
                label: `${sa.dominator.trackName}${sa.dominator.raceNumber > 1 ? ` — Race ${sa.dominator.raceNumber}` : ''}`,
              }
            : undefined
        )
      ),
    },
    {
      key: 'defender',
      label: 'Defender',
      description: 'Smallest class-winning margin of the season, in any single race.',
      hasLinks: true,
      rows: seasonAwardsList.map((sa) =>
        row(
          sa.season,
          sa.defender,
          sa.defender ? `${(sa.defender.value / 10000).toFixed(3)}s margin` : null,
          sa.defender
            ? {
                href: `/results/${sa.defender.subsessionId}`,
                label: `${sa.defender.trackName}${sa.defender.raceNumber > 1 ? ` — Race ${sa.defender.raceNumber}` : ''}`,
              }
            : undefined
        )
      ),
    },
    {
      key: 'enduranceSpecialist',
      label: 'Endurance Specialist',
      description: 'Most points scored counting only endurance rounds, no dropped weeks.',
      hasLinks: false,
      rows: seasonAwardsList.map((sa) =>
        row(
          sa.season,
          sa.enduranceSpecialist,
          sa.enduranceSpecialist ? `${trimNum(sa.enduranceSpecialist.value, 1)} pts (no drops)` : null
        )
      ),
    },
    {
      key: 'sprintSpecialist',
      label: 'Sprint Specialist',
      description: 'Most points scored counting only sprint rounds, no dropped weeks.',
      hasLinks: false,
      rows: seasonAwardsList.map((sa) =>
        row(sa.season, sa.sprintSpecialist, sa.sprintSpecialist ? `${trimNum(sa.sprintSpecialist.value, 1)} pts (no drops)` : null)
      ),
    },
  ];
} catch (err) {
  console.error('Failed to compute season awards (fragment):', err);
  loadError = err instanceof Error ? err.message : String(err);
}

Astro.response.headers.set('Cache-Control', 'public, s-maxage=60, stale-while-revalidate=300');
---

{loadError && (
  <p class="mt-4 rounded-lg border border-brand-pink/30 bg-brand-pink/10 p-4 text-sm text-white/80">
    Couldn't load Awards right now.
    <br /><span class="mt-1 block text-white/50">{loadError}</span>
  </p>
)}

{!loadError && sections.every((s) => s.rows.length === 0) && <p class="mt-10 text-white/60">No results.</p>}

{!loadError && sections.some((s) => s.rows.length > 0) && (
  <div class="mt-8 flex flex-col gap-3">
    {sections.map((section, i) => (
      <details class="group reveal rounded-xl border border-white/10 bg-white/[0.03] transition open:bg-white/[0.05]" style={`transition-delay: ${Math.min(i, 6) * 20}ms`}>
        <summary class="flex cursor-pointer list-none items-center gap-4 p-4">
          <div>
            <p class="font-display text-xl leading-none">{section.label}</p>
            <p class="mt-1 text-xs text-white/50">{section.description}</p>
          </div>
          <span class="ml-auto flex-none text-white/40 transition group-open:rotate-180">▾</span>
        </summary>
        <div class="border-t border-white/10 p-4">
          {section.rows.length === 0 ? (
            <p class="text-sm text-white/40">No results.</p>
          ) : (
            <div class="overflow-x-auto">
              <table class="w-full min-w-[480px] border-collapse text-sm">
                <thead>
                  <tr class="border-b border-white/10 text-left text-[10px] uppercase tracking-wide text-white/30">
                    <th class="py-2 pr-3 font-medium">Season</th>
                    <th class="py-2 pr-3 font-medium">Winner</th>
                    <th class="py-2 pr-3 font-medium">Value</th>
                    {section.hasLinks && <th class="py-2 pr-3 font-medium">Race</th>}
                  </tr>
                </thead>
                <tbody>
                  {section.rows.map((r) => (
                    <tr class="border-b border-white/5">
                      <td class="py-2 pr-3 font-semibold text-white/90">
                        <span class="flex items-center gap-1.5">
                          {r.seasonLogoUrl && <img src={r.seasonLogoUrl} alt="" class="h-4 w-4 flex-none rounded-sm object-contain" />}
                          {r.seasonName}
                        </span>
                      </td>
                      <td class="py-2 pr-3 text-white/80">
                        {r.driverName ? (
                          <span class="flex items-center gap-1.5">
                            <DriverFlag nationality1={r.nationality1} nationality2={r.nationality2} size="h-3.5 w-5" />
                            {r.driverName}
                            {r.carNumber !== null && <span class="text-white/40">#{r.carNumber}</span>}
                          </span>
                        ) : (
                          <span class="text-white/30">—</span>
                        )}
                      </td>
                      <td class="py-2 pr-3 text-white/70">{r.valueText ?? <span class="text-white/30">—</span>}</td>
                      {section.hasLinks && (
                        <td class="py-2 pr-3 text-white/70">
                          {r.link ? (
                            <a href={r.link.href} class="text-brand-primary hover:underline">
                              {r.link.label}
                            </a>
                          ) : (
                            <span class="text-white/30">—</span>
                          )}
                        </td>
                      )}
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          )}
        </div>
      </details>
    ))}
  </div>
)}
