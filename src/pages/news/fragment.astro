---
export const prerender = false;

import NewsCard from '../../components/NewsCard.astro';
import { getNewsPosts, getSeasons, resolveSupabaseEnv, getAllNewsPostTags, type NewsTag, type SeasonLogoPair } from '../../lib/supabase';

const supabaseEnv = resolveSupabaseEnv(Astro.locals);

// Four independent fetches — none depends on another's result (the
// seasonOptions/posts computations that use allPosts happen after all four
// resolve) — so they're wrapped in named functions and run concurrently via
// one Promise.all rather than one after another.
let allPosts: Awaited<ReturnType<typeof getNewsPosts>> = [];
let loadError = false;
async function loadAllPosts() {
  try {
    allPosts = await getNewsPosts(supabaseEnv);
  } catch (err) {
    console.error('Failed to load news posts:', err);
    loadError = true;
  }
}

// season_label on a post is freeform text, not an FK to `seasons` — best-
// effort name match so NewsCard can show that season's logo next to its tag.
let logoBySeasonLabel = new Map<string, SeasonLogoPair>();
async function loadSeasonLogos() {
  try {
    const seasons = await getSeasons(supabaseEnv);
    logoBySeasonLabel = new Map(
      seasons.filter((s) => s.logo_url).map((s) => [s.name, { dark: s.logo_url!, light: s.logo_url_light }])
    );
  } catch (err) {
    console.error('Failed to load seasons for news card logos:', err);
  }
}

// Every post's assigned tags (0055_news_tags.sql), fetched once and grouped
// by post_id — same "fetch once, map by id" convention as logoBySeasonLabel
// just above.
let tagsByPostId = new Map<string, NewsTag[]>();
async function loadTags() {
  try {
    const links = await getAllNewsPostTags(supabaseEnv);
    for (const link of links) {
      if (!link.news_tags) continue;
      if (!tagsByPostId.has(link.post_id)) tagsByPostId.set(link.post_id, []);
      tagsByPostId.get(link.post_id)!.push(link.news_tags);
    }
  } catch (err) {
    console.error('Failed to load news tags for news cards:', err);
  }
}

await Promise.all([loadAllPosts(), loadSeasonLogos(), loadTags()]);

// Every distinct season tag currently in use, for the filter dropdown —
// derived straight from the posts themselves (already fetched in full, no
// extra query needed) rather than from curated_rounds, since a post can be
// tagged with a season no round is linked to at all.
const seasonOptions = [...new Set(allPosts.map((p) => p.season_label).filter((s): s is string => Boolean(s)))]
  // Most recent season first (ATC18 before ATC9 — numeric-aware), right after "All seasons".
  .sort((a, b) => b.localeCompare(a, undefined, { numeric: true }));

const q = Astro.url.searchParams.get('q')?.trim() ?? '';
const seasonFilter = Astro.url.searchParams.get('season') ?? '';

const posts = allPosts.filter((p) => {
  if (q && !p.title.toLowerCase().includes(q.toLowerCase())) return false;
  if (seasonFilter && p.season_label !== seasonFilter) return false;
  return true;
});

Astro.response.headers.set('Cache-Control', 'public, s-maxage=60, stale-while-revalidate=300');
---

    {loadError && (
      <p class="mt-8 rounded-lg border border-brand-pink/30 bg-brand-pink/10 p-4 text-sm text-white/80">
        Couldn't load news right now — check that PUBLIC_SUPABASE_URL and PUBLIC_SUPABASE_ANON_KEY are set.
      </p>
    )}

    {!loadError && (
      <form method="GET" data-news-filter class="reveal mt-8 flex flex-wrap items-end gap-3" style="transition-delay: 40ms">
        <label class="flex flex-col gap-1.5 text-sm">
          <span class="text-white/60">Search titles</span>
          <input
            type="search"
            name="q"
            value={q}
            placeholder="Search news..."
            class="w-64 rounded-md border border-white/15 bg-white/5 px-3 py-2 text-white outline-none focus:border-brand-primary"
          />
        </label>
        <label class="flex flex-col gap-1.5 text-sm">
          <span class="text-white/60">Season</span>
          <select
            name="season"
            class="rounded-md border border-white/15 bg-white/5 px-3 py-2 text-white outline-none focus:border-brand-primary"
          >
            <option value="" class="bg-brand-ink text-white">All seasons</option>
            {seasonOptions.map((label) => (
              <option value={label} selected={label === seasonFilter} class="bg-brand-ink text-white">{label}</option>
            ))}
          </select>
        </label>
      </form>
    )}

    {/* Only this block is swapped when the filters change (see news/index.astro's script), so the search box keeps focus while typing. */}
    <div data-news-list>
      {!loadError && posts.length === 0 && (
        <p class="mt-6 text-white/60">No results.</p>
      )}

      {posts.length > 0 && (
        <div class="mt-6">
          <NewsCard post={posts[0]} index={0} featured logoBySeasonLabel={logoBySeasonLabel} tagsByPostId={tagsByPostId} />
          {posts.length > 1 && (
            <div class="mt-6 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
              {posts.slice(1).map((post, i) => <NewsCard post={post} index={i + 1} logoBySeasonLabel={logoBySeasonLabel} tagsByPostId={tagsByPostId} />)}
            </div>
          )}
        </div>
      )}
    </div>
