---
export const prerender = false;

import Layout from '../../layouts/Layout.astro';
import PageBanner from '../../components/PageBanner.astro';
import { resolveSupabaseEnv, getPageBanners } from '../../lib/supabase';
import { bannerUrlFor } from '../../lib/pageBanners';

// Shell-then-skeleton split (same pattern as results.astro / standings.astro):
// this file only fetches the page banner and paints the heading plus a loading
// skeleton right away; the posts, tags and filter form lives in news/fragment.astro and is
// fetched client-side by the loader script below once this shell has painted.
const supabaseEnv = resolveSupabaseEnv(Astro.locals);

let bannerUrl: string | null = null;
try {
  bannerUrl = bannerUrlFor(await getPageBanners(supabaseEnv), 'news');
} catch (err) {
  console.error('Failed to load page banner:', err);
}

Astro.response.headers.set('Cache-Control', 'public, s-maxage=60, stale-while-revalidate=300');
---

<Layout title="News" description="News and updates from Alpha Touring Challenge.">
  <section class="relative mx-auto max-w-6xl overflow-hidden px-6 pb-24 pt-8">
    <PageBanner imageUrl={bannerUrl} />
    <h1 class="reveal font-display text-2xl sm:text-5xl">News</h1>

    <div data-news-results data-fragment-url={`/news/fragment${Astro.url.search}`}>
      <div aria-live="polite" aria-busy="true">
        <span class="sr-only">Loading news…</span>
        <div class="mt-8 flex flex-wrap items-end gap-3">
          <div class="h-[4.5rem] w-64 animate-pulse rounded-md border border-white/10 bg-white/[0.03]"></div>
          <div class="h-[4.5rem] w-40 animate-pulse rounded-md border border-white/10 bg-white/[0.03]"></div>
        </div>
        <div class="mt-10 h-72 animate-pulse rounded-xl border border-white/10 bg-white/[0.03]"></div>
        <div class="mt-6 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          <div class="h-64 animate-pulse rounded-xl border border-white/10 bg-white/[0.03]"></div>
          <div class="h-64 animate-pulse rounded-xl border border-white/10 bg-white/[0.03]"></div>
          <div class="h-64 animate-pulse rounded-xl border border-white/10 bg-white/[0.03]"></div>
        </div>
      </div>
    </div>
  </section>
</Layout>

<script>
  // Shell-then-skeleton: fetches the news fragment (the expensive data work)
  // client-side once this shell has already painted — same pattern as
  // results.astro / standings.astro; see the matching fragment.astro for the
  // full explanation.
  function initNewsResults() {
    const container = document.querySelector<HTMLElement>('[data-news-results]');
    const url = container?.dataset.fragmentUrl;
    if (!container || !url) return;
    // Cleared immediately so the synthetic astro:page-load dispatched below
    // doesn't see this same data-fragment-url and fetch it all over again.
    delete container.dataset.fragmentUrl;

    fetch(url)
      .then((res) => {
        if (!res.ok) throw new Error(`news fragment request failed (${res.status})`);
        return res.text();
      })
      .then((html) => {
        container.innerHTML = html;
        // reveal.ts only observes `.reveal` elements present at page-load
        // time; this content lands later, so mark it visible right away.
        container.querySelectorAll('.reveal').forEach((el) => el.classList.add('is-visible'));
        // Sortable tables, row expanders and this page's own scripts bind
        // against whatever exists at astro:page-load, so re-dispatch it now
        // that the real content is in place.
        document.dispatchEvent(new Event('astro:page-load'));
      })
      .catch((err) => {
        console.error('Failed to load news:', err);
        container.innerHTML = '<p class="mt-10 text-white/60">Couldn’t load this page right now — try refreshing.</p>';
      });
  }

  document.addEventListener('astro:page-load', initNewsResults);
</script>
