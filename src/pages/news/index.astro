---
export const prerender = false;

import Layout from '../../layouts/Layout.astro';
import NewsCard from '../../components/NewsCard.astro';
import PageBanner from '../../components/PageBanner.astro';
import { getNewsPosts, getPageBanners, getSeasons, resolveSupabaseEnv } from '../../lib/supabase';
import { bannerUrlFor } from '../../lib/pageBanners';

const supabaseEnv = resolveSupabaseEnv(Astro.locals);

let allPosts: Awaited<ReturnType<typeof getNewsPosts>> = [];
let loadError = false;
try {
  allPosts = await getNewsPosts(supabaseEnv);
} catch (err) {
  console.error('Failed to load news posts:', err);
  loadError = true;
}

let bannerUrl: string | null = null;
try {
  bannerUrl = bannerUrlFor(await getPageBanners(supabaseEnv), 'news');
} catch (err) {
  console.error('Failed to load page banner:', err);
}

// season_label on a post is freeform text, not an FK to `seasons` — best-
// effort name match so NewsCard can show that season's logo next to its tag.
let logoBySeasonLabel = new Map<string, string>();
try {
  const seasons = await getSeasons(supabaseEnv);
  logoBySeasonLabel = new Map(seasons.filter((s) => s.logo_url).map((s) => [s.name, s.logo_url!]));
} catch (err) {
  console.error('Failed to load seasons for news card logos:', err);
}

// Every distinct season tag currently in use, for the filter dropdown —
// derived straight from the posts themselves (already fetched in full, no
// extra query needed) rather than from curated_rounds, since a post can be
// tagged with a season no round is linked to at all.
const seasonOptions = [...new Set(allPosts.map((p) => p.season_label).filter((s): s is string => Boolean(s)))].sort();

const q = Astro.url.searchParams.get('q')?.trim() ?? '';
const seasonFilter = Astro.url.searchParams.get('season') ?? '';

const posts = allPosts.filter((p) => {
  if (q && !p.title.toLowerCase().includes(q.toLowerCase())) return false;
  if (seasonFilter && p.season_label !== seasonFilter) return false;
  return true;
});

Astro.response.headers.set('Cache-Control', 'public, s-maxage=60, stale-while-revalidate=300');
---

<Layout title="News" description="News and updates from Alpha Touring Challenge.">
  <section class="relative mx-auto max-w-6xl overflow-hidden px-6 pb-24 pt-28 sm:pt-36">
    <PageBanner imageUrl={bannerUrl} />
    <h1 class="reveal font-display text-5xl">News</h1>

    {loadError && (
      <p class="mt-8 rounded-lg border border-brand-pink/30 bg-brand-pink/10 p-4 text-sm text-white/80">
        Couldn't load news right now — check that PUBLIC_SUPABASE_URL and PUBLIC_SUPABASE_ANON_KEY are set.
      </p>
    )}

    {!loadError && (
      <form method="GET" class="reveal mt-8 flex flex-wrap items-end gap-3" style="transition-delay: 40ms">
        <label class="flex flex-col gap-1.5 text-sm">
          <span class="text-white/60">Search titles</span>
          <input
            type="search"
            name="q"
            value={q}
            placeholder="Search news..."
            class="w-64 rounded-md border border-white/15 bg-white/5 px-3 py-2 text-white outline-none focus:border-brand-primary"
          />
        </label>
        <label class="flex flex-col gap-1.5 text-sm">
          <span class="text-white/60">Season</span>
          <select
            name="season"
            onchange="this.form.submit()"
            class="rounded-md border border-white/15 bg-white/5 px-3 py-2 text-white outline-none focus:border-brand-primary"
          >
            <option value="" class="bg-brand-ink text-white">All seasons</option>
            {seasonOptions.map((label) => (
              <option value={label} selected={label === seasonFilter} class="bg-brand-ink text-white">{label}</option>
            ))}
          </select>
        </label>
        <button
          type="submit"
          class="rounded-lg bg-white/5 px-4 py-2 text-sm font-semibold text-white/70 ring-1 ring-white/10 transition hover:bg-white/10"
        >
          Search
        </button>
        {(q || seasonFilter) && (
          <a href="/news" class="text-sm text-white/40 hover:text-white/70">Clear</a>
        )}
      </form>
    )}

    {!loadError && posts.length === 0 && (
      <p class="mt-8 text-white/60">No results.</p>
    )}

    {posts.length > 0 && (
      <div class="mt-10">
        <NewsCard post={posts[0]} index={0} featured logoBySeasonLabel={logoBySeasonLabel} />
        {posts.length > 1 && (
          <div class="mt-6 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
            {posts.slice(1).map((post, i) => <NewsCard post={post} index={i + 1} logoBySeasonLabel={logoBySeasonLabel} />)}
          </div>
        )}
      </div>
    )}
  </section>
</Layout>
