---
export const prerender = false;

import Layout from '../../layouts/Layout.astro';
import { getNewsPostBySlug, resolveSupabaseEnv, formatDate } from '../../lib/supabase';
import { getRoundBySubsessionId } from '../../lib/results';
import { computeRoundRecap, type RoundRecap } from '../../lib/newsRecap';
import { classBadgeClasses } from '../../lib/classColors';
import { isAdminView } from '../../lib/auth';

const supabaseEnv = resolveSupabaseEnv(Astro.locals);

const { slug } = Astro.params;
let post: Awaited<ReturnType<typeof getNewsPostBySlug>> = null;
try {
  post = slug ? await getNewsPostBySlug(supabaseEnv, slug) : null;
} catch (err) {
  console.error('Failed to load news post:', err);
}

if (!post) {
  return Astro.redirect('/news', 307);
}

Astro.response.headers.set('Cache-Control', 'public, s-maxage=60, stale-while-revalidate=300');

const date = formatDate(post.published_at);

// Simple paragraph splitting — no Markdown dependency for MVP1. If you need
// bold/links/lists in post bodies later, add `marked` and swap this out.
const paragraphs = post.body.split(/\n\s*\n/).map((p) => p.trim()).filter(Boolean);

// Linked round (optional, see 0017_news_round_season.sql): a link to the
// results at the top, and a live-computed recap at the bottom — neither is
// stored, both are recomputed from the round's current data on every view
// (see src/lib/newsRecap.ts's header for why).
let roundTrackName: string | null = null;
let recap: RoundRecap | null = null;
if (post.round_subsession_id !== null) {
  try {
    const [round, computedRecap] = await Promise.all([
      getRoundBySubsessionId(supabaseEnv, post.round_subsession_id),
      computeRoundRecap(supabaseEnv, post.round_subsession_id),
    ]);
    roundTrackName = round?.track_name ?? null;
    recap = computedRecap;
  } catch (err) {
    console.error('Failed to load linked round for news post:', err);
  }
}
---

<Layout title={post.title} description={post.excerpt ?? undefined}>
  <article class="mx-auto max-w-3xl px-6 pb-24 pt-28 sm:pt-36">
    <a href="/news" class="text-sm text-white/50 hover:text-white">&larr; Back to News</a>

    <h1 class="reveal mt-4 font-display text-4xl sm:text-5xl">{post.title}</h1>
    <p class="reveal mt-4 flex flex-wrap items-center gap-2 text-sm uppercase tracking-widest text-white/50" style="transition-delay: 80ms">
      <span>{date} · {post.author_name}</span>
      {post.season_label && (
        <span class="rounded bg-white/10 px-2 py-0.5 text-[11px] font-semibold text-white/50">{post.season_label}</span>
      )}
    </p>

    {post.round_subsession_id !== null && roundTrackName && (
      <a
        href={`/results/${post.round_subsession_id}`}
        class="reveal mt-4 inline-flex items-center gap-1.5 rounded-lg bg-brand-primary/15 px-3 py-1.5 text-sm font-semibold text-brand-primary ring-1 ring-brand-primary/30 transition hover:bg-brand-primary/25"
        style="transition-delay: 100ms"
      >
        View race results — {roundTrackName} &rarr;
      </a>
    )}

    {post.cover_image_url && (
      <img
        src={post.cover_image_url}
        alt={post.title}
        class="reveal mt-8 w-full rounded-xl object-cover"
        style="transition-delay: 120ms"
      />
    )}

    <div class="reveal mt-8 text-lg text-white/80" style="transition-delay: 160ms">
      {paragraphs.map((p) => <p class="mb-4 leading-relaxed">{p}</p>)}
    </div>

    {recap && (
      <div class="reveal mt-16 border-t border-white/10 pt-10" style="transition-delay: 200ms">
        <h2 class="font-display text-3xl">Race Recap — {recap.trackName}</h2>

        {recap.trackRecordMatchIssue && isAdminView(Astro.locals) && (
          <p class="mt-3 rounded-lg border border-brand-gold/30 bg-brand-gold/10 px-4 py-2.5 text-sm text-brand-gold">
            <span class="font-semibold">Admin only —</span> track-record checking is off for this recap: {recap.trackRecordMatchIssue}
          </p>
        )}

        {recap.races.map((race) => (
          <div class="mt-6 rounded-xl border border-white/10 bg-white/[0.03] p-5">
            <h3 class="text-xs font-semibold uppercase tracking-widest text-white/40">Race {race.raceNumber}</h3>

            {race.topByClass.length > 0 && (
              <div class="mt-4 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
                {race.topByClass.map((cls) => (
                  <div>
                    <span class={`rounded-lg border px-2 py-0.5 text-[11px] font-semibold uppercase tracking-wide ${classBadgeClasses(cls.className)}`}>
                      {cls.className}
                    </span>
                    <ol class="mt-2 flex flex-col gap-1 text-sm text-white/70">
                      {cls.top3.map((entry) => (
                        <li>
                          <span class="text-white/40">{entry.position}.</span> {entry.driver.name}
                          {entry.driver.car_number !== null && <span class="text-white/40"> #{entry.driver.car_number}</span>}
                          {entry.teamName && <span class="text-white/40"> — {entry.teamName}</span>}
                        </li>
                      ))}
                    </ol>
                  </div>
                ))}
              </div>
            )}

            {race.topRookies.length > 0 && (
              <div class="mt-4">
                <span class="text-xs font-semibold uppercase tracking-wide text-white/40">Top Rookies</span>
                <ol class="mt-2 flex flex-col gap-1 text-sm text-white/70">
                  {race.topRookies.map((entry) => (
                    <li>
                      {entry.position !== null && <span class="text-white/40">{entry.position}.</span>} {entry.driver.name}
                      {entry.driver.car_number !== null && <span class="text-white/40"> #{entry.driver.car_number}</span>}
                    </li>
                  ))}
                </ol>
              </div>
            )}

            {race.fastestLap && (
              <p class="mt-4 text-sm text-white/70">
                <span class="mr-1 text-xs font-semibold uppercase tracking-wide text-white/40">Fastest Lap</span>
                {race.fastestLap.driver.name}
                {race.fastestLap.driver.car_number !== null && ` #${race.fastestLap.driver.car_number}`} — {race.fastestLap.formatted}
                {race.fastestLap.isTrackRecord && (
                  <span class="ml-2 rounded bg-brand-gold/15 px-1.5 py-0.5 text-[10px] font-semibold uppercase tracking-wide text-brand-gold">
                    New Track Record
                  </span>
                )}
                {race.fastestLap.isTrackRecord && race.fastestLap.previousRecordFormatted && (
                  <span class="ml-1 text-xs text-white/40">(previous {race.fastestLap.previousRecordFormatted})</span>
                )}
              </p>
            )}
          </div>
        ))}

        {(recap.topTeamOverall || recap.topTeamDelta) && (
          <div class="mt-6 grid gap-4 sm:grid-cols-2">
            {recap.topTeamOverall && (
              <div class="rounded-xl border border-white/10 bg-white/[0.03] p-5">
                <span class="text-xs font-semibold uppercase tracking-wide text-white/40">Most Points — Overall</span>
                <p class="mt-1 text-lg font-semibold">{recap.topTeamOverall.teamName}</p>
                <p class="text-sm text-white/50">{recap.topTeamOverall.points} pts</p>
              </div>
            )}
            {recap.topTeamDelta && (
              <div class="rounded-xl border border-white/10 bg-white/[0.03] p-5">
                <span class="text-xs font-semibold uppercase tracking-wide text-white/40">Most Points — Delta</span>
                <p class="mt-1 text-lg font-semibold">{recap.topTeamDelta.teamName}</p>
                <p class="text-sm text-white/50">{recap.topTeamDelta.points} pts</p>
              </div>
            )}
          </div>
        )}

        {recap.teamBreakdown.length > 0 && (
          <div class="mt-6">
            <h3 class="text-xs font-semibold uppercase tracking-widest text-white/40">Who Scored For Who</h3>
            <div class="mt-3 flex flex-col gap-3">
              {recap.teamBreakdown.map((team) => (
                <div class="rounded-xl border border-white/10 bg-white/[0.03] p-4">
                  <p class="font-semibold">{team.teamName}</p>
                  <ul class="mt-1 flex flex-col gap-0.5 text-sm text-white/60">
                    {team.entries.map((entry) => (
                      <li>
                        Race {entry.raceNumber}: {entry.driverName}
                        {entry.carNumber !== null && ` #${entry.carNumber}`} — {entry.points} pts
                      </li>
                    ))}
                  </ul>
                </div>
              ))}
            </div>
          </div>
        )}
      </div>
    )}
  </article>
</Layout>
