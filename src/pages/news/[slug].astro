---
export const prerender = false;

import Layout from '../../layouts/Layout.astro';
import { getNewsPostBySlug, getSeasons, resolveSupabaseEnv, formatDate, displayDriverName, getTagsForPost, type NewsTag } from '../../lib/supabase';
import { getRoundBySubsessionId } from '../../lib/results';
import { computeRoundRecap, type RoundRecap } from '../../lib/newsRecap';
import { classBadgeClasses } from '../../lib/classColors';
import { isAdminView } from '../../lib/auth';
import TeamLogo from '../../components/TeamLogo.astro';
import DriverFlag from '../../components/DriverFlag.astro';

const supabaseEnv = resolveSupabaseEnv(Astro.locals);

const { slug } = Astro.params;
let post: Awaited<ReturnType<typeof getNewsPostBySlug>> = null;
try {
  post = slug ? await getNewsPostBySlug(supabaseEnv, slug) : null;
} catch (err) {
  console.error('Failed to load news post:', err);
}

if (!post) {
  return Astro.redirect('/news', 307);
}

Astro.response.headers.set('Cache-Control', 'public, s-maxage=60, stale-while-revalidate=300');

const date = formatDate(post.published_at);

// Three independent lookups, none depending on another — wrapped in named
// functions and run concurrently via one Promise.all instead of one after
// another.

// season_label is freeform text, not an FK to `seasons` — best-effort name
// match so the season tag can show that season's logo, same as NewsCard.
let seasonLogoUrl: string | null = null;
async function loadSeasonLogo() {
  if (!post!.season_label) return;
  try {
    const seasons = await getSeasons(supabaseEnv);
    seasonLogoUrl = seasons.find((s) => s.name === post!.season_label)?.logo_url ?? null;
  } catch (err) {
    console.error('Failed to load seasons for the post season tag logo:', err);
  }
}

// Assigned tags (0055_news_tags.sql) — separate from the RESULTS tag above,
// which is derived from round_subsession_id and needs no query of its own.
let tags: NewsTag[] = [];
async function loadTags() {
  try {
    tags = await getTagsForPost(supabaseEnv, post!.id);
  } catch (err) {
    console.error('Failed to load tags for news post:', err);
  }
}

// Linked round (optional, see 0017_news_round_season.sql): a link to the
// results at the top, and a live-computed recap at the bottom — neither is
// stored, both are recomputed from the round's current data on every view
// (see src/lib/newsRecap.ts's header for why).
let roundTrackName: string | null = null;
let recap: RoundRecap | null = null;
async function loadRoundAndRecap() {
  if (post!.round_subsession_id === null) return;
  try {
    const [round, computedRecap] = await Promise.all([
      getRoundBySubsessionId(supabaseEnv, post!.round_subsession_id),
      computeRoundRecap(supabaseEnv, post!.round_subsession_id),
    ]);
    roundTrackName = round?.track_name ?? null;
    recap = computedRecap;
  } catch (err) {
    console.error('Failed to load linked round for news post:', err);
  }
}

await Promise.all([loadSeasonLogo(), loadTags(), loadRoundAndRecap()]);

// Simple paragraph splitting — no Markdown dependency for MVP1. If you need
// bold/links/lists in post bodies later, add `marked` and swap this out.
const paragraphs = post.body.split(/\n\s*\n/).map((p) => p.trim()).filter(Boolean);
---

<Layout title={post.title} description={post.excerpt ?? undefined}>
  <article class="mx-auto max-w-3xl px-6 pb-24 pt-28 sm:pt-36">
    <a href="/news" class="text-sm text-white/50 hover:text-white">&larr; Back to News</a>

    <h1 class="reveal mt-4 font-display text-4xl sm:text-5xl">{post.title}</h1>
    <p class="reveal mt-4 flex flex-wrap items-center gap-2 text-sm uppercase tracking-widest text-white/50" style="transition-delay: 80ms">
      <span>{date} · {post.author_name}</span>
      {post.season_label && (
        <span class="flex items-center gap-1 rounded bg-white/10 px-2 py-0.5 text-[11px] font-semibold text-white/50">
          {post.season_label}
          {seasonLogoUrl && <img src={seasonLogoUrl} alt="" class="h-3.5 w-3.5 flex-none rounded-sm object-contain" />}
        </span>
      )}
      {post.round_subsession_id !== null && (
        <span class="rounded bg-brand-primary/15 px-2 py-0.5 text-[11px] font-semibold text-brand-primary">RESULTS</span>
      )}
      {tags.map((tag) => (
        <span class="rounded bg-white/10 px-2 py-0.5 text-[11px] font-semibold text-white/50">{tag.name}</span>
      ))}
    </p>

    {post.round_subsession_id !== null && roundTrackName && (
      <a
        href={`/results/${post.round_subsession_id}`}
        class="reveal mt-4 inline-flex items-center gap-1.5 rounded-lg bg-brand-primary/15 px-3 py-1.5 text-sm font-semibold text-brand-primary ring-1 ring-brand-primary/30 transition hover:bg-brand-primary/25"
        style="transition-delay: 100ms"
      >
        View Race Results &rarr;
      </a>
    )}

    {post.cover_image_url && (
      <img
        src={post.cover_image_url}
        alt={post.title}
        class="reveal mt-8 w-full rounded-xl object-cover"
        style="transition-delay: 120ms"
      />
    )}

    <div class="reveal mt-8 text-lg text-white/80" style="transition-delay: 160ms">
      {paragraphs.map((p) => <p class="mb-4 leading-relaxed">{p}</p>)}
    </div>

    {recap && (
      <div class="reveal mt-16 border-t border-white/10 pt-10" style="transition-delay: 200ms">
        <h2 class="font-display text-3xl">Race Recap — {recap.trackName}</h2>

        {recap.trackRecordMatchIssue && isAdminView(Astro.locals) && (
          <p class="mt-3 rounded-lg border border-brand-gold/30 bg-brand-gold/10 px-4 py-2.5 text-sm text-brand-gold">
            <span class="font-semibold">Admin only —</span> track-record checking is off for this recap: {recap.trackRecordMatchIssue}
          </p>
        )}

        {recap.races.map((race) => (
          <div class="mt-6 rounded-xl border border-white/10 bg-white/[0.03] p-5">
            <h3 class="text-xs font-semibold uppercase tracking-widest text-white/40">Race {race.raceNumber}</h3>

            {race.topByClass.length > 0 && (
              <div class="mt-4 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
                {race.topByClass.map((cls) => (
                  <div>
                    <span class={`rounded-lg border px-2 py-0.5 text-[11px] font-semibold uppercase tracking-wide ${classBadgeClasses(cls.className)}`}>
                      {cls.className}
                    </span>
                    <ol class="mt-2 flex flex-col gap-1.5 text-sm text-white/70">
                      {cls.top3.map((entry) => (
                        <li class="flex items-center gap-1.5">
                          <span class="text-white/40">{entry.position}.</span>
                          <DriverFlag nationality1={entry.driver.nationality_1} nationality2={entry.driver.nationality_2} />
                          <span>
                            {displayDriverName(entry.driver.name)}
                            {entry.driver.car_number !== null && <span class="text-white/40"> #{entry.driver.car_number}</span>}
                          </span>
                          {entry.teamName && <TeamLogo name={entry.teamName} logoUrl={entry.teamLogoUrl} size="h-4 w-4" />}
                        </li>
                      ))}
                    </ol>
                  </div>
                ))}
              </div>
            )}

            {race.topRookies.length > 0 && (
              <div class="mt-4">
                <span class="text-xs font-semibold uppercase tracking-wide text-white/40">Top Rookies</span>
                <ol class="mt-2 flex flex-col gap-1 text-sm text-white/70">
                  {race.topRookies.map((entry) => (
                    <li class="flex items-center gap-1.5">
                      {entry.position !== null && <span class="text-white/40">{entry.position}.</span>}
                      <DriverFlag nationality1={entry.driver.nationality_1} nationality2={entry.driver.nationality_2} />
                      {displayDriverName(entry.driver.name)}
                      {entry.driver.car_number !== null && <span class="text-white/40"> #{entry.driver.car_number}</span>}
                    </li>
                  ))}
                </ol>
              </div>
            )}

            {race.fastestLap && (
              <p class="mt-4 flex flex-wrap items-center gap-1.5 text-sm text-white/70">
                <span class="mr-1 text-xs font-semibold uppercase tracking-wide text-white/40">Fastest Lap</span>
                <DriverFlag nationality1={race.fastestLap.driver.nationality_1} nationality2={race.fastestLap.driver.nationality_2} />
                {displayDriverName(race.fastestLap.driver.name)}
                {race.fastestLap.driver.car_number !== null && ` #${race.fastestLap.driver.car_number}`} — {race.fastestLap.formatted}
                {race.fastestLap.isTrackRecord && (
                  <span class="ml-2 rounded bg-brand-gold/15 px-1.5 py-0.5 text-[10px] font-semibold uppercase tracking-wide text-brand-gold">
                    New Track Record
                  </span>
                )}
                {race.fastestLap.isTrackRecord && race.fastestLap.previousRecordFormatted && (
                  <span class="ml-1 text-xs text-white/40">(previous {race.fastestLap.previousRecordFormatted})</span>
                )}
              </p>
            )}

          </div>
        ))}

        {(recap.topTeamOverall || recap.topTeamDelta) && (
          <div class="mt-6 grid gap-4 sm:grid-cols-2">
            {recap.topTeamOverall && (
              <div class="rounded-xl border border-white/10 bg-white/[0.03] p-5">
                <span class="text-xs font-semibold uppercase tracking-wide text-white/40">Most Team Points — Overall</span>
                <div class="mt-1.5 flex items-center gap-2">
                  <TeamLogo name={recap.topTeamOverall.teamName} logoUrl={recap.topTeamOverall.logoUrl} size="h-7 w-7" />
                  <p class="text-lg font-semibold">{recap.topTeamOverall.teamName}</p>
                </div>
                <p class="mt-1 text-sm text-white/50">{recap.topTeamOverall.points} pts</p>
              </div>
            )}
            {recap.topTeamDelta && (
              <div class="rounded-xl border border-white/10 bg-white/[0.03] p-5">
                <span class="text-xs font-semibold uppercase tracking-wide text-white/40">Most Team Points — Delta</span>
                <div class="mt-1.5 flex items-center gap-2">
                  <TeamLogo name={recap.topTeamDelta.teamName} logoUrl={recap.topTeamDelta.logoUrl} size="h-7 w-7" />
                  <p class="text-lg font-semibold">{recap.topTeamDelta.teamName}</p>
                </div>
                <p class="mt-1 text-sm text-white/50">{recap.topTeamDelta.points} pts</p>
              </div>
            )}
          </div>
        )}

        {recap.teamBreakdown.length > 0 && (
          <details class="mt-6">
            <summary class="cursor-pointer text-xs font-semibold uppercase tracking-widest text-white/40 transition hover:text-white/60">
              Team Scoring Breakdown
            </summary>
            <div class="mt-3 flex flex-col gap-3">
              {recap.teamBreakdown.map((team) => (
                <div class="rounded-xl border border-white/10 bg-white/[0.03] p-4">
                  <div class="flex items-center gap-2">
                    <TeamLogo name={team.teamName} logoUrl={team.logoUrl} size="h-5 w-5" />
                    <p class="font-semibold">{team.teamName}</p>
                  </div>
                  <ul class="mt-1.5 flex flex-col gap-0.5 text-sm text-white/60">
                    {team.entries.map((entry) => (
                      <li class="flex items-center gap-1.5">
                        <span>Race {entry.raceNumber}:</span>
                        <DriverFlag nationality1={entry.nationality1} nationality2={entry.nationality2} />
                        <span>
                          {displayDriverName(entry.driverName)}
                          {entry.carNumber !== null && ` #${entry.carNumber}`} — {entry.points} pts
                        </span>
                      </li>
                    ))}
                  </ul>
                </div>
              ))}
            </div>
          </details>
        )}

        {recap.deltaTeamBreakdown.length > 0 && (
          <details class="mt-6">
            <summary class="cursor-pointer text-xs font-semibold uppercase tracking-widest text-white/40 transition hover:text-white/60">
              Delta Team Scoring Breakdown
            </summary>
            <div class="mt-3 flex flex-col gap-3">
              {recap.deltaTeamBreakdown.map((team) => (
                <div class="rounded-xl border border-white/10 bg-white/[0.03] p-4">
                  <div class="flex items-center gap-2">
                    <TeamLogo name={team.teamName} logoUrl={team.logoUrl} size="h-5 w-5" />
                    <p class="font-semibold">{team.teamName}</p>
                  </div>
                  <ul class="mt-1.5 flex flex-col gap-0.5 text-sm text-white/60">
                    {team.entries.map((entry) => (
                      <li class="flex items-center gap-1.5">
                        <span>Race {entry.raceNumber}:</span>
                        <DriverFlag nationality1={entry.nationality1} nationality2={entry.nationality2} />
                        <span>
                          {displayDriverName(entry.driverName)}
                          {entry.carNumber !== null && ` #${entry.carNumber}`} — {entry.points} pts
                        </span>
                      </li>
                    ))}
                  </ul>
                </div>
              ))}
            </div>
          </details>
        )}

        {recap.races.some((race) => race.sublimeFinesse.length > 0) && (
          <details class="mt-6">
            <summary class="cursor-pointer text-xs font-semibold uppercase tracking-widest text-white/40 transition hover:text-white/60">
              Sublime Finesse
            </summary>
            <div class="mt-3 flex flex-col gap-3">
              {recap.races.filter((race) => race.sublimeFinesse.length > 0).map((race) => (
                <div class="rounded-xl border border-white/10 bg-white/[0.03] p-4">
                  <p class="font-semibold">Race {race.raceNumber}</p>
                  <ul class="mt-1.5 flex flex-col gap-0.5 text-sm text-white/60">
                    {race.sublimeFinesse.map((entry) => (
                      <li class="flex items-center gap-1.5">
                        <DriverFlag nationality1={entry.driver.nationality_1} nationality2={entry.driver.nationality_2} />
                        <span>
                          {displayDriverName(entry.driver.name)}
                          {entry.carNumber !== null && ` #${entry.carNumber}`}
                          {entry.incidents !== null && ` — ${entry.incidents}x`}
                        </span>
                      </li>
                    ))}
                  </ul>
                </div>
              ))}
            </div>
          </details>
        )}

        {recap.races.some((race) => race.nakedAggression.length > 0) && (
          <details class="mt-6">
            <summary class="cursor-pointer text-xs font-semibold uppercase tracking-widest text-white/40 transition hover:text-white/60">
              Naked Aggression
            </summary>
            <div class="mt-3 flex flex-col gap-3">
              {recap.races.filter((race) => race.nakedAggression.length > 0).map((race) => (
                <div class="rounded-xl border border-white/10 bg-white/[0.03] p-4">
                  <p class="font-semibold">Race {race.raceNumber}</p>
                  <ul class="mt-1.5 flex flex-col gap-0.5 text-sm text-white/60">
                    {race.nakedAggression.map((entry) => (
                      <li class="flex items-center gap-1.5">
                        <DriverFlag nationality1={entry.driver.nationality_1} nationality2={entry.driver.nationality_2} />
                        <span>
                          {displayDriverName(entry.driver.name)}
                          {entry.carNumber !== null && ` #${entry.carNumber}`}
                          {' '}— P{entry.startingPosition} &rarr; P{entry.finishPosition}
                          <span class="ml-1 text-brand-gold">
                            ({entry.positionsGained >= 0 ? '+' : ''}{entry.positionsGained})
                          </span>
                          {entry.bonusAwarded && (
                            <span
                              class="ml-1.5 rounded bg-brand-gold/15 px-1.5 py-0.5 text-[10px] font-semibold uppercase tracking-wide text-brand-gold"
                              title="Naked Aggression bonus point — most net positions gained this race"
                            >
                              Bonus
                            </span>
                          )}
                        </span>
                      </li>
                    ))}
                  </ul>
                </div>
              ))}
            </div>
          </details>
        )}
      </div>
    )}
  </article>
</Layout>
