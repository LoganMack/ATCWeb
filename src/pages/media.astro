---
export const prerender = false;

import Layout from '../layouts/Layout.astro';
import PageBanner from '../components/PageBanner.astro';
import {
  resolveSupabaseEnv,
  getAllMediaGraphics,
  getMediaVideosByCategory,
  getAllMediaMeetups,
  getAllMeetupDriverLinks,
  getAllCircuitLayouts,
  getAllTrackGuides,
  getCircuits,
  getPageBanners,
  formatDate,
  displayLayoutName,
  displayDriverName,
  youtubeThumbnailUrl,
  resizedImageUrl,
  type MediaVideoCategory,
} from '../lib/supabase';
import {
  getAllBroadcastVideos,
  getAllPhotoAlbumLinks,
  getAllReplayLinks,
  type BroadcastVideo,
  type PhotoAlbumLink,
  type ReplayLink,
} from '../lib/results';
import { bannerUrlFor } from '../lib/pageBanners';

const supabaseEnv = resolveSupabaseEnv(Astro.locals);

// 'graphics' used to be one combined tab (Round Photo Albums + the
// media_graphics gallery) — split into two, the same "top-level tabs" shape
// Videos already used for its own sub-filters, per Logan: race photos and
// [originally "team graphics", since renamed to Posters — see below] are
// different enough things that they deserve their own tabs rather than
// being two sections stacked inside one.
//
// 'posters' was originally shipped as "Team Graphics" — Logan then decided
// to sunset that content and repurpose the same tab/gallery for event
// posters instead (see 0064_posters_sunset_team_graphics.sql, which wipes
// the old team-graphics-era rows). Deliberately still backed by the same
// `media_graphics` table/`MediaGraphic` type/`getAllMediaGraphics` etc. —
// mechanically it's the exact same "title + uploaded image, shown in a
// gallery" feature, just relabeled and given a fresh start content-wise, so
// there was no reason to rename the underlying schema too.
const TABS = ['videos', 'race-photos', 'posters', 'replays', 'meetups'] as const;
type Tab = (typeof TABS)[number];
const TAB_LABELS: Record<Tab, string> = {
  videos: 'Videos',
  'race-photos': 'Race Photos',
  posters: 'Posters',
  replays: 'Replays',
  meetups: 'Meetups',
};
const tabParam = Astro.url.searchParams.get('tab');
const tab: Tab = (TABS as readonly string[]).includes(tabParam ?? '') ? (tabParam as Tab) : 'videos';

const VIDEO_FILTERS = ['broadcasts', 'cinematic', 'educational', 'trackguide', 'other'] as const;
type VideoFilter = (typeof VIDEO_FILTERS)[number];
const filterParam = Astro.url.searchParams.get('filter');
const filter: VideoFilter = (VIDEO_FILTERS as readonly string[]).includes(filterParam ?? '') ? (filterParam as VideoFilter) : 'broadcasts';

let bannerUrl: string | null = null;
try {
  bannerUrl = bannerUrlFor(await getPageBanners(supabaseEnv), 'media');
} catch (err) {
  console.error('Failed to load page banner:', err);
}

let loadError = false;

let broadcastVideos: BroadcastVideo[] = [];
let categoryVideos: Awaited<ReturnType<typeof getMediaVideosByCategory>> = [];
// Track Guide is two-level now that a layout can have any number of guides
// (0053_track_guides.sql) — trackGuideLayouts is the "pick a layout" list
// (one card per layout with >=1 guide); selectedLayout/trackGuidesForLayout
// are populated instead, from the same query results, once `?layout=` names
// one of them.
let trackGuideLayouts: { layoutId: string; circuitName: string; layoutName: string; guideCount: number; firstUrl: string }[] = [];
let selectedLayout: { circuitName: string; layoutName: string } | null = null;
let trackGuidesForLayout: { title: string | null; url: string }[] = [];
let graphics: Awaited<ReturnType<typeof getAllMediaGraphics>> = [];
let photoAlbums: PhotoAlbumLink[] = [];
let replays: ReplayLink[] = [];
let meetups: Awaited<ReturnType<typeof getAllMediaMeetups>> = [];
let meetupDriverLinks: Awaited<ReturnType<typeof getAllMeetupDriverLinks>> = [];

try {
  if (tab === 'videos') {
    if (filter === 'broadcasts') {
      broadcastVideos = await getAllBroadcastVideos(supabaseEnv);
    } else if (filter === 'trackguide') {
      const [layouts, circuits, allGuides] = await Promise.all([
        getAllCircuitLayouts(supabaseEnv),
        getCircuits(supabaseEnv),
        getAllTrackGuides(supabaseEnv),
      ]);
      const circuitNameById = new Map(circuits.map((c) => [c.id, c.name]));
      const layoutById = new Map(layouts.map((l) => [l.id, l]));
      const guidesByLayoutId = new Map<string, typeof allGuides>();
      for (const guide of allGuides) {
        if (!guidesByLayoutId.has(guide.layout_id)) guidesByLayoutId.set(guide.layout_id, []);
        guidesByLayoutId.get(guide.layout_id)!.push(guide);
      }

      const layoutIdParam = Astro.url.searchParams.get('layout');
      const requestedLayout = layoutIdParam ? layoutById.get(layoutIdParam) : undefined;
      if (requestedLayout && guidesByLayoutId.has(requestedLayout.id)) {
        selectedLayout = {
          circuitName: circuitNameById.get(requestedLayout.circuit_id) ?? 'Unknown circuit',
          layoutName: displayLayoutName(requestedLayout.name),
        };
        trackGuidesForLayout = guidesByLayoutId.get(requestedLayout.id)!.map((g) => ({ title: g.title, url: g.url }));
      } else {
        trackGuideLayouts = [...guidesByLayoutId.entries()]
          .map(([layoutId, guides]) => {
            const layout = layoutById.get(layoutId);
            if (!layout) return null;
            return {
              layoutId,
              circuitName: circuitNameById.get(layout.circuit_id) ?? 'Unknown circuit',
              layoutName: displayLayoutName(layout.name),
              guideCount: guides.length,
              firstUrl: guides[0].url,
            };
          })
          .filter((entry): entry is NonNullable<typeof entry> => entry !== null)
          .sort((a, b) => a.circuitName.localeCompare(b.circuitName) || a.layoutName.localeCompare(b.layoutName));
      }
    } else {
      categoryVideos = await getMediaVideosByCategory(supabaseEnv, filter as MediaVideoCategory);
    }
  } else if (tab === 'race-photos') {
    photoAlbums = await getAllPhotoAlbumLinks(supabaseEnv);
  } else if (tab === 'posters') {
    graphics = await getAllMediaGraphics(supabaseEnv);
  } else if (tab === 'replays') {
    replays = await getAllReplayLinks(supabaseEnv);
  } else if (tab === 'meetups') {
    [meetups, meetupDriverLinks] = await Promise.all([getAllMediaMeetups(supabaseEnv), getAllMeetupDriverLinks(supabaseEnv)]);
  }
} catch (err) {
  console.error('Failed to load media page content:', err);
  loadError = true;
}

function tabHref(t: Tab): string {
  return t === 'videos' ? `/media?tab=videos&filter=${filter}` : `/media?tab=${t}`;
}
function filterHref(f: VideoFilter): string {
  return `/media?tab=videos&filter=${f}`;
}

const FILTER_LABELS: Record<VideoFilter, string> = {
  broadcasts: 'Broadcasts',
  cinematic: 'Cinematics',
  educational: 'Educational',
  trackguide: 'Track Guide',
  other: 'Other',
};

// Display names of every driver attached to each meetup (see
// 0070_meetup_drivers.sql), sorted alphabetically — grouped here from the
// flat link list rather than queried per-meetup, same "front-load once,
// group in memory" reasoning as photoLinksBySubsession elsewhere on this
// page.
const driverNamesByMeetupId = new Map<string, string[]>();
for (const link of meetupDriverLinks) {
  if (!link.drivers) continue;
  if (!driverNamesByMeetupId.has(link.meetup_id)) driverNamesByMeetupId.set(link.meetup_id, []);
  const label = displayDriverName(link.drivers.name) + (link.drivers.car_number !== null ? ` #${link.drivers.car_number}` : '');
  driverNamesByMeetupId.get(link.meetup_id)!.push(label);
}
for (const names of driverNamesByMeetupId.values()) names.sort((a, b) => a.localeCompare(b));

const meetupPins = meetups
  .filter((m) => Number.isFinite(m.latitude) && Number.isFinite(m.longitude))
  .map((m) => ({
    title: m.title,
    lat: m.latitude,
    lng: m.longitude,
    photoUrl: m.photo_url,
    locationLabel: m.location_label,
    date: m.meetup_date ? formatDate(m.meetup_date) : null,
    drivers: driverNamesByMeetupId.get(m.id) ?? [],
  }));

Astro.response.headers.set('Cache-Control', 'public, s-maxage=60, stale-while-revalidate=300');
---

<Layout title="Media" description="Broadcasts, cinematics, educational videos, track guides, race photos, posters, and meetups from Alpha Touring Challenge.">
  <section class="relative mx-auto max-w-5xl overflow-hidden px-6 pb-24 pt-28 sm:pt-36">
    <PageBanner imageUrl={bannerUrl} />
    <h1 class="reveal font-display text-5xl">Media</h1>

    <div class="reveal mb-8 mt-8 flex flex-wrap gap-2" style="transition-delay: 40ms">
      {TABS.map((t) => (
        <a
          href={tabHref(t)}
          class={`rounded-lg px-4 py-1.5 text-sm font-semibold ring-1 ring-white/15 transition ${
            tab === t ? 'bg-white text-brand-ink' : 'text-white/80 hover:bg-white/10'
          }`}
        >
          {TAB_LABELS[t]}
        </a>
      ))}
    </div>

    {loadError && (
      <p class="rounded-lg border border-brand-pink/30 bg-brand-pink/10 p-4 text-sm text-white/80">
        Couldn't load Media page content right now.
      </p>
    )}

    {!loadError && tab === 'videos' && (
      <>
        <div class="reveal mb-8 flex flex-wrap gap-2" style="transition-delay: 60ms">
          {VIDEO_FILTERS.map((f) => (
            <a
              href={filterHref(f)}
              class={`rounded-lg px-3.5 py-1.5 text-xs font-semibold ring-1 ring-white/15 transition ${
                filter === f ? 'bg-brand-primary text-white' : 'text-white/70 hover:bg-white/10'
              }`}
            >
              {FILTER_LABELS[f]}
            </a>
          ))}
        </div>

        <div class="reveal mb-6 max-w-sm" style="transition-delay: 70ms">
          <input
            type="search"
            id="media-search-videos"
            placeholder="Search…"
            class="w-full rounded-md border border-white/15 bg-white/5 px-3 py-2 text-white outline-none focus:border-brand-primary"
          />
        </div>

        {filter === 'broadcasts' && (
          broadcastVideos.length === 0 ? (
            <p class="reveal mt-8 text-white/60" style="transition-delay: 80ms">No broadcast links on file yet.</p>
          ) : (
            <div id="media-search-grid" class="reveal grid gap-4 sm:grid-cols-2 lg:grid-cols-3" style="transition-delay: 80ms">
              {broadcastVideos.map((v) => {
                const thumb = youtubeThumbnailUrl(v.broadcast_url);
                return (
                  <a href={v.broadcast_url} target="_blank" rel="noopener noreferrer" data-search={v.track_name.toLowerCase()} class="group overflow-hidden rounded-xl bg-white/5 ring-1 ring-white/10 transition hover:ring-brand-primary/50">
                    {thumb ? (
                      <img src={thumb} alt="" class="aspect-video w-full object-cover transition group-hover:brightness-110" />
                    ) : (
                      <div class="aspect-video w-full bg-white/10"></div>
                    )}
                    <div class="p-3">
                      <p class="font-semibold">{v.track_name}</p>
                      <p class="mt-0.5 text-xs text-white/50">
                        {v.season_label && `${v.season_label} · `}
                        {formatDate(v.start_time)}
                        {v.race_number > 1 && ` · Race ${v.race_number}`}
                      </p>
                    </div>
                  </a>
                );
              })}
            </div>
          )
        )}

        {filter === 'trackguide' && selectedLayout && (
          <>
            <a href="/media?tab=videos&filter=trackguide" class="reveal mb-4 inline-block text-sm text-brand-primary hover:underline" style="transition-delay: 70ms">
              &larr; All Track Guides
            </a>
            <h2 class="reveal mb-4 font-display text-2xl" style="transition-delay: 70ms">
              {selectedLayout.circuitName} — {selectedLayout.layoutName}
            </h2>
            <div id="media-search-grid" class="reveal grid gap-4 sm:grid-cols-2 lg:grid-cols-3" style="transition-delay: 80ms">
              {trackGuidesForLayout.map((tg) => {
                const thumb = youtubeThumbnailUrl(tg.url);
                return (
                  <a href={tg.url} target="_blank" rel="noopener noreferrer" data-search={(tg.title ?? '').toLowerCase()} class="group overflow-hidden rounded-xl bg-white/5 ring-1 ring-white/10 transition hover:ring-brand-primary/50">
                    {thumb ? (
                      <img src={thumb} alt="" class="aspect-video w-full object-cover transition group-hover:brightness-110" />
                    ) : (
                      <div class="aspect-video w-full bg-white/10"></div>
                    )}
                    <div class="p-3">
                      <p class="font-semibold">{tg.title || 'Track Guide'}</p>
                    </div>
                  </a>
                );
              })}
            </div>
          </>
        )}

        {filter === 'trackguide' && !selectedLayout && (
          trackGuideLayouts.length === 0 ? (
            <p class="reveal mt-8 text-white/60" style="transition-delay: 80ms">No track guides on file yet.</p>
          ) : (
            <div id="media-search-grid" class="reveal grid gap-4 sm:grid-cols-2 lg:grid-cols-3" style="transition-delay: 80ms">
              {trackGuideLayouts.map((tg) => {
                const thumb = youtubeThumbnailUrl(tg.firstUrl);
                return (
                  <a href={`/media?tab=videos&filter=trackguide&layout=${encodeURIComponent(tg.layoutId)}`} data-search={`${tg.circuitName} ${tg.layoutName}`.toLowerCase()} class="group overflow-hidden rounded-xl bg-white/5 ring-1 ring-white/10 transition hover:ring-brand-primary/50">
                    {thumb ? (
                      <img src={thumb} alt="" class="aspect-video w-full object-cover transition group-hover:brightness-110" />
                    ) : (
                      <div class="aspect-video w-full bg-white/10"></div>
                    )}
                    <div class="p-3">
                      <p class="font-semibold">{tg.circuitName}</p>
                      <p class="mt-0.5 text-xs text-white/50">
                        {tg.layoutName} · {tg.guideCount} guide{tg.guideCount === 1 ? '' : 's'}
                      </p>
                    </div>
                  </a>
                );
              })}
            </div>
          )
        )}

        {(filter === 'cinematic' || filter === 'educational' || filter === 'other') && (
          categoryVideos.length === 0 ? (
            <p class="reveal mt-8 text-white/60" style="transition-delay: 80ms">No results.</p>
          ) : (
            <div id="media-search-grid" class="reveal grid gap-4 sm:grid-cols-2 lg:grid-cols-3" style="transition-delay: 80ms">
              {categoryVideos.map((v) => {
                const thumb = youtubeThumbnailUrl(v.youtube_url);
                return (
                  <a href={v.youtube_url} target="_blank" rel="noopener noreferrer" data-search={v.title.toLowerCase()} class="group overflow-hidden rounded-xl bg-white/5 ring-1 ring-white/10 transition hover:ring-brand-primary/50">
                    {thumb ? (
                      <img src={thumb} alt="" class="aspect-video w-full object-cover transition group-hover:brightness-110" />
                    ) : (
                      <div class="aspect-video w-full bg-white/10"></div>
                    )}
                    <div class="p-3">
                      <p class="font-semibold">{v.title}</p>
                    </div>
                  </a>
                );
              })}
            </div>
          )
        )}
        <p id="media-search-empty-videos" class="reveal mt-8 hidden text-white/60">No matches.</p>
      </>
    )}

    {!loadError && tab === 'race-photos' && (
      photoAlbums.length === 0 ? (
        <p class="reveal mt-8 text-white/60" style="transition-delay: 60ms">No race photos on file yet.</p>
      ) : (
        // Same list shape as Videos → Broadcasts (see that block above) —
        // one card per round with a linked album, newest first. No
        // synchronous thumbnail here (see /api/photo-album-thumbnail's own
        // doc comment for why); each card starts with a plain placeholder
        // that the script at the bottom of this file swaps for a real image
        // once that round's thumbnail fetch resolves.
        <div id="media-photo-albums-grid" class="reveal grid gap-4 sm:grid-cols-2 lg:grid-cols-3" style="transition-delay: 60ms">
          {photoAlbums.map((p) => (
            <a
              href={p.photo_album_url}
              target="_blank"
              rel="noopener noreferrer"
              class="group overflow-hidden rounded-xl bg-white/5 ring-1 ring-white/10 transition hover:ring-brand-primary/50"
            >
              <div class="aspect-video w-full bg-white/10" data-album-thumb data-album-url={p.photo_album_url}></div>
              <div class="p-3">
                <p class="font-semibold">{p.track_name}</p>
                <p class="mt-0.5 text-xs text-white/50">
                  {p.season_label && `${p.season_label} · `}
                  {formatDate(p.start_time)}
                  {p.race_number > 1 && ` · Race ${p.race_number}`}
                </p>
              </div>
            </a>
          ))}
        </div>
      )
    )}

    {!loadError && tab === 'posters' && (
      graphics.length === 0 ? (
        <p class="reveal mt-8 text-white/60" style="transition-delay: 60ms">No posters on file yet.</p>
      ) : (
        <>
          <div class="reveal mb-6 max-w-sm" style="transition-delay: 60ms">
            <input
              type="search"
              id="media-search-posters"
              placeholder="Search posters…"
              class="w-full rounded-md border border-white/15 bg-white/5 px-3 py-2 text-white outline-none focus:border-brand-primary"
            />
          </div>
          <div id="media-posters-grid" class="reveal grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-4" style="transition-delay: 70ms">
            {graphics.map((g) => (
              <button
                type="button"
                data-lightbox
                data-lightbox-src={g.image_url}
                data-lightbox-alt={g.title}
                data-search={g.title.toLowerCase()}
                class="group overflow-hidden rounded-xl bg-white/5 text-left ring-1 ring-white/10 transition hover:ring-brand-primary/50"
              >
                <img
                  src={resizedImageUrl(g.image_url, { width: 400 })}
                  alt={g.title}
                  loading="lazy"
                  class="aspect-square w-full object-cover transition group-hover:brightness-110"
                />
                <p class="truncate p-2 text-xs font-semibold text-white/80">{g.title}</p>
              </button>
            ))}
          </div>
          <p id="media-search-empty-posters" class="reveal mt-8 hidden text-white/60">No matches.</p>
        </>
      )
    )}

    {!loadError && tab === 'replays' && (
      replays.length === 0 ? (
        <p class="reveal mt-8 text-white/60" style="transition-delay: 60ms">No replays on file yet.</p>
      ) : (
        <>
          <div class="reveal mb-6 max-w-sm" style="transition-delay: 60ms">
            <input
              type="search"
              id="media-search-replays"
              placeholder="Search replays…"
              class="w-full rounded-md border border-white/15 bg-white/5 px-3 py-2 text-white outline-none focus:border-brand-primary"
            />
          </div>
          <div id="media-replays-list" class="reveal flex flex-col divide-y divide-white/10 rounded-xl border border-white/10" style="transition-delay: 70ms">
            {replays.map((r) => (
              <a
                href={r.replay_url}
                target="_blank"
                rel="noopener noreferrer"
                data-search={r.track_name.toLowerCase()}
                class="flex flex-wrap items-center justify-between gap-2 px-4 py-3 transition hover:bg-white/[0.03]"
              >
                <span>
                  <span class="font-semibold">{r.track_name}</span>
                  <span class="ml-2 text-xs text-white/50">
                    {r.season_label && `${r.season_label} · `}
                    {formatDate(r.start_time)}
                    {r.race_number > 1 && ` · Race ${r.race_number}`}
                  </span>
                </span>
                <span class="text-xs font-semibold text-brand-primary">Download Replay</span>
              </a>
            ))}
          </div>
          <p id="media-search-empty-replays" class="reveal mt-8 hidden text-white/60">No matches.</p>
        </>
      )
    )}

    {!loadError && tab === 'meetups' && (
      meetupPins.length === 0 ? (
        <p class="reveal mt-8 text-white/60" style="transition-delay: 60ms">No meetups on file yet.</p>
      ) : (
        <>
          <div class="reveal mb-6 max-w-sm" style="transition-delay: 60ms">
            <input
              type="search"
              id="media-search-meetups"
              placeholder="Search meetups…"
              class="w-full rounded-md border border-white/15 bg-white/5 px-3 py-2 text-white outline-none focus:border-brand-primary"
            />
          </div>
          <div class="reveal overflow-hidden rounded-xl ring-1 ring-white/10" style="transition-delay: 70ms">
            <div id="meetup-map" class="h-[520px] w-full bg-white/5"></div>
          </div>
        </>
      )
    )}
  </section>

  <script>
    // Shared client-side search for the Videos, Posters, and Replays tabs —
    // each renders a plain grid or list of already-server-rendered
    // `[data-search]` items (never more than one of these search inputs
    // exists on a given page load, since `tab` is a real server-side query
    // param, not a client-side toggle), so this is just show/hide filtering,
    // same pattern as driver-stats.astro's own search box. Meetups gets its
    // own handler (see the Leaflet script below) since map markers can't be
    // hidden with a CSS class the way a grid/list item can.
    function initGridSearch(inputId: string, gridId: string, emptyId: string | null) {
      const input = document.getElementById(inputId) as HTMLInputElement | null;
      const grid = document.getElementById(gridId);
      if (!input || !grid) return;

      const items = grid.querySelectorAll<HTMLElement>('[data-search]');
      const empty = emptyId ? document.getElementById(emptyId) : null;

      input.addEventListener('input', () => {
        const term = input.value.trim().toLowerCase();
        let visibleCount = 0;
        items.forEach((item) => {
          const matches = !term || (item.dataset.search ?? '').includes(term);
          item.style.display = matches ? '' : 'none';
          if (matches) visibleCount += 1;
        });
        if (empty) empty.classList.toggle('hidden', visibleCount > 0);
      });
    }

    // Graphics tab's "Round Photo Albums" list (src/pages/media.astro,
    // above) renders each card with a plain placeholder div — there's no
    // synchronous thumbnail the way YouTube broadcasts get one, since
    // Flickr has no predictable per-album image URL (see
    // /api/photo-album-thumbnail's own doc comment). This fetches one small
    // JSON response per album and swaps the placeholder for a real <img>
    // if a thumbnail comes back; a Flickr link with no resolvable thumbnail
    // (or a non-Flickr album URL) just keeps its placeholder, same as a
    // broadcast video whose URL didn't parse. Re-running this against
    // already-swapped cards is harmless — replaceWith() removes the
    // placeholder from the DOM, so it simply won't match `[data-album-thumb]`
    // a second time.
    function initAlbumThumbnails() {
      document.querySelectorAll<HTMLElement>('[data-album-thumb]').forEach((el) => {
        const albumUrl = el.dataset.albumUrl;
        if (!albumUrl) return;
        fetch(`/api/photo-album-thumbnail?url=${encodeURIComponent(albumUrl)}`)
          .then((res) => (res.ok ? res.json() : null))
          .then((data: { thumbnailUrl?: string | null } | null) => {
            if (!data?.thumbnailUrl) return;
            const img = document.createElement('img');
            img.src = data.thumbnailUrl;
            img.alt = '';
            img.className = 'aspect-video w-full object-cover transition group-hover:brightness-110';
            el.replaceWith(img);
          })
          .catch((err) => console.error('Failed to load photo album thumbnail:', err));
      });
    }

    document.addEventListener('astro:page-load', () => {
      initGridSearch('media-search-videos', 'media-search-grid', 'media-search-empty-videos');
      initGridSearch('media-search-posters', 'media-posters-grid', 'media-search-empty-posters');
      initGridSearch('media-search-replays', 'media-replays-list', 'media-search-empty-replays');
      initAlbumThumbnails();
    });
  </script>

  {tab === 'meetups' && meetupPins.length > 0 && (
    <script define:vars={{ meetupPins }}>
      // PLAIN JAVASCRIPT ONLY BELOW — no type annotations, no `as Foo`
      // casts, no other TypeScript-only syntax. `define:vars` scripts are
      // inlined verbatim (that's how `meetupPins` gets into the browser at
      // all) rather than run through Astro/Vite's TS-stripping step the way
      // a normal <script> tag is, so any TS syntax here ships raw to the
      // browser and throws a SyntaxError on load — which was the actual
      // cause of "the Meetups map never loads" (found via a real page
      // load's console: `SyntaxError: Missing initializer in const
      // declaration`, from `const markerEntries: {...}[] = []` and
      // `... as HTMLInputElement | null` below, both fixed to plain JS). A
      // parse error here means the WHOLE script never runs — including the
      // astro:page-load listener at the bottom — so the map silently just
      // never initializes; there's no console error visible to a normal
      // visitor, only in devtools.
      //
      // Leaflet is loaded dynamically from here, NOT via a static
      // <link>/<script src> pair sitting in the page markup — this tab's
      // whole block (including those tags) only ever exists in the DOM
      // while `tab=meetups`, and the site navigates between tabs through
      // Astro's client router (ViewTransitions) rather than a hard page
      // load. A router-driven swap inserts new content via the DOM rather
      // than the browser's native HTML parser, and a DYNAMICALLY inserted
      // <script src> always loads asynchronously with no guaranteed
      // ordering relative to a plain inline script right after it — so the
      // old static <script src="leaflet.min.js"> next to this inline
      // script had no guarantee of having finished (or even started) by
      // the time this ran, `typeof L` could easily still be 'undefined',
      // and initMeetupMap silently bailed with nothing to retry it — the
      // exact "endlessly loading, never loads" bug this replaced. Loading
      // it explicitly here and awaiting its real `load` event removes that
      // race entirely; the browser still caches/dedupes the request itself,
      // so this is a no-op over the network on every visit after the
      // first.
      let leafletLoadPromise;
      function loadLeaflet() {
        // @ts-ignore - global the Leaflet script defines once loaded
        if (typeof L !== 'undefined') return Promise.resolve();
        if (leafletLoadPromise) return leafletLoadPromise;
        leafletLoadPromise = new Promise((resolve, reject) => {
          if (!document.querySelector('link[data-leaflet-css]')) {
            const link = document.createElement('link');
            link.rel = 'stylesheet';
            link.href = 'https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/leaflet.min.css';
            link.dataset.leafletCss = 'true';
            document.head.appendChild(link);
          }
          const existing = document.querySelector('script[data-leaflet-js]');
          if (existing) {
            // Already requested by an earlier visit to this tab — if it's
            // still mid-flight, ride its own load/error events; if it
            // already finished, `L` is set and the check above would have
            // returned already, so reaching here means it's still pending.
            existing.addEventListener('load', () => resolve(undefined));
            existing.addEventListener('error', () => reject(new Error('Failed to load Leaflet')));
            return;
          }
          const script = document.createElement('script');
          script.src = 'https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/leaflet.min.js';
          script.dataset.leafletJs = 'true';
          script.onload = () => resolve(undefined);
          script.onerror = () => reject(new Error('Failed to load Leaflet'));
          document.head.appendChild(script);
        });
        return leafletLoadPromise;
      }

      // Pure client-side rendering of server-provided pin data once Leaflet
      // is ready — no network call of its own beyond that, so (per
      // pageProgress.ts's own convention) this doesn't drive the global
      // loading bar; the page navigation that got here already did.
      function initMeetupMap() {
        const el = document.getElementById('meetup-map');
        if (!el || el.dataset.mapInit === 'true') return;
        el.dataset.mapInit = 'true';

        loadLeaflet()
          .then(() => {
            // @ts-ignore
            const map = L.map(el).setView([39.8283, -98.5795], 4); // continental-US center
            // @ts-ignore
            L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
              attribution: '&copy; OpenStreetMap contributors',
              maxZoom: 18,
            }).addTo(map);

            // Kept alongside each pin's own searchable text so the search
            // box below can add/remove markers from the map on the fly —
            // Leaflet markers have no built-in show/hide, so filtering
            // means literally adding/removing them from the map rather
            // than toggling a CSS class the way the plain-grid search
            // (initGridSearch, further down this file) does for
            // Videos/Graphics.
            const markerEntries = [];
            meetupPins.forEach((pin) => {
              // The image is a lightbox trigger (see src/scripts/
              // lightbox.ts) rather than a plain <img> — that script's
              // click listener is delegated to <body>, so it picks up this
              // popup's markup fine even though Leaflet injects it into the
              // DOM long after astro:page-load already fired.
              const popupHtml = `
                <div style="min-width:160px">
                  ${pin.photoUrl ? `<img src="${pin.photoUrl}" alt="${pin.title}" data-lightbox data-lightbox-src="${pin.photoUrl}" data-lightbox-alt="${pin.title}" style="width:100%;height:100px;object-fit:cover;border-radius:6px;margin-bottom:6px;cursor:zoom-in" />` : ''}
                  <strong>${pin.title}</strong>
                  ${pin.locationLabel || pin.date ? `<div style="font-size:12px;opacity:0.7;margin-top:2px">${[pin.locationLabel, pin.date].filter(Boolean).join(' · ')}</div>` : ''}
                  ${pin.drivers.length > 0 ? `
                    <div style="font-size:11px;text-transform:uppercase;letter-spacing:0.05em;opacity:0.5;margin-top:8px">Attended</div>
                    <ul style="margin:2px 0 0;padding:0;list-style:none;font-size:12px;line-height:1.5">
                      ${pin.drivers.map((name) => `<li>${name}</li>`).join('')}
                    </ul>
                  ` : ''}
                </div>
              `;
              // @ts-ignore
              const marker = L.marker([pin.lat, pin.lng]).addTo(map).bindPopup(popupHtml);
              markerEntries.push({ marker, searchText: `${pin.title} ${pin.locationLabel ?? ''}`.toLowerCase() });
            });

            const searchInput = document.getElementById('media-search-meetups');
            if (searchInput && !searchInput.dataset.meetupSearchBound) {
              searchInput.dataset.meetupSearchBound = 'true';
              searchInput.addEventListener('input', () => {
                const term = searchInput.value.trim().toLowerCase();
                markerEntries.forEach(({ marker, searchText }) => {
                  const matches = !term || searchText.includes(term);
                  const onMap = map.hasLayer(marker);
                  if (matches && !onMap) marker.addTo(map);
                  if (!matches && onMap) map.removeLayer(marker);
                });
              });
            }
          })
          .catch((err) => {
            // Allow a later retry (e.g. the next time this tab loads) rather
            // than permanently latching the "already initialized" guard on
            // a failed attempt.
            el.dataset.mapInit = 'false';
            console.error('Failed to load meetup map:', err);
          });
      }

      document.addEventListener('astro:page-load', initMeetupMap);
    </script>
  )}
</Layout>
