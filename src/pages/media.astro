---
export const prerender = false;

import Layout from '../layouts/Layout.astro';
import PageBanner from '../components/PageBanner.astro';
import { resolveSupabaseEnv, getPageBanners } from '../lib/supabase';
import { bannerUrlFor } from '../lib/pageBanners';

// Shell-then-skeleton split (same pattern as results.astro / standings.astro):
// this file only fetches the page banner and paints the heading plus a
// loading skeleton right away. The tab bar and the tab's content (videos,
// photos, posters, replays, meetups) live in media/fragment.astro and are
// fetched client-side once this shell has painted. The page's scripts (grid
// search, album thumbnails, the meetup map) stay here, bound per-element at
// astro:page-load, because a <script> inside fetched HTML never executes.
const supabaseEnv = resolveSupabaseEnv(Astro.locals);

let bannerUrl: string | null = null;
try {
  bannerUrl = bannerUrlFor(await getPageBanners(supabaseEnv), 'media');
} catch (err) {
  console.error('Failed to load page banner:', err);
}

Astro.response.headers.set('Cache-Control', 'public, s-maxage=60, stale-while-revalidate=300');
---

<Layout title="Media" description="Broadcasts, cinematics, briefings, track guides, race photos, posters, and meetups from Alpha Touring Challenge.">
  <section class="relative mx-auto max-w-5xl overflow-hidden px-6 pb-24 pt-8">
    <PageBanner imageUrl={bannerUrl} />
    <h1 class="reveal font-display text-2xl sm:text-5xl">Media</h1>

    <div data-media-results data-fragment-url={`/media/fragment${Astro.url.search}`}>
      <div class="mt-8" aria-live="polite" aria-busy="true">
        <span class="sr-only">Loading media…</span>
        <div class="flex flex-wrap gap-3">
          <div class="h-9 w-36 animate-pulse rounded-md border border-white/10 bg-white/[0.03]"></div>
          <div class="h-9 w-36 animate-pulse rounded-md border border-white/10 bg-white/[0.03]"></div>
        </div>
        <div class="mt-6 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          <div class="aspect-video animate-pulse rounded-xl border border-white/10 bg-white/[0.03]"></div>
          <div class="aspect-video animate-pulse rounded-xl border border-white/10 bg-white/[0.03]"></div>
          <div class="aspect-video animate-pulse rounded-xl border border-white/10 bg-white/[0.03]"></div>
        </div>
      </div>
    </div>
  </section>

  <script>
    // Shared client-side search for the Videos, Posters, and Replays tabs —
    // each renders a plain grid or list of already-server-rendered
    // `[data-search]` items (never more than one of these search inputs
    // exists on a given page load, since `tab` is a real server-side query
    // param, not a client-side toggle), so this is just show/hide filtering,
    // same pattern as driver-stats.astro's own search box. Meetups gets its
    // own handler (see the dot-map script below) since map pins can't be
    // hidden with a CSS class the way a grid/list item can.
    function initGridSearch(inputId: string, gridId: string, emptyId: string | null) {
      const input = document.getElementById(inputId) as HTMLInputElement | null;
      const grid = document.getElementById(gridId);
      if (!input || !grid) return;

      const items = grid.querySelectorAll<HTMLElement>('[data-search]');
      const empty = emptyId ? document.getElementById(emptyId) : null;

      input.addEventListener('input', () => {
        const term = input.value.trim().toLowerCase();
        let visibleCount = 0;
        items.forEach((item) => {
          const matches = !term || (item.dataset.search ?? '').includes(term);
          item.style.display = matches ? '' : 'none';
          if (matches) visibleCount += 1;
        });
        if (empty) empty.classList.toggle('hidden', visibleCount > 0);
      });
    }

    // Graphics tab's "Round Photo Albums" list (src/pages/media.astro,
    // above) renders each card with a plain placeholder div — there's no
    // synchronous thumbnail the way YouTube broadcasts get one, since
    // Flickr has no predictable per-album image URL (see
    // /api/photo-album-thumbnail's own doc comment). This fetches one small
    // JSON response per album and swaps the placeholder for a real <img>
    // if a thumbnail comes back; a Flickr link with no resolvable thumbnail
    // (or a non-Flickr album URL) just keeps its placeholder, same as a
    // broadcast video whose URL didn't parse. Re-running this against
    // already-swapped cards is harmless — replaceWith() removes the
    // placeholder from the DOM, so it simply won't match `[data-album-thumb]`
    // a second time.
    function initAlbumThumbnails() {
      document.querySelectorAll<HTMLElement>('[data-album-thumb]').forEach((el) => {
        const albumUrl = el.dataset.albumUrl;
        if (!albumUrl) return;
        fetch(`/api/photo-album-thumbnail?url=${encodeURIComponent(albumUrl)}`)
          .then((res) => (res.ok ? res.json() : null))
          .then((data: { thumbnailUrl?: string | null } | null) => {
            if (!data?.thumbnailUrl) return;
            const img = document.createElement('img');
            img.src = data.thumbnailUrl;
            img.alt = '';
            img.className = 'aspect-video w-full object-cover transition group-hover:brightness-110';
            el.replaceWith(img);
          })
          .catch((err) => console.error('Failed to load photo album thumbnail:', err));
      });
    }

    document.addEventListener('astro:page-load', () => {
      initGridSearch('media-search-videos', 'media-search-grid', 'media-search-empty-videos');
      initGridSearch('media-search-posters', 'media-posters-grid', 'media-search-empty-posters');
      initGridSearch('media-search-replays', 'media-replays-list', 'media-search-empty-replays');
      initAlbumThumbnails();
    });
  </script>

  <script>
    // Meetups map: the shared dot-matrix world map (src/scripts/dotMap.ts), the
    // same one the Calendar's Map view uses — no tile server or third-party script.
    // Pins come from the fragment's #meetup-pins JSON element. Hovering a pin shows
    // a short tooltip; clicking one lists its meetup(s) under the map (photo,
    // location and date, who attended). The search box above filters the pins.
    //
    // This tab's content is swapped in by the client router, so binding happens on
    // astro:page-load and is guarded per element; a failed attempt releases the
    // guard so the next page-load can retry.
    interface MeetupPin {
      title: string;
      locationLabel: string | null;
      date: string | null;
      photoUrl: string | null;
      lat: number;
      lng: number;
      drivers: string[];
    }

    function initMeetupMap() {
      const box = document.getElementById('meetup-map');
      const pinsEl = document.getElementById('meetup-pins');
      const svg = box?.querySelector<SVGSVGElement>('[data-meetup-svg]');
      const tip = box?.querySelector<HTMLElement>('[data-meetup-tip]');
      const detail = document.getElementById('meetup-detail');
      if (!box || !pinsEl || !svg || !tip || !detail || box.dataset.mapInit === 'true') return;
      box.dataset.mapInit = 'true';

      const pins: MeetupPin[] = JSON.parse(pinsEl.textContent ?? '[]');
      const searchInput = document.getElementById('media-search-meetups') as HTMLInputElement | null;
      const matches = (p: MeetupPin) => {
        const term = searchInput?.value.trim().toLowerCase() ?? '';
        return !term || `${p.title} ${p.locationLabel ?? ''}`.toLowerCase().includes(term);
      };
      const sub = (p: MeetupPin) => [p.locationLabel, p.date].filter(Boolean).join(' · ');
      let selected: string[] | null = null;
      let map: import('../scripts/dotMap').DotMap | null = null;

      function showDetail() {
        const chosen = pins.map((p, i) => ({ p, i })).filter(({ p, i }) => selected?.includes(String(i)) && matches(p));
        detail!.replaceChildren();
        if (chosen.length === 0) {
          selected = null;
          map?.setSelected(null);
          detail!.classList.add('hidden');
          return;
        }
        detail!.classList.remove('hidden');
        const list = document.createElement('div');
        list.className = 'grid gap-4 sm:grid-cols-2';
        for (const { p } of chosen) {
          const card = document.createElement('article');
          card.className = 'overflow-hidden rounded-xl border border-white/10 bg-brand-ink';
          // The image is a lightbox trigger (see src/scripts/lightbox.ts); its click listener is delegated to <body>, so it works on nodes added later.
          if (typeof p.photoUrl === 'string' && /^https?:\/\//i.test(p.photoUrl)) {
            const img = document.createElement('img');
            img.src = p.photoUrl;
            img.alt = p.title;
            img.loading = 'lazy';
            img.className = 'h-44 w-full cursor-zoom-in object-cover';
            img.setAttribute('data-lightbox', '');
            img.dataset.lightboxSrc = p.photoUrl;
            img.dataset.lightboxAlt = p.title;
            card.appendChild(img);
          }
          const body = document.createElement('div');
          body.className = 'p-4';
          const h = document.createElement('h3');
          h.className = 'font-semibold';
          h.textContent = p.title;
          body.appendChild(h);
          if (sub(p)) {
            const s = document.createElement('p');
            s.className = 'mt-1 text-sm text-white/50';
            s.textContent = sub(p);
            body.appendChild(s);
          }
          if (p.drivers.length > 0) {
            const l = document.createElement('p');
            l.className = 'mt-3 text-xs font-semibold uppercase tracking-wide text-white/40';
            l.textContent = 'Attended';
            const ul = document.createElement('ul');
            ul.className = 'mt-1 text-sm text-white/70';
            p.drivers.forEach((name) => {
              const li = document.createElement('li');
              li.textContent = name;
              ul.appendChild(li);
            });
            body.append(l, ul);
          }
          card.appendChild(body);
          list.appendChild(card);
        }
        detail!.appendChild(list);
      }

      import('../scripts/dotMap')
        .then(({ createDotMap }) =>
          createDotMap<number>({
            box,
            svg,
            tip,
            getItems: () =>
              pins
                .map((p, i) => ({ p, i }))
                .filter(({ p }) => matches(p))
                .map(({ p, i }) => ({ id: String(i), lat: p.lat, lng: p.lng, weight: 1, color: 'var(--m-pin-endurance)', data: i })),
            tooltip: (c, el) => {
              const head = document.createElement('div');
              head.className = 'font-semibold';
              head.textContent = c.items.length > 1 ? `${c.items.length} meetups` : pins[c.items[0].data].title;
              el.appendChild(head);
              if (c.items.length === 1) {
                if (sub(pins[c.items[0].data])) {
                  const s = document.createElement('div');
                  s.style.opacity = '0.6';
                  s.textContent = sub(pins[c.items[0].data]);
                  el.appendChild(s);
                }
              } else {
                const list = document.createElement('div');
                list.style.marginTop = '4px';
                c.items.slice(0, 5).forEach((it) => {
                  const line = document.createElement('div');
                  line.textContent = pins[it.data].title;
                  list.appendChild(line);
                });
                if (c.items.length > 5) {
                  const more = document.createElement('div');
                  more.style.opacity = '0.6';
                  more.textContent = `+${c.items.length - 5} more`;
                  list.appendChild(more);
                }
                el.appendChild(list);
              }
            },
            onActivate: (c) => {
              const ids = c.items.map((i) => i.id);
              const same = selected && selected.length === ids.length && ids.every((x) => selected!.includes(x));
              selected = same ? null : ids;
              map?.setSelected(selected);
              showDetail();
              if (selected) detail.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
            },
          })
        )
        .then((m) => {
          map = m;
          if (searchInput && !searchInput.dataset.meetupSearchBound) {
            searchInput.dataset.meetupSearchBound = 'true';
            searchInput.addEventListener('input', () => {
              map?.refresh();
              if (selected) showDetail();
            });
          }
        })
        .catch((err) => {
          // Allow a later retry rather than permanently latching the guard on a failed attempt.
          box.dataset.mapInit = 'false';
          console.error('Failed to load meetup map:', err);
        });
    }

    document.addEventListener('astro:page-load', initMeetupMap);
  </script>
</Layout>

<script>
  // Shell-then-skeleton: fetches the media fragment (the expensive data work)
  // client-side once this shell has already painted — same pattern as
  // results.astro / standings.astro; see the matching fragment.astro for the
  // full explanation.
  function initMediaResults() {
    const container = document.querySelector<HTMLElement>('[data-media-results]');
    const url = container?.dataset.fragmentUrl;
    if (!container || !url) return;
    // Cleared immediately so the synthetic astro:page-load dispatched below
    // doesn't see this same data-fragment-url and fetch it all over again.
    delete container.dataset.fragmentUrl;

    fetch(url)
      .then((res) => {
        if (!res.ok) throw new Error(`media fragment request failed (${res.status})`);
        return res.text();
      })
      .then((html) => {
        container.innerHTML = html;
        // reveal.ts only observes `.reveal` elements present at page-load
        // time; this content lands later, so mark it visible right away.
        container.querySelectorAll('.reveal').forEach((el) => el.classList.add('is-visible'));
        // Sortable tables, row expanders and this page's own scripts bind
        // against whatever exists at astro:page-load, so re-dispatch it now
        // that the real content is in place.
        document.dispatchEvent(new Event('astro:page-load'));
      })
      .catch((err) => {
        console.error('Failed to load media:', err);
        container.innerHTML = '<p class="mt-10 text-white/60">Couldn’t load this page right now — try refreshing.</p>';
      });
  }

  document.addEventListener('astro:page-load', initMediaResults);
</script>
