---
export const prerender = false;

import Layout from '../layouts/Layout.astro';
import PageBanner from '../components/PageBanner.astro';
import { resolveSupabaseEnv, getPageBanners } from '../lib/supabase';
import { bannerUrlFor } from '../lib/pageBanners';

// Shell-then-skeleton split (same pattern as results.astro / standings.astro):
// this file only fetches the page banner and paints the heading plus a
// loading skeleton right away. The tab bar and the tab's content (videos,
// photos, posters, replays, meetups) live in media/fragment.astro and are
// fetched client-side once this shell has painted. The page's scripts (grid
// search, album thumbnails, the meetup map) stay here, bound per-element at
// astro:page-load, because a <script> inside fetched HTML never executes.
const supabaseEnv = resolveSupabaseEnv(Astro.locals);

let bannerUrl: string | null = null;
try {
  bannerUrl = bannerUrlFor(await getPageBanners(supabaseEnv), 'media');
} catch (err) {
  console.error('Failed to load page banner:', err);
}

Astro.response.headers.set('Cache-Control', 'public, s-maxage=60, stale-while-revalidate=300');
---

<Layout title="Media" description="Broadcasts, cinematics, briefings, track guides, race photos, posters, and meetups from Alpha Touring Challenge.">
  <section class="relative mx-auto max-w-5xl overflow-hidden px-6 pb-24 pt-8">
    <PageBanner imageUrl={bannerUrl} />
    <h1 class="reveal font-display text-2xl sm:text-5xl">Media</h1>

    <div data-media-results data-fragment-url={`/media/fragment${Astro.url.search}`}>
      <div class="mt-8" aria-live="polite" aria-busy="true">
        <span class="sr-only">Loading media…</span>
        <div class="flex flex-wrap gap-2">
          <div class="h-9 w-24 animate-pulse rounded-lg border border-white/10 bg-white/[0.03]"></div>
          <div class="h-9 w-28 animate-pulse rounded-lg border border-white/10 bg-white/[0.03]"></div>
          <div class="h-9 w-24 animate-pulse rounded-lg border border-white/10 bg-white/[0.03]"></div>
          <div class="h-9 w-24 animate-pulse rounded-lg border border-white/10 bg-white/[0.03]"></div>
          <div class="h-9 w-24 animate-pulse rounded-lg border border-white/10 bg-white/[0.03]"></div>
        </div>
        <div class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          <div class="aspect-video animate-pulse rounded-xl border border-white/10 bg-white/[0.03]"></div>
          <div class="aspect-video animate-pulse rounded-xl border border-white/10 bg-white/[0.03]"></div>
          <div class="aspect-video animate-pulse rounded-xl border border-white/10 bg-white/[0.03]"></div>
        </div>
      </div>
    </div>
  </section>

  <script>
    // Shared client-side search for the Videos, Posters, and Replays tabs —
    // each renders a plain grid or list of already-server-rendered
    // `[data-search]` items (never more than one of these search inputs
    // exists on a given page load, since `tab` is a real server-side query
    // param, not a client-side toggle), so this is just show/hide filtering,
    // same pattern as driver-stats.astro's own search box. Meetups gets its
    // own handler (see the Leaflet script below) since map markers can't be
    // hidden with a CSS class the way a grid/list item can.
    function initGridSearch(inputId: string, gridId: string, emptyId: string | null) {
      const input = document.getElementById(inputId) as HTMLInputElement | null;
      const grid = document.getElementById(gridId);
      if (!input || !grid) return;

      const items = grid.querySelectorAll<HTMLElement>('[data-search]');
      const empty = emptyId ? document.getElementById(emptyId) : null;

      input.addEventListener('input', () => {
        const term = input.value.trim().toLowerCase();
        let visibleCount = 0;
        items.forEach((item) => {
          const matches = !term || (item.dataset.search ?? '').includes(term);
          item.style.display = matches ? '' : 'none';
          if (matches) visibleCount += 1;
        });
        if (empty) empty.classList.toggle('hidden', visibleCount > 0);
      });
    }

    // Graphics tab's "Round Photo Albums" list (src/pages/media.astro,
    // above) renders each card with a plain placeholder div — there's no
    // synchronous thumbnail the way YouTube broadcasts get one, since
    // Flickr has no predictable per-album image URL (see
    // /api/photo-album-thumbnail's own doc comment). This fetches one small
    // JSON response per album and swaps the placeholder for a real <img>
    // if a thumbnail comes back; a Flickr link with no resolvable thumbnail
    // (or a non-Flickr album URL) just keeps its placeholder, same as a
    // broadcast video whose URL didn't parse. Re-running this against
    // already-swapped cards is harmless — replaceWith() removes the
    // placeholder from the DOM, so it simply won't match `[data-album-thumb]`
    // a second time.
    function initAlbumThumbnails() {
      document.querySelectorAll<HTMLElement>('[data-album-thumb]').forEach((el) => {
        const albumUrl = el.dataset.albumUrl;
        if (!albumUrl) return;
        fetch(`/api/photo-album-thumbnail?url=${encodeURIComponent(albumUrl)}`)
          .then((res) => (res.ok ? res.json() : null))
          .then((data: { thumbnailUrl?: string | null } | null) => {
            if (!data?.thumbnailUrl) return;
            const img = document.createElement('img');
            img.src = data.thumbnailUrl;
            img.alt = '';
            img.className = 'aspect-video w-full object-cover transition group-hover:brightness-110';
            el.replaceWith(img);
          })
          .catch((err) => console.error('Failed to load photo album thumbnail:', err));
      });
    }

    document.addEventListener('astro:page-load', () => {
      initGridSearch('media-search-videos', 'media-search-grid', 'media-search-empty-videos');
      initGridSearch('media-search-posters', 'media-posters-grid', 'media-search-empty-posters');
      initGridSearch('media-search-replays', 'media-replays-list', 'media-search-empty-replays');
      initAlbumThumbnails();
    });
  </script>

  <script>

// (This used to be a define:vars script, which is why it was plain JS only. It now lives in a normal module script and reads its pins from the fragment's #meetup-pins JSON element, so TypeScript is fine again.)
// formerly: PLAIN JAVASCRIPT ONLY BELOW — no type annotations, no `as Foo`
// casts, no other TypeScript-only syntax. `define:vars` scripts are
// inlined verbatim (that's how `meetupPins` gets into the browser at
// all) rather than run through Astro/Vite's TS-stripping step the way
// a normal <script> tag is, so any TS syntax here ships raw to the
// browser and throws a SyntaxError on load — which was the actual
// cause of "the Meetups map never loads" (found via a real page
// load's console: `SyntaxError: Missing initializer in const
// declaration`, from `const markerEntries: {...}[] = []` and
// `... as HTMLInputElement | null` below, both fixed to plain JS). A
// parse error here means the WHOLE script never runs — including the
// astro:page-load listener at the bottom — so the map silently just
// never initializes; there's no console error visible to a normal
// visitor, only in devtools.
//
// Leaflet is loaded dynamically from here, NOT via a static
// <link>/<script src> pair sitting in the page markup — this tab's
// whole block (including those tags) only ever exists in the DOM
// while `tab=meetups`, and the site navigates between tabs through
// Astro's client router (ViewTransitions) rather than a hard page
// load. A router-driven swap inserts new content via the DOM rather
// than the browser's native HTML parser, and a DYNAMICALLY inserted
// <script src> always loads asynchronously with no guaranteed
// ordering relative to a plain inline script right after it — so the
// old static <script src="leaflet.min.js"> next to this inline
// script had no guarantee of having finished (or even started) by
// the time this ran, `typeof L` could easily still be 'undefined',
// and initMeetupMap silently bailed with nothing to retry it — the
// exact "endlessly loading, never loads" bug this replaced. Loading
// it explicitly here and awaiting its real `load` event removes that
// race entirely; the browser still caches/dedupes the request itself,
// so this is a no-op over the network on every visit after the
// first.
interface MeetupPin {
  title: string;
  locationLabel: string | null;
  date: string | null;
  photoUrl: string | null;
  lat: number;
  lng: number;
  drivers: string[];
}

let leafletLoadPromise: Promise<void> | undefined;
function loadLeaflet() {
  // @ts-ignore - global the Leaflet script defines once loaded
  if (typeof L !== 'undefined') return Promise.resolve();
  if (leafletLoadPromise) return leafletLoadPromise;
  leafletLoadPromise = new Promise<void>((resolve, reject) => {
    if (!document.querySelector('link[data-leaflet-css]')) {
      const link = document.createElement('link');
      link.rel = 'stylesheet';
      link.href = 'https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/leaflet.min.css';
      link.dataset.leafletCss = 'true';
      document.head.appendChild(link);
    }
    const existing = document.querySelector('script[data-leaflet-js]');
    if (existing) {
      // Already requested by an earlier visit to this tab — if it's
      // still mid-flight, ride its own load/error events; if it
      // already finished, `L` is set and the check above would have
      // returned already, so reaching here means it's still pending.
      existing.addEventListener('load', () => resolve());
      existing.addEventListener('error', () => reject(new Error('Failed to load Leaflet')));
      return;
    }
    const script = document.createElement('script');
    script.src = 'https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/leaflet.min.js';
    script.dataset.leafletJs = 'true';
    script.onload = () => resolve();
    script.onerror = () => reject(new Error('Failed to load Leaflet'));
    document.head.appendChild(script);
  });
  return leafletLoadPromise;
}

// Pure client-side rendering of server-provided pin data once Leaflet
// is ready — no network call of its own beyond that, so (per
// pageProgress.ts's own convention) this doesn't drive the global
// loading bar; the page navigation that got here already did.
function initMeetupMap() {
  const el = document.getElementById('meetup-map');
  const pinsEl = document.getElementById('meetup-pins');
  if (!el || !pinsEl || el.dataset.mapInit === 'true') return;
  el.dataset.mapInit = 'true';
  const meetupPins: MeetupPin[] = JSON.parse(pinsEl.textContent ?? '[]');

  loadLeaflet()
    .then(() => {
      // @ts-ignore
      const map = L.map(el).setView([39.8283, -98.5795], 4); // continental-US center
      // @ts-ignore
      L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
        attribution: '&copy; OpenStreetMap contributors',
        maxZoom: 18,
      }).addTo(map);

      // Kept alongside each pin's own searchable text so the search
      // box below can add/remove markers from the map on the fly —
      // Leaflet markers have no built-in show/hide, so filtering
      // means literally adding/removing them from the map rather
      // than toggling a CSS class the way the plain-grid search
      // (initGridSearch, further down this file) does for
      // Videos/Graphics.
      const markerEntries: { marker: any; searchText: string }[] = [];
      meetupPins.forEach((pin) => {
        // The image is a lightbox trigger (see src/scripts/
        // lightbox.ts) rather than a plain <img> — that script's
        // click listener is delegated to <body>, so it picks up this
        // popup's markup fine even though Leaflet injects it into the
        // DOM long after astro:page-load already fired.
        // Everything interpolated below is escaped — pin fields come from
        // the database (admin-entered, but still data, never markup).
        const esc = (v: unknown) =>
          String(v ?? '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;').replace(/'/g, '&#39;');
        const safePhoto = typeof pin.photoUrl === 'string' && /^https?:\/\//i.test(pin.photoUrl) ? pin.photoUrl : '';
        const popupHtml = `
          <div style="min-width:160px">
            ${safePhoto ? `<img src="${esc(safePhoto)}" alt="${esc(pin.title)}" data-lightbox data-lightbox-src="${esc(safePhoto)}" data-lightbox-alt="${esc(pin.title)}" style="width:100%;height:100px;object-fit:cover;border-radius:3px;margin-bottom:6px;cursor:zoom-in" />` : ''}
            <strong>${esc(pin.title)}</strong>
            ${pin.locationLabel || pin.date ? `<div style="font-size:12px;opacity:0.7;margin-top:2px">${esc([pin.locationLabel, pin.date].filter(Boolean).join(' · '))}</div>` : ''}
            ${pin.drivers.length > 0 ? `
              <div style="font-size:11px;text-transform:uppercase;letter-spacing:0.05em;opacity:0.5;margin-top:8px">Attended</div>
              <ul style="margin:2px 0 0;padding:0;list-style:none;font-size:12px;line-height:1.5">
                ${pin.drivers.map((name: string) => `<li>${esc(name)}</li>`).join('')}
              </ul>
            ` : ''}
          </div>
        `;
        // @ts-ignore
        const marker = L.marker([pin.lat, pin.lng]).addTo(map).bindPopup(popupHtml);
        markerEntries.push({ marker, searchText: `${pin.title} ${pin.locationLabel ?? ''}`.toLowerCase() });
      });

      const searchInput = document.getElementById('media-search-meetups') as HTMLInputElement | null;
      if (searchInput && !searchInput.dataset.meetupSearchBound) {
        searchInput.dataset.meetupSearchBound = 'true';
        searchInput.addEventListener('input', () => {
          const term = searchInput.value.trim().toLowerCase();
          markerEntries.forEach(({ marker, searchText }) => {
            const matches = !term || searchText.includes(term);
            const onMap = map.hasLayer(marker);
            if (matches && !onMap) marker.addTo(map);
            if (!matches && onMap) map.removeLayer(marker);
          });
        });
      }
    })
    .catch((err) => {
      // Allow a later retry (e.g. the next time this tab loads) rather
      // than permanently latching the "already initialized" guard on
      // a failed attempt.
      el.dataset.mapInit = 'false';
      console.error('Failed to load meetup map:', err);
    });
}

document.addEventListener('astro:page-load', initMeetupMap);
  </script>
</Layout>

<script>
  // Shell-then-skeleton: fetches the media fragment (the expensive data work)
  // client-side once this shell has already painted — same pattern as
  // results.astro / standings.astro; see the matching fragment.astro for the
  // full explanation.
  function initMediaResults() {
    const container = document.querySelector<HTMLElement>('[data-media-results]');
    const url = container?.dataset.fragmentUrl;
    if (!container || !url) return;
    // Cleared immediately so the synthetic astro:page-load dispatched below
    // doesn't see this same data-fragment-url and fetch it all over again.
    delete container.dataset.fragmentUrl;

    fetch(url)
      .then((res) => {
        if (!res.ok) throw new Error(`media fragment request failed (${res.status})`);
        return res.text();
      })
      .then((html) => {
        container.innerHTML = html;
        // reveal.ts only observes `.reveal` elements present at page-load
        // time; this content lands later, so mark it visible right away.
        container.querySelectorAll('.reveal').forEach((el) => el.classList.add('is-visible'));
        // Sortable tables, row expanders and this page's own scripts bind
        // against whatever exists at astro:page-load, so re-dispatch it now
        // that the real content is in place.
        document.dispatchEvent(new Event('astro:page-load'));
      })
      .catch((err) => {
        console.error('Failed to load media:', err);
        container.innerHTML = '<p class="mt-10 text-white/60">Couldn’t load this page right now — try refreshing.</p>';
      });
  }

  document.addEventListener('astro:page-load', initMediaResults);
</script>
