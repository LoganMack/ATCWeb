---
export const prerender = false;

import Layout from '../layouts/Layout.astro';
import PageBanner from '../components/PageBanner.astro';
import {
  resolveSupabaseEnv,
  getAllMediaGraphics,
  getMediaVideosByCategory,
  getAllMediaMeetups,
  getAllCircuitLayouts,
  getAllTrackGuides,
  getCircuits,
  getPageBanners,
  formatDate,
  displayLayoutName,
  youtubeThumbnailUrl,
  type MediaVideoCategory,
} from '../lib/supabase';
import { getAllBroadcastVideos, getAllPhotoAlbumLinks, type BroadcastVideo, type PhotoAlbumLink } from '../lib/results';
import { bannerUrlFor } from '../lib/pageBanners';

const supabaseEnv = resolveSupabaseEnv(Astro.locals);

const TABS = ['videos', 'graphics', 'meetups'] as const;
type Tab = (typeof TABS)[number];
const tabParam = Astro.url.searchParams.get('tab');
const tab: Tab = (TABS as readonly string[]).includes(tabParam ?? '') ? (tabParam as Tab) : 'videos';

const VIDEO_FILTERS = ['broadcasts', 'cinematic', 'educational', 'trackguide', 'other'] as const;
type VideoFilter = (typeof VIDEO_FILTERS)[number];
const filterParam = Astro.url.searchParams.get('filter');
const filter: VideoFilter = (VIDEO_FILTERS as readonly string[]).includes(filterParam ?? '') ? (filterParam as VideoFilter) : 'broadcasts';

let bannerUrl: string | null = null;
try {
  bannerUrl = bannerUrlFor(await getPageBanners(supabaseEnv), 'media');
} catch (err) {
  console.error('Failed to load page banner:', err);
}

let loadError = false;

let broadcastVideos: BroadcastVideo[] = [];
let categoryVideos: Awaited<ReturnType<typeof getMediaVideosByCategory>> = [];
// Track Guide is two-level now that a layout can have any number of guides
// (0053_track_guides.sql) — trackGuideLayouts is the "pick a layout" list
// (one card per layout with >=1 guide); selectedLayout/trackGuidesForLayout
// are populated instead, from the same query results, once `?layout=` names
// one of them.
let trackGuideLayouts: { layoutId: string; circuitName: string; layoutName: string; guideCount: number; firstUrl: string }[] = [];
let selectedLayout: { circuitName: string; layoutName: string } | null = null;
let trackGuidesForLayout: { title: string | null; url: string }[] = [];
let graphics: Awaited<ReturnType<typeof getAllMediaGraphics>> = [];
let photoAlbums: PhotoAlbumLink[] = [];
let meetups: Awaited<ReturnType<typeof getAllMediaMeetups>> = [];

try {
  if (tab === 'videos') {
    if (filter === 'broadcasts') {
      broadcastVideos = await getAllBroadcastVideos(supabaseEnv);
    } else if (filter === 'trackguide') {
      const [layouts, circuits, allGuides] = await Promise.all([
        getAllCircuitLayouts(supabaseEnv),
        getCircuits(supabaseEnv),
        getAllTrackGuides(supabaseEnv),
      ]);
      const circuitNameById = new Map(circuits.map((c) => [c.id, c.name]));
      const layoutById = new Map(layouts.map((l) => [l.id, l]));
      const guidesByLayoutId = new Map<string, typeof allGuides>();
      for (const guide of allGuides) {
        if (!guidesByLayoutId.has(guide.layout_id)) guidesByLayoutId.set(guide.layout_id, []);
        guidesByLayoutId.get(guide.layout_id)!.push(guide);
      }

      const layoutIdParam = Astro.url.searchParams.get('layout');
      const requestedLayout = layoutIdParam ? layoutById.get(layoutIdParam) : undefined;
      if (requestedLayout && guidesByLayoutId.has(requestedLayout.id)) {
        selectedLayout = {
          circuitName: circuitNameById.get(requestedLayout.circuit_id) ?? 'Unknown circuit',
          layoutName: displayLayoutName(requestedLayout.name),
        };
        trackGuidesForLayout = guidesByLayoutId.get(requestedLayout.id)!.map((g) => ({ title: g.title, url: g.url }));
      } else {
        trackGuideLayouts = [...guidesByLayoutId.entries()]
          .map(([layoutId, guides]) => {
            const layout = layoutById.get(layoutId);
            if (!layout) return null;
            return {
              layoutId,
              circuitName: circuitNameById.get(layout.circuit_id) ?? 'Unknown circuit',
              layoutName: displayLayoutName(layout.name),
              guideCount: guides.length,
              firstUrl: guides[0].url,
            };
          })
          .filter((entry): entry is NonNullable<typeof entry> => entry !== null)
          .sort((a, b) => a.circuitName.localeCompare(b.circuitName) || a.layoutName.localeCompare(b.layoutName));
      }
    } else {
      categoryVideos = await getMediaVideosByCategory(supabaseEnv, filter as MediaVideoCategory);
    }
  } else if (tab === 'graphics') {
    [graphics, photoAlbums] = await Promise.all([getAllMediaGraphics(supabaseEnv), getAllPhotoAlbumLinks(supabaseEnv)]);
  } else if (tab === 'meetups') {
    meetups = await getAllMediaMeetups(supabaseEnv);
  }
} catch (err) {
  console.error('Failed to load media page content:', err);
  loadError = true;
}

function tabHref(t: Tab): string {
  return t === 'videos' ? `/media?tab=videos&filter=${filter}` : `/media?tab=${t}`;
}
function filterHref(f: VideoFilter): string {
  return `/media?tab=videos&filter=${f}`;
}

const FILTER_LABELS: Record<VideoFilter, string> = {
  broadcasts: 'Broadcasts',
  cinematic: 'Cinematics',
  educational: 'Educational',
  trackguide: 'Track Guide',
  other: 'Other',
};

const meetupPins = meetups
  .filter((m) => Number.isFinite(m.latitude) && Number.isFinite(m.longitude))
  .map((m) => ({
    title: m.title,
    lat: m.latitude,
    lng: m.longitude,
    photoUrl: m.photo_url,
    locationLabel: m.location_label,
    date: m.meetup_date ? formatDate(m.meetup_date) : null,
  }));

Astro.response.headers.set('Cache-Control', 'public, s-maxage=60, stale-while-revalidate=300');
---

<Layout title="Media" description="Broadcasts, cinematics, educational videos, track guides, graphics, and meetups from Alpha Touring Challenge.">
  <section class="relative mx-auto max-w-5xl overflow-hidden px-6 pb-24 pt-28 sm:pt-36">
    <PageBanner imageUrl={bannerUrl} />
    <h1 class="reveal font-display text-5xl">Media</h1>

    <div class="reveal mb-8 mt-8 flex flex-wrap gap-2" style="transition-delay: 40ms">
      {TABS.map((t) => (
        <a
          href={tabHref(t)}
          class={`rounded-lg px-4 py-1.5 text-sm font-semibold capitalize ring-1 ring-white/15 transition ${
            tab === t ? 'bg-white text-brand-ink' : 'text-white/80 hover:bg-white/10'
          }`}
        >
          {t}
        </a>
      ))}
    </div>

    {loadError && (
      <p class="rounded-lg border border-brand-pink/30 bg-brand-pink/10 p-4 text-sm text-white/80">
        Couldn't load Media page content right now.
      </p>
    )}

    {!loadError && tab === 'videos' && (
      <>
        <div class="reveal mb-8 flex flex-wrap gap-2" style="transition-delay: 60ms">
          {VIDEO_FILTERS.map((f) => (
            <a
              href={filterHref(f)}
              class={`rounded-lg px-3.5 py-1.5 text-xs font-semibold ring-1 ring-white/15 transition ${
                filter === f ? 'bg-brand-primary text-white' : 'text-white/70 hover:bg-white/10'
              }`}
            >
              {FILTER_LABELS[f]}
            </a>
          ))}
        </div>

        <div class="reveal mb-6 max-w-sm" style="transition-delay: 70ms">
          <input
            type="search"
            id="media-search-videos"
            placeholder="Search…"
            class="w-full rounded-md border border-white/15 bg-white/5 px-3 py-2 text-white outline-none focus:border-brand-primary"
          />
        </div>

        {filter === 'broadcasts' && (
          broadcastVideos.length === 0 ? (
            <p class="reveal mt-8 text-white/60" style="transition-delay: 80ms">No broadcast links on file yet.</p>
          ) : (
            <div id="media-search-grid" class="reveal grid gap-4 sm:grid-cols-2 lg:grid-cols-3" style="transition-delay: 80ms">
              {broadcastVideos.map((v) => {
                const thumb = youtubeThumbnailUrl(v.broadcast_url);
                return (
                  <a href={v.broadcast_url} target="_blank" rel="noopener noreferrer" data-search={v.track_name.toLowerCase()} class="group overflow-hidden rounded-xl bg-white/5 ring-1 ring-white/10 transition hover:ring-brand-primary/50">
                    {thumb ? (
                      <img src={thumb} alt="" class="aspect-video w-full object-cover transition group-hover:brightness-110" />
                    ) : (
                      <div class="aspect-video w-full bg-white/10"></div>
                    )}
                    <div class="p-3">
                      <p class="font-semibold">{v.track_name}</p>
                      <p class="mt-0.5 text-xs text-white/50">
                        {v.season_label && `${v.season_label} · `}
                        {formatDate(v.start_time)}
                        {v.race_number > 1 && ` · Race ${v.race_number}`}
                      </p>
                    </div>
                  </a>
                );
              })}
            </div>
          )
        )}

        {filter === 'trackguide' && selectedLayout && (
          <>
            <a href="/media?tab=videos&filter=trackguide" class="reveal mb-4 inline-block text-sm text-brand-primary hover:underline" style="transition-delay: 70ms">
              &larr; All Track Guides
            </a>
            <h2 class="reveal mb-4 font-display text-2xl" style="transition-delay: 70ms">
              {selectedLayout.circuitName} — {selectedLayout.layoutName}
            </h2>
            <div id="media-search-grid" class="reveal grid gap-4 sm:grid-cols-2 lg:grid-cols-3" style="transition-delay: 80ms">
              {trackGuidesForLayout.map((tg) => {
                const thumb = youtubeThumbnailUrl(tg.url);
                return (
                  <a href={tg.url} target="_blank" rel="noopener noreferrer" data-search={(tg.title ?? '').toLowerCase()} class="group overflow-hidden rounded-xl bg-white/5 ring-1 ring-white/10 transition hover:ring-brand-primary/50">
                    {thumb ? (
                      <img src={thumb} alt="" class="aspect-video w-full object-cover transition group-hover:brightness-110" />
                    ) : (
                      <div class="aspect-video w-full bg-white/10"></div>
                    )}
                    <div class="p-3">
                      <p class="font-semibold">{tg.title || 'Track Guide'}</p>
                    </div>
                  </a>
                );
              })}
            </div>
          </>
        )}

        {filter === 'trackguide' && !selectedLayout && (
          trackGuideLayouts.length === 0 ? (
            <p class="reveal mt-8 text-white/60" style="transition-delay: 80ms">No track guides on file yet.</p>
          ) : (
            <div id="media-search-grid" class="reveal grid gap-4 sm:grid-cols-2 lg:grid-cols-3" style="transition-delay: 80ms">
              {trackGuideLayouts.map((tg) => {
                const thumb = youtubeThumbnailUrl(tg.firstUrl);
                return (
                  <a href={`/media?tab=videos&filter=trackguide&layout=${encodeURIComponent(tg.layoutId)}`} data-search={`${tg.circuitName} ${tg.layoutName}`.toLowerCase()} class="group overflow-hidden rounded-xl bg-white/5 ring-1 ring-white/10 transition hover:ring-brand-primary/50">
                    {thumb ? (
                      <img src={thumb} alt="" class="aspect-video w-full object-cover transition group-hover:brightness-110" />
                    ) : (
                      <div class="aspect-video w-full bg-white/10"></div>
                    )}
                    <div class="p-3">
                      <p class="font-semibold">{tg.circuitName}</p>
                      <p class="mt-0.5 text-xs text-white/50">
                        {tg.layoutName} · {tg.guideCount} guide{tg.guideCount === 1 ? '' : 's'}
                      </p>
                    </div>
                  </a>
                );
              })}
            </div>
          )
        )}

        {(filter === 'cinematic' || filter === 'educational' || filter === 'other') && (
          categoryVideos.length === 0 ? (
            <p class="reveal mt-8 text-white/60" style="transition-delay: 80ms">No results.</p>
          ) : (
            <div id="media-search-grid" class="reveal grid gap-4 sm:grid-cols-2 lg:grid-cols-3" style="transition-delay: 80ms">
              {categoryVideos.map((v) => {
                const thumb = youtubeThumbnailUrl(v.youtube_url);
                return (
                  <a href={v.youtube_url} target="_blank" rel="noopener noreferrer" data-search={v.title.toLowerCase()} class="group overflow-hidden rounded-xl bg-white/5 ring-1 ring-white/10 transition hover:ring-brand-primary/50">
                    {thumb ? (
                      <img src={thumb} alt="" class="aspect-video w-full object-cover transition group-hover:brightness-110" />
                    ) : (
                      <div class="aspect-video w-full bg-white/10"></div>
                    )}
                    <div class="p-3">
                      <p class="font-semibold">{v.title}</p>
                    </div>
                  </a>
                );
              })}
            </div>
          )
        )}
        <p id="media-search-empty-videos" class="reveal mt-8 hidden text-white/60">No matches.</p>
      </>
    )}

    {!loadError && tab === 'graphics' && (
      graphics.length === 0 && photoAlbums.length === 0 ? (
        <p class="reveal mt-8 text-white/60" style="transition-delay: 60ms">No graphics on file yet.</p>
      ) : (
        <>
          {photoAlbums.length > 0 && (
            // Same list shape as Videos → Broadcasts (see that block above) —
            // one card per round with a linked album, newest first. No
            // synchronous thumbnail here (see /api/photo-album-thumbnail's
            // own doc comment for why); each card starts with a plain
            // placeholder that the script at the bottom of this file swaps
            // for a real image once that round's thumbnail fetch resolves.
            <div class="reveal mb-10" style="transition-delay: 60ms">
              <h2 class="mb-4 font-display text-2xl">Round Photo Albums</h2>
              <div id="media-photo-albums-grid" class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
                {photoAlbums.map((p) => (
                  <a
                    href={p.photo_album_url}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="group overflow-hidden rounded-xl bg-white/5 ring-1 ring-white/10 transition hover:ring-brand-primary/50"
                  >
                    <div class="aspect-video w-full bg-white/10" data-album-thumb data-album-url={p.photo_album_url}></div>
                    <div class="p-3">
                      <p class="font-semibold">{p.track_name}</p>
                      <p class="mt-0.5 text-xs text-white/50">
                        {p.season_label && `${p.season_label} · `}
                        {formatDate(p.start_time)}
                        {p.race_number > 1 && ` · Race ${p.race_number}`}
                      </p>
                    </div>
                  </a>
                ))}
              </div>
            </div>
          )}

          {graphics.length > 0 && (
            <>
              <div class="reveal mb-6 max-w-sm" style="transition-delay: 60ms">
                <input
                  type="search"
                  id="media-search-graphics"
                  placeholder="Search graphics…"
                  class="w-full rounded-md border border-white/15 bg-white/5 px-3 py-2 text-white outline-none focus:border-brand-primary"
                />
              </div>
              <div id="media-graphics-grid" class="reveal grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-4" style="transition-delay: 70ms">
                {graphics.map((g) => (
                  <button
                    type="button"
                    data-lightbox
                    data-lightbox-src={g.image_url}
                    data-lightbox-alt={g.title}
                    data-search={g.title.toLowerCase()}
                    class="group overflow-hidden rounded-xl bg-white/5 text-left ring-1 ring-white/10 transition hover:ring-brand-primary/50"
                  >
                    <img src={g.image_url} alt={g.title} class="aspect-square w-full object-cover transition group-hover:brightness-110" />
                    <p class="truncate p-2 text-xs font-semibold text-white/80">{g.title}</p>
                  </button>
                ))}
              </div>
              <p id="media-search-empty-graphics" class="reveal mt-8 hidden text-white/60">No matches.</p>
            </>
          )}
        </>
      )
    )}

    {!loadError && tab === 'meetups' && (
      meetupPins.length === 0 ? (
        <p class="reveal mt-8 text-white/60" style="transition-delay: 60ms">No meetups on file yet.</p>
      ) : (
        <>
          <div class="reveal mb-6 max-w-sm" style="transition-delay: 60ms">
            <input
              type="search"
              id="media-search-meetups"
              placeholder="Search meetups…"
              class="w-full rounded-md border border-white/15 bg-white/5 px-3 py-2 text-white outline-none focus:border-brand-primary"
            />
          </div>
          <div class="reveal overflow-hidden rounded-xl ring-1 ring-white/10" style="transition-delay: 70ms">
            <div id="meetup-map" class="h-[520px] w-full bg-white/5"></div>
          </div>
        </>
      )
    )}
  </section>

  <script>
    // Shared client-side search for the Videos and Graphics tabs — both
    // render a plain grid of already-server-rendered `[data-search]` cards
    // (never more than one of the two search inputs below exists on a given
    // page load, since `tab` is a real server-side query param, not a
    // client-side toggle), so this is just show/hide filtering, same
    // pattern as driver-stats.astro's own search box. Meetups gets its own
    // handler (see the Leaflet script below) since map markers can't be
    // hidden with a CSS class the way a grid item can.
    function initGridSearch(inputId: string, gridId: string, emptyId: string | null) {
      const input = document.getElementById(inputId) as HTMLInputElement | null;
      const grid = document.getElementById(gridId);
      if (!input || !grid) return;

      const items = grid.querySelectorAll<HTMLElement>('[data-search]');
      const empty = emptyId ? document.getElementById(emptyId) : null;

      input.addEventListener('input', () => {
        const term = input.value.trim().toLowerCase();
        let visibleCount = 0;
        items.forEach((item) => {
          const matches = !term || (item.dataset.search ?? '').includes(term);
          item.style.display = matches ? '' : 'none';
          if (matches) visibleCount += 1;
        });
        if (empty) empty.classList.toggle('hidden', visibleCount > 0);
      });
    }

    // Graphics tab's "Round Photo Albums" list (src/pages/media.astro,
    // above) renders each card with a plain placeholder div — there's no
    // synchronous thumbnail the way YouTube broadcasts get one, since
    // Flickr has no predictable per-album image URL (see
    // /api/photo-album-thumbnail's own doc comment). This fetches one small
    // JSON response per album and swaps the placeholder for a real <img>
    // if a thumbnail comes back; a Flickr link with no resolvable thumbnail
    // (or a non-Flickr album URL) just keeps its placeholder, same as a
    // broadcast video whose URL didn't parse. Re-running this against
    // already-swapped cards is harmless — replaceWith() removes the
    // placeholder from the DOM, so it simply won't match `[data-album-thumb]`
    // a second time.
    function initAlbumThumbnails() {
      document.querySelectorAll<HTMLElement>('[data-album-thumb]').forEach((el) => {
        const albumUrl = el.dataset.albumUrl;
        if (!albumUrl) return;
        fetch(`/api/photo-album-thumbnail?url=${encodeURIComponent(albumUrl)}`)
          .then((res) => (res.ok ? res.json() : null))
          .then((data: { thumbnailUrl?: string | null } | null) => {
            if (!data?.thumbnailUrl) return;
            const img = document.createElement('img');
            img.src = data.thumbnailUrl;
            img.alt = '';
            img.className = 'aspect-video w-full object-cover transition group-hover:brightness-110';
            el.replaceWith(img);
          })
          .catch((err) => console.error('Failed to load photo album thumbnail:', err));
      });
    }

    document.addEventListener('astro:page-load', () => {
      initGridSearch('media-search-videos', 'media-search-grid', 'media-search-empty-videos');
      initGridSearch('media-search-graphics', 'media-graphics-grid', 'media-search-empty-graphics');
      initAlbumThumbnails();
    });
  </script>

  {tab === 'meetups' && meetupPins.length > 0 && (
    <>
      <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/leaflet.min.css" />
      <script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/leaflet.min.js"></script>
      <script define:vars={{ meetupPins }}>
        // Pure client-side rendering of server-provided pin data — no
        // network call of its own once Leaflet's assets have loaded, so
        // (per pageProgress.ts's own convention) this doesn't drive the
        // global loading bar; the page navigation that got here already did.
        function initMeetupMap() {
          const el = document.getElementById('meetup-map');
          // @ts-ignore - global from the Leaflet CDN script above
          if (!el || typeof L === 'undefined' || el.dataset.mapInit === 'true') return;
          el.dataset.mapInit = 'true';

          // @ts-ignore
          const map = L.map(el).setView([39.8283, -98.5795], 4); // continental-US center
          // @ts-ignore
          L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
            attribution: '&copy; OpenStreetMap contributors',
            maxZoom: 18,
          }).addTo(map);

          // Kept alongside each pin's own searchable text so the search box
          // below can add/remove markers from the map on the fly — Leaflet
          // markers have no built-in show/hide, so filtering means literally
          // adding/removing them from the map rather than toggling a CSS
          // class the way the plain-grid search (initGridSearch, further
          // down this file) does for Videos/Graphics.
          const markerEntries: { marker: any; searchText: string }[] = [];
          meetupPins.forEach((pin) => {
            const popupHtml = `
              <div style="min-width:160px">
                ${pin.photoUrl ? `<img src="${pin.photoUrl}" alt="" style="width:100%;height:100px;object-fit:cover;border-radius:6px;margin-bottom:6px" />` : ''}
                <strong>${pin.title}</strong>
                ${pin.locationLabel || pin.date ? `<div style="font-size:12px;opacity:0.7;margin-top:2px">${[pin.locationLabel, pin.date].filter(Boolean).join(' · ')}</div>` : ''}
              </div>
            `;
            // @ts-ignore
            const marker = L.marker([pin.lat, pin.lng]).addTo(map).bindPopup(popupHtml);
            markerEntries.push({ marker, searchText: `${pin.title} ${pin.locationLabel ?? ''}`.toLowerCase() });
          });

          const searchInput = document.getElementById('media-search-meetups') as HTMLInputElement | null;
          if (searchInput && !searchInput.dataset.meetupSearchBound) {
            searchInput.dataset.meetupSearchBound = 'true';
            searchInput.addEventListener('input', () => {
              const term = searchInput.value.trim().toLowerCase();
              markerEntries.forEach(({ marker, searchText }) => {
                const matches = !term || searchText.includes(term);
                const onMap = map.hasLayer(marker);
                if (matches && !onMap) marker.addTo(map);
                if (!matches && onMap) map.removeLayer(marker);
              });
            });
          }
        }

        document.addEventListener('astro:page-load', initMeetupMap);
      </script>
    </>
  )}
</Layout>
