---
export const prerender = false;
import LoadError from '../../components/LoadError.astro';
import { markUncacheable } from '../../lib/security';

import {
  getTeams,
  getTeamRosterForSeason,
  getAllTeamRosters,
  getAllTeamSeasonLogos,
  type Team,
} from '../../lib/db/teams';
import { getDrivers, resolveSupabaseEnv } from '../../lib/db/client';
import { getSeasons, type Season } from '../../lib/db/seasons';
import { displayDriverName } from '../../lib/db/circuits';
import { driversSelect, type DriverBasic } from '../../lib/results/rows';
import { getAllRounds } from '../../lib/results/rounds';
import { isChampionshipSeason } from '../../lib/results/shared';
import { seasonOptionAttrs } from '../../lib/seasonSelect';
import TeamLogo from '../../components/TeamLogo.astro';
import DriverLink from '../../components/DriverLink.astro';

const supabaseEnv = resolveSupabaseEnv(Astro.locals);

let teams: Awaited<ReturnType<typeof getTeams>> = [];
let loadError = false;
const loadTeams = async () => {
  try {
    teams = await getTeams(supabaseEnv);
  } catch (err) {
    console.error('Failed to load teams:', err);
    loadError = true;
  }
};

// Seasons, fetched first so the picker and the roster, logo and founded-date loads share `selectedSeason`
// (current season by default).
let seasons: Season[] = [];
const loadSeasons = async () => {
  try {
    seasons = await getSeasons(supabaseEnv);
  } catch (err) {
    console.error('Failed to load seasons:', err);
  }
};

// Current members by team name (from drivers.team_id; getDrivers' embedded team has no id), so search also
// matches member names.
let memberNamesByTeamName = new Map<string, string[]>();
const loadMemberNames = async () => {
  try {
    const drivers = await getDrivers(supabaseEnv);
    for (const d of drivers) {
      if (!d.teams?.name) continue;
      if (!memberNamesByTeamName.has(d.teams.name)) memberNamesByTeamName.set(d.teams.name, []);
      memberNamesByTeamName.get(d.teams.name)!.push(displayDriverName(d.name));
    }
  } catch (err) {
    console.error('Failed to load drivers for team search:', err);
  }
};

// Drivers, to turn roster driver_ids into rows; independent, so fetched in the first batch.
let driversBasic: DriverBasic[] = [];
const loadDriversBasic = async () => {
  try {
    driversBasic = await driversSelect(supabaseEnv);
  } catch (err) {
    console.error('Failed to load drivers for team rosters:', err);
  }
};

// These six blocks don't read each other's results, so they run
// concurrently rather than as 6 sequential round-trips — each keeps its own
// try/catch exactly as before, isolated from the others.
await Promise.all([loadTeams(), loadSeasons(), loadMemberNames(), loadDriversBasic()]);

Astro.response.headers.set('Cache-Control', 'public, s-maxage=60, stale-while-revalidate=300');

// `?season=` from the GET-submitted picker, else the current season; split into Championships and Exhibitions
// like the Race Results picker.
const championshipSeasons = seasons.filter((s) => isChampionshipSeason(s.name));
const exhibitionSeasons = seasons.filter((s) => !isChampionshipSeason(s.name));
const currentSeason = seasons.find((s) => s.is_current) ?? seasons[0] ?? null;
const requestedSeasonId = Astro.url.searchParams.get('season');
const selectedSeason = (requestedSeasonId ? seasons.find((s) => s.id === requestedSeasonId) : undefined) ?? currentSeason;
const isPastSeason = !!selectedSeason && selectedSeason.id !== currentSeason?.id;

// Roster columns from the selected season's team_rosters (what scoring trusts), not drivers.team_id. Most
// seasons allow 3 drivers, some 4; a 4th column appears when any roster has a 4th entry.
let rosterByTeamId = new Map<string, DriverBasic[]>();
const loadSeasonRoster = async () => {
  if (!selectedSeason) return;
  try {
    const rosterEntries = await getTeamRosterForSeason(supabaseEnv, selectedSeason.id);
    const driverById = new Map(driversBasic.map((d) => [d.id, d]));
    for (const entry of rosterEntries) {
      const driver = driverById.get(entry.driver_id);
      if (!driver) continue;
      if (!rosterByTeamId.has(entry.team_id)) rosterByTeamId.set(entry.team_id, []);
      rosterByTeamId.get(entry.team_id)!.push(driver);
    }
    for (const list of rosterByTeamId.values()) {
      list.sort((a, b) => (a.car_number ?? Number.MAX_SAFE_INTEGER) - (b.car_number ?? Number.MAX_SAFE_INTEGER) || a.name.localeCompare(b.name));
    }
  } catch (err) {
    console.error('Failed to load team rosters for selected season:', err);
  }
};

// The selected season's logo override (team_season_logos), else the current logo_url.
let logoOverrideByTeamId = new Map<string, string>();
const loadSeasonLogos = async () => {
  if (!selectedSeason) return;
  try {
    const allLogos = await getAllTeamSeasonLogos(supabaseEnv);
    for (const logo of allLogos) {
      if (logo.season_id === selectedSeason.id) logoOverrideByTeamId.set(logo.team_id, logo.logo_url);
    }
  } catch (err) {
    console.error('Failed to load historical team logos:', err);
  }
};

// "Founded": the team's earliest raced round across every season it had a roster, regardless of the selected
// season. seasons.start_date is never filled in, so it isn't used; teams.created_at is the fallback for a
// team with no raced rounds.
let earliestRaceDateByTeamId = new Map<string, string>();
const loadFoundingDates = async () => {
  try {
    const [allRosterEntries, allRounds] = await Promise.all([getAllTeamRosters(supabaseEnv), getAllRounds(supabaseEnv)]);
    const earliestRoundStartBySeasonId = new Map<string, string>();
    for (const round of allRounds) {
      const existing = earliestRoundStartBySeasonId.get(round.season_id);
      if (!existing || round.start_time < existing) earliestRoundStartBySeasonId.set(round.season_id, round.start_time);
    }
    for (const entry of allRosterEntries) {
      const seasonStart = earliestRoundStartBySeasonId.get(entry.season_id);
      if (!seasonStart) continue;
      const existing = earliestRaceDateByTeamId.get(entry.team_id);
      if (!existing || seasonStart < existing) earliestRaceDateByTeamId.set(entry.team_id, seasonStart);
    }
  } catch (err) {
    console.error('Failed to load team rosters/rounds for founding dates:', err);
  }
};

// Independent of each other, so they run together.
await Promise.all([loadSeasonRoster(), loadSeasonLogos(), loadFoundingDates()]);

function foundedDateFor(team: Team): string {
  const earliestRaceDate = earliestRaceDateByTeamId.get(team.id);
  return earliestRaceDate && earliestRaceDate < team.created_at ? earliestRaceDate : team.created_at;
}

function ordinalSuffix(n: number): string {
  const rem100 = n % 100;
  if (rem100 >= 11 && rem100 <= 13) return 'th';
  if (n % 10 === 1) return 'st';
  if (n % 10 === 2) return 'nd';
  if (n % 10 === 3) return 'rd';
  return 'th';
}

/** "MMM DDth, YYYY" (e.g. "Jan 3rd, 2024") — read off the UTC calendar date so a date stored as e.g. `2023-01-05` (midnight UTC) never shifts a day depending on the visitor's timezone. */
function formatFoundedDate(iso: string): string {
  const d = new Date(iso);
  const month = d.toLocaleString('en-US', { month: 'short', timeZone: 'UTC' });
  const day = d.getUTCDate();
  const year = d.getUTCFullYear();
  return `${month} ${day}${ordinalSuffix(day)}, ${year}`;
}

/**
 * Splits a name at its first space so the narrow mobile roster columns stack first name over the rest
 * (Logan); desktop keeps one line.
 */
function splitFirstName(fullName: string): { first: string; rest: string } {
  const trimmed = fullName.trim();
  const spaceIdx = trimmed.indexOf(' ');
  if (spaceIdx === -1) return { first: trimmed, rest: '' };
  return { first: trimmed.slice(0, spaceIdx), rest: trimmed.slice(spaceIdx + 1) };
}

// Only teams with drivers on the selected season's roster: for the current season that is exactly the active
// teams; past seasons keep every team that raced. Headers sort client-side (sortable-table.ts).
const sortedTeams = teams
  .filter((team) => (rosterByTeamId.get(team.id)?.length ?? 0) > 0)
  .sort((a, b) => a.name.localeCompare(b.name));

// Whether any team's roster for the selected season has a 4th driver
// (rulebook cap of 3 loosened in some historical seasons — see the roster
// loader's doc comment above).
const showFourthDriverColumn = [...rosterByTeamId.values()].some((list) => list.length >= 4);
const driverColumnCount = showFourthDriverColumn ? 4 : 3;
if (loadError) markUncacheable(Astro);
---

    {loadError && <LoadError class="mt-8" />}

    {!loadError && (
      <div class="reveal mt-8 relative z-30 rounded-xl border border-white/10 bg-brand-ink p-4" style="transition-delay: 80ms">
        <div class="flex flex-wrap items-end gap-3">
          <input
            type="search"
            id="team-search"
            placeholder="Search teams or drivers…"
            class="search-input h-9 rounded-md border border-white/15 bg-transparent px-3 text-sm text-white outline-none hover:bg-white/5 focus:border-brand-primary focus:bg-white/5"
          />
          {seasons.length > 0 && (
            <form method="GET" class="sm:w-44">
              <label class="flex flex-col gap-1.5">
                <span class="text-xs font-semibold uppercase tracking-wide text-white/40">Season</span>
                <select
                  name="season"
                  data-logo-select
                  data-submit-on-change
                  class="h-9 w-full rounded-md border border-white/15 bg-transparent px-3 text-sm text-white outline-none hover:bg-white/5 focus:border-brand-primary focus:bg-white/5"
                >
                  <optgroup label="Championships" class="bg-brand-ink text-white">
                    {championshipSeasons.map((s) => (
                      <option value={s.id} selected={s.id === selectedSeason?.id} {...seasonOptionAttrs(s)} class="bg-brand-ink text-white">{s.name}</option>
                    ))}
                  </optgroup>
                  {exhibitionSeasons.length > 0 && (
                    <optgroup label="Exhibitions" class="bg-brand-ink text-white">
                      {exhibitionSeasons.map((s) => (
                        <option value={s.id} selected={s.id === selectedSeason?.id} {...seasonOptionAttrs(s)} class="bg-brand-ink text-white">{s.name}</option>
                      ))}
                    </optgroup>
                  )}
                </select>
              </label>
            </form>
          )}
        </div>
      </div>
    )}

    {!loadError && (
      <div class="mt-6 rounded-xl border border-white/10" data-sticky-thead>
        <table class="w-full border-collapse" data-sortable>
          <thead>
            <tr class="border-b border-white/10 text-left text-xs uppercase tracking-wide text-white/40">
              <th class="py-3 pl-4 pr-3 font-medium" data-sort-key="name">Team</th>
              {/* Founded is hidden on mobile (Logan) so the team name has the
                  whole row; desktop shows it as before. Still gated on
                  !isPastSeason. */}
              {!isPastSeason && <th class="hidden py-3 pr-4 font-medium sm:table-cell" data-sort-key="founded">Founded</th>}
              {/* Hidden on mobile, where tapping a row expands its driver list instead. */}
              <th class="hidden py-3 pr-4 font-medium sm:table-cell">Driver 1</th>
              <th class="hidden py-3 pr-4 font-medium sm:table-cell">Driver 2</th>
              <th class="hidden py-3 pr-4 font-medium sm:table-cell">Driver 3</th>
              {showFourthDriverColumn && <th class="hidden py-3 pr-4 font-medium sm:table-cell">Driver 4</th>}
            </tr>
          </thead>
          <tbody id="team-list">
            {sortedTeams.map((team) => {
              const members = memberNamesByTeamName.get(team.name) ?? [];
              const roster = rosterByTeamId.get(team.id) ?? [];
              const logoUrl = logoOverrideByTeamId.get(team.id) ?? team.logo_url;
              const founded = foundedDateFor(team);
              const searchText = [team.name, ...members, ...roster.map((d) => displayDriverName(d.name))].join(' ').toLowerCase();
              return (
                <>
                <tr
                  data-expand-row
                  tabindex="0"
                  role="button"
                  aria-expanded="false"
                  class="cursor-pointer border-b border-white/5 text-sm transition hover:bg-white/[0.04] sm:cursor-default"
                  data-search={searchText}
                >
                  <td class="py-2.5 pl-4 pr-3" data-col="name">
                    <div class="flex items-center gap-3">
                      <span
                        data-chevron
                        class="inline-block shrink-0 text-[9px] text-white/30 transition-transform duration-150 sm:hidden"
                        aria-hidden="true"
                      >
                        &#9654;
                      </span>
                      <TeamLogo name={team.name} logoUrl={logoUrl} size="h-8 w-8" />
                      <div class="flex flex-col justify-center">
                        <span class="font-semibold leading-tight">{team.name}</span>
                      </div>
                    </div>
                  </td>
                  {!isPastSeason && (
                    <td class="hidden py-2.5 pr-4 text-white/70 sm:table-cell" data-col="founded" data-sort-value={founded}>
                      {formatFoundedDate(founded)}
                    </td>
                  )}
                  {Array.from({ length: driverColumnCount }, (_, i) => i).map((i) => {
                    const driver = roster[i];
                    const fullName = driver ? displayDriverName(driver.name) : '';
                    const { first, rest } = splitFirstName(fullName);
                    return (
                      <td class="hidden py-2.5 pr-4 text-white/70 sm:table-cell">
                        {driver ? (
                          <>
                            {/* Mobile: first name stacked above the rest of
                                the name, no car number (Logan) — desktop
                                keeps the original single-line "Name #Number". */}
                            <DriverLink id={driver.id} hidden={driver.is_hidden}>
                              <span class="flex flex-col leading-tight sm:hidden">
                                <span>{first}</span>
                                {rest && <span>{rest}</span>}
                              </span>
                            </DriverLink>
                            <span class="hidden sm:inline">
                              <DriverLink id={driver.id} hidden={driver.is_hidden}>{fullName}</DriverLink>
                              {driver.car_number !== null && <span class="text-white/40"> #{driver.car_number}</span>}
                            </span>
                          </>
                        ) : (
                          <span class="text-white/25">—</span>
                        )}
                      </td>
                    );
                  })}
                </tr>
                {/* Mobile-only driver list for the row above; `sm:hidden` stays even when expandRows.ts
                   removes `hidden`, so it never shows at sm+. */}
                <tr data-detail-row class="hidden border-b border-white/5 bg-white/[0.02] text-xs sm:hidden">
                  <td colspan={!isPastSeason ? 2 : 1} class="px-4 py-4">
                    <div class="text-[10px] uppercase tracking-wide text-white/30">Drivers</div>
                    <table class="mt-1 w-full max-w-xs">
                      <tbody>
                        {roster.map((driver, i) => (
                          <tr class="border-b border-white/5 last:border-0">
                            <td class="py-1 text-white/50">Driver {i + 1}</td>
                            <td class="py-1 text-right font-semibold text-white/90">
                              <DriverLink id={driver.id} hidden={driver.is_hidden}>{displayDriverName(driver.name)}</DriverLink>
                              {driver.car_number !== null && <span class="text-white/40"> #{driver.car_number}</span>}
                            </td>
                          </tr>
                        ))}
                      </tbody>
                    </table>
                  </td>
                </tr>
                </>
              );
            })}
          </tbody>
        </table>
      </div>
    )}

    {!loadError && <p id="team-search-empty" class="mt-4 hidden text-white/60">No results.</p>}
