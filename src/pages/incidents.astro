---
export const prerender = false;

import Layout from '../layouts/Layout.astro';
import HistoryTabs from '../components/HistoryTabs.astro';
import PageBanner from '../components/PageBanner.astro';
import { resolveSupabaseEnv } from '../lib/db/client';
import { getPageBanners } from '../lib/db/assets';
import { bannerUrlFor } from '../lib/pageBanners';

// Shell: only the banner, tab switcher and a skeleton; getAllIncidents() reads every penalty ever logged, so
// the tables load from incidents/fragment.astro after first paint.

const supabaseEnv = resolveSupabaseEnv(Astro.locals);

let bannerUrl: string | null = null;
try {
  bannerUrl = bannerUrlFor(await getPageBanners(supabaseEnv), 'incidents');
} catch (err) {
  console.error('Failed to load page banner:', err);
}

Astro.response.headers.set('Cache-Control', 'public, s-maxage=60, stale-while-revalidate=300');
---

<Layout title="Incidents" description="Every steward-logged incident in Alpha Touring Challenge history.">
  <section class="relative mx-auto max-w-6xl px-6 pb-24 pt-8">
    <PageBanner imageUrl={bannerUrl} />
    <h1 class="reveal font-display text-2xl sm:text-5xl">Incidents</h1>

    <!--
      The three-way All Incidents / By Driver / By Offense switch — plain
      radio-less tab buttons toggling `hidden` on sibling panels, same shape
      as the homepage's standings widget. The one real difference: that
      widget's markup (and its toggle script) render synchronously in the
      same page load, so its script can just querySelector the tabs/panels
      directly. Here the tabs AND panels only exist once
      incidents/fragment.astro's HTML lands via `container.innerHTML =`
      below — and a <script> tag inside HTML set that way never executes
      (see drivers/[id]/fragment.astro's own doc comment on this exact
      limitation). So this toggle script lives here, in the shell (which
      DOES execute normally), using one delegated `document` click listener
      — same "resolve fresh against whatever's in the DOM right now" shape
      as expandRows.ts — so it works correctly for tab buttons that don't
      exist yet when this script first runs.
    -->
    <div data-incidents-results data-fragment-url="/incidents/fragment">
      <div class="reveal mt-12 relative z-30 rounded-xl border border-white/10 bg-brand-ink p-4" aria-live="polite" aria-busy="true">
        <span class="sr-only">Loading incidents…</span>
        <div class="flex flex-wrap items-end gap-3">
          <HistoryTabs active="incidents" />
          <div class="flex flex-col gap-1.5 sm:w-56">
            <span class="text-xs font-semibold uppercase tracking-wide text-white/40">View</span>
            <div class="h-9 animate-pulse rounded-md border border-white/10 bg-white/[0.03]"></div>
          </div>
        </div>
      </div>
      <div class="mt-6 h-96 animate-pulse rounded-xl border border-white/10 bg-white/[0.02]"></div>
    </div>
  </section>

  <script>
    import { bindFragment } from '../scripts/fragmentLoader';

    bindFragment('[data-incidents-results]', {
      label: 'Incidents',
      logMessage: 'Failed to load incidents:',
      errorHtml:
        '<p class="mt-10 text-white/60">Couldn’t load incidents right now — try refreshing the page.</p>',
    });

    // The All / By Driver / By Offense switch: a delegated listener in the shell, since scripts in the
    // fragment never run; bound once. Row popups are src/scripts/incidentDetails.ts.
    document.addEventListener('change', (e) => {
      const select = (e.target as HTMLElement).closest<HTMLSelectElement>('[data-incidents-select]');
      if (!select) return;
      const widget = select.closest<HTMLElement>('[data-incidents-widget]');
      if (!widget) return;
      widget.querySelectorAll<HTMLElement>('[data-incidents-panel]').forEach((panel) => {
        panel.classList.toggle('hidden', panel.dataset.incidentsPanel !== select.value);
      });
      // Minimum Starts only applies to the By Driver view.
      const wrap = widget.querySelector<HTMLElement>('[data-min-starts-wrap]');
      if (wrap) {
        wrap.classList.toggle('hidden', select.value !== 'byDriver');
        wrap.classList.toggle('flex', select.value === 'byDriver');
      }
    });

    // Minimum Starts: hide By Driver rows (and their open detail rows) for drivers with fewer starts than the chosen value.
    function applyMinStarts(widget: HTMLElement) {
      const input = widget.querySelector<HTMLInputElement>('[data-min-starts-input]');
      if (!input) return;
      const min = Math.max(0, Math.floor(Number(input.value)) || 0);
      const panel = widget.querySelector<HTMLElement>('[data-incidents-panel="byDriver"]');
      if (!panel) return;
      let visible = 0;
      let total = 0;
      panel.querySelectorAll<HTMLElement>('tr[data-expand-row][data-starts]').forEach((row) => {
        total++;
        const hide = Number(row.dataset.starts) < min;
        row.style.display = hide ? 'none' : '';
        const detail = row.nextElementSibling;
        if (detail instanceof HTMLElement && detail.hasAttribute('data-detail-row')) detail.style.display = hide ? 'none' : '';
        if (!hide) visible++;
      });
      panel.querySelector<HTMLElement>('[data-min-starts-empty]')?.classList.toggle('hidden', visible > 0 || total === 0);
      const option = widget.querySelector<HTMLOptionElement>('option[data-label-base]');
      if (option) option.textContent = `${option.dataset.labelBase} (${visible})`;
    }
    document.addEventListener('input', (e) => {
      const input = (e.target as HTMLElement).closest<HTMLInputElement>('[data-min-starts-input]');
      const widget = input?.closest<HTMLElement>('[data-incidents-widget]');
      if (widget) applyMinStarts(widget);
    });
    document.addEventListener('click', (e) => {
      const btn = (e.target as HTMLElement).closest<HTMLElement>('[data-min-starts-step]');
      const widget = btn?.closest<HTMLElement>('[data-incidents-widget]');
      const input = widget?.querySelector<HTMLInputElement>('[data-min-starts-input]');
      if (!btn || !widget || !input) return;
      const next = Math.max(0, (Math.floor(Number(input.value)) || 0) + Number(btn.dataset.minStartsStep));
      input.value = String(next);
      applyMinStarts(widget);
    });
  </script>

  <script>
    import '../scripts/incidentDetails';
  </script>
</Layout>
