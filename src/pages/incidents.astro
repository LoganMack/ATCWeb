---
export const prerender = false;

import Layout from '../layouts/Layout.astro';
import HistoryTabs from '../components/HistoryTabs.astro';
import PageBanner from '../components/PageBanner.astro';
import { resolveSupabaseEnv, getPageBanners } from '../lib/supabase';
import { bannerUrlFor } from '../lib/pageBanners';

// Same shell-then-spinner split as driver-stats.astro/team-stats.astro/
// hall-of-fame.astro — getAllIncidents() (src/lib/incidents.ts) fetches
// EVERY penalty ever logged across the site's whole history, which is
// cheaper than computeDriverCareerStats but still not something worth
// blocking this page's first paint on. This shell only fetches the page
// banner, renders the tab switcher shell + a loading skeleton, and leaves
// the actual three tables to incidents/fragment.astro, fetched client-side
// once this shell has already painted.

const supabaseEnv = resolveSupabaseEnv(Astro.locals);

let bannerUrl: string | null = null;
try {
  bannerUrl = bannerUrlFor(await getPageBanners(supabaseEnv), 'incidents');
} catch (err) {
  console.error('Failed to load page banner:', err);
}

Astro.response.headers.set('Cache-Control', 'public, s-maxage=60, stale-while-revalidate=300');
---

<Layout title="Incidents" description="Every steward-logged incident in Alpha Touring Challenge history.">
  <section class="relative mx-auto max-w-6xl px-6 pb-24 pt-8">
    <PageBanner imageUrl={bannerUrl} />
    <h1 class="reveal font-display text-2xl sm:text-5xl">Incidents</h1>

    <!--
      The three-way All Incidents / By Driver / By Offense switch — plain
      radio-less tab buttons toggling `hidden` on sibling panels, same shape
      as the homepage's standings widget. The one real difference: that
      widget's markup (and its toggle script) render synchronously in the
      same page load, so its script can just querySelector the tabs/panels
      directly. Here the tabs AND panels only exist once
      incidents/fragment.astro's HTML lands via `container.innerHTML =`
      below — and a <script> tag inside HTML set that way never executes
      (see drivers/[id]/fragment.astro's own doc comment on this exact
      limitation). So this toggle script lives here, in the shell (which
      DOES execute normally), using one delegated `document` click listener
      — same "resolve fresh against whatever's in the DOM right now" shape
      as expandRows.ts — so it works correctly for tab buttons that don't
      exist yet when this script first runs.
    -->
    <div data-incidents-results data-fragment-url="/incidents/fragment">
      <div class="reveal mt-12 relative z-30 rounded-xl border border-white/10 bg-brand-ink p-4" aria-live="polite" aria-busy="true">
        <span class="sr-only">Loading incidents…</span>
        <div class="flex flex-wrap items-end gap-3">
          <HistoryTabs active="incidents" />
          <div class="flex flex-col gap-1.5 sm:w-56">
            <span class="text-xs font-semibold uppercase tracking-wide text-white/40">View</span>
            <div class="h-9 animate-pulse rounded-md border border-white/10 bg-white/[0.03]"></div>
          </div>
        </div>
      </div>
      <div class="mt-6 h-96 animate-pulse rounded-xl border border-white/10 bg-white/[0.02]"></div>
    </div>
  </section>

  <script>
    // Fetches incidents/fragment.astro (the expensive getAllIncidents()
    // computation) client-side once this shell has already painted — see
    // this file's top-of-file comment and incidents/fragment.astro for the
    // full explanation.
    // Parsed lazily from the fragment's JSON block on first click, and dropped whenever a new fragment lands.
    let incidentSummaries: Record<string, any> | null = null;

    function initIncidentsResults() {
      const container = document.querySelector<HTMLElement>('[data-incidents-results]');
      const url = container?.dataset.fragmentUrl;
      if (!container || !url) return;
      // Cleared immediately, before the fetch even resolves — same guard
      // driver-stats.astro/team-stats.astro use, so the synthetic
      // astro:page-load dispatched below (once the fragment lands) doesn't
      // see this same data-fragment-url and fetch it all over again.
      delete container.dataset.fragmentUrl;

      fetch(url)
        .then((res) => {
          if (!res.ok) throw new Error(`Incidents fragment request failed (${res.status})`);
          return res.text();
        })
        .then((html) => {
          container.innerHTML = html;
          incidentSummaries = null;
          // sortable-table.ts and expandRows.ts (both sitewide, delegated/
          // per-element-guarded listeners) only bind against content that
          // exists at astro:page-load time — re-dispatching it here is the
          // established fix for "content changed without a real
          // navigation" (see driver-stats.astro's identical comment).
          document.dispatchEvent(new Event('astro:page-load'));
        })
        .catch((err) => {
          console.error('Failed to load incidents:', err);
          container.innerHTML = '<p class="mt-10 text-white/60">Couldn’t load incidents right now — try refreshing the page.</p>';
        });
    }

    document.addEventListener('astro:page-load', initIncidentsResults);

    // The All Incidents / By Driver / By Offense dropdown switch — see this
    // file's markup comment above for why this has to be a delegated
    // listener living in the shell rather than a script inside the
    // fragment itself. Bound once (module scripts run at most once per
    // page load, soft navigations included — see expandRows.ts's own doc
    // comment on this exact pattern), so no re-init guard is needed here
    // the way per-element setup functions need one.
    // "Incident Details" popup for any [data-history-incident] row (All
    // Incidents, and the incidents listed inside By Driver / By Offense rows).
    // Delegated for the same reason as the switch below — the rows and the
    // <dialog> arrive with the fetched fragment. Each row only carries its
    // incident's id; the details live once in the fragment's JSON block.
    function openIncidentDetails(row: HTMLElement) {
      const dialog = document.querySelector<HTMLDialogElement>('[data-history-incident-dialog]');
      if (!dialog) return;
      if (!incidentSummaries) {
        try {
          incidentSummaries = JSON.parse(document.querySelector('[data-history-incident-data]')?.textContent ?? '{}');
        } catch {
          incidentSummaries = {};
        }
      }
      const summary = incidentSummaries?.[row.dataset.historyIncident ?? ''];
      if (!summary) return;
      const set = (name: string, text: string) => {
        const el = dialog.querySelector<HTMLElement>(`[data-hi="${name}"]`);
        if (el) el.textContent = text;
      };
      const show = (name: string, visible: boolean) => {
        dialog.querySelector<HTMLElement>(`[data-hi-row="${name}"]`)?.classList.toggle('hidden', !visible);
      };
      set('round', `${summary.track} · ${summary.round}`);
      set('when', `${summary.season} · ${summary.session} · ${summary.date}`);
      set('driver', summary.driver ?? '—');
      set('number', summary.incidentNumber ?? '—');
      set('lap', summary.lap != null ? String(summary.lap) : '—');
      const involved: string[] = summary.involved ?? [];
      show('involved', involved.length > 0);
      set('involved', involved.join(', '));
      show('description', Boolean(summary.description));
      set('description', summary.description ?? '');
      const offenses: string[] = summary.offenses ?? [];
      show('offenses', offenses.length > 0);
      dialog.querySelector<HTMLElement>('[data-hi="offenses"]')?.replaceChildren(
        ...offenses.map((name) => {
          const div = document.createElement('div');
          div.textContent = name;
          return div;
        })
      );
      set('pp', summary.isWarning ? 'Warning' : summary.pp ? String(summary.pp) : '—');
      set('time', summary.time ? `+${summary.time}s` : '—');
      set('points', summary.points ? String(summary.points) : '—');
      show('appealed', Boolean(summary.isAppealed));
      dialog.querySelector<HTMLAnchorElement>('[data-hi-link="round"]')?.setAttribute('href', summary.roundHref);
      dialog.querySelector<HTMLAnchorElement>('[data-hi-link="report"]')?.setAttribute('href', summary.href);
      dialog.showModal();
    }
    document.addEventListener('click', (e) => {
      const target = e.target as HTMLElement;
      const row = target.closest<HTMLElement>('[data-history-incident]');
      if (row) {
        openIncidentDetails(row);
        return;
      }
      if (target.closest('[data-close-history-incident]')) {
        target.closest('dialog')?.close();
        return;
      }
      // Clicking the backdrop (the <dialog> element itself, outside its content) closes it.
      if (target instanceof HTMLDialogElement && target.hasAttribute('data-history-incident-dialog')) target.close();
    });
    document.addEventListener('keydown', (e) => {
      if (e.key !== 'Enter' && e.key !== ' ') return;
      const row = (e.target as HTMLElement).closest<HTMLElement>('[data-history-incident]');
      if (!row) return;
      e.preventDefault();
      openIncidentDetails(row);
    });

    document.addEventListener('change', (e) => {
      const select = (e.target as HTMLElement).closest<HTMLSelectElement>('[data-incidents-select]');
      if (!select) return;
      const widget = select.closest<HTMLElement>('[data-incidents-widget]');
      if (!widget) return;
      widget.querySelectorAll<HTMLElement>('[data-incidents-panel]').forEach((panel) => {
        panel.classList.toggle('hidden', panel.dataset.incidentsPanel !== select.value);
      });
    });
  </script>
</Layout>
