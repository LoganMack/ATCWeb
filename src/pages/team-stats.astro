---
export const prerender = false;

import Layout from '../layouts/Layout.astro';
import HistoryTabs from '../components/HistoryTabs.astro';
import PageBanner from '../components/PageBanner.astro';
import { resolveSupabaseEnv, getPageBanners } from '../lib/supabase';
import { bannerUrlFor } from '../lib/pageBanners';

// Same shell-then-spinner split as champions.astro / driver-stats.astro
// (PERFORMANCE_AUDIT.md #5) — this page used to await the full
// computeTeamCareerStats() call (every team's whole season-by-season
// history) right here in its own frontmatter, blocking Astro's client
// router from swapping the DOM until that finished. Unlike driver-stats
// this page has no filter tabs of its own — no cheap server-side data to
// fetch at all — so the shell only needs the page banner before it can
// render. Everything else lives in team-stats/fragment.astro now, fetched
// client-side by the <script> below once this shell has already painted.

const supabaseEnv = resolveSupabaseEnv(Astro.locals);

// Same view=overall|delta convention team-standings.astro uses for its own
// Overall/Delta team-competition toggle — see computeTeamCareerStats' own
// doc comment (src/lib/results.ts) for exactly what 'delta' scopes here.
// A real query-param navigation (not client JS) so this shell re-renders
// with the right fragment URL baked in from the start, same as every other
// filter on this page's sibling history pages.
const view = Astro.url.searchParams.get('view') === 'delta' ? 'delta' : 'overall';

let bannerUrl: string | null = null;
try {
  bannerUrl = bannerUrlFor(await getPageBanners(supabaseEnv), 'team-stats');
} catch (err) {
  console.error('Failed to load page banner:', err);
}

Astro.response.headers.set('Cache-Control', 'public, s-maxage=60, stale-while-revalidate=300');
---

<Layout title="Team Stats" description="Career statistics for every team that has ever raced in Alpha Touring Challenge.">
  <section class="relative mx-auto max-w-6xl overflow-hidden px-6 pb-24 pt-28 sm:pt-36">
    <PageBanner imageUrl={bannerUrl} />
    <h1 class="reveal font-display text-5xl">Team Stats</h1>

    <HistoryTabs active="teamStats" />

    <div class="mt-8 flex flex-wrap items-end justify-between gap-4">
      <div class="max-w-sm flex-1">
        <input
          type="search"
          id="team-stats-search"
          placeholder="Search teams…"
          class="w-full rounded-md border border-white/15 bg-white/5 px-3 py-2 text-white outline-none focus:border-brand-primary"
        />
      </div>

      <div class="flex gap-2">
        <a
          href="/team-stats?view=overall"
          class={`rounded-lg px-4 py-1.5 text-sm font-semibold ring-1 ring-white/15 transition ${
            view === 'overall' ? 'bg-white text-brand-ink' : 'text-white/80 hover:bg-white/10'
          }`}
        >
          Overall
        </a>
        <a
          href="/team-stats?view=delta"
          class={`rounded-lg px-4 py-1.5 text-sm font-semibold ring-1 ring-white/15 transition ${
            view === 'delta' ? 'bg-white text-brand-ink' : 'text-white/80 hover:bg-white/10'
          }`}
        >
          Delta
        </a>
      </div>
    </div>

    <div data-team-stats-results data-fragment-url={`/team-stats/fragment?view=${view}`}>
      <div class="mt-6 flex flex-col gap-2" aria-live="polite" aria-busy="true">
        <span class="sr-only">Loading team stats…</span>
        <div class="h-10 animate-pulse rounded-lg border border-white/10 bg-white/[0.03]"></div>
        <div class="h-64 animate-pulse rounded-xl border border-white/10 bg-white/[0.02]"></div>
      </div>
    </div>
  </section>

  <script>
    // Fetches team-stats/fragment.astro (the expensive
    // computeTeamCareerStats table) client-side once this shell has
    // already painted — see this file's top-of-file comment and
    // team-stats/fragment.astro for the full explanation.
    function initTeamStatsResults() {
      const container = document.querySelector<HTMLElement>('[data-team-stats-results]');
      const url = container?.dataset.fragmentUrl;
      if (!container || !url) return;
      // Cleared immediately, before the fetch even resolves — see
      // driver-stats.astro's identical guard for why (this function
      // re-runs on the synthetic astro:page-load dispatched below once the
      // fragment lands, and without this it would refetch forever).
      delete container.dataset.fragmentUrl;

      fetch(url)
        .then((res) => {
          if (!res.ok) throw new Error(`Team stats fragment request failed (${res.status})`);
          return res.text();
        })
        .then((html) => {
          container.innerHTML = html;
          // Same reasoning as driver-stats.astro: sortable-table.ts and
          // this page's own initTeamStatsSearch below only bind up at
          // astro:page-load time, which already fired against a shell that
          // had neither the table nor #team-stats-body yet. Re-dispatching
          // is the codebase's established fix (see hard-form-submit.ts's
          // doc comment) and every sitewide listener is safe against
          // firing twice.
          document.dispatchEvent(new Event('astro:page-load'));
        })
        .catch((err) => {
          console.error('Failed to load team stats:', err);
          container.innerHTML = '<p class="mt-10 text-white/60">Couldn’t load team stats right now — try refreshing the page.</p>';
        });
    }

    document.addEventListener('astro:page-load', initTeamStatsResults);

    // Click-to-expand itself is handled globally — see src/scripts/expandRows.ts.
    // Search-filter logic mirrors driver-stats.astro's own (see that page's
    // trailing script for the full reasoning on force-collapsing a filtered-
    // out row's detail panel). No-ops until team-stats/fragment.astro's
    // table has actually landed in the DOM (see initTeamStatsResults
    // above) — re-runs on the synthetic astro:page-load it dispatches once
    // that happens.
    function initTeamStatsSearch() {
      const body = document.getElementById('team-stats-body');
      const searchInput = document.getElementById('team-stats-search') as HTMLInputElement | null;
      const empty = document.getElementById('team-stats-search-empty');
      if (!body || !searchInput) return;

      function applyFilter() {
        const term = searchInput!.value.trim().toLowerCase();
        const rows = body!.querySelectorAll<HTMLTableRowElement>('[data-expand-row]');
        let visibleCount = 0;
        rows.forEach((row) => {
          const matches = !term || (row.dataset.search ?? '').includes(term);
          row.style.display = matches ? '' : 'none';
          if (matches) {
            visibleCount += 1;
          } else if (row.getAttribute('aria-expanded') === 'true') {
            const detail = row.nextElementSibling as HTMLElement | null;
            row.setAttribute('aria-expanded', 'false');
            detail?.classList.add('hidden');
            row.querySelector<HTMLElement>('[data-chevron]')?.classList.remove('rotate-90');
          }
        });
        if (empty) empty.classList.toggle('hidden', visibleCount > 0);
      }

      searchInput.addEventListener('input', applyFilter);
    }

    document.addEventListener('astro:page-load', initTeamStatsSearch);
  </script>
</Layout>
