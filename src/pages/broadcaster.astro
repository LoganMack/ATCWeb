---
export const prerender = false;

// The Broadcaster account's own page (broadcaster-staff-roles C7, FR1.8): its email and password only, since the
// Broadcaster has no driver profile. Signed-in Broadcaster only; anyone else goes to /my-profile, which sends them
// to their own page. One formData() read, an `intent`, the action through src/lib, then a redirect with a status
// that names a code, never an address. Signed-in only, so it is never edge-cached.
import Layout from '../layouts/Layout.astro';
import { resolveSupabaseEnv } from '../lib/db/client';
import { BROADCASTER_PATH, isBroadcasterAccount } from '../lib/auth';
import {
  IN_PLACE_STATUS_PARAMS,
  inPlaceStatusMessage,
  requestEmailChange,
  requestOwnPasswordReset,
  type InPlaceResult,
} from '../lib/driverAccount';

const session = Astro.locals.session;
if (!session) return Astro.redirect(`/login?next=${BROADCASTER_PATH}`, 302);
if (!isBroadcasterAccount(Astro.locals)) return Astro.redirect('/my-profile', 302);

const supabaseEnv = resolveSupabaseEnv(Astro.locals);
const owner = { accessToken: session.accessToken, user: session.user };

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const intent = String(form.get('intent') ?? '');
  if (intent === 'change-email') {
    const change = await requestEmailChange(
      supabaseEnv,
      owner,
      form.get('new_email'),
      `${Astro.url.origin}${BROADCASTER_PATH}`,
    );
    return Astro.redirect(`${BROADCASTER_PATH}?${IN_PLACE_STATUS_PARAMS['change-email']}=${change.status}`, 302);
  }
  if (intent === 'reset-password') {
    const status = await requestOwnPasswordReset(supabaseEnv, owner, `${Astro.url.origin}/reset-password`);
    return Astro.redirect(`${BROADCASTER_PATH}?${IN_PLACE_STATUS_PARAMS['reset-password']}=${status}`, 302);
  }
  return Astro.redirect(BROADCASTER_PATH, 302);
}

const emailNotice = inPlaceStatusMessage(
  'change-email',
  Astro.url.searchParams.get(IN_PLACE_STATUS_PARAMS['change-email']),
);
const passwordNotice = inPlaceStatusMessage(
  'reset-password',
  Astro.url.searchParams.get(IN_PLACE_STATUS_PARAMS['reset-password']),
);
const noticeClass = (notice: InPlaceResult | null) =>
  notice ? `text-sm ${notice.ok ? 'text-brand-primary' : 'text-brand-pink'}` : 'hidden';
const email = session.user.email;
const pendingEmail = session.user.newEmail ?? null;
const inputClass =
  'h-9 rounded-md border border-white/15 bg-white/5 px-3 text-sm text-white outline-none focus:border-brand-primary';
---

<Layout title="Broadcaster">
  <section class="mx-auto flex max-w-3xl flex-col px-6 pb-24 pt-8" data-testid="broadcaster-page">
    <h1 class="reveal font-display text-3xl sm:text-4xl">Broadcaster</h1>
    <p class="reveal mt-2 text-sm text-white/60" style="transition-delay: 40ms">
      This account views the site as a linked driver, without a driver profile, and is the only one with View as
      Broadcaster.
    </p>

    <div class="reveal mt-8 grid gap-6 lg:grid-cols-2" style="transition-delay: 60ms">
      <form method="POST" data-astro-reload class="flex min-w-0 flex-col gap-2 rounded-xl border border-white/10 bg-brand-ink p-5">
        <input type="hidden" name="intent" value="change-email" />
        <h2 class="font-display text-2xl">Email</h2>
        <p class="text-sm text-white/70" data-testid="broadcaster-email">{email ?? 'This account has no email address.'}</p>
        {pendingEmail && (
          <p class="text-sm text-white/70">
            Waiting for you to confirm {pendingEmail}. Click the link we emailed there (and the one sent to your current
            address, if one arrived).
          </p>
        )}
        <label class="mt-2 flex flex-col gap-1.5 text-sm">
          <span class="text-white/70">Change Email</span>
          <input
            type="email"
            name="new_email"
            required
            autocomplete="email"
            maxlength="254"
            class={`w-full ${inputClass}`}
            data-testid="broadcaster-new-email"
          />
        </label>
        <button type="submit" class="btn btn-neutral self-start" data-testid="broadcaster-change-email">
          Send confirmation link
        </button>
        <p role="status" class={noticeClass(emailNotice)}>{emailNotice?.message}</p>
      </form>

      <form method="POST" data-astro-reload class="flex min-w-0 flex-col gap-2 rounded-xl border border-white/10 bg-brand-ink p-5">
        <input type="hidden" name="intent" value="reset-password" />
        <h2 class="font-display text-2xl">Password</h2>
        <p class="text-sm text-white/70">We'll email a link to set a new password.</p>
        <button type="submit" class="btn btn-neutral self-start" data-testid="broadcaster-reset-password">
          Send password reset link
        </button>
        <p role="status" class={noticeClass(passwordNotice)}>{passwordNotice?.message}</p>
      </form>
    </div>

    <p class="reveal mt-6 text-xs text-white/40" style="transition-delay: 80ms">Email notifications are sent to drivers only.</p>
  </section>
</Layout>
