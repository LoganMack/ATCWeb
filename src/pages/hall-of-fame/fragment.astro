---
export const prerender = false;

import TeamLogo from '../../components/TeamLogo.astro';
import DriverFlag from '../../components/DriverFlag.astro';
import StatBlock from '../../components/StatBlock.astro';
import PhotoGrid from '../../components/PhotoGrid.astro';
import {
  resolveSupabaseEnv,
  getDriverClasses,
  getSeasons,
  getStandingsExcludedRoundIds,
  getHallOfFameDrivers,
  getAllHallOfFamePhotos,
  displayDriverName,
  type HallOfFamePhoto,
} from '../../lib/supabase';
import { computeDriverCareerStats, aggregateDriverCareerStats, type DriverCareerStats } from '../../lib/results';
import { classBadgeClasses } from '../../lib/classColors';

/**
 * Same shell-then-spinner split as champions/fragment.astro,
 * driver-stats/fragment.astro, and team-stats/fragment.astro —
 * hall-of-fame.astro now only renders the page banner and a loading
 * skeleton, then fetches THIS route client-side for the actual member
 * cards. This is where the expensive computeDriverCareerStats() call
 * (filtered down to Hall of Fame members) plus their photos now live, so
 * it no longer blocks the shell.
 *
 * Returns a bare HTML fragment — no <Layout>, no <html>/<head> — meant only
 * to be dropped into hall-of-fame.astro's results container via
 * `container.innerHTML = await res.text()`. Never linked to directly.
 */

const supabaseEnv = resolveSupabaseEnv(Astro.locals);

let loadError: string | null = null;
let members: (DriverCareerStats & { bio: string | null })[] = [];
let photosByDriver = new Map<string, HallOfFamePhoto[]>();
try {
  const [classes, seasons, exhibitionRoundIds, hofDrivers] = await Promise.all([
    getDriverClasses(supabaseEnv),
    getSeasons(supabaseEnv),
    getStandingsExcludedRoundIds(supabaseEnv),
    getHallOfFameDrivers(supabaseEnv),
  ]);
  const bioById = new Map(hofDrivers.map((d) => [d.id, d.bio]));
  if (bioById.size > 0) {
    // Reuses the exact same career-stats computation Driver Stats uses (see
    // src/lib/results.ts) rather than a separate query, so a Hall of Fame
    // member's numbers here can never drift from their Driver Stats row —
    // this just filters that full list down to the marked members
    // (0027_hall_of_fame.sql / admin/drivers' "Hall of Fame member" toggle).
    const [careerStats, allPhotos] = await Promise.all([
      computeDriverCareerStats(supabaseEnv, seasons, classes, exhibitionRoundIds),
      getAllHallOfFamePhotos(supabaseEnv),
    ]);
    for (const photo of allPhotos) {
      if (!photosByDriver.has(photo.driver_id)) photosByDriver.set(photo.driver_id, []);
      photosByDriver.get(photo.driver_id)!.push(photo);
    }
    members = careerStats
      .filter((c) => bioById.has(c.driver.id))
      .map((c) => ({ ...c, bio: bioById.get(c.driver.id) ?? null }));
  }
} catch (err) {
  console.error('Failed to compute Hall of Fame (fragment):', err);
  loadError = err instanceof Error ? err.message : String(err);
}

function raceWord(n: number): string {
  return `${n} race${n === 1 ? '' : 's'}`;
}

// Overall/Alpha/Gamma/Delta stat filter on each card (per Logan) — see the
// buttons below in the template for the full reasoning. Kept as a plain
// tuple (not `classes` from getDriverClasses) since these four labels are
// fixed regardless of what's actually on file, and "Overall" isn't a real
// driver_classes row to begin with.
const HOF_CLASS_KEYS = ['Overall', 'Alpha', 'Gamma', 'Delta'] as const;
type HofClassKey = (typeof HOF_CLASS_KEYS)[number];

interface HofExtras {
  statsByClass: Record<HofClassKey, DriverCareerStats>;
  defaultClass: HofClassKey;
}

// Precomputed here (frontmatter), not inline in the template's own
// members.map() below, because a `Record<HofClassKey, ...>` type
// annotation written INSIDE a template `{}` expression trips up Astro's
// compiler — the `<`/`>` of the generic reads as the start of a JSX tag to
// its expression-boundary scan, corrupting everything after it (reproduced
// live: adding that one annotated const inside the template map callback
// broke the whole file's build with an unrelated-looking esbuild parse
// error many lines later). Plain TS in frontmatter has no such issue.
const hofExtrasByDriverId = new Map<string, HofExtras>();
for (const entry of members) {
  const statsByClass: Record<HofClassKey, DriverCareerStats> = {
    Overall: entry,
    Alpha: aggregateDriverCareerStats(entry.driver, entry.seasons.filter((r) => r.className === 'Alpha')),
    Gamma: aggregateDriverCareerStats(entry.driver, entry.seasons.filter((r) => r.className === 'Gamma')),
    Delta: aggregateDriverCareerStats(entry.driver, entry.seasons.filter((r) => r.className === 'Delta')),
  };

  // Defaults to whichever class this member has made the most career
  // starts in — Overall instead if Alpha wins that tiebreak, per Logan
  // (Alpha is the default/entry class every driver starts in, so it isn't
  // informative to call out on its own the way a Gamma/Delta specialist's
  // class is; Overall already covers an Alpha-heavy career same as it
  // would for anyone else).
  let defaultClass: HofClassKey = 'Overall';
  let mostStarts = -1;
  for (const key of ['Alpha', 'Gamma', 'Delta'] as const) {
    if (statsByClass[key].starts > mostStarts) {
      mostStarts = statsByClass[key].starts;
      defaultClass = key;
    }
  }
  if (defaultClass === 'Alpha') defaultClass = 'Overall';

  hofExtrasByDriverId.set(entry.driver.id, { statsByClass, defaultClass });
}

Astro.response.headers.set('Cache-Control', 'public, s-maxage=60, stale-while-revalidate=300');
---

{loadError && (
  <p class="mt-4 rounded-lg border border-brand-pink/30 bg-brand-pink/10 p-4 text-sm text-white/80">
    Couldn't load the Hall of Fame right now.
    <br /><span class="mt-1 block text-white/50">{loadError}</span>
  </p>
)}

{!loadError && members.length === 0 && (
  <p class="mt-10 text-white/60">No Hall of Fame members yet.</p>
)}

{!loadError && members.length > 0 && (
  <div class="mt-8 flex flex-col gap-5">
    {members.map((entry, i) => {
      const name = displayDriverName(entry.driver.name);
      const hof = hofExtrasByDriverId.get(entry.driver.id)!;
      return (
        <div
          class="reveal overflow-hidden rounded-xl border border-white/10 bg-white/[0.03]"
          style={`transition-delay: ${Math.min(i, 4) * 30}ms`}
          data-hof-card
        >
          <div
            data-expand-row
            tabindex="0"
            role="button"
            aria-expanded="false"
            class="grid cursor-pointer gap-0 transition hover:bg-white/[0.02] sm:grid-cols-[264px_1fr]"
          >
            <PhotoGrid photos={photosByDriver.get(entry.driver.id) ?? []} altText={name} />

            <div class="p-6">
              <div class="flex flex-wrap items-center gap-2">
                <span
                  data-chevron
                  class="inline-block shrink-0 text-[10px] text-white/30 transition-transform duration-150"
                  aria-hidden="true"
                >
                  &#9654;
                </span>
                <h3 class="font-display text-3xl leading-none">
                  {name} {entry.driver.car_number !== null && <span class="text-white/40">#{entry.driver.car_number}</span>}
                </h3>
                <DriverFlag nationality1={entry.driver.nationality_1} nationality2={entry.driver.nationality_2} />

                {/* Overall/Alpha/Gamma/Delta stat filter (per Logan) — one
                    independent toggle per card, pushed to the right end of
                    the driver-name line via ml-auto. Click handling lives
                    in src/scripts/hofClassFilter.ts (delegated, scoped to
                    this card's own [data-hof-card] ancestor); expandRows.ts
                    has a matching guard so clicking a button here doesn't
                    also toggle the card's season-table row open/closed
                    underneath it, same as it already does for PhotoGrid's
                    lightbox buttons nested the same way. */}
                <div class="ml-auto flex flex-wrap gap-1.5">
                  {HOF_CLASS_KEYS.map((key) => (
                    <button
                      type="button"
                      data-hof-class-btn
                      data-hof-class-value={key}
                      class="rounded-lg px-3 py-1 text-xs font-semibold ring-1 ring-white/15 transition data-[active=true]:bg-white data-[active=true]:text-brand-ink"
                      data-active={key === hof.defaultClass ? 'true' : 'false'}
                    >
                      {key}
                    </button>
                  ))}
                </div>
              </div>

              {entry.bio && <p class="mt-3 max-w-2xl text-sm text-white/70">{entry.bio}</p>}

              {/* All four class variants render server-side; only the
                  default one starts visible, and hofClassFilter.ts just
                  toggles `hidden` on click rather than re-fetching or
                  re-rendering anything. */}
              {HOF_CLASS_KEYS.map((key) => (
                <dl
                  class={`mt-6 grid grid-cols-2 gap-x-4 gap-y-5 sm:grid-cols-4 ${key === hof.defaultClass ? '' : 'hidden'}`}
                  data-hof-stats-panel={key}
                >
                  <StatBlock label="Championships" value={hof.statsByClass[key].championships} />
                  <StatBlock label="Wins" value={hof.statsByClass[key].wins} sub={hof.statsByClass[key].starts ? `${hof.statsByClass[key].starts} starts` : undefined} />
                  <StatBlock label="Poles" value={hof.statsByClass[key].poles} />
                  <StatBlock label="Podiums" value={hof.statsByClass[key].podiums} />
                  <StatBlock label="Top 5" labelSuffixLower="s" value={hof.statsByClass[key].top5s} />
                  <StatBlock label="Top 10" labelSuffixLower="s" value={hof.statsByClass[key].top10s} />
                  <StatBlock label="Starts" value={hof.statsByClass[key].starts} />
                  <StatBlock label="Appearances" value={hof.statsByClass[key].appearances} />
                </dl>
              ))}
            </div>
          </div>

          <div data-detail-row class="hidden border-t border-white/10 bg-white/[0.02] p-4">
            <div data-sticky-thead>
              <table class="w-full min-w-[860px] border-collapse text-xs">
                <thead>
                  <tr class="border-b border-white/10 text-left text-[10px] uppercase tracking-wide text-white/30">
                    <th class="py-2 pr-3 font-medium">Season</th>
                    <th class="py-2 pr-3 font-medium">Class</th>
                    <th class="py-2 pr-3 font-medium">Car(s)</th>
                    <th class="py-2 pr-3 font-medium">Team(s)</th>
                    <th class="py-2 pr-3 text-center font-medium">Wins</th>
                    <th class="py-2 pr-3 text-center font-medium">Poles</th>
                    <th class="py-2 pr-3 text-center font-medium">Podiums</th>
                    <th class="py-2 pr-3 text-center font-medium">Top 5s</th>
                    <th class="py-2 pr-3 text-center font-medium">Top 10s</th>
                    <th class="py-2 pr-3 text-center font-medium">Laps</th>
                    <th class="py-2 pr-3 text-center font-medium">Led</th>
                    <th class="py-2 pr-3 text-center font-medium">CPI</th>
                    <th class="py-2 pr-3 text-center font-medium">Starts</th>
                    <th class="py-2 pr-3 text-center font-medium">Apps</th>
                    <th class="py-2 pr-3 text-center font-medium">Class Pos</th>
                    <th class="py-2 pr-3 text-center font-medium">Overall Pos</th>
                  </tr>
                </thead>
                <tbody>
                  {entry.seasons.map((r) => {
                    const seasonCpi = r.totalCorners !== null && r.incidents > 0 ? r.totalCorners / r.incidents : null;
                    return (
                      <tr class="border-b border-white/5">
                        <td class="py-2 pr-3 font-semibold text-white/90">{r.season.name}</td>
                        <td class="py-2 pr-3">
                          <span class={`rounded-lg border px-2 py-0.5 text-[10px] font-semibold uppercase tracking-wide ${classBadgeClasses(r.className)}`}>
                            {r.className}
                          </span>
                        </td>
                        <td class="py-2 pr-3">
                          <div class="flex flex-wrap items-center gap-1">
                            {r.cars.map((c) => (
                              <TeamLogo name={c.carName} logoUrl={c.logoUrl} size="h-5 w-5" title={`${c.carName} — ${raceWord(c.races)}`} tint />
                            ))}
                            {r.cars.length === 0 && <span class="text-white/30">—</span>}
                          </div>
                        </td>
                        <td class="py-2 pr-3">
                          <div class="flex flex-wrap items-center gap-1">
                            {r.teams.map((t) => (
                              <TeamLogo
                                name={t.teamName}
                                logoUrl={t.logoUrl}
                                size="h-5 w-5"
                                title={`${t.teamName} — ${raceWord(t.racesUnderTeam)} under this team, ${raceWord(t.racesScoredForTeam)} scored for the team`}
                              />
                            ))}
                            {r.teams.length === 0 && <span class="text-white/30">—</span>}
                          </div>
                        </td>
                        <td class="py-2 pr-3 text-center text-white/70">{r.wins}</td>
                        <td class="py-2 pr-3 text-center text-white/70">{r.poles}</td>
                        <td class="py-2 pr-3 text-center text-white/70">{r.podiums}</td>
                        <td class="py-2 pr-3 text-center text-white/70">{r.top5s}</td>
                        <td class="py-2 pr-3 text-center text-white/70">{r.top10s}</td>
                        <td class="py-2 pr-3 text-center text-white/70">{r.laps}</td>
                        <td class="py-2 pr-3 text-center text-white/70">{r.lapsLed}</td>
                        <td class="py-2 pr-3 text-center text-white/70">{seasonCpi !== null ? seasonCpi.toFixed(1) : '—'}</td>
                        <td class="py-2 pr-3 text-center text-white/70">{r.starts}</td>
                        <td class="py-2 pr-3 text-center text-white/70">{r.appearances}</td>
                        <td class="py-2 pr-3 text-center font-semibold text-white/90">{r.classPosition}</td>
                        <td class="py-2 pr-3 text-center text-white/70">{r.overallPosition ?? '—'}</td>
                      </tr>
                    );
                  })}
                </tbody>
              </table>
            </div>
          </div>
        </div>
      );
    })}
  </div>
)}
