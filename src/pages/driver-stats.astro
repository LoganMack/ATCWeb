---
export const prerender = false;
import LoadError from '../components/LoadError.astro';
import { markUncacheable } from '../lib/security';

import Layout from '../layouts/Layout.astro';
import StatsTabs from '../components/StatsTabs.astro';
import ClassFilterSelect from '../components/ClassFilterSelect.astro';
import { classFilterOptions, resolveClassFilter } from '../lib/results/classFilter';
import PageBanner from '../components/PageBanner.astro';
import { resolveSupabaseEnv } from '../lib/db/client';
import { getDriverClasses } from '../lib/db/lookups';
import { getPageBanners } from '../lib/db/assets';
import { bannerUrlFor } from '../lib/pageBanners';

// Shell: fetches only the driver classes for the filter tabs and renders a skeleton; the table comes from
// driver-stats/fragment.astro after this paints.

const supabaseEnv = resolveSupabaseEnv(Astro.locals);

// Kicked off immediately, in parallel with everything below — same reasoning
// as champions.astro's pageBannersPromise.
const pageBannersPromise = getPageBanners(supabaseEnv);

let classes: Awaited<ReturnType<typeof getDriverClasses>> = [];
let loadError: string | null = null;
try {
  classes = await getDriverClasses(supabaseEnv);
} catch (err) {
  console.error('Failed to load driver stats filters:', err);
  loadError = err instanceof Error ? err.message : String(err);
}

// The shared resolver (BR3.1): no class, or an unknown one, is Overall.
const classFilter = resolveClassFilter(Astro.url.searchParams.get('class'), classes);
const classOptions = classFilterOptions('/driver-stats', classFilter, classes);

let bannerUrl: string | null = null;
try {
  bannerUrl = bannerUrlFor(await pageBannersPromise, 'driver-stats');
} catch (err) {
  console.error('Failed to load page banner:', err);
}

Astro.response.headers.set('Cache-Control', 'public, s-maxage=60, stale-while-revalidate=300');
if (loadError) markUncacheable(Astro);
---

<Layout title="Driver Stats" description="Career statistics for every driver who has ever raced in Alpha Touring Challenge.">
  <section class="relative mx-auto max-w-6xl px-6 pb-24 pt-8">
    <PageBanner imageUrl={bannerUrl} />
    <h1 class="reveal font-display text-2xl sm:text-5xl">Driver Stats</h1>

    {loadError && <LoadError />}

    {!loadError && (
      <div class="reveal mt-12 relative z-30 rounded-xl border border-white/10 bg-brand-ink p-4">
       <div class="flex flex-wrap items-end gap-3">
        <StatsTabs active="drivers" />
        <input
          type="search"
          id="driver-stats-search"
          placeholder="Search drivers…"
          class="search-input h-9 rounded-md border border-white/15 bg-transparent px-3 text-sm text-white outline-none hover:bg-white/5 focus:border-brand-primary focus:bg-white/5"
        />
        <ClassFilterSelect options={classOptions} />
       </div>
      </div>
    )}

    {!loadError && (
      <div data-driver-stats-results data-fragment-url={`/driver-stats/fragment${Astro.url.search}`}>
        <div class="mt-6 flex flex-col gap-2" aria-live="polite" aria-busy="true">
          <span class="sr-only">Loading driver stats…</span>
          <div class="h-9 animate-pulse rounded-lg border border-white/10 bg-white/[0.03]"></div>
          <div class="h-64 animate-pulse rounded-xl border border-white/10 bg-white/[0.02]"></div>
        </div>
      </div>
    )}
  </section>

  <script>
    import { bindFragment } from '../scripts/fragmentLoader';

    bindFragment('[data-driver-stats-results]', {
      label: 'Driver stats',
      logMessage: 'Failed to load driver stats:',
      errorHtml:
        '<p class="mt-10 text-white/60">Couldn’t load driver stats right now — try refreshing the page.</p>',
    });

    // Row expand/collapse is the global src/scripts/expandRows.ts.

    // Filters the table by driver name and collapses a hidden row's open detail row, which carries no
    // data-search. Waits for the fragment, re-running on its astro:page-load.
    function initDriverStatsSearch() {
      const body = document.getElementById('driver-stats-body');
      const searchInput = document.getElementById('driver-stats-search') as HTMLInputElement | null;
      const empty = document.getElementById('driver-stats-search-empty');
      if (!body || !searchInput) return;

      function applyFilter() {
        const term = searchInput!.value.trim().toLowerCase();
        const rows = body!.querySelectorAll<HTMLTableRowElement>('[data-expand-row]');
        let visibleCount = 0;
        rows.forEach((row) => {
          const matches = !term || (row.dataset.search ?? '').includes(term);
          row.style.display = matches ? '' : 'none';
          if (matches) {
            visibleCount += 1;
          } else if (row.getAttribute('aria-expanded') === 'true') {
            const detail = row.nextElementSibling as HTMLElement | null;
            row.setAttribute('aria-expanded', 'false');
            detail?.classList.add('hidden');
            row.querySelector<HTMLElement>('[data-chevron]')?.classList.remove('rotate-90');
          }
        });
        if (empty) empty.classList.toggle('hidden', visibleCount > 0);
      }

      searchInput.addEventListener('input', applyFilter);
    }

    document.addEventListener('astro:page-load', initDriverStatsSearch);
  </script>
</Layout>
