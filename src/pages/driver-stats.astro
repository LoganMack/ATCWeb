---
export const prerender = false;

import Layout from '../layouts/Layout.astro';
import HistoryTabs from '../components/HistoryTabs.astro';
import PageBanner from '../components/PageBanner.astro';
import { resolveSupabaseEnv, getDriverClasses, getPageBanners } from '../lib/supabase';
import { bannerUrlFor } from '../lib/pageBanners';

// Same shell-then-spinner split as champions.astro/champions/fragment.astro
// (PERFORMANCE_AUDIT.md #5) — this page used to await the full
// computeDriverCareerStats() call (every driver's whole season-by-season
// history) right here in its own frontmatter, which blocked Astro's client
// router from swapping the DOM until that finished. Now this shell only
// fetches what it needs to render the class-filter tabs immediately
// (driver classes — cheap, same shape as any other page's reference-table
// lookup) and renders a loading skeleton in place of the table. The
// expensive part moved to driver-stats/fragment.astro, fetched client-side
// by the <script> below once this shell has already painted.

const supabaseEnv = resolveSupabaseEnv(Astro.locals);

// Kicked off immediately, in parallel with everything below — same reasoning
// as champions.astro's pageBannersPromise.
const pageBannersPromise = getPageBanners(supabaseEnv);

let classes: Awaited<ReturnType<typeof getDriverClasses>> = [];
let loadError: string | null = null;
try {
  classes = await getDriverClasses(supabaseEnv);
} catch (err) {
  console.error('Failed to load driver stats filters:', err);
  loadError = err instanceof Error ? err.message : String(err);
}

const requestedClassName = Astro.url.searchParams.get('class');
const activeClass = classes.find((c) => c.name === requestedClassName) ?? null;

let bannerUrl: string | null = null;
try {
  bannerUrl = bannerUrlFor(await pageBannersPromise, 'driver-stats');
} catch (err) {
  console.error('Failed to load page banner:', err);
}

Astro.response.headers.set('Cache-Control', 'public, s-maxage=60, stale-while-revalidate=300');
---

<Layout title="Driver Stats" description="Career statistics for every driver who has ever raced in Alpha Touring Challenge.">
  <section class="relative mx-auto max-w-6xl overflow-hidden px-6 pb-24 pt-28 sm:pt-36">
    <PageBanner imageUrl={bannerUrl} />
    <h1 class="reveal font-display text-5xl">Driver Stats</h1>

    <HistoryTabs active="driverStats" />

    {loadError && (
      <p class="mt-4 rounded-lg border border-brand-pink/30 bg-brand-pink/10 p-4 text-sm text-white/80">
        Couldn't load driver stats right now.
        <br /><span class="mt-1 block text-white/50">{loadError}</span>
      </p>
    )}

    {!loadError && (
      <div class="mt-8 flex flex-wrap gap-2">
        <a
          href="/driver-stats"
          class={`rounded-lg px-4 py-1.5 text-sm font-semibold ring-1 ring-white/15 transition ${
            !activeClass ? 'bg-white text-brand-ink' : 'text-white/80 hover:bg-white/10'
          }`}
        >
          Overall
        </a>
        {classes.map((c) => (
          <a
            href={`/driver-stats?class=${encodeURIComponent(c.name)}`}
            class={`rounded-lg px-4 py-1.5 text-sm font-semibold ring-1 ring-white/15 transition ${
              activeClass?.id === c.id ? 'bg-white text-brand-ink' : 'text-white/80 hover:bg-white/10'
            }`}
          >
            {c.name}
          </a>
        ))}
      </div>
    )}

    {!loadError && (
      <div class="mt-4 max-w-sm">
        <input
          type="search"
          id="driver-stats-search"
          placeholder="Search drivers…"
          class="w-full rounded-md border border-white/15 bg-white/5 px-3 py-2 text-white outline-none focus:border-brand-primary"
        />
      </div>
    )}

    {!loadError && (
      <div data-driver-stats-results data-fragment-url={`/driver-stats/fragment${Astro.url.search}`}>
        <div class="mt-6 flex flex-col gap-2" aria-live="polite" aria-busy="true">
          <span class="sr-only">Loading driver stats…</span>
          <div class="h-10 animate-pulse rounded-lg border border-white/10 bg-white/[0.03]"></div>
          <div class="h-64 animate-pulse rounded-xl border border-white/10 bg-white/[0.02]"></div>
        </div>
      </div>
    )}
  </section>

  <script>
    // Fetches driver-stats/fragment.astro (the expensive
    // computeDriverCareerStats table) client-side once this shell has
    // already painted — see this file's top-of-file comment and
    // driver-stats/fragment.astro for the full explanation.
    function initDriverStatsResults() {
      const container = document.querySelector<HTMLElement>('[data-driver-stats-results]');
      const url = container?.dataset.fragmentUrl;
      if (!container || !url) return;
      // Cleared immediately, before the fetch even resolves — this
      // function re-runs on every astro:page-load, including the
      // synthetic one dispatched below once the fragment lands. Without
      // this guard that synthetic dispatch would see the same
      // data-fragment-url still sitting on the container and kick off
      // another fetch, which would dispatch again, forever.
      delete container.dataset.fragmentUrl;

      fetch(url)
        .then((res) => {
          if (!res.ok) throw new Error(`Driver stats fragment request failed (${res.status})`);
          return res.text();
        })
        .then((html) => {
          container.innerHTML = html;
          // This table (and this page's own search box, via
          // initDriverStatsSearch below) only bind up at astro:page-load
          // time — sortable-table.ts binds each <table data-sortable>'s
          // headers then, and initDriverStatsSearch looks up
          // #driver-stats-body then. Both already ran once against a shell
          // that had neither element yet. Re-dispatching the same event is
          // the codebase's own established fix for "content changed
          // without a real navigation" (see hard-form-submit.ts's doc
          // comment) — every sitewide astro:page-load listener re-scans or
          // is guarded per-element, so firing it again here is safe.
          document.dispatchEvent(new Event('astro:page-load'));
        })
        .catch((err) => {
          console.error('Failed to load driver stats:', err);
          container.innerHTML = '<p class="mt-10 text-white/60">Couldn’t load driver stats right now — try refreshing the page.</p>';
        });
    }

    document.addEventListener('astro:page-load', initDriverStatsResults);

    // Click-to-expand itself is handled globally now — see
    // src/scripts/expandRows.ts (a single delegated listener for every
    // `[data-expand-row]`/`[data-detail-row]` pair on the site, fixing a
    // real bug the old per-page copy of this had: no de-dup guard, so a
    // second `astro:page-load` firing for the same content would double-
    // bind every row's listener, making a click toggle open-then-closed
    // in the same event — i.e. look like nothing happened until a full
    // reload cleared the duplicate binding).

    // Filters the career table by driver name. A hidden row's detail panel
    // (if it happened to be open) gets force-collapsed too — otherwise an
    // expanded season table could be left dangling below a row that just
    // disappeared, since the summary and detail rows are two independent
    // <tr> elements and only the summary row carries data-search. No-ops
    // until driver-stats/fragment.astro's table has actually landed in the
    // DOM (see initDriverStatsResults above) — re-runs on the synthetic
    // astro:page-load it dispatches once that happens.
    function initDriverStatsSearch() {
      const body = document.getElementById('driver-stats-body');
      const searchInput = document.getElementById('driver-stats-search') as HTMLInputElement | null;
      const empty = document.getElementById('driver-stats-search-empty');
      if (!body || !searchInput) return;

      function applyFilter() {
        const term = searchInput!.value.trim().toLowerCase();
        const rows = body!.querySelectorAll<HTMLTableRowElement>('[data-expand-row]');
        let visibleCount = 0;
        rows.forEach((row) => {
          const matches = !term || (row.dataset.search ?? '').includes(term);
          row.style.display = matches ? '' : 'none';
          if (matches) {
            visibleCount += 1;
          } else if (row.getAttribute('aria-expanded') === 'true') {
            const detail = row.nextElementSibling as HTMLElement | null;
            row.setAttribute('aria-expanded', 'false');
            detail?.classList.add('hidden');
            row.querySelector<HTMLElement>('[data-chevron]')?.classList.remove('rotate-90');
          }
        });
        if (empty) empty.classList.toggle('hidden', visibleCount > 0);
      }

      searchInput.addEventListener('input', applyFilter);
    }

    document.addEventListener('astro:page-load', initDriverStatsSearch);
  </script>
</Layout>
