---
export const prerender = false;

import Layout from '../layouts/Layout.astro';
import HistoryTabs from '../components/HistoryTabs.astro';
import PageBanner from '../components/PageBanner.astro';
import { resolveSupabaseEnv } from '../lib/db/client';
import { getPageBanners } from '../lib/db/assets';
import { bannerUrlFor } from '../lib/pageBanners';

// Shell: needs only the page banner; the member cards come from hall-of-fame/fragment.astro after this
// paints.

const supabaseEnv = resolveSupabaseEnv(Astro.locals);

let bannerUrl: string | null = null;
try {
  bannerUrl = bannerUrlFor(await getPageBanners(supabaseEnv), 'hall-of-fame');
} catch (err) {
  console.error('Failed to load page banner:', err);
}

Astro.response.headers.set('Cache-Control', 'public, s-maxage=60, stale-while-revalidate=300');
---

<Layout title="Hall of Fame" description="Alpha Touring Challenge's Hall of Fame.">
  <section class="relative mx-auto max-w-5xl px-6 pb-24 pt-8">
    <PageBanner imageUrl={bannerUrl} />
    <h1 class="reveal font-display text-2xl sm:text-5xl">Hall of Fame</h1>

    <div class="reveal mt-12 relative z-30 rounded-xl border border-white/10 bg-brand-ink p-4">
      <div class="flex flex-wrap items-end gap-3">
        <HistoryTabs active="hallOfFame" />
      </div>
    </div>

    <div data-hof-results data-fragment-url="/hall-of-fame/fragment">
      <div class="mt-8 flex flex-col gap-5" aria-live="polite" aria-busy="true">
        <span class="sr-only">Loading Hall of Fame…</span>
        <div class="h-40 animate-pulse rounded-xl border border-white/10 bg-white/[0.03]"></div>
        <div class="h-40 animate-pulse rounded-xl border border-white/10 bg-white/[0.03]"></div>
      </div>
    </div>
  </section>

  <script>
    import { bindFragment } from '../scripts/fragmentLoader';

    // The re-dispatched astro:page-load is here for reveal.ts (the `.reveal`
    // member cards); expandRows.ts and lightbox.ts are delegation-based and
    // need no re-init.
    bindFragment('[data-hof-results]', {
      label: 'Hall of Fame',
      logMessage: 'Failed to load Hall of Fame:',
      errorHtml:
        '<p class="mt-10 text-white/60">Couldn’t load the Hall of Fame right now — try refreshing the page.</p>',
    });
  </script>
</Layout>

<script>
  import '../scripts/hofClassFilter';
  import '../scripts/lightbox';
</script>
