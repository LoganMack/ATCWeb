---
export const prerender = false;

import Layout from '../layouts/Layout.astro';
import HistoryTabs from '../components/HistoryTabs.astro';
import PageBanner from '../components/PageBanner.astro';
import { resolveSupabaseEnv, getPageBanners } from '../lib/supabase';
import { bannerUrlFor } from '../lib/pageBanners';

// Same shell-then-spinner split as champions.astro / driver-stats.astro /
// team-stats.astro (PERFORMANCE_AUDIT.md #5) — this page used to await the
// full computeDriverCareerStats() call (filtered down to Hall of Fame
// members) plus every member's photos right here in its own frontmatter,
// blocking Astro's client router from swapping the DOM until that
// finished. Like team-stats.astro this page has no filter tabs of its
// own, so the shell only needs the page banner before it can render —
// everything else lives in hall-of-fame/fragment.astro now, fetched
// client-side by the <script> below once this shell has already painted.

const supabaseEnv = resolveSupabaseEnv(Astro.locals);

let bannerUrl: string | null = null;
try {
  bannerUrl = bannerUrlFor(await getPageBanners(supabaseEnv), 'hall-of-fame');
} catch (err) {
  console.error('Failed to load page banner:', err);
}

Astro.response.headers.set('Cache-Control', 'public, s-maxage=60, stale-while-revalidate=300');
---

<Layout title="Hall of Fame" description="Alpha Touring Challenge's Hall of Fame.">
  <section class="relative mx-auto max-w-5xl overflow-hidden px-6 pb-24 pt-28 sm:pt-36">
    <PageBanner imageUrl={bannerUrl} />
    <h1 class="reveal font-display text-5xl">Hall of Fame</h1>

    <HistoryTabs active="hallOfFame" />

    <div data-hof-results data-fragment-url="/hall-of-fame/fragment">
      <div class="mt-8 flex flex-col gap-5" aria-live="polite" aria-busy="true">
        <span class="sr-only">Loading Hall of Fame…</span>
        <div class="h-40 animate-pulse rounded-xl border border-white/10 bg-white/[0.03]"></div>
        <div class="h-40 animate-pulse rounded-xl border border-white/10 bg-white/[0.03]"></div>
      </div>
    </div>
  </section>

  <script>
    // Fetches hall-of-fame/fragment.astro (the expensive
    // computeDriverCareerStats + photos work) client-side once this shell
    // has already painted — see this file's top-of-file comment and
    // hall-of-fame/fragment.astro for the full explanation.
    function initHallOfFameResults() {
      const container = document.querySelector<HTMLElement>('[data-hof-results]');
      const url = container?.dataset.fragmentUrl;
      if (!container || !url) return;
      // Cleared immediately, before the fetch even resolves — same guard
      // as driver-stats.astro/team-stats.astro, for the same reason (this
      // function re-runs on the synthetic astro:page-load dispatched below
      // once the fragment lands, and without this it would refetch
      // forever).
      delete container.dataset.fragmentUrl;

      fetch(url)
        .then((res) => {
          if (!res.ok) throw new Error(`Hall of Fame fragment request failed (${res.status})`);
          return res.text();
        })
        .then((html) => {
          container.innerHTML = html;
          // Same reasoning as driver-stats.astro/team-stats.astro:
          // reveal.ts's IntersectionObserver (for the `.reveal` member
          // cards) only ever looked at what existed in the DOM at the real
          // astro:page-load — this content lands well after that.
          // Re-dispatching is the codebase's established fix (see
          // hard-form-submit.ts's doc comment); expandRows.ts and
          // lightbox.ts (used inside each card's PhotoGrid) are both fully
          // delegation-based already, so they need no re-init at all — this
          // dispatch is here purely for reveal.ts.
          document.dispatchEvent(new Event('astro:page-load'));
        })
        .catch((err) => {
          console.error('Failed to load Hall of Fame:', err);
          container.innerHTML = '<p class="mt-10 text-white/60">Couldn’t load the Hall of Fame right now — try refreshing the page.</p>';
        });
    }

    document.addEventListener('astro:page-load', initHallOfFameResults);
  </script>
</Layout>
