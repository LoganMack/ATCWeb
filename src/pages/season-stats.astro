---
export const prerender = false;

import Layout from '../layouts/Layout.astro';
import StatsTabs from '../components/StatsTabs.astro';
import PageBanner from '../components/PageBanner.astro';
import { resolveSupabaseEnv } from '../lib/db/client';
import { getPageBanners } from '../lib/db/assets';
import { bannerUrlFor } from '../lib/pageBanners';
import { parseSeasonStatsScope } from '../lib/results/seasonStats';

// Shell: needs only the banner; the table comes from season-stats/fragment.astro after this paints.

const supabaseEnv = resolveSupabaseEnv(Astro.locals);

// Unknown values fall back to Overall (BR5.4). A real navigation, so the fragment URL is right from the start.
const scope = parseSeasonStatsScope(Astro.url.searchParams.get('class'));
const classOptions = [
  { value: 'overall', label: 'Overall', href: '/season-stats' },
  { value: 'alpha', label: 'Alpha', href: '/season-stats?class=alpha' },
  { value: 'gamma', label: 'Gamma', href: '/season-stats?class=gamma' },
  { value: 'delta', label: 'Delta', href: '/season-stats?class=delta' },
];
const fragmentUrl = scope === 'overall' ? '/season-stats/fragment' : `/season-stats/fragment?class=${scope}`;

let bannerUrl: string | null = null;
try {
  bannerUrl = bannerUrlFor(await getPageBanners(supabaseEnv), 'season-stats');
} catch (err) {
  console.error('Failed to load page banner:', err);
}

Astro.response.headers.set('Cache-Control', 'public, s-maxage=60, stale-while-revalidate=300');
---

<Layout title="Season Stats" description="Season-by-season statistics for every Alpha Touring Challenge championship.">
  <section class="relative mx-auto max-w-6xl px-6 pb-24 pt-8">
    <PageBanner imageUrl={bannerUrl} />
    <h1 class="reveal font-display text-2xl sm:text-5xl">Season Stats</h1>

    <div class="reveal mt-12 relative z-30 rounded-xl border border-white/10 bg-brand-ink p-4">
      <div class="flex flex-wrap items-end gap-3">
        <StatsTabs active="seasons" />
        <input
          type="search"
          id="season-stats-search"
          aria-label="Search seasons"
          placeholder="Search seasons…"
          class="search-input h-9 rounded-md border border-white/15 bg-transparent px-3 text-sm text-white outline-none hover:bg-white/5 focus:border-brand-primary focus:bg-white/5"
        />
        {/* Each option's value is its destination URL; onchange just navigates there. */}
        <label class="flex flex-col gap-1.5 sm:w-44">
          <span class="text-xs font-semibold uppercase tracking-wide text-white/40">Class</span>
          <select
            aria-label="Class"
            class="h-9 w-full rounded-md border border-white/15 bg-transparent px-3 text-sm text-white outline-none hover:bg-white/5 focus:border-brand-primary focus:bg-white/5"
            data-navigate-on-change
          >
            {classOptions.map((o) => (
              <option value={o.href} selected={o.value === scope} class="bg-brand-ink text-white">{o.label}</option>
            ))}
          </select>
        </label>
      </div>
    </div>

    <div data-season-stats-results data-fragment-url={fragmentUrl}>
      <div class="mt-6 flex flex-col gap-2" aria-live="polite" aria-busy="true">
        <span class="sr-only">Loading season stats…</span>
        <div class="h-9 animate-pulse rounded-lg border border-white/10 bg-white/[0.03]"></div>
        <div class="h-64 animate-pulse rounded-xl border border-white/10 bg-white/[0.02]"></div>
      </div>
    </div>
  </section>

  <script>
    import { bindFragment } from '../scripts/fragmentLoader';

    bindFragment('[data-season-stats-results]', {
      label: 'Season stats',
      logMessage: 'Failed to load season stats:',
      errorHtml:
        '<p class="mt-10 text-white/60">Couldn’t load season stats right now — try refreshing the page.</p>',
    });

    // Search by season name (BR5.5); waits for the fragment's astro:page-load.
    function initSeasonStatsSearch() {
      const body = document.getElementById('season-stats-body');
      const searchInput = document.getElementById('season-stats-search') as HTMLInputElement | null;
      const empty = document.getElementById('season-stats-search-empty');
      if (!body || !searchInput) return;

      function applyFilter() {
        const term = searchInput!.value.trim().toLowerCase();
        let visibleCount = 0;
        body!.querySelectorAll<HTMLTableRowElement>('tr[data-season-name]').forEach((row) => {
          const matches = !term || (row.dataset.seasonName ?? '').includes(term);
          row.style.display = matches ? '' : 'none';
          if (matches) visibleCount += 1;
        });
        if (empty) empty.classList.toggle('hidden', visibleCount > 0);
      }

      searchInput.addEventListener('input', applyFilter);
      applyFilter();
    }

    document.addEventListener('astro:page-load', initSeasonStatsSearch);
  </script>
</Layout>
