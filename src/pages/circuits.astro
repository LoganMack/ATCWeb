---
export const prerender = false;

import Layout from '../layouts/Layout.astro';
import HistoryTabs from '../components/HistoryTabs.astro';
import PageBanner from '../components/PageBanner.astro';
import {
  resolveSupabaseEnv,
  getCircuits,
  getAllCircuitLayouts,
  formatLapTime,
  formatDate,
  displayLayoutName,
  layoutImageUrl,
  getPageBanners,
  type CircuitLayout,
} from '../lib/supabase';
import { bannerUrlFor } from '../lib/pageBanners';

const supabaseEnv = resolveSupabaseEnv(Astro.locals);

let circuits: Awaited<ReturnType<typeof getCircuits>> = [];
let layouts: CircuitLayout[] = [];
let loadError = false;
try {
  [circuits, layouts] = await Promise.all([getCircuits(supabaseEnv), getAllCircuitLayouts(supabaseEnv)]);
} catch (err) {
  console.error('Failed to load circuits:', err);
  loadError = true;
}

let bannerUrl: string | null = null;
try {
  bannerUrl = bannerUrlFor(await getPageBanners(supabaseEnv), 'circuits');
} catch (err) {
  console.error('Failed to load page banner:', err);
}

const layoutsByCircuit = new Map<string, CircuitLayout[]>();
for (const l of layouts) {
  if (!layoutsByCircuit.has(l.circuit_id)) layoutsByCircuit.set(l.circuit_id, []);
  layoutsByCircuit.get(l.circuit_id)!.push(l);
}

Astro.response.headers.set('Cache-Control', 'public, s-maxage=60, stale-while-revalidate=300');
---

<Layout title="Circuits" description="Every circuit Alpha Touring Challenge has raced, with each layout's lap record.">
  <section class="relative mx-auto max-w-5xl overflow-hidden px-6 pb-24 pt-28 sm:pt-36">
    <PageBanner imageUrl={bannerUrl} />
    <h1 class="reveal font-display text-5xl">Circuits</h1>

    <HistoryTabs active="circuits" />

    {loadError && (
      <p class="mt-4 rounded-lg border border-brand-pink/30 bg-brand-pink/10 p-4 text-sm text-white/80">
        Couldn't load circuits right now — check that PUBLIC_SUPABASE_URL and PUBLIC_SUPABASE_ANON_KEY are set.
      </p>
    )}

    {!loadError && circuits.length === 0 && <p class="mt-10 text-white/60">No results.</p>}

    {!loadError && circuits.length > 0 && (
      <div class="reveal mt-8 max-w-sm" style="transition-delay: 80ms">
        <input
          type="search"
          id="circuit-search"
          placeholder="Search circuits or layouts…"
          class="w-full rounded-md border border-white/15 bg-white/5 px-3 py-2 text-white outline-none focus:border-brand-primary"
        />
      </div>
    )}

    {!loadError && circuits.length > 0 && (
      <div class="mt-4 flex flex-col gap-3" id="circuit-list">
        {circuits.map((circuit) => {
          const circuitLayouts = layoutsByCircuit.get(circuit.id) ?? [];
          const searchText = [circuit.name, ...circuitLayouts.map((l) => displayLayoutName(l.name))]
            .join(' ')
            .toLowerCase();
          return (
            <details class="group rounded-xl border border-white/10 bg-white/[0.03] transition open:bg-white/[0.05]" data-search={searchText}>
              <summary class="flex cursor-pointer list-none items-center gap-4 p-4">
                {circuit.logo_url ? (
                  <img src={circuit.logo_url} alt="" class="h-10 w-10 flex-none rounded object-contain" />
                ) : (
                  <div class="h-10 w-10 flex-none rounded bg-white/10"></div>
                )}
                <div>
                  <p class="font-semibold">{circuit.name}</p>
                  <p class="text-xs text-white/50">{circuit.location ?? '—'}</p>
                </div>
                <span class="ml-auto flex-none text-white/40 transition group-open:rotate-180">▾</span>
              </summary>
              <div class="border-t border-white/10 p-4">
                {circuitLayouts.length === 0 ? (
                  <p class="text-sm text-white/40">No results.</p>
                ) : (
                  <div class="grid gap-3 sm:grid-cols-2">
                    {circuitLayouts.map((layout) => {
                      const imageUrl = layoutImageUrl(layout, circuit);
                      return (
                        <div class="flex gap-3 rounded-lg bg-white/5 p-3 text-sm ring-1 ring-white/10">
                          {imageUrl ? (
                            <img src={imageUrl} alt="" class="h-14 w-14 flex-none rounded object-cover" />
                          ) : (
                            <div class="h-14 w-14 flex-none rounded bg-white/10"></div>
                          )}
                          <div>
                            <p class="font-semibold">{displayLayoutName(layout.name)}</p>
                            <p class="mt-1 text-xs text-white/50">{layout.length_km !== null ? `${layout.length_km} km` : '—'}</p>
                            <p class="mt-1 text-xs text-white/50">
                              {layout.lap_record_seconds !== null ? `Record ${formatLapTime(layout.lap_record_seconds)}` : 'No lap record on file'}
                              {layout.lap_record_holder && ` — ${layout.lap_record_holder}`}
                              {layout.lap_record_date && ` (${formatDate(layout.lap_record_date)})`}
                            </p>
                          </div>
                        </div>
                      );
                    })}
                  </div>
                )}
              </div>
            </details>
          );
        })}
      </div>
    )}

    {!loadError && circuits.length > 0 && (
      <p id="circuit-search-empty" class="mt-4 hidden text-white/60">No results.</p>
    )}
  </section>

  <script>
    // Plain substring search across each circuit's name + its layouts'
    // display names (data-search, lowercased server-side) — same
    // show/hide-via-inline-style approach the roster/teams filters use.
    function initCircuitSearch() {
      const input = document.getElementById('circuit-search') as HTMLInputElement | null;
      const list = document.getElementById('circuit-list');
      const empty = document.getElementById('circuit-search-empty');
      if (!input || !list) return;

      function applySearch() {
        const q = input!.value.trim().toLowerCase();
        const items = list!.querySelectorAll<HTMLElement>('[data-search]');
        let visibleCount = 0;
        items.forEach((item) => {
          const matches = !q || (item.dataset.search ?? '').includes(q);
          item.style.display = matches ? '' : 'none';
          if (matches) visibleCount += 1;
        });
        if (empty) empty.classList.toggle('hidden', visibleCount > 0);
      }

      input.addEventListener('input', applySearch);
      applySearch();
    }

    document.addEventListener('astro:page-load', initCircuitSearch);
  </script>
</Layout>
