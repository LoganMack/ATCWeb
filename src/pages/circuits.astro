---
export const prerender = false;
import LoadError from '../components/LoadError.astro';
import { markUncacheable } from '../lib/security';

import Layout from '../layouts/Layout.astro';
import HistoryTabs from '../components/HistoryTabs.astro';
import PageBanner from '../components/PageBanner.astro';
import { resolveSupabaseEnv } from '../lib/db/client';
import {
  getCircuits,
  getAllCircuitLayouts,
  getCircuitLogoBackgrounds,
  logoBgAttrs,
  type LogoBackground,
  formatLapTime,
  formatDate,
  displayLayoutName,
  layoutImageUrl,
  type Circuit,
  type CircuitLayout,
} from '../lib/db/circuits';
import { getPageBanners } from '../lib/db/assets';
import { bannerUrlFor } from '../lib/pageBanners';

const supabaseEnv = resolveSupabaseEnv(Astro.locals);

// Independent of the circuits/layouts fetch below — kicked off here and
// awaited just before the template needs it, so it runs concurrently with
// that block instead of after it.
const bannerPromise = (async () => {
  try {
    return bannerUrlFor(await getPageBanners(supabaseEnv), 'circuits');
  } catch (err) {
    console.error('Failed to load page banner:', err);
    return null;
  }
})();

let circuits: Circuit[] = [];
let layouts: CircuitLayout[] = [];
let logoBackgrounds: Record<string, LogoBackground> = {};
let loadError = false;
try {
  const [circuitsResult, layoutsResult, logoBgResult] = await Promise.all([getCircuits(supabaseEnv), getAllCircuitLayouts(supabaseEnv), getCircuitLogoBackgrounds(supabaseEnv)]);
  circuits = circuitsResult;
  layouts = layoutsResult;
  logoBackgrounds = logoBgResult;
} catch (err) {
  console.error('Failed to load circuits:', err);
  loadError = true;
}

const bannerUrl = await bannerPromise;

// One flat, searchable row per layout (Logan): image, circuit, layout and the curated record, each expanding
// into the layout's history from circuits/layout-detail/[layoutId].astro, loaded on first expand.
const circuitById = new Map(circuits.map((c) => [c.id, c]));
const sortedLayouts = [...layouts].sort((a, b) => {
  const circuitCompare = (circuitById.get(a.circuit_id)?.name ?? '').localeCompare(circuitById.get(b.circuit_id)?.name ?? '');
  if (circuitCompare !== 0) return circuitCompare;
  return displayLayoutName(a.name).localeCompare(displayLayoutName(b.name));
});

Astro.response.headers.set('Cache-Control', 'public, s-maxage=60, stale-while-revalidate=300');
if (loadError) markUncacheable(Astro);
---

<Layout title="Circuits" description="Every circuit Alpha Touring Challenge has raced, with each layout's lap record.">
  <section class="relative mx-auto max-w-5xl px-6 pb-24 pt-8">
    <PageBanner imageUrl={bannerUrl} />
    <h1 class="reveal font-display text-2xl sm:text-5xl">Circuits</h1>

    {loadError && <LoadError />}

    {!loadError && sortedLayouts.length === 0 && <p class="mt-10 text-white/60">No results.</p>}

    {!loadError && sortedLayouts.length > 0 && (
      <div class="reveal mt-12 relative z-30 rounded-xl border border-white/10 bg-brand-ink p-4" style="transition-delay: 80ms">
       <div class="flex flex-wrap items-end gap-3">
        <HistoryTabs active="circuits" />
        <input
          type="search"
          id="circuit-search"
          placeholder="Search circuits or layouts…"
          class="h-9 min-w-[14rem] flex-1 rounded-md border border-white/15 bg-transparent px-3 text-sm text-white outline-none hover:bg-white/5 focus:border-brand-primary focus:bg-white/5"
        />
       </div>
      </div>
    )}

    {!loadError && sortedLayouts.length > 0 && (
      <div class="reveal mt-6 rounded-xl border border-white/10" style="transition-delay: 100ms" data-sticky-thead>
        <table class="w-full border-collapse text-sm">
          <thead>
            <tr class="border-b border-white/10 text-left text-xs uppercase tracking-wide text-white/40">
              <th class="py-3 pl-4 pr-2 font-medium">Circuit</th>
              <th class="py-3 pr-2 font-medium">Layout</th>
              <th class="py-3 pr-2 font-medium">Record</th>
              <th class="hidden py-3 pr-2 font-medium sm:table-cell">Record Holder</th>
              <th class="hidden py-3 pr-4 font-medium sm:table-cell">Record Date</th>
            </tr>
          </thead>
          <tbody id="circuit-list">
            {sortedLayouts.map((layout) => {
              const circuit = circuitById.get(layout.circuit_id) ?? null;
              const imageUrl = layoutImageUrl(layout, circuit);
              const layoutName = displayLayoutName(layout.name);
              const searchText = [circuit?.name ?? '', layoutName].join(' ').toLowerCase();
              return (
                <>
                  <tr
                    data-expand-row
                    data-search={searchText}
                    data-layout-detail-url={`/circuits/layout-detail/${layout.id}`}
                    tabindex="0"
                    role="button"
                    aria-expanded="false"
                    class="cursor-pointer border-b border-white/5 transition hover:bg-white/[0.04]"
                  >
                    <td class="py-2.5 pl-4 pr-2 font-semibold">
                      <div class="flex items-center gap-3">
                        <span
                          data-chevron
                          class="inline-block shrink-0 text-[9px] text-white/30 transition-transform duration-150"
                          aria-hidden="true"
                        >
                          ▶
                        </span>
                        {imageUrl ? (
                          <img src={imageUrl} alt="" class="h-9 w-9 flex-none rounded object-contain" {...logoBgAttrs(logoBackgrounds[layout.circuit_id])} />
                        ) : (
                          <div class="h-9 w-9 flex-none rounded bg-white/10"></div>
                        )}
                        <span>{circuit?.name ?? '—'}</span>
                      </div>
                    </td>
                    <td class="py-2.5 pr-2 text-white/70">{layoutName}</td>
                    <td class="py-2.5 pr-2 text-white/70">
                      {layout.lap_record_seconds !== null ? formatLapTime(layout.lap_record_seconds) : '—'}
                    </td>
                    <td class="hidden py-2.5 pr-2 text-white/70 sm:table-cell">{layout.lap_record_holder ?? '—'}</td>
                    <td class="hidden py-2.5 pr-4 text-white/70 sm:table-cell">{formatDate(layout.lap_record_date)}</td>
                  </tr>
                  <tr data-detail-row class="hidden border-b border-white/5 bg-white/[0.02] text-xs">
                    <td colspan={5} class="px-4 py-4 sm:pl-11" data-layout-detail-body>
                      <p class="text-white/40">Loading…</p>
                    </td>
                  </tr>
                </>
              );
            })}
          </tbody>
        </table>
      </div>
    )}

    {!loadError && sortedLayouts.length > 0 && (
      <p id="circuit-search-empty" class="mt-4 hidden text-white/60">No results.</p>
    )}
  </section>

  <script>
    // Plain substring search across each layout's circuit name + display
    // name (data-search, lowercased server-side) — same show/hide-via-
    // inline-style approach the roster/teams filters use.
    function initCircuitSearch() {
      const input = document.getElementById('circuit-search') as HTMLInputElement | null;
      const list = document.getElementById('circuit-list');
      const empty = document.getElementById('circuit-search-empty');
      if (!input || !list) return;

      function applySearch() {
        const q = input!.value.trim().toLowerCase();
        const rows = list!.querySelectorAll<HTMLElement>('[data-search]');
        let visibleCount = 0;
        rows.forEach((row) => {
          const matches = !q || (row.dataset.search ?? '').includes(q);
          row.style.display = matches ? '' : 'none';
          // Hide a filtered-out row's detail row too, in case it was left open.
          const detail = row.nextElementSibling as HTMLElement | null;
          if (detail && detail.hasAttribute('data-detail-row')) {
            detail.style.display = matches ? '' : 'none';
          }
          if (matches) visibleCount += 1;
        });
        if (empty) empty.classList.toggle('hidden', visibleCount > 0);
      }

      input.addEventListener('input', applySearch);
      applySearch();
    }

    document.addEventListener('astro:page-load', initCircuitSearch);
  </script>
</Layout>

<script>
  import '../scripts/circuitLayoutDetail';
</script>
