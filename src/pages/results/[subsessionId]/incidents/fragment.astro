---
export const prerender = false;

// v0.16: the Incident Report — every penalty/incident logged for one round,
// broken apart per session (each real race, plus Qualifying/Practice as a
// whole — see 0056_penalty_session_type.sql), same pattern as the results
// page's per-race tables, replacing both the old external "Incident Report
// URL" link and the old per-row expand-to-reveal panel on the results page.
// All penalty add/edit/remove lives here instead of on the results page
// (src/pages/results/[subsessionId].astro), which is read-only for
// penalties as of this version.
import {
  resolveSupabaseEnv,
  getPenaltiesForSubsession,
  getPenaltiesForSubsessions,
  getDrivers,
  getEvents,
  getPenaltyOffenses,
  createPenalty,
  updatePenalty,
  deletePenalty,
  formatDate,
  getDriverClasses,
  restGet,
  getSeasonById,
  getScoringRulesets,
  resolveSeasonRuleset,
  shortDriverName,
  getCircuits,
  getAllCircuitLayouts,
  getLayoutMapDetails,
  type Penalty,
  type PenaltyOffense,
  type PenaltyInput,
  type ScoringRuleset,
} from '../../../../lib/supabase';
import SectionIcon from '../../../../components/SectionIcon.astro';
import { getRoundBySubsessionId, getRoundResults, getRoundsForSeason, getRoundLayoutsForSubsessions, resolveLayout, type RoundResults, type DriverBasic } from '../../../../lib/results';
import { matchCorners, turnLabelsFrom, type MapCorner } from '../../../../lib/turnMatch';
import {
  applyPenaltiesToRoundResults,
  effectiveTimePenaltySeconds,
  effectivePointsPenalty,
  effectivePenaltyPoints,
  scoringRaceNumber,
  computeRoundPPSummary,
  countWarnings,
  type RoundPPSummary,
} from '../../../../lib/penalties';
import { recomputeDriverSeasonPP, strOrNullField, numOrNullField, numOrZeroField } from '../../../../lib/penaltyActions';
import { isAdminView } from '../../../../lib/auth';
import {
  getRoundPenaltyData,
  createRoundPenalty,
  getRoundPenaltiesForDriver,
  updateRoundPenalty,
  setRoundPenaltyServed,
  deleteRoundPenalty,
  roundPenaltyLabel,
  isRoundPenaltyKind,
  ROUND_PENALTY_KINDS,
  ROUND_PENALTY_LABELS,
  ROUND_PENALTY_NOTE_MAX_LENGTH,
  type RoundPenalty,
  type RoundPenaltyData,
  type RoundPenaltyKind,
} from '../../../../lib/roundPenalties';
import { ppPenaltyTier, type PPPenaltyTier } from '../../../../lib/ppPenaltyTable';
import RowIcon from '../../../../components/RowIcon.astro';
import { logActivity, actorNameFor } from '../../../../lib/activityLog';
import {
  getAppealClosesAt,
  isAppealOpen,
  createIncidentAppeal,
  uploadAppealFile,
  safeAppealFileName,
  getIncidentAppealsForSubsession,
  setIncidentAppealStatus,
  signAppealFileUrl,
  APPEAL_MAX_FILES,
  APPEAL_MAX_FILE_BYTES,
  APPEAL_MAX_MESSAGE_LENGTH,
  APPEAL_ALLOWED_MIME_TYPES,
  type AppealFileMeta,
  type IncidentAppeal,
} from '../../../../lib/incidentAppeals';
import {
  getIncidentReportsForSubsession,
  setIncidentReportStatus,
  isRoundPosted,
  getVisibleReviewsForSubsession,
  getReviewCountsForSubsession,
  saveIncidentReportReview,
  reviewAgreement,
  reviewPenaltyLabel,
  REVIEW_PENALTIES,
  REVIEW_AGREEMENT_MIN,
  type IncidentReport,
  type IncidentReportReview,
} from '../../../../lib/incidentReports';

const supabaseEnv = resolveSupabaseEnv(Astro.locals);
// isAdminView (not a raw role check) so the footer's "View as Visitor"
// toggle actually hides this page's admin-only UI — and blocks the POST
// handlers below — while previewing.
const isAdmin = isAdminView(Astro.locals);
const subsessionId = Number(Astro.params.subsessionId);
// id of the Reported Incidents panel. Dismiss/Reopen and saving a review
// redirect to it, so the steward lands back on their review queue instead of
// the top of the page; the shell scrolls to it once the fragment is in.
const REPORTS_ANCHOR = 'reported-incidents';
// ids the round-penalty forms redirect back to: the Round Penalties table, the Round Summary and
// the stewards' owed-penalties box.
const ROUND_PENALTIES_ANCHOR = 'round-penalties';
const ROUND_SUMMARY_ANCHOR = 'round-summary';
const OWED_PENALTIES_ANCHOR = 'owed-penalties';
// Where this report's visible page lives — every POST below redirects back to it, not to this fragment URL.
const shellPath = `/results/${Astro.params.subsessionId}/incidents`;
// The fragment owns the POST handling, so its forms post here and carry the page's query string along (the redirect lands back on the same view).
const formAction = `${shellPath}/fragment${Astro.url.search}`;

/** Builds a round-wide driver lookup straight from getRoundResults() — used by the page render. Deliberately excludes notInRoster rows (see results.ts's RaceResultRow.notInRoster) — their driver.id is a synthetic `unrostered:<custId>` string, not a real drivers.id, and penalties.driver_id is a NOT NULL uuid FK into drivers — offering one of these as a pickable "driver at fault" would fail at the database with an invalid-uuid error the moment anyone actually logged a penalty against them. Use the Drivers admin page's "Sync Results with Roster" button to give them a real roster entry first if they need a penalty logged. */
async function loadRoundDrivers(): Promise<Map<string, DriverBasic>> {
  const results = await getRoundResults(supabaseEnv, subsessionId);
  const out = new Map<string, DriverBasic>();
  for (const rows of results.overall.values()) {
    for (const row of rows) if (!row.notInRoster) out.set(row.driver.id, row.driver);
  }
  return out;
}

// Read once up front (a request body can only be consumed once) — shared by
// the open-to-everyone `submit-appeal` handler and the admin-only intents.
const postForm: FormData | null =
  Astro.request.method === 'POST' && Number.isFinite(subsessionId) ? await Astro.request.formData() : null;

// --- Submit an appeal (anyone, signed in or not) ---------------------------
// Open only while the Incident Appeal Window is (see lib/incidentAppeals.ts);
// re-checked here server-side. The files go into the private
// 'incident-appeals' bucket first, then one SECURITY DEFINER call records the
// appeal text + file list (0093_incident_appeals.sql).
if (postForm && String(postForm.get('intent') ?? '') === 'submit-appeal') {
  const back = (code: string) => {
    const url = new URL(Astro.url);
    url.searchParams.set('appeal', code);
    return Astro.redirect(`${shellPath}${url.search}`, 302);
  };
  // Honeypot — real users never fill this hidden field.
  if (String(postForm.get('website') ?? '').trim() !== '') return back('ok');
  const appealCloses = await getAppealClosesAt(supabaseEnv, subsessionId);
  if (!isAppealOpen(appealCloses)) return back('closed');

  const penaltyId = String(postForm.get('penalty_id') ?? '');
  const message = String(postForm.get('message') ?? '').trim();
  const files = postForm.getAll('files').filter((f): f is File => typeof f !== 'string' && f.size > 0);
  if (!/^[0-9a-f-]{36}$/i.test(penaltyId) || !message || message.length > APPEAL_MAX_MESSAGE_LENGTH) return back('invalid');
  if (files.length > APPEAL_MAX_FILES) return back('toomany');
  if (files.some((f) => f.size > APPEAL_MAX_FILE_BYTES)) return back('toolarge');
  if (files.some((f) => !APPEAL_ALLOWED_MIME_TYPES.includes(f.type))) return back('badtype');

  try {
    const owned = await restGet<{ id: string }[]>(supabaseEnv, `penalties?select=id&id=eq.${penaltyId}&subsession_id=eq.${subsessionId}`);
    if (owned.length === 0) return back('invalid');
    const appealId = crypto.randomUUID();
    const token = Astro.locals.session?.accessToken ?? null;
    const uploaded: AppealFileMeta[] = [];
    for (const [i, file] of files.entries()) {
      const path = `${appealId}/${i + 1}-${safeAppealFileName(file.name)}`;
      await uploadAppealFile(supabaseEnv, token, path, file);
      uploaded.push({ path, name: file.name, size: file.size, type: file.type });
    }
    await createIncidentAppeal(supabaseEnv, token, { id: appealId, penalty_id: penaltyId, message, files: uploaded });
  } catch (err) {
    console.error('Failed to save incident appeal:', err);
    return back('failed');
  }
  return back('ok');
}

if (isAdmin && postForm) {
  const form = postForm;
  const intent = String(form.get('intent') ?? '');
  const accessToken = Astro.locals.session!.accessToken;
  const actor = { id: Astro.locals.session!.user.id, name: actorNameFor(Astro.locals.session!) };
  // round (below) isn't loaded yet at this point — this POST-handling block
  // runs before that section — so fetch a fresh copy here for every
  // branch's activity_log entry label.
  const roundForLog = await getRoundBySubsessionId(supabaseEnv, subsessionId);
  const roundLabel = roundForLog ? `${roundForLog.track_name} (${formatDate(roundForLog.start_time)})` : `Round ${subsessionId}`;

  if (intent === 'add-incident' || intent === 'update-incident') {
    // The Session field's value encodes both what kind of session this
    // incident happened in and (for a real race) which one — "race:2",
    // "qualifying:0", "practice:0". Qualifying/practice always carry the
    // race_number sentinel 0 (see 0056_penalty_session_type.sql) — it can
    // never collide with a real race (curated_race_results.race_number is
    // always 1-5); it's purely a display/grouping value. For SCORING, a
    // qualifying/practice incident's penalty always applies to Race 1 (see
    // scoringRaceNumber in src/lib/penalties.ts, which every recalculation
    // pass reads instead of this raw field).
    const [sessionTypeRaw, raceNumberRaw] = String(form.get('session') ?? '').split(':');
    const sessionType: 'race' | 'qualifying' | 'practice' =
      sessionTypeRaw === 'qualifying' || sessionTypeRaw === 'practice' ? sessionTypeRaw : 'race';
    const raceNumber = sessionType === 'race' ? Number(raceNumberRaw) : 0;
    const isRaceSession = sessionType === 'race';
    // Cars at fault (fault_driver_ids — the incident dialog's checklist, see
    // src/scripts/faultCards.ts): one penalty row per car, each with its own
    // PP/Warning, time penalty, points penalty and offenses (the fields named
    // "<field>:<driver id>"); session, #, lap, description and involved cars
    // are shared. Nothing ticked is a Racing Incident: one row with no driver
    // (0020_penalty_racing_incident.sql) and, server-side regardless of what
    // was submitted, no penalty or offenses. An edit updates one existing row,
    // so only the first car counts there (the dialog only allows one).
    const faultDriverIds = [...new Set(form.getAll('fault_driver_ids').map(String).filter(Boolean))];
    const penalizedDriverIds = intent === 'update-incident' ? faultDriverIds.slice(0, 1) : faultDriverIds;
    const involvedDriverIds = form.getAll('involved_driver_ids').map(String);

    const shared = {
      subsession_id: subsessionId,
      race_number: raceNumber,
      session_type: sessionType,
      incident_number: strOrNullField(form, 'incident_number'),
      lap: numOrNullField(form, 'lap'),
      description: strOrNullField(form, 'description'),
      // Appeals are edit-only in the dialog (they're about one car's existing
      // penalty), so these are blank on every Add.
      is_appealed: form.get('is_appealed') === 'on',
      appeal_result: strOrNullField(form, 'appeal_result'),
      appeal_time_penalty_seconds: numOrNullField(form, 'appeal_time_penalty_seconds'),
      appeal_points_penalty: numOrZeroField(form, 'appeal_points_penalty'),
      appeal_penalty_points: numOrZeroField(form, 'appeal_penalty_points'),
    };

    // PP and the warning flag come from one dropdown per car: "warning" is a
    // Warning (rulebook: 2 warnings escalates to +1 PP, so it has no PP value
    // of its own — stored as penalty_points 0, see
    // 0059_penalty_points_warning_dropdown.sql), blank is "no PP/warning"
    // (also 0), and 1-7 is a literal PP award. Qualifying/practice incidents
    // can carry a real penalty too — per Logan, it always applies to Race 1
    // (see scoringRaceNumber in src/lib/penalties.ts).
    function penaltyFor(driverId: string | null): { data: PenaltyInput; offenseIds: string[] } {
      if (!driverId) {
        return {
          data: { ...shared, driver_id: null, time_penalty_seconds: null, points_penalty: 0, penalty_points: 0, is_warning: false },
          offenseIds: [],
        };
      }
      const ppChoice = String(form.get(`penalty_points_choice:${driverId}`) ?? '');
      return {
        data: {
          ...shared,
          driver_id: driverId,
          time_penalty_seconds: numOrNullField(form, `time_penalty_seconds:${driverId}`),
          points_penalty: numOrZeroField(form, `points_penalty:${driverId}`),
          penalty_points: ppChoice === 'warning' ? 0 : Number(ppChoice) || 0,
          is_warning: ppChoice === 'warning',
        },
        offenseIds: form.getAll(`offense_ids:${driverId}`).map(String),
      };
    }

    try {
      const savedPenaltyIds: string[] = [];
      if (intent === 'add-incident' && Number.isFinite(raceNumber)) {
        for (const driverId of penalizedDriverIds.length > 0 ? penalizedDriverIds : [null]) {
          const { data, offenseIds } = penaltyFor(driverId);
          const created = await createPenalty(supabaseEnv, accessToken, data, offenseIds, involvedDriverIds);
          if (created?.id) savedPenaltyIds.push(created.id);
        }
      } else if (intent === 'update-incident') {
        const penaltyId = String(form.get('penalty_id') ?? '');
        if (penaltyId) {
          const { data, offenseIds } = penaltyFor(penalizedDriverIds[0] ?? null);
          await updatePenalty(supabaseEnv, accessToken, penaltyId, data, offenseIds, involvedDriverIds);
          savedPenaltyIds.push(penaltyId);
        }
      }
      // Re-tally every car whose season PP may have changed — on an edit that
      // moved the penalty to a different car, the car it was taken off too.
      const originalDriverId = intent === 'update-incident' ? String(form.get('original_driver_id') ?? '') : '';
      for (const driverId of new Set([...penalizedDriverIds, originalDriverId].filter(Boolean))) {
        await recomputeDriverSeasonPP(supabaseEnv, accessToken, driverId);
      }
      // Logged from a driver's incident report ("Log incident" in the
      // Reported Incidents panel) — mark that report as handled.
      const fromReportId = String(form.get('from_report_id') ?? '');
      if (intent === 'add-incident' && fromReportId) await setIncidentReportStatus(supabaseEnv, accessToken, fromReportId, 'logged');
      const sessionLabel = isRaceSession ? `Race ${raceNumber}` : sessionType === 'qualifying' ? 'Qualifying' : 'Practice';
      await logActivity(supabaseEnv, accessToken, actor, {
        action: intent === 'add-incident' ? 'add' : 'edit',
        entity_type: 'incident',
        entity_label: `${roundLabel} — ${sessionLabel}${shared.incident_number ? ` #${shared.incident_number}` : ''}${savedPenaltyIds.length > 1 ? ` (${savedPenaltyIds.length} cars at fault)` : ''}`,
        entity_id: savedPenaltyIds[0] ?? null,
      });
    } catch (err) {
      console.error('Failed to save incident:', err);
    }
    // Logged from the Reported Incidents panel → back to it, like Dismiss/Reopen below.
    const fromReport = intent === 'add-incident' && Boolean(form.get('from_report_id'));
    return Astro.redirect(`${shellPath}${Astro.url.search}${fromReport ? `#${REPORTS_ANCHOR}` : ''}`, 302);
  }

  // Round penalties (0104_round_penalties.sql): log one against a driver for
  // this round, remove one, or mark one (from this or an earlier round)
  // served at this round / owed again.
  // ?roundpenalty=failed drives the flash at the top of the page (roundPenaltyFlash
  // below); a successful save clears one left over from an earlier failure.
  const roundPenaltyBack = (anchor: string, failed: boolean) => {
    const url = new URL(Astro.url);
    if (failed) url.searchParams.set('roundpenalty', 'failed');
    else url.searchParams.delete('roundpenalty');
    return Astro.redirect(`${shellPath}${url.search}${failed ? '' : `#${anchor}`}`, 302);
  };
  if (intent === 'add-round-penalty' || intent === 'update-round-penalty') {
    const driverId = String(form.get('driver_id') ?? '');
    const kind = String(form.get('kind') ?? '');
    const note = strOrNullField(form, 'note')?.slice(0, ROUND_PENALTY_NOTE_MAX_LENGTH) ?? null;
    const id = String(form.get('round_penalty_id') ?? '');
    let failed = false;
    if (driverId && isRoundPenaltyKind(kind) && (kind !== 'other' || note) && (intent === 'add-round-penalty' || id)) {
      try {
        if (intent === 'add-round-penalty') {
          await createRoundPenalty(supabaseEnv, accessToken, { subsession_id: subsessionId, driver_id: driverId, kind, note, created_by: actor.id });
        } else {
          await updateRoundPenalty(supabaseEnv, accessToken, id, { driver_id: driverId, kind, note, markOwed: form.get('status') === 'owed' });
        }
        await logActivity(supabaseEnv, accessToken, actor, {
          action: intent === 'add-round-penalty' ? 'add' : 'edit',
          entity_type: 'incident',
          entity_label: `${roundLabel} — round penalty (${ROUND_PENALTY_LABELS[kind]})`,
          entity_id: null,
        });
      } catch (err) {
        console.error('Failed to save round penalty:', err);
        failed = true;
      }
    }
    return roundPenaltyBack(ROUND_SUMMARY_ANCHOR, failed);
  }

  // The Round Summary row's Edit: tick boxes for the fixed kinds plus one Other
  // note. Ticked kinds with nothing logged are added, unticked logged ones are
  // removed (served ones too — this popup is the one place a penalty is
  // waived, and unticking it drops where it was served); ones left ticked keep
  // their note and served status.
  // These are separate writes, not one transaction: if one fails partway, the
  // ones before it stay saved, get logged, and the flash says to check.
  if (intent === 'save-driver-round-penalties') {
    const driverId = String(form.get('driver_id') ?? '');
    const wanted = new Set(form.getAll('kinds').map(String).filter(isRoundPenaltyKind));
    const otherNote = strOrNullField(form, 'other_note')?.slice(0, ROUND_PENALTY_NOTE_MAX_LENGTH) ?? null;
    let changes = 0;
    let failed = false;
    if (driverId) {
      try {
        const existing = await getRoundPenaltiesForDriver(supabaseEnv, subsessionId, driverId);
        for (const kind of ROUND_PENALTY_KINDS) {
          if (kind === 'other') continue;
          const logged = existing.filter((rp) => rp.kind === kind);
          if (wanted.has(kind) && logged.length === 0) {
            await createRoundPenalty(supabaseEnv, accessToken, { subsession_id: subsessionId, driver_id: driverId, kind, note: null, created_by: actor.id });
            changes++;
          } else if (!wanted.has(kind)) {
            for (const rp of logged) {
              await deleteRoundPenalty(supabaseEnv, accessToken, rp.id);
              changes++;
            }
          }
        }
        // Only the first Other is edited here; any more stay in the Round Penalties table.
        const other = existing.find((rp) => rp.kind === 'other');
        if (otherNote && !other) {
          await createRoundPenalty(supabaseEnv, accessToken, { subsession_id: subsessionId, driver_id: driverId, kind: 'other', note: otherNote, created_by: actor.id });
          changes++;
        } else if (otherNote && other && other.note !== otherNote) {
          await updateRoundPenalty(supabaseEnv, accessToken, other.id, { driver_id: driverId, kind: 'other', note: otherNote, markOwed: false });
          changes++;
        } else if (!otherNote && other) {
          await deleteRoundPenalty(supabaseEnv, accessToken, other.id);
          changes++;
        }
      } catch (err) {
        console.error('Failed to save driver round penalties:', err);
        failed = true;
      }
      if (changes > 0) {
        try {
          await logActivity(supabaseEnv, accessToken, actor, {
            action: 'edit',
            entity_type: 'incident',
            entity_label: `${roundLabel} — round penalties${failed ? ' (partly saved)' : ''}`,
            entity_id: null,
          });
        } catch (err) {
          console.error('Failed to log driver round penalties:', err);
        }
      }
    }
    return roundPenaltyBack(ROUND_SUMMARY_ANCHOR, failed);
  }

  if (intent === 'delete-round-penalty') {
    const id = String(form.get('round_penalty_id') ?? '');
    let failed = false;
    if (id) {
      try {
        await deleteRoundPenalty(supabaseEnv, accessToken, id);
        await logActivity(supabaseEnv, accessToken, actor, {
          action: 'delete',
          entity_type: 'incident',
          entity_label: `${roundLabel} — round penalty`,
          entity_id: null,
        });
      } catch (err) {
        console.error('Failed to delete round penalty:', err);
        failed = true;
      }
    }
    return roundPenaltyBack(ROUND_SUMMARY_ANCHOR, failed);
  }

  if (intent === 'set-round-penalty-served') {
    const id = String(form.get('round_penalty_id') ?? '');
    const served = form.get('served') === '1';
    let failed = false;
    if (id) {
      try {
        await setRoundPenaltyServed(supabaseEnv, accessToken, id, served ? subsessionId : null);
        await logActivity(supabaseEnv, accessToken, actor, {
          action: 'edit',
          entity_type: 'incident',
          entity_label: `${roundLabel} — round penalty ${served ? 'served' : 'marked owed'}`,
          entity_id: null,
        });
      } catch (err) {
        console.error('Failed to update round penalty:', err);
        failed = true;
      }
    }
    return roundPenaltyBack(OWED_PENALTIES_ANCHOR, failed);
  }

  if (intent === 'set-report-status') {
    const reportId = String(form.get('report_id') ?? '');
    const status = String(form.get('status') ?? '');
    // Dismissing needs a reason (the dismiss popup's textarea; 0111).
    const dismissalReason = String(form.get('reason') ?? '').trim().slice(0, 500);
    let statusFlash: 'dismissreason' | 'dismissfailed' | null = null;
    if (reportId && (status === 'open' || status === 'dismissed' || status === 'logged')) {
      if (status === 'dismissed' && !dismissalReason) {
        statusFlash = 'dismissreason';
      } else {
        try {
          await setIncidentReportStatus(supabaseEnv, accessToken, reportId, status, dismissalReason);
        } catch (err) {
          console.error('Failed to update incident report status:', err);
          if (status === 'dismissed') statusFlash = 'dismissfailed';
        }
      }
    }
    // Back to the top of the reports list (see REPORTS_ANCHOR), not the top of
    // the page, without a ?review= failure left over from an earlier save
    // (or with one for a dismissal that didn't go through).
    const url = new URL(Astro.url);
    url.searchParams.delete('review');
    if (statusFlash) url.searchParams.set('review', statusFlash);
    return Astro.redirect(`${shellPath}${url.search}#${REPORTS_ANCHOR}`, 302);
  }

  // Steward review of a driver-submitted report (0096) — the database
  // enforces admin-only, one review per admin, and the lock once logged.
  if (intent === 'save-review') {
    const reportId = String(form.get('report_id') ?? '');
    const explanation = String(form.get('explanation') ?? '').trim();
    // Every ticked car with its own suggested penalty ("penalty:<driver id>",
    // src/scripts/faultCards.ts), or explicitly Racing Incident with none (0100).
    const racingIncident = form.get('racing_incident') === 'on';
    const faultDriverIds = [...new Set(form.getAll('fault_driver_ids').map(String).filter(Boolean))];
    const faults = faultDriverIds.map((driver_id) => ({
      driver_id,
      penalty: REVIEW_PENALTIES.find((p) => p === String(form.get(`penalty:${driver_id}`) ?? '')),
    }));
    // ?review=<code> drives the message above the reports (reviewFlash below);
    // a successful save clears any code left over from an earlier failure.
    const back = (code: 'locked' | 'involved' | 'invalid' | 'failed' | null) => {
      const url = new URL(Astro.url);
      if (code) url.searchParams.set('review', code);
      else url.searchParams.delete('review');
      return Astro.redirect(`${shellPath}${url.search}#${REPORTS_ANCHOR}`, 302);
    };
    const validFaults = racingIncident ? faults.length === 0 : faults.length > 0 && faults.every((f) => f.penalty);
    if (!reportId || !validFaults || !explanation) return back('invalid');
    try {
      await saveIncidentReportReview(supabaseEnv, accessToken, {
        report_id: reportId,
        faults: faults.map((f) => ({ driver_id: f.driver_id, penalty: f.penalty! })),
        explanation,
      });
    } catch (err) {
      console.error('Failed to save incident report review:', err);
      // Expected when another admin logs the report mid-review — see 0096's save function —
      // or when the steward was one of the report's drivers (0099).
      const message = err instanceof Error ? err.message : '';
      return back(message.includes('reviews are locked') ? 'locked' : message.includes('involved in this incident') ? 'involved' : 'failed');
    }
    // No verdict in the log entry — that would undo the blind voting.
    await logActivity(supabaseEnv, accessToken, actor, {
      action: 'edit',
      entity_type: 'incident_report',
      entity_label: `${roundLabel} — steward review`,
      entity_id: reportId,
    });
    return back(null);
  }

  if (intent === 'set-appeal-status') {
    const appealId = String(form.get('appeal_id') ?? '');
    const status = String(form.get('status') ?? '');
    if (appealId && (status === 'open' || status === 'reviewed' || status === 'dismissed')) {
      try {
        await setIncidentAppealStatus(supabaseEnv, accessToken, appealId, status);
      } catch (err) {
        console.error('Failed to update incident appeal status:', err);
      }
    }
    return Astro.redirect(`${shellPath}${Astro.url.search}`, 302);
  }

  if (intent === 'delete-incident') {
    const penaltyId = String(form.get('penalty_id') ?? '');
    const driverId = String(form.get('driver_id') ?? '');
    try {
      if (penaltyId) {
        await deletePenalty(supabaseEnv, accessToken, penaltyId);
        await logActivity(supabaseEnv, accessToken, actor, {
          action: 'delete',
          entity_type: 'incident',
          entity_label: roundLabel,
          entity_id: penaltyId,
        });
      }
      if (driverId) await recomputeDriverSeasonPP(supabaseEnv, accessToken, driverId);
    } catch (err) {
      console.error('Failed to delete incident:', err);
    }
    return Astro.redirect(`${shellPath}${Astro.url.search}`, 302);
  }
}

let round: Awaited<ReturnType<typeof getRoundBySubsessionId>> = null;
let originalResults: RoundResults = { byClass: new Map(), overall: new Map() };
let penalties: Penalty[] = [];
let offenses: PenaltyOffense[] = [];
let classes: Awaited<ReturnType<typeof getDriverClasses>> = [];
let loadError: string | null = null;

if (Number.isFinite(subsessionId)) {
  try {
    [round, originalResults, penalties, offenses, classes] = await Promise.all([
      getRoundBySubsessionId(supabaseEnv, subsessionId),
      getRoundResults(supabaseEnv, subsessionId),
      getPenaltiesForSubsession(supabaseEnv, subsessionId),
      getPenaltyOffenses(supabaseEnv),
      getDriverClasses(supabaseEnv),
    ]);
  } catch (err) {
    console.error('Failed to load incident report:', err);
    loadError = err instanceof Error ? err.message : String(err);
  }
}

if (!loadError && !round) {
  // The shell's loader follows X-Redirect-To (a plain redirect here would be
  // followed by fetch() and the destination page pasted into the container).
  return new Response(null, { status: 404, headers: { 'X-Redirect-To': '/results' } });
}

// An incident report is only public once an admin "posts" it (Admin →
// Incident Reporting). Until then only admins can open this page; everyone
// else goes back to the round's results.
let roundPosted = true;
if (round) {
  try {
    roundPosted = await isRoundPosted(supabaseEnv, subsessionId);
  } catch (err) {
    console.error('Failed to check whether incident report is posted:', err);
  }
  if (!roundPosted && !isAdmin) {
    return new Response(null, { status: 403, headers: { 'X-Redirect-To': `/results/${subsessionId}` } });
  }
}

// This round's season's scoring ruleset — see results/[subsessionId].astro's
// matching fetch for why applyPenaltiesToRoundResults below needs it: a
// repositioned driver's new finish/class points must be priced off the SAME
// base_points/class_podium table the round was actually scored with, not a
// fixed default one.
let ruleset: ScoringRuleset | null = null;
if (!loadError && round) {
  try {
    const [rulesetSeason, rulesets] = await Promise.all([getSeasonById(supabaseEnv, round.season_id), getScoringRulesets(supabaseEnv)]);
    ruleset = rulesetSeason ? resolveSeasonRuleset(rulesetSeason, rulesets) : null;
  } catch (err) {
    console.error('Failed to resolve round scoring ruleset:', err);
  }
}

// The "before" snapshot is exactly what getRoundResults() returned (no
// penalties applied yet); the "after" snapshot runs it through the same
// engine the results page itself uses. Position/points lost or gained are
// measured between these two, per Logan: "Before vs. after this round's
// full recalculation" — not per individual penalty, since a driver's final
// position/points reflect every penalty logged against the whole race at
// once, not just one entry in isolation.
// Alpha never earns the top-3-in-class Class Points bonus (see README) —
// told to the recompute engine so a penalty-driven podium shuffle can't
// manufacture class points for an Alpha driver.
const classPointsEligibleByClassId = new Map(classes.map((c) => [c.id, c.name !== 'Alpha']));
const recomputedResults =
  penalties.length > 0
    ? applyPenaltiesToRoundResults(
        originalResults,
        penalties,
        round?.format ?? null,
        classPointsEligibleByClassId,
        ruleset?.rules ?? null,
        subsessionId
      )
    : originalResults;

interface PosPoints {
  position: number | null;
  totalPoints: number;
}
function buildLookup(rr: RoundResults): Map<string, PosPoints> {
  const m = new Map<string, PosPoints>();
  for (const rows of rr.overall.values()) {
    for (const row of rows) m.set(`${row.raceNumber}:${row.driver.id}`, { position: row.position, totalPoints: row.totalPoints });
  }
  return m;
}
const originalByKey = buildLookup(originalResults);
const recomputedByKey = buildLookup(recomputedResults);

function deltaFor(p: Penalty): { positionDelta: number | null; pointsDelta: number | null } {
  // scoringRaceNumber (not the raw race_number) — a qualifying/practice
  // incident's delta shows up against Race 1, where its penalty actually
  // landed (see that helper's own doc comment in src/lib/penalties.ts).
  const key = `${scoringRaceNumber(p)}:${p.driver_id}`;
  const before = originalByKey.get(key);
  const after = recomputedByKey.get(key);
  const positionDelta = before?.position != null && after?.position != null ? before.position - after.position : null;
  const pointsDelta = before && after ? after.totalPoints - before.totalPoints : null;
  return { positionDelta, pointsDelta };
}

function formatDelta(n: number | null): string {
  if (n === null) return '—';
  if (n === 0) return '0';
  return `${n > 0 ? '+' : ''}${n}`;
}
function deltaClass(n: number | null): string {
  if (n === null || n === 0) return 'text-white/40';
  return n > 0 ? 'text-brand-blue' : 'text-brand-pink';
}

// Every driver who appeared anywhere in this round, sorted by car number —
// powers the Driver and Involved pickers in the add/edit dialog (an
// incident can only involve cars that were actually in this round). Unlike
// the old per-race dialog, the driver being penalized is no longer excluded
// from the "Involved" list — per Logan, involvement should be inclusive so
// the penalized driver's own car can be tagged alongside anyone else's.
// notInRoster rows are excluded — see loadRoundDrivers' own doc comment
// above on why their synthetic id can never be a valid penalties.driver_id.
const driverById = new Map<string, DriverBasic>();
for (const rows of originalResults.overall.values()) {
  for (const row of rows) if (!row.notInRoster) driverById.set(row.driver.id, row.driver);
}
const roundDrivers = [...driverById.values()].sort((a, b) => (a.car_number ?? Infinity) - (b.car_number ?? Infinity));
const raceNumbers = [...originalResults.overall.keys()].sort((a, b) => a - b);

// Driver-submitted reports (0090_incident_reports.sql) — admin-only queue,
// shown above the incident list; RLS already limits non-admins to nothing
// but their own rows, but this page only ever renders it for admins.
let incidentReports: IncidentReport[] = [];
if (isAdmin) {
  try {
    incidentReports = await getIncidentReportsForSubsession(supabaseEnv, Astro.locals.session!.accessToken, subsessionId);
  } catch (err) {
    console.error('Failed to load incident reports:', err);
  }
}

// Chronological: Practice → Qualifying → Race 1 → Race 2 → Race 3, then lap,
// then turn. `turn` is free text ("3", "10b", "back straight"), so it's a
// natural sort — 3 before 10 before 10b, with wordy turns after numbered ones.
function reportSessionRank(session: string): number {
  const [type, num] = session.split(':');
  if (type === 'practice') return 0;
  if (type === 'qualifying') return 1;
  if (type === 'race') return 2 + (Number(num) || 0);
  return Number.MAX_SAFE_INTEGER;
}
incidentReports.sort(
  (a, b) =>
    reportSessionRank(a.session) - reportSessionRank(b.session) ||
    a.lap - b.lap ||
    a.turn.localeCompare(b.turn, undefined, { numeric: true, sensitivity: 'base' }) ||
    new Date(a.created_at).getTime() - new Date(b.created_at).getTime()
);
// "INC n", numbered in that chronological order across every group below.
// Dismissed reports get no number and close the gap, so dismissing or
// reopening one renumbers the reports after it.
const reportNumberById = new Map(
  incidentReports.filter((r) => r.status !== 'dismissed').map((r, i) => [r.id, i + 1])
);

// Flag reports that probably describe the same incident: same session, lap
// and turn, plus at least one car in common — reporters often leave cars out,
// so "04 and 11" and "04" still match. Turn is free text, so case and a
// leading "T"/"Turn" are ignored ("10", "T10", "turn 10" all match).
// Dismissed reports are left out: once a duplicate is dismissed, the report it
// duplicated stops being flagged (and is flagged again if it's Reopened).
function normalizeTurn(turn: string): string {
  return turn.trim().toLowerCase().replace(/^(turn|t)\s*(?=\d)/, '').replace(/\s+/g, ' ');
}
const possibleDuplicateReportIds = new Set<string>();
// Stewards review the first-submitted report of a duplicate group; a later
// duplicate maps to the earliest report it matches, for the "review that one
// instead" note.
const duplicateOriginalById = new Map<string, IncidentReport>();
const duplicateCandidates = incidentReports.filter((r) => r.status !== 'dismissed');
for (let i = 0; i < duplicateCandidates.length; i++) {
  for (let j = i + 1; j < duplicateCandidates.length; j++) {
    const a = duplicateCandidates[i];
    const b = duplicateCandidates[j];
    if (
      a.session === b.session &&
      a.lap === b.lap &&
      normalizeTurn(a.turn) === normalizeTurn(b.turn) &&
      a.driver_ids.some((id) => b.driver_ids.includes(id))
    ) {
      possibleDuplicateReportIds.add(a.id);
      possibleDuplicateReportIds.add(b.id);
      const [earlier, later] = a.created_at <= b.created_at ? [a, b] : [b, a];
      const current = duplicateOriginalById.get(later.id);
      if (!current || earlier.created_at < current.created_at) duplicateOriginalById.set(later.id, earlier);
    }
  }
}
// The first-submitted report a later duplicate points to may itself be a
// later duplicate of something earlier still — follow the chain to the start.
for (const [id, original] of duplicateOriginalById) {
  let root = original;
  const seen = new Set([id]);
  while (duplicateOriginalById.has(root.id) && !seen.has(root.id)) {
    seen.add(root.id);
    root = duplicateOriginalById.get(root.id)!;
  }
  duplicateOriginalById.set(id, root);
}
function reportLabel(r: IncidentReport): string {
  const n = reportNumberById.get(r.id);
  return `${n ? `INC ${n} · ` : ''}${sessionLabelByValue.get(r.session) ?? r.session} · Lap ${r.lap} · Turn ${r.turn}`;
}
// Admin → Incident Reporting links here two ways: "View Incidents"
// (?view=reports) shows the driver-submitted reports queue, "Edit Report"
// (no param) shows the not-yet-posted notice and the + Add Incident To
// Report control instead. Every POST on this page
// redirects back to its own pathname + search, so the mode survives a
// Dismiss/Reopen/Log incident round trip.
const viewReports = isAdmin && Astro.url.searchParams.get('view') === 'reports';
// Reports still waiting on the stewards — the number on the View Reported Incidents button.
const openReportCount = incidentReports.filter((r) => r.status === 'open').length;

// This round's layout map and its numbered corners (layout_corners, 0110),
// View Incidents only: each report card shows the map with the reported
// turn(s) circled. Failure-tolerant — no map just means no map column.
let reportMapUrl: string | null = null;
let reportMapCorners: MapCorner[] = [];
if (viewReports && round) {
  try {
    const [circuits, layouts, roundLayouts] = await Promise.all([
      getCircuits(supabaseEnv),
      getAllCircuitLayouts(supabaseEnv),
      getRoundLayoutsForSubsessions(supabaseEnv, [subsessionId]),
    ]);
    const layout = resolveLayout(round.track_name, roundLayouts.get(subsessionId) ?? null, circuits, layouts);
    reportMapUrl = layout?.image_url ?? null;
    if (layout && reportMapUrl) reportMapCorners = (await getLayoutMapDetails(supabaseEnv, layout.id)).corners;
  } catch (err) {
    console.error('Failed to load the layout map for the reported incidents:', err);
  }
}
/** "#04, #12" for a report's cars (name when a car has no number). */
function reportCarsTitle(r: IncidentReport): string {
  return r.driver_ids
    .map((id) => {
      const d = driverById.get(id);
      return d ? (d.car_number !== null ? `#${d.car_number}` : shortDriverName(d.name)) : '?';
    })
    .join(', ');
}

/** "Race 1, Lap 12, Turns 3, 4" — "Turn" (no s) when the report names a single turn. */
function reportSubtitle(r: IncidentReport): string {
  const base = `${sessionLabelByValue.get(r.session) ?? r.session}, Lap ${r.lap}`;
  const turnText = (r.turn ?? '').trim();
  if (!turnText) return base;
  const labels = turnLabelsFrom(turnText);
  if (labels.length === 0) return `${base}, ${turnText}`;
  return `${base}, Turn${labels.length > 1 ? 's' : ''} ${labels.join(', ')}`;
}

// Steward reviews (0096), View Incidents only. RLS hands back only what this
// admin may see — their own review, plus everyone else's on reports they've
// already reviewed (or that are logged, or that they were involved in) — and
// the counts RPC says how many exist in total.
const myUserId = Astro.locals.session?.user.id ?? null;
// A steward linked to one of a report's drivers can't review it, but can read
// everyone else's reviews of it (0099).
const myDriverId = Astro.locals.session?.profile?.driver_id ?? null;
function isInvolved(r: IncidentReport): boolean {
  return myDriverId !== null && r.driver_ids.includes(myDriverId);
}
const reviewsByReport = new Map<string, IncidentReportReview[]>();
let reviewCounts = new Map<string, number>();
let reviewsLoadFailed = false;
if (viewReports && incidentReports.length > 0) {
  try {
    const token = Astro.locals.session!.accessToken;
    const [reviews, counts] = await Promise.all([
      getVisibleReviewsForSubsession(supabaseEnv, token, subsessionId),
      getReviewCountsForSubsession(supabaseEnv, token, subsessionId),
    ]);
    for (const review of reviews) {
      if (!reviewsByReport.has(review.report_id)) reviewsByReport.set(review.report_id, []);
      reviewsByReport.get(review.report_id)!.push(review);
    }
    reviewCounts = counts;
  } catch (err) {
    console.error('Failed to load incident report reviews:', err);
    reviewsLoadFailed = true;
  }
}
function myReviewOf(reportId: string): IncidentReportReview | null {
  return reviewsByReport.get(reportId)?.find((v) => v.reviewer_id === myUserId) ?? null;
}
// The reports split into three groups, each still in chronological order, so
// the next report this steward hasn't reviewed is always first in the list:
// Needs your review (not dismissed, voting still open, no review from you yet),
// Reviewed (you've reviewed it, it was logged and voting is over, or you were
// involved and can't review it), and
// Dismissed and Logged (both collapsed, in that order at the bottom — a logged
// report only ever shows up under Logged, whatever its review state). If the
// reviews didn't load there's no telling what this steward has reviewed, so
// every open report goes in one ungrouped list instead of a wrong queue (with
// a warning above it).
interface ReportGroup { title: string; icon: 'review' | 'reviewed' | 'open' | 'dismissed' | 'logged'; empty: string | null; collapsed: boolean; reports: IncidentReport[]; alwaysShow?: boolean }
const needsReviewGroup: ReportGroup = { title: 'Needs Review', icon: 'review', empty: null, collapsed: false, reports: [], alwaysShow: true };
const reviewedGroup: ReportGroup = { title: 'Reviewed', icon: 'reviewed', empty: null, collapsed: false, reports: [] };
const openGroup: ReportGroup = { title: 'Open', icon: 'open', empty: null, collapsed: false, reports: [] };
const dismissedGroup: ReportGroup = { title: 'Dismissed', icon: 'dismissed', empty: null, collapsed: true, reports: [] };
const loggedGroup: ReportGroup = { title: 'Logged', icon: 'logged', empty: null, collapsed: true, reports: [] };
for (const r of incidentReports) {
  const group =
    r.status === 'dismissed' ? dismissedGroup
    : r.status === 'logged' ? loggedGroup
    : reviewsLoadFailed ? openGroup
    : myReviewOf(r.id) || r.reviews_closed_at || isInvolved(r) ? reviewedGroup
    : needsReviewGroup;
  group.reports.push(r);
}
const reportGroups = reviewsLoadFailed
  ? [openGroup, dismissedGroup, loggedGroup]
  : [needsReviewGroup, reviewedGroup, dismissedGroup, loggedGroup];
// Colour for each group's icon (SectionIcon.astro), matching the agreement colours below.
const groupIconColor: Record<ReportGroup['icon'], string> = {
  review: 'text-brand-gold',
  reviewed: 'text-emerald-400',
  open: 'text-brand-gold',
  dismissed: 'text-white/40',
  logged: 'text-brand-primary',
};
// Hover note on a disabled Add/Edit Review button — same look as the results page's disabled Incident Report button (IncidentButton.astro).
// Uses a NAMED group (group/reviewbtn): a plain group-hover would also fire whenever the pointer is over the enclosing card's own `group`, showing every row's note at once.
const reviewTipClass =
  'pointer-events-none absolute right-0 top-full z-30 mt-1.5 w-max max-w-[16rem] rounded-md bg-brand-ink px-2 py-1 text-[11px] font-semibold text-white opacity-0 shadow-lg ring-1 ring-white/15 transition-opacity group-hover/reviewbtn:opacity-100 group-focus-within/reviewbtn:opacity-100';
const agreementStyles = {
  all: { item: 'border-emerald-400/60 bg-emerald-400/10', text: 'text-emerald-400', label: 'All stewards agree' },
  driver: { item: 'border-brand-gold/60 bg-brand-gold/10', text: 'text-brand-gold', label: 'Same cars at fault, different penalties' },
  split: { item: 'border-brand-pink/60 bg-brand-pink/10', text: 'text-brand-pink', label: 'Stewards disagree on fault' },
} as const;
function reviewDriverLabel(driverId: string | null): string {
  if (!driverId) return 'Racing Incident';
  const d = driverById.get(driverId);
  return d ? `${d.car_number !== null ? `#${d.car_number} ` : ''}${d.name}` : 'Unknown driver';
}
const offenseNameById = new Map(offenses.map((o) => [o.id, o.name]));

// Appeals (0093_incident_appeals.sql) — admin-only queue, shown beneath the
// reported incidents. Attached files live in a private bucket, so each gets a
// one-hour signed download link here.
let incidentAppeals: IncidentAppeal[] = [];
const appealFileUrls = new Map<string, string | null>();
if (isAdmin) {
  try {
    const token = Astro.locals.session!.accessToken;
    incidentAppeals = await getIncidentAppealsForSubsession(supabaseEnv, token, subsessionId);
    await Promise.all(
      incidentAppeals.flatMap((a) => a.files.map(async (f) => { appealFileUrls.set(f.path, await signAppealFileUrl(supabaseEnv, token, f.path)); }))
    );
  } catch (err) {
    console.error('Failed to load incident appeals:', err);
  }
}

// Whether the Submit Appeal button in the details popup is live: open from
// the moment the round was posted until the Incident Appeal Window runs out.
// The button re-checks this live in the browser too (the page can be cached).
const appealClosesAt = roundPosted ? await getAppealClosesAt(supabaseEnv, subsessionId) : null;
const appealOpen = isAppealOpen(appealClosesAt);
let appealFlash: { kind: 'ok' | 'error'; message: string } | null = null;
{
  const flash = Astro.url.searchParams.get('appeal');
  if (flash === 'ok') appealFlash = { kind: 'ok', message: 'Appeal submitted. The stewards will review it.' };
  else if (flash === 'closed') appealFlash = { kind: 'error', message: 'The appeal window for this round has closed.' };
  else if (flash === 'invalid') appealFlash = { kind: 'error', message: 'Your appeal needs a written explanation.' };
  else if (flash === 'toomany') appealFlash = { kind: 'error', message: `You can attach up to ${APPEAL_MAX_FILES} files.` };
  else if (flash === 'toolarge') appealFlash = { kind: 'error', message: 'Each file must be 10 MB or smaller.' };
  else if (flash === 'badtype') appealFlash = { kind: 'error', message: 'Attachments must be images, PDFs, videos (MP4/WebM/MOV) or text files.' };
  else if (flash === 'failed') appealFlash = { kind: 'error', message: "Couldn't save your appeal right now. Please try again." };
}
// A round penalty change that didn't (fully) save (?roundpenalty=, set by the round penalty handlers).
const roundPenaltyFlash =
  isAdmin && Astro.url.searchParams.get('roundpenalty') === 'failed'
    ? "Couldn't save all of that round penalty change. Check the Round Summary and Round Penalties below, then try again."
    : null;

// Same idea for a steward review that didn't save (?review=, set by the save-review handler).
let reviewFlash: string | null = null;
if (viewReports) {
  const flash = Astro.url.searchParams.get('review');
  if (flash === 'locked') reviewFlash = "Couldn't save your review — this incident was logged while you were writing it, so reviews are closed.";
  else if (flash === 'involved') reviewFlash = "Couldn't save your review — you were involved in this incident, so you can't review it.";
  else if (flash === 'invalid') reviewFlash = "Couldn't save your review — it needs the car(s) at fault (or Racing Incident), a penalty for each car, and an explanation.";
  else if (flash === 'failed') reviewFlash = "Couldn't save your review right now. Please try again.";
  else if (flash === 'dismissreason') reviewFlash = "Couldn't dismiss the incident — a reason is required.";
  else if (flash === 'dismissfailed') reviewFlash = "Couldn't dismiss the incident right now. Please try again.";
}

// Every loggable session for this round's dialog/grouping — every real race,
// plus Qualifying and Practice (session_type sentinel race_number 0, see
// 0056_penalty_session_type.sql), independent of whether Qualifying/Practice
// have any imported results data at all (Logan: incident logging shouldn't
// depend on that).
const sessionOptions: { value: string; label: string }[] = [
  ...raceNumbers.map((n) => ({ value: `race:${n}`, label: `Race ${n}` })),
  { value: 'qualifying:0', label: 'Qualifying' },
  { value: 'practice:0', label: 'Practice' },
];
const sessionLabelByValue = new Map(sessionOptions.map((o) => [o.value, o.label]));
function sessionKey(p: Penalty): string {
  return `${p.session_type}:${p.race_number}`;
}

/** "#04, #12" — car numbers only, sorted by car number, for every car tagged as involved. */
function involvedSummary(p: Penalty): string | null {
  if (p.involved_driver_ids.length === 0) return null;
  const sorted = [...p.involved_driver_ids].sort(
    (a, b) => (driverById.get(a)?.car_number ?? Infinity) - (driverById.get(b)?.car_number ?? Infinity)
  );
  return sorted.map((id) => (driverById.get(id)?.car_number != null ? `#${driverById.get(id)!.car_number}` : '?')).join(', ');
}

/** Numeric incident_number sorts numerically; a non-numeric or missing one sorts to the end (Infinity), then falls back to a string compare so two non-numeric incident numbers still sort predictably rather than by insertion order. */
/** "#12" — incident numbers are always shown with a leading # (not doubled if one was typed in). */
function formatIncidentNumber(n: string | null): string {
  const v = (n ?? '').trim();
  if (!v) return '—';
  return v.startsWith('#') ? v : `#${v}`;
}
function incidentNumberSortValue(p: Penalty): number {
  const n = p.incident_number ? Number(p.incident_number) : NaN;
  return Number.isFinite(n) ? n : Infinity;
}

// session_type sorts race < qualifying < practice (matches sessionOptions'
// own order) before falling back to race_number, so grouping below stays in
// that same order without a second sort pass.
const SESSION_TYPE_SORT_ORDER: Record<Penalty['session_type'], number> = { race: 0, qualifying: 1, practice: 2 };
const sortedPenalties = [...penalties].sort((a, b) => {
  if (a.session_type !== b.session_type) return SESSION_TYPE_SORT_ORDER[a.session_type] - SESSION_TYPE_SORT_ORDER[b.session_type];
  if (a.race_number !== b.race_number) return a.race_number - b.race_number;
  const numA = incidentNumberSortValue(a);
  const numB = incidentNumberSortValue(b);
  if (numA !== numB) return numA - numB;
  const strCmp = (a.incident_number ?? '').localeCompare(b.incident_number ?? '');
  if (strCmp !== 0) return strCmp;
  return new Date(a.created_at).getTime() - new Date(b.created_at).getTime();
});

// Broken apart per session (race, or Qualifying/Practice as a whole), same
// pattern as the results page's per-race tables — a session with no
// incidents logged just doesn't get a section.
const penaltiesBySession = new Map<string, Penalty[]>();
for (const p of sortedPenalties) {
  const key = sessionKey(p);
  if (!penaltiesBySession.has(key)) penaltiesBySession.set(key, []);
  penaltiesBySession.get(key)!.push(p);
}
/** Edit / Remove icon buttons at the end of admin rows (the icon's name shows on hover). */
const iconBtn = 'inline-flex h-7 w-7 items-center justify-center rounded-md text-white/40 transition hover:bg-white/10 hover:text-white';
const iconBtnDanger = 'inline-flex h-7 w-7 items-center justify-center rounded-md text-white/40 transition hover:bg-white/10 hover:text-brand-pink';

const sessionKeysWithIncidents = sessionOptions.map((o) => o.value).filter((key) => penaltiesBySession.has(key));

// Cumulative summary at the bottom of the report: one row per car penalized
// this round, with what they got in each race and where that leaves their
// season PP. Qualifying/practice penalties count against Race 1 (see
// scoringRaceNumber), so that's the column they're added to.
interface RaceTally { pp: number; warnings: number; time: number; points: number; fromQualiOrPractice: boolean }
interface SummaryRow {
  driverId: string;
  byRace: Map<number, RaceTally>;
  roundPP: number;
  roundWarnings: number;
  season: RoundPPSummary | null;
  seasonPPMax: number | null;
  /** Season warnings from earlier rounds / from this round — each adds 0.5 to the Season PP shown. Null when the season context didn't load. */
  earlierWarnings: number | null;
  seasonWarnings: number | null;
  /** The PP Penalties table row for this round's PP total. */
  tier: PPPenaltyTier | null;
  /** Round penalties that total calls for, each with the logged one if stewards have logged it. */
  due: { kind: RoundPenaltyKind; logged: RoundPenalty | null }[];
  /** Round penalties stewards logged for this driver here that the total didn't call for (e.g. Other, or a changed kind). */
  extra: RoundPenalty[];
}
const roundPenaltiesByDriver = new Map<string, Penalty[]>();
for (const p of penalties) {
  if (!p.driver_id) continue;
  if (!roundPenaltiesByDriver.has(p.driver_id)) roundPenaltiesByDriver.set(p.driver_id, []);
  roundPenaltiesByDriver.get(p.driver_id)!.push(p);
}

// Season context for the PP column: every penalty from this season's earlier
// rounds (start_time before this one), plus each driver's PP limit and
// probation state. If any of it fails to load, the table still shows this
// round's own numbers, just without the season columns. Stewards always get
// the driver list too, for the names in the owed-penalties box.
let earlierSeasonPenalties: Penalty[] = [];
let seasonDriverById = new Map<string, { name: string; car_number: number | null; penalty_points_max: number; on_probation: boolean; probation_started_at: string | null }>();
let seasonEvents: { event_date: string }[] = [];
let seasonContextLoaded = false;
const emptyRoundPenaltyData: RoundPenaltyData = { earnedHere: [], carriedIn: [], roundById: new Map(), available: false };
const [roundPenaltyData] = await Promise.all([
  round
    ? getRoundPenaltyData(supabaseEnv, { subsession_id: subsessionId, track_name: round.track_name, start_time: round.start_time })
    : Promise.resolve(emptyRoundPenaltyData),
  (async () => {
    if (!round || (roundPenaltiesByDriver.size === 0 && !isAdmin)) return;
    try {
      const [seasonRounds, drivers, events] = await Promise.all([
        getRoundsForSeason(supabaseEnv, round.season_id),
        getDrivers(supabaseEnv),
        getEvents(supabaseEnv),
      ]);
      const roundStart = new Date(round.start_time).getTime();
      const earlierIds = seasonRounds.filter((r) => new Date(r.start_time).getTime() < roundStart).map((r) => r.subsession_id);
      seasonDriverById = new Map(drivers.map((d) => [d.id, d]));
      seasonEvents = events;
      if (roundPenaltiesByDriver.size > 0) earlierSeasonPenalties = await getPenaltiesForSubsessions(supabaseEnv, earlierIds);
      seasonContextLoaded = true;
    } catch (err) {
      console.error('Failed to load season PP context for incident summary:', err);
    }
  })(),
]);

/** "#14 Jane Doe" — this round's drivers first, then the full roster (owed penalties can be for drivers not in this round). */
function driverLabel(driverId: string): string {
  const d = driverById.get(driverId) ?? seasonDriverById.get(driverId);
  return d ? `${d.car_number !== null ? `#${d.car_number} ` : ''}${d.name}` : 'Unknown driver';
}
/** "#14 J. Doe" — driverLabel() with the name shortened, for the compact cards. */
function shortDriverLabel(driverId: string): string {
  const d = driverById.get(driverId) ?? seasonDriverById.get(driverId);
  return d ? `${d.car_number !== null ? `#${d.car_number} ` : ''}${shortDriverName(d.name)}` : 'Unknown driver';
}
function roundRefLabel(id: number): string {
  const r = roundPenaltyData.roundById.get(id);
  return r ? `${r.track_name} (${formatDate(r.start_time)})` : `Round ${id}`;
}
const summaryRows: SummaryRow[] = [...roundPenaltiesByDriver].map(([driverId, driverPenalties]) => {
  const byRace = new Map<number, RaceTally>();
  for (const p of driverPenalties) {
    const race = scoringRaceNumber(p);
    const t = byRace.get(race) ?? { pp: 0, warnings: 0, time: 0, points: 0, fromQualiOrPractice: false };
    t.pp += effectivePenaltyPoints(p);
    if (p.is_warning) t.warnings += 1;
    t.time += effectiveTimePenaltySeconds(p) ?? 0;
    t.points += effectivePointsPenalty(p);
    if (p.session_type !== 'race') t.fromQualiOrPractice = true;
    byRace.set(race, t);
  }
  const seasonDriver = seasonDriverById.get(driverId);
  const earlier = earlierSeasonPenalties.filter((p) => p.driver_id === driverId);
  const roundPP = driverPenalties.reduce((sum, p) => sum + effectivePenaltyPoints(p), 0);
  const season = seasonContextLoaded && seasonDriver ? computeRoundPPSummary(seasonDriver, earlier, driverPenalties, seasonEvents) : null;
  // The rulebook's PP Penalties table, read at the round total (per Logan):
  // the parts a finished race can't take are due next round, plus the
  // 1-round ban for reaching the season limit.
  const tier = ppPenaltyTier(roundPP);
  const dueKinds: RoundPenaltyKind[] = [...(tier?.nextRound ?? []), ...(season?.hitLimit ? (['round_ban'] as const) : [])];
  const driverRoundPenalties = roundPenaltyData.earnedHere.filter((rp) => rp.driver_id === driverId);
  const due = dueKinds.map((kind) => ({ kind, logged: driverRoundPenalties.find((rp) => rp.kind === kind) ?? null }));
  return {
    driverId,
    byRace,
    roundPP,
    roundWarnings: countWarnings(driverPenalties),
    // AI entrants aren't in getDrivers(), so they get no season columns.
    season,
    seasonPPMax: seasonDriver?.penalty_points_max ?? null,
    earlierWarnings: seasonContextLoaded && seasonDriver ? countWarnings(earlier) : null,
    seasonWarnings: seasonContextLoaded && seasonDriver ? countWarnings(earlier) + countWarnings(driverPenalties) : null,
    tier,
    due,
    extra: driverRoundPenalties.filter((rp) => !due.some((d) => d.logged === rp)),
  };
});
summaryRows.sort(
  (a, b) => (driverById.get(a.driverId)?.car_number ?? Infinity) - (driverById.get(b.driverId)?.car_number ?? Infinity)
);


