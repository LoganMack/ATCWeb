              <summary class="flex cursor-pointer list-none items-center justify-between gap-2 [&::-webkit-details-marker]:hidden">
                <span class="flex items-center gap-2">
                  <h2 class="font-display text-2xl">{g.title}</h2>
                  <span class="font-display text-2xl text-white/40">{g.reports.length}</span>
                </span>
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4 flex-none text-white/40 transition-transform group-open:rotate-90" aria-hidden="true">
                  <polyline points="9 6 15 12 9 18" />
                </svg>
              </summary>
            {g.reports.length === 0 && <p class="mt-3 text-sm text-white/40">{g.empty}</p>}
            <ul class="mt-3 flex flex-col gap-2">
              {g.reports.map((r) => {
                const visibleReviews = reviewsByReport.get(r.id) ?? [];
                const myReview = myReviewOf(r.id);
                const reviewCount = reviewCounts.get(r.id) ?? visibleReviews.length;
                // Closed for good once first logged — a Reopen doesn't reopen voting (0096).
                const reviewsLocked = Boolean(r.reviews_closed_at);
                const involved = isInvolved(r);
                // Others' reviews (and the colour) only once you've voted, or once
                // the report is logged and voting is over — otherwise it would leak the outcome.
                // An involved steward can't vote, so there's no vote to keep blind.
                const canSeeReviews = Boolean(myReview) || reviewsLocked || involved;
                const agreement = canSeeReviews ? reviewAgreement(visibleReviews) : null;
                const style = agreement ? agreementStyles[agreement] : null;
                const duplicateOriginal = duplicateOriginalById.get(r.id);
                return (
                <li class={`rounded-lg border p-3 text-sm ${style ? style.item : 'border-white/10 bg-brand-ink'} ${r.status === 'open' ? '' : 'opacity-50'}`}>
                  <div class="flex flex-wrap items-center justify-between gap-2">
                    <p class="font-semibold text-white/80">
                      {reportLabel(r)}
                      {possibleDuplicateReportIds.has(r.id) && (
                        <span class="ml-1 font-normal text-brand-gold">(possible duplicate)</span>
                      )}
                    </p>
                    <div class="flex flex-wrap items-center gap-2">
                      {r.status === 'open' && (
                        <button
                          type="button"
                          data-log-report
                          data-report={JSON.stringify({ id: r.id, number: reportNumberById.get(r.id) ?? null, session: r.session, lap: r.lap, turn: r.turn, description: r.description, reporter: r.reporter_name, driver_ids: r.driver_ids })}
                          class="btn btn-primary btn-sm"
                        >
                          Log incident
                        </button>
                      )}
                      <form method="POST" action={formAction} data-astro-reload>
                        <input type="hidden" name="intent" value="set-report-status" />
                        <input type="hidden" name="report_id" value={r.id} />
                        <input type="hidden" name="status" value={r.status === 'open' ? 'dismissed' : 'open'} />
                        <button type="submit" class="btn btn-neutral btn-sm">
                          {r.status === 'open' ? 'Dismiss' : 'Reopen'}
                        </button>
                      </form>
                    </div>
                  </div>
                  <p class="mt-1 text-xs text-white/50">
                    Cars: {r.driver_ids.map((id) => { const d = driverById.get(id); return d ? `${d.car_number !== null ? `#${d.car_number} ` : ''}${d.name}` : 'Unknown'; }).join(', ')}
                  </p>
                  {r.description && <p class="mt-1 text-white/70">{r.description}</p>}
                  <p class="mt-1 text-[11px] text-white/30">
                    Reported {new Date(r.created_at).toLocaleString('en-US', { timeZone: 'America/New_York', dateStyle: 'medium', timeStyle: 'short' })} ET
                  </p>

                  <div class="mt-3 border-t border-white/10 pt-3">
                    <div class="flex flex-wrap items-center justify-between gap-2">
                      <p class="text-xs text-white/50">
                        Steward reviews: {reviewCount}
                        {style && <span class={`ml-2 font-semibold ${style.text}`}>{style.label}</span>}
                        {myReview && !style && reviewCount < REVIEW_AGREEMENT_MIN && (
                          <span class="ml-2 text-white/30">({REVIEW_AGREEMENT_MIN} needed to compare)</span>
                        )}
                      </p>
                      {reviewsLocked ? (
                        <span class="text-xs text-white/40">
                          {r.status === 'open'
                            ? 'Reopened after logging — reviews stay closed; log or dismiss it'
                            : 'Reviews closed — incident was logged'}
                        </span>
                      ) : involved ? (
                        <span class="text-xs text-white/40">You were involved — can't review</span>
                      ) : (
                        <button
                          type="button"
                          data-open-review-dialog
                          data-review={JSON.stringify({
                            report_id: r.id,
                            label: reportLabel(r),
                            // Null = not reviewed yet; [] = a Racing Incident review.
                            faults: myReview ? myReview.faults : null,
                            explanation: myReview?.explanation ?? '',
                          })}
                          class="btn btn-gold btn-sm"
                        >
                          {myReview ? 'Edit my review' : 'Review'}
                        </button>
                      )}
                    </div>

                    {duplicateOriginal && (
                      <p class="mt-2 text-xs text-brand-gold">
                        Possible duplicate of an earlier report ({reportLabel(duplicateOriginal)}) — review that one instead.
                      </p>
                    )}

                    {/* Collapsed by default, like the Dismissed group — every action on
                        this page reloads it, so a list that started open would undo
                        any hiding. The count and agreement colour above stay visible. */}
                    {canSeeReviews && visibleReviews.length > 0 ? (
                      <details class="group/reviews mt-2">
                        <summary class="flex cursor-pointer list-none items-center gap-2 text-xs text-white/50 hover:text-white/70 [&::-webkit-details-marker]:hidden">
                          <span class="inline-block text-[9px] text-white/40 transition-transform duration-150 group-open/reviews:rotate-90" aria-hidden="true">&#9654;</span>
                          <span class="group-open/reviews:hidden">Show reviews ({visibleReviews.length})</span>
                          <span class="hidden group-open/reviews:inline">Hide reviews</span>
                        </summary>
                        <ul class="mt-1.5 flex flex-col gap-2">
                          {visibleReviews.map((v) => (
                            <li class="rounded-md bg-white/5 p-2 text-xs">
                              <p class="font-semibold text-white/80">
                                {v.reviewer_id === myUserId ? 'You' : (v.reviewer_name ?? 'Unknown steward')}
                                <span class="font-normal text-white/50">
                                  {' · '}
                                  {v.faults.length === 0
                                    ? 'Racing Incident'
                                    : v.faults.map((f) => `${reviewDriverLabel(f.driver_id)} · ${reviewPenaltyLabel(f.penalty)}`).join(', ')}
                                </span>
                                {v.edited_at && <span class="ml-1 font-normal italic text-white/40">(edited)</span>}
                              </p>
                              <p class="mt-1 whitespace-pre-line text-white/70">{v.explanation}</p>
                            </li>
                          ))}
                        </ul>
                      </details>
                    ) : (
                      reviewCount > 0 && !reviewsLocked && (
                        <p class="mt-2 text-xs text-white/40">Submit your own review to see the other stewards'.</p>
                      )
                    )}
                  </div>
                </li>
                );
              })}
            </ul>
            </details>
            </div>
            ))}
          </div>
        )}

        {isAdmin && incidentAppeals.length > 0 && (
          <details class="group mt-6 rounded-xl border border-brand-gold/30 bg-brand-gold/5 p-4">
            <summary class="flex cursor-pointer list-none items-center gap-2 [&::-webkit-details-marker]:hidden">
              <span class="inline-block text-[10px] text-brand-gold/70 transition-transform duration-150 group-open:rotate-90" aria-hidden="true">&#9654;</span>
              <h2 class="font-display text-xl text-brand-gold">
                Submitted Appeals
                <span class="ml-2 text-sm text-white/40">
                  {incidentAppeals.filter((a) => a.status === 'open').length} open
                </span>
              </h2>
            </summary>
            <ul class="mt-3 flex flex-col gap-2">
              {incidentAppeals.map((a) => {
                const appealed = penalties.find((p) => p.id === a.penalty_id);
                const appealedDriver = appealed?.driver_id ? driverById.get(appealed.driver_id) : undefined;
                return (
                  <li class={`rounded-lg border border-white/10 bg-brand-ink p-3 text-sm ${a.status === 'open' ? '' : 'opacity-50'}`}>
                    <div class="flex flex-wrap items-center justify-between gap-2">
                      <p class="font-semibold text-white/80">
                        {appealed?.incident_number ? `Incident ${formatIncidentNumber(appealed.incident_number)}` : 'Incident'}
                        {appealed && (
                          <span class="font-normal text-white/50">
                            {' · '}
                            {appealed.driver_id === null ? 'Racing Incident' : (appealedDriver?.car_number != null ? `#${appealedDriver.car_number} ${appealedDriver.name}` : (appealedDriver?.name ?? 'Unknown driver'))}
                            {appealed.lap != null && ` · Lap ${appealed.lap}`}
                          </span>
                        )}
                      </p>
                      <div class="flex flex-wrap items-center gap-2">
                        {a.status === 'open' && (
                          <form method="POST" action={formAction} data-astro-reload>
                            <input type="hidden" name="intent" value="set-appeal-status" />
                            <input type="hidden" name="appeal_id" value={a.id} />
                            <input type="hidden" name="status" value="reviewed" />
                            <button type="submit" class="btn btn-primary btn-sm">Mark reviewed</button>
                          </form>
                        )}
                        <form method="POST" action={formAction} data-astro-reload>
                          <input type="hidden" name="intent" value="set-appeal-status" />
                          <input type="hidden" name="appeal_id" value={a.id} />
                          <input type="hidden" name="status" value={a.status === 'open' ? 'dismissed' : 'open'} />
                          <button type="submit" class="btn btn-neutral btn-sm">
                            {a.status === 'open' ? 'Dismiss' : 'Reopen'}
                          </button>
                        </form>
                      </div>
                    </div>
                    <p class="mt-2 whitespace-pre-line text-white/70">{a.message}</p>
                    {a.files.length > 0 && (
                      <ul class="mt-2 flex flex-wrap gap-2">
                        {a.files.map((f) => {
                          const url = appealFileUrls.get(f.path) ?? null;
                          const label = `${f.name} (${(f.size / 1048576).toFixed(1)} MB)`;
                          return (
                            <li>
                              {url ? (
                                <a href={url} target="_blank" rel="noopener noreferrer" class="btn btn-primary btn-sm inline-block">{label}</a>
                              ) : (
                                <span class="inline-block rounded-md bg-white/5 px-2 py-1 text-xs text-white/40" title="Couldn't create a download link">{label}</span>
                              )}
                            </li>
                          );
                        })}
                      </ul>
                    )}
                    <p class="mt-2 text-[11px] text-white/30">
                      Submitted by {a.submitter_name ?? (a.submitter_id ? 'a signed-in user' : 'a signed-out visitor')} · {new Date(a.created_at).toLocaleString('en-US', { timeZone: 'America/New_York', dateStyle: 'medium', timeStyle: 'short' })} ET
                      {a.status !== 'open' && ` · ${a.status}`}
                    </p>
                  </li>
                );
              })}
            </ul>
          </details>
        )}

        {isAdmin && !viewReports && (
          <div class="mt-6 flex flex-wrap items-center gap-2">
            <button
              type="button"
              data-open-incident-dialog
              class="btn btn-primary"
            >
              + Add Incident To Report
            </button>

            <details class="relative">
              <summary class="btn btn-neutral list-none">
                Import incidents from CSV
              </summary>
              <div class="absolute left-0 z-10 mt-2 flex w-80 flex-col gap-3 rounded-lg border border-white/10 bg-brand-ink p-4 text-xs text-white/60 shadow-xl">
                <a
                  href="/incident-report-template.csv"
                  download
                  class="btn btn-neutral self-start"
                >
                  Download CSV template
                </a>
                <form method="POST" action={formAction} enctype="multipart/form-data" data-astro-reload class="flex flex-col gap-2">
                  <input type="hidden" name="intent" value="import-csv" />
                  <input
                    type="file"
                    name="csv_file"
                    accept=".csv"
                    required
                    class="text-xs text-white/60 file:mr-2 file:rounded file:border-0 file:bg-brand-primary file:px-3 file:py-1.5 file:text-xs file:font-semibold file:text-white file:transition hover:file:brightness-110"
                  />
                  <button type="submit" class="btn btn-primary btn-sm self-start">
                    Upload
                  </button>
                </form>
                <p class="text-white/30">
                  Rows are matched by race number and driver car number — anything unrecognized is skipped rather than
                  failing the whole import. Use "RI" as the driver car number for a Racing Incident (no driver at fault).
                </p>
              </div>
            </details>
          </div>
        )}

        {!viewReports && sortedPenalties.length === 0 && (
          <div class="mt-10 flex flex-wrap items-center gap-3">
            {/* Edit Report (admin, no ?view=reports) shows just the button instead; View Incidents only
                shows it when there are no submitted reports either, so it doesn't read as "nothing here"
                underneath a list of reports still waiting to be logged. */}
            {(!isAdmin || (viewReports && incidentReports.length === 0)) && (
              <p class="text-white/60">No incidents logged for this round.</p>
            )}
            {isAdmin && !viewReports && (
              <a
                href={viewReportsHref}
                class="btn btn-neutral"
              >
                To view submitted incidents, click here
              </a>
            )}
          </div>
        )}

        {!viewReports && sessionKeysWithIncidents.map((key) => (
          <div class="mt-10">
            <h3 class="text-xs font-semibold uppercase tracking-widest text-white/40">{sessionLabelByValue.get(key)}</h3>
            <div class="mt-2 rounded-xl border border-white/10" data-sticky-thead>
              <table class="w-full border-collapse">
                <thead>
                  <tr class="border-b border-white/10 text-left text-xs uppercase tracking-wide text-white/40">
                    {/* Columns shown: on mobile just #, Lap, Driver and PP; from md
                        up also Involved, Time, Pts, Pos Δ and Pts Δ. Everything
                        else about an incident (description, offenses, appeal
                        notes) lives in the details popup — click/tap any row
                        (the › at the end of it) to open it
                        ([data-incident-row] / [data-incident-details-dialog]
                        below), per Logan. */}
                    <th class="py-3 pl-4 pr-3 font-medium">#</th>
                    <th class="py-3 pr-3 text-center font-medium">Lap</th>
                    <th class="py-3 pr-3 font-medium">Driver</th>
                    <th class="hidden py-3 pr-3 font-medium md:table-cell">Involved</th>
                    <th class="py-3 pr-3 text-center font-medium">PP</th>
                    <th class="hidden py-3 pr-3 text-center font-medium md:table-cell">Time</th>
                    <th class="hidden py-3 pr-3 text-center font-medium md:table-cell">Pts</th>
                    <th class="hidden py-3 pr-3 text-center font-medium md:table-cell">Pos &Delta;</th>
                    <th class="hidden py-3 pr-3 text-center font-medium md:table-cell">Pts &Delta;</th>
                    <th class="w-8 py-3 pr-4"><span class="sr-only">Details</span></th>
                  </tr>
                </thead>
                <tbody>
                  {penaltiesBySession.get(key)!.map((p) => {
                    const driver = p.driver_id ? driverById.get(p.driver_id) : undefined;
                    const { positionDelta, pointsDelta } = deltaFor(p);
                    const time = effectiveTimePenaltySeconds(p);
                    const points = effectivePointsPenalty(p);
                    const pp = effectivePenaltyPoints(p);
                    return (
                      <>
                        <tr
                          class={`${isAdmin ? '' : 'border-b border-white/5 '}cursor-pointer text-sm transition hover:bg-white/[0.03] active:bg-white/5`}
                          tabindex="0"
                          role="button"
                          data-incident-row
                          data-incident-summary={JSON.stringify({
                            penaltyId: p.id,
                            driverLabel: p.driver_id === null ? 'Racing Incident (no driver at fault)' : (driver?.car_number != null ? `#${driver.car_number}` : '—'),
                            incidentNumber: formatIncidentNumber(p.incident_number),
                            lap: p.lap,
                            involved: involvedSummary(p),
                            description: p.description,
                            offenses: p.offense_ids.map((id) => offenseNameById.get(id) ?? '?'),
                            isWarning: p.is_warning,
                            pp,
                            time,
                            points,
                            positionDelta: formatDelta(positionDelta),
                            positionDeltaClass: deltaClass(positionDelta),
                            pointsDelta: formatDelta(pointsDelta),
                            pointsDeltaClass: deltaClass(pointsDelta),
                            isAppealed: p.is_appealed,
                            appealResult: p.appeal_result,
                          })}
                        >
                          <td class="py-2.5 pl-4 pr-3 text-white/60">{formatIncidentNumber(p.incident_number)}</td>
                          <td class="py-2.5 pr-3 text-center text-white/60">{p.lap ?? '—'}</td>
                          <td class="py-2.5 pr-3 font-semibold">
                            <div title={p.driver_id === null ? 'Racing Incident — no driver at fault' : undefined}>
                              {p.driver_id === null ? 'RI' : (driver?.car_number != null ? `#${driver.car_number}` : '—')}
                            </div>
                          </td>
                          <td class="hidden py-2.5 pr-3 text-white/50 md:table-cell">{involvedSummary(p) ?? '—'}</td>
                          <td class="py-2.5 pr-3 text-center text-white/60">
                            {/* A warning never carries a PP value of its own
                                (penalty_points is stored 0 — see this file's
                                own "warning" sentinel comment above), so
                                showing both would always read as "— Warning"
                                — just the word, no placeholder dash, per
                                Logan. */}
                            {p.is_warning ? (
                              <div class="text-[9px] font-semibold uppercase tracking-wide text-brand-gold">Warning</div>
                            ) : (
                              <div>{pp || '—'}</div>
                            )}
                          </td>
                          <td class="hidden py-2.5 pr-3 text-center text-white/60 md:table-cell">{time ? `+${time}s` : '—'}</td>
                          <td class="hidden py-2.5 pr-3 text-center text-white/60 md:table-cell">{points ? points : '—'}</td>
                          <td class={`hidden py-2.5 pr-3 text-center font-semibold md:table-cell ${deltaClass(positionDelta)}`}>{formatDelta(positionDelta)}</td>
                          <td class={`hidden py-2.5 pr-3 text-center font-semibold md:table-cell ${deltaClass(pointsDelta)}`}>{formatDelta(pointsDelta)}</td>
                          <td class="py-2.5 pr-4 text-right text-lg leading-none text-white/30" aria-hidden="true">&rsaquo;</td>
                        </tr>
                        {isAdmin && (
                          <tr class="border-b border-white/5 text-sm">
                            <td colspan={10} class="py-1.5 pl-4 pr-4">
                              <div class="flex justify-start gap-3">
                                <button
                                  type="button"
                                  data-edit-incident
                                  data-incident={JSON.stringify({
                                    id: p.id,
                                    session: sessionKey(p),
                                    driver_id: p.driver_id,
                                    incident_number: p.incident_number,
                                    lap: p.lap,
                                    description: p.description,
                                    time_penalty_seconds: p.time_penalty_seconds,
                                    points_penalty: p.points_penalty,
                                    penalty_points: p.penalty_points,
                                    is_warning: p.is_warning,
                                    offense_ids: p.offense_ids,
                                    involved_driver_ids: p.involved_driver_ids,
                                    is_appealed: p.is_appealed,
                                    appeal_result: p.appeal_result,
                                    appeal_time_penalty_seconds: p.appeal_time_penalty_seconds,
                                    appeal_points_penalty: p.appeal_points_penalty,
                                    appeal_penalty_points: p.appeal_penalty_points,
                                  })}
                                  class="text-xs font-semibold text-white/40 hover:text-white"
                                >
                                  Edit
                                </button>
                                <form method="POST" action={formAction} data-astro-reload class="inline">
                                  <input type="hidden" name="intent" value="delete-incident" />
                                  <input type="hidden" name="penalty_id" value={p.id} />
                                  <input type="hidden" name="driver_id" value={p.driver_id ?? ''} />
                                  <button type="submit" class="text-xs font-semibold text-white/40 hover:text-brand-pink">
                                    Remove
                                  </button>
                                </form>
                              </div>
                            </td>
                          </tr>
                        )}
                      </>
                    );
                  })}
                </tbody>
              </table>
            </div>
          </div>
        ))}

        {isAdmin && (
          <dialog
            id="incident-dialog"
            data-incident-dialog
            data-next-incident-number={nextIncidentNumber}
            data-used-incident-numbers={JSON.stringify([...new Set(penalties.map((p) => p.incident_number).filter(Boolean))])}
            class="w-full max-w-2xl rounded-xl border border-white/10 bg-brand-ink p-0 text-white backdrop:bg-black/60"
          >
            <form method="POST" action={formAction} data-astro-reload class="flex max-h-[85vh] flex-col gap-3 overflow-y-auto p-5">
              <input type="hidden" name="intent" data-incident-intent-field value="add-incident" />
              <input type="hidden" name="penalty_id" data-incident-id-field value="" />
              {/* Edit only: the car the row belonged to before this edit, so its PP is re-tallied if the edit moves the penalty to another car. */}
              <input type="hidden" name="original_driver_id" data-incident-original-driver-field value="" />
              <input type="hidden" name="from_report_id" data-incident-from-report-field value="" />

              <div class="flex items-center justify-between">
                <h4 class="font-display text-xl" data-incident-heading>Add Incident</h4>
                <button type="button" data-close-incident-dialog class="text-white/40 hover:text-white">✕</button>
              </div>

              <div class="grid grid-cols-3 gap-3">
                <label class="flex flex-col gap-1 text-[11px] text-white/50">
                  Incident #
                  <input type="text" name="incident_number" data-incident-number-field required class="rounded-md border border-white/15 bg-white/5 px-2 py-1.5 text-sm text-white outline-none focus:border-brand-primary" />
                </label>
                <label class="flex flex-col gap-1 text-[11px] text-white/50">
                  Session
                  <select
                    name="session"
                    data-incident-session-field
                    required
                    class="rounded-md border border-white/15 bg-white/5 px-2 py-1.5 text-sm text-white outline-none focus:border-brand-primary"
                  >
                    <option value="" selected disabled hidden class="bg-brand-ink text-white">Select session…</option>
                    {sessionOptions.map((o) => <option value={o.value} class="bg-brand-ink text-white">{o.label}</option>)}
                  </select>
                </label>
                <label class="flex flex-col gap-1 text-[11px] text-white/50">
                  Lap
                  <input type="number" name="lap" data-incident-lap-field required class="rounded-md border border-white/15 bg-white/5 px-2 py-1.5 text-sm text-white outline-none focus:border-brand-primary" />
                </label>
              </div>
              {/* Shown when the Incident # is already used by a logged incident this round. A warning only — saving is still allowed. */}
              <p data-incident-number-warning class="hidden rounded-md border border-brand-gold/40 bg-brand-gold/10 px-3 py-2 text-xs text-brand-gold">
                ⚠ Incident #<span data-incident-number-warning-value></span> is already logged this round. Double-check the number before saving.
              </p>

              {/* Cars at fault (src/scripts/faultCards.ts): tick every car at fault
                  and each gets its own card with its own PP/Warning, time penalty,
                  points penalty and offenses. Saving creates one penalty row per
                  car, all sharing this incident's #, session, lap, description and
                  involved cars. Racing Incident (no car at fault,
                  0020_penalty_racing_incident.sql) is one row with no driver.
                  Editing an existing row is one car only (single mode). */}
              <div data-fault-root data-incident-faults class="flex flex-col gap-2">
                <fieldset data-fault-picker data-driver-picker class="flex flex-col gap-1 text-[11px] text-white/50">
                  <legend class="mb-1" data-incident-fault-legend>Cars at fault</legend>
                  <input
                    type="search"
                    data-driver-search
                    placeholder="Search by car number or name…"
                    aria-label="Search drivers"
                    class="rounded-md border border-white/15 bg-white/5 px-2 py-1.5 text-sm text-white outline-none focus:border-brand-primary"
                  />
                  <div class="mt-1 grid max-h-40 grid-cols-3 gap-x-4 gap-y-1 overflow-y-auto rounded-md border border-white/15 bg-white/5 p-2">
                    <label class="col-span-3 flex items-center gap-2 text-xs text-white/70">
                      <input type="checkbox" data-fault-racing-incident />
                      Racing Incident (no driver at fault)
                    </label>
                    {roundDrivers.length === 0 && <span class="col-span-3 text-white/30">No drivers in this round.</span>}
                    {roundDrivers.map((d) => (
                      <label
                        data-driver-option
                        data-search={`${d.car_number !== null ? `#${d.car_number} ` : ''}${d.name}`.toLowerCase()}
                        data-fault-label={`${d.car_number !== null ? `#${d.car_number} ` : ''}${d.name}`}
                        class="flex items-center gap-2 text-xs text-white/70"
                      >
                        <input type="checkbox" name="fault_driver_ids" value={d.id} />
                        {d.car_number !== null && <span class="text-white/30">#{d.car_number}</span>} {d.name}
                      </label>
                    ))}
                    <p data-driver-search-empty class="col-span-3 hidden text-white/30">No matches.</p>
                  </div>
                </fieldset>
                <div data-fault-cards class="flex flex-col gap-2"></div>
                <template data-fault-card-template>
                  <div class="flex flex-col gap-2 rounded-md border border-white/10 bg-white/[0.03] p-3">
                    <p data-fault-card-label class="text-xs font-semibold text-white/80"></p>
                    <div class="grid grid-cols-3 gap-3">
                      <label class="flex flex-col gap-1 text-[11px] text-white/50">
                        Penalty points (PP)
                        <select name="penalty_points_choice:__ID__" class="rounded-md border border-white/15 bg-white/5 px-2 py-1.5 text-sm text-white outline-none focus:border-brand-primary">
                          <option value="" class="bg-brand-ink text-white">0</option>
                          <option value="warning" class="bg-brand-ink text-white">Warning</option>
                          {[1, 2, 3, 4, 5, 6, 7].map((n) => <option value={String(n)} class="bg-brand-ink text-white">{n}</option>)}
                        </select>
                      </label>
                      <label class="flex flex-col gap-1 text-[11px] text-white/50">
                        Time penalty (seconds)
                        <input type="number" step="1" placeholder="0" name="time_penalty_seconds:__ID__" class="rounded-md border border-white/15 bg-white/5 px-2 py-1.5 text-sm text-white outline-none focus:border-brand-primary" />
                      </label>
                      <label class="flex flex-col gap-1 text-[11px] text-white/50">
                        Points penalty
                        <input type="number" name="points_penalty:__ID__" placeholder="0" class="rounded-md border border-white/15 bg-white/5 px-2 py-1.5 text-sm text-white outline-none focus:border-brand-primary" />
                      </label>
                    </div>
                    <fieldset class="flex flex-col gap-1 text-[11px] text-white/50">
                      <legend class="mb-1">Offenses (rulebook section 5)</legend>
                      <div class="grid max-h-32 grid-cols-2 gap-x-4 gap-y-1 overflow-y-auto rounded-md border border-white/15 bg-white/5 p-2">
                        {offenses.length === 0 && <span class="col-span-2 text-white/30">No offenses configured — add some at /admin/site-properties.</span>}
                        {offenses.map((o) => (
                          <label class="flex items-center gap-2 text-xs text-white/70">
                            <input type="checkbox" name="offense_ids:__ID__" value={o.id} />
                            {o.name} {o.reference_points && <span class="text-white/30">({o.reference_points})</span>}
                          </label>
                        ))}
                      </div>
                    </fieldset>
                  </div>
                </template>
              </div>

              <p data-incident-missing-fields class="text-[11px] font-semibold text-brand-gold"></p>

              <div data-incident-rest class="hidden flex-col gap-3">
                <label class="flex flex-col gap-1 text-[11px] text-white/50">
                  Description
                  <textarea name="description" rows="2" class="rounded-md border border-white/15 bg-white/5 px-2 py-1.5 text-sm text-white outline-none focus:border-brand-primary"></textarea>
                </label>

                {/* Edit only: an appeal is about one car's existing penalty, so it's
                    never set while adding (which can create several at once). */}
                <label data-incident-edit-only class="flex items-center gap-2 text-xs text-white/70">
                  <input type="checkbox" name="is_appealed" data-appeal-checkbox />
                  Appealed
                </label>

                <div data-appeal-fields class="hidden flex-col gap-3 rounded-md border border-white/10 bg-brand-ink p-3">
                  <label class="flex flex-col gap-1 text-[11px] text-white/50">
                    Appeal result
                    <textarea
                      name="appeal_result"
                      rows="2"
                      placeholder="e.g. Upheld — reduced to 5s"
                      class="rounded-md border border-white/15 bg-white/5 px-2 py-1.5 text-sm text-white outline-none focus:border-brand-primary"
                    ></textarea>
                  </label>
                  <div class="grid grid-cols-3 gap-3">
                    <label class="flex flex-col gap-1 text-[11px] text-white/50">
                      New penalty points (PP)
                      <input type="number" name="appeal_penalty_points" placeholder="0" class="rounded-md border border-white/15 bg-white/5 px-2 py-1.5 text-sm text-white outline-none focus:border-brand-primary" />
                    </label>
                    <label class="flex flex-col gap-1 text-[11px] text-white/50">
                      New time penalty (seconds)
                      <input type="number" step="1" placeholder="0" name="appeal_time_penalty_seconds" class="rounded-md border border-white/15 bg-white/5 px-2 py-1.5 text-sm text-white outline-none focus:border-brand-primary" />
                    </label>
                    <label class="flex flex-col gap-1 text-[11px] text-white/50">
                      New points penalty
                      <input type="number" name="appeal_points_penalty" placeholder="0" class="rounded-md border border-white/15 bg-white/5 px-2 py-1.5 text-sm text-white outline-none focus:border-brand-primary" />
                    </label>
                  </div>
                  <p class="text-[11px] text-white/30">
                    These values replace the original values, which stay on record but stop being applied.
                  </p>
                </div>

                <fieldset class="flex flex-col gap-1 text-[11px] text-white/50">
                  <legend class="mb-1">Involved</legend>
                  <div class="grid max-h-40 grid-cols-3 gap-x-4 gap-y-1 overflow-y-auto rounded-md border border-white/15 bg-white/5 p-2">
                    {roundDrivers.length === 0 && <span class="col-span-3 text-white/30">No drivers in this round.</span>}
                    {roundDrivers.map((d) => (
                      <label class="flex items-center gap-2 text-xs text-white/70">
                        <input type="checkbox" name="involved_driver_ids" value={d.id} />
                        {d.car_number !== null && <span class="text-white/30">#{d.car_number}</span>} {d.name}
                      </label>
                    ))}
                  </div>
                </fieldset>
              </div>

              <button
                type="submit"
                data-incident-save-button
                class="btn btn-primary mt-1"
              >
                Save Incident
              </button>
            </form>
          </dialog>
        )}

        {/* "Incident Details" popup — opened by clicking/tapping any incident
            row (desktop and mobile alike). The table itself leaves out the
            description, offenses and appeal notes, so this card is where
            everything about one incident is readable in one place. Every
            viewer gets it (not isAdmin-gated) — it's read-only, apart from
            the "Submit Appeal" button at the bottom, which opens the appeal
            form below while the Incident Appeal Window is open. */}
        <dialog
          data-mobile-incident-dialog
          class="w-full max-w-sm rounded-xl border border-white/10 bg-brand-ink p-0 text-white backdrop:bg-black/60 md:max-w-md"
        >
          <div class="flex max-h-[85vh] flex-col gap-4 overflow-y-auto p-5">
            <div class="flex items-center justify-between">
              <h4 class="font-display text-lg">Incident Details</h4>
              <button type="button" data-close-mobile-incident-dialog class="text-white/40 hover:text-white">✕</button>
            </div>

            <dl class="flex flex-col gap-3 text-sm">
              <div>
                <dt class="text-[11px] uppercase tracking-wide text-white/40">Driver</dt>
                <dd data-mobile-driver class="mt-0.5 font-semibold"></dd>
              </div>
              <div class="flex gap-6">
                <div>
                  <dt class="text-[11px] uppercase tracking-wide text-white/40">Incident #</dt>
                  <dd data-mobile-incident-number class="mt-0.5"></dd>
                </div>
                <div>
                  <dt class="text-[11px] uppercase tracking-wide text-white/40">Lap</dt>
                  <dd data-mobile-lap class="mt-0.5"></dd>
                </div>
              </div>
              <div data-mobile-involved-row class="hidden">
                <dt class="text-[11px] uppercase tracking-wide text-white/40">Involved</dt>
                <dd data-mobile-involved class="mt-0.5 text-white/70"></dd>
              </div>
              <div data-mobile-description-row class="hidden">
                <dt class="text-[11px] uppercase tracking-wide text-white/40">Description</dt>
                <dd data-mobile-description class="mt-0.5 text-white/70"></dd>
              </div>
              <div data-mobile-offenses-row class="hidden">
                <dt class="text-[11px] uppercase tracking-wide text-white/40">Offenses</dt>
                <dd data-mobile-offenses class="mt-0.5 flex flex-col gap-0.5 text-white/70"></dd>
              </div>
              <div class="flex gap-6">
                <div>
                  <dt class="text-[11px] uppercase tracking-wide text-white/40">PP</dt>
                  <dd data-mobile-pp class="mt-0.5"></dd>
                </div>
                <div>
                  <dt class="text-[11px] uppercase tracking-wide text-white/40">Time</dt>
                  <dd data-mobile-time class="mt-0.5"></dd>
                </div>
                <div>
                  <dt class="text-[11px] uppercase tracking-wide text-white/40">Pts</dt>
                  <dd data-mobile-points class="mt-0.5"></dd>
                </div>
              </div>
              <div class="flex gap-6">
                <div>
                  <dt class="text-[11px] uppercase tracking-wide text-white/40">Pos &Delta;</dt>
                  <dd data-mobile-position-delta class="mt-0.5 font-semibold"></dd>
                </div>
                <div>
                  <dt class="text-[11px] uppercase tracking-wide text-white/40">Pts &Delta;</dt>
                  <dd data-mobile-points-delta class="mt-0.5 font-semibold"></dd>
                </div>
              </div>
              <div data-mobile-appeal-row class="hidden rounded-md border border-brand-pink/30 bg-brand-pink/10 p-2">
                <dt class="text-[10px] font-semibold uppercase tracking-wide text-brand-pink">Appealed</dt>
                <dd data-mobile-appeal class="mt-1 text-[13px] text-brand-pink/90"></dd>
              </div>
            </dl>

            <div class="flex justify-end">
              <button
                type="button"
                data-open-appeal-dialog
                data-appeal-closes-at={appealClosesAt?.toISOString() ?? ''}
                data-appeal-open={appealOpen ? 'true' : 'false'}
                disabled={!appealOpen}
                title={appealOpen ? 'Appeal this incident.' : 'The appeal window for this incident has closed.'}
                class="btn btn-gold"
              >
                Submit Appeal
              </button>
            </div>
          </div>
        </dialog>

        <dialog
          data-appeal-dialog
          class="w-full max-w-md rounded-xl border border-white/10 bg-brand-ink p-0 text-white backdrop:bg-black/60"
        >
          <form method="POST" action={formAction} enctype="multipart/form-data" data-astro-reload data-appeal-form class="flex max-h-[85vh] flex-col gap-4 overflow-y-auto p-5">
            <input type="hidden" name="intent" value="submit-appeal" />
            <input type="hidden" name="penalty_id" data-appeal-penalty-id />
            <input type="text" name="website" tabindex="-1" autocomplete="off" class="hidden" aria-hidden="true" />
            <div class="flex items-center justify-between">
              <h4 class="font-display text-lg">Submit Appeal <span data-appeal-incident-label class="text-white/50"></span></h4>
              <button type="button" data-close-appeal-dialog class="text-white/40 hover:text-white">✕</button>
            </div>
            <label class="block text-sm">
              <span class="text-white/60">Why should this incident be reviewed?</span>
              <textarea
                name="message"
                required
                rows="6"
                maxlength={APPEAL_MAX_MESSAGE_LENGTH}
                class="mt-1 block w-full rounded-lg border border-white/10 bg-white/5 px-3 py-2 text-white"
              ></textarea>
            </label>
            <label class="block text-sm">
              <span class="text-white/60">Attachments (optional — up to {APPEAL_MAX_FILES} files, 10 MB each)</span>
              <input
                type="file"
                name="files"
                multiple
                accept={APPEAL_ALLOWED_MIME_TYPES.join(',')}
                data-appeal-files
                class="mt-1 block w-full text-xs text-white/60 file:mr-2 file:rounded file:border-0 file:bg-white/10 file:px-3 file:py-1.5 file:text-xs file:font-semibold file:text-white file:transition hover:file:bg-white/20"
              />
              <span class="mt-1 block text-[11px] text-white/30">Images, PDFs, videos (MP4/WebM/MOV) or text files.</span>
            </label>
            <p data-appeal-error class="hidden rounded-md border border-brand-pink/30 bg-brand-pink/10 p-2 text-xs text-brand-pink/90"></p>
            <div class="flex justify-end gap-2">
              <button type="button" data-close-appeal-dialog class="btn btn-neutral">Cancel</button>
              <button type="submit" class="btn btn-gold">Submit Appeal</button>
            </div>
          </form>
        </dialog>

        {viewReports && (
          <dialog
            data-review-dialog
            class="w-full max-w-md rounded-xl border border-white/10 bg-brand-ink p-0 text-white backdrop:bg-black/60"
          >
            <form method="POST" action={formAction} data-astro-reload class="flex max-h-[85vh] flex-col gap-4 overflow-y-auto p-5">
              <input type="hidden" name="intent" value="save-review" />
              <input type="hidden" name="report_id" data-review-report-id />
              <div class="flex items-center justify-between gap-3">
                <h4 class="font-display text-lg">Steward Review <span data-review-label class="text-white/50"></span></h4>
                <button type="button" data-close-review-dialog class="text-white/40 hover:text-white">✕</button>
              </div>
              {/* Cars at fault (src/scripts/faultCards.ts): a searchable checklist —
                  dropdown options can't be filtered reliably across browsers (see
                  src/scripts/driverPickerSearch.ts) — where every ticked car gets
                  its own suggested penalty. Racing Incident = no car ticked. */}
              <div data-fault-root data-review-faults class="flex flex-col gap-2">
                <fieldset class="flex flex-col gap-1 text-[11px] text-white/50" data-fault-picker data-driver-picker>
                  <legend class="mb-1">Cars at Fault</legend>
                  <label class="flex items-center gap-2 text-xs text-white/70">
                    <input type="checkbox" name="racing_incident" data-fault-racing-incident />
                    Racing Incident (no driver at fault)
                  </label>
                  <input
                    type="search"
                    data-driver-search
                    placeholder="Search by car number or name…"
                    aria-label="Search drivers"
                    class="rounded-md border border-white/15 bg-white/5 px-2 py-1.5 text-sm text-white outline-none focus:border-brand-primary"
                  />
                  <div class="grid max-h-48 grid-cols-1 gap-y-1 overflow-y-auto rounded-md border border-white/15 bg-white/5 p-2 sm:grid-cols-2 sm:gap-x-4">
                    {roundDrivers.length === 0 && <span class="col-span-full text-white/30">No drivers in this round.</span>}
                    {roundDrivers.map((d) => (
                      <label
                        class="flex items-center gap-2 text-xs text-white/70"
                        data-driver-option
                        data-search={`${d.car_number !== null ? `#${d.car_number} ` : ''}${d.name}`.toLowerCase()}
                        data-fault-label={`${d.car_number !== null ? `#${d.car_number} ` : ''}${d.name}`}
                      >
                        <input type="checkbox" name="fault_driver_ids" value={d.id} />
                        {d.car_number !== null && <span class="text-white/30">#{d.car_number}</span>} {d.name}
                      </label>
                    ))}
                    <p data-driver-search-empty class="col-span-full hidden text-white/30">No matches.</p>
                  </div>
                </fieldset>
                <div data-fault-cards class="flex flex-col gap-2"></div>
                <template data-fault-card-template>
                  <label class="flex items-center justify-between gap-3 rounded-md border border-white/10 bg-white/[0.03] px-3 py-2 text-[11px] text-white/50">
                    <span data-fault-card-label class="text-xs font-semibold text-white/80"></span>
                    <select
                      name="penalty:__ID__"
                      required
                      class="rounded-md border border-white/15 bg-white/5 px-2 py-1.5 text-sm text-white outline-none focus:border-brand-primary"
                    >
                      <option value="" selected disabled hidden class="bg-brand-ink text-white">Select penalty…</option>
                      {REVIEW_PENALTIES.map((p) => (
                        <option value={p} class="bg-brand-ink text-white">{reviewPenaltyLabel(p)}</option>
                      ))}
                    </select>
                  </label>
                </template>
                <p data-review-faults-missing class="hidden text-[11px] font-semibold text-brand-gold">Tick the car(s) at fault, or Racing Incident.</p>
              </div>
              <label class="flex flex-col gap-1 text-[11px] text-white/50">
                Explanation
                <textarea
                  name="explanation"
                  data-review-explanation
                  required
                  rows="5"
                  maxlength="4000"
                  class="rounded-md border border-white/15 bg-white/5 px-3 py-2 text-sm text-white outline-none focus:border-brand-primary"
                ></textarea>
              </label>
              <p class="text-[11px] text-white/30">
                Only admins ever see reviews. You'll see the other stewards' reviews once you've submitted yours.
              </p>
              <div class="flex justify-end gap-2">
                <button type="button" data-close-review-dialog class="btn btn-neutral">Cancel</button>
                <button type="submit" class="btn btn-gold">Save Review</button>
              </div>
            </form>
          </dialog>
        )}
      </>
    )}
