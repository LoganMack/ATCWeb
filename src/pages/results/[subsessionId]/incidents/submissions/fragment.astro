---
export const prerender = false;
import LoadError from '../../../../../components/LoadError.astro';
import IncidentCommentDialog from '../../../../../components/IncidentCommentDialog.astro';
import { markUncacheable } from '../../../../../lib/security';
import { resolveSupabaseEnv } from '../../../../../lib/db/client';
import { formatDate } from '../../../../../lib/db/circuits';
import { getRoundBySubsessionId } from '../../../../../lib/results/rounds';
import type { RoundSummary } from '../../../../../lib/results/rows';
import { isRoundPosted } from '../../../../../lib/incidentReports';
import { getMyIncidents, type IncidentManagementRow } from '../../../../../lib/incidents';
import IncidentSubmissionsTables from '../../../../../components/IncidentSubmissionsTables.astro';
import {
  buildIncidentSubmissionsView,
  getIncidentSubmissions,
  getViewerCarNumber,
  type IncidentSubmissionDbRow,
} from '../../../../../lib/incidentSubmissions';

// The public Incident Submissions page (the shell incidents.astro loads it for non-admins while the round is
// unposted). Read-only: rows don't open, and incident_submissions() returns no report text or decisions.
// A driver named in a report comments through the profile's popup, which posts to their own profile.
const supabaseEnv = resolveSupabaseEnv(Astro.locals);
const session = Astro.locals.session;
const myDriverId = session?.profile?.driver_id ?? null;
const subsessionId = Number(Astro.params.subsessionId);

let round: RoundSummary | null = null;
let posted = false;
let submissions: IncidentSubmissionDbRow[] = [];
let loadError: string | null = null;
let mine: IncidentManagementRow[] | null = null;
let viewerCar: string | null = null;
if (Number.isFinite(subsessionId)) {
  try {
    [round, posted, submissions] = await Promise.all([
      getRoundBySubsessionId(supabaseEnv, subsessionId),
      isRoundPosted(supabaseEnv, subsessionId),
      getIncidentSubmissions(supabaseEnv, subsessionId),
    ]);
  } catch (err) {
    console.error('Failed to load incident submissions:', err);
    loadError = err instanceof Error ? err.message : String(err);
  }
  // Only for the comment buttons: a failure leaves the list without them.
  if (!loadError && !posted && session && myDriverId && submissions.length > 0) {
    const [mineResult, car] = await Promise.all([
      getMyIncidents(supabaseEnv, session.accessToken).catch((err) => {
        console.error('Failed to load the viewer’s incidents:', err instanceof Error ? err.message : 'unknown');
        return null;
      }),
      getViewerCarNumber(supabaseEnv, myDriverId),
    ]);
    mine = mineResult?.rows ?? null;
    viewerCar = car;
  }
}

if (!loadError && !round) {
  // The shell's loader follows X-Redirect-To (a plain redirect would be pasted into the container).
  return new Response(null, { status: 404, headers: { 'X-Redirect-To': '/results' } });
}

const sessions = buildIncidentSubmissionsView(submissions, mine, viewerCar);
const commentAction = myDriverId ? `/drivers/${encodeURIComponent(myDriverId)}` : null;
const showComments = commentAction !== null && sessions.some((s) => s.rows.some((r) => r.comment));

Astro.response.headers.set('Cache-Control', 'public, s-maxage=60, stale-while-revalidate=300');
if (loadError) markUncacheable(Astro);
---

{loadError && <LoadError />}

{round && (
  <>
    <span hidden data-page-title={`Incident Submissions: ${round.track_name}`}></span>
    <h1 class="reveal mt-3 font-display text-2xl sm:text-5xl" style="transition-delay: 40ms">
      Incident Submissions:{' '}
      <span class="mt-1 block font-body text-lg not-italic sm:mt-0 sm:inline sm:font-display sm:text-5xl sm:italic">
        {round.track_name}
      </span>
    </h1>
    <p class="reveal mt-3 text-white/60" style="transition-delay: 80ms">{formatDate(round.start_time)}</p>

    {posted ? (
      <p role="status" class="mt-8 text-white/60">
        The stewards have posted this round’s Incident Report. <a href={`/results/${subsessionId}/incidents`} class="underline hover:text-white">Open it</a>.
      </p>
    ) : (
      <div data-incident-management class="mt-6">
        <p class="text-sm text-white/60">
          The incidents reported for this round. The stewards’ decisions appear here once they post the Incident Report.
        </p>
        <p data-incident-status role="status" class="mt-2 text-sm text-white/70"></p>

        {sessions.length === 0 ? (
          <p class="mt-8 text-white/60">No incidents have been reported for this round.</p>
        ) : (
          <IncidentSubmissionsTables sessions={sessions} />
        )}
        {showComments && <p class="mt-4 text-xs text-white/40">ⓘ Comments go to the stewards only.</p>}
      </div>
    )}

    {showComments && commentAction && <IncidentCommentDialog action={commentAction} />}
  </>
)}
