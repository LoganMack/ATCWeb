---
export const prerender = false;

// v0.16: the Incident Report — every penalty/incident logged for one round,
// broken apart per race (same pattern as the results page's per-race
// tables), replacing both the old external "Incident Report URL" link and
// the old per-row expand-to-reveal panel on the results page. All penalty
// add/edit/remove lives here instead of on the results page
// (src/pages/results/[subsessionId].astro), which is read-only for
// penalties as of this version.
import Layout from '../../../layouts/Layout.astro';
import {
  resolveSupabaseEnv,
  getPenaltiesForSubsession,
  getPenaltyOffenses,
  createPenalty,
  updatePenalty,
  deletePenalty,
  formatDate,
  getDriverClasses,
  getDriverSeasonCarNumbersForSeason,
  uploadToStorage,
  type Penalty,
  type PenaltyOffense,
  type PenaltyInput,
} from '../../../lib/supabase';
import { getRoundBySubsessionId, getRoundResults, type RoundResults, type DriverBasic } from '../../../lib/results';
import {
  applyPenaltiesToRoundResults,
  effectiveTimePenaltySeconds,
  effectivePointsPenalty,
  effectivePenaltyPoints,
} from '../../../lib/penalties';
import { recomputeDriverSeasonPP, strOrNullField, numOrNullField, numOrZeroField } from '../../../lib/penaltyActions';
import { resolveDriverByCarNumberForSeason } from '../../../lib/raceResultsImport';
import { parseCsv } from '../../../lib/csv';
import { isAdminView } from '../../../lib/auth';
import { logActivity, actorNameFor } from '../../../lib/activityLog';

const supabaseEnv = resolveSupabaseEnv(Astro.locals);
// isAdminView (not a raw role check) so the footer's "View as Visitor"
// toggle actually hides this page's admin-only UI — and blocks the POST
// handlers below — while previewing.
const isAdmin = isAdminView(Astro.locals);
const subsessionId = Number(Astro.params.subsessionId);

/** Builds a round-wide driver lookup straight from getRoundResults() — shared by both the page render and the CSV importer below, which needs it independently since it runs during POST handling, before the page's own data-loading section. Deliberately excludes notInRoster rows (see results.ts's RaceResultRow.notInRoster) — their driver.id is a synthetic `unrostered:<custId>` string, not a real drivers.id, and penalties.driver_id is a NOT NULL uuid FK into drivers — offering one of these as a pickable "driver at fault" would fail at the database with an invalid-uuid error the moment anyone actually logged a penalty against them. Use the Drivers admin page's "Sync Results with Roster" button to give them a real roster entry first if they need a penalty logged. */
async function loadRoundDrivers(): Promise<Map<string, DriverBasic>> {
  const results = await getRoundResults(supabaseEnv, subsessionId);
  const out = new Map<string, DriverBasic>();
  for (const rows of results.overall.values()) {
    for (const row of rows) if (!row.notInRoster) out.set(row.driver.id, row.driver);
  }
  return out;
}

if (isAdmin && Astro.request.method === 'POST' && Number.isFinite(subsessionId)) {
  const form = await Astro.request.formData();
  const intent = String(form.get('intent') ?? '');
  const accessToken = Astro.locals.session!.accessToken;
  const actor = { id: Astro.locals.session!.user.id, name: actorNameFor(Astro.locals.session!) };
  // round (below) isn't loaded yet at this point — this POST-handling block
  // runs before that section — so fetch a fresh copy here for every
  // branch's activity_log entry label.
  const roundForLog = await getRoundBySubsessionId(supabaseEnv, subsessionId);
  const roundLabel = roundForLog ? `${roundForLog.track_name} (${formatDate(roundForLog.start_time)})` : `Round ${subsessionId}`;

  if (intent === 'add-incident' || intent === 'update-incident') {
    const raceNumber = Number(form.get('race_number'));
    // The Driver field's default option is a disabled blank placeholder
    // (value="") so a driver must always be actively chosen — "racing_incident"
    // is the sentinel for the "Racing Incident (no driver at fault)" choice,
    // stored as a real null per 0020_penalty_racing_incident.sql. An empty
    // string here shouldn't normally reach the server (the placeholder is
    // disabled + the field is `required`), but falls back to null (same as
    // Racing Incident) rather than erroring if it ever does.
    const driverIdRaw = String(form.get('driver_id') ?? '');
    const driverId = driverIdRaw && driverIdRaw !== 'racing_incident' ? driverIdRaw : null;
    // Offenses/warning describe a specific driver's fault — force them
    // empty/off server-side for a Racing Incident regardless of what the
    // form actually submitted (the dialog hides and clears both once
    // "Racing Incident" is picked, but this is the authoritative guard).
    const offenseIds = driverId ? form.getAll('offense_ids').map(String) : [];
    const involvedDriverIds = form.getAll('involved_driver_ids').map(String);

    const data: PenaltyInput = {
      subsession_id: subsessionId,
      race_number: raceNumber,
      driver_id: driverId,
      incident_number: strOrNullField(form, 'incident_number'),
      lap: numOrNullField(form, 'lap'),
      description: strOrNullField(form, 'description'),
      time_penalty_seconds: numOrNullField(form, 'time_penalty_seconds'),
      points_penalty: numOrZeroField(form, 'points_penalty'),
      penalty_points: numOrZeroField(form, 'penalty_points'),
      is_warning: driverId ? form.get('is_warning') === 'on' : false,
      is_appealed: form.get('is_appealed') === 'on',
      appeal_result: strOrNullField(form, 'appeal_result'),
      appeal_time_penalty_seconds: numOrNullField(form, 'appeal_time_penalty_seconds'),
      appeal_points_penalty: numOrZeroField(form, 'appeal_points_penalty'),
      appeal_penalty_points: numOrZeroField(form, 'appeal_penalty_points'),
    };

    try {
      let savedPenaltyId: string | null = null;
      if (intent === 'add-incident' && Number.isFinite(raceNumber)) {
        const created = await createPenalty(supabaseEnv, accessToken, data, offenseIds, involvedDriverIds);
        savedPenaltyId = created?.id ?? null;
      } else if (intent === 'update-incident') {
        const penaltyId = String(form.get('penalty_id') ?? '');
        if (penaltyId) {
          await updatePenalty(supabaseEnv, accessToken, penaltyId, data, offenseIds, involvedDriverIds);
          savedPenaltyId = penaltyId;
        }
      }
      if (driverId) await recomputeDriverSeasonPP(supabaseEnv, accessToken, driverId);
      await logActivity(supabaseEnv, accessToken, actor, {
        action: intent === 'add-incident' ? 'add' : 'edit',
        entity_type: 'incident',
        entity_label: `${roundLabel} — Race ${raceNumber}${data.incident_number ? ` #${data.incident_number}` : ''}`,
        entity_id: savedPenaltyId,
      });
    } catch (err) {
      console.error('Failed to save incident:', err);
    }
    return Astro.redirect(`${Astro.url.pathname}${Astro.url.search}`, 302);
  }

  if (intent === 'delete-incident') {
    const penaltyId = String(form.get('penalty_id') ?? '');
    const driverId = String(form.get('driver_id') ?? '');
    try {
      if (penaltyId) {
        await deletePenalty(supabaseEnv, accessToken, penaltyId);
        await logActivity(supabaseEnv, accessToken, actor, {
          action: 'delete',
          entity_type: 'incident',
          entity_label: roundLabel,
          entity_id: penaltyId,
        });
      }
      if (driverId) await recomputeDriverSeasonPP(supabaseEnv, accessToken, driverId);
    } catch (err) {
      console.error('Failed to delete incident:', err);
    }
    return Astro.redirect(`${Astro.url.pathname}${Astro.url.search}`, 302);
  }

  if (intent === 'import-csv') {
    let imported = 0;
    let skipped = 0;
    let uploadedFile: File | null = null;
    try {
      const file = form.get('csv_file');
      if (file instanceof File) {
        uploadedFile = file;
        const [importOffenses, importDriverById, importRound] = await Promise.all([
          getPenaltyOffenses(supabaseEnv),
          loadRoundDrivers(),
          getRoundBySubsessionId(supabaseEnv, subsessionId),
        ]);
        const importDrivers = [...importDriverById.values()];
        // Season-scoped car numbers (0044_driver_season_car_numbers.sql) —
        // see resolveDriverByCarNumberForSeason's own doc comment for why
        // matching by a driver's CURRENT car_number alone isn't reliable
        // for a past round.
        const seasonCarNumberRows = importRound?.season_id
          ? await getDriverSeasonCarNumbersForSeason(supabaseEnv, importRound.season_id)
          : [];
        const seasonCarNumbers = new Map(seasonCarNumberRows.map((r) => [`${r.driver_id}:${r.season_id}`, r.car_number]));
        const resolveDriver = (carNumber: number) =>
          Number.isFinite(carNumber) && importRound?.season_id
            ? resolveDriverByCarNumberForSeason(importDrivers, seasonCarNumbers, importRound.season_id, carNumber)
            : importDrivers.find((d) => d.car_number === carNumber);
        const text = await file.text();
        const rows = parseCsv(text);
        const header = (rows[0] ?? []).map((h) => h.trim().toLowerCase());
        const colIndex = (name: string) => header.indexOf(name);
        const get = (row: string[], name: string) => {
          const i = colIndex(name);
          return i >= 0 ? (row[i] ?? '').trim() : '';
        };
        const touchedDriverIds = new Set<string>();

        for (const row of rows.slice(1)) {
          if (row.every((c) => c.trim() === '')) continue;

          const raceNumber = Number(get(row, 'race_number'));
          const carNumber = Number(get(row, 'driver_car_number'));
          const driver = resolveDriver(carNumber);
          if (!Number.isFinite(raceNumber) || !driver) {
            skipped++;
            continue;
          }

          const offenseNames = get(row, 'offense_names').split(';').map((s) => s.trim()).filter(Boolean);
          const offenseIds = offenseNames
            .map((name) => importOffenses.find((o) => o.name.toLowerCase() === name.toLowerCase())?.id)
            .filter((id): id is string => Boolean(id));

          const involvedCarNumbers = get(row, 'involved_car_numbers')
            .split(';')
            .map((s) => Number(s.trim()))
            .filter((n) => Number.isFinite(n));
          const involvedDriverIds = involvedCarNumbers
            .map((n) => resolveDriver(n)?.id)
            .filter((id): id is string => Boolean(id));

          const isWarningRaw = get(row, 'is_warning').toLowerCase();
          const lapRaw = get(row, 'lap');
          const timeRaw = get(row, 'time_penalty_seconds');
          const pointsRaw = get(row, 'points_penalty');
          const ppRaw = get(row, 'penalty_points');

          const data: PenaltyInput = {
            subsession_id: subsessionId,
            race_number: raceNumber,
            driver_id: driver.id,
            incident_number: get(row, 'incident_number') || null,
            lap: lapRaw ? Number(lapRaw) : null,
            description: get(row, 'description') || null,
            time_penalty_seconds: timeRaw ? Number(timeRaw) : null,
            points_penalty: pointsRaw ? Number(pointsRaw) : 0,
            penalty_points: ppRaw ? Number(ppRaw) : 0,
            is_warning: isWarningRaw === 'true' || isWarningRaw === 'yes' || isWarningRaw === '1',
            is_appealed: false,
            appeal_result: null,
            appeal_time_penalty_seconds: null,
            appeal_points_penalty: 0,
            appeal_penalty_points: 0,
          };

          try {
            await createPenalty(supabaseEnv, accessToken, data, offenseIds, involvedDriverIds);
            touchedDriverIds.add(driver.id);
            imported++;
          } catch (err) {
            console.error('Failed to import an incident row:', err);
            skipped++;
          }
        }

        for (const driverId of touchedDriverIds) {
          await recomputeDriverSeasonPP(supabaseEnv, accessToken, driverId);
        }
      }
    } catch (err) {
      console.error('Failed to import CSV:', err);
    }
    if (uploadedFile) {
      // entity_type: 'incident' (not 'import') so this shows up under the
      // Activity Log's "Incident Reports" filter, matching this page's own
      // purpose — the download link still works regardless of entity_type,
      // since that's driven by file_url being set, not by category.
      let fileUrl: string | null = null;
      try {
        const ext = uploadedFile.name.split('.').pop() || 'csv';
        const path = `incidents-${subsessionId}-${Date.now()}.${ext}`;
        fileUrl = await uploadToStorage(supabaseEnv, accessToken, 'imports', path, uploadedFile);
      } catch (err) {
        console.error('Failed to store incident import spreadsheet for the activity log:', err);
      }
      await logActivity(supabaseEnv, accessToken, actor, {
        action: 'add',
        entity_type: 'incident',
        entity_label: `${roundLabel} — CSV import`,
        details: `${imported} imported, ${skipped} skipped`,
        file_url: fileUrl,
        file_name: uploadedFile.name,
      });
    }
    return Astro.redirect(`${Astro.url.pathname}?imported=${imported}&skipped=${skipped}`, 302);
  }
}

let round: Awaited<ReturnType<typeof getRoundBySubsessionId>> = null;
let originalResults: RoundResults = { byClass: new Map(), overall: new Map() };
let penalties: Penalty[] = [];
let offenses: PenaltyOffense[] = [];
let classes: Awaited<ReturnType<typeof getDriverClasses>> = [];
let loadError: string | null = null;

if (Number.isFinite(subsessionId)) {
  try {
    [round, originalResults, penalties, offenses, classes] = await Promise.all([
      getRoundBySubsessionId(supabaseEnv, subsessionId),
      getRoundResults(supabaseEnv, subsessionId),
      getPenaltiesForSubsession(supabaseEnv, subsessionId),
      getPenaltyOffenses(supabaseEnv),
      getDriverClasses(supabaseEnv),
    ]);
  } catch (err) {
    console.error('Failed to load incident report:', err);
    loadError = err instanceof Error ? err.message : String(err);
  }
}

if (!loadError && !round) {
  return Astro.redirect('/results', 302);
}

// The "before" snapshot is exactly what getRoundResults() returned (no
// penalties applied yet); the "after" snapshot runs it through the same
// engine the results page itself uses. Position/points lost or gained are
// measured between these two, per Logan: "Before vs. after this round's
// full recalculation" — not per individual penalty, since a driver's final
// position/points reflect every penalty logged against the whole race at
// once, not just one entry in isolation.
// Alpha never earns the top-3-in-class Class Points bonus (see README) —
// told to the recompute engine so a penalty-driven podium shuffle can't
// manufacture class points for an Alpha driver.
const classPointsEligibleByClassId = new Map(classes.map((c) => [c.id, c.name !== 'Alpha']));
const recomputedResults =
  penalties.length > 0
    ? applyPenaltiesToRoundResults(originalResults, penalties, round?.format ?? null, classPointsEligibleByClassId)
    : originalResults;

interface PosPoints {
  position: number | null;
  totalPoints: number;
}
function buildLookup(rr: RoundResults): Map<string, PosPoints> {
  const m = new Map<string, PosPoints>();
  for (const rows of rr.overall.values()) {
    for (const row of rows) m.set(`${row.raceNumber}:${row.driver.id}`, { position: row.position, totalPoints: row.totalPoints });
  }
  return m;
}
const originalByKey = buildLookup(originalResults);
const recomputedByKey = buildLookup(recomputedResults);

function deltaFor(p: Penalty): { positionDelta: number | null; pointsDelta: number | null } {
  const key = `${p.race_number}:${p.driver_id}`;
  const before = originalByKey.get(key);
  const after = recomputedByKey.get(key);
  const positionDelta = before?.position != null && after?.position != null ? before.position - after.position : null;
  const pointsDelta = before && after ? after.totalPoints - before.totalPoints : null;
  return { positionDelta, pointsDelta };
}

function formatDelta(n: number | null): string {
  if (n === null) return '—';
  if (n === 0) return '0';
  return `${n > 0 ? '+' : ''}${n}`;
}
function deltaClass(n: number | null): string {
  if (n === null || n === 0) return 'text-white/40';
  return n > 0 ? 'text-brand-blue' : 'text-brand-pink';
}

// Every driver who appeared anywhere in this round, sorted by car number —
// powers the Driver and Involved pickers in the add/edit dialog (an
// incident can only involve cars that were actually in this round). Unlike
// the old per-race dialog, the driver being penalized is no longer excluded
// from the "Involved" list — per Logan, involvement should be inclusive so
// the penalized driver's own car can be tagged alongside anyone else's.
// notInRoster rows are excluded — see loadRoundDrivers' own doc comment
// above on why their synthetic id can never be a valid penalties.driver_id.
const driverById = new Map<string, DriverBasic>();
for (const rows of originalResults.overall.values()) {
  for (const row of rows) if (!row.notInRoster) driverById.set(row.driver.id, row.driver);
}
const roundDrivers = [...driverById.values()].sort((a, b) => (a.car_number ?? Infinity) - (b.car_number ?? Infinity));
const raceNumbers = [...originalResults.overall.keys()].sort((a, b) => a - b);
const offenseNameById = new Map(offenses.map((o) => [o.id, o.name]));

/** "#04, #12" — car numbers only, sorted by car number, for every car tagged as involved. */
function involvedSummary(p: Penalty): string | null {
  if (p.involved_driver_ids.length === 0) return null;
  const sorted = [...p.involved_driver_ids].sort(
    (a, b) => (driverById.get(a)?.car_number ?? Infinity) - (driverById.get(b)?.car_number ?? Infinity)
  );
  return sorted.map((id) => (driverById.get(id)?.car_number != null ? `#${driverById.get(id)!.car_number}` : '?')).join(', ');
}

/** Numeric incident_number sorts numerically; a non-numeric or missing one sorts to the end (Infinity), then falls back to a string compare so two non-numeric incident numbers still sort predictably rather than by insertion order. */
function incidentNumberSortValue(p: Penalty): number {
  const n = p.incident_number ? Number(p.incident_number) : NaN;
  return Number.isFinite(n) ? n : Infinity;
}

const sortedPenalties = [...penalties].sort((a, b) => {
  if (a.race_number !== b.race_number) return a.race_number - b.race_number;
  const numA = incidentNumberSortValue(a);
  const numB = incidentNumberSortValue(b);
  if (numA !== numB) return numA - numB;
  const strCmp = (a.incident_number ?? '').localeCompare(b.incident_number ?? '');
  if (strCmp !== 0) return strCmp;
  return new Date(a.created_at).getTime() - new Date(b.created_at).getTime();
});

// Broken apart per race, same pattern as the results page's per-race
// tables — a race with no incidents logged just doesn't get a section.
const penaltiesByRace = new Map<number, Penalty[]>();
for (const p of sortedPenalties) {
  if (!penaltiesByRace.has(p.race_number)) penaltiesByRace.set(p.race_number, []);
  penaltiesByRace.get(p.race_number)!.push(p);
}
const raceNumbersWithIncidents = raceNumbers.filter((n) => penaltiesByRace.has(n));

/** Descriptions longer than this many characters are cut off with a trailing ellipsis behind a "Show more" toggle — a hard character limit rather than CSS truncation, so the cell can never stretch wider than this regardless of how long the underlying text is. */
const DESCRIPTION_TRUNCATE_LENGTH = 30;

const importedCount = Astro.url.searchParams.get('imported');
const skippedCount = Astro.url.searchParams.get('skipped');

Astro.response.headers.set('Cache-Control', 'public, s-maxage=60, stale-while-revalidate=300');
---

<Layout title={round ? `Incident Report — ${round.track_name}` : 'Incident Report'} description="Every incident and penalty logged for this round.">
  <section class="mx-auto max-w-6xl px-6 pb-24 pt-28 sm:pt-36">
    <a href={`/results/${subsessionId}`} class="text-sm text-white/50 hover:text-white">&larr; Back to Results</a>

    {loadError && (
      <p class="mt-4 rounded-lg border border-brand-pink/30 bg-brand-pink/10 p-4 text-sm text-white/80">
        Couldn't load this round's incident report right now.
        <br /><span class="mt-1 block text-white/50">{loadError}</span>
      </p>
    )}

    {round && (
      <>
        <h1 class="reveal mt-3 font-display text-5xl" style="transition-delay: 40ms">
          Incident Report — {round.track_name}
        </h1>
        <p class="reveal mt-3 text-white/60" style="transition-delay: 80ms">
          {formatDate(round.start_time)}
        </p>

        {importedCount !== null && (
          <p class="mt-4 rounded-lg border border-brand-primary/30 bg-brand-primary/10 p-3 text-sm text-white/80">
            Imported {importedCount} incident{importedCount === '1' ? '' : 's'}.
            {Number(skippedCount) > 0 && ` ${skippedCount} row${skippedCount === '1' ? '' : 's'} skipped (unrecognized race or driver car number).`}
          </p>
        )}

        {isAdmin && (
          <div class="mt-6 flex flex-wrap items-center gap-2">
            <button
              type="button"
              data-open-incident-dialog
              class="rounded-lg bg-brand-primary px-4 py-2 text-sm font-semibold transition hover:brightness-110"
            >
              + Add Incident
            </button>

            <details class="relative">
              <summary class="cursor-pointer list-none rounded-lg bg-white/5 px-4 py-2 text-sm font-semibold text-white/60 ring-1 ring-white/10 transition hover:bg-white/10">
                Import from CSV
              </summary>
              <div class="absolute left-0 z-10 mt-2 flex w-80 flex-col gap-3 rounded-lg border border-white/10 bg-brand-ink p-4 text-xs text-white/60 shadow-xl">
                <a
                  href="/incident-report-template.csv"
                  download
                  class="self-start rounded-lg bg-white/10 px-3 py-1.5 font-semibold text-white/70 transition hover:bg-white/20"
                >
                  Download CSV template
                </a>
                <form method="POST" enctype="multipart/form-data" data-astro-reload class="flex flex-col gap-2">
                  <input type="hidden" name="intent" value="import-csv" />
                  <input
                    type="file"
                    name="csv_file"
                    accept=".csv"
                    required
                    class="text-xs text-white/60 file:mr-2 file:rounded file:border-0 file:bg-brand-primary file:px-3 file:py-1.5 file:text-xs file:font-semibold file:text-white file:transition hover:file:brightness-110"
                  />
                  <button type="submit" class="self-start rounded-lg bg-brand-primary px-3 py-1.5 text-xs font-semibold transition hover:brightness-110">
                    Upload
                  </button>
                </form>
                <p class="text-white/30">
                  Rows are matched by race number and driver car number — anything unrecognized is skipped rather than
                  failing the whole import.
                </p>
              </div>
            </details>
          </div>
        )}

        {sortedPenalties.length === 0 && <p class="mt-10 text-white/60">No incidents logged for this round.</p>}

        {raceNumbersWithIncidents.map((raceNumber) => (
          <div class="mt-10">
            <h3 class="text-xs font-semibold uppercase tracking-widest text-white/40">Race {raceNumber}</h3>
            <div class="mt-2 overflow-x-auto rounded-xl border border-white/10">
              <table class="w-full border-collapse">
                <thead>
                  <tr class="border-b border-white/10 text-left text-xs uppercase tracking-wide text-white/40">
                    <th class="py-3 pl-4 pr-3 font-medium">#</th>
                    <th class="py-3 pr-3 text-center font-medium">Lap</th>
                    <th class="py-3 pr-3 font-medium">Driver</th>
                    <th class="py-3 pr-3 font-medium">Involved</th>
                    <th class="py-3 pr-3 font-medium">Description</th>
                    <th class="py-3 pr-3 font-medium">Offenses</th>
                    <th class="py-3 pr-3 text-center font-medium">PP</th>
                    <th class="py-3 pr-3 text-center font-medium">Time</th>
                    <th class="py-3 pr-3 text-center font-medium">Pts</th>
                    <th class="py-3 pr-3 text-center font-medium">Pos &Delta;</th>
                    <th class="py-3 pr-4 text-center font-medium">Pts &Delta;</th>
                  </tr>
                </thead>
                <tbody>
                  {penaltiesByRace.get(raceNumber)!.map((p) => {
                    const driver = p.driver_id ? driverById.get(p.driver_id) : undefined;
                    const { positionDelta, pointsDelta } = deltaFor(p);
                    const time = effectiveTimePenaltySeconds(p);
                    const points = effectivePointsPenalty(p);
                    const pp = effectivePenaltyPoints(p);
                    const isLongDescription = (p.description?.length ?? 0) > DESCRIPTION_TRUNCATE_LENGTH;
                    const truncatedDescription = isLongDescription
                      ? `${p.description!.slice(0, DESCRIPTION_TRUNCATE_LENGTH).trimEnd()}…`
                      : (p.description ?? '');
                    return (
                      <>
                        <tr class={isAdmin ? 'text-sm' : 'border-b border-white/5 text-sm'}>
                          <td class="py-2.5 pl-4 pr-3 text-white/60">{p.incident_number ?? '—'}</td>
                          <td class="py-2.5 pr-3 text-center text-white/60">{p.lap ?? '—'}</td>
                          <td class="py-2.5 pr-3 font-semibold">
                            <div title={p.driver_id === null ? 'Racing Incident — no driver at fault' : undefined}>
                              {p.driver_id === null ? 'RI' : (driver?.car_number != null ? `#${driver.car_number}` : '—')}
                            </div>
                            {p.is_appealed && (
                              <button
                                type="button"
                                data-appeal-toggle
                                class="text-[10px] font-semibold uppercase tracking-wide text-brand-pink hover:underline"
                              >
                                Appealed
                              </button>
                            )}
                            {p.is_appealed && (
                              <div
                                data-appeal-detail
                                class="mt-1 hidden max-w-[12rem] rounded-md border border-brand-pink/30 bg-brand-pink/10 p-2 text-[11px] font-normal text-brand-pink/90"
                              >
                                {p.appeal_result || 'No appeal notes recorded.'}
                              </div>
                            )}
                          </td>
                          <td class="py-2.5 pr-3 text-white/50">{involvedSummary(p) ?? '—'}</td>
                          <td class="max-w-xs py-2.5 pr-3 text-white/50">
                            {p.description ? (
                              <div class="flex flex-col items-start gap-0.5">
                                <div
                                  data-desc-text
                                  data-full-text={p.description}
                                  data-truncated-text={truncatedDescription}
                                  data-expanded="false"
                                >
                                  {isLongDescription ? truncatedDescription : p.description}
                                </div>
                                {isLongDescription && (
                                  <button type="button" data-desc-toggle class="text-[10px] font-semibold text-white/40 hover:text-white">
                                    Show more
                                  </button>
                                )}
                              </div>
                            ) : (
                              '—'
                            )}
                          </td>
                          <td class="py-2.5 pr-3 text-white/50">
                            {p.offense_ids.length > 0 ? (
                              <div class="flex flex-col gap-0.5">
                                {p.offense_ids.map((id) => <div>{offenseNameById.get(id) ?? '?'}</div>)}
                              </div>
                            ) : (
                              '—'
                            )}
                          </td>
                          <td class="py-2.5 pr-3 text-center text-white/60">
                            <div>{pp || '—'}</div>
                            {p.is_warning && (
                              <div class="text-[9px] font-semibold uppercase tracking-wide text-brand-gold">Warning</div>
                            )}
                          </td>
                          <td class="py-2.5 pr-3 text-center text-white/60">{time ? `+${time}s` : '—'}</td>
                          <td class="py-2.5 pr-3 text-center text-white/60">{points ? points : '—'}</td>
                          <td class={`py-2.5 pr-3 text-center font-semibold ${deltaClass(positionDelta)}`}>{formatDelta(positionDelta)}</td>
                          <td class={`py-2.5 pr-4 text-center font-semibold ${deltaClass(pointsDelta)}`}>{formatDelta(pointsDelta)}</td>
                        </tr>
                        {isAdmin && (
                          <tr class="border-b border-white/5 text-sm">
                            <td colspan={11} class="py-1.5 pl-4 pr-4">
                              <div class="flex justify-start gap-3">
                                <button
                                  type="button"
                                  data-edit-incident
                                  data-incident={JSON.stringify({
                                    id: p.id,
                                    race_number: p.race_number,
                                    driver_id: p.driver_id,
                                    incident_number: p.incident_number,
                                    lap: p.lap,
                                    description: p.description,
                                    time_penalty_seconds: p.time_penalty_seconds,
                                    points_penalty: p.points_penalty,
                                    penalty_points: p.penalty_points,
                                    is_warning: p.is_warning,
                                    offense_ids: p.offense_ids,
                                    involved_driver_ids: p.involved_driver_ids,
                                    is_appealed: p.is_appealed,
                                    appeal_result: p.appeal_result,
                                    appeal_time_penalty_seconds: p.appeal_time_penalty_seconds,
                                    appeal_points_penalty: p.appeal_points_penalty,
                                    appeal_penalty_points: p.appeal_penalty_points,
                                  })}
                                  class="text-xs font-semibold text-white/40 hover:text-white"
                                >
                                  Edit
                                </button>
                                <form method="POST" data-astro-reload class="inline">
                                  <input type="hidden" name="intent" value="delete-incident" />
                                  <input type="hidden" name="penalty_id" value={p.id} />
                                  <input type="hidden" name="driver_id" value={p.driver_id ?? ''} />
                                  <button type="submit" class="text-xs font-semibold text-white/40 hover:text-brand-pink">
                                    Remove
                                  </button>
                                </form>
                              </div>
                            </td>
                          </tr>
                        )}
                      </>
                    );
                  })}
                </tbody>
              </table>
            </div>
          </div>
        ))}

        {isAdmin && (
          <dialog
            id="incident-dialog"
            data-incident-dialog
            class="w-full max-w-lg rounded-xl border border-white/10 bg-brand-ink p-0 text-white backdrop:bg-black/60"
          >
            <form method="POST" data-astro-reload class="flex max-h-[85vh] flex-col gap-3 overflow-y-auto p-5">
              <input type="hidden" name="intent" data-incident-intent-field value="add-incident" />
              <input type="hidden" name="penalty_id" data-incident-id-field value="" />

              <div class="flex items-center justify-between">
                <h4 class="font-display text-xl" data-incident-heading>Add Incident</h4>
                <button type="button" data-close-incident-dialog class="text-white/40 hover:text-white">✕</button>
              </div>

              <div class="grid grid-cols-2 gap-3">
                <label class="flex flex-col gap-1 text-[11px] text-white/50">
                  Race
                  <select
                    name="race_number"
                    data-incident-race-field
                    required={raceNumbers.length > 1}
                    class="rounded-md border border-white/15 bg-white/5 px-2 py-1.5 text-sm text-white outline-none focus:border-brand-primary"
                  >
                    {raceNumbers.length > 1 && (
                      <option value="" selected disabled hidden class="bg-brand-ink text-white">Select race…</option>
                    )}
                    {raceNumbers.map((n) => <option value={n} class="bg-brand-ink text-white">Race {n}</option>)}
                  </select>
                </label>
                <label class="flex flex-col gap-1 text-[11px] text-white/50">
                  Driver
                  <select
                    name="driver_id"
                    data-incident-driver-field
                    required
                    class="rounded-md border border-white/15 bg-white/5 px-2 py-1.5 text-sm text-white outline-none focus:border-brand-primary"
                  >
                    <option value="" selected disabled hidden class="bg-brand-ink text-white">Select driver…</option>
                    <option value="racing_incident" class="bg-brand-ink text-white">Racing Incident (no driver at fault)</option>
                    {roundDrivers.map((d) => (
                      <option value={d.id} class="bg-brand-ink text-white">
                        {d.car_number !== null ? `#${d.car_number} — ` : ''}
                        {d.name}
                      </option>
                    ))}
                  </select>
                </label>
              </div>

              <div class="grid grid-cols-2 gap-3">
                <label class="flex flex-col gap-1 text-[11px] text-white/50">
                  Incident #
                  <input type="text" name="incident_number" data-incident-number-field required class="rounded-md border border-white/15 bg-white/5 px-2 py-1.5 text-sm text-white outline-none focus:border-brand-primary" />
                </label>
                <label class="flex flex-col gap-1 text-[11px] text-white/50">
                  Lap
                  <input type="number" name="lap" data-incident-lap-field required class="rounded-md border border-white/15 bg-white/5 px-2 py-1.5 text-sm text-white outline-none focus:border-brand-primary" />
                </label>
              </div>

              <p data-incident-missing-fields class="text-[11px] font-semibold text-brand-gold"></p>

              <div data-incident-rest class="hidden flex-col gap-3">
                <label class="flex flex-col gap-1 text-[11px] text-white/50">
                  Description
                  <textarea name="description" rows="2" class="rounded-md border border-white/15 bg-white/5 px-2 py-1.5 text-sm text-white outline-none focus:border-brand-primary"></textarea>
                </label>

                <label data-fault-only class="flex flex-col gap-1 text-[11px] text-white/50">
                  Penalty points (PP)
                  <input type="number" name="penalty_points" placeholder="0" class="rounded-md border border-white/15 bg-white/5 px-2 py-1.5 text-sm text-white outline-none focus:border-brand-primary" />
                </label>

                <div data-fault-only class="grid grid-cols-2 gap-3">
                  <label class="flex flex-col gap-1 text-[11px] text-white/50">
                    Time penalty (seconds)
                    <input type="number" step="0.001" name="time_penalty_seconds" class="rounded-md border border-white/15 bg-white/5 px-2 py-1.5 text-sm text-white outline-none focus:border-brand-primary" />
                  </label>
                  <label class="flex flex-col gap-1 text-[11px] text-white/50">
                    Points penalty
                    <input type="number" name="points_penalty" placeholder="0" class="rounded-md border border-white/15 bg-white/5 px-2 py-1.5 text-sm text-white outline-none focus:border-brand-primary" />
                  </label>
                </div>

                <label data-fault-only class="flex items-center gap-2 text-xs text-white/70">
                  <input type="checkbox" name="is_warning" />
                  This is a warning (rulebook: 2 warnings escalates to +1 PP)
                </label>

                <label class="flex items-center gap-2 text-xs text-white/70">
                  <input type="checkbox" name="is_appealed" data-appeal-checkbox />
                  This penalty was appealed
                </label>

                <div data-appeal-fields class="hidden flex-col gap-3 rounded-md border border-white/10 bg-white/5 p-3">
                  <label class="flex flex-col gap-1 text-[11px] text-white/50">
                    Appeal result
                    <textarea
                      name="appeal_result"
                      rows="2"
                      placeholder="e.g. Upheld — reduced to 5s"
                      class="rounded-md border border-white/15 bg-white/5 px-2 py-1.5 text-sm text-white outline-none focus:border-brand-primary"
                    ></textarea>
                  </label>
                  <div class="grid grid-cols-2 gap-3">
                    <label class="flex flex-col gap-1 text-[11px] text-white/50">
                      New time penalty (seconds)
                      <input type="number" step="0.001" name="appeal_time_penalty_seconds" class="rounded-md border border-white/15 bg-white/5 px-2 py-1.5 text-sm text-white outline-none focus:border-brand-primary" />
                    </label>
                    <label class="flex flex-col gap-1 text-[11px] text-white/50">
                      New points penalty
                      <input type="number" name="appeal_points_penalty" placeholder="0" class="rounded-md border border-white/15 bg-white/5 px-2 py-1.5 text-sm text-white outline-none focus:border-brand-primary" />
                    </label>
                  </div>
                  <label class="flex flex-col gap-1 text-[11px] text-white/50">
                    New penalty points (PP)
                    <input type="number" name="appeal_penalty_points" placeholder="0" class="rounded-md border border-white/15 bg-white/5 px-2 py-1.5 text-sm text-white outline-none focus:border-brand-primary" />
                  </label>
                  <p class="text-[11px] text-white/30">
                    These replace the original time/points/PP everywhere (this race's results, season standings, season
                    PP) once appealed — the original values above stay on record but stop being applied.
                  </p>
                </div>

                <fieldset data-fault-only class="flex flex-col gap-1 text-[11px] text-white/50">
                  <legend class="mb-1">Offenses (rulebook section 5)</legend>
                  <div class="flex max-h-32 flex-col gap-1 overflow-y-auto rounded-md border border-white/15 bg-white/5 p-2">
                    {offenses.length === 0 && <span class="text-white/30">No offenses configured — add some at /admin/site-properties.</span>}
                    {offenses.map((o) => (
                      <label class="flex items-center gap-2 text-xs text-white/70">
                        <input type="checkbox" name="offense_ids" value={o.id} />
                        {o.name} {o.reference_points && <span class="text-white/30">({o.reference_points})</span>}
                      </label>
                    ))}
                  </div>
                </fieldset>

                <fieldset class="flex flex-col gap-1 text-[11px] text-white/50">
                  <legend class="mb-1">Involved</legend>
                  <div class="flex max-h-32 flex-col gap-1 overflow-y-auto rounded-md border border-white/15 bg-white/5 p-2">
                    {roundDrivers.length === 0 && <span class="text-white/30">No drivers in this round.</span>}
                    {roundDrivers.map((d) => (
                      <label class="flex items-center gap-2 text-xs text-white/70">
                        <input type="checkbox" name="involved_driver_ids" value={d.id} />
                        {d.car_number !== null && <span class="text-white/30">#{d.car_number}</span>} {d.name}
                      </label>
                    ))}
                  </div>
                </fieldset>
              </div>

              <button
                type="submit"
                data-incident-save-button
                class="mt-1 rounded-lg bg-brand-primary px-4 py-2 text-sm font-semibold transition hover:brightness-110 disabled:cursor-not-allowed disabled:opacity-40 disabled:hover:brightness-100"
              >
                Save Incident
              </button>
            </form>
          </dialog>
        )}
      </>
    )}
  </section>
</Layout>

<script>
  // Wires up:
  //   - The single shared add/edit <dialog> for this page ([data-open-
  //     incident-dialog] / [data-edit-incident] / [data-appeal-checkbox] /
  //     [data-close-incident-dialog]) — same pattern as before, just no
  //     longer scoped to one race's row since this dialog picks its own
  //     race/driver.
  //   - [data-fault-only] — the offenses fieldset and warning checkbox,
  //     hidden (and cleared) whenever the Driver field's "Racing Incident"
  //     option is selected (empty value — see 0020_penalty_racing_incident.sql).
  //   - [data-desc-toggle] — expands/collapses a long description.
  //   - [data-appeal-toggle] — reveals/hides that incident's appeal notes.
  function initIncidentPage() {
    document.querySelectorAll<HTMLButtonElement>('[data-desc-toggle]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const text = btn.previousElementSibling as HTMLElement | null;
        if (!text) return;
        const expanded = text.dataset.expanded === 'true';
        if (expanded) {
          text.textContent = text.dataset.truncatedText ?? '';
          text.dataset.expanded = 'false';
          btn.textContent = 'Show more';
        } else {
          text.textContent = text.dataset.fullText ?? '';
          text.dataset.expanded = 'true';
          btn.textContent = 'Show less';
        }
      });
    });

    document.querySelectorAll<HTMLButtonElement>('[data-appeal-toggle]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const detail = btn.nextElementSibling as HTMLElement | null;
        detail?.classList.toggle('hidden');
      });
    });

    const dialog = document.querySelector<HTMLDialogElement>('[data-incident-dialog]');
    if (!dialog) return;
    const form = dialog.querySelector('form')!;
    const intentField = dialog.querySelector<HTMLInputElement>('[data-incident-intent-field]')!;
    const idField = dialog.querySelector<HTMLInputElement>('[data-incident-id-field]')!;
    const raceField = dialog.querySelector<HTMLSelectElement>('[data-incident-race-field]')!;
    const driverField = dialog.querySelector<HTMLSelectElement>('[data-incident-driver-field]')!;
    const heading = dialog.querySelector('[data-incident-heading]')!;
    const appealCheckbox = dialog.querySelector<HTMLInputElement>('[data-appeal-checkbox]')!;
    const appealFields = dialog.querySelector<HTMLElement>('[data-appeal-fields]')!;
    // Everything that only makes sense when a specific driver is actually
    // at fault — offenses (rulebook section 5), the warning checkbox, and
    // the penalty inputs (PP, time penalty, points penalty) — hidden once
    // "Racing Incident" (the driver select's "racing_incident" sentinel
    // option) is picked. See 0020_penalty_racing_incident.sql.
    const faultOnlyFields = dialog.querySelectorAll<HTMLElement>('[data-fault-only]');
    // The blank placeholder option ("Select driver…") is disabled/unselectable
    // once the user has interacted with the field — only used as the default
    // so nothing is pre-selected. Treat it the same as "no driver chosen yet"
    // for fault-field visibility, same as "racing_incident" itself.
    const isDriverChosen = (value: string) => value !== '' && value !== 'racing_incident';

    // The four "core" fields that must be filled in before the rest of the
    // form is even shown — Race is only required when the round has more
    // than one race (server only renders `required` on the select in that
    // case, so `raceField.required` reflects that at runtime).
    const numberField = dialog.querySelector<HTMLInputElement>('[data-incident-number-field]')!;
    const lapField = dialog.querySelector<HTMLInputElement>('[data-incident-lap-field]')!;
    const missingFieldsEl = dialog.querySelector<HTMLElement>('[data-incident-missing-fields]')!;
    const restEl = dialog.querySelector<HTMLElement>('[data-incident-rest]')!;
    const saveButton = dialog.querySelector<HTMLButtonElement>('[data-incident-save-button]')!;

    function setAppealFieldsVisible(visible: boolean) {
      appealFields.classList.toggle('hidden', !visible);
      appealFields.classList.toggle('flex', visible);
    }

    function setFaultFieldsVisible(visible: boolean) {
      faultOnlyFields.forEach((el) => el.classList.toggle('hidden', !visible));
      if (!visible) {
        // Clear rather than just hide, so switching to Racing Incident
        // never leaves a hidden offense/warning/penalty value silently in
        // the submitted form data.
        dialog.querySelectorAll<HTMLInputElement>('[name="offense_ids"]').forEach((cb) => (cb.checked = false));
        const warningBox = dialog.querySelector<HTMLInputElement>('[name="is_warning"]');
        if (warningBox) warningBox.checked = false;
        const clear = (name: string) => {
          const el = dialog.querySelector<HTMLInputElement>(`[name="${name}"]`);
          if (el) el.value = '';
        };
        clear('penalty_points');
        clear('time_penalty_seconds');
        clear('points_penalty');
      }
    }

    // Race, Driver, Incident #, and Lap are the "core" fields — until all
    // of them are filled in, the rest of the form stays hidden and Save
    // stays disabled, with a message telling the user what's still missing.
    function updateFormValidity() {
      const missing: string[] = [];
      if (raceField.required && !raceField.value) missing.push('Race');
      if (!isDriverChosen(driverField.value)) missing.push('Driver');
      if (!numberField.value.trim()) missing.push('Incident #');
      if (!lapField.value.trim()) missing.push('Lap');

      const isValid = missing.length === 0;
      restEl.classList.toggle('hidden', !isValid);
      restEl.classList.toggle('flex', isValid);
      saveButton.disabled = !isValid;
      missingFieldsEl.textContent = isValid ? '' : `Still needed: ${missing.join(', ')}`;
    }

    appealCheckbox.addEventListener('change', () => setAppealFieldsVisible(appealCheckbox.checked));
    driverField.addEventListener('change', () => setFaultFieldsVisible(isDriverChosen(driverField.value)));
    raceField.addEventListener('change', updateFormValidity);
    driverField.addEventListener('change', updateFormValidity);
    numberField.addEventListener('input', updateFormValidity);
    lapField.addEventListener('input', updateFormValidity);

    document.querySelectorAll<HTMLButtonElement>('[data-open-incident-dialog]').forEach((btn) => {
      btn.addEventListener('click', () => {
        form.reset();
        intentField.value = 'add-incident';
        idField.value = '';
        heading.textContent = 'Add Incident';
        setAppealFieldsVisible(false);
        // form.reset() restores the blank placeholder (its `selected`
        // attribute) — Driver starts unselected on every new Add, per Logan.
        setFaultFieldsVisible(isDriverChosen(driverField.value));
        // Nothing is filled in yet on a fresh Add — form starts collapsed
        // with Save disabled until Race/Driver/Incident #/Lap are set.
        updateFormValidity();
        dialog.showModal();
      });
    });

    document.querySelectorAll<HTMLButtonElement>('[data-edit-incident]').forEach((btn) => {
      btn.addEventListener('click', () => {
        if (!btn.dataset.incident) return;
        const p = JSON.parse(btn.dataset.incident);
        intentField.value = 'update-incident';
        idField.value = p.id;
        heading.textContent = 'Edit Incident';
        raceField.value = String(p.race_number);
        driverField.value = p.driver_id ?? 'racing_incident';

        const set = (name: string, value: string) => {
          const el = dialog.querySelector<HTMLInputElement | HTMLTextAreaElement>(`[name="${name}"]`);
          if (el) el.value = value;
        };
        set('incident_number', p.incident_number ?? '');
        set('lap', p.lap ?? '');
        set('description', p.description ?? '');
        set('time_penalty_seconds', p.time_penalty_seconds ?? '');
        set('points_penalty', p.points_penalty ?? '');
        set('penalty_points', p.penalty_points ?? '');
        set('appeal_result', p.appeal_result ?? '');
        set('appeal_time_penalty_seconds', p.appeal_time_penalty_seconds ?? '');
        set('appeal_points_penalty', p.appeal_points_penalty ?? '');
        set('appeal_penalty_points', p.appeal_penalty_points ?? '');

        const warningBox = dialog.querySelector<HTMLInputElement>('[name="is_warning"]');
        if (warningBox) warningBox.checked = Boolean(p.is_warning);

        appealCheckbox.checked = Boolean(p.is_appealed);
        setAppealFieldsVisible(Boolean(p.is_appealed));

        dialog.querySelectorAll<HTMLInputElement>('[name="offense_ids"]').forEach((cb) => {
          cb.checked = (p.offense_ids ?? []).includes(cb.value);
        });
        dialog.querySelectorAll<HTMLInputElement>('[name="involved_driver_ids"]').forEach((cb) => {
          cb.checked = (p.involved_driver_ids ?? []).includes(cb.value);
        });

        setFaultFieldsVisible(isDriverChosen(driverField.value));
        // Existing incidents already have their core fields filled in, so
        // this should immediately expand the rest of the form and enable Save.
        updateFormValidity();

        dialog.showModal();
      });
    });

    dialog.querySelectorAll<HTMLButtonElement>('[data-close-incident-dialog]').forEach((btn) => {
      btn.addEventListener('click', () => dialog.close());
    });
  }

  document.addEventListener('astro:page-load', initIncidentPage);
</script>
