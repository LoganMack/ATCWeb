---
export const prerender = false;

import Layout from '../../../layouts/Layout.astro';
import { resolveSupabaseEnv, getPenaltiesForSubsession } from '../../../lib/supabase';
import { getRoundBySubsessionId } from '../../../lib/results';
import { isRoundPosted } from '../../../lib/incidentReports';

// Shell-then-skeleton split (same pattern as results.astro / standings.astro):
// this file paints the frame, the back link and a loading skeleton right away;
// everything that needs the round's data — penalties, appeals, reports, the
// admin and appeal POST handling — lives in incidents/fragment.astro and is
// fetched client-side once this shell has painted. The fragment's forms POST
// straight to the fragment (which owns that handling) and redirect back here.
// The page's interaction script below stays here because a <script> inside
// fetched HTML never executes; it bails out until the fragment's elements exist
// and binds when the loader's astro:page-load re-dispatch fires.
const subsessionId = Astro.params.subsessionId;

// Just enough for the <title> and the link-preview (Discord/Slack) embed —
// crawlers don't run the fragment's JS, so the track name and live incident
// count have to be in the shell's own HTML. The count is only offered once the
// report is posted, so an embed never reveals an unposted report.
let trackName: string | null = null;
let incidentCount: number | null = null;
if (Number.isFinite(Number(subsessionId))) {
  const env = resolveSupabaseEnv(Astro.locals);
  try {
    const [round, posted, penalties] = await Promise.all([
      getRoundBySubsessionId(env, Number(subsessionId)),
      isRoundPosted(env, Number(subsessionId)),
      getPenaltiesForSubsession(env, Number(subsessionId)),
    ]);
    trackName = round?.track_name ?? null;
    if (posted) incidentCount = penalties.length;
  } catch (err) {
    console.error('Failed to look up round for page title:', err);
  }
}
const description =
  incidentCount !== null
    ? `${incidentCount} incident${incidentCount === 1 ? '' : 's'} reported.`
    : 'Every incident and penalty logged for this round.';
const seasonParam = Astro.url.searchParams.get('season');
const backToRoundHref = `/results/${subsessionId}${seasonParam ? `?season=${encodeURIComponent(seasonParam)}` : ''}`;

Astro.response.headers.set('Cache-Control', 'public, s-maxage=60, stale-while-revalidate=300');
---

<Layout title={trackName ? `Incident Report: ${trackName}` : 'Incident Report'} description={description}>
  <section class="mx-auto max-w-6xl px-6 pb-24 pt-8">
    <a href={backToRoundHref} class="text-sm text-white/50 hover:text-white">&larr; Back to Results</a>

    <div data-incident-results data-fragment-url={`/results/${subsessionId}/incidents/fragment${Astro.url.search}`}>
      <div aria-live="polite" aria-busy="true">
        <span class="sr-only">Loading incident report…</span>
        <div class="mt-3 h-12 w-96 max-w-full animate-pulse rounded-md bg-white/[0.03]"></div>
        <div class="mt-3 h-5 w-40 animate-pulse rounded bg-white/[0.03]"></div>
        <div class="mt-8 flex flex-col gap-4">
          <div class="h-9 w-48 animate-pulse rounded-md bg-white/[0.03]"></div>
          <div class="h-72 animate-pulse rounded-xl border border-white/10 bg-white/[0.02]"></div>
        </div>
      </div>
    </div>
  </section>
</Layout>

<script>
  // Wires up:
  //   - The single shared add/edit <dialog> for this page ([data-open-
  //     incident-dialog] / [data-edit-incident] / [data-appeal-checkbox] /
  //     [data-close-incident-dialog]) — same pattern as before, just no
  //     longer scoped to one race's row since this dialog picks its own
  //     session/driver.
  //   - Cars at fault ([data-incident-faults], src/scripts/faultCards.ts) —
  //     tick every car at fault and each gets its own card (PP/Warning, time
  //     penalty, points penalty, offenses); saving creates one penalty row
  //     per car. Racing Incident (0020_penalty_racing_incident.sql) has no
  //     card — there's no one to penalize. Editing is one row, so one car.
  //     Penalties are available for every session type: a qualifying/practice
  //     incident's penalty always applies to Race 1 (see scoringRaceNumber in
  //     src/lib/penalties.ts).
  //   - Ticking a car at fault also ticks it in the Involved list (a driver
  //     at fault is, at minimum, involved in their own incident) — see
  //     syncInvolvedWithFaults below. Only ever unticks a box IT ticked;
  //     anything the admin ticked by hand is left alone.
  import { initFaultPicker, setCardField } from '../../../scripts/faultCards';

  function initIncidentPage() {
    // "Incident Details" popup for [data-incident-row] — opened by clicking
    // (or pressing Enter/Space on) any incident row, on every screen size.
    // Placed ahead of the `if (!dialog) return` below so it still wires up
    // for non-admin viewers, who never get the add/edit <dialog> at all.
    const mobileDialog = document.querySelector<HTMLDialogElement>('[data-mobile-incident-dialog]');
    if (mobileDialog) {
      const setField = (selector: string, text: string) => {
        const el = mobileDialog.querySelector<HTMLElement>(selector);
        if (el) el.textContent = text;
      };
      const setRowVisible = (selector: string, visible: boolean) => {
        mobileDialog.querySelector<HTMLElement>(selector)?.classList.toggle('hidden', !visible);
      };

      // Submit Appeal: live window check (the page may be cached at the edge)
      // plus the appeal form popup itself.
      const appealBtn = mobileDialog.querySelector<HTMLButtonElement>('[data-open-appeal-dialog]');
      const appealDialog = document.querySelector<HTMLDialogElement>('[data-appeal-dialog]');
      let currentPenaltyId = '';
      let currentIncidentLabel = '';
      const refreshAppealButton = () => {
        if (!appealBtn) return;
        const closesAt = appealBtn.dataset.appealClosesAt ? new Date(appealBtn.dataset.appealClosesAt).getTime() : NaN;
        const open = appealBtn.dataset.appealOpen === 'true' && Number.isFinite(closesAt) && Date.now() < closesAt;
        appealBtn.disabled = !open;
        appealBtn.title = open ? 'Appeal this incident.' : 'The appeal window for this incident has closed.';
      };
      if (appealBtn && appealDialog) {
        const appealForm = appealDialog.querySelector<HTMLFormElement>('[data-appeal-form]')!;
        const fileInput = appealDialog.querySelector<HTMLInputElement>('[data-appeal-files]')!;
        const errorEl = appealDialog.querySelector<HTMLElement>('[data-appeal-error]')!;
        const showError = (msg: string) => {
          errorEl.textContent = msg;
          errorEl.classList.toggle('hidden', msg === '');
        };
        appealBtn.addEventListener('click', () => {
          refreshAppealButton();
          if (appealBtn.disabled) return;
          appealDialog.querySelector<HTMLInputElement>('[data-appeal-penalty-id]')!.value = currentPenaltyId;
          const label = appealDialog.querySelector<HTMLElement>('[data-appeal-incident-label]');
          if (label) label.textContent = currentIncidentLabel !== '—' ? `· Incident ${currentIncidentLabel}` : '';
          showError('');
          mobileDialog.close();
          appealDialog.showModal();
        });
        appealDialog.querySelectorAll<HTMLButtonElement>('[data-close-appeal-dialog]').forEach((btn) => {
          btn.addEventListener('click', () => appealDialog.close());
        });
        fileInput.addEventListener('change', () => {
          const files = Array.from(fileInput.files ?? []);
          if (files.length > 3) showError('You can attach up to 3 files.');
          else if (files.some((f) => f.size > 10 * 1024 * 1024)) showError('Each file must be 10 MB or smaller.');
          else showError('');
        });
        appealForm.addEventListener('submit', (event) => {
          const files = Array.from(fileInput.files ?? []);
          if (files.length > 3) {
            event.preventDefault();
            showError('You can attach up to 3 files.');
          } else if (files.some((f) => f.size > 10 * 1024 * 1024)) {
            event.preventDefault();
            showError('Each file must be 10 MB or smaller.');
          }
        });
      }
      refreshAppealButton();

      const openDetails = (row: HTMLTableRowElement) => {
        if (!row.dataset.incidentSummary) return;
        const summary = JSON.parse(row.dataset.incidentSummary);
        currentPenaltyId = summary.penaltyId ?? '';
        currentIncidentLabel = summary.incidentNumber ?? '—';

        setField('[data-mobile-driver]', summary.driverLabel ?? '—');
        setField('[data-mobile-incident-number]', summary.incidentNumber ?? '—');
        setField('[data-mobile-lap]', summary.lap != null ? String(summary.lap) : '—');

        setRowVisible('[data-mobile-involved-row]', Boolean(summary.involved));
        setField('[data-mobile-involved]', summary.involved ?? '');

        setRowVisible('[data-mobile-description-row]', Boolean(summary.description));
        setField('[data-mobile-description]', summary.description ?? '');

        const offenses: string[] = summary.offenses ?? [];
        setRowVisible('[data-mobile-offenses-row]', offenses.length > 0);
        const offensesEl = mobileDialog.querySelector<HTMLElement>('[data-mobile-offenses]');
        if (offensesEl) {
          offensesEl.replaceChildren(
            ...offenses.map((name: string) => {
              const div = document.createElement('div');
              div.textContent = name;
              return div;
            })
          );
        }

        setField('[data-mobile-pp]', summary.isWarning ? 'Warning' : (summary.pp ? String(summary.pp) : '—'));
        setField('[data-mobile-time]', summary.time ? `+${summary.time}s` : '—');
        setField('[data-mobile-points]', summary.points ? String(summary.points) : '—');

        const posEl = mobileDialog.querySelector<HTMLElement>('[data-mobile-position-delta]');
        if (posEl) {
          posEl.textContent = summary.positionDelta ?? '—';
          posEl.className = `mt-0.5 font-semibold ${summary.positionDeltaClass ?? 'text-white/40'}`;
        }
        const ptsEl = mobileDialog.querySelector<HTMLElement>('[data-mobile-points-delta]');
        if (ptsEl) {
          ptsEl.textContent = summary.pointsDelta ?? '—';
          ptsEl.className = `mt-0.5 font-semibold ${summary.pointsDeltaClass ?? 'text-white/40'}`;
        }

        setRowVisible('[data-mobile-appeal-row]', Boolean(summary.isAppealed));
        setField('[data-mobile-appeal]', summary.appealResult || 'No appeal notes recorded.');

        refreshAppealButton();
        mobileDialog.showModal();
      };

      document.querySelectorAll<HTMLTableRowElement>('[data-incident-row]').forEach((row) => {
        row.addEventListener('click', () => openDetails(row));
        row.addEventListener('keydown', (event) => {
          if (event.key !== 'Enter' && event.key !== ' ') return;
          event.preventDefault();
          openDetails(row);
        });
      });

      mobileDialog.querySelectorAll<HTMLButtonElement>('[data-close-mobile-incident-dialog]').forEach((btn) => {
        btn.addEventListener('click', () => mobileDialog.close());
      });
    }

    const dialog = document.querySelector<HTMLDialogElement>('[data-incident-dialog]');
    if (!dialog) return;
    const form = dialog.querySelector('form')!;
    const intentField = dialog.querySelector<HTMLInputElement>('[data-incident-intent-field]')!;
    const idField = dialog.querySelector<HTMLInputElement>('[data-incident-id-field]')!;
    const originalDriverField = dialog.querySelector<HTMLInputElement>('[data-incident-original-driver-field]')!;
    const fromReportField = dialog.querySelector<HTMLInputElement>('[data-incident-from-report-field]')!;
    const sessionField = dialog.querySelector<HTMLSelectElement>('[data-incident-session-field]')!;
    const heading = dialog.querySelector('[data-incident-heading]')!;
    const appealCheckbox = dialog.querySelector<HTMLInputElement>('[data-appeal-checkbox]')!;
    const appealFields = dialog.querySelector<HTMLElement>('[data-appeal-fields]')!;
    const editOnlyFields = dialog.querySelectorAll<HTMLElement>('[data-incident-edit-only]');
    const faultLegend = dialog.querySelector<HTMLElement>('[data-incident-fault-legend]')!;
    const faultSearch = dialog.querySelector<HTMLInputElement>('[data-incident-faults] [data-driver-search]')!;

    // Cars at fault: a checklist where every ticked car gets its own card
    // (PP/Warning, time penalty, points penalty, offenses) — see
    // src/scripts/faultCards.ts and the dialog markup in incidents/fragment.astro.
    // Racing Incident (no driver at fault, 0020_penalty_racing_incident.sql)
    // has no card: nobody to penalize. Available regardless of which session
    // is chosen — a qualifying/practice incident's penalty is just as real as
    // a race incident's, it always applies to Race 1 (see scoringRaceNumber in
    // src/lib/penalties.ts).
    const faultRoot = dialog.querySelector<HTMLElement>('[data-incident-faults]')!;
    const faults = initFaultPicker(faultRoot);

    // Clears the search box and re-filters (driverPickerSearch.ts), so a car
    // about to be pre-ticked isn't hidden by a search left over from last time.
    const resetDriverSearch = () => {
      faultSearch.value = '';
      faultSearch.dispatchEvent(new Event('input', { bubbles: true }));
    };

    // Adding can create several penalties at once (one per car); editing is
    // one existing penalty row, so one car only — and that's where an appeal
    // is recorded.
    function setMode(mode: 'add' | 'edit') {
      faults.setSingle(mode === 'edit');
      faultLegend.textContent = mode === 'edit' ? 'Car at fault' : 'Cars at fault — tick every car at fault';
      editOnlyFields.forEach((el) => el.classList.toggle('hidden', mode !== 'edit'));
      if (mode === 'add') {
        appealCheckbox.checked = false;
        setAppealFieldsVisible(false);
      }
    }

    // The "core" fields that must be filled in before the rest of the form is
    // even shown — Session is always required (a real race, Qualifying, or
    // Practice must always be explicitly chosen).
    const numberField = dialog.querySelector<HTMLInputElement>('[data-incident-number-field]')!;
    const lapField = dialog.querySelector<HTMLInputElement>('[data-incident-lap-field]')!;
    const missingFieldsEl = dialog.querySelector<HTMLElement>('[data-incident-missing-fields]')!;
    const restEl = dialog.querySelector<HTMLElement>('[data-incident-rest]')!;
    const saveButton = dialog.querySelector<HTMLButtonElement>('[data-incident-save-button]')!;

    function setAppealFieldsVisible(visible: boolean) {
      appealFields.classList.toggle('hidden', !visible);
      appealFields.classList.toggle('flex', visible);
    }

    // Session, a car at fault (or Racing Incident), Incident # and Lap are the
    // "core" fields — until all of them are filled in, the rest of the form
    // stays hidden and Save stays disabled, with a message saying what's missing.
    function updateFormValidity() {
      const missing: string[] = [];
      if (!sessionField.value) missing.push('Session');
      if (!faults.isRacingIncident() && faults.selected().length === 0) missing.push('Car at fault (or Racing Incident)');
      if (!numberField.value.trim()) missing.push('Incident #');
      if (!lapField.value.trim()) missing.push('Lap');

      const isValid = missing.length === 0;
      restEl.classList.toggle('hidden', !isValid);
      restEl.classList.toggle('flex', isValid);
      saveButton.disabled = !isValid;
      missingFieldsEl.textContent = isValid ? '' : `Still needed: ${missing.join(', ')}`;
      updateNumberWarning();
    }

    // Yellow note (not a block) when the Incident # matches one already logged
    // this round — e.g. a report's INC number pre-filled over hand-added or
    // imported incidents. "3", "#3", "# 3" and "03" all match, the same as the
    // incidents list's numeric sort. When editing, the incident's own number
    // doesn't count (its other cars' rows share it).
    const numberWarning = dialog.querySelector<HTMLElement>('[data-incident-number-warning]')!;
    const numberWarningValue = dialog.querySelector<HTMLElement>('[data-incident-number-warning-value]')!;
    const stripHash = (n: string) => n.trim().replace(/^#/, '').trim();
    const normalizeIncidentNumber = (n: string) => {
      const v = stripHash(n);
      return /^\d+$/.test(v) ? String(Number(v)) : v.toLowerCase();
    };
    const usedIncidentNumbers = new Set<string>(
      (JSON.parse(dialog.dataset.usedIncidentNumbers ?? '[]') as string[]).map(normalizeIncidentNumber)
    );
    let ownIncidentNumber = '';
    function updateNumberWarning() {
      const n = normalizeIncidentNumber(numberField.value);
      const duplicate = n !== '' && n !== ownIncidentNumber && usedIncidentNumbers.has(n);
      numberWarning.classList.toggle('hidden', !duplicate);
      numberWarningValue.textContent = stripHash(numberField.value);
    }

    // Ticking a car at fault also ticks that car in the Involved list — per
    // Logan, a driver at fault is, at minimum, involved in their own incident.
    // Only ever unticks a box this function itself ticked (autoInvolvedIds),
    // when that car stops being at fault — anything the admin ticked by hand,
    // including the same car, is never touched.
    const autoInvolvedIds = new Set<string>();
    function syncInvolvedWithFaults() {
      const atFault = new Set(faults.selected());
      for (const id of [...autoInvolvedIds]) {
        if (atFault.has(id)) continue;
        const checkbox = dialog!.querySelector<HTMLInputElement>(`[name="involved_driver_ids"][value="${id}"]`);
        if (checkbox) checkbox.checked = false;
        autoInvolvedIds.delete(id);
      }
      for (const id of atFault) {
        const checkbox = dialog!.querySelector<HTMLInputElement>(`[name="involved_driver_ids"][value="${id}"]`);
        if (checkbox && !checkbox.checked) {
          checkbox.checked = true;
          autoInvolvedIds.add(id);
        }
      }
    }

    appealCheckbox.addEventListener('change', () => setAppealFieldsVisible(appealCheckbox.checked));
    faultRoot.addEventListener('fault-change', syncInvolvedWithFaults);
    faultRoot.addEventListener('fault-change', updateFormValidity);
    sessionField.addEventListener('change', updateFormValidity);
    numberField.addEventListener('input', updateFormValidity);
    lapField.addEventListener('input', updateFormValidity);

    // Every way of opening the dialog starts from this blank Add state.
    function resetForAdd(fromReportId: string) {
      form.reset();
      resetDriverSearch();
      faults.clear();
      // Fresh dialog, fresh tracking — clear() above already ran the sync, so
      // nothing is auto-ticked yet.
      autoInvolvedIds.clear();
      intentField.value = 'add-incident';
      idField.value = '';
      originalDriverField.value = '';
      fromReportField.value = fromReportId;
      ownIncidentNumber = '';
      heading.textContent = 'Add Incident';
      numberField.value = dialog!.dataset.nextIncidentNumber ?? '';
      setMode('add');
    }

    document.querySelectorAll<HTMLButtonElement>('[data-open-incident-dialog]').forEach((btn) => {
      btn.addEventListener('click', () => {
        // Session and cars at fault start unselected on every new Add, per
        // Logan — the form starts collapsed with Save disabled.
        resetForAdd('');
        updateFormValidity();
        dialog.showModal();
      });
    });

    document.querySelectorAll<HTMLButtonElement>('[data-edit-incident]').forEach((btn) => {
      btn.addEventListener('click', () => {
        if (!btn.dataset.incident) return;
        const p = JSON.parse(btn.dataset.incident);
        resetForAdd('');
        intentField.value = 'update-incident';
        idField.value = p.id;
        originalDriverField.value = p.driver_id ?? '';
        heading.textContent = 'Edit Incident';
        setMode('edit');
        sessionField.value = p.session;

        const set = (name: string, value: string) => {
          const el = dialog.querySelector<HTMLInputElement | HTMLTextAreaElement>(`[name="${name}"]`);
          if (el) el.value = value;
        };
        set('incident_number', p.incident_number ?? '');
        ownIncidentNumber = normalizeIncidentNumber(p.incident_number ?? '');
        set('lap', p.lap ?? '');
        set('description', p.description ?? '');
        set('appeal_result', p.appeal_result ?? '');
        set('appeal_time_penalty_seconds', p.appeal_time_penalty_seconds ?? '');
        set('appeal_points_penalty', p.appeal_points_penalty ?? '');
        set('appeal_penalty_points', p.appeal_penalty_points ?? '');

        // Involved first, straight from the stored row — the car ticked below
        // is already in it, so the auto-tick sync has nothing to add.
        dialog.querySelectorAll<HTMLInputElement>('[name="involved_driver_ids"]').forEach((cb) => {
          cb.checked = (p.involved_driver_ids ?? []).includes(cb.value);
        });

        if (p.driver_id) {
          const card = faults.addDriver(p.driver_id);
          if (card) {
            // PP dropdown derived from the same two columns as always
            // (is_warning/penalty_points): is_warning wins outright, a 1-7
            // penalty_points maps straight to that option, and anything else
            // (0, or an old warning+PP combo predating
            // 0059_penalty_points_warning_dropdown.sql) falls back to "0".
            const pp = Number(p.penalty_points);
            setCardField(card, 'penalty_points_choice', p.is_warning ? 'warning' : pp >= 1 && pp <= 7 ? String(pp) : '');
            setCardField(card, 'time_penalty_seconds', p.time_penalty_seconds != null ? String(p.time_penalty_seconds) : '');
            setCardField(card, 'points_penalty', p.points_penalty ? String(p.points_penalty) : '');
            setCardField(card, 'offense_ids', p.offense_ids ?? []);
          }
        } else {
          faults.setRacingIncident(true);
        }
        // Whatever the sync just did, nothing in this stored row was auto-ticked.
        autoInvolvedIds.clear();

        appealCheckbox.checked = Boolean(p.is_appealed);
        setAppealFieldsVisible(Boolean(p.is_appealed));

        // Existing incidents already have their core fields filled in, so
        // this immediately expands the rest of the form and enables Save.
        updateFormValidity();
        dialog.showModal();
      });
    });

    // "Log incident" on a driver-submitted report: opens the normal Add
    // Incident dialog pre-filled from the report (session, lap, involved
    // cars, and the report's INC number as the Incident # — still editable;
    // the description is deliberately left blank). The steward still ticks
    // the car(s) at fault; saving marks the report as logged (from_report_id).
    document.querySelectorAll<HTMLButtonElement>('[data-log-report]').forEach((btn) => {
      btn.addEventListener('click', () => {
        if (!btn.dataset.report) return;
        const r = JSON.parse(btn.dataset.report);
        resetForAdd(r.id);
        // The report's own INC number, in place of the next-number default.
        if (r.number != null) numberField.value = String(r.number);
        sessionField.value = r.session;
        lapField.value = String(r.lap);
        dialog.querySelectorAll<HTMLInputElement>('[name="involved_driver_ids"]').forEach((cb) => {
          cb.checked = (r.driver_ids ?? []).includes(cb.value);
        });
        updateFormValidity();
        dialog.showModal();
      });
    });

    dialog.querySelectorAll<HTMLButtonElement>('[data-close-incident-dialog]').forEach((btn) => {
      btn.addEventListener('click', () => dialog.close());
    });
  }

  document.addEventListener('astro:page-load', initIncidentPage);

  // Steward review popup (View Incidents only): one shared <dialog>, filled
  // from the clicked report's data-review (pre-filled with the admin's own
  // review when editing). Every car ticked at fault gets its own suggested
  // penalty (src/scripts/faultCards.ts, 0100); Racing Incident has none.
  // Like initIncidentPage, this bails until the fragment's dialog exists and
  // binds on the loader's astro:page-load re-dispatch.
  function initReviewDialog() {
    const dialog = document.querySelector<HTMLDialogElement>('[data-review-dialog]');
    if (!dialog) return;
    const form = dialog.querySelector('form')!;
    const reportIdField = dialog.querySelector<HTMLInputElement>('[data-review-report-id]')!;
    const labelEl = dialog.querySelector<HTMLElement>('[data-review-label]')!;
    const faultRoot = dialog.querySelector<HTMLElement>('[data-review-faults]')!;
    const faultSearch = faultRoot.querySelector<HTMLInputElement>('[data-driver-search]')!;
    const faultsMissing = faultRoot.querySelector<HTMLElement>('[data-review-faults-missing]')!;
    const explanationField = dialog.querySelector<HTMLTextAreaElement>('[data-review-explanation]')!;
    const faults = initFaultPicker(faultRoot);

    // Checkboxes can't be `required` as a group, so the browser won't stop a
    // save with nothing ticked — do it here (the server checks too).
    const hasVerdict = () => faults.isRacingIncident() || faults.selected().length > 0;
    faultRoot.addEventListener('fault-change', () => {
      if (hasVerdict()) faultsMissing.classList.add('hidden');
    });
    form.addEventListener('submit', (e) => {
      if (hasVerdict()) return;
      e.preventDefault();
      faultsMissing.classList.remove('hidden');
    });

    document.querySelectorAll<HTMLButtonElement>('[data-open-review-dialog]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const data = JSON.parse(btn.dataset.review ?? '{}') as {
          report_id: string;
          label: string;
          faults: { driver_id: string; penalty: string }[] | null;
          explanation: string;
        };
        reportIdField.value = data.report_id;
        labelEl.textContent = `— ${data.label}`;
        // Clear any search left over from the last report and re-filter (driverPickerSearch.ts).
        faultSearch.value = '';
        faultSearch.dispatchEvent(new Event('input', { bubbles: true }));
        faults.clear();
        if (data.faults && data.faults.length === 0) faults.setRacingIncident(true);
        for (const f of data.faults ?? []) {
          const card = faults.addDriver(f.driver_id);
          if (card) setCardField(card, 'penalty', f.penalty);
        }
        faultsMissing.classList.add('hidden');
        explanationField.value = data.explanation;
        dialog.showModal();
      });
    });

    dialog.querySelectorAll<HTMLButtonElement>('[data-close-review-dialog]').forEach((btn) => {
      btn.addEventListener('click', () => dialog.close());
    });
  }

  document.addEventListener('astro:page-load', initReviewDialog);
</script>

<script>
  // Shell-then-skeleton: fetches the incident fragment (the expensive data work)
  // client-side once this shell has already painted — same pattern as
  // results.astro / standings.astro; see the matching fragment.astro for the
  // full explanation.
  function initIncidentResults() {
    const container = document.querySelector<HTMLElement>('[data-incident-results]');
    const url = container?.dataset.fragmentUrl;
    if (!container || !url) return;
    // Cleared immediately so the synthetic astro:page-load dispatched below
    // doesn't see this same data-fragment-url and fetch it all over again.
    delete container.dataset.fragmentUrl;

    fetch(url)
      .then((res) => {
        // The fragment answers with X-Redirect-To for an unknown round, or an
        // unposted report a non-admin may not see.
        const redirectTo = res.headers.get('X-Redirect-To');
        if (redirectTo) {
          window.location.replace(redirectTo);
          throw new Error('redirecting');
        }
        if (!res.ok) throw new Error(`incident fragment request failed (${res.status})`);
        return res.text();
      })
      .then((html) => {
        container.innerHTML = html;
        // reveal.ts only observes `.reveal` elements present at page-load
        // time; this content lands later, so mark it visible right away.
        const pageTitle = container.querySelector<HTMLElement>('[data-page-title]')?.dataset.pageTitle;
        if (pageTitle) document.title = `${pageTitle} · Alpha Touring Challenge`;
        container.querySelectorAll('.reveal').forEach((el) => el.classList.add('is-visible'));
        // Sortable tables, row expanders and this page's own scripts bind
        // against whatever exists at astro:page-load, so re-dispatch it now
        // that the real content is in place.
        document.dispatchEvent(new Event('astro:page-load'));
        // The browser's own jump to #hash happened before this content existed
        // (e.g. #reported-incidents after saving a review), so do it now — then
        // drop the hash, or every later refresh would yank the steward back here.
        if (location.hash) {
          try {
            document.getElementById(decodeURIComponent(location.hash.slice(1)))?.scrollIntoView();
          } catch {
            // Malformed hash — not worth losing the page over.
          }
          history.replaceState(history.state, '', location.pathname + location.search);
        }
      })
      .catch((err) => {
        console.error('Failed to load incident:', err);
        container.innerHTML = '<p class="mt-10 text-white/60">Couldn’t load this page right now — try refreshing.</p>';
      });
  }

  document.addEventListener('astro:page-load', initIncidentResults);
</script>
