---
export const prerender = false;

import Layout from '../../../layouts/Layout.astro';
import { resolveSupabaseEnv } from '../../../lib/supabase';
import { getRoundBySubsessionId } from '../../../lib/results';

// Shell-then-skeleton split (same pattern as the results and Incident Report
// pages): this file paints the frame, the back link and a loading skeleton
// right away; the round's kudos, drivers and the share/delete POST handling
// live in kudos/fragment.astro, fetched client-side once this shell has
// painted. The fragment's forms POST straight to the fragment and redirect
// back here.
const subsessionId = Astro.params.subsessionId;

// Only the round's name, for the <title> and link-preview embeds — crawlers
// don't run the fragment's JS.
let trackName: string | null = null;
if (Number.isFinite(Number(subsessionId))) {
  try {
    trackName = (await getRoundBySubsessionId(resolveSupabaseEnv(Astro.locals), Number(subsessionId)))?.track_name ?? null;
  } catch (err) {
    console.error('Failed to look up round for page title:', err);
  }
}
const seasonParam = Astro.url.searchParams.get('season');
const backToRoundHref = `/results/${subsessionId}${seasonParam ? `?season=${encodeURIComponent(seasonParam)}` : ''}`;

Astro.response.headers.set('Cache-Control', 'public, s-maxage=60, stale-while-revalidate=300');
---

<Layout title={trackName ? `Kudos: ${trackName}` : 'Kudos'} description="Highlights and good racing moments shared from this round.">
  <section class="mx-auto max-w-5xl px-6 pb-24 pt-8">
    <a href={backToRoundHref} class="text-sm text-white/50 hover:text-white">&larr; Back to Results</a>

    <div data-kudos-page data-fragment-url={`/results/${subsessionId}/kudos/fragment${Astro.url.search}`}>
      <div aria-live="polite" aria-busy="true">
        <span class="sr-only">Loading kudos…</span>
        <div class="mt-3 h-12 w-80 max-w-full animate-pulse rounded-md bg-white/[0.03]"></div>
        <div class="mt-3 h-5 w-40 animate-pulse rounded bg-white/[0.03]"></div>
        <div class="mt-8 flex flex-col gap-3">
          <div class="h-24 animate-pulse rounded-xl border border-white/10 bg-white/[0.02]"></div>
          <div class="h-24 animate-pulse rounded-xl border border-white/10 bg-white/[0.02]"></div>
        </div>
      </div>
    </div>
  </section>
</Layout>

<script>
  import '../../../scripts/kudosDialog';
</script>

<script>
  // Shell-then-skeleton loader — same as results/[subsessionId].astro's.
  function initKudosPage() {
    const container = document.querySelector<HTMLElement>('[data-kudos-page]');
    const url = container?.dataset.fragmentUrl;
    if (!container || !url) return;
    // Cleared immediately so the synthetic astro:page-load dispatched below
    // doesn't see this same data-fragment-url and fetch it all over again.
    delete container.dataset.fragmentUrl;

    fetch(url)
      .then((res) => {
        // Unknown round: the fragment answers with X-Redirect-To instead of redirecting.
        const redirectTo = res.headers.get('X-Redirect-To');
        if (redirectTo) {
          window.location.replace(redirectTo);
          throw new Error('redirecting');
        }
        if (!res.ok) throw new Error(`kudos fragment request failed (${res.status})`);
        return res.text();
      })
      .then((html) => {
        container.innerHTML = html;
        const pageTitle = container.querySelector<HTMLElement>('[data-page-title]')?.dataset.pageTitle;
        if (pageTitle) document.title = `${pageTitle} · Alpha Touring Challenge`;
        container.querySelectorAll('.reveal').forEach((el) => el.classList.add('is-visible'));
        document.dispatchEvent(new Event('astro:page-load'));
      })
      .catch((err) => {
        console.error('Failed to load kudos:', err);
        container.innerHTML = '<p class="mt-10 text-white/60">Couldn’t load this page right now — try refreshing.</p>';
      });
  }

  document.addEventListener('astro:page-load', initKudosPage);
</script>
