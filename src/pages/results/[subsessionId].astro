---
export const prerender = false;

import Layout from '../../layouts/Layout.astro';
import ResultsTable from '../../components/ResultsTable.astro';
import QualifyingResultsTable from '../../components/QualifyingResultsTable.astro';
import {
  resolveSupabaseEnv,
  getDriverClasses,
  getExhibitionRoundIds,
  getTestRoundIds,
  setRoundExhibition,
  setRoundTest,
  getRaceLinksForSubsession,
  upsertRaceLinks,
  formatDate,
  getPenaltiesForSubsession,
  type RaceLinks,
  type Penalty,
} from '../../lib/supabase';
import {
  getRoundBySubsessionId,
  getRoundResults,
  getQualifyingForSubsession,
  getRoundsForSeason,
  computeDisplayRoundNumbers,
  isChampionshipSeason,
  topTeamScorers,
  iracingResultsUrl,
  type RoundResults,
  type QualifyingRow,
} from '../../lib/results';
import { applyPenaltiesToRoundResults } from '../../lib/penalties';
import { isAdminView } from '../../lib/auth';

const supabaseEnv = resolveSupabaseEnv(Astro.locals);
// isAdminView (not a raw role check) so the footer's "View as Visitor"
// toggle actually hides this page's admin-only UI while previewing.
const isAdmin = isAdminView(Astro.locals);

// iRacing subsession IDs are ordinary (non-bigint-range) integers in
// practice, so Number() parsing here is safe — well under
// Number.MAX_SAFE_INTEGER.
const subsessionId = Number(Astro.params.subsessionId);

// Admin-only: flag/unflag this specific round as a non-points exhibition
// (e.g. a pre-season race run inside an otherwise real championship
// season) — a PRG redirect back to this same URL keeps this in line with
// every other admin mutation in the codebase (see admin/champions'
// upload-photo fix for why that matters).
if (isAdmin && Astro.request.method === 'POST' && Number.isFinite(subsessionId)) {
  const form = await Astro.request.formData();
  const intent = String(form.get('intent') ?? '');

  if (intent === 'toggle-exhibition') {
    const nextIsExhibition = String(form.get('next') ?? 'true') === 'true';
    try {
      await setRoundExhibition(supabaseEnv, Astro.locals.session!.accessToken, subsessionId, nextIsExhibition);
    } catch (err) {
      console.error('Failed to update round exhibition flag:', err);
    }
    return Astro.redirect(`${Astro.url.pathname}${Astro.url.search}`, 302);
  }

  if (intent === 'toggle-test') {
    const nextIsTest = String(form.get('next') ?? 'true') === 'true';
    try {
      await setRoundTest(supabaseEnv, Astro.locals.session!.accessToken, subsessionId, nextIsTest);
    } catch (err) {
      console.error('Failed to update round test flag:', err);
    }
    return Astro.redirect(`${Astro.url.pathname}${Astro.url.search}`, 302);
  }

  if (intent === 'save-race-links') {
    // Empty strings from the form mean "clear this field" (null), not
    // "leave whatever was there" — the form always shows the current
    // values, so a blank field means the admin actually cleared it.
    const strOrNull = (v: FormDataEntryValue | null) => {
      const s = String(v ?? '').trim();
      return s.length > 0 ? s : null;
    };
    const numOrNull = (v: FormDataEntryValue | null) => {
      const s = String(v ?? '').trim();
      return s.length > 0 ? Number(s) : null;
    };
    const raceNumber = Number(form.get('race_number'));
    if (Number.isFinite(raceNumber)) {
      try {
        await upsertRaceLinks(supabaseEnv, Astro.locals.session!.accessToken, {
          subsession_id: subsessionId,
          race_number: raceNumber,
          iracing_subsession_id: numOrNull(form.get('iracing_subsession_id')),
          replay_url: strOrNull(form.get('replay_url')),
          broadcast_url: strOrNull(form.get('broadcast_url')),
          photo_album_url: strOrNull(form.get('photo_album_url')),
        });
      } catch (err) {
        console.error('Failed to save race links:', err);
      }
    }
    return Astro.redirect(`${Astro.url.pathname}${Astro.url.search}`, 302);
  }

  // Penalty add/edit/remove now lives entirely on the Incident Report page
  // (src/pages/results/[subsessionId]/incidents.astro) — this page is
  // read-only for penalties (see v0.16's README section for why).
}

let round: Awaited<ReturnType<typeof getRoundBySubsessionId>> = null;
let roundResults: RoundResults = { byClass: new Map(), overall: new Map() };
let classes: Awaited<ReturnType<typeof getDriverClasses>> = [];
let exhibitionRoundIds: Set<number> = new Set();
let testRoundIds: Set<number> = new Set();
let raceLinksByRace: Map<number, RaceLinks> = new Map();
let penalties: Penalty[] = [];
let loadError: string | null = null;

if (Number.isFinite(subsessionId)) {
  try {
    [round, roundResults, classes, exhibitionRoundIds, testRoundIds, raceLinksByRace, penalties] = await Promise.all([
      getRoundBySubsessionId(supabaseEnv, subsessionId),
      getRoundResults(supabaseEnv, subsessionId),
      getDriverClasses(supabaseEnv),
      getExhibitionRoundIds(supabaseEnv),
      getTestRoundIds(supabaseEnv),
      getRaceLinksForSubsession(supabaseEnv, subsessionId),
      getPenaltiesForSubsession(supabaseEnv, subsessionId),
    ]);
  } catch (err) {
    console.error('Failed to load round results:', err);
    loadError = err instanceof Error ? err.message : String(err);
  }
}

if (!loadError && !round) {
  return Astro.redirect('/results', 302);
}

// Recalculate positions/points for anywhere a penalty applies (rule 64's
// re-classification, plus each of that driver's own flat points_penalty
// deductions) — see src/lib/penalties.ts for the full engine. A no-op
// (same object back) for a round with no penalties logged. Only ever
// touches penalties.session_type === 'race' rows in effect, since
// applyPenaltiesToRoundResults only ever looks up race_number keys that
// exist in roundResults — a qualifying/practice penalty's race_number
// sentinel (0) never matches a real race and is naturally never applied.
if (!loadError && penalties.length > 0) {
  // Alpha never earns the top-3-in-class Class Points bonus (Gamma/Delta's
  // own per-race class-position bonus, see README) — told to recomputeRow
  // via this lookup so a penalty-driven podium shuffle can't manufacture
  // class points for an Alpha driver that the original pipeline data never
  // had.
  const classPointsEligibleByClassId = new Map(classes.map((c) => [c.id, c.name !== 'Alpha']));
  roundResults = applyPenaltiesToRoundResults(roundResults, penalties, round?.format ?? null, classPointsEligibleByClassId);
}

const classNameById = new Map(classes.map((c) => [c.id, c.name]));
// Classes ordered Alpha/Gamma/Delta (sort_order) rather than however Map
// iteration happens to return them.
const orderedClassIds = classes.map((c) => c.id).filter((id) => roundResults.byClass.has(id));

// Exhibition either because the round itself is flagged (round_overrides)
// or because the whole season it belongs to isn't a real championship
// season (see isChampionshipSeason).
const isRoundFlaggedExhibition = exhibitionRoundIds.has(subsessionId);
const isSeasonExhibition = round?.season_label ? !isChampionshipSeason(round.season_label) : false;
const isExhibition = isRoundFlaggedExhibition || isSeasonExhibition;
// Independent of isExhibition — see 0036_round_test_flag.sql. A round can't
// be BOTH season-flagged-exhibition and season-flagged-test since that's a
// property of the season name, but the manual per-round flags (this one and
// is_exhibition) aren't mutually exclusive by design.
const isTest = testRoundIds.has(subsessionId);

// The displayed "Round N" skips exhibitions and test sessions entirely (so
// flagging round 1 makes round 2 become "Round 1") — needs every round in
// this round's season to compute, not just this one.
let displayRoundNumber: number | null = null;
if (!loadError && round) {
  try {
    const seasonRounds = await getRoundsForSeason(supabaseEnv, round.season_id);
    displayRoundNumber = computeDisplayRoundNumbers(seasonRounds, exhibitionRoundIds, testRoundIds).get(subsessionId) ?? null;
  } catch (err) {
    console.error('Failed to compute round number:', err);
  }
}

// Race vs. Qualifying — two independent result categories, each with its
// own Overall/Per Class view (see `view` below). Practice isn't one of
// these tabs: there's no imported practice-results table yet (Logan: "we
// will create this table later") — Practice only exists as a loggable
// session on the Incident Report (see that page).
const category = Astro.url.searchParams.get('category') === 'qualifying' ? 'qualifying' : 'race';
// The points system is based on overall finishing position, not
// class-relative position, so the overall (cross-class) view is the
// default — the per-class view is still available via ?view=class. Shared
// by both categories.
const view = Astro.url.searchParams.get('view') === 'class' ? 'class' : 'overall';
const overallRaceNumbers = [...roundResults.overall.keys()].sort((a, b) => a - b);

// Fetched only when actually viewing Qualifying — qualifying isn't split by
// race (curated_qualifying has no race_number column, it's one session per
// round), so this is a single overall/byClass pair rather than a per-race
// map. See getQualifyingForSubsession's own doc comment.
let qualifying: { overall: QualifyingRow[]; byClass: Map<number, QualifyingRow[]> } = { overall: [], byClass: new Map() };
if (!loadError && category === 'qualifying' && Number.isFinite(subsessionId)) {
  try {
    qualifying = await getQualifyingForSubsession(supabaseEnv, subsessionId);
  } catch (err) {
    console.error('Failed to load qualifying results:', err);
  }
}
const qualifyingOrderedClassIds = classes.map((c) => c.id).filter((id) => qualifying.byClass.has(id));

// Whatever `season` value (a real season number, or one of results.astro's
// pooled "exhibition-rounds"/"test-sessions" filter sentinels) the Race
// Results list was showing when this round's link was clicked — carried
// through every link below that returns to or stays within this round, so
// "Back to Race Results" (and the category/view tabs and Incident Report
// link, which shouldn't lose it either) land back on the same view instead
// of always defaulting to the current season.
const seasonParam = Astro.url.searchParams.get('season');
const backHref = seasonParam ? `/results?season=${encodeURIComponent(seasonParam)}` : '/results';
const seasonQuerySuffix = seasonParam ? `&season=${encodeURIComponent(seasonParam)}` : '';
const incidentsHref = `/results/${subsessionId}/incidents${seasonParam ? `?season=${encodeURIComponent(seasonParam)}` : ''}`;

/** Shared pill styling for the category/view toggle links below. */
function pillClass(active: boolean): string {
  return `rounded-lg px-4 py-1.5 text-sm font-semibold ring-1 ring-white/15 transition ${
    active ? 'bg-white text-brand-ink' : 'text-white/80 hover:bg-white/10'
  }`;
}

// How many points each driver actually contributed toward their team's
// total for a given race — only the team's top 2 scorers that race count
// (topTeamScorers(), see results.ts), same class-blind "overall" points
// formula the news recap's Team Scoring Breakdown uses, so this figure
// always matches what that breakdown would show. Computed once from the
// overall (cross-class) rows regardless of which view (Overall/Per Class)
// is being rendered, since a team can span more than one class and a
// driver's contribution to their team is the same fact either way.
const teamPointsByRaceDriver = new Map<string, number>();
for (const [raceNumber, overallRows] of roundResults.overall) {
  const rowsByTeam = new Map<string, typeof overallRows>();
  for (const row of overallRows) {
    if (!row.team) continue;
    if (!rowsByTeam.has(row.team.name)) rowsByTeam.set(row.team.name, []);
    rowsByTeam.get(row.team.name)!.push(row);
  }
  for (const teamRows of rowsByTeam.values()) {
    for (const row of topTeamScorers(teamRows, (r) => r.totalPoints - r.classPoints)) {
      teamPointsByRaceDriver.set(`${raceNumber}:${row.driver.id}`, row.totalPoints - row.classPoints);
    }
  }
}

Astro.response.headers.set('Cache-Control', 'public, s-maxage=60, stale-while-revalidate=300');
---

<Layout title={round ? round.track_name : 'Race Results'} description="Race-by-race results for this round.">
  <section class="mx-auto max-w-5xl px-6 pb-24 pt-28 sm:pt-36">
    <a href={backHref} class="text-sm text-white/50 hover:text-white">&larr; Back to Race Results</a>

    {loadError && (
      <p class="mt-4 rounded-lg border border-brand-pink/30 bg-brand-pink/10 p-4 text-sm text-white/80">
        Couldn't load this round's results right now. If this mentions permission/RLS, race_scores or
        curated_race_results likely still need the public-read policy from
        <code>supabase/migrations/0004_champions.sql</code> — it has to be run manually in the Supabase SQL editor.
        <br /><span class="mt-1 block text-white/50">{loadError}</span>
      </p>
    )}

    {round && (
      <>
        <h1 class="reveal mt-3 font-display text-5xl" style="transition-delay: 40ms">
          {isExhibition ? 'Exhibition — ' : displayRoundNumber !== null ? `Round ${displayRoundNumber} — ` : ''}{round.track_name}
        </h1>
        <p class="reveal mt-3 text-white/60" style="transition-delay: 80ms">
          {formatDate(round.start_time)}
          {round.format && ` · ${round.format === 'endurance' ? 'Endurance' : 'Sprint'}`}
          {round.strength_of_field !== null && ` · SoF ${round.strength_of_field}`}
          {round.num_drivers !== null && ` · ${round.num_drivers} drivers`}
        </p>

        {isExhibition && (
          <p class="reveal mt-2 flex flex-wrap items-center gap-2 text-sm" style="transition-delay: 90ms">
            <span class="rounded-lg bg-brand-pink/15 px-2.5 py-1 text-xs font-semibold uppercase tracking-wide text-brand-pink">
              Exhibition
            </span>
            <span class="text-white/40">
              {isSeasonExhibition ? "Non-points season — excluded from standings & champions." : 'Flagged non-points — excluded from standings & champions.'}
            </span>
          </p>
        )}

        {isTest && (
          <p class="reveal mt-2 flex flex-wrap items-center gap-2 text-sm" style="transition-delay: 90ms">
            <span class="rounded-lg bg-white/10 px-2.5 py-1 text-xs font-semibold uppercase tracking-wide text-white/60">
              Test
            </span>
            <span class="text-white/40">Flagged as a test round — find it via the Test Sessions filter on the Race Results list.</span>
          </p>
        )}

        {/* Race links (iRacing Results / Replay / Broadcast / Photo Album) — one row
            per real race number, always visible regardless of which results
            category/view is currently selected (they're a property of the round,
            not of a view). Moved here from ResultsTable.astro, which used to render
            this once per race table and so lost it entirely under a non-Race view. */}
        {overallRaceNumbers.length > 0 && (
          <div class="mt-6 flex flex-col gap-2">
            {overallRaceNumbers.map((raceNumber) => {
              const links = raceLinksByRace.get(raceNumber) ?? null;
              const hasAnyLink = links && (links.iracing_subsession_id || links.replay_url || links.broadcast_url || links.photo_album_url);
              if (!hasAnyLink && !isAdmin) return null;
              return (
                <div class="flex flex-wrap items-center gap-2">
                  <span class="text-xs font-semibold uppercase tracking-widest text-white/40">Race {raceNumber}</span>
                  {links?.iracing_subsession_id && (
                    <a
                      href={iracingResultsUrl(links.iracing_subsession_id)}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="rounded-lg bg-brand-primary px-3 py-1 text-[11px] font-semibold text-white transition hover:brightness-110"
                    >
                      iRacing Results
                    </a>
                  )}
                  {links?.replay_url && (
                    <a
                      href={links.replay_url}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="rounded-lg bg-brand-primary px-3 py-1 text-[11px] font-semibold text-white transition hover:brightness-110"
                    >
                      Download Replay
                    </a>
                  )}
                  {links?.broadcast_url && (
                    <a
                      href={links.broadcast_url}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="rounded-lg bg-brand-primary px-3 py-1 text-[11px] font-semibold text-white transition hover:brightness-110"
                    >
                      Watch Broadcast
                    </a>
                  )}
                  {links?.photo_album_url && (
                    <a
                      href={links.photo_album_url}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="rounded-lg bg-brand-primary px-3 py-1 text-[11px] font-semibold text-white transition hover:brightness-110"
                    >
                      Photo Album
                    </a>
                  )}
                  {isAdmin && (
                    <details class="relative">
                      <summary class="cursor-pointer list-none rounded-lg bg-white/5 px-3 py-1 text-[11px] font-semibold text-white/50 ring-1 ring-white/10 transition hover:bg-white/10">
                        Edit links
                      </summary>
                      <form
                        method="POST"
                        data-astro-reload
                        class="absolute left-0 z-10 mt-2 flex w-64 flex-col gap-2 rounded-lg border border-white/10 bg-brand-ink p-4 shadow-xl"
                      >
                        <input type="hidden" name="intent" value="save-race-links" />
                        <input type="hidden" name="subsession_id" value={subsessionId} />
                        <input type="hidden" name="race_number" value={raceNumber} />
                        <label class="flex flex-col gap-1 text-[11px] text-white/50">
                          iRacing subsession ID
                          <input
                            type="number"
                            name="iracing_subsession_id"
                            value={links?.iracing_subsession_id ?? ''}
                            class="rounded-md border border-white/15 bg-white/5 px-2 py-1.5 text-xs text-white outline-none focus:border-brand-primary"
                          />
                        </label>
                        <label class="flex flex-col gap-1 text-[11px] text-white/50">
                          Replay download URL
                          <input
                            type="url"
                            name="replay_url"
                            value={links?.replay_url ?? ''}
                            class="rounded-md border border-white/15 bg-white/5 px-2 py-1.5 text-xs text-white outline-none focus:border-brand-primary"
                          />
                        </label>
                        <label class="flex flex-col gap-1 text-[11px] text-white/50">
                          Broadcast video URL
                          <input
                            type="url"
                            name="broadcast_url"
                            value={links?.broadcast_url ?? ''}
                            class="rounded-md border border-white/15 bg-white/5 px-2 py-1.5 text-xs text-white outline-none focus:border-brand-primary"
                          />
                        </label>
                        <label class="flex flex-col gap-1 text-[11px] text-white/50">
                          Photo album URL
                          <input
                            type="url"
                            name="photo_album_url"
                            value={links?.photo_album_url ?? ''}
                            class="rounded-md border border-white/15 bg-white/5 px-2 py-1.5 text-xs text-white outline-none focus:border-brand-primary"
                          />
                        </label>
                        <button
                          type="submit"
                          class="mt-1 rounded-lg bg-brand-primary px-3 py-1.5 text-xs font-semibold transition hover:brightness-110"
                        >
                          Save
                        </button>
                      </form>
                    </details>
                  )}
                </div>
              );
            })}
          </div>
        )}

        <div class="mt-8 flex gap-2">
          <a href={`/results/${subsessionId}?category=race&view=${view}${seasonQuerySuffix}`} class={pillClass(category === 'race')}>
            Race
          </a>
          <a href={`/results/${subsessionId}?category=qualifying&view=${view}${seasonQuerySuffix}`} class={pillClass(category === 'qualifying')}>
            Qualifying
          </a>
        </div>

        <div class="mt-3 flex flex-wrap items-center justify-between gap-2">
          <div class="flex gap-2">
            <a href={`/results/${subsessionId}?category=${category}&view=overall${seasonQuerySuffix}`} class={pillClass(view === 'overall')}>
              Overall
            </a>
            <a href={`/results/${subsessionId}?category=${category}&view=class${seasonQuerySuffix}`} class={pillClass(view === 'class')}>
              Per Class
            </a>
          </div>
          <a
            href={incidentsHref}
            class="rounded-lg bg-brand-gold/15 px-4 py-1.5 text-sm font-semibold text-brand-gold ring-1 ring-brand-gold/30 transition hover:bg-brand-gold/25"
          >
            Incident Report
          </a>
        </div>

        {category === 'race' && (
          <>
            {orderedClassIds.length === 0 && <p class="mt-10 text-white/60">No results.</p>}

            {view === 'overall' && orderedClassIds.length > 0 && (
              <>
                {overallRaceNumbers.map((raceNumber) => (
                  <ResultsTable
                    raceNumber={raceNumber}
                    rows={roundResults.overall.get(raceNumber)!}
                    showClass
                    classNameById={classNameById}
                    penalties={penalties}
                    teamPointsByRaceDriver={teamPointsByRaceDriver}
                  />
                ))}
              </>
            )}

            {view === 'class' && orderedClassIds.map((classId) => {
              const byRace = roundResults.byClass.get(classId)!;
              const raceNumbers = [...byRace.keys()].sort((a, b) => a - b);
              return (
                <div class="mt-12">
                  <h2 class="font-display text-2xl uppercase tracking-widest text-white/50">{classNameById.get(classId)}</h2>
                  {raceNumbers.map((raceNumber) => (
                    <ResultsTable
                      raceNumber={raceNumber}
                      rows={byRace.get(raceNumber)!}
                      penalties={penalties}
                      teamPointsByRaceDriver={teamPointsByRaceDriver}
                    />
                  ))}
                </div>
              );
            })}
          </>
        )}

        {category === 'qualifying' && (
          <>
            {qualifying.overall.length === 0 && <p class="mt-10 text-white/60">No qualifying results.</p>}

            {view === 'overall' && qualifying.overall.length > 0 && (
              <QualifyingResultsTable rows={qualifying.overall} showClass classNameById={classNameById} />
            )}

            {view === 'class' && qualifyingOrderedClassIds.map((classId) => (
              <div class="mt-12">
                <h2 class="font-display text-2xl uppercase tracking-widest text-white/50">{classNameById.get(classId)}</h2>
                <QualifyingResultsTable rows={qualifying.byClass.get(classId)!} />
              </div>
            ))}
          </>
        )}

        {isAdmin && !isSeasonExhibition && (
          <div class="mt-16 flex flex-wrap gap-3 border-t border-white/10 pt-6">
            <form method="POST" data-astro-reload>
              <input type="hidden" name="intent" value="toggle-exhibition" />
              <input type="hidden" name="next" value={isRoundFlaggedExhibition ? 'false' : 'true'} />
              <button
                type="submit"
                class="rounded-lg bg-white/5 px-3 py-1.5 text-xs font-semibold text-white/70 ring-1 ring-white/10 transition hover:bg-white/10"
              >
                {isRoundFlaggedExhibition ? 'Unflag as exhibition' : 'Flag this round as an exhibition'}
              </button>
            </form>
            <form method="POST" data-astro-reload>
              <input type="hidden" name="intent" value="toggle-test" />
              <input type="hidden" name="next" value={isTest ? 'false' : 'true'} />
              <button
                type="submit"
                class="rounded-lg bg-white/5 px-3 py-1.5 text-xs font-semibold text-white/70 ring-1 ring-white/10 transition hover:bg-white/10"
              >
                {isTest ? 'Unflag as test' : 'Flag this round as a test'}
              </button>
            </form>
          </div>
        )}
      </>
    )}
  </section>
</Layout>
