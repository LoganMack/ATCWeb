---
export const prerender = false;

import Layout from '../../layouts/Layout.astro';
import { resolveSupabaseEnv } from '../../lib/db/client';
import { getRoundBySubsessionId } from '../../lib/results/rounds';
import { getPageBanners } from '../../lib/db/assets';
import { bannerUrlFor } from '../../lib/pageBanners';
import PageBanner from '../../components/PageBanner.astro';

// Shell: paints the frame, back link and a skeleton; [subsessionId]/fragment.astro holds the round's data and
// POST handling (its forms post to it and redirect here). The dialog and countdown scripts load here, because
// scripts in fetched HTML never run; they are delegated, register-once listeners.
const subsessionId = Astro.params.subsessionId;

// Only the round's name, for the <title> and link-preview (Discord/Slack)
// embeds — crawlers don't run the fragment's JS, so this has to be in the
// shell's own HTML. One small lookup; everything else waits for the fragment.
let trackName: string | null = null;
if (Number.isFinite(Number(subsessionId))) {
  try {
    trackName = (await getRoundBySubsessionId(resolveSupabaseEnv(Astro.locals), Number(subsessionId)))?.track_name ?? null;
  } catch (err) {
    console.error('Failed to look up round for page title:', err);
  }
}
let bannerUrl: string | null = null;
try {
  bannerUrl = bannerUrlFor(await getPageBanners(resolveSupabaseEnv(Astro.locals)), 'round-results');
} catch (err) {
  console.error('Failed to load page banner:', err);
}
const seasonParam = Astro.url.searchParams.get('season');
const backHref = seasonParam ? `/results?season=${encodeURIComponent(seasonParam)}` : '/results';

Astro.response.headers.set('Cache-Control', 'public, s-maxage=60, stale-while-revalidate=300');
---

<Layout title={trackName ?? 'Race Results'} description="Race-by-race results for this round.">
  <section class="relative mx-auto max-w-5xl px-6 pb-24 pt-8">
    <PageBanner imageUrl={bannerUrl} />
    <a href={backHref} class="text-sm text-white/50 hover:text-white">&larr; Back to Race Results</a>

    <div data-race-results data-fragment-url={`/results/${subsessionId}/fragment${Astro.url.search}`}>
      <div aria-live="polite" aria-busy="true">
        <span class="sr-only">Loading results…</span>
        <div class="mt-3 h-12 w-72 max-w-full animate-pulse rounded-md bg-white/[0.03]"></div>
        <div class="mt-3 h-5 w-40 animate-pulse rounded bg-white/[0.03]"></div>
        <div class="mt-8 flex flex-wrap items-center gap-3">
          <div class="hidden h-9 w-60 max-w-full animate-pulse sm:block rounded-md border border-white/10 bg-white/[0.03]"></div>
          <div class="h-9 w-[6.6rem] animate-pulse rounded-md border border-white/10 bg-white/[0.03]"></div>
          <div class="h-9 w-[6.6rem] animate-pulse rounded-md border border-white/10 bg-white/[0.03]"></div>
          <div class="flex gap-2 sm:ml-auto">
            <div class="h-9 w-10 animate-pulse rounded-md border border-white/10 bg-white/[0.03]"></div>
            <div class="h-9 w-32 animate-pulse rounded-md border border-white/10 bg-white/[0.03]"></div>
            <div class="h-9 w-10 animate-pulse rounded-md border border-white/10 bg-white/[0.03]"></div>
          </div>
        </div>
        <div class="mt-6 h-[28rem] animate-pulse rounded-xl border border-white/10 bg-white/[0.02]"></div>
      </div>
    </div>
  </section>
</Layout>

<script>
  import '../../scripts/raceLinksDialog';
  import '../../scripts/reportIncidentDialog';
  import '../../scripts/incidentCountdown';
  import '../../scripts/interviewRecorder';
</script>

<script>
  import { bindFragment, pageTitle, redirectHeader } from '../../scripts/fragmentLoader';

  bindFragment('[data-race-results]', {
    label: 'race',
    logMessage: 'Failed to load race:',
    errorHtml: '<p class="mt-10 text-white/60">Couldn’t load this page right now — try refreshing.</p>',
    checkResponse: redirectHeader,
    afterInsert: pageTitle,
    reveal: true,
  });
</script>
