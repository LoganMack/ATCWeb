---
export const prerender = false;

import Layout from '../../layouts/Layout.astro';
import { resolveSupabaseEnv } from '../../lib/supabase';
import { getRoundBySubsessionId } from '../../lib/results';

// Shell-then-skeleton split (same pattern as results.astro / standings.astro):
// this file paints the frame, the back link and a loading skeleton right away;
// everything that needs the round's data — results, penalties, ruleset,
// incident-report state, the admin/incident POST handling — lives in
// [subsessionId]/fragment.astro and is fetched client-side once this shell has
// painted. The fragment's forms POST straight to the fragment (which owns that
// handling) and redirect back here.
//
// The dialog/countdown scripts below used to live inside their components;
// those components now render inside the fetched fragment, where <script> tags
// never execute, so the scripts are loaded here instead (all are delegated,
// register-once listeners that don't need their elements to exist yet).
const subsessionId = Astro.params.subsessionId;

// Only the round's name, for the <title> and link-preview (Discord/Slack)
// embeds — crawlers don't run the fragment's JS, so this has to be in the
// shell's own HTML. One small lookup; everything else waits for the fragment.
let trackName: string | null = null;
if (Number.isFinite(Number(subsessionId))) {
  try {
    trackName = (await getRoundBySubsessionId(resolveSupabaseEnv(Astro.locals), Number(subsessionId)))?.track_name ?? null;
  } catch (err) {
    console.error('Failed to look up round for page title:', err);
  }
}
const seasonParam = Astro.url.searchParams.get('season');
const backHref = seasonParam ? `/results?season=${encodeURIComponent(seasonParam)}` : '/results';

Astro.response.headers.set('Cache-Control', 'public, s-maxage=60, stale-while-revalidate=300');
---

<Layout title={trackName ?? 'Race Results'} description="Race-by-race results for this round.">
  <section class="mx-auto max-w-5xl px-6 pb-24 pt-8">
    <a href={backHref} class="text-sm text-white/50 hover:text-white">&larr; Back to Race Results</a>

    <div data-race-results data-fragment-url={`/results/${subsessionId}/fragment${Astro.url.search}`}>
      <div aria-live="polite" aria-busy="true">
        <span class="sr-only">Loading results…</span>
        <div class="mt-3 h-12 w-72 max-w-full animate-pulse rounded-md bg-white/[0.03]"></div>
        <div class="mt-3 h-5 w-40 animate-pulse rounded bg-white/[0.03]"></div>
        <div class="mt-8 flex flex-wrap items-center gap-3">
          <div class="h-9 w-32 animate-pulse rounded-md border border-white/10 bg-white/[0.03]"></div>
          <div class="h-9 w-24 animate-pulse rounded-md border border-white/10 bg-white/[0.03]"></div>
          <div class="flex gap-2 sm:ml-auto">
            <div class="h-9 w-28 animate-pulse rounded-md border border-white/10 bg-white/[0.03]"></div>
            <div class="h-9 w-32 animate-pulse rounded-md border border-white/10 bg-white/[0.03]"></div>
          </div>
        </div>
        <div class="mt-6 h-[28rem] animate-pulse rounded-xl border border-white/10 bg-white/[0.02]"></div>
      </div>
    </div>
  </section>
</Layout>

<script>
  import '../../scripts/raceLinksDialog';
  import '../../scripts/reportIncidentDialog';
  import '../../scripts/incidentCountdown';
</script>

<script>
  // Shell-then-skeleton: fetches the race fragment (the expensive data work)
  // client-side once this shell has already painted — same pattern as
  // results.astro / standings.astro; see the matching fragment.astro for the
  // full explanation.
  function initRaceResults() {
    const container = document.querySelector<HTMLElement>('[data-race-results]');
    const url = container?.dataset.fragmentUrl;
    if (!container || !url) return;
    // Cleared immediately so the synthetic astro:page-load dispatched below
    // doesn't see this same data-fragment-url and fetch it all over again.
    delete container.dataset.fragmentUrl;

    fetch(url)
      .then((res) => {
        // Unknown round: the fragment answers with X-Redirect-To instead of redirecting.
        const redirectTo = res.headers.get('X-Redirect-To');
        if (redirectTo) {
          window.location.replace(redirectTo);
          throw new Error('redirecting');
        }
        if (!res.ok) throw new Error(`race fragment request failed (${res.status})`);
        return res.text();
      })
      .then((html) => {
        container.innerHTML = html;
        // reveal.ts only observes `.reveal` elements present at page-load
        // time; this content lands later, so mark it visible right away.
        const pageTitle = container.querySelector<HTMLElement>('[data-page-title]')?.dataset.pageTitle;
        if (pageTitle) document.title = `${pageTitle} · Alpha Touring Challenge`;
        container.querySelectorAll('.reveal').forEach((el) => el.classList.add('is-visible'));
        // Sortable tables, row expanders and this page's own scripts bind
        // against whatever exists at astro:page-load, so re-dispatch it now
        // that the real content is in place.
        document.dispatchEvent(new Event('astro:page-load'));
      })
      .catch((err) => {
        console.error('Failed to load race:', err);
        container.innerHTML = '<p class="mt-10 text-white/60">Couldn’t load this page right now — try refreshing.</p>';
      });
  }

  document.addEventListener('astro:page-load', initRaceResults);
</script>
