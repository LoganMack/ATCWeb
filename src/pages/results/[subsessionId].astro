---
export const prerender = false;

import Layout from '../../layouts/Layout.astro';
import HistoryTabs from '../../components/HistoryTabs.astro';
import ResultsTable from '../../components/ResultsTable.astro';
import {
  resolveSupabaseEnv,
  getDriverClasses,
  getExhibitionRoundIds,
  setRoundExhibition,
  getRaceLinksForSubsession,
  upsertRaceLinks,
  formatDate,
  getPenaltiesForSubsession,
  getPenaltiesForSubsessions,
  getPenaltyOffenses,
  createPenalty,
  updatePenalty,
  deletePenalty,
  getDriverById,
  updateDriver,
  getEvents,
  getWarningCounts,
  type RaceLinks,
  type Penalty,
  type PenaltyOffense,
} from '../../lib/supabase';
import {
  getRoundBySubsessionId,
  getRoundResults,
  getRoundsForSeason,
  getCurrentSeasonRounds,
  computeDisplayRoundNumbers,
  isChampionshipSeason,
  type RoundResults,
} from '../../lib/results';
import { applyPenaltiesToRoundResults, computeSeasonPPState } from '../../lib/penalties';

const supabaseEnv = resolveSupabaseEnv(Astro.locals);
const isAdmin = Astro.locals.session?.profile?.role === 'admin';

// iRacing subsession IDs are ordinary (non-bigint-range) integers in
// practice, so Number() parsing here is safe — well under
// Number.MAX_SAFE_INTEGER.
const subsessionId = Number(Astro.params.subsessionId);

/**
 * Recomputes one driver's CURRENT SEASON PP tally/probation state from
 * scratch (see computeSeasonPPState's own doc comment for why "from
 * scratch" beats incrementally patching a stored counter) and persists it.
 * Called after every penalty create/update/delete below — not just
 * creation like in v0.13/v0.14 — so editing or removing a penalty now
 * correctly ripples through, and so PP stays scoped to the CURRENT season
 * (rule 57's season limit) rather than accumulating across a driver's
 * whole career. A no-op if no season is currently flagged `is_current`.
 */
async function recomputeDriverSeasonPP(driverId: string) {
  const [driver, currentSeason, events] = await Promise.all([
    getDriverById(supabaseEnv, driverId),
    getCurrentSeasonRounds(supabaseEnv),
    getEvents(supabaseEnv),
  ]);
  if (!driver || currentSeason.subsessionIds.length === 0) return;

  const seasonPenalties = await getPenaltiesForSubsessions(supabaseEnv, currentSeason.subsessionIds);
  const driverPenalties = seasonPenalties.filter((p) => p.driver_id === driverId);
  const state = computeSeasonPPState(driver, driverPenalties, events);

  await updateDriver(supabaseEnv, Astro.locals.session!.accessToken, driverId, {
    penalty_points: state.penalty_points,
    on_probation: state.on_probation,
    probation_started_at: state.probation_started_at,
  });
}

/** Blank-means-null/0 form field readers, shared by add-penalty/update-penalty below. */
function strOrNullField(form: FormData, name: string) {
  const s = String(form.get(name) ?? '').trim();
  return s.length > 0 ? s : null;
}
function numOrNullField(form: FormData, name: string) {
  const s = String(form.get(name) ?? '').trim();
  return s.length > 0 ? Number(s) : null;
}
function numOrZeroField(form: FormData, name: string) {
  const s = String(form.get(name) ?? '').trim();
  return s.length > 0 ? Number(s) : 0;
}

// Admin-only: flag/unflag this specific round as a non-points exhibition
// (e.g. a pre-season race run inside an otherwise real championship
// season) — a PRG redirect back to this same URL keeps this in line with
// every other admin mutation in the codebase (see admin/champions'
// upload-photo fix for why that matters).
if (isAdmin && Astro.request.method === 'POST' && Number.isFinite(subsessionId)) {
  const form = await Astro.request.formData();
  const intent = String(form.get('intent') ?? '');

  if (intent === 'toggle-exhibition') {
    const nextIsExhibition = String(form.get('next') ?? 'true') === 'true';
    try {
      await setRoundExhibition(supabaseEnv, Astro.locals.session!.accessToken, subsessionId, nextIsExhibition);
    } catch (err) {
      console.error('Failed to update round exhibition flag:', err);
    }
    return Astro.redirect(`${Astro.url.pathname}${Astro.url.search}`, 302);
  }

  if (intent === 'save-race-links') {
    // Empty strings from the form mean "clear this field" (null), not
    // "leave whatever was there" — the form always shows the current
    // values, so a blank field means the admin actually cleared it.
    const strOrNull = (v: FormDataEntryValue | null) => {
      const s = String(v ?? '').trim();
      return s.length > 0 ? s : null;
    };
    const numOrNull = (v: FormDataEntryValue | null) => {
      const s = String(v ?? '').trim();
      return s.length > 0 ? Number(s) : null;
    };
    const raceNumber = Number(form.get('race_number'));
    if (Number.isFinite(raceNumber)) {
      try {
        await upsertRaceLinks(supabaseEnv, Astro.locals.session!.accessToken, {
          subsession_id: subsessionId,
          race_number: raceNumber,
          iracing_subsession_id: numOrNull(form.get('iracing_subsession_id')),
          replay_url: strOrNull(form.get('replay_url')),
          broadcast_url: strOrNull(form.get('broadcast_url')),
          incident_report_url: strOrNull(form.get('incident_report_url')),
        });
      } catch (err) {
        console.error('Failed to save race links:', err);
      }
    }
    return Astro.redirect(`${Astro.url.pathname}${Astro.url.search}`, 302);
  }

  // Log a new steward penalty against one driver in one specific race
  // (rule 66: penalties apply to the race they occurred in). Also
  // recomputes the driver's CURRENT SEASON PP tally/probation state from
  // scratch (rules 57-62) — see recomputeDriverSeasonPP above.
  if (intent === 'add-penalty') {
    const driverId = String(form.get('driver_id') ?? '');
    const raceNumber = Number(form.get('race_number'));
    const offenseIds = form.getAll('offense_ids').map(String).filter(Boolean);
    const involvedDriverIds = form.getAll('involved_driver_ids').map(String).filter(Boolean);

    if (driverId && Number.isFinite(raceNumber)) {
      try {
        await createPenalty(
          supabaseEnv,
          Astro.locals.session!.accessToken,
          {
            subsession_id: subsessionId,
            race_number: raceNumber,
            driver_id: driverId,
            incident_number: strOrNullField(form, 'incident_number'),
            lap: numOrNullField(form, 'lap'),
            description: strOrNullField(form, 'description'),
            time_penalty_seconds: numOrNullField(form, 'time_penalty_seconds'),
            points_penalty: numOrZeroField(form, 'points_penalty'),
            penalty_points: numOrZeroField(form, 'penalty_points'),
            is_warning: form.get('is_warning') === 'on',
            is_appealed: form.get('is_appealed') === 'on',
            appeal_result: strOrNullField(form, 'appeal_result'),
            appeal_time_penalty_seconds: numOrNullField(form, 'appeal_time_penalty_seconds'),
            appeal_points_penalty: numOrZeroField(form, 'appeal_points_penalty'),
            appeal_penalty_points: numOrZeroField(form, 'appeal_penalty_points'),
          },
          offenseIds,
          involvedDriverIds
        );
        await recomputeDriverSeasonPP(driverId);
      } catch (err) {
        console.error('Failed to save penalty:', err);
      }
    }
    return Astro.redirect(`${Astro.url.pathname}${Astro.url.search}`, 302);
  }

  // Edits a penalty's own fields/offense-tags/involved-cars/appeal outcome
  // in place, then recomputes the driver's season PP from scratch — unlike
  // v0.13/v0.14, a PP change here now correctly ripples through (see
  // recomputeDriverSeasonPP above and updatePenalty's doc comment in
  // src/lib/supabase.ts).
  if (intent === 'update-penalty') {
    const penaltyId = String(form.get('penalty_id') ?? '');
    const driverId = String(form.get('driver_id') ?? '');
    const offenseIds = form.getAll('offense_ids').map(String).filter(Boolean);
    const involvedDriverIds = form.getAll('involved_driver_ids').map(String).filter(Boolean);

    if (penaltyId) {
      try {
        await updatePenalty(
          supabaseEnv,
          Astro.locals.session!.accessToken,
          penaltyId,
          {
            incident_number: strOrNullField(form, 'incident_number'),
            lap: numOrNullField(form, 'lap'),
            description: strOrNullField(form, 'description'),
            time_penalty_seconds: numOrNullField(form, 'time_penalty_seconds'),
            points_penalty: numOrZeroField(form, 'points_penalty'),
            penalty_points: numOrZeroField(form, 'penalty_points'),
            is_warning: form.get('is_warning') === 'on',
            is_appealed: form.get('is_appealed') === 'on',
            appeal_result: strOrNullField(form, 'appeal_result'),
            appeal_time_penalty_seconds: numOrNullField(form, 'appeal_time_penalty_seconds'),
            appeal_points_penalty: numOrZeroField(form, 'appeal_points_penalty'),
            appeal_penalty_points: numOrZeroField(form, 'appeal_penalty_points'),
          },
          offenseIds,
          involvedDriverIds
        );
        if (driverId) await recomputeDriverSeasonPP(driverId);
      } catch (err) {
        console.error('Failed to update penalty:', err);
      }
    }
    return Astro.redirect(`${Astro.url.pathname}${Astro.url.search}`, 302);
  }

  if (intent === 'delete-penalty') {
    const penaltyId = String(form.get('penalty_id') ?? '');
    const driverId = String(form.get('driver_id') ?? '');
    if (penaltyId) {
      try {
        await deletePenalty(supabaseEnv, Astro.locals.session!.accessToken, penaltyId);
        if (driverId) await recomputeDriverSeasonPP(driverId);
      } catch (err) {
        console.error('Failed to delete penalty:', err);
      }
    }
    return Astro.redirect(`${Astro.url.pathname}${Astro.url.search}`, 302);
  }
}

let round: Awaited<ReturnType<typeof getRoundBySubsessionId>> = null;
let roundResults: RoundResults = { byClass: new Map(), overall: new Map() };
let classes: Awaited<ReturnType<typeof getDriverClasses>> = [];
let exhibitionRoundIds: Set<number> = new Set();
let raceLinksByRace: Map<number, RaceLinks> = new Map();
let penalties: Penalty[] = [];
let offenses: PenaltyOffense[] = [];
let warningCounts: Map<string, number> = new Map();
let loadError: string | null = null;

if (Number.isFinite(subsessionId)) {
  try {
    [round, roundResults, classes, exhibitionRoundIds, raceLinksByRace, penalties, offenses] = await Promise.all([
      getRoundBySubsessionId(supabaseEnv, subsessionId),
      getRoundResults(supabaseEnv, subsessionId),
      getDriverClasses(supabaseEnv),
      getExhibitionRoundIds(supabaseEnv),
      getRaceLinksForSubsession(supabaseEnv, subsessionId),
      getPenaltiesForSubsession(supabaseEnv, subsessionId),
      getPenaltyOffenses(supabaseEnv),
    ]);
    // Steward-facing only (which driver already has how many warnings
    // logged THIS SEASON — see getCurrentSeasonRounds) — skip the extra
    // queries for public visitors.
    if (isAdmin) {
      const currentSeason = await getCurrentSeasonRounds(supabaseEnv);
      warningCounts = await getWarningCounts(supabaseEnv, currentSeason.subsessionIds);
    }
  } catch (err) {
    console.error('Failed to load round results:', err);
    loadError = err instanceof Error ? err.message : String(err);
  }
}

if (!loadError && !round) {
  return Astro.redirect('/results', 302);
}

// Recalculate positions/points for anywhere a penalty applies (rule 64's
// re-classification, plus each of that driver's own flat points_penalty
// deductions) — see src/lib/penalties.ts for the full engine. A no-op
// (same object back) for a round with no penalties logged.
if (!loadError && penalties.length > 0) {
  roundResults = applyPenaltiesToRoundResults(roundResults, penalties, round?.format ?? null);
}

const penaltiesByRaceDriver = new Map<string, Penalty[]>();
for (const p of penalties) {
  const key = `${p.race_number}:${p.driver_id}`;
  if (!penaltiesByRaceDriver.has(key)) penaltiesByRaceDriver.set(key, []);
  penaltiesByRaceDriver.get(key)!.push(p);
}

const classNameById = new Map(classes.map((c) => [c.id, c.name]));
// Classes ordered Alpha/Gamma/Delta (sort_order) rather than however Map
// iteration happens to return them.
const orderedClassIds = classes.map((c) => c.id).filter((id) => roundResults.byClass.has(id));

// Exhibition either because the round itself is flagged (round_overrides)
// or because the whole season it belongs to isn't a real championship
// season (see isChampionshipSeason).
const isRoundFlaggedExhibition = exhibitionRoundIds.has(subsessionId);
const isSeasonExhibition = round?.season_label ? !isChampionshipSeason(round.season_label) : false;
const isExhibition = isRoundFlaggedExhibition || isSeasonExhibition;

// The displayed "Round N" skips exhibitions entirely (so flagging round 1
// makes round 2 become "Round 1") — needs every round in this round's
// season to compute, not just this one.
let displayRoundNumber: number | null = null;
if (!loadError && round) {
  try {
    const seasonRounds = await getRoundsForSeason(supabaseEnv, round.season_id);
    displayRoundNumber = computeDisplayRoundNumbers(seasonRounds, exhibitionRoundIds).get(subsessionId) ?? null;
  } catch (err) {
    console.error('Failed to compute round number:', err);
  }
}

// The points system is based on overall finishing position, not
// class-relative position, so the overall (cross-class) view is the
// default — the per-class view is still available via ?view=class.
const view = Astro.url.searchParams.get('view') === 'class' ? 'class' : 'overall';
const overallRaceNumbers = [...roundResults.overall.keys()].sort((a, b) => a - b);

Astro.response.headers.set('Cache-Control', 'public, s-maxage=60, stale-while-revalidate=300');
---

<Layout title={round ? round.track_name : 'Race Results'} description="Race-by-race results for this round.">
  <section class="mx-auto max-w-5xl px-6 pb-24 pt-28 sm:pt-36">
    <a href="/results" class="text-sm text-white/50 hover:text-white">&larr; Back to Race Results</a>

    {loadError && (
      <p class="mt-4 rounded-lg border border-brand-pink/30 bg-brand-pink/10 p-4 text-sm text-white/80">
        Couldn't load this round's results right now. If this mentions permission/RLS, race_scores or
        curated_race_results likely still need the public-read policy from
        <code>supabase/migrations/0004_champions.sql</code> — it has to be run manually in the Supabase SQL editor.
        <br /><span class="mt-1 block text-white/50">{loadError}</span>
      </p>
    )}

    {round && (
      <>
        <h1 class="reveal mt-3 font-display text-5xl" style="transition-delay: 40ms">
          {isExhibition ? 'Exhibition — ' : displayRoundNumber !== null ? `Round ${displayRoundNumber} — ` : ''}{round.track_name}
        </h1>
        <p class="reveal mt-3 text-white/60" style="transition-delay: 80ms">
          {formatDate(round.start_time)}
          {round.format && ` · ${round.format === 'endurance' ? 'Endurance' : 'Sprint'}`}
          {round.strength_of_field !== null && ` · SoF ${round.strength_of_field}`}
          {round.num_drivers !== null && ` · ${round.num_drivers} drivers`}
        </p>

        {isExhibition && (
          <p class="reveal mt-2 flex flex-wrap items-center gap-2 text-sm" style="transition-delay: 90ms">
            <span class="rounded-lg bg-brand-pink/15 px-2.5 py-1 text-xs font-semibold uppercase tracking-wide text-brand-pink">
              Exhibition
            </span>
            <span class="text-white/40">
              {isSeasonExhibition ? "Non-points season — excluded from standings & champions." : 'Flagged non-points — excluded from standings & champions.'}
            </span>
          </p>
        )}

        <HistoryTabs active="results" />

        <div class="mt-8 flex gap-2">
          <a
            href={`/results/${subsessionId}?view=overall`}
            class={`rounded-lg px-4 py-1.5 text-sm font-semibold ring-1 ring-white/15 transition ${
              view === 'overall' ? 'bg-white text-brand-ink' : 'text-white/80 hover:bg-white/10'
            }`}
          >
            Overall
          </a>
          <a
            href={`/results/${subsessionId}?view=class`}
            class={`rounded-lg px-4 py-1.5 text-sm font-semibold ring-1 ring-white/15 transition ${
              view === 'class' ? 'bg-white text-brand-ink' : 'text-white/80 hover:bg-white/10'
            }`}
          >
            Per Class
          </a>
        </div>

        {orderedClassIds.length === 0 && <p class="mt-10 text-white/60">No results.</p>}

        {view === 'overall' && orderedClassIds.length > 0 && (
          <>
            {overallRaceNumbers.map((raceNumber) => (
              <ResultsTable
                subsessionId={subsessionId}
                raceNumber={raceNumber}
                rows={roundResults.overall.get(raceNumber)!}
                showClass
                classNameById={classNameById}
                links={raceLinksByRace.get(raceNumber) ?? null}
                isAdmin={isAdmin}
                penalties={penalties}
                offenses={offenses}
                warningCounts={warningCounts}
              />
            ))}
          </>
        )}

        {view === 'class' && orderedClassIds.map((classId) => {
          const byRace = roundResults.byClass.get(classId)!;
          const raceNumbers = [...byRace.keys()].sort((a, b) => a - b);
          return (
            <div class="mt-12">
              <h2 class="font-display text-2xl uppercase tracking-widest text-white/50">{classNameById.get(classId)}</h2>
              {raceNumbers.map((raceNumber) => (
                <ResultsTable
                  subsessionId={subsessionId}
                  raceNumber={raceNumber}
                  rows={byRace.get(raceNumber)!}
                  links={raceLinksByRace.get(raceNumber) ?? null}
                  isAdmin={isAdmin}
                  penalties={penalties}
                  offenses={offenses}
                  warningCounts={warningCounts}
                />
              ))}
            </div>
          );
        })}

        {isAdmin && !isSeasonExhibition && (
          <form method="POST" data-astro-reload class="mt-16 border-t border-white/10 pt-6">
            <input type="hidden" name="intent" value="toggle-exhibition" />
            <input type="hidden" name="next" value={isRoundFlaggedExhibition ? 'false' : 'true'} />
            <button
              type="submit"
              class="rounded-lg bg-white/5 px-3 py-1.5 text-xs font-semibold text-white/70 ring-1 ring-white/10 transition hover:bg-white/10"
            >
              {isRoundFlaggedExhibition ? 'Unflag as exhibition' : 'Flag this round as an exhibition'}
            </button>
          </form>
        )}
      </>
    )}
  </section>
</Layout>
