---
export const prerender = false;

import AdminLayout from '../../../layouts/AdminLayout.astro';
import { resolveSupabaseEnv, getEvents, getAllCircuitLayouts, eventImageUrl } from '../../../lib/supabase';
import { formatEventDate, FORMAT_BADGE_CLASSES, FORMAT_LABELS, CATEGORY_BADGE_CLASSES, CATEGORY_LABELS, usesFormatBadge } from '../../../lib/eventFormatting';

const supabaseEnv = resolveSupabaseEnv(Astro.locals);

let events: Awaited<ReturnType<typeof getEvents>> = [];
let layouts: Awaited<ReturnType<typeof getAllCircuitLayouts>> = [];
let loadError = false;
try {
  [events, layouts] = await Promise.all([getEvents(supabaseEnv), getAllCircuitLayouts(supabaseEnv)]);
} catch (err) {
  console.error('Failed to load events for admin:', err);
  loadError = true;
}
---

<AdminLayout title="Events">
  <div class="reveal flex flex-wrap items-center justify-between gap-3">
    <h1 class="font-display text-4xl">Events</h1>
    <div class="flex items-center gap-2">
      <a href="/admin/import" class="rounded-lg bg-white/5 px-4 py-2.5 text-sm font-semibold text-white/60 ring-1 ring-white/10 transition hover:bg-white/10">
        Import from CSV
      </a>
      <a href="/admin/events/new" class="rounded-lg bg-brand-primary px-5 py-2.5 font-semibold transition hover:brightness-110">
        New Event
      </a>
    </div>
  </div>

  {loadError && (
    <p class="mt-8 rounded-lg border border-brand-pink/30 bg-brand-pink/10 p-4 text-sm text-white/80">
      Couldn't load events.
    </p>
  )}

  {events.length === 0 && !loadError && (
    <p class="reveal mt-8 rounded-xl border border-white/10 p-6 text-sm text-white/60" style="transition-delay: 80ms">
      No results.
    </p>
  )}

  {events.length > 0 && (
    <div class="reveal mt-8 overflow-x-auto rounded-xl border border-white/10" style="transition-delay: 80ms">
      <table class="w-full border-collapse" data-sortable>
        <thead>
          <tr class="border-b border-white/10 text-left text-xs uppercase tracking-wide text-white/40">
            <th class="py-3 pl-6 pr-3 font-medium" data-sort-key="circuit">Event</th>
            <th class="py-3 pr-3 font-medium" data-sort-key="date">Date</th>
            <th class="py-3 pr-3 font-medium" data-sort-key="format">Format</th>
            <th class="py-3 pr-6 font-medium"></th>
          </tr>
        </thead>
        <tbody>
          {events.map((event) => {
            const imageUrl = eventImageUrl(event, event.circuits, layouts);
            return (
            <tr class="border-b border-white/5 text-sm transition hover:bg-white/[0.03]">
              <td class="py-3 pl-6 pr-3" data-col="circuit">
                <div class="flex items-center gap-3">
                  {imageUrl && (
                    <img src={imageUrl} alt="" class="h-8 w-8 flex-none rounded object-contain" />
                  )}
                  <div>
                    <span class="font-semibold">{event.title ?? event.circuits?.name ?? 'TBA'}</span>
                    {event.season_id && event.round_number !== null && (
                      <p class="text-xs text-white/40">
                        {event.seasons?.name ?? 'Season'} — Round {event.round_number}
                      </p>
                    )}
                  </div>
                </div>
              </td>
              <td class="py-3 pr-3 text-white/60" data-col="date" data-sort-value={event.event_date}>
                {formatEventDate(event.event_date)}
              </td>
              <td class="py-3 pr-3" data-col="format" data-sort-value={event.format}>
                <div class="flex flex-wrap items-center gap-1.5">
                  {usesFormatBadge(event.category) ? (
                    <span class={`rounded-lg px-2.5 py-1 text-xs font-semibold uppercase tracking-wide ${FORMAT_BADGE_CLASSES[event.format]}`}>
                      {FORMAT_LABELS[event.format]}
                    </span>
                  ) : (
                    // TEST/HOLIDAY/IRACING events don't use the format field
                    // (see eventFormatting.ts) — same override as
                    // EventDetailCard.astro/UpcomingEventCard.astro.
                    <span class={`rounded-lg px-2.5 py-1 text-xs font-semibold uppercase tracking-wide ${CATEGORY_BADGE_CLASSES[event.category]}`}>
                      {CATEGORY_LABELS[event.category]}
                    </span>
                  )}
                  {event.category !== 'championship' && usesFormatBadge(event.category) && (
                    <span class={`rounded-lg px-2.5 py-1 text-xs font-semibold uppercase tracking-wide ${CATEGORY_BADGE_CLASSES[event.category]}`}>
                      {CATEGORY_LABELS[event.category]}
                    </span>
                  )}
                </div>
              </td>
              <td class="py-3 pr-6 text-right">
                <a href={`/admin/events/${event.id}`} class="text-sm font-semibold text-brand-primary hover:underline">Edit</a>
              </td>
            </tr>
            );
          })}
        </tbody>
      </table>
    </div>
  )}
</AdminLayout>
