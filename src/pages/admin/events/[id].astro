---
export const prerender = false;

import AdminLayout from '../../../layouts/AdminLayout.astro';
import EventSessionFields from '../../../components/EventSessionFields.astro';
import {
  resolveSupabaseEnv,
  getEventById,
  createEvent,
  updateEvent,
  deleteEvent,
  getCircuits,
  getCircuitById,
  getAllCircuitLayouts,
  displayLayoutName,
  getSeasons,
  formatDate,
  type EventRecord,
  type EventFormat,
  type EventCategory,
  type Weather,
} from '../../../lib/supabase';
import { getEventRound } from '../../../lib/results';
import { logActivity, actorNameFor } from '../../../lib/activityLog';

const supabaseEnv = resolveSupabaseEnv(Astro.locals);
const accessToken = Astro.locals.session!.accessToken;
const actor = { id: Astro.locals.session!.user.id, name: actorNameFor(Astro.locals.session!) };
const { id } = Astro.params;
const isNew = id === 'new';

let error: string | null = null;

function str(form: FormData, name: string): string {
  return String(form.get(name) ?? '').trim();
}
function optStr(form: FormData, name: string): string | null {
  const v = str(form, name);
  return v || null;
}
function optInt(form: FormData, name: string): number | null {
  const v = str(form, name);
  return v ? Number(v) : null;
}
const WEATHER_VALUES: Weather[] = ['clear', 'partly_cloudy', 'overcast', 'raining', 'mixed'];
function optWeather(form: FormData, name: string): Weather | null {
  const v = str(form, name);
  return (WEATHER_VALUES as string[]).includes(v) ? (v as Weather) : null;
}
function optCategory(form: FormData, name: string): EventCategory {
  const v = str(form, name);
  return v === 'test' || v === 'exhibition' ? v : 'championship';
}

function readForm(form: FormData): Partial<EventRecord> {
  const category = optCategory(form, 'category');
  // TEST/EXHIBITION are season-agnostic (per Logan) — even if stale
  // season/round values are sitting in the submitted form (e.g. the admin
  // switched category after picking a season), don't persist them. A
  // championship event keeps whatever season/round the form submitted,
  // including both-blank (allowed — see events_season_round_paired; a
  // championship event can be scheduled before its season/round is known).
  const seasonId = category === 'championship' ? optStr(form, 'season_id') : null;
  const roundNumber = category === 'championship' ? optInt(form, 'round_number') : null;
  return {
    circuit_id: str(form, 'circuit_id'),
    layout: optStr(form, 'layout'),
    event_date: str(form, 'event_date'),
    format: (str(form, 'format') || 'sprint') as EventFormat,
    fuel_limit_pct: optInt(form, 'fuel_limit_pct'),
    results_url: optStr(form, 'results_url'),
    category,
    season_id: seasonId,
    round_number: roundNumber,
    subsession_id: optInt(form, 'subsession_id'),

    practice_start_time: optStr(form, 'practice_start_time'),
    practice_sim_time: optStr(form, 'practice_sim_time'),
    practice_minutes: optInt(form, 'practice_minutes'),
    practice_weather: optWeather(form, 'practice_weather'),

    qualifying_start_time: optStr(form, 'qualifying_start_time'),
    qualifying_sim_time: optStr(form, 'qualifying_sim_time'),
    qualifying_minutes: optInt(form, 'qualifying_minutes'),
    qualifying_laps: optInt(form, 'qualifying_laps'),
    qualifying_weather: optWeather(form, 'qualifying_weather'),

    // Test Session events don't require any races to be saved
    // (0054_test_session_no_race_required.sql) — every other category still
    // requires race1_start_time, enforced below in the validation check.
    race1_start_time: category === 'test' ? optStr(form, 'race1_start_time') : str(form, 'race1_start_time'),
    race1_sim_time: optStr(form, 'race1_sim_time'),
    race1_laps: optInt(form, 'race1_laps'),
    race1_weather: optWeather(form, 'race1_weather'),

    race2_start_time: optStr(form, 'race2_start_time'),
    race2_sim_time: optStr(form, 'race2_sim_time'),
    race2_laps: optInt(form, 'race2_laps'),
    race2_weather: optWeather(form, 'race2_weather'),

    race3_start_time: optStr(form, 'race3_start_time'),
    race3_sim_time: optStr(form, 'race3_sim_time'),
    race3_laps: optInt(form, 'race3_laps'),
    race3_weather: optWeather(form, 'race3_weather'),
  };
}

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const intent = String(form.get('intent') ?? 'save');

  if (intent === 'delete' && !isNew && id) {
    try {
      // event (below) isn't loaded yet at this point — fetch fresh for the
      // log entry's label.
      const deletedEvent = await getEventById(supabaseEnv, id);
      const deletedCircuit = deletedEvent ? await getCircuitById(supabaseEnv, deletedEvent.circuit_id) : null;
      await deleteEvent(supabaseEnv, accessToken, id);
      await logActivity(supabaseEnv, accessToken, actor, {
        action: 'delete',
        entity_type: 'event',
        entity_label: deletedCircuit ? `${deletedCircuit.name} — ${deletedEvent?.event_date}` : deletedEvent?.event_date,
        entity_id: id,
      });
      return Astro.redirect('/admin/events', 302);
    } catch (err) {
      console.error('Failed to delete event:', err);
      error = 'Failed to delete this event.';
    }
  } else {
    const data = readForm(form);
    if (!data.circuit_id || !data.event_date || (data.category !== 'test' && !data.race1_start_time)) {
      error = 'Circuit, event date, and Race 1 start time are required.';
    } else if ((data.season_id === null) !== (data.round_number === null)) {
      error = 'Season and round number must be set together (or both left blank).';
    } else {
      try {
        const circuitForLog = await getCircuitById(supabaseEnv, data.circuit_id);
        const eventLabel = circuitForLog ? `${circuitForLog.name} — ${data.event_date}` : data.event_date;
        if (isNew) {
          const created = await createEvent(supabaseEnv, accessToken, data);
          await logActivity(supabaseEnv, accessToken, actor, {
            action: 'add',
            entity_type: 'event',
            entity_label: eventLabel,
            entity_id: created.id,
          });
          return Astro.redirect(`/admin/events/${created.id}`, 302);
        } else if (id) {
          await updateEvent(supabaseEnv, accessToken, id, data);
          await logActivity(supabaseEnv, accessToken, actor, {
            action: 'edit',
            entity_type: 'event',
            entity_label: eventLabel,
            entity_id: id,
          });
        }
      } catch (err) {
        console.error('Failed to save event:', err);
        error = err instanceof Error ? err.message : 'Failed to save changes.';
      }
    }
  }
}

const [circuits, layouts, seasons] = await Promise.all([getCircuits(supabaseEnv), getAllCircuitLayouts(supabaseEnv), getSeasons(supabaseEnv)]);

let event: EventRecord | null = null;
if (!isNew && id) {
  event = await getEventById(supabaseEnv, id);
  if (!event) return Astro.redirect('/admin/events', 302);
}

// Only meaningful once results actually exist for whatever round this event
// represents (see getEventRound's own doc comment) — null for every
// upcoming event, and for a past one nothing's been imported/matched to
// yet. Shown as a "View Results" link below the form when resolved.
const linkedRound = event ? await getEventRound(supabaseEnv, event) : null;

const d: Partial<EventRecord> = event ?? {
  circuit_id: circuits[0]?.id ?? '',
  layout: '',
  event_date: '',
  format: 'sprint',
  fuel_limit_pct: null,
  results_url: '',
  category: 'championship',
  season_id: null,
  round_number: null,
  subsession_id: null,
  practice_start_time: null,
  practice_sim_time: null,
  practice_minutes: null,
  practice_weather: null,
  qualifying_start_time: null,
  qualifying_sim_time: null,
  qualifying_minutes: null,
  qualifying_laps: null,
  qualifying_weather: null,
  race1_start_time: '',
  race1_sim_time: null,
  race1_laps: null,
  race1_weather: null,
  race2_start_time: null,
  race2_sim_time: null,
  race2_laps: null,
  race2_weather: null,
  race3_start_time: null,
  race3_sim_time: null,
  race3_laps: null,
  race3_weather: null,
};

---

<AdminLayout title={isNew ? 'New Event' : 'Edit Event'}>
  <h1 class="reveal font-display text-4xl">{isNew ? 'New Event' : 'Edit Event'}</h1>

  {error && (
    <p class="reveal mt-6 rounded-lg border border-brand-pink/30 bg-brand-pink/10 p-4 text-sm text-white/80">{error}</p>
  )}

  {circuits.length === 0 && (
    <p class="reveal mt-6 rounded-lg border border-brand-tertiary/30 bg-brand-tertiary/10 p-4 text-sm text-white/80">
      No results.
    </p>
  )}

  <form method="POST" data-astro-reload class="reveal mt-8 flex max-w-3xl flex-col gap-6" style="transition-delay: 80ms">
    <div class="grid gap-4 sm:grid-cols-2">
      <label class="flex flex-col gap-1.5 text-sm">
        <span class="text-white/70">Circuit</span>
        <select
          id="circuit_id"
          name="circuit_id"
          required
          class="rounded-md border border-white/15 bg-white/5 px-3 py-2 text-white outline-none focus:border-brand-primary"
        >
          {circuits.map((c) => (
            <option value={c.id} selected={c.id === d.circuit_id} class="bg-brand-ink text-white">{c.name}</option>
          ))}
        </select>
      </label>
      <label class="flex flex-col gap-1.5 text-sm">
        <span class="text-white/70">Layout</span>
        <select
          id="layout"
          name="layout"
          class="rounded-md border border-white/15 bg-white/5 px-3 py-2 text-white outline-none focus:border-brand-primary"
        >
          <option value="" selected={!d.layout} class="bg-brand-ink text-white">Not set</option>
          {/*
            selected is scoped by circuit_id too, not just name — layout
            names are NOT unique across circuits ("Grand Prix" alone appears
            on 23 different circuits, "Full Course" on 7). events.layout is
            plain text (no FK to circuit_layouts), so matching by name only
            meant EVERY same-named option across EVERY circuit got the
            `selected` HTML attribute at once; the browser then picks
            whichever one is last in DOM order as the actually-selected
            option (almost never this event's own circuit), and
            initLayoutFilter() below — seeing that "selected" option doesn't
            belong to the current circuit — reset the whole dropdown back to
            "Not set". This is what made assigning a layout look like it
            silently failed on save.
          */}
          {layouts.map((l) => (
            <option
              value={l.name}
              selected={l.name === d.layout && l.circuit_id === d.circuit_id}
              data-circuit-id={l.circuit_id}
              class="bg-brand-ink text-white"
            >
              {displayLayoutName(l.name)}
            </option>
          ))}
        </select>
        <span class="text-xs text-white/40">Only shows layouts on file for the selected circuit — add more in Admin &rarr; Circuits.</span>
      </label>
      <label class="flex flex-col gap-1.5 text-sm">
        <span class="text-white/70">Event date</span>
        <input
          type="date"
          name="event_date"
          required
          value={d.event_date ?? ''}
          class="rounded-md border border-white/15 bg-white/5 px-3 py-2 text-white outline-none focus:border-brand-primary"
        />
      </label>
      <label id="format-field" class="flex flex-col gap-1.5 text-sm">
        <span class="text-white/70">Format</span>
        <select
          name="format"
          class="rounded-md border border-white/15 bg-white/5 px-3 py-2 text-white outline-none focus:border-brand-primary"
        >
          <option value="sprint" selected={d.format === 'sprint'} class="bg-brand-ink text-white">Sprint</option>
          <option value="endurance" selected={d.format === 'endurance'} class="bg-brand-ink text-white">Endurance</option>
          <option value="special" selected={d.format === 'special'} class="bg-brand-ink text-white">Special</option>
        </select>
      </label>
      <label class="flex flex-col gap-1.5 text-sm">
        <span class="text-white/70">Category</span>
        <select
          id="category"
          name="category"
          class="rounded-md border border-white/15 bg-white/5 px-3 py-2 text-white outline-none focus:border-brand-primary"
        >
          <option value="championship" selected={d.category === 'championship'} class="bg-brand-ink text-white">Championship</option>
          <option value="test" selected={d.category === 'test'} class="bg-brand-ink text-white">Test Session</option>
          <option value="exhibition" selected={d.category === 'exhibition'} class="bg-brand-ink text-white">Exhibition</option>
        </select>
        <span class="text-xs text-white/40">Test and Exhibition are season-agnostic — no season/round below.</span>
      </label>
      <div id="season-round-fields" class="contents">
        <label class="flex flex-col gap-1.5 text-sm">
          <span class="text-white/70">Season</span>
          <select
            name="season_id"
            class="rounded-md border border-white/15 bg-white/5 px-3 py-2 text-white outline-none focus:border-brand-primary"
          >
            <option value="" selected={!d.season_id} class="bg-brand-ink text-white">Not set yet</option>
            {seasons.map((s) => (
              <option value={s.id} selected={s.id === d.season_id} class="bg-brand-ink text-white">{s.name}</option>
            ))}
          </select>
        </label>
        <label class="flex flex-col gap-1.5 text-sm">
          <span class="text-white/70">Round number</span>
          <input
            type="number"
            min="1"
            name="round_number"
            value={d.round_number ?? ''}
            placeholder="e.g. 4"
            class="rounded-md border border-white/15 bg-white/5 px-3 py-2 text-white outline-none focus:border-brand-primary"
          />
          <span class="text-xs text-white/40">Must be set together with Season — this is what lets results uploaded later auto-link back to this event.</span>
        </label>
      </div>
      <label class="flex flex-col gap-1.5 text-sm">
        <span class="text-white/70">Round override (subsession id)</span>
        <input
          type="number"
          name="subsession_id"
          value={d.subsession_id ?? ''}
          placeholder="Usually leave blank"
          class="rounded-md border border-white/15 bg-white/5 px-3 py-2 text-white outline-none focus:border-brand-primary"
        />
        <span class="text-xs text-white/40">
          Only needed to manually point a Test/Exhibition event at a round already on Race Results (Season/Round auto-matching doesn't apply to those) — leave blank otherwise.
        </span>
      </label>
      {linkedRound && (
        <p class="text-sm text-white/60 sm:col-span-2">
          Linked round: <a href={`/results/${linkedRound.subsession_id}`} class="font-semibold text-brand-primary hover:underline">{linkedRound.track_name} — {formatDate(linkedRound.start_time)}</a>
        </p>
      )}
      <label class="flex flex-col gap-1.5 text-sm">
        <span class="text-white/70">Fuel limit (%)</span>
        <input
          type="number"
          min="0"
          name="fuel_limit_pct"
          value={d.fuel_limit_pct ?? ''}
          class="rounded-md border border-white/15 bg-white/5 px-3 py-2 text-white outline-none focus:border-brand-primary"
        />
      </label>
      <label class="flex flex-col gap-1.5 text-sm">
        <span class="text-white/70">iRacing results URL</span>
        <input
          type="text"
          name="results_url"
          value={d.results_url ?? ''}
          placeholder="https://members.iracing.com/..."
          class="rounded-md border border-white/15 bg-white/5 px-3 py-2 text-white outline-none focus:border-brand-primary"
        />
      </label>
    </div>

    <div class="flex flex-col gap-4">
      <EventSessionFields
        prefix="practice"
        label="Practice"
        showMinutes
        startTime={d.practice_start_time ?? null}
        simTime={d.practice_sim_time ?? null}
        minutes={d.practice_minutes ?? null}
        weather={d.practice_weather ?? null}
      />
      <EventSessionFields
        prefix="qualifying"
        label="Qualifying"
        showMinutes
        showLaps
        startTime={d.qualifying_start_time ?? null}
        simTime={d.qualifying_sim_time ?? null}
        minutes={d.qualifying_minutes ?? null}
        laps={d.qualifying_laps ?? null}
        weather={d.qualifying_weather ?? null}
      />
      <EventSessionFields
        prefix="race1"
        label="Race 1"
        showLaps
        required
        startTime={d.race1_start_time ?? null}
        simTime={d.race1_sim_time ?? null}
        laps={d.race1_laps ?? null}
        weather={d.race1_weather ?? null}
      />
      <EventSessionFields
        prefix="race2"
        label="Race 2 (optional)"
        showLaps
        startTime={d.race2_start_time ?? null}
        simTime={d.race2_sim_time ?? null}
        laps={d.race2_laps ?? null}
        weather={d.race2_weather ?? null}
      />
      <EventSessionFields
        prefix="race3"
        label="Race 3 (optional)"
        showLaps
        startTime={d.race3_start_time ?? null}
        simTime={d.race3_sim_time ?? null}
        laps={d.race3_laps ?? null}
        weather={d.race3_weather ?? null}
      />
    </div>

    <div class="flex gap-3">
      <button
        type="submit"
        name="intent"
        value="save"
        class="rounded-lg bg-brand-primary px-6 py-3 font-semibold transition hover:brightness-110"
      >
        {isNew ? 'Create Event' : 'Save Changes'}
      </button>
      <a href="/admin/events" class="rounded-lg bg-white/5 px-6 py-3 font-semibold ring-1 ring-white/10 transition hover:bg-white/10">
        Cancel
      </a>
    </div>
  </form>

  {!isNew && (
    <form method="POST" data-astro-reload class="reveal mt-6 max-w-3xl border-t border-white/10 pt-6" style="transition-delay: 100ms">
      <input type="hidden" name="intent" value="delete" />
      <button
        type="submit"
        data-confirm="Delete this event? This can't be undone."
        class="rounded-lg bg-brand-pink/10 px-5 py-2.5 text-sm font-semibold text-brand-pink ring-1 ring-brand-pink/30 transition hover:bg-brand-pink/20"
      >
        Delete Event
      </button>
    </form>
  )}
</AdminLayout>

<script>
  // Layout <select> shows every circuit_layouts row up front (each <option>
  // tagged data-circuit-id), then this filters which are actually visible
  // to just the currently-chosen Circuit — re-run on Circuit change so
  // switching circuits can't leave a mismatched layout selected. The blank
  // "Not set" option (no data-circuit-id) always stays visible.
  function initLayoutFilter() {
    const circuitSelect = document.getElementById('circuit_id') as HTMLSelectElement | null;
    const layoutSelect = document.getElementById('layout') as HTMLSelectElement | null;
    if (!circuitSelect || !layoutSelect) return;

    function applyFilter() {
      const circuitId = circuitSelect!.value;
      let selectedStillVisible = false;
      Array.from(layoutSelect!.options).forEach((opt) => {
        if (!opt.dataset.circuitId) return; // the blank "Not set" option
        const matches = opt.dataset.circuitId === circuitId;
        opt.hidden = !matches;
        opt.disabled = !matches;
        if (matches && opt.selected) selectedStillVisible = true;
      });
      if (!selectedStillVisible && layoutSelect!.value !== '') {
        layoutSelect!.value = '';
      }
    }

    circuitSelect.addEventListener('change', applyFilter);
    applyFilter();
  }

  // Test/Exhibition are season-agnostic (per Logan) — hides the
  // Season/Round inputs rather than removing them from the DOM, since
  // readForm() server-side already ignores season_id/round_number for
  // those two categories regardless of what's submitted (see its own
  // comment) — this is purely about not showing fields that won't be used.
  //
  // Test Session additionally hides the Format field entirely (not used —
  // see CATEGORY_LABELS/CATEGORY_BADGE_CLASSES in eventFormatting.ts, the
  // format badge shows a literal "Test Session" override on cards instead)
  // and drops `required` off Race 1's start time input, since Test Session
  // events can now be saved with zero races
  // (0054_test_session_no_race_required.sql) — mirrored here so the browser
  // doesn't block submission on a field the server no longer requires
  // either (see readForm()'s race1_start_time handling above).
  function initCategoryFields() {
    const categorySelect = document.getElementById('category') as HTMLSelectElement | null;
    const seasonRoundFields = document.getElementById('season-round-fields');
    const formatField = document.getElementById('format-field');
    const race1StartTime = document.querySelector<HTMLInputElement>('input[name="race1_start_time"]');
    if (!categorySelect || !seasonRoundFields) return;

    function applyVisibility() {
      // Toggling inline `display` directly rather than Tailwind's `hidden`
      // class — this element already carries `contents` (so its two child
      // labels lay out as direct grid items, not nested inside a block
      // wrapper) and `display: none` needs to win outright when hiding, not
      // fight `display: contents` over class-order specificity.
      seasonRoundFields!.style.display = categorySelect!.value === 'championship' ? '' : 'none';

      const isTest = categorySelect!.value === 'test';
      if (formatField) formatField.style.display = isTest ? 'none' : '';
      if (race1StartTime) race1StartTime.required = !isTest;
    }

    categorySelect.addEventListener('change', applyVisibility);
    applyVisibility();
  }

  document.addEventListener('astro:page-load', () => {
    document.querySelectorAll<HTMLButtonElement>('[data-confirm]').forEach((btn) => {
      btn.addEventListener('click', (e) => {
        if (!confirm(btn.dataset.confirm || 'Are you sure?')) e.preventDefault();
      });
    });
    initLayoutFilter();
    initCategoryFields();
  });
</script>
