---
export const prerender = false;

// Manages news_tags (0055), the free labels on posts via news_post_tags; not the display-only "RESULTS" tag.
// A small add/delete list without logActivity, like the Media page's lists.

import AdminLayout from '../../../../layouts/AdminLayout.astro';
import { resolveSupabaseEnv } from '../../../../lib/db/client';
import { getAllNewsTags, createNewsTag, deleteNewsTag } from '../../../../lib/db/news';
import { requireAdmin } from '../../../../lib/auth';

const admin = requireAdmin(Astro);
if (admin instanceof Response) return admin;

const supabaseEnv = resolveSupabaseEnv(Astro.locals);
const accessToken = admin.accessToken;

let error: string | null = null;

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const intent = String(form.get('intent') ?? '');

  try {
    if (intent === 'add-tag') {
      const name = String(form.get('name') ?? '').trim();
      if (!name) {
        error = 'A tag name is required.';
      } else {
        await createNewsTag(supabaseEnv, accessToken, name);
        return Astro.redirect('/admin/news/tags', 302);
      }
    } else if (intent === 'delete-tag') {
      const id = String(form.get('id') ?? '');
      if (id) await deleteNewsTag(supabaseEnv, accessToken, id);
      return Astro.redirect('/admin/news/tags', 302);
    }
  } catch (err) {
    console.error('Failed to save news tags:', err);
    error = err instanceof Error ? err.message : 'Failed to save changes.';
  }
}

let tags: Awaited<ReturnType<typeof getAllNewsTags>> = [];
let loadError = false;
try {
  tags = await getAllNewsTags(supabaseEnv);
} catch (err) {
  console.error('Failed to load news tags for admin:', err);
  loadError = true;
}
---

<AdminLayout title="News Tags">
  <div class="reveal flex items-center justify-between gap-3">
    <h1 class="font-display text-4xl">News Tags</h1>
    <a href="/admin/news" class="text-sm text-white/50 hover:text-white">&larr; Back to News</a>
  </div>
  <p class="reveal mt-2 text-sm text-white/60" style="transition-delay: 40ms">
    Tags posts can be labeled with, selectable when creating or editing a post. Deleting a tag here removes it from
    every post it was assigned to.
  </p>

  {loadError && (
    <p class="mt-8 rounded-lg border border-brand-pink/30 bg-brand-pink/10 p-4 text-sm text-white/80">Couldn't load news tags.</p>
  )}

  {error && (
    <p class="reveal mt-6 rounded-lg border border-brand-pink/30 bg-brand-pink/10 p-4 text-sm text-white/80">{error}</p>
  )}

  {!loadError && (
    <>
      <ul class="reveal mt-8 flex max-w-md flex-col gap-2" style="transition-delay: 60ms">
        {tags.length === 0 && <li class="text-sm text-white/40">No tags yet.</li>}
        {tags.map((tag) => (
          <li class="flex items-center justify-between gap-3 rounded-lg bg-brand-ink p-3 text-sm ring-1 ring-white/10">
            <span class="font-semibold">{tag.name}</span>
            <form method="POST" data-astro-reload>
              <input type="hidden" name="intent" value="delete-tag" />
              <input type="hidden" name="id" value={tag.id} />
              <button type="submit" class="text-xs font-semibold text-white/40 transition hover:text-brand-pink">Remove</button>
            </form>
          </li>
        ))}
      </ul>

      <form method="POST" data-astro-reload class="reveal mt-6 flex max-w-md items-end gap-2" style="transition-delay: 80ms">
        <input type="hidden" name="intent" value="add-tag" />
        <label class="flex flex-1 flex-col gap-1.5 text-sm">
          <span class="text-white/60">New tag</span>
          <input
            type="text"
            name="name"
            required
            placeholder="e.g. Announcement"
            class="rounded-md border border-white/15 bg-white/5 px-3 py-2 text-white outline-none focus:border-brand-primary"
          />
        </label>
        <button type="submit" class="btn btn-primary">
          Add Tag
        </button>
      </form>
    </>
  )}
</AdminLayout>
