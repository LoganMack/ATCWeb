---
export const prerender = false;

import { safeJson } from '../../../../lib/security';
import AdminLayout from '../../../../layouts/AdminLayout.astro';
import { resolveSupabaseEnv } from '../../../../lib/db/client';
import {
  getNewsPostByIdAdmin,
  updateNewsPost,
  deleteNewsPost,
  getAllNewsTags,
  getTagIdsForPost,
  setPostTags,
  setPostDrivers,
  extractMentionedDriverIds,
} from '../../../../lib/db/news';
import { uploadToStorage } from '../../../../lib/db/assets';
import { displayDriverName } from '../../../../lib/db/circuits';
import { getDriversBasic } from '../../../../lib/db/drivers';
import { getAllRounds } from '../../../../lib/results/rounds';
import { groupRoundsBySeason, roundOptionLabel } from '../../../../lib/roundLabels';
import { logActivity, actorNameFor } from '../../../../lib/activityLog';
import { requireAdmin } from '../../../../lib/auth';

const admin = requireAdmin(Astro);
if (admin instanceof Response) return admin;

const supabaseEnv = resolveSupabaseEnv(Astro.locals);
const accessToken = admin.accessToken;
const actor = { id: admin.user.id, name: actorNameFor(admin) };
const { id } = Astro.params;

if (!id) return Astro.redirect('/admin/news', 302);

let error: string | null = null;

function extFromFile(file: File): string {
  const fromName = file.name.split('.').pop();
  if (fromName && fromName.length <= 5) return fromName.toLowerCase();
  const map: Record<string, string> = {
    'image/png': 'png',
    'image/jpeg': 'jpg',
    'image/webp': 'webp',
    'image/svg+xml': 'svg',
  };
  return map[file.type] ?? 'png';
}

// Fetched up front so the form below can pre-fill every field (including
// falling back to the post's existing published_at/cover_image_url when
// the admin doesn't touch those fields on save).
let post = await getNewsPostByIdAdmin(supabaseEnv, accessToken, id);
if (!post) return Astro.redirect('/admin/news', 302);

// Every round of every season for the picker (as in new.astro), loaded before the POST for the season_label.
let allRounds: Awaited<ReturnType<typeof getAllRounds>> = [];
try {
  allRounds = await getAllRounds(supabaseEnv);
} catch (err) {
  console.error('Failed to load rounds for the news editor:', err);
}
const roundGroups = groupRoundsBySeason(allRounds);

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const intent = String(form.get('intent') ?? 'save');

  if (intent === 'delete') {
    try {
      await deleteNewsPost(supabaseEnv, accessToken, id);
      await logActivity(supabaseEnv, accessToken, actor, {
        action: 'delete',
        entity_type: 'news',
        entity_label: post.title,
        entity_id: id,
      });
      return Astro.redirect('/admin/news', 302);
    } catch (err) {
      console.error('Failed to delete news post:', err);
      error = 'Failed to delete the post.';
    }
  } else {
    const title = String(form.get('title') ?? '').trim();
    const slug = String(form.get('slug') ?? '').trim();
    const excerpt = String(form.get('excerpt') ?? '').trim();
    const body = String(form.get('body') ?? '').trim();
    // Author isn't editable (Logan): editing never reassigns authorship, so author_name is left out of the
    // PATCH.
    const coverFile = form.get('cover_image');
    const removeCoverImage = form.get('remove_cover_image') === 'on';
    const status = form.get('status') === 'published' ? 'published' : 'draft';
    const roundRaw = String(form.get('round_subsession_id') ?? '').trim();
    const round_subsession_id = roundRaw ? Number(roundRaw) : null;
    // The season tag comes from the linked round (Logan); no round, no tag.
    const season_label = round_subsession_id !== null ? (allRounds.find((r) => r.subsession_id === round_subsession_id)?.season_label ?? null) : null;
    // Noon UTC as in new.astro. Prefilled from published_at, so leaving it is a no-op and changing it
    // backdates the post.
    const publishedDateRaw = String(form.get('published_date') ?? '').trim();
    const published_at = publishedDateRaw ? `${publishedDateRaw}T12:00:00.000Z` : post.published_at;

    if (!title || !slug || !body) {
      error = 'Title, slug, and body are required.';
    } else {
      try {
        // A new upload wins; otherwise the checkbox clears the image; otherwise it stays.
        let cover_image_url: string | null | undefined = undefined;
        if (coverFile instanceof File && coverFile.size > 0) {
          const path = `news-${slug}-${Date.now()}.${extFromFile(coverFile)}`;
          cover_image_url = await uploadToStorage(supabaseEnv, accessToken, 'photos', path, coverFile);
        } else if (removeCoverImage) {
          cover_image_url = null;
        }

        await updateNewsPost(supabaseEnv, accessToken, id, {
          title,
          slug,
          excerpt: excerpt || null,
          body,
          ...(cover_image_url !== undefined ? { cover_image_url } : {}),
          status,
          season_label,
          round_subsession_id: round_subsession_id !== null && Number.isFinite(round_subsession_id) ? round_subsession_id : null,
          published_at,
        });
        await setPostTags(supabaseEnv, accessToken, id, form.getAll('tag_ids').map(String));
        // Tagged drivers follow the body's @-mentions (extractMentionedDriverIds in src/lib/db/news.ts), so
        // removing a mention un-tags the driver.
        await setPostDrivers(supabaseEnv, accessToken, id, extractMentionedDriverIds(body));
        await logActivity(supabaseEnv, accessToken, actor, {
          action: 'edit',
          entity_type: 'news',
          entity_label: title,
          entity_id: id,
        });
        post = await getNewsPostByIdAdmin(supabaseEnv, accessToken, id);
        if (!post) return Astro.redirect('/admin/news', 302);
      } catch (err) {
        console.error('Failed to update news post:', err);
        error = err instanceof Error ? err.message : 'Failed to save changes.';
      }
    }
  }
}

let allTags: Awaited<ReturnType<typeof getAllNewsTags>> = [];
let selectedTagIds: string[] = [];
try {
  [allTags, selectedTagIds] = await Promise.all([getAllNewsTags(supabaseEnv), getTagIdsForPost(supabaseEnv, id)]);
} catch (err) {
  console.error('Failed to load news tags for the news editor:', err);
}

let allDrivers: Awaited<ReturnType<typeof getDriversBasic>> = [];
try {
  allDrivers = await getDriversBasic(supabaseEnv);
} catch (err) {
  console.error('Failed to load drivers for the news editor:', err);
}
// Dataset for the Body field's @-mention autocomplete — see new.astro's
// matching comment.
const mentionDriversJson = JSON.stringify(
  allDrivers.map((d) => ({ id: d.id, label: displayDriverName(d.name) + (d.car_number !== null ? ` #${d.car_number}` : '') }))
).replace(/</g, '\\u003c');
---

<AdminLayout title="Edit Post">
  <div class="reveal flex items-center justify-between">
    <h1 class="font-display text-4xl">Edit Post</h1>
    <a href={`/news/${post.slug}`} target="_blank" class="text-sm text-white/50 hover:text-white">View on site &rarr;</a>
  </div>

  {error && (
    <p class="reveal mt-6 rounded-lg border border-brand-pink/30 bg-brand-pink/10 p-4 text-sm text-white/80">{error}</p>
  )}

  <form method="POST" data-astro-reload enctype="multipart/form-data" class="reveal mt-8 flex max-w-2xl flex-col gap-4" style="transition-delay: 80ms">
    <label class="flex flex-col gap-1.5 text-sm">
      <span class="text-white/70">Title</span>
      <input
        type="text"
        name="title"
        required
        value={post.title}
        class="rounded-md border border-white/15 bg-white/5 px-3 py-2 text-white outline-none focus:border-brand-primary"
      />
    </label>
    <label class="flex flex-col gap-1.5 text-sm">
      <span class="text-white/70">URL slug</span>
      <input
        type="text"
        name="slug"
        required
        value={post.slug}
        class="rounded-md border border-white/15 bg-white/5 px-3 py-2 text-white outline-none focus:border-brand-primary"
      />
    </label>
    <label class="flex flex-col gap-1.5 text-sm">
      <span class="text-white/70">Excerpt</span>
      <textarea
        name="excerpt"
        rows="2"
        class="rounded-md border border-white/15 bg-white/5 px-3 py-2 text-white outline-none focus:border-brand-primary"
      >{post.excerpt}</textarea>
    </label>
    <div class="relative flex flex-col gap-1.5 text-sm">
      <span class="text-white/70">Body</span>
      <textarea
        name="body"
        id="post-body"
        required
        rows="10"
        class="rounded-md border border-white/15 bg-white/5 px-3 py-2 text-white outline-none focus:border-brand-primary"
      >{post.body}</textarea>
      <!-- Positioned by the wrapping div's `relative` — see the mention-autocomplete script below. -->
      <div id="mention-menu" class="absolute left-0 right-0 top-full z-20 mt-1 hidden max-h-56 overflow-auto rounded-md border border-white/15 bg-brand-ink shadow-lg"></div>
      <span class="text-xs text-white/40">
        Type <span class="font-mono text-white/60">@</span> followed by a driver's name to mention them, then pick a
        match from the list. Mentioned drivers show as links to their profile on the published post, and this post
        shows up in their profile's Related News section.
      </span>
    </div>
    <script type="application/json" id="mention-drivers-data" set:html={safeJson(JSON.parse(mentionDriversJson))} />
    <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
      <div class="flex flex-col gap-1.5 text-sm">
        <span class="text-white/70">Cover image</span>
        {post.cover_image_url && (
          <img src={post.cover_image_url} alt="" class="mb-1 h-24 w-full max-w-xs rounded-lg object-cover ring-1 ring-white/10" />
        )}
        <input
          type="file"
          name="cover_image"
          accept="image/png,image/jpeg,image/webp,image/svg+xml"
          class="rounded-md border border-white/15 bg-white/5 px-3 py-2 text-white outline-none file:mr-3 file:rounded-lg file:border-0 file:bg-white/10 file:px-3 file:py-1.5 file:text-white"
        />
        {post.cover_image_url && (
          <label class="mt-1 flex items-center gap-2 text-xs text-white/50">
            <input type="checkbox" name="remove_cover_image" />
            Remove the current cover image (ignored if you also upload a new file above)
          </label>
        )}
      </div>
      <label class="flex flex-col gap-1.5 text-sm">
        <span class="text-white/70">Published date</span>
        <input
          type="date"
          name="published_date"
          value={post.published_at.slice(0, 10)}
          class="rounded-md border border-white/15 bg-white/5 px-3 py-2 text-white outline-none focus:border-brand-primary"
        />
      </label>
    </div>
    <label class="flex flex-col gap-1.5 text-sm">
      <span class="text-white/70">Linked round (optional)</span>
      <select
        name="round_subsession_id"
        class="rounded-md border border-white/15 bg-white/5 px-3 py-2 text-white outline-none focus:border-brand-primary"
      >
        <option value="" selected={post.round_subsession_id === null} class="bg-brand-ink text-white">
          — No linked round —
        </option>
        {roundGroups.map(({ label: seasonLabel, rounds }) => (
          <optgroup label={seasonLabel} class="bg-brand-ink text-white">
            {rounds.map((r) => (
              <option value={r.subsession_id} selected={post.round_subsession_id === r.subsession_id} class="bg-brand-ink text-white">
                {roundOptionLabel(r)}
              </option>
            ))}
          </optgroup>
        ))}
      </select>
    </label>
    <fieldset class="flex flex-col gap-1.5 text-sm">
      <legend class="text-white/70">Tags</legend>
      {allTags.length === 0 ? (
        <p class="text-xs text-white/40">
          No tags yet. <a href="/admin/news/tags" class="text-brand-primary hover:underline">Create some</a> first.
        </p>
      ) : (
        <div class="flex flex-wrap gap-3">
          {allTags.map((tag) => (
            <label class="flex items-center gap-1.5 rounded-lg bg-brand-ink px-3 py-1.5 ring-1 ring-white/10">
              <input type="checkbox" name="tag_ids" value={tag.id} checked={selectedTagIds.includes(tag.id)} />
              <span>{tag.name}</span>
            </label>
          ))}
        </div>
      )}
    </fieldset>
    <fieldset class="flex flex-col gap-1.5 text-sm">
      <legend class="text-white/70">Status</legend>
      <label class="flex items-center gap-2">
        <input type="radio" name="status" value="draft" checked={post.status === 'draft'} />
        <span>Draft</span>
      </label>
      <label class="flex items-center gap-2">
        <input type="radio" name="status" value="published" checked={post.status === 'published'} />
        <span>Published</span>
      </label>
    </fieldset>

    <div class="mt-2 flex gap-3">
      <button
        type="submit"
        name="intent"
        value="save"
        class="btn btn-primary btn-lg"
      >
        Save Changes
      </button>
      <a href="/admin/news" class="btn btn-neutral btn-lg">
        Cancel
      </a>
    </div>
  </form>

  <form method="POST" data-astro-reload class="reveal mt-6 max-w-2xl border-t border-white/10 pt-6" style="transition-delay: 100ms">
    <input type="hidden" name="intent" value="delete" />
    <button
      type="submit"
      data-confirm="Delete this post? This can't be undone."
      class="btn btn-danger"
    >
      Delete Post
    </button>
  </form>
</AdminLayout>

<script>
  document.addEventListener('astro:page-load', () => {
    document.querySelectorAll<HTMLButtonElement>('[data-confirm]').forEach((btn) => {
      btn.addEventListener('click', (e) => {
        if (!confirm(btn.dataset.confirm || 'Are you sure?')) e.preventDefault();
      });
    });
  });
</script>

<script>
  // @-mention autocomplete, the same as new.astro's, on this page's elements.
  function initMentionAutocomplete() {
    const textarea = document.getElementById('post-body') as HTMLTextAreaElement | null;
    const menu = document.getElementById('mention-menu') as HTMLDivElement | null;
    const dataEl = document.getElementById('mention-drivers-data');
    if (!textarea || !menu || !dataEl) return;
    if (textarea.dataset.mentionInit === 'true') return; // astro:page-load can fire more than once for the same DOM
    textarea.dataset.mentionInit = 'true';

    interface MentionDriver {
      id: string;
      label: string;
    }
    let drivers: MentionDriver[] = [];
    try {
      drivers = JSON.parse(dataEl.textContent || '[]');
    } catch {
      drivers = [];
    }

    let mentionStart = -1; // index of the '@' that opened the in-progress mention, or -1 when none is active
    let highlighted = 0;
    let matches: MentionDriver[] = [];

    function closeMenu() {
      menu!.classList.add('hidden');
      menu!.innerHTML = '';
      mentionStart = -1;
      matches = [];
    }

    function renderMenu() {
      menu!.innerHTML = '';
      matches.forEach((d, i) => {
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.textContent = d.label;
        btn.dataset.index = String(i);
        btn.className = `block w-full truncate px-3 py-1.5 text-left text-sm ${i === highlighted ? 'bg-brand-primary/20 text-white' : 'text-white/70 hover:bg-white/5'}`;
        menu!.appendChild(btn);
      });
      menu!.classList.toggle('hidden', matches.length === 0);
    }

    function insertMention(driver: MentionDriver) {
      if (mentionStart < 0) return;
      const cursor = textarea!.selectionStart;
      const text = textarea!.value;
      const token = `@[${driver.label}](${driver.id}) `;
      textarea!.value = text.slice(0, mentionStart) + token + text.slice(cursor);
      const newCursor = mentionStart + token.length;
      textarea!.setSelectionRange(newCursor, newCursor);
      closeMenu();
      textarea!.focus();
    }

    function updateMenu() {
      const cursor = textarea!.selectionStart;
      const upToCursor = textarea!.value.slice(0, cursor);
      const at = upToCursor.lastIndexOf('@');
      if (at === -1) return closeMenu();
      const query = upToCursor.slice(at + 1);
      // The query can't span whitespace (that means the '@' wasn't the
      // start of the word under the cursor anymore), and the '@' itself
      // must start a word — start of the text, or preceded by whitespace.
      if (/\s/.test(query)) return closeMenu();
      const prevChar = at > 0 ? upToCursor[at - 1] : '';
      if (prevChar && !/\s/.test(prevChar)) return closeMenu();

      const q = query.toLowerCase();
      matches = drivers.filter((d) => d.label.toLowerCase().includes(q)).slice(0, 8);
      if (matches.length === 0) return closeMenu();
      mentionStart = at;
      highlighted = 0;
      renderMenu();
    }

    textarea.addEventListener('input', updateMenu);
    textarea.addEventListener('click', updateMenu);
    textarea.addEventListener('keydown', (e) => {
      if (menu!.classList.contains('hidden')) return;
      if (e.key === 'ArrowDown') {
        e.preventDefault();
        highlighted = Math.min(highlighted + 1, matches.length - 1);
        renderMenu();
      } else if (e.key === 'ArrowUp') {
        e.preventDefault();
        highlighted = Math.max(highlighted - 1, 0);
        renderMenu();
      } else if (e.key === 'Enter' || e.key === 'Tab') {
        if (matches[highlighted]) {
          e.preventDefault();
          insertMention(matches[highlighted]);
        }
      } else if (e.key === 'Escape') {
        closeMenu();
      }
    });
    textarea.addEventListener('blur', () => {
      // Short delay so a click that moves focus elsewhere still lands first (menu clicks don't blur, see the
      // mousedown handler).
      setTimeout(closeMenu, 150);
    });
    menu.addEventListener('mousedown', (e) => {
      // Keep focus and selectionStart on the textarea: insertMention needs the caret from before the click.
      e.preventDefault();
    });
    menu.addEventListener('click', (e) => {
      const btn = (e.target as HTMLElement).closest('button[data-index]') as HTMLButtonElement | null;
      if (!btn) return;
      const i = Number(btn.dataset.index);
      if (matches[i]) insertMention(matches[i]);
    });
  }

  document.addEventListener('astro:page-load', initMentionAutocomplete);
</script>
