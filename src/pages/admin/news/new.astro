---
export const prerender = false;

import AdminLayout from '../../../layouts/AdminLayout.astro';
import { resolveSupabaseEnv, createNewsPost, formatDate } from '../../../lib/supabase';
import { getAllRounds } from '../../../lib/results';
import { slugify } from '../../../lib/slug';

const supabaseEnv = resolveSupabaseEnv(Astro.locals);
const accessToken = Astro.locals.session!.accessToken;
const displayName = Astro.locals.session!.profile?.display_name || Astro.locals.session!.user.email || '';

let error: string | null = null;

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const title = String(form.get('title') ?? '').trim();
  const excerpt = String(form.get('excerpt') ?? '').trim();
  const body = String(form.get('body') ?? '').trim();
  const author_name = String(form.get('author_name') ?? '').trim() || displayName;
  const cover_image_url = String(form.get('cover_image_url') ?? '').trim();
  const status = form.get('status') === 'published' ? 'published' : 'draft';
  const season_label = String(form.get('season_label') ?? '').trim();
  const roundRaw = String(form.get('round_subsession_id') ?? '').trim();
  const round_subsession_id = roundRaw ? Number(roundRaw) : null;
  let slug = String(form.get('slug') ?? '').trim();
  if (!slug) slug = slugify(title);

  if (!title || !body) {
    error = 'Title and body are required.';
  } else if (!slug) {
    error = 'Could not generate a URL slug from that title — set one manually.';
  } else {
    try {
      const post = await createNewsPost(supabaseEnv, accessToken, {
        title,
        slug,
        excerpt: excerpt || null,
        body,
        author_name,
        cover_image_url: cover_image_url || null,
        status,
        season_label: season_label || null,
        round_subsession_id: round_subsession_id !== null && Number.isFinite(round_subsession_id) ? round_subsession_id : null,
        published_at: new Date().toISOString(),
      });
      return Astro.redirect(`/admin/news/${post.id}/edit`, 302);
    } catch (err) {
      console.error('Failed to create news post:', err);
      error = err instanceof Error ? err.message : 'Failed to create the post.';
    }
  }
}

// Grouped by season for the round picker below — every round across every
// season (not just the current one), since a post can reasonably recap a
// round from any point in the site's history.
let allRounds: Awaited<ReturnType<typeof getAllRounds>> = [];
try {
  allRounds = await getAllRounds(supabaseEnv);
} catch (err) {
  console.error('Failed to load rounds for the news editor:', err);
}
const roundsBySeasonLabel = new Map<string, typeof allRounds>();
for (const r of allRounds) {
  const key = r.season_label ?? 'Unlabeled';
  if (!roundsBySeasonLabel.has(key)) roundsBySeasonLabel.set(key, []);
  roundsBySeasonLabel.get(key)!.push(r);
}
// Suggestions for the season-tag field — every distinct season_label
// already in use across all rounds (championship AND non-points/exhibition
// ones alike, since this is derived straight from curated_rounds rather
// than filtered to real "ATCxx" seasons only). Free text, not a strict
// picker — see 0017_news_round_season.sql for why.
const seasonLabelSuggestions = [...new Set(allRounds.map((r) => r.season_label).filter((s): s is string => Boolean(s)))].sort();
---

<AdminLayout title="New Post">
  <h1 class="reveal font-display text-4xl">New Post</h1>

  {error && (
    <p class="reveal mt-6 rounded-lg border border-brand-pink/30 bg-brand-pink/10 p-4 text-sm text-white/80">{error}</p>
  )}

  <form method="POST" data-astro-reload class="reveal mt-8 flex max-w-2xl flex-col gap-4" style="transition-delay: 80ms">
    <label class="flex flex-col gap-1.5 text-sm">
      <span class="text-white/70">Title</span>
      <input
        type="text"
        name="title"
        required
        class="rounded-md border border-white/15 bg-white/5 px-3 py-2 text-white outline-none focus:border-brand-primary"
      />
    </label>
    <label class="flex flex-col gap-1.5 text-sm">
      <span class="text-white/70">URL slug (optional — auto-generated from the title if left blank)</span>
      <input
        type="text"
        name="slug"
        placeholder="e.g. season-18-kicks-off"
        class="rounded-md border border-white/15 bg-white/5 px-3 py-2 text-white outline-none focus:border-brand-primary"
      />
    </label>
    <label class="flex flex-col gap-1.5 text-sm">
      <span class="text-white/70">Excerpt</span>
      <textarea
        name="excerpt"
        rows="2"
        class="rounded-md border border-white/15 bg-white/5 px-3 py-2 text-white outline-none focus:border-brand-primary"
      ></textarea>
    </label>
    <label class="flex flex-col gap-1.5 text-sm">
      <span class="text-white/70">Body</span>
      <textarea
        name="body"
        required
        rows="10"
        class="rounded-md border border-white/15 bg-white/5 px-3 py-2 text-white outline-none focus:border-brand-primary"
      ></textarea>
    </label>
    <label class="flex flex-col gap-1.5 text-sm">
      <span class="text-white/70">Cover image URL</span>
      <input
        type="text"
        name="cover_image_url"
        placeholder="/images/news/your-image.jpg"
        class="rounded-md border border-white/15 bg-white/5 px-3 py-2 text-white outline-none focus:border-brand-primary"
      />
    </label>
    <label class="flex flex-col gap-1.5 text-sm">
      <span class="text-white/70">Author</span>
      <input
        type="text"
        name="author_name"
        value={displayName}
        class="rounded-md border border-white/15 bg-white/5 px-3 py-2 text-white outline-none focus:border-brand-primary"
      />
    </label>
    <label class="flex flex-col gap-1.5 text-sm">
      <span class="text-white/70">Season tag</span>
      <input
        type="text"
        name="season_label"
        list="season-label-suggestions"
        placeholder="e.g. ATC17"
        class="rounded-md border border-white/15 bg-white/5 px-3 py-2 text-white outline-none focus:border-brand-primary"
      />
      <datalist id="season-label-suggestions">
        {seasonLabelSuggestions.map((label) => <option value={label} />)}
      </datalist>
      <span class="text-xs text-white/40">
        Free text, not limited to real championship seasons — tag exhibitions or one-off events however you like.
        Powers the season filter on the public News page.
      </span>
    </label>
    <label class="flex flex-col gap-1.5 text-sm">
      <span class="text-white/70">Linked round (optional)</span>
      <select
        name="round_subsession_id"
        class="rounded-md border border-white/15 bg-white/5 px-3 py-2 text-white outline-none focus:border-brand-primary"
      >
        <option value="" class="bg-brand-ink text-white">— No linked round —</option>
        {[...roundsBySeasonLabel.entries()].map(([seasonLabel, rounds]) => (
          <optgroup label={seasonLabel} class="bg-brand-ink text-white">
            {rounds.map((r) => (
              <option value={r.subsession_id} class="bg-brand-ink text-white">
                {formatDate(r.start_time)} — {r.track_name}
              </option>
            ))}
          </optgroup>
        ))}
      </select>
      <span class="text-xs text-white/40">
        When set, the article shows a link to that round's results at the top and a live race recap (top finishers,
        fastest laps, team points) at the bottom.
      </span>
    </label>
    <fieldset class="flex flex-col gap-1.5 text-sm">
      <legend class="text-white/70">Status</legend>
      <label class="flex items-center gap-2">
        <input type="radio" name="status" value="draft" checked />
        <span>Draft</span>
      </label>
      <label class="flex items-center gap-2">
        <input type="radio" name="status" value="published" />
        <span>Published</span>
      </label>
    </fieldset>

    <div class="mt-2 flex gap-3">
      <button type="submit" class="rounded-lg bg-brand-primary px-6 py-3 font-semibold transition hover:brightness-110">
        Create Post
      </button>
      <a href="/admin/news" class="rounded-lg bg-white/5 px-6 py-3 font-semibold ring-1 ring-white/10 transition hover:bg-white/10">
        Cancel
      </a>
    </div>
  </form>
</AdminLayout>
