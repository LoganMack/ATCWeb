---
export const prerender = false;

// Combines the former Site Settings, Page Banners, Car Logos, Penalty
// Offenses, and Photo Management (Champions/Hall of Fame) tabs — all were
// small, one-off, site-wide configuration screens that didn't belong to any
// single content type, so splitting them across separate nav entries just
// added clicks for no real organizational benefit. All forms POST back to
// this same route now; a hidden `form_section` field tells the previously-
// separate handlers below apart. The Champions/Hall of Fame section below
// has no form of its own — it's a display-only index linking out to the
// existing per-season/per-driver photo-upload subpages, so it doesn't need
// a `form_section` branch. /admin/site-settings, /admin/page-banners,
// /admin/car-logos, and /admin/penalty-offenses still exist as thin
// redirects here for anyone with an old bookmark; /admin/champions is now
// one too (see that file).
//
// The page is split into tabs (?tab=settings|banners|car-logos|offenses|
// champions) and only the active tab's data is fetched — the Champions tab in
// particular runs the whole champions computation, which used to delay every
// visit to this page even when you only wanted to change a setting.

import AdminLayout from '../../../layouts/AdminLayout.astro';
import {
  resolveSupabaseEnv,
  getPageBanners,
  upsertPageBanner,
  deletePageBanner,
  getCarLogos,
  upsertCarLogo,
  deleteCarLogo,
  getDistinctDriverCarNames,
  getPenaltyOffenses,
  createPenaltyOffense,
  updatePenaltyOffense,
  deletePenaltyOffense,
  uploadToStorage,
  getDriverClasses,
  getSeasons,
  getChampionPhotosForClass,
  getHallOfFameDrivers,
  getAllHallOfFamePhotos,
  displayDriverName,
  type PenaltyOffense,
} from '../../../lib/supabase';
import { BANNER_PAGES, BANNER_STRIP_HEIGHT, BANNER_PHONE_ASPECT } from '../../../lib/pageBanners';
import { logActivity, actorNameFor } from '../../../lib/activityLog';
import { getSiteSettings, upsertSiteSetting } from '../../../lib/supabase';
import { INCIDENT_REPORT_PERIOD_HOURS_KEY, INCIDENT_APPEAL_PERIOD_HOURS_KEY, siteSettingInt } from '../../../lib/siteSettings';
import { getChampions, driversSelect } from '../../../lib/results';

const supabaseEnv = resolveSupabaseEnv(Astro.locals);
const accessToken = Astro.locals.session!.accessToken;
const actor = { id: Astro.locals.session!.user.id, name: actorNameFor(Astro.locals.session!) };

let error: string | null = null;

const TABS = [
  { key: 'settings', label: 'Incident Windows' },
  { key: 'banners', label: 'Page Banners' },
  { key: 'car-logos', label: 'Car Logos' },
  { key: 'offenses', label: 'Penalty Offenses' },
  { key: 'champions', label: 'Champions & Hall of Fame' },
] as const;
type TabKey = (typeof TABS)[number]['key'];
// Which tab each POST form lives on, so saving lands you back on it.
const SECTION_TAB: Record<string, TabKey> = {
  'incident-reporting': 'settings',
  'incident-appeal': 'settings',
  banner: 'banners',
  'car-logo': 'car-logos',
  'penalty-offense': 'offenses',
};
const requestedTab = Astro.url.searchParams.get('tab');
let activeTab: TabKey =
  TABS.find((t) => t.key === requestedTab)?.key ?? (Astro.url.searchParams.has('class') ? 'champions' : 'settings');

function extFromFile(file: File): string {
  const fromName = file.name.split('.').pop();
  if (fromName && fromName.length <= 5) return fromName.toLowerCase();
  const map: Record<string, string> = {
    'image/png': 'png',
    'image/jpeg': 'jpg',
    'image/webp': 'webp',
    'image/svg+xml': 'svg',
  };
  return map[file.type] ?? 'png';
}

function slugify(name: string): string {
  return name
    .toLowerCase()
    .replace(/[^a-z0-9]+/g, '-')
    .replace(/^-+|-+$/g, '')
    .slice(0, 60) || 'car';
}

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const section = String(form.get('form_section') ?? '');
  activeTab = SECTION_TAB[section] ?? activeTab;
  const tabUrl = `/admin/site-properties?tab=${activeTab}`;

  if (section === 'incident-appeal') {
    const hours = Math.round(Number(String(form.get('period_hours') ?? '').trim()));
    if (!Number.isFinite(hours) || hours < 1 || hours > 720) {
      error = 'Appeal window must be a whole number of hours between 1 and 720.';
    } else {
      try {
        await upsertSiteSetting(supabaseEnv, accessToken, { setting_key: INCIDENT_APPEAL_PERIOD_HOURS_KEY, value: String(hours) });
        await logActivity(supabaseEnv, accessToken, actor, {
          action: 'edit',
          entity_type: 'site_property',
          entity_label: `Incident appeal window — ${hours}h`,
        });
        return Astro.redirect(tabUrl, 302);
      } catch (err) {
        console.error('Failed to save incident appeal window:', err);
        error = err instanceof Error ? err.message : 'Failed to save the appeal window.';
      }
    }
  } else if (section === 'incident-reporting') {
    const hours = Math.round(Number(String(form.get('period_hours') ?? '').trim()));
    if (!Number.isFinite(hours) || hours < 1 || hours > 720) {
      error = 'Reporting window must be a whole number of hours between 1 and 720.';
    } else {
      try {
        await upsertSiteSetting(supabaseEnv, accessToken, { setting_key: INCIDENT_REPORT_PERIOD_HOURS_KEY, value: String(hours) });
        await logActivity(supabaseEnv, accessToken, actor, {
          action: 'edit',
          entity_type: 'site_property',
          entity_label: `Incident reporting window — ${hours}h`,
        });
        return Astro.redirect(tabUrl, 302);
      } catch (err) {
        console.error('Failed to save incident reporting period:', err);
        error = err instanceof Error ? err.message : 'Failed to save the reporting window.';
      }
    }
  } else if (section === 'car-logo') {
    const intent = String(form.get('intent') ?? 'save');

    if (intent === 'delete') {
      const carName = String(form.get('car_name') ?? '');
      if (carName) {
        try {
          await deleteCarLogo(supabaseEnv, accessToken, carName);
          await logActivity(supabaseEnv, accessToken, actor, {
            action: 'delete',
            entity_type: 'site_property',
            entity_label: `Car logo — ${carName}`,
          });
        } catch (err) {
          console.error('Failed to delete car logo:', err);
          error = 'Failed to remove that logo.';
        }
      }
      if (!error) return Astro.redirect(tabUrl, 302);
    } else {
      const carName = String(form.get('car_name') ?? '').trim();
      const logoUrlField = String(form.get('logo_url') ?? '').trim();
      const logoFile = form.get('logo');

      if (!carName) {
        error = 'Car name is required.';
      } else {
        try {
          const existedBefore = (await getCarLogos(supabaseEnv)).some((c) => c.car_name === carName);
          let logo_url = logoUrlField || null;
          if (logoFile instanceof File && logoFile.size > 0) {
            const path = `car-${slugify(carName)}-${Date.now()}.${extFromFile(logoFile)}`;
            logo_url = await uploadToStorage(supabaseEnv, accessToken, 'logos', path, logoFile);
          }
          if (!logo_url) {
            error = 'Provide a logo file or a logo URL.';
          } else {
            await upsertCarLogo(supabaseEnv, accessToken, { car_name: carName, logo_url });
            await logActivity(supabaseEnv, accessToken, actor, {
              action: existedBefore ? 'edit' : 'add',
              entity_type: 'site_property',
              entity_label: `Car logo — ${carName}`,
            });
            return Astro.redirect(tabUrl, 302);
          }
        } catch (err) {
          console.error('Failed to save car logo:', err);
          error = err instanceof Error ? err.message : 'Failed to save this logo.';
        }
      }
    }
  } else if (section === 'penalty-offense') {
    const intent = String(form.get('intent') ?? 'save');

    if (intent === 'delete') {
      const id = String(form.get('id') ?? '');
      if (id) {
        try {
          await deletePenaltyOffense(supabaseEnv, accessToken, id);
          await logActivity(supabaseEnv, accessToken, actor, {
            action: 'delete',
            entity_type: 'site_property',
            entity_label: 'Penalty offense',
            entity_id: id,
          });
        } catch (err) {
          console.error('Failed to delete penalty offense:', err);
          error = 'Failed to remove that offense.';
        }
      }
      if (!error) return Astro.redirect(tabUrl, 302);
    } else {
      const id = String(form.get('id') ?? '');
      const name = String(form.get('name') ?? '').trim();
      const referencePoints = String(form.get('reference_points') ?? '').trim() || null;
      const sortOrder = Number(form.get('sort_order') ?? 0);

      if (!name) {
        error = 'Offense name is required.';
      } else {
        try {
          if (id) {
            await updatePenaltyOffense(supabaseEnv, accessToken, id, { name, reference_points: referencePoints, sort_order: sortOrder });
            await logActivity(supabaseEnv, accessToken, actor, {
              action: 'edit',
              entity_type: 'site_property',
              entity_label: `Penalty offense — ${name}`,
              entity_id: id,
            });
          } else {
            const created = await createPenaltyOffense(supabaseEnv, accessToken, { name, reference_points: referencePoints, sort_order: sortOrder });
            await logActivity(supabaseEnv, accessToken, actor, {
              action: 'add',
              entity_type: 'site_property',
              entity_label: `Penalty offense — ${name}`,
              entity_id: created?.id,
            });
          }
          return Astro.redirect(tabUrl, 302);
        } catch (err) {
          console.error('Failed to save penalty offense:', err);
          error = err instanceof Error ? err.message : 'Failed to save this offense.';
        }
      }
    }
  } else if (section === 'banner') {
    const intent = String(form.get('intent') ?? 'save');
    const pageKey = String(form.get('page_key') ?? '');
    const validKey = BANNER_PAGES.some((p) => p.key === pageKey);

    if (!validKey) {
      error = 'Unknown page.';
    } else if (intent === 'delete') {
      try {
        await deletePageBanner(supabaseEnv, accessToken, pageKey);
        await logActivity(supabaseEnv, accessToken, actor, {
          action: 'delete',
          entity_type: 'site_property',
          entity_label: `Page banner — ${pageKey}`,
        });
      } catch (err) {
        console.error('Failed to remove page banner:', err);
        error = 'Failed to remove that banner.';
      }
      if (!error) return Astro.redirect(tabUrl, 302);
    } else {
      const imageUrlField = String(form.get('image_url') ?? '').trim();
      const imageFile = form.get('image');

      try {
        let image_url = imageUrlField || null;
        if (imageFile instanceof File && imageFile.size > 0) {
          const path = `${pageKey}-${Date.now()}.${extFromFile(imageFile)}`;
          image_url = await uploadToStorage(supabaseEnv, accessToken, 'banners', path, imageFile);
        }
        if (!image_url) {
          error = 'Provide an image file or an image URL.';
        } else {
          await upsertPageBanner(supabaseEnv, accessToken, { page_key: pageKey, image_url });
          await logActivity(supabaseEnv, accessToken, actor, {
            action: 'edit',
            entity_type: 'site_property',
            entity_label: `Page banner — ${pageKey}`,
          });
          return Astro.redirect(tabUrl, 302);
        }
      } catch (err) {
        console.error('Failed to save page banner:', err);
        error = err instanceof Error ? err.message : 'Failed to save this banner.';
      }
    }
  }
}

let configured: Awaited<ReturnType<typeof getPageBanners>> = [];
if (activeTab === 'banners') {
  try {
    configured = await getPageBanners(supabaseEnv);
  } catch (err) {
    console.error('Failed to load page banners:', err);
    if (!error) error = 'Failed to load page banners.';
  }
}
const bannerByKey = new Map(configured.map((b) => [b.page_key, b.image_url]));

let configuredCarLogos: Awaited<ReturnType<typeof getCarLogos>> = [];
let driverCarNames: string[] = [];
if (activeTab === 'car-logos') {
  try {
    [configuredCarLogos, driverCarNames] = await Promise.all([getCarLogos(supabaseEnv), getDistinctDriverCarNames(supabaseEnv)]);
  } catch (err) {
    console.error('Failed to load car logos:', err);
    if (!error) error = 'Failed to load car logos.';
  }
}
const logoByCarName = new Map(configuredCarLogos.map((c) => [c.car_name, c.logo_url]));
// Every car name worth showing a row for: currently-configured logos, plus
// every car currently listed on a driver's profile that doesn't have one
// yet — see getDistinctDriverCarNames for why this (not a full scan of
// historical race results) is the practical source for "cars in the data."
const allCarNames = [...new Set([...logoByCarName.keys(), ...driverCarNames])].sort((a, b) => a.localeCompare(b));

let offenses: PenaltyOffense[] = [];
if (activeTab === 'offenses') {
  try {
    offenses = await getPenaltyOffenses(supabaseEnv);
  } catch (err) {
    console.error('Failed to load penalty offenses:', err);
    if (!error) error = 'Failed to load penalty offenses.';
  }
}

// --- Champions & Hall of Fame (formerly /admin/champions, "Photo Management") ---
// Display-only index — the champion for each season/class is computed
// automatically from race results; this section is just for finding the
// per-season/per-driver subpage where the (up to 5) photos shown on the
// public Champions and Hall of Fame pages get uploaded. Those subpages
// themselves (src/pages/admin/champions/[seasonId]/[classId].astro and
// hall-of-fame/[driverId].astro) are unchanged and stay at their existing
// routes — only this index moved.
let classes: Awaited<ReturnType<typeof getDriverClasses>> = [];
let seasons: Awaited<ReturnType<typeof getSeasons>> = [];
let championsLoadError: string | null = null;
if (activeTab === 'champions') {
  try {
    [classes, seasons] = await Promise.all([getDriverClasses(supabaseEnv), getSeasons(supabaseEnv)]);
  } catch (err) {
    console.error('Failed to load admin champions filters:', err);
    championsLoadError = err instanceof Error ? err.message : String(err);
  }
}

// Hall of Fame members section — separate from the season/class champion
// photo management below (Hall of Fame photos are scoped per-driver, not
// per-season/class; see hall_of_fame_photos vs champion_photos).
let hofError: string | null = null;
let hofMembers: { id: string; name: string; photoCount: number }[] = [];
if (activeTab === 'champions') {
  try {
    const [hofDrivers, allDrivers, hofPhotos] = await Promise.all([
      getHallOfFameDrivers(supabaseEnv),
      driversSelect(supabaseEnv),
      getAllHallOfFamePhotos(supabaseEnv),
    ]);
    const driverById = new Map(allDrivers.map((d) => [d.id, d]));
    const photoCountByDriver = new Map<string, number>();
    for (const photo of hofPhotos) {
      photoCountByDriver.set(photo.driver_id, (photoCountByDriver.get(photo.driver_id) ?? 0) + 1);
    }
    hofMembers = hofDrivers
      .map((h) => {
        const driver = driverById.get(h.id);
        return driver
          ? { id: driver.id, name: displayDriverName(driver.name), photoCount: photoCountByDriver.get(driver.id) ?? 0 }
          : null;
      })
      .filter((m): m is { id: string; name: string; photoCount: number } => m !== null)
      .sort((a, b) => a.name.localeCompare(b.name));
  } catch (err) {
    console.error('Failed to load Hall of Fame members for admin:', err);
    hofError = err instanceof Error ? err.message : String(err);
  }
}

// Gamma/Delta didn't exist for every season (seasons.gamma_enabled/
// delta_enabled, 0037_class_and_scoring_fixes.sql) — same gating champions.astro
// / champions/fragment.astro already apply to the public Champions page.
function classIsEnabledFor(className: string, season: Awaited<ReturnType<typeof getSeasons>>[number]): boolean {
  if (className === 'Gamma') return season.gamma_enabled;
  if (className === 'Delta') return season.delta_enabled;
  return true;
}

const requestedClassName = Astro.url.searchParams.get('class');
const activeClass = classes.find((c) => c.name === requestedClassName) ?? classes.find((c) => c.name === 'Alpha') ?? classes[0];

let champions: Awaited<ReturnType<typeof getChampions>> = [];
let photoCountBySeason = new Map<string, number>();
if (activeTab === 'champions' && !championsLoadError && activeClass) {
  try {
    const eligibleSeasons = seasons.filter((s) => classIsEnabledFor(activeClass.name, s));
    const [championsResult, photos] = await Promise.all([
      getChampions(supabaseEnv, eligibleSeasons, activeClass.id),
      getChampionPhotosForClass(supabaseEnv, activeClass.id),
    ]);
    champions = championsResult;
    for (const photo of photos) {
      photoCountBySeason.set(photo.season_id, (photoCountBySeason.get(photo.season_id) ?? 0) + 1);
    }
  } catch (err) {
    console.error('Failed to compute champions for admin:', err);
    championsLoadError = err instanceof Error ? err.message : String(err);
  }
}
let incidentPeriodHours = 24;
let incidentAppealHours = 24;
if (activeTab === 'settings') {
  try {
    const settings = await getSiteSettings(supabaseEnv);
    incidentPeriodHours = siteSettingInt(settings, INCIDENT_REPORT_PERIOD_HOURS_KEY);
    incidentAppealHours = siteSettingInt(settings, INCIDENT_APPEAL_PERIOD_HOURS_KEY);
  } catch (err) {
    console.error('Failed to load incident reporting period:', err);
  }
}
---

<AdminLayout title="Site Properties">
  <h1 class="reveal font-display text-4xl">Site Properties</h1>
  <p class="reveal mt-2 max-w-2xl text-sm text-white/60" style="transition-delay: 40ms">
    One-off, site-wide settings that don't belong to any one page.
  </p>

  {error && (
    <p class="reveal mt-6 break-words rounded-lg border border-brand-pink/30 bg-brand-pink/10 p-4 text-sm text-white/80">{error}</p>
  )}

  <nav class="reveal mt-8 flex flex-wrap gap-2" aria-label="Site properties sections" style="transition-delay: 45ms">
    {TABS.map((t) => (
      <a href={`/admin/site-properties?tab=${t.key}`} class={`btn ${t.key === activeTab ? 'btn-active' : 'btn-neutral'}`} aria-current={t.key === activeTab ? 'page' : undefined}>
        {t.label}
      </a>
    ))}
  </nav>

  {activeTab === 'settings' && (
  <section class="reveal mt-8" style="transition-delay: 50ms">
    <h2 class="font-semibold">Incident Reporting Window</h2>
    <p class="mt-1 max-w-2xl text-sm text-white/50">
      How long drivers can report incidents after a round's race ends. Once it closes, the Incident Report button on the results page is disabled until you post the round.
    </p>
    <form method="POST" data-astro-reload class="mt-4 flex flex-wrap items-end gap-3">
      <input type="hidden" name="form_section" value="incident-reporting" />
      <label class="block text-sm">
        <span class="text-white/60">Reporting window (hours)</span>
        <input
          type="number"
          name="period_hours"
          min="1"
          max="720"
          step="1"
          value={incidentPeriodHours}
          required
          class="mt-1 block w-32 rounded-lg border border-white/10 bg-white/5 px-3 py-2 text-white"
        />
      </label>
      <button type="submit" class="btn btn-primary">Save</button>
    </form>

    <h2 class="mt-8 font-semibold">Incident Appeal Window</h2>
    <p class="mt-1 max-w-2xl text-sm text-white/50">
      How long drivers can submit an appeal for an incident after you post the round's incident report. Once it closes, the Submit Appeal button in the incident details popup is disabled.
    </p>
    <form method="POST" data-astro-reload class="mt-4 flex flex-wrap items-end gap-3">
      <input type="hidden" name="form_section" value="incident-appeal" />
      <label class="block text-sm">
        <span class="text-white/60">Appeal window (hours)</span>
        <input
          type="number"
          name="period_hours"
          min="1"
          max="720"
          step="1"
          value={incidentAppealHours}
          required
          class="mt-1 block w-32 rounded-lg border border-white/10 bg-white/5 px-3 py-2 text-white"
        />
      </label>
      <button type="submit" class="btn btn-primary">Save</button>
    </form>
  </section>
  )}

  {activeTab === 'banners' && (
  <section class="reveal mt-8" style="transition-delay: 60ms">
    <h2 class="font-semibold">Page Banners</h2>
    <p class="mt-1 max-w-2xl text-xs text-white/40">
      An optional background image for the space between the top nav and each page's own header — the Home entry is
      the homepage's larger hero section instead. Leave a page unset and it just renders plain black, same as before
      any of this existed. When you choose a file, a crop tool opens: drag the photo to reposition it and use the zoom
      slider, and only the framed area is saved. (An image URL is used as-is, uncropped.)
    </p>

    <div class="mt-4 flex flex-col gap-3">
      {BANNER_PAGES.map((page) => {
        const imageUrl = bannerByKey.get(page.key) ?? null;
        return (
          <div class="flex flex-wrap items-center gap-3 rounded-lg bg-brand-ink p-3 ring-1 ring-white/10">
            {imageUrl ? (
              <img src={imageUrl} alt="" class="h-10 w-16 flex-none rounded object-cover" />
            ) : (
              <div class="h-10 w-16 flex-none rounded bg-white/10"></div>
            )}
            <div class="min-w-[10rem]">
              <p class="font-semibold">{page.label}</p>
              <p class="text-xs text-white/40">{page.description}</p>
            </div>
            <form
              method="POST"
              data-astro-reload
              enctype="multipart/form-data"
              data-banner-form
              data-crop-aspect={page.key === 'home' ? '2.2857' : String(Math.round(((page.width ?? 1152) / BANNER_STRIP_HEIGHT) * 1000) / 1000)}
              data-crop-phone={page.key === 'home' ? '0.76' : String(Math.round(BANNER_PHONE_ASPECT * 1000) / 1000)}
              class="flex flex-wrap items-center gap-2"
            >
              <input type="hidden" name="form_section" value="banner" />
              <input type="hidden" name="intent" value="save" />
              <input type="hidden" name="page_key" value={page.key} />
              <input
                type="text"
                name="image_url"
                placeholder="Image URL (optional if uploading a file)"
                class="w-56 rounded-md border border-white/15 bg-white/5 px-2 py-1.5 text-xs text-white outline-none focus:border-brand-primary"
              />
              <input
                type="file"
                name="image"
                data-banner-file
                accept="image/png,image/jpeg,image/webp"
                class="w-56 text-xs text-white/60 file:mr-2 file:rounded-lg file:border-0 file:bg-white/10 file:px-3 file:py-1.5 file:text-xs file:text-white"
              />
              <button
                type="submit"
                class="btn btn-primary btn-sm"
              >
                Save
              </button>
            </form>
            {imageUrl && (
              <form method="POST" data-astro-reload>
                <input type="hidden" name="form_section" value="banner" />
                <input type="hidden" name="intent" value="delete" />
                <input type="hidden" name="page_key" value={page.key} />
                <button type="submit" class="text-xs font-semibold text-white/40 transition hover:text-brand-pink">Remove</button>
              </form>
            )}
          </div>
        );
      })}
    </div>
    {/* One shared crop panel; the script below moves it into whichever banner row you pick a file for. */}
    <div id="banner-cropper" hidden class="w-full basis-full rounded-lg border border-white/10 bg-brand-ink p-3">
      <p class="text-xs text-white/50">
        Drag the photo to reposition it, and use the slider to zoom. Everything inside the frame is saved.
        <span data-crop-phone-note>The dashed lines show roughly what a phone shows.</span>
      </p>
      <div
        data-crop-frame
        class="relative mt-2 w-full cursor-grab touch-none select-none overflow-hidden rounded-md bg-black active:cursor-grabbing"
        style="aspect-ratio: 7 / 1"
      >
        <img data-crop-img alt="" draggable="false" class="pointer-events-none absolute left-0 top-0 max-w-none select-none" />
        <div data-crop-guide class="pointer-events-none absolute inset-y-0 left-1/2 -translate-x-1/2 border-x border-dashed border-white/70"></div>
      </div>
      <div class="mt-3 flex flex-wrap items-center gap-3 text-xs text-white/60">
        <label class="flex items-center gap-2">
          Zoom
          <input type="range" data-crop-zoom min="1" max="4" step="0.01" value="1" class="w-48 accent-brand-primary" />
        </label>
        <button type="button" data-crop-reset class="btn btn-neutral btn-sm">Reset</button>
        <label class="flex items-center gap-1.5">
          <input type="checkbox" data-crop-skip class="h-3.5 w-3.5 accent-brand-primary" />
