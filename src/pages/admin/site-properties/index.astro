<script>
  // Banner crop tool. The chosen file is shown in a banner-shaped frame; you
  // drag to reposition and zoom, and on submit the framed region is rendered to
  // a 1600px-wide JPEG that replaces the file in the form before it's sent.
  // Delegated listeners, bound once (this page is swapped in by the client
  // router, so inline scripts must not assume a fresh document each visit).
  let cropBound = false;

  type CropState = {
    form: HTMLFormElement;
    input: HTMLInputElement;
    img: HTMLImageElement;
    nw: number;
    nh: number;
    zoom: number;
    ox: number;
    oy: number;
    aspect: number;
    url: string;
  };
  let state: CropState | null = null;

  const panel = () => document.getElementById('banner-cropper') as HTMLElement | null;

  function frameSize(p: HTMLElement) {
    const frame = p.querySelector<HTMLElement>('[data-crop-frame]')!;
    const r = frame.getBoundingClientRect();
    return { frame, fw: r.width, fh: r.height };
  }

  function baseScale(fw: number, fh: number, st: CropState) {
    return Math.max(fw / st.nw, fh / st.nh);
  }

  function clamp(st: CropState, fw: number, fh: number) {
    const scale = baseScale(fw, fh, st) * st.zoom;
    st.ox = Math.min(0, Math.max(fw - st.nw * scale, st.ox));
    st.oy = Math.min(0, Math.max(fh - st.nh * scale, st.oy));
  }

  function render() {
    const p = panel();
    if (!p || !state) return;
    const { fw, fh } = frameSize(p);
    clamp(state, fw, fh);
    const scale = baseScale(fw, fh, state) * state.zoom;
    const img = state.img;
    img.style.width = `${state.nw * scale}px`;
    img.style.height = `${state.nh * scale}px`;
    img.style.transform = `translate(${state.ox}px, ${state.oy}px)`;
  }

  function resetView() {
    const p = panel();
    if (!p || !state) return;
    const { fw, fh } = frameSize(p);
    state.zoom = 1;
    const scale = baseScale(fw, fh, state);
    state.ox = (fw - state.nw * scale) / 2;
    state.oy = (fh - state.nh * scale) / 2;
    const zoom = p.querySelector<HTMLInputElement>('[data-crop-zoom]');
    if (zoom) zoom.value = '1';
    render();
  }

  function closeCropper() {
    const p = panel();
    if (state) URL.revokeObjectURL(state.url);
    state = null;
    if (p) p.hidden = true;
  }

  function openCropper(input: HTMLInputElement, file: File) {
    const p = panel();
    const form = input.closest<HTMLFormElement>('[data-banner-form]');
    if (!p || !form) return;
    // A previous row's pending file would otherwise be uploaded uncropped.
    if (state && state.input !== input) state.input.value = '';
    if (state) URL.revokeObjectURL(state.url);

    const aspect = Number(form.dataset.cropAspect) || 7;
    const phoneAspect = Number(form.dataset.cropPhone) || 2.44;
    const row = form.parentElement!;
    row.appendChild(p);
    p.hidden = false;
    const frame = p.querySelector<HTMLElement>('[data-crop-frame]')!;
    frame.style.aspectRatio = `${aspect} / 1`;
    const guide = p.querySelector<HTMLElement>('[data-crop-guide]')!;
    guide.style.width = `${Math.min(1, phoneAspect / aspect) * 100}%`;
    guide.style.display = phoneAspect / aspect >= 0.98 ? 'none' : '';
    const skip = p.querySelector<HTMLInputElement>('[data-crop-skip]');
    if (skip) skip.checked = false;

    const url = URL.createObjectURL(file);
    const img = p.querySelector<HTMLImageElement>('[data-crop-img]')!;
    img.onload = () => {
      state = { form, input, img, nw: img.naturalWidth, nh: img.naturalHeight, zoom: 1, ox: 0, oy: 0, aspect, url };
      resetView();
    };
    img.src = url;
  }

  async function cropToBlob(st: CropState, p: HTMLElement): Promise<Blob | null> {
    const { fw, fh } = frameSize(p);
    const scale = baseScale(fw, fh, st) * st.zoom;
    const sx = -st.ox / scale;
    const sy = -st.oy / scale;
    const sw = fw / scale;
    const sh = fh / scale;
    const outW = Math.min(1600, Math.round(sw));
    const outW2 = Math.max(outW, 800);
    const outH = Math.round(outW2 / st.aspect);
    const canvas = document.createElement('canvas');
    canvas.width = outW2;
    canvas.height = outH;
    const ctx = canvas.getContext('2d');
    if (!ctx) return null;
    ctx.fillStyle = '#000';
    ctx.fillRect(0, 0, outW2, outH);
    ctx.imageSmoothingQuality = 'high';
    ctx.drawImage(st.img, sx, sy, sw, sh, 0, 0, outW2, outH);
    return new Promise((resolve) => canvas.toBlob((b) => resolve(b), 'image/jpeg', 0.9));
  }

  function initBannerCropper() {
    if (cropBound) return;
    cropBound = true;

    document.addEventListener('change', (e) => {
      const t = e.target as HTMLElement;
      if (t instanceof HTMLInputElement && t.matches('[data-banner-file]')) {
        const file = t.files?.[0];
        if (file) openCropper(t, file);
        else closeCropper();
      } else if (t instanceof HTMLInputElement && t.matches('[data-crop-zoom]') && state) {
        const p = panel();
        if (!p) return;
        const { fw, fh } = frameSize(p);
        const old = baseScale(fw, fh, state) * state.zoom;
        const cx = (fw / 2 - state.ox) / old;
        const cy = (fh / 2 - state.oy) / old;
        state.zoom = Number(t.value);
        const next = baseScale(fw, fh, state) * state.zoom;
        state.ox = fw / 2 - cx * next;
        state.oy = fh / 2 - cy * next;
        render();
      }
    });
    // The zoom slider should follow the thumb live, not only on release.
    document.addEventListener('input', (e) => {
      const t = e.target as HTMLElement;
      if (t instanceof HTMLInputElement && t.matches('[data-crop-zoom]')) t.dispatchEvent(new Event('change', { bubbles: true }));
    });

    document.addEventListener('click', (e) => {
      const t = e.target as HTMLElement;
      if (t.closest('[data-crop-reset]')) resetView();
    });

    let drag: { x: number; y: number; ox: number; oy: number } | null = null;
    document.addEventListener('pointerdown', (e) => {
      const frame = (e.target as HTMLElement).closest('[data-crop-frame]');
      if (!frame || !state) return;
      drag = { x: e.clientX, y: e.clientY, ox: state.ox, oy: state.oy };
      (frame as HTMLElement).setPointerCapture(e.pointerId);
    });
    document.addEventListener('pointermove', (e) => {
      if (!drag || !state) return;
      state.ox = drag.ox + (e.clientX - drag.x);
      state.oy = drag.oy + (e.clientY - drag.y);
      render();
    });
    const endDrag = () => {
      drag = null;
    };
    document.addEventListener('pointerup', endDrag);
    document.addEventListener('pointercancel', endDrag);
    window.addEventListener('resize', render);

    // Runs in the CAPTURE phase on purpose. hard-form-submit.ts (loaded on every
    // page) binds its own submit listener directly on each POST form and builds
    // its FormData right away, which would send the original, uncropped file
    // before a bubble-phase listener ever ran. Capturing here lets us swap in the
    // cropped file first, then re-fire the submit so that handler sends it.
    let recropping = false;
    document.addEventListener(
      'submit',
      async (e) => {
        const form = e.target as HTMLFormElement;
        if (recropping) {
          recropping = false;
          return;
        }
        if (!form.matches?.('[data-banner-form]') || !state || state.form !== form) return;
        const p = panel();
        if (!p || p.hidden) return;
        const skip = p.querySelector<HTMLInputElement>('[data-crop-skip]');
        if (skip?.checked) return; // upload the original file as chosen
        e.preventDefault();
        e.stopImmediatePropagation();
        const submitter = (e as SubmitEvent).submitter as HTMLElement | null;
        const blob = await cropToBlob(state, p);
        if (blob) {
          const dt = new DataTransfer();
          dt.items.add(new File([blob], 'banner.jpg', { type: 'image/jpeg' }));
          state.input.files = dt.files;
        }
        // If a crop couldn't be rendered, fall through with the original file
        // rather than losing the upload.
        recropping = true;
        form.requestSubmit(submitter ?? undefined);
      },
      true
    );
  }

  initBannerCropper();
  document.addEventListener('astro:page-load', initBannerCropper);

  export {};
</script>
