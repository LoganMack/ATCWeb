---
export const prerender = false;

// Combines the former Site Settings, Page Banners, Car Logos, and Penalty
// Offenses tabs — all were small, one-off, site-wide configuration screens
// that didn't belong to any single content type, so splitting them across
// separate nav entries just added clicks for no real organizational
// benefit. All forms POST back to this same route now; a hidden
// `form_section` field tells the previously-separate handlers below apart.
// /admin/site-settings, /admin/page-banners, /admin/car-logos, and
// /admin/penalty-offenses still exist as thin redirects here for anyone
// with an old bookmark.

import AdminLayout from '../../../layouts/AdminLayout.astro';
import {
  resolveSupabaseEnv,
  getSiteSettings,
  upsertSiteSetting,
  getPageBanners,
  upsertPageBanner,
  deletePageBanner,
  getCarLogos,
  upsertCarLogo,
  deleteCarLogo,
  getDistinctDriverCarNames,
  getPenaltyOffenses,
  createPenaltyOffense,
  updatePenaltyOffense,
  deletePenaltyOffense,
  uploadToStorage,
  type PenaltyOffense,
} from '../../../lib/supabase';
import { FEATURED_BROADCAST_URL_KEY, siteSettingValue, youtubeEmbedUrl } from '../../../lib/siteSettings';
import { BANNER_PAGES } from '../../../lib/pageBanners';
import { logActivity, actorNameFor } from '../../../lib/activityLog';

const supabaseEnv = resolveSupabaseEnv(Astro.locals);
const accessToken = Astro.locals.session!.accessToken;
const actor = { id: Astro.locals.session!.user.id, name: actorNameFor(Astro.locals.session!) };

let error: string | null = null;
let saved = false;

function extFromFile(file: File): string {
  const fromName = file.name.split('.').pop();
  if (fromName && fromName.length <= 5) return fromName.toLowerCase();
  const map: Record<string, string> = {
    'image/png': 'png',
    'image/jpeg': 'jpg',
    'image/webp': 'webp',
    'image/svg+xml': 'svg',
  };
  return map[file.type] ?? 'png';
}

function slugify(name: string): string {
  return name
    .toLowerCase()
    .replace(/[^a-z0-9]+/g, '-')
    .replace(/^-+|-+$/g, '')
    .slice(0, 60) || 'car';
}

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const section = String(form.get('form_section') ?? '');

  if (section === 'car-logo') {
    const intent = String(form.get('intent') ?? 'save');

    if (intent === 'delete') {
      const carName = String(form.get('car_name') ?? '');
      if (carName) {
        try {
          await deleteCarLogo(supabaseEnv, accessToken, carName);
          await logActivity(supabaseEnv, accessToken, actor, {
            action: 'delete',
            entity_type: 'site_property',
            entity_label: `Car logo — ${carName}`,
          });
        } catch (err) {
          console.error('Failed to delete car logo:', err);
          error = 'Failed to remove that logo.';
        }
      }
      if (!error) return Astro.redirect('/admin/site-properties', 302);
    } else {
      const carName = String(form.get('car_name') ?? '').trim();
      const logoUrlField = String(form.get('logo_url') ?? '').trim();
      const logoFile = form.get('logo');

      if (!carName) {
        error = 'Car name is required.';
      } else {
        try {
          const existedBefore = (await getCarLogos(supabaseEnv)).some((c) => c.car_name === carName);
          let logo_url = logoUrlField || null;
          if (logoFile instanceof File && logoFile.size > 0) {
            const path = `car-${slugify(carName)}-${Date.now()}.${extFromFile(logoFile)}`;
            logo_url = await uploadToStorage(supabaseEnv, accessToken, 'logos', path, logoFile);
          }
          if (!logo_url) {
            error = 'Provide a logo file or a logo URL.';
          } else {
            await upsertCarLogo(supabaseEnv, accessToken, { car_name: carName, logo_url });
            await logActivity(supabaseEnv, accessToken, actor, {
              action: existedBefore ? 'edit' : 'add',
              entity_type: 'site_property',
              entity_label: `Car logo — ${carName}`,
            });
            return Astro.redirect('/admin/site-properties', 302);
          }
        } catch (err) {
          console.error('Failed to save car logo:', err);
          error = err instanceof Error ? err.message : 'Failed to save this logo.';
        }
      }
    }
  } else if (section === 'penalty-offense') {
    const intent = String(form.get('intent') ?? 'save');

    if (intent === 'delete') {
      const id = String(form.get('id') ?? '');
      if (id) {
        try {
          await deletePenaltyOffense(supabaseEnv, accessToken, id);
          await logActivity(supabaseEnv, accessToken, actor, {
            action: 'delete',
            entity_type: 'site_property',
            entity_label: 'Penalty offense',
            entity_id: id,
          });
        } catch (err) {
          console.error('Failed to delete penalty offense:', err);
          error = 'Failed to remove that offense.';
        }
      }
      if (!error) return Astro.redirect('/admin/site-properties', 302);
    } else {
      const id = String(form.get('id') ?? '');
      const name = String(form.get('name') ?? '').trim();
      const referencePoints = String(form.get('reference_points') ?? '').trim() || null;
      const sortOrder = Number(form.get('sort_order') ?? 0);

      if (!name) {
        error = 'Offense name is required.';
      } else {
        try {
          if (id) {
            await updatePenaltyOffense(supabaseEnv, accessToken, id, { name, reference_points: referencePoints, sort_order: sortOrder });
            await logActivity(supabaseEnv, accessToken, actor, {
              action: 'edit',
              entity_type: 'site_property',
              entity_label: `Penalty offense — ${name}`,
              entity_id: id,
            });
          } else {
            const created = await createPenaltyOffense(supabaseEnv, accessToken, { name, reference_points: referencePoints, sort_order: sortOrder });
            await logActivity(supabaseEnv, accessToken, actor, {
              action: 'add',
              entity_type: 'site_property',
              entity_label: `Penalty offense — ${name}`,
              entity_id: created?.id,
            });
          }
          return Astro.redirect('/admin/site-properties', 302);
        } catch (err) {
          console.error('Failed to save penalty offense:', err);
          error = err instanceof Error ? err.message : 'Failed to save this offense.';
        }
      }
    }
  } else if (section === 'banner') {
    const intent = String(form.get('intent') ?? 'save');
    const pageKey = String(form.get('page_key') ?? '');
    const validKey = BANNER_PAGES.some((p) => p.key === pageKey);

    if (!validKey) {
      error = 'Unknown page.';
    } else if (intent === 'delete') {
      try {
        await deletePageBanner(supabaseEnv, accessToken, pageKey);
        await logActivity(supabaseEnv, accessToken, actor, {
          action: 'delete',
          entity_type: 'site_property',
          entity_label: `Page banner — ${pageKey}`,
        });
      } catch (err) {
        console.error('Failed to remove page banner:', err);
        error = 'Failed to remove that banner.';
      }
      if (!error) return Astro.redirect('/admin/site-properties', 302);
    } else {
      const imageUrlField = String(form.get('image_url') ?? '').trim();
      const imageFile = form.get('image');

      try {
        let image_url = imageUrlField || null;
        if (imageFile instanceof File && imageFile.size > 0) {
          const path = `${pageKey}-${Date.now()}.${extFromFile(imageFile)}`;
          image_url = await uploadToStorage(supabaseEnv, accessToken, 'banners', path, imageFile);
        }
        if (!image_url) {
          error = 'Provide an image file or an image URL.';
        } else {
          await upsertPageBanner(supabaseEnv, accessToken, { page_key: pageKey, image_url });
          await logActivity(supabaseEnv, accessToken, actor, {
            action: 'edit',
            entity_type: 'site_property',
            entity_label: `Page banner — ${pageKey}`,
          });
          return Astro.redirect('/admin/site-properties', 302);
        }
      } catch (err) {
        console.error('Failed to save page banner:', err);
        error = err instanceof Error ? err.message : 'Failed to save this banner.';
      }
    }
  } else {
    const broadcastUrl = String(form.get('featured_broadcast_url') ?? '').trim();

    if (broadcastUrl && !youtubeEmbedUrl(broadcastUrl)) {
      error = "That doesn't look like a YouTube URL — paste the normal watch/share link (or leave it blank to remove the broadcast).";
    } else {
      try {
        await upsertSiteSetting(supabaseEnv, accessToken, {
          setting_key: FEATURED_BROADCAST_URL_KEY,
          value: broadcastUrl || null,
        });
        await logActivity(supabaseEnv, accessToken, actor, {
          action: 'edit',
          entity_type: 'site_property',
          entity_label: 'Featured Broadcast URL',
          details: broadcastUrl || '(cleared)',
        });
        saved = true;
      } catch (err) {
        console.error('Failed to save site settings:', err);
        error = err instanceof Error ? err.message : 'Failed to save.';
      }
    }
  }
}

let currentBroadcastUrl = '';
try {
  currentBroadcastUrl = siteSettingValue(await getSiteSettings(supabaseEnv), FEATURED_BROADCAST_URL_KEY) ?? '';
} catch (err) {
  console.error('Failed to load site settings:', err);
  if (!error) error = 'Failed to load current settings.';
}

let configured: Awaited<ReturnType<typeof getPageBanners>> = [];
try {
  configured = await getPageBanners(supabaseEnv);
} catch (err) {
  console.error('Failed to load page banners:', err);
  if (!error) error = 'Failed to load page banners.';
}
const bannerByKey = new Map(configured.map((b) => [b.page_key, b.image_url]));

let configuredCarLogos: Awaited<ReturnType<typeof getCarLogos>> = [];
let driverCarNames: string[] = [];
try {
  [configuredCarLogos, driverCarNames] = await Promise.all([getCarLogos(supabaseEnv), getDistinctDriverCarNames(supabaseEnv)]);
} catch (err) {
  console.error('Failed to load car logos:', err);
  if (!error) error = 'Failed to load car logos.';
}
const logoByCarName = new Map(configuredCarLogos.map((c) => [c.car_name, c.logo_url]));
// Every car name worth showing a row for: currently-configured logos, plus
// every car currently listed on a driver's profile that doesn't have one
// yet — see getDistinctDriverCarNames for why this (not a full scan of
// historical race results) is the practical source for "cars in the data."
const allCarNames = [...new Set([...logoByCarName.keys(), ...driverCarNames])].sort((a, b) => a.localeCompare(b));

let offenses: PenaltyOffense[] = [];
try {
  offenses = await getPenaltyOffenses(supabaseEnv);
} catch (err) {
  console.error('Failed to load penalty offenses:', err);
  if (!error) error = 'Failed to load penalty offenses.';
}
---

<AdminLayout title="Site Properties">
  <h1 class="reveal font-display text-4xl">Site Properties</h1>
  <p class="reveal mt-2 max-w-2xl text-sm text-white/60" style="transition-delay: 40ms">
    One-off, site-wide settings that don't belong to any one page.
  </p>

  {error && (
    <p class="reveal mt-6 break-words rounded-lg border border-brand-pink/30 bg-brand-pink/10 p-4 text-sm text-white/80">{error}</p>
  )}
  {saved && !error && (
    <p class="reveal mt-6 rounded-lg border border-brand-primary/30 bg-brand-primary/10 p-4 text-sm text-white/80">Saved.</p>
  )}

  <section class="reveal mt-8 max-w-xl rounded-lg bg-white/5 p-5 ring-1 ring-white/10" style="transition-delay: 60ms">
    <h2 class="font-semibold">Featured Broadcast</h2>
    <p class="mt-1 text-xs text-white/40">
      The YouTube video/live URL shown in the homepage's "Featured Broadcast" section. Leave blank to hide that section entirely.
    </p>
    <form method="POST" data-astro-reload class="mt-3">
      <input type="hidden" name="form_section" value="broadcast" />
      <input
        id="featured_broadcast_url"
        type="text"
        name="featured_broadcast_url"
        value={currentBroadcastUrl}
        placeholder="https://www.youtube.com/watch?v=..."
        class="w-full rounded-md border border-white/15 bg-white/5 px-3 py-2 text-sm text-white outline-none focus:border-brand-primary"
      />
      <button
        type="submit"
        class="mt-4 rounded-lg bg-brand-primary px-5 py-2 text-sm font-semibold transition hover:brightness-110"
      >
        Save
      </button>
    </form>
  </section>

  <section class="reveal mt-8" style="transition-delay: 80ms">
    <h2 class="font-semibold">Page Banners</h2>
    <p class="mt-1 max-w-2xl text-xs text-white/40">
      An optional background image for the space between the top nav and each page's own header — the Home entry is
      the homepage's larger hero section instead. Leave a page unset and it just renders plain black, same as before
      any of this existed.
    </p>

    <div class="mt-4 flex flex-col gap-3">
      {BANNER_PAGES.map((page) => {
        const imageUrl = bannerByKey.get(page.key) ?? null;
        return (
          <div class="flex flex-wrap items-center gap-3 rounded-lg bg-white/5 p-3 ring-1 ring-white/10">
            {imageUrl ? (
              <img src={imageUrl} alt="" class="h-10 w-16 flex-none rounded object-cover" />
            ) : (
              <div class="h-10 w-16 flex-none rounded bg-white/10"></div>
            )}
            <div class="min-w-[10rem]">
              <p class="font-semibold">{page.label}</p>
              <p class="text-xs text-white/40">{page.description}</p>
            </div>
            <form method="POST" data-astro-reload enctype="multipart/form-data" class="flex flex-wrap items-center gap-2">
              <input type="hidden" name="form_section" value="banner" />
              <input type="hidden" name="intent" value="save" />
              <input type="hidden" name="page_key" value={page.key} />
              <input
                type="text"
                name="image_url"
                placeholder="Image URL (optional if uploading a file)"
                class="w-56 rounded-md border border-white/15 bg-white/5 px-2 py-1.5 text-xs text-white outline-none focus:border-brand-primary"
              />
              <input
                type="file"
                name="image"
                accept="image/png,image/jpeg,image/webp"
                class="w-56 text-xs text-white/60 file:mr-2 file:rounded-lg file:border-0 file:bg-white/10 file:px-3 file:py-1.5 file:text-xs file:text-white"
              />
              <button
                type="submit"
                class="rounded-lg bg-brand-primary px-3 py-1.5 text-xs font-semibold transition hover:brightness-110"
              >
                Save
              </button>
            </form>
            {imageUrl && (
              <form method="POST" data-astro-reload>
                <input type="hidden" name="form_section" value="banner" />
                <input type="hidden" name="intent" value="delete" />
                <input type="hidden" name="page_key" value={page.key} />
                <button type="submit" class="text-xs font-semibold text-white/40 transition hover:text-brand-pink">Remove</button>
              </form>
            )}
          </div>
        );
      })}
    </div>
  </section>

  <section class="reveal mt-8" style="transition-delay: 100ms">
    <h2 class="font-semibold">Car Logos</h2>
    <p class="mt-1 max-w-2xl text-xs text-white/40">
      Shown next to each driver on race results (and season standings) when a car's logo is configured — same small
      tile + hover-name behavior as team logos. Every car currently assigned to a driver is listed below; add a logo
      for any of them, or add a car by name directly (useful for a car from a past season no current driver uses).
    </p>

    <div class="mt-4 flex flex-col gap-3">
      {allCarNames.length === 0 && <p class="text-sm text-white/40">No results.</p>}
      {allCarNames.map((carName) => {
        const logoUrl = logoByCarName.get(carName) ?? null;
        return (
          <div class="flex flex-wrap items-center gap-3 rounded-lg bg-white/5 p-3 ring-1 ring-white/10">
            {logoUrl ? (
              <img src={logoUrl} alt="" class="h-10 w-10 flex-none rounded object-contain" />
            ) : (
              <div class="h-10 w-10 flex-none rounded bg-white/10"></div>
            )}
            <span class="min-w-[10rem] font-semibold">{carName}</span>
            <form method="POST" data-astro-reload enctype="multipart/form-data" class="flex flex-wrap items-center gap-2">
              <input type="hidden" name="form_section" value="car-logo" />
              <input type="hidden" name="intent" value="save" />
              <input type="hidden" name="car_name" value={carName} />
              <input
                type="text"
                name="logo_url"
                placeholder="Logo URL (optional if uploading a file)"
                class="w-56 rounded-md border border-white/15 bg-white/5 px-2 py-1.5 text-xs text-white outline-none focus:border-brand-primary"
              />
              <input
                type="file"
                name="logo"
                accept="image/png,image/jpeg,image/webp,image/svg+xml"
                class="w-56 text-xs text-white/60 file:mr-2 file:rounded-lg file:border-0 file:bg-white/10 file:px-3 file:py-1.5 file:text-xs file:text-white"
              />
              <button
                type="submit"
                class="rounded-lg bg-brand-primary px-3 py-1.5 text-xs font-semibold transition hover:brightness-110"
              >
                Save
              </button>
            </form>
            {logoUrl && (
              <form method="POST" data-astro-reload>
                <input type="hidden" name="form_section" value="car-logo" />
                <input type="hidden" name="intent" value="delete" />
                <input type="hidden" name="car_name" value={carName} />
                <button type="submit" class="text-xs font-semibold text-white/40 transition hover:text-brand-pink">Remove</button>
              </form>
            )}
          </div>
        );
      })}
    </div>

    <details class="reveal relative mt-4">
      <summary class="cursor-pointer list-none rounded-lg bg-white/5 px-4 py-2 text-sm font-semibold text-white/70 ring-1 ring-white/10 transition hover:bg-white/10">
        Add a car by name
      </summary>
      <form method="POST" data-astro-reload enctype="multipart/form-data" class="mt-3 flex max-w-md flex-col gap-2 rounded-lg border border-white/10 bg-white/[0.03] p-4">
        <input type="hidden" name="form_section" value="car-logo" />
        <input type="hidden" name="intent" value="save" />
        <label class="flex flex-col gap-1.5 text-sm">
          <span class="text-white/60">Car name (must match the results data exactly)</span>
          <input
            type="text"
            name="car_name"
            required
            class="rounded-md border border-white/15 bg-white/5 px-3 py-2 text-white outline-none focus:border-brand-primary"
          />
        </label>
        <label class="flex flex-col gap-1.5 text-sm">
          <span class="text-white/60">Logo URL</span>
          <input
            type="text"
            name="logo_url"
            class="rounded-md border border-white/15 bg-white/5 px-3 py-2 text-white outline-none focus:border-brand-primary"
          />
        </label>
        <label class="flex flex-col gap-1.5 text-sm">
          <span class="text-white/60">Or upload a file</span>
          <input
            type="file"
            name="logo"
            accept="image/png,image/jpeg,image/webp,image/svg+xml"
            class="rounded-md border border-white/15 bg-white/5 px-3 py-2 text-white outline-none file:mr-3 file:rounded-lg file:border-0 file:bg-white/10 file:px-3 file:py-1.5 file:text-white"
          />
        </label>
        <button
          type="submit"
          class="mt-1 self-start rounded-lg bg-brand-primary px-5 py-2 text-sm font-semibold transition hover:brightness-110"
        >
          Add Car Logo
        </button>
      </form>
    </details>
  </section>

  <section class="reveal mt-8" style="transition-delay: 120ms">
    <h2 class="font-semibold">Penalty Offenses</h2>
    <p class="mt-1 max-w-2xl text-xs text-white/40">
      The offense list stewards pick from when logging a penalty on a race result (rulebook section 5, "Post-Race
      Penalties"). "Reference PP" is just a reminder shown next to each offense in that dropdown — several rulebook
      entries are a range or an "or" choice ("+1-4", "Warning or 1"), so it's free text, not a number. It never
      auto-fills the penalty's actual PP; that's always entered by hand on the penalty itself.
    </p>

    <div class="mt-4 flex flex-col gap-2">
      {offenses.length === 0 && <p class="text-sm text-white/40">No results.</p>}
      {offenses.map((o) => (
        <div class="flex flex-wrap items-center gap-3 rounded-lg bg-white/5 p-3 ring-1 ring-white/10">
          <form method="POST" data-astro-reload class="flex flex-1 flex-wrap items-center gap-2">
            <input type="hidden" name="form_section" value="penalty-offense" />
            <input type="hidden" name="intent" value="save" />
            <input type="hidden" name="id" value={o.id} />
            <input
              type="text"
              name="name"
              required
              value={o.name}
              class="min-w-[14rem] flex-1 rounded-md border border-white/15 bg-white/5 px-2 py-1.5 text-sm text-white outline-none focus:border-brand-primary"
            />
            <input
              type="text"
              name="reference_points"
              placeholder="Reference PP, e.g. 1-4"
              value={o.reference_points ?? ''}
              class="w-40 rounded-md border border-white/15 bg-white/5 px-2 py-1.5 text-xs text-white outline-none focus:border-brand-primary"
            />
            <input
              type="number"
              name="sort_order"
              value={o.sort_order}
              title="Sort order"
              class="w-20 rounded-md border border-white/15 bg-white/5 px-2 py-1.5 text-xs text-white outline-none focus:border-brand-primary"
            />
            <button type="submit" class="rounded-lg bg-brand-primary px-3 py-1.5 text-xs font-semibold transition hover:brightness-110">
              Save
            </button>
          </form>
          <form method="POST" data-astro-reload>
            <input type="hidden" name="form_section" value="penalty-offense" />
            <input type="hidden" name="intent" value="delete" />
            <input type="hidden" name="id" value={o.id} />
            <button type="submit" class="text-xs font-semibold text-white/40 transition hover:text-brand-pink">Remove</button>
          </form>
        </div>
      ))}
    </div>

    <details class="reveal relative mt-4">
      <summary class="cursor-pointer list-none rounded-lg bg-white/5 px-4 py-2 text-sm font-semibold text-white/70 ring-1 ring-white/10 transition hover:bg-white/10">
        Add an offense
      </summary>
      <form method="POST" data-astro-reload class="mt-3 flex max-w-md flex-col gap-2 rounded-lg border border-white/10 bg-white/[0.03] p-4">
        <input type="hidden" name="form_section" value="penalty-offense" />
        <input type="hidden" name="intent" value="save" />
        <label class="flex flex-col gap-1.5 text-sm">
          <span class="text-white/60">Offense name</span>
          <input
            type="text"
            name="name"
            required
            class="rounded-md border border-white/15 bg-white/5 px-3 py-2 text-white outline-none focus:border-brand-primary"
          />
        </label>
        <label class="flex flex-col gap-1.5 text-sm">
          <span class="text-white/60">Reference PP (informational only)</span>
          <input
            type="text"
            name="reference_points"
            placeholder="e.g. 1-4, or &quot;Warning or 1&quot;"
            class="rounded-md border border-white/15 bg-white/5 px-3 py-2 text-white outline-none focus:border-brand-primary"
          />
        </label>
        <label class="flex flex-col gap-1.5 text-sm">
          <span class="text-white/60">Sort order</span>
          <input
            type="number"
            name="sort_order"
            value="0"
            class="rounded-md border border-white/15 bg-white/5 px-3 py-2 text-white outline-none focus:border-brand-primary"
          />
        </label>
        <button type="submit" class="mt-1 self-start rounded-lg bg-brand-primary px-5 py-2 text-sm font-semibold transition hover:brightness-110">
          Add Offense
        </button>
      </form>
    </details>
  </section>
</AdminLayout>
