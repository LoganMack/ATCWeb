---
export const prerender = false;

import AdminLayout from '../../layouts/AdminLayout.astro';

// Same shell-then-spinner split as the public site's awards.astro/
// champions.astro/etc. (see admin/fragment.astro's own top-of-file comment)
// — this page used to await seven-plus parallel Supabase queries (every
// driver/team/news/event/circuit/season/organization row, plus page-view
// stats and two more counts) right here before sending any HTML, so opening
// /admin always meant a blank page for however long that round-trip took.
// Now the shell renders instantly with a loading-cards skeleton below, and
// admin/fragment.astro is fetched client-side for the actual dashboard, per
// Logan ("add the loading cards animation to the admin panel so we can
// access it faster").
---

<AdminLayout title="Dashboard">
  <h1 class="reveal font-display text-4xl">Dashboard</h1>

  <div data-admin-dashboard data-fragment-url="/admin/fragment">
    <div class="mt-8 flex flex-col gap-8" aria-live="polite" aria-busy="true">
      <span class="sr-only">Loading Dashboard…</span>
      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        <div class="h-20 animate-pulse rounded-xl border border-white/10 bg-white/[0.03]"></div>
        <div class="h-20 animate-pulse rounded-xl border border-white/10 bg-white/[0.03]"></div>
        <div class="h-20 animate-pulse rounded-xl border border-white/10 bg-white/[0.03]"></div>
        <div class="h-20 animate-pulse rounded-xl border border-white/10 bg-white/[0.03]"></div>
        <div class="h-20 animate-pulse rounded-xl border border-white/10 bg-white/[0.03]"></div>
        <div class="h-20 animate-pulse rounded-xl border border-white/10 bg-white/[0.03]"></div>
        <div class="h-20 animate-pulse rounded-xl border border-white/10 bg-white/[0.03]"></div>
      </div>
      <div class="h-10 w-40 animate-pulse rounded-lg border border-white/10 bg-white/[0.03]"></div>
      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        <div class="h-20 animate-pulse rounded-xl border border-white/10 bg-white/[0.03]"></div>
        <div class="h-20 animate-pulse rounded-xl border border-white/10 bg-white/[0.03]"></div>
        <div class="h-20 animate-pulse rounded-xl border border-white/10 bg-white/[0.03]"></div>
        <div class="h-20 animate-pulse rounded-xl border border-white/10 bg-white/[0.03]"></div>
        <div class="h-20 animate-pulse rounded-xl border border-white/10 bg-white/[0.03]"></div>
        <div class="h-20 animate-pulse rounded-xl border border-white/10 bg-white/[0.03]"></div>
        <div class="h-20 animate-pulse rounded-xl border border-white/10 bg-white/[0.03]"></div>
        <div class="h-20 animate-pulse rounded-xl border border-white/10 bg-white/[0.03]"></div>
      </div>
    </div>
  </div>

  <script>
    // Same fetch-fragment-then-drop-in pattern as awards.astro/
    // champions.astro/team-stats.astro — see admin/fragment.astro's own
    // top-of-file comment for the full reasoning (reveal.ts re-dispatch
    // included).

    // Reads a fragment response's HTML. If the admin session expired (or the
    // user lost admin) while this page sat open, middleware answers the
    // fragment request with a 302 to /login, which fetch() follows silently —
    // so a "successful" response would be the entire login page, dropped
    // into the dashboard. Reload instead: middleware then redirects this
    // real page to /login?next=/admin. The never-settling promise stops the
    // caller's .then/.catch from flashing anything while the reload happens.
    function fragmentHtml(res: Response, label: string): Promise<string> {
      if (res.redirected) {
        window.location.reload();
        return new Promise<never>(() => {});
      }
      if (!res.ok) throw new Error(`${label} fragment request failed (${res.status})`);
      return res.text();
    }

    function initAdminDashboard() {
      const container = document.querySelector<HTMLElement>('[data-admin-dashboard]');
      const url = container?.dataset.fragmentUrl;
      if (!container || !url) return;
      delete container.dataset.fragmentUrl;

      fetch(url)
        .then((res) => fragmentHtml(res, 'Admin dashboard'))
        .then((html) => {
          container.innerHTML = html;
          document.dispatchEvent(new Event('astro:page-load'));
        })
        .catch((err) => {
          console.error('Failed to load admin dashboard:', err);
          container.innerHTML = '<p class="mt-10 text-white/60">Couldn’t load the dashboard right now — try refreshing the page.</p>';
        });
    }

    document.addEventListener('astro:page-load', initAdminDashboard);

    // "Load Analytics" — the button arrives inside the dashboard fragment's
    // innerHTML (whose own <script>s would never run), so it's handled here
    // by delegation. Registered once at module level: this bundled script
    // only executes once per full page load, and a document-level listener
    // survives view-transition navigations, so re-adding it on every
    // astro:page-load would stack duplicate handlers.
    document.addEventListener('click', (event) => {
      const button = (event.target as Element | null)?.closest<HTMLButtonElement>('[data-load-analytics]');
      const container = button?.closest<HTMLElement>('[data-admin-analytics]');
      const url = container?.dataset.fragmentUrl;
      if (!button || !container || !url) return;

      button.disabled = true;
      button.textContent = 'Loading Analytics…';
      container.setAttribute('aria-busy', 'true');
      container.querySelector('[data-analytics-error]')?.remove();

      fetch(url)
        .then((res) => fragmentHtml(res, 'Analytics'))
        .then((html) => {
          container.innerHTML = html;
        })
        .catch((err) => {
          console.error('Failed to load analytics:', err);
          button.disabled = false;
          button.textContent = 'Retry Loading Analytics';
          const message = document.createElement('p');
          message.dataset.analyticsError = '';
          message.className = 'mt-3 text-sm text-white/50';
          message.textContent = 'Couldn’t load analytics — the query failed or timed out. Try again, or check the server log for the exact error.';
          container.append(message);
        })
        .finally(() => container.removeAttribute('aria-busy'));
    });
  </script>
</AdminLayout>
