---
export const prerender = false;

import AdminLayout from '../../layouts/AdminLayout.astro';
import { resolveSupabaseEnv } from '../../lib/db/client';
import { requireAdmin } from '../../lib/auth';
import { handleEmailTemplateForm } from '../../lib/notifications/emailTemplates';

// Dashboard shell: renders at once with a skeleton and fetches admin/fragment.astro for the dashboard.

const admin = requireAdmin(Astro);
if (admin instanceof Response) return admin;

// The Email section's template forms (FR2.1, FR2.5) post here; RLS decides who may write (BR2.1).
if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const intent = String(form.get('intent') ?? '');
  if (intent === 'save-email-template' || intent === 'reset-email-template') {
    const query = await handleEmailTemplateForm(resolveSupabaseEnv(Astro.locals), admin.accessToken, intent, form);
    return Astro.redirect(`/admin${query}`, 303);
  }
  return Astro.redirect('/admin', 303);
}

// The save outcome rides on the redirect's query; only its own keys are passed on to the fragment.
const FLASH_KEYS = ['email', 'kind', 'field', 'reason', 'ph'];
const flashParams = new URLSearchParams();
for (const key of FLASH_KEYS) {
  const value = Astro.url.searchParams.get(key);
  if (value) flashParams.set(key, value.slice(0, 60));
}
const flashQuery = flashParams.toString();
const fragmentUrl = flashQuery ? `/admin/fragment?${flashQuery}` : '/admin/fragment';
---

<AdminLayout title="Dashboard">
  <div data-admin-dashboard data-fragment-url={fragmentUrl}>
    <div class="flex flex-col gap-8" aria-live="polite" aria-busy="true">
      <span class="sr-only">Loading Dashboard…</span>
      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        <div class="h-20 animate-pulse rounded-xl border border-white/10 bg-white/[0.03]"></div>
        <div class="h-20 animate-pulse rounded-xl border border-white/10 bg-white/[0.03]"></div>
        <div class="h-20 animate-pulse rounded-xl border border-white/10 bg-white/[0.03]"></div>
      </div>
      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        <div class="h-20 animate-pulse rounded-xl border border-white/10 bg-white/[0.03]"></div>
        <div class="h-20 animate-pulse rounded-xl border border-white/10 bg-white/[0.03]"></div>
        <div class="h-20 animate-pulse rounded-xl border border-white/10 bg-white/[0.03]"></div>
      </div>
      <div class="flex flex-wrap gap-3">
        <div class="h-14 w-14 animate-pulse rounded-xl border border-white/10 bg-white/[0.03]"></div>
        <div class="h-14 w-14 animate-pulse rounded-xl border border-white/10 bg-white/[0.03]"></div>
        <div class="h-14 w-14 animate-pulse rounded-xl border border-white/10 bg-white/[0.03]"></div>
        <div class="h-14 w-14 animate-pulse rounded-xl border border-white/10 bg-white/[0.03]"></div>
        <div class="h-14 w-14 animate-pulse rounded-xl border border-white/10 bg-white/[0.03]"></div>
        <div class="h-14 w-14 animate-pulse rounded-xl border border-white/10 bg-white/[0.03]"></div>
      </div>
    </div>
  </div>

  <script>
    import { bindFragment, hashScroll, reloadOnRedirect } from '../../scripts/fragmentLoader';
    import { bindEmailTemplatePreviews } from '../../scripts/emailTemplatePreview';

    bindFragment('[data-admin-dashboard]', {
      label: 'Admin dashboard',
      logMessage: 'Failed to load admin dashboard:',
      errorHtml:
        '<p class="mt-10 text-white/60">Couldn’t load the dashboard right now — try refreshing the page.</p>',
      checkResponse: reloadOnRedirect,
      afterDispatch: hashScroll,
    });
    bindEmailTemplatePreviews();

    // If the session expired, middleware redirects the fragment request to /login and fetch() follows
    // silently, so the body would be the login page. Reload instead; the never-settling promise keeps
    // anything from flashing.
    function fragmentHtml(res: Response, label: string): Promise<string> {
      if (res.redirected) {
        window.location.reload();
        return new Promise<never>(() => {});
      }
      if (!res.ok) throw new Error(`${label} fragment request failed (${res.status})`);
      return res.text();
    }

    // The analytics range buttons arrive in fragment HTML, whose scripts never run, so one document-level
    // listener handles them; registered once, since it survives navigations.
    document.addEventListener('click', (event) => {
      const button = (event.target as Element | null)?.closest<HTMLButtonElement>('[data-load-analytics]');
      const section = button?.closest<HTMLElement>('[data-analytics-section]');
      const container = section?.querySelector<HTMLElement>('[data-admin-analytics]');
      const url = container?.dataset.fragmentUrl;
      const range = button?.dataset.loadAnalytics;
      if (!button || !section || !container || !url || !range) return;

      // All buttons locked while one window loads, so two responses can't
      // race each other into the container.
      const buttons = Array.from(section.querySelectorAll<HTMLButtonElement>('[data-load-analytics]'));
      const label = button.textContent ?? '';
      buttons.forEach((b) => (b.disabled = true));
      button.textContent = 'Loading…';
      container.setAttribute('aria-busy', 'true');
      container.classList.add('opacity-50');

      fetch(`${url}?range=${encodeURIComponent(range)}`)
        .then((res) => fragmentHtml(res, 'Analytics'))
        .then((html) => {
          container.innerHTML = html;
          buttons.forEach((b) => (b.dataset.active = String(b === button)));
        })
        .catch((err) => {
          console.error('Failed to load analytics:', err);
          // Clear any previously loaded window's charts too, rather than
          // leaving them under a message about a different window failing.
          buttons.forEach((b) => delete b.dataset.active);
          const message = document.createElement('p');
          message.className = 'mt-4 text-sm text-white/50';
          message.textContent = 'Couldn’t load analytics — the query failed or timed out. Try again, or check the server log for the exact error.';
          container.replaceChildren(message);
        })
        .finally(() => {
          buttons.forEach((b) => (b.disabled = false));
          button.textContent = label;
          container.removeAttribute('aria-busy');
          container.classList.remove('opacity-50');
        });
    });
  </script>
</AdminLayout>
