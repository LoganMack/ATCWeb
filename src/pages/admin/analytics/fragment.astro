---
export const prerender = false;

import StatBlock from '../../../components/StatBlock.astro';
import { resolveSupabaseEnv } from '../../../lib/db/client';
import { getPageViewStats } from '../../../lib/db/analytics';
import { resolveAnalyticsRange } from '../../../lib/analyticsRanges';
import { requireAdmin } from '../../../lib/auth';

const admin = requireAdmin(Astro);
if (admin instanceof Response) return admin;

/**
 * The dashboard's Site Analytics block as a fragment, loaded only when an admin picks a window (`?range=`,
 * src/lib/analyticsRanges.ts), so get_page_view_stats() no longer delays every /admin visit. Never linked
 * directly.
 */

const supabaseEnv = resolveSupabaseEnv(Astro.locals);
const accessToken = admin.accessToken;

const range = resolveAnalyticsRange(Astro.url.searchParams.get('range'));
const pageViewStats = await getPageViewStats(supabaseEnv, accessToken, range.days);

// getPageViewStats returns null on any failure, so answer with an error status and the dashboard shows its
// retry message.
if (!pageViewStats) {
  return new Response('Analytics unavailable', { status: 503 });
}

// Pre-0103 databases don't return the window totals; at the default 30-day
// window those are exactly visitors30d/views30d.
const visitorsInRange = pageViewStats.visitorsRange ?? pageViewStats.visitors30d;
const viewsInRange = pageViewStats.viewsRange ?? pageViewStats.views30d;

// --- Site analytics display helpers --------------------------------------

/** ISO 3166-1 alpha-2 -> readable name via the platform's own locale data (Intl.DisplayNames) — no hardcoded country-name table to maintain. Falls back to the raw code for anything it can't resolve (e.g. Cloudflare's "T1" for Tor exit traffic, or the "Unknown" bucket the RPC already labels itself). */
function countryName(code: string): string {
  if (!code || code === 'Unknown') return 'Unknown';
  try {
    return new Intl.DisplayNames(['en'], { type: 'region' }).of(code) ?? code;
  } catch {
    return code;
  }
}

function formatHour(hour: number): string {
  const period = hour < 12 ? 'AM' : 'PM';
  const h12 = hour % 12 === 0 ? 12 : hour % 12;
  return `${h12}${period}`;
}

const topCountries = pageViewStats?.topCountries ?? [];
const maxCountryVisitors = Math.max(1, ...topCountries.map((c) => c.visitors));
const hourly = pageViewStats?.hourly ?? [];
const maxHourlyViews = Math.max(1, ...hourly.map((h) => h.views));
const hourlyToday = pageViewStats?.hourlyToday ?? [];
const maxHourlyTodayViews = Math.max(1, ...hourlyToday.map((h) => h.views));
const topPages = pageViewStats?.topPages ?? [];
const maxPageViews = Math.max(1, ...topPages.map((p) => p.views));
const topErrors = pageViewStats?.topErrors ?? [];
const maxErrorOccurrences = Math.max(1, ...topErrors.map((e) => e.occurrences));
// No Cache-Control: per-admin data, like every /admin page.
---

<div class="mt-4 space-y-6">
  <div class="rounded-xl border border-white/10 bg-brand-ink p-5">
    <dl class="grid grid-cols-1 gap-x-4 gap-y-5 sm:grid-cols-3">
      <StatBlock
        label="Visitors Today"
        value={pageViewStats.visitorsToday}
        sub={`${pageViewStats.viewsToday} page view${pageViewStats.viewsToday === 1 ? '' : 's'}`}
      />
      <StatBlock
        label="Visitors (7 days)"
        value={pageViewStats.visitors7d}
        sub={`${pageViewStats.views7d} page views`}
      />
      <StatBlock
        label={`Visitors (${range.title})`}
        value={visitorsInRange}
        sub={`${viewsInRange} page view${viewsInRange === 1 ? '' : 's'}`}
      />
    </dl>
  </div>

  <div class="grid gap-4 lg:grid-cols-2">
    <div class="rounded-xl border border-white/10 bg-brand-ink p-5">
      <h3 class="text-xs uppercase tracking-wide text-white/40">Top Regions ({range.title})</h3>
      {topCountries.length > 0 ? (
        <ul class="mt-3 space-y-2.5">
          {topCountries.map((c) => (
            <li>
              <div class="flex items-center justify-between text-sm">
                <span class="text-white/80">{countryName(c.country)}</span>
                <span class="text-white/50">{c.visitors}</span>
              </div>
              <div class="mt-1 h-1.5 rounded-full bg-white/5">
                <div
                  class="h-1.5 rounded-full bg-brand-primary text-fixed-white"
                  style={`width: ${Math.max(4, Math.round((c.visitors / maxCountryVisitors) * 100))}%`}
                />
              </div>
            </li>
          ))}
        </ul>
      ) : (
        <p class="mt-3 text-sm text-white/40">No visits recorded yet.</p>
      )}
    </div>

    <div class="rounded-xl border border-white/10 bg-brand-ink p-5">
      {/* Today's hourly traffic (hourlyToday, 0083) above the window's chart, so today's shape isn't
         averaged away. */}
      <h3 class="text-xs uppercase tracking-wide text-white/40">Traffic by Hour (Today, ET)</h3>
      <div class="mt-4 flex h-24 items-stretch gap-1">
        {hourlyToday.map((h) => (
          <div class="relative h-full flex-1 rounded-t bg-white/5">
            <div
              class="absolute bottom-0 w-full rounded-t bg-brand-primary/70 transition hover:bg-brand-primary"
              style={`height: ${Math.round((h.views / maxHourlyTodayViews) * 100)}%`}
              title={`${formatHour(h.hour)} ET — ${h.views} view${h.views === 1 ? '' : 's'}`}
            />
          </div>
        ))}
      </div>
      <div class="mt-1 flex justify-between text-[10px] text-white/30">
        <span>12am</span>
        <span>6am</span>
        <span>12pm</span>
        <span>6pm</span>
        <span>12am</span>
      </div>

      <h3 class="mt-5 border-t border-white/10 pt-4 text-xs uppercase tracking-wide text-white/40">Traffic by Hour ({range.title}, ET)</h3>
      <div class="mt-4 flex h-24 items-stretch gap-1">
        {hourly.map((h) => (
          <div class="relative h-full flex-1 rounded-t bg-white/5">
            <div
              class="absolute bottom-0 w-full rounded-t bg-brand-primary/70 transition hover:bg-brand-primary"
              style={`height: ${Math.round((h.views / maxHourlyViews) * 100)}%`}
              title={`${formatHour(h.hour)} ET — ${h.views} view${h.views === 1 ? '' : 's'}`}
            />
          </div>
        ))}
      </div>
      <div class="mt-1 flex justify-between text-[10px] text-white/30">
        <span>12am</span>
        <span>6am</span>
        <span>12pm</span>
        <span>6pm</span>
        <span>12am</span>
      </div>
    </div>
  </div>

  <div class="grid gap-4 lg:grid-cols-2">
    <div class="rounded-xl border border-white/10 bg-brand-ink p-5">
      <h3 class="text-xs uppercase tracking-wide text-white/40">Most Popular Pages by Views ({range.title})</h3>
      {topPages.length > 0 ? (
        <ul class="mt-3 space-y-2.5">
          {topPages.map((p) => (
            <li>
              <div class="flex items-center justify-between gap-3 text-sm">
                <span class="truncate text-white/80" title={p.path}>{p.path}</span>
                <span class="shrink-0 text-white/50">{p.views}</span>
              </div>
              <div class="mt-1 h-1.5 rounded-full bg-white/5">
                <div
                  class="h-1.5 rounded-full bg-brand-primary text-fixed-white"
                  style={`width: ${Math.max(4, Math.round((p.views / maxPageViews) * 100))}%`}
                />
              </div>
            </li>
          ))}
        </ul>
      ) : (
        <p class="mt-3 text-sm text-white/40">No page views recorded yet.</p>
      )}
    </div>

    <div class="rounded-xl border border-white/10 bg-brand-ink p-5">
      <h3 class="text-xs uppercase tracking-wide text-white/40">Most Common Errors ({range.title})</h3>
      {topErrors.length > 0 ? (
        <ul class="mt-3 space-y-2.5">
          {topErrors.map((e) => (
            <li>
              <div class="flex items-center justify-between gap-3 text-sm">
                <span class="truncate text-white/80" title={e.path}>
                  <span class="mr-1.5 rounded bg-red-500/20 px-1.5 py-0.5 text-xs font-semibold text-red-300">{e.status}</span>
                  {e.path}
                </span>
                <span class="shrink-0 text-white/50">{e.occurrences}</span>
              </div>
              <div class="mt-1 h-1.5 rounded-full bg-white/5">
                <div
                  class="h-1.5 rounded-full bg-red-400/70"
                  style={`width: ${Math.max(4, Math.round((e.occurrences / maxErrorOccurrences) * 100))}%`}
                />
              </div>
            </li>
          ))}
        </ul>
      ) : (
        <p class="mt-3 text-sm text-white/40">No errors recorded {range.emptyErrors}.</p>
      )}
    </div>
  </div>
</div>
