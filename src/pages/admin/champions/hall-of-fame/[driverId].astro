---
export const prerender = false;

import AdminLayout from '../../../../layouts/AdminLayout.astro';
import {
  resolveSupabaseEnv,
  getDriverById,
  getHallOfFamePhotos,
  upsertHallOfFamePhoto,
  deleteHallOfFamePhoto,
  uploadToStorage,
  displayDriverName,
} from '../../../../lib/supabase';

const supabaseEnv = resolveSupabaseEnv(Astro.locals);
const accessToken = Astro.locals.session!.accessToken;
const { driverId } = Astro.params;

function extFromFile(file: File): string {
  const fromName = file.name.split('.').pop();
  if (fromName && fromName.length <= 5) return fromName.toLowerCase();
  const map: Record<string, string> = {
    'image/png': 'png',
    'image/jpeg': 'jpg',
    'image/webp': 'webp',
    'image/svg+xml': 'svg',
  };
  return map[file.type] ?? 'png';
}

let error: string | null = null;

const driver = driverId ? await getDriverById(supabaseEnv, driverId) : null;

if (!driver || !driver.is_hall_of_fame) {
  return Astro.redirect('/admin/champions', 302);
}

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const intent = String(form.get('intent') ?? 'upload');

  if (intent === 'delete') {
    const photoId = String(form.get('photo_id') ?? '');
    if (photoId) {
      try {
        await deleteHallOfFamePhoto(supabaseEnv, accessToken, photoId);
      } catch (err) {
        console.error('Failed to delete Hall of Fame photo:', err);
        error = 'Failed to delete that photo.';
      }
    }
  } else {
    const slot = Number(form.get('slot') ?? -1);
    const file = form.get('photo');
    if (slot >= 0 && slot < 5 && file instanceof File && file.size > 0) {
      try {
        const path = `hall-of-fame-${driver.id}-${slot}-${Date.now()}.${extFromFile(file)}`;
        const image_url = await uploadToStorage(supabaseEnv, accessToken, 'photos', path, file);
        await upsertHallOfFamePhoto(supabaseEnv, accessToken, {
          driver_id: driver.id,
          image_url,
          sort_order: slot,
        });
      } catch (err) {
        console.error('Failed to upload Hall of Fame photo:', err);
        error = 'Failed to upload that photo.';
      }
    }
  }

  // PRG pattern — see admin/champions/[seasonId]/[classId].astro for why
  // this redirect (rather than falling through to a plain re-render) is
  // required by hard-form-submit.ts.
  if (!error) {
    return Astro.redirect(Astro.url.pathname, 302);
  }
}

const photos = await getHallOfFamePhotos(supabaseEnv, driver.id);
const photoBySlot = [0, 1, 2, 3, 4].map((slot) => photos.find((p) => p.sort_order === slot) ?? null);
const driverName = displayDriverName(driver.name);
---

<AdminLayout title={`${driverName} — Hall of Fame Photos`}>
  <a href="/admin/champions" class="text-sm text-white/50 hover:text-white">&larr; Back to Photo Management</a>

  <h1 class="reveal mt-3 font-display text-4xl" style="transition-delay: 40ms">
    {driverName}
  </h1>
  <p class="reveal mt-2 text-sm text-white/60" style="transition-delay: 60ms">
    Up to 5 photos shown on this driver's Hall of Fame entry.
  </p>

  {error && (
    <p class="reveal mt-6 rounded-lg border border-brand-pink/30 bg-brand-pink/10 p-4 text-sm text-white/80">{error}</p>
  )}

  <div class="reveal mt-8 grid gap-6 sm:grid-cols-3 lg:grid-cols-5" style="transition-delay: 80ms">
    {photoBySlot.map((photo, slot) => (
      <div class="rounded-xl border border-white/10 p-4">
        <p class="text-xs uppercase tracking-wide text-white/40">Photo {slot + 1}</p>
        {photo ? (
          <button
            type="button"
            data-lightbox
            data-lightbox-src={photo.image_url}
            data-lightbox-alt={`${driverName} — photo ${slot + 1}`}
            class="group relative mt-3 block aspect-video w-full overflow-hidden rounded-md bg-white/5"
            aria-label={`Enlarge photo ${slot + 1}`}
          >
            <img
              src={photo.image_url}
              alt=""
              class="h-full w-full object-cover transition group-hover:scale-105"
            />
          </button>
        ) : (
          <div class="mt-3 flex aspect-video w-full items-center justify-center rounded-md bg-white/5 text-xs text-white/30">
            No photo
          </div>
        )}

        <form method="POST" data-astro-reload enctype="multipart/form-data" class="mt-3 flex flex-col gap-2">
          <input type="hidden" name="slot" value={slot} />
          <input
            type="file"
            name="photo"
            accept="image/png,image/jpeg,image/webp"
            class="w-full text-xs text-white/60 file:mr-2 file:rounded-lg file:border-0 file:bg-white/10 file:px-3 file:py-1.5 file:text-xs file:text-white"
          />
          <button
            type="submit"
            class="rounded-lg bg-brand-primary px-3 py-1.5 text-xs font-semibold transition hover:brightness-110"
          >
            {photo ? 'Replace' : 'Upload'}
          </button>
        </form>

        {photo && (
          <form method="POST" data-astro-reload class="mt-2">
            <input type="hidden" name="intent" value="delete" />
            <input type="hidden" name="photo_id" value={photo.id} />
            <button
              type="submit"
              data-confirm="Remove this photo?"
              class="rounded-lg bg-white/5 px-3 py-1.5 text-xs font-semibold text-white/70 ring-1 ring-white/10 transition hover:bg-white/10"
            >
              Remove
            </button>
          </form>
        )}
      </div>
    ))}
  </div>
</AdminLayout>

<script>
  document.addEventListener('astro:page-load', () => {
    document.querySelectorAll<HTMLButtonElement>('[data-confirm]').forEach((btn) => {
      btn.addEventListener('click', (e) => {
        if (!confirm(btn.dataset.confirm || 'Are you sure?')) e.preventDefault();
      });
    });
  });
</script>
