---
export const prerender = false;

import AdminLayout from '../../../layouts/AdminLayout.astro';
import {
  resolveSupabaseEnv,
  getDriverClasses,
  getSeasons,
  getChampionPhotosForClass,
  getHallOfFameDrivers,
  getAllHallOfFamePhotos,
  displayDriverName,
} from '../../../lib/supabase';
import { getChampions, driversSelect } from '../../../lib/results';

const supabaseEnv = resolveSupabaseEnv(Astro.locals);

let classes: Awaited<ReturnType<typeof getDriverClasses>> = [];
let seasons: Awaited<ReturnType<typeof getSeasons>> = [];
let loadError: string | null = null;
try {
  [classes, seasons] = await Promise.all([getDriverClasses(supabaseEnv), getSeasons(supabaseEnv)]);
} catch (err) {
  console.error('Failed to load admin champions filters:', err);
  loadError = err instanceof Error ? err.message : String(err);
}

// Hall of Fame members section — separate from the season/class champion
// photo management below (Hall of Fame photos are scoped per-driver, not
// per-season/class; see hall_of_fame_photos vs champion_photos).
let hofError: string | null = null;
let hofMembers: { id: string; name: string; photoCount: number }[] = [];
try {
  const [hofDrivers, allDrivers, hofPhotos] = await Promise.all([
    getHallOfFameDrivers(supabaseEnv),
    driversSelect(supabaseEnv),
    getAllHallOfFamePhotos(supabaseEnv),
  ]);
  const driverById = new Map(allDrivers.map((d) => [d.id, d]));
  const photoCountByDriver = new Map<string, number>();
  for (const photo of hofPhotos) {
    photoCountByDriver.set(photo.driver_id, (photoCountByDriver.get(photo.driver_id) ?? 0) + 1);
  }
  hofMembers = hofDrivers
    .map((h) => {
      const driver = driverById.get(h.id);
      return driver
        ? { id: driver.id, name: displayDriverName(driver.name), photoCount: photoCountByDriver.get(driver.id) ?? 0 }
        : null;
    })
    .filter((m): m is { id: string; name: string; photoCount: number } => m !== null)
    .sort((a, b) => a.name.localeCompare(b.name));
} catch (err) {
  console.error('Failed to load Hall of Fame members for admin:', err);
  hofError = err instanceof Error ? err.message : String(err);
}

// Gamma/Delta didn't exist for every season (seasons.gamma_enabled/
// delta_enabled, 0037_class_and_scoring_fixes.sql) — same gating champions.astro
// / champions/fragment.astro already apply to the public Champions page.
// This admin page was missing it, which let e.g. a Delta season-3 "champion"
// show up here (and offer photo upload for it) even though Delta didn't
// exist until ATC5. Kept in sync by hand with the other two copies, same
// convention as those files already establish for this exact helper.
function classIsEnabledFor(className: string, season: Awaited<ReturnType<typeof getSeasons>>[number]): boolean {
  if (className === 'Gamma') return season.gamma_enabled;
  if (className === 'Delta') return season.delta_enabled;
  return true;
}

const requestedClassName = Astro.url.searchParams.get('class');
const activeClass = classes.find((c) => c.name === requestedClassName) ?? classes.find((c) => c.name === 'Alpha') ?? classes[0];

let champions: Awaited<ReturnType<typeof getChampions>> = [];
let photoCountBySeason = new Map<string, number>();
if (!loadError && activeClass) {
  try {
    const eligibleSeasons = seasons.filter((s) => classIsEnabledFor(activeClass.name, s));
    const [championsResult, photos] = await Promise.all([
      getChampions(supabaseEnv, eligibleSeasons, activeClass.id),
      getChampionPhotosForClass(supabaseEnv, activeClass.id),
    ]);
    champions = championsResult;
    for (const photo of photos) {
      photoCountBySeason.set(photo.season_id, (photoCountBySeason.get(photo.season_id) ?? 0) + 1);
    }
  } catch (err) {
    console.error('Failed to compute champions for admin:', err);
    loadError = err instanceof Error ? err.message : String(err);
  }
}
---

<AdminLayout title="Photo Management">
  <h1 class="reveal font-display text-4xl">Photo Management</h1>
  <p class="reveal mt-2 text-sm text-white/60" style="transition-delay: 60ms">
    The champion for each season/class is computed automatically from race results — this page is just for uploading
    the (up to 5) photos shown on the public Champions and Hall of Fame pages. Standings look off? Fix it at the
    source data (race_scores / curated_race_results), not here. To add or remove Hall of Fame members themselves,
    use the "Hall of Fame member" toggle on a driver's admin profile.
  </p>

  <h2 class="reveal mt-10 font-display text-2xl" style="transition-delay: 70ms">Hall of Fame</h2>

  {hofError && (
    <p class="reveal mt-4 rounded-lg border border-brand-pink/30 bg-brand-pink/10 p-4 text-sm text-white/80">
      Couldn't load Hall of Fame members.
      <br /><span class="mt-1 block text-white/50">{hofError}</span>
    </p>
  )}

  {!hofError && hofMembers.length === 0 && (
    <p class="reveal mt-4 text-sm text-white/60" style="transition-delay: 90ms">No Hall of Fame members yet.</p>
  )}

  {!hofError && hofMembers.length > 0 && (
    <div class="reveal mt-4 divide-y divide-white/10 rounded-xl border border-white/10" style="transition-delay: 90ms">
      {hofMembers.map((m) => (
        <a
          href={`/admin/champions/hall-of-fame/${m.id}`}
          class="flex flex-wrap items-center justify-between gap-2 px-6 py-4 transition hover:bg-white/[0.03]"
        >
          <p class="font-semibold">{m.name}</p>
          <span class="text-sm text-white/50">{m.photoCount} / 5 photos</span>
        </a>
      ))}
    </div>
  )}

  <h2 class="reveal mt-10 font-display text-2xl" style="transition-delay: 100ms">Champions</h2>

  {loadError && (
    <p class="reveal mt-6 rounded-lg border border-brand-pink/30 bg-brand-pink/10 p-4 text-sm text-white/80">
      Couldn't load champions.
      <br /><span class="mt-1 block text-white/50">{loadError}</span>
    </p>
  )}

  {!loadError && (
    <div class="reveal mt-6 flex flex-wrap gap-2" style="transition-delay: 80ms">
      {classes.map((c) => (
        <a
          href={`/admin/champions?class=${encodeURIComponent(c.name)}`}
          class={`rounded-lg px-4 py-1.5 text-sm font-semibold ring-1 ring-white/15 transition ${
            c.id === activeClass?.id ? 'bg-white text-brand-ink' : 'text-white/80 hover:bg-white/10'
          }`}
        >
          {c.name}
        </a>
      ))}
    </div>
  )}

  {!loadError && champions.length === 0 && (
    <p class="reveal mt-8 text-sm text-white/60" style="transition-delay: 100ms">
      No results.
    </p>
  )}

  {!loadError && champions.length > 0 && (
    <div class="reveal mt-6 divide-y divide-white/10 rounded-xl border border-white/10" style="transition-delay: 100ms">
      {champions.map((entry) => (
        <a
          href={`/admin/champions/${entry.season.id}/${activeClass!.id}`}
          class="flex flex-wrap items-center justify-between gap-2 px-6 py-4 transition hover:bg-white/[0.03]"
        >
          <div>
            <p class="font-semibold">{entry.season.name}</p>
            <p class="text-sm text-white/50">{displayDriverName(entry.standing.driver.name)} · {entry.standing.totalPoints} pts</p>
          </div>
          <span class="text-sm text-white/50">{photoCountBySeason.get(entry.season.id) ?? 0} / 5 photos</span>
        </a>
      ))}
    </div>
  )}
</AdminLayout>
