---
// Photo Management (Champions/Hall of Fame index) was merged into Site
// Properties — kept as a redirect for anyone with an old bookmark/link. The
// per-season/per-driver photo-upload subpages this index used to link to
// ([seasonId]/[classId].astro, hall-of-fame/[driverId].astro) are unchanged
// and still live under /admin/champions/.
export const prerender = false;
return Astro.redirect('/admin/site-properties#champions', 301);
