---
export const prerender = false;

import AdminLayout from '../../../../layouts/AdminLayout.astro';
import {
  resolveSupabaseEnv,
  getSeasonById,
  getDriverClasses,
  getChampionPhotos,
  upsertChampionPhoto,
  deleteChampionPhoto,
  uploadToStorage,
} from '../../../../lib/supabase';
import { computeSeasonStandings } from '../../../../lib/results';

const supabaseEnv = resolveSupabaseEnv(Astro.locals);
const accessToken = Astro.locals.session!.accessToken;
const { seasonId, classId: classIdParam } = Astro.params;
const classId = Number(classIdParam);

function extFromFile(file: File): string {
  const fromName = file.name.split('.').pop();
  if (fromName && fromName.length <= 5) return fromName.toLowerCase();
  const map: Record<string, string> = {
    'image/png': 'png',
    'image/jpeg': 'jpg',
    'image/webp': 'webp',
    'image/svg+xml': 'svg',
  };
  return map[file.type] ?? 'png';
}

let error: string | null = null;

const season = seasonId ? await getSeasonById(supabaseEnv, seasonId) : null;
const classes = await getDriverClasses(supabaseEnv);
const driverClass = classes.find((c) => c.id === classId);

if (!season || !driverClass) {
  return Astro.redirect('/admin/champions', 302);
}

const standings = await computeSeasonStandings(supabaseEnv, season, classId);
const champion = standings[0] ?? null;

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const intent = String(form.get('intent') ?? 'upload');

  if (intent === 'delete') {
    const photoId = String(form.get('photo_id') ?? '');
    if (photoId) {
      try {
        await deleteChampionPhoto(supabaseEnv, accessToken, photoId);
      } catch (err) {
        console.error('Failed to delete champion photo:', err);
        error = 'Failed to delete that photo.';
      }
    }
  } else if (champion) {
    const slot = Number(form.get('slot') ?? -1);
    const file = form.get('photo');
    if (slot >= 0 && slot < 3 && file instanceof File && file.size > 0) {
      try {
        const path = `champion-${season.id}-${classId}-${slot}-${Date.now()}.${extFromFile(file)}`;
        const image_url = await uploadToStorage(supabaseEnv, accessToken, 'photos', path, file);
        await upsertChampionPhoto(supabaseEnv, accessToken, {
          season_id: season.id,
          class_id: classId,
          driver_id: champion.driver.id,
          image_url,
          sort_order: slot,
        });
      } catch (err) {
        console.error('Failed to upload champion photo:', err);
        error = 'Failed to upload that photo.';
      }
    }
  }
}

const photos = await getChampionPhotos(supabaseEnv, season.id, classId);
const photoBySlot = [0, 1, 2].map((slot) => photos.find((p) => p.sort_order === slot) ?? null);
---

<AdminLayout title={`${season.name} ${driverClass.name} Champion`}>
  <a href="/admin/champions" class="text-sm text-white/50 hover:text-white">&larr; Back to Champions</a>

  <h1 class="reveal mt-3 font-display text-4xl" style="transition-delay: 40ms">
    {season.name} · {driverClass.name}
  </h1>

  {champion ? (
    <p class="reveal mt-2 text-sm text-white/60" style="transition-delay: 60ms">
      Computed champion: <span class="font-semibold text-white">{champion.driver.name}</span> — {champion.totalPoints} pts
    </p>
  ) : (
    <p class="reveal mt-2 text-sm text-brand-pink" style="transition-delay: 60ms">
      No standings data found for this season/class — nothing to attach photos to yet.
    </p>
  )}

  {error && (
    <p class="reveal mt-6 rounded-xl border border-brand-pink/30 bg-brand-pink/10 p-4 text-sm text-white/80">{error}</p>
  )}

  {champion && (
    <div class="reveal mt-8 grid gap-6 sm:grid-cols-3" style="transition-delay: 80ms">
      {photoBySlot.map((photo, slot) => (
        <div class="rounded-2xl border border-white/10 p-4">
          <p class="text-xs uppercase tracking-wide text-white/40">Photo {slot + 1}</p>
          {photo ? (
            <img src={photo.image_url} alt="" class="mt-3 aspect-square w-full rounded-lg object-cover" />
          ) : (
            <div class="mt-3 flex aspect-square w-full items-center justify-center rounded-lg bg-white/5 text-xs text-white/30">
              No photo
            </div>
          )}

          <form method="POST" data-astro-reload enctype="multipart/form-data" class="mt-3 flex flex-col gap-2">
            <input type="hidden" name="slot" value={slot} />
            <input
              type="file"
              name="photo"
              accept="image/png,image/jpeg,image/webp"
              class="w-full text-xs text-white/60 file:mr-2 file:rounded-full file:border-0 file:bg-white/10 file:px-3 file:py-1.5 file:text-xs file:text-white"
            />
            <button
              type="submit"
              class="rounded-full bg-brand-primary px-3 py-1.5 text-xs font-semibold transition hover:brightness-110"
            >
              {photo ? 'Replace' : 'Upload'}
            </button>
          </form>

          {photo && (
            <form method="POST" data-astro-reload class="mt-2">
              <input type="hidden" name="intent" value="delete" />
              <input type="hidden" name="photo_id" value={photo.id} />
              <button
                type="submit"
                data-confirm="Remove this photo?"
                class="rounded-full bg-white/5 px-3 py-1.5 text-xs font-semibold text-white/70 ring-1 ring-white/10 transition hover:bg-white/10"
              >
                Remove
              </button>
            </form>
          )}
        </div>
      ))}
    </div>
  )}
</AdminLayout>

<script>
  document.addEventListener('astro:page-load', () => {
    document.querySelectorAll<HTMLButtonElement>('[data-confirm]').forEach((btn) => {
      btn.addEventListener('click', (e) => {
        if (!confirm(btn.dataset.confirm || 'Are you sure?')) e.preventDefault();
      });
    });
  });
</script>
