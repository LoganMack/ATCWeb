---
export const prerender = false;

import AdminLayout from '../../../layouts/AdminLayout.astro';
import {
  resolveSupabaseEnv,
  getTeams,
  getTeamById,
  createTeam,
  updateTeam,
  deleteTeam,
  uploadToStorage,
  getSeasons,
  getDriversBasic,
  getTeamRosterForSeason,
  getTeamRosterForTeamSeason,
  addTeamRosterEntry,
  removeTeamRosterEntry,
  getTeamSeasonLogosForTeam,
  upsertTeamSeasonLogo,
  deleteTeamSeasonLogo,
  type Team,
  type Season,
  type DriverOption,
  type TeamRosterEntry,
  type TeamSeasonLogo,
} from '../../../lib/supabase';

const supabaseEnv = resolveSupabaseEnv(Astro.locals);
const accessToken = Astro.locals.session!.accessToken;
const { id } = Astro.params;
const isNew = id === 'new';

let error: string | null = null;
let rosterError: string | null = null;
let rosterSeasonId: string | null = null;
let historicalLogoError: string | null = null;

function extFromFile(file: File): string {
  const fromName = file.name.split('.').pop();
  if (fromName && fromName.length <= 5) return fromName.toLowerCase();
  const map: Record<string, string> = {
    'image/png': 'png',
    'image/jpeg': 'jpg',
    'image/webp': 'webp',
    'image/svg+xml': 'svg',
  };
  return map[file.type] ?? 'png';
}

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const intent = String(form.get('intent') ?? 'save');

  if (intent === 'add-roster' || intent === 'remove-roster') {
    const seasonId = String(form.get('season_id') ?? '');
    const driverId = String(form.get('driver_id') ?? '');
    // Set client-side (see the script below) when the admin confirms
    // transferring a driver who's already on another team's roster this
    // season — the client can't do the transfer itself (no direct DB
    // access), so it just flags the intent and the server does both halves
    // of it here.
    const transferFromTeamId = String(form.get('transfer_from_team_id') ?? '');
    rosterSeasonId = seasonId || null;
    if (!isNew && id && seasonId && driverId) {
      try {
        if (intent === 'add-roster') {
          if (transferFromTeamId) {
            await removeTeamRosterEntry(supabaseEnv, accessToken, { season_id: seasonId, team_id: transferFromTeamId, driver_id: driverId });
          }
          await addTeamRosterEntry(supabaseEnv, accessToken, { season_id: seasonId, team_id: id, driver_id: driverId });
        } else {
          await removeTeamRosterEntry(supabaseEnv, accessToken, { season_id: seasonId, team_id: id, driver_id: driverId });
        }
        return Astro.redirect(`/admin/teams/${id}?season=${seasonId}`, 302);
      } catch (err) {
        console.error('Failed to update team roster:', err);
        rosterError = err instanceof Error ? err.message : 'Failed to update the roster.';
      }
    }
    // Falls through (no redirect) so the page re-renders with rosterError
    // shown and the season the admin was working in still selected.
  } else if (intent === 'add-historical-logo') {
    const seasonId = String(form.get('logo_season_id') ?? '');
    const file = form.get('historical_logo');
    if (!seasonId) {
      historicalLogoError = 'Pick a season first.';
    } else if (!(file instanceof File) || file.size === 0) {
      historicalLogoError = 'Choose an image file to upload.';
    } else if (!isNew && id) {
      try {
        // Own storage path from the current-logo upload below (season id
        // baked in), so this can never collide with — or overwrite — the
        // team's current logo file or any other season's historical one.
        const path = `${id}-season-${seasonId}-${Date.now()}.${extFromFile(file)}`;
        const logo_url = await uploadToStorage(supabaseEnv, accessToken, 'logos', path, file);
        await upsertTeamSeasonLogo(supabaseEnv, accessToken, { team_id: id, season_id: seasonId, logo_url });
        return Astro.redirect(`/admin/teams/${id}`, 302);
      } catch (err) {
        console.error('Failed to upload historical team logo:', err);
        historicalLogoError = err instanceof Error ? err.message : 'Failed to upload the historical logo.';
      }
    }
  } else if (intent === 'remove-historical-logo') {
    const logoId = String(form.get('logo_id') ?? '');
    if (!isNew && id && logoId) {
      try {
        await deleteTeamSeasonLogo(supabaseEnv, accessToken, logoId);
        return Astro.redirect(`/admin/teams/${id}`, 302);
      } catch (err) {
        console.error('Failed to remove historical team logo:', err);
        historicalLogoError = 'Failed to remove the historical logo.';
      }
    }
  } else if (intent === 'delete' && !isNew && id) {
    try {
      await deleteTeam(supabaseEnv, accessToken, id);
      return Astro.redirect('/admin/teams', 302);
    } catch (err) {
      console.error('Failed to delete team:', err);
      error = 'Failed to delete this team. Drivers still assigned to it may need reassigning first.';
    }
  } else {
    const name = String(form.get('name') ?? '').trim();
    const status = form.get('status') === 'inactive' ? 'inactive' : 'active';
    const primary_color_hex = String(form.get('primary_color_hex') ?? '').trim() || null;
    const logoFile = form.get('logo');

    if (!name) {
      error = 'Team name is required.';
    } else if (
      (await getTeams(supabaseEnv)).some(
        (other) => other.name.trim().toLowerCase() === name.toLowerCase() && other.id !== id
      )
    ) {
      error = `A team named "${name}" already exists.`;
    } else {
      try {
        let teamId = isNew ? null : id!;
        if (isNew) {
          const created = await createTeam(supabaseEnv, accessToken, { name, status, primary_color_hex });
          teamId = created.id;
        } else {
          await updateTeam(supabaseEnv, accessToken, teamId!, { name, status, primary_color_hex });
        }

        if (logoFile instanceof File && logoFile.size > 0) {
          const path = `${teamId}-${Date.now()}.${extFromFile(logoFile)}`;
          const logo_url = await uploadToStorage(supabaseEnv, accessToken, 'logos', path, logoFile);
          await updateTeam(supabaseEnv, accessToken, teamId!, { logo_url });
        }

        return Astro.redirect(`/admin/teams/${teamId}`, 302);
      } catch (err) {
        console.error('Failed to save team:', err);
        error = err instanceof Error ? err.message : 'Failed to save changes.';
      }
    }
  }
}

let team: Team | null = null;
if (!isNew && id) {
  team = await getTeamById(supabaseEnv, id);
  if (!team) return Astro.redirect('/admin/teams', 302);
}

const t: Partial<Team> = team ?? { name: '', status: 'active', primary_color_hex: '', logo_url: null };

// Season roster editor — teams field a different (max 4) set of drivers
// each season, tracked separately from teams.id/drivers.id. See
// 0008_team_rosters.sql for the max-4 / one-team-per-season rules, enforced
// server-side (not just here) so a bad request can't bypass them.
let seasons: Season[] = [];
let rosterDrivers: DriverOption[] = [];
let rosterEntries: TeamRosterEntry[] = [];
let selectedSeasonId: string | null = null;
let historicalLogos: TeamSeasonLogo[] = [];
if (!isNew && id) {
  try {
    [seasons, rosterDrivers, historicalLogos] = await Promise.all([
      getSeasons(supabaseEnv),
      getDriversBasic(supabaseEnv),
      getTeamSeasonLogosForTeam(supabaseEnv, id),
    ]);
  } catch (err) {
    console.error('Failed to load roster editor data:', err);
  }
  const requestedSeasonId = rosterSeasonId ?? Astro.url.searchParams.get('season');
  selectedSeasonId =
    (requestedSeasonId && seasons.some((s) => s.id === requestedSeasonId) ? requestedSeasonId : null) ??
    seasons.find((s) => s.is_current)?.id ??
    seasons[0]?.id ??
    null;
  if (selectedSeasonId) {
    try {
      rosterEntries = await getTeamRosterForTeamSeason(supabaseEnv, id, selectedSeasonId);
    } catch (err) {
      console.error('Failed to load team roster:', err);
    }
  }
}

// Cross-team lookup for the selected season — powers the "this driver is
// already on another team, transfer them?" confirmation below (the DB
// trigger in 0008_team_rosters.sql blocks a driver being on two rosters at
// once either way; this is purely so the admin gets a friendly prompt
// instead of a raw rejected-insert error).
const otherTeamByDriverId = new Map<string, { teamId: string; teamName: string }>();
if (!isNew && id && selectedSeasonId) {
  try {
    const [seasonRosterAllTeams, allTeams] = await Promise.all([
      getTeamRosterForSeason(supabaseEnv, selectedSeasonId),
      getTeams(supabaseEnv),
    ]);
    const teamNameById = new Map(allTeams.map((tm) => [tm.id, tm.name]));
    for (const entry of seasonRosterAllTeams) {
      if (entry.team_id !== id) {
        const teamName = teamNameById.get(entry.team_id);
        if (teamName) otherTeamByDriverId.set(entry.driver_id, { teamId: entry.team_id, teamName });
      }
    }
  } catch (err) {
    console.error('Failed to load cross-team roster data:', err);
  }
}

const selectedSeasonName = seasons.find((s) => s.id === selectedSeasonId)?.name ?? '';
const rosterDriverIds = new Set(rosterEntries.map((r) => r.driver_id));
const rosterDriversOnTeam = rosterDrivers
  .filter((d) => rosterDriverIds.has(d.id))
  .sort((a, b) => a.name.localeCompare(b.name));
const availableDrivers = rosterDrivers.filter((d) => !rosterDriverIds.has(d.id));
const rosterFull = rosterDriversOnTeam.length >= 4;
---

<AdminLayout title={isNew ? 'New Team' : t.name || 'Edit Team'}>
  <h1 class="reveal font-display text-4xl">{isNew ? 'New Team' : t.name}</h1>

  {error && (
    <p class="reveal mt-6 break-words rounded-lg border border-brand-pink/30 bg-brand-pink/10 p-4 text-sm text-white/80">{error}</p>
  )}

  <form method="POST" data-astro-reload enctype="multipart/form-data" class="reveal mt-8 flex max-w-xl flex-col gap-4" style="transition-delay: 80ms">
    <label class="flex flex-col gap-1.5 text-sm">
      <span class="text-white/70">Team name</span>
      <input
        type="text"
        name="name"
        required
        value={t.name}
        class="rounded-md border border-white/15 bg-white/5 px-3 py-2 text-white outline-none focus:border-brand-primary"
      />
    </label>
    <fieldset class="flex flex-col gap-1.5 text-sm">
      <legend class="text-white/70">Status</legend>
      <label class="flex items-center gap-2">
        <input type="radio" name="status" value="active" checked={t.status === 'active'} />
        <span>Active</span>
      </label>
      <label class="flex items-center gap-2">
        <input type="radio" name="status" value="inactive" checked={t.status === 'inactive'} />
        <span>Inactive</span>
      </label>
    </fieldset>
    <label class="flex flex-col gap-1.5 text-sm">
      <span class="text-white/70">Primary color (hex)</span>
      <input
        type="text"
        name="primary_color_hex"
        placeholder="#4369F5"
        value={t.primary_color_hex ?? ''}
        class="rounded-md border border-white/15 bg-white/5 px-3 py-2 text-white outline-none focus:border-brand-primary"
      />
    </label>

    <div class="flex flex-col gap-1.5 text-sm">
      <span class="text-white/70">Primary Logo</span>
      {t.logo_url && (
        <img src={t.logo_url} alt="" class="mb-2 h-16 w-16 rounded object-contain ring-1 ring-white/10" />
      )}
      <input
        type="file"
        name="logo"
        accept="image/png,image/jpeg,image/webp,image/svg+xml"
        class="rounded-md border border-white/15 bg-white/5 px-3 py-2 text-white outline-none file:mr-3 file:rounded-lg file:border-0 file:bg-white/10 file:px-3 file:py-1.5 file:text-white"
      />
      <span class="text-xs text-white/40">PNG, JPG, WebP, or SVG.</span>
    </div>

    <div class="mt-2 flex gap-3">
      <button
        type="submit"
        name="intent"
        value="save"
        class="rounded-lg bg-brand-primary px-6 py-3 font-semibold transition hover:brightness-110"
      >
        {isNew ? 'Create Team' : 'Save Changes'}
      </button>
      <a href="/admin/teams" class="rounded-lg bg-white/5 px-6 py-3 font-semibold ring-1 ring-white/10 transition hover:bg-white/10">
        Cancel
      </a>
    </div>
  </form>

  {!isNew && (
    <div class="reveal mt-10 max-w-xl border-t border-white/10 pt-6" style="transition-delay: 85ms">
      <h2 class="text-lg font-semibold">Logos by Season</h2>

      {historicalLogoError && (
        <p class="mt-4 rounded-lg border border-brand-pink/30 bg-brand-pink/10 p-3 text-sm text-white/80">{historicalLogoError}</p>
      )}

      {historicalLogos.length > 0 && (
        <ul class="mt-4 flex flex-col gap-2">
          {historicalLogos
            .slice()
            .sort(
              (a, b) =>
                (seasons.find((s) => s.id === b.season_id)?.number ?? 0) -
                (seasons.find((s) => s.id === a.season_id)?.number ?? 0)
            )
            .map((logo) => (
              <li class="flex items-center justify-between gap-3 rounded-md bg-white/5 px-3 py-2 text-sm ring-1 ring-white/10">
                <span class="flex items-center gap-3">
                  <img src={logo.logo_url} alt="" class="h-8 w-8 rounded object-contain ring-1 ring-white/10" />
                  {seasons.find((s) => s.id === logo.season_id)?.name ?? 'Unknown season'}
                </span>
                <form method="POST" data-astro-reload>
                  <input type="hidden" name="intent" value="remove-historical-logo" />
                  <input type="hidden" name="logo_id" value={logo.id} />
                  <button type="submit" class="text-xs font-semibold text-white/40 transition hover:text-brand-pink">Remove</button>
                </form>
              </li>
            ))}
        </ul>
      )}

      {seasons.length === 0 ? (
        <p class="mt-4 text-sm text-white/40">No seasons yet — add one under Seasons first.</p>
      ) : (
        <form method="POST" data-astro-reload enctype="multipart/form-data" class="mt-4 flex flex-wrap items-end gap-3">
          <input type="hidden" name="intent" value="add-historical-logo" />
          <label class="flex flex-col gap-1.5 text-sm">
            <span class="text-white/60">Season</span>
            <select
              name="logo_season_id"
              class="rounded-md border border-white/15 bg-white/5 px-3 py-2 text-white outline-none focus:border-brand-primary"
            >
              {seasons.map((s) => (
                <option value={s.id} class="bg-brand-ink text-white">{s.name}</option>
              ))}
            </select>
          </label>
          <label class="flex flex-col gap-1.5 text-sm">
            <span class="text-white/60">Logo file</span>
            <input
              type="file"
              name="historical_logo"
              accept="image/png,image/jpeg,image/webp,image/svg+xml"
              class="rounded-md border border-white/15 bg-white/5 px-3 py-2 text-white outline-none file:mr-3 file:rounded-lg file:border-0 file:bg-white/10 file:px-3 file:py-1.5 file:text-white"
            />
          </label>
          <button
            type="submit"
            class="rounded-lg bg-white/5 px-4 py-2 text-sm font-semibold ring-1 ring-white/10 transition hover:bg-white/10"
          >
            Save logo for season
          </button>
        </form>
      )}
    </div>
  )}

  {!isNew && (
    <div class="reveal mt-10 max-w-xl border-t border-white/10 pt-6" style="transition-delay: 90ms">
      <h2 class="text-lg font-semibold">Roster by Season</h2>

      {seasons.length === 0 ? (
        <p class="mt-4 text-sm text-white/40">No results.</p>
      ) : (
        <>
          <form method="GET" class="mt-4">
            <label class="flex flex-col gap-1.5 text-sm">
              <span class="text-white/60">Season</span>
              <select
                name="season"
                onchange="this.form.submit()"
                class="rounded-md border border-white/15 bg-white/5 px-3 py-2 text-white outline-none focus:border-brand-primary"
              >
                {seasons.map((s) => (
                  <option value={s.id} selected={s.id === selectedSeasonId} class="bg-brand-ink text-white">{s.name}</option>
                ))}
              </select>
            </label>
          </form>

          {rosterError && (
            <p class="mt-4 rounded-lg border border-brand-pink/30 bg-brand-pink/10 p-3 text-sm text-white/80">{rosterError}</p>
          )}

          <ul class="mt-4 flex flex-col gap-2">
            {rosterDriversOnTeam.length === 0 && <li class="text-sm text-white/40">No results.</li>}
            {rosterDriversOnTeam.map((d) => (
              <li class="flex items-center justify-between gap-3 rounded-md bg-white/5 px-3 py-2 text-sm ring-1 ring-white/10">
                <span>
                  {d.name} {d.car_number !== null && <span class="text-white/40">#{d.car_number}</span>}
                </span>
                <form method="POST" data-astro-reload>
                  <input type="hidden" name="intent" value="remove-roster" />
                  <input type="hidden" name="season_id" value={selectedSeasonId ?? ''} />
                  <input type="hidden" name="driver_id" value={d.id} />
                  <button type="submit" class="text-xs font-semibold text-white/40 transition hover:text-brand-pink">Remove</button>
                </form>
              </li>
            ))}
          </ul>

          {selectedSeasonId && (
            <form
              method="POST"
              data-astro-reload
              data-add-roster-form
              data-team-name={t.name}
              data-season-name={selectedSeasonName}
              class="mt-4 flex flex-wrap items-end gap-3"
            >
              <input type="hidden" name="intent" value="add-roster" />
              <input type="hidden" name="season_id" value={selectedSeasonId} />
              <input type="hidden" name="transfer_from_team_id" value="" data-transfer-from-team-id />
              <label class="flex flex-col gap-1.5 text-sm">
                <span class="text-white/60">Add driver</span>
                <select
                  name="driver_id"
                  disabled={rosterFull || availableDrivers.length === 0}
                  class="rounded-md border border-white/15 bg-white/5 px-3 py-2 text-white outline-none focus:border-brand-primary disabled:opacity-40"
                >
                  {availableDrivers.map((d) => {
                    const other = otherTeamByDriverId.get(d.id);
                    return (
                      <option
                        value={d.id}
                        data-driver-name={d.name}
                        data-other-team-id={other?.teamId ?? ''}
                        data-other-team-name={other?.teamName ?? ''}
                        class="bg-brand-ink text-white"
                      >
                        {d.name}{d.car_number !== null ? ` #${d.car_number}` : ''}{other ? ` (on ${other.teamName})` : ''}
                      </option>
                    );
                  })}
                </select>
              </label>
              <button
                type="submit"
                disabled={rosterFull || availableDrivers.length === 0}
                class="rounded-lg bg-white/5 px-4 py-2 text-sm font-semibold ring-1 ring-white/10 transition hover:bg-white/10 disabled:opacity-40"
              >
                Add to roster
              </button>
              {rosterFull && <span class="text-xs text-white/40">Roster is full (4/4) for this season.</span>}
            </form>
          )}
        </>
      )}
    </div>
  )}

  {!isNew && (
    <form method="POST" data-astro-reload class="reveal mt-10 max-w-xl border-t border-white/10 pt-6" style="transition-delay: 100ms">
      <input type="hidden" name="intent" value="delete" />
      <button
        type="submit"
        data-confirm="Delete this team? Drivers still assigned to it, and its season rosters, will need reassigning first."
        class="rounded-lg bg-brand-pink/10 px-5 py-2.5 text-sm font-semibold text-brand-pink ring-1 ring-brand-pink/30 transition hover:bg-brand-pink/20"
      >
        Delete Team
      </button>
    </form>
  )}
</AdminLayout>

<script>
  document.addEventListener('astro:page-load', () => {
    document.querySelectorAll<HTMLButtonElement>('[data-confirm]').forEach((btn) => {
      btn.addEventListener('click', (e) => {
        if (!confirm(btn.dataset.confirm || 'Are you sure?')) e.preventDefault();
      });
    });

    // "Add driver" on the Roster by Season form — if the selected driver is
    // already on another team's roster this season, confirm the transfer
    // before submitting (the server enforces the same rule regardless, see
    // 0008_team_rosters.sql, but this avoids the admin hitting that as a
    // raw rejected-insert error). On confirm, stash which team to remove
    // them from first; on cancel, don't submit at all.
    document.querySelectorAll<HTMLFormElement>('[data-add-roster-form]').forEach((form) => {
      form.addEventListener('submit', (e) => {
        const select = form.querySelector<HTMLSelectElement>('select[name="driver_id"]');
        const transferField = form.querySelector<HTMLInputElement>('[data-transfer-from-team-id]');
        if (!select || !transferField) return;

        transferField.value = '';

        const option = select.selectedOptions[0];
        const otherTeamId = option?.dataset.otherTeamId;
        const otherTeamName = option?.dataset.otherTeamName;
        if (!option || !otherTeamId || !otherTeamName) return;

        const driverName = option.dataset.driverName ?? option.textContent?.trim() ?? 'This driver';
        const teamName = form.dataset.teamName ?? 'this team';
        const seasonName = form.dataset.seasonName ?? 'this season';
        const confirmed = confirm(
          `${driverName} is currently assigned to ${otherTeamName} for ${seasonName}. Do you want to transfer this driver from ${otherTeamName} to ${teamName}?`
        );
        if (!confirmed) {
          e.preventDefault();
          return;
        }
        transferField.value = otherTeamId;
      });
    });
  });
</script>
