---
export const prerender = false;

// Same shell-then-spinner split as admin/index.astro (see admin/drivers/
// fragment.astro's own top-of-file comment) — this page used to run two
// opportunistic write RPCs (syncDriverStatuses/syncRookieStatus) plus fetch
// every driver and their driver_last_race row, all before sending any HTML,
// so opening /admin/drivers always meant a blank page for however long that
// took. POST handling (the three form intents below) stays right here since
// that's the URL every form on this page posts to — only the GET-time data
// loading and table/settings-panel rendering moved to the fragment.

import AdminLayout from '../../../layouts/AdminLayout.astro';
import { resolveSupabaseEnv, upsertSiteSetting, syncDriverStatuses, syncRookieStatus, syncResultsWithRoster } from '../../../lib/supabase';
import { PROBATION_DAYS_KEY, PROBATION_ROUNDS_KEY, INACTIVITY_DAYS_KEY, INACTIVITY_ROUNDS_KEY } from '../../../lib/siteSettings';
import { logActivity, actorNameFor } from '../../../lib/activityLog';

const supabaseEnv = resolveSupabaseEnv(Astro.locals);
const accessToken = Astro.locals.session!.accessToken;
const actor = { id: Astro.locals.session!.user.id, name: actorNameFor(Astro.locals.session!) };

let error: string | null = null;
let saved = false;

// How many names to actually list out in the post-sync banner below — a
// season or two of backlog can mean dozens of newly-linked/created drivers,
// which would otherwise make for an unreasonably long redirect URL (see the
// redirect below, which is what actually carries this list across the
// POST-then-render-same-page pattern every other admin page here uses).
const SYNC_NAMES_SHOWN = 20;

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const intent = String(form.get('intent') ?? 'save-settings');

  if (intent === 'sync-statuses') {
    try {
      const [statusesChanged, rookiesChanged] = await Promise.all([
        syncDriverStatuses(supabaseEnv, accessToken),
        syncRookieStatus(supabaseEnv, accessToken),
      ]);
      if (statusesChanged > 0 || rookiesChanged > 0) {
        await logActivity(supabaseEnv, accessToken, actor, {
          action: 'edit',
          entity_type: 'driver',
          entity_label: 'Sync Statuses',
          details: `${statusesChanged} status${statusesChanged === 1 ? '' : 'es'} changed, ${rookiesChanged} driver${rookiesChanged === 1 ? '' : 's'} lost rookie status`,
        });
      }
      const params = new URLSearchParams({
        synced_statuses: String(statusesChanged),
        synced_rookies: String(rookiesChanged),
      });
      return Astro.redirect(`/admin/drivers?${params.toString()}`, 302);
    } catch (err) {
      console.error('Failed to sync driver statuses:', err);
      error = err instanceof Error ? err.message : 'Failed to sync driver statuses.';
    }
  } else if (intent === 'sync-results-roster') {
    try {
      const outcome = await syncResultsWithRoster(supabaseEnv, accessToken);
      const allNames = [...outcome.created, ...outcome.linked];
      if (allNames.length > 0) {
        await logActivity(supabaseEnv, accessToken, actor, {
          action: outcome.created.length > 0 ? 'add' : 'edit',
          entity_type: 'driver',
          entity_label: 'Sync Results with Roster',
          details: `${outcome.created.length} created, ${outcome.linked.length} linked, ${outcome.roundsRecalculated} round(s) recalculated: ${allNames.slice(0, SYNC_NAMES_SHOWN).join(', ')}${allNames.length > SYNC_NAMES_SHOWN ? ` (+${allNames.length - SYNC_NAMES_SHOWN} more)` : ''}${outcome.recalcFailed.length > 0 ? ` — recalc failed for: ${outcome.recalcFailed.join('; ')}` : ''}`,
        });
      }
      const params = new URLSearchParams({
        synced_created: String(outcome.created.length),
        synced_linked: String(outcome.linked.length),
        synced_names: allNames.slice(0, SYNC_NAMES_SHOWN).join(', '),
        synced_more: String(Math.max(0, allNames.length - SYNC_NAMES_SHOWN)),
        synced_rounds: String(outcome.roundsRecalculated),
        synced_recalc_failed: String(outcome.recalcFailed.length),
      });
      return Astro.redirect(`/admin/drivers?${params.toString()}`, 302);
    } catch (err) {
      console.error('Failed to sync results with roster:', err);
      error = err instanceof Error ? err.message : 'Failed to sync results with roster.';
    }
  } else {
    // Blank/non-numeric/negative just falls back to the field's own default
    // via siteSettingInt on the next load, same tolerant handling as reading
    // these values back — a stray bad value here can't wedge the automation.
    function readIntField(name: string): string {
      const raw = String(form.get(name) ?? '').trim();
      const n = Number(raw);
      return raw && Number.isFinite(n) && n > 0 ? String(Math.round(n)) : '';
    }
    try {
      await Promise.all([
        upsertSiteSetting(supabaseEnv, accessToken, { setting_key: PROBATION_DAYS_KEY, value: readIntField('probation_days') || null }),
        upsertSiteSetting(supabaseEnv, accessToken, { setting_key: PROBATION_ROUNDS_KEY, value: readIntField('probation_rounds') || null }),
        upsertSiteSetting(supabaseEnv, accessToken, { setting_key: INACTIVITY_DAYS_KEY, value: readIntField('inactivity_days') || null }),
        upsertSiteSetting(supabaseEnv, accessToken, { setting_key: INACTIVITY_ROUNDS_KEY, value: readIntField('inactivity_rounds') || null }),
      ]);
      await logActivity(supabaseEnv, accessToken, actor, {
        action: 'edit',
        entity_type: 'site_property',
        entity_label: 'Driver Settings (probation/inactivity)',
      });
      saved = true;
    } catch (err) {
      console.error('Failed to save driver settings:', err);
      error = err instanceof Error ? err.message : 'Failed to save driver settings.';
    }
  }
}

// Sync result banner — query-string carried (see the redirect above), same
// convention as Admin > Import's imported/skipped counts.
const syncedCreated = Astro.url.searchParams.get('synced_created');
const syncedLinked = Astro.url.searchParams.get('synced_linked');
const syncedNames = Astro.url.searchParams.get('synced_names');
const syncedMore = Astro.url.searchParams.get('synced_more');
const syncedRounds = Astro.url.searchParams.get('synced_rounds');
const syncedRecalcFailed = Astro.url.searchParams.get('synced_recalc_failed');
const syncedStatuses = Astro.url.searchParams.get('synced_statuses');
const syncedRookies = Astro.url.searchParams.get('synced_rookies');

// Driver Settings (probation/inactivity values), the two opportunistic
// syncDriverStatuses/syncRookieStatus RPCs, the drivers list itself, and the
// bulk driver_last_race lookup all moved to admin/drivers/fragment.astro —
// see that file's top-of-file comment. All that's left here is the cheap,
// dependency-free query-string filter below, needed synchronously to render
// the All/AI tabs and to build the fragment's URL.

// All vs. AI — same plain query-string pill pattern as the Activity Log's
// category filter (src/pages/admin/activity-log/index.astro). AI-flagged
// drivers (0057_driver_ai_flag.sql) exist only to satisfy an exhibition
// result's FK and are never mixed into the default "All" list.
const activeFilter = Astro.url.searchParams.get('filter') === 'ai' ? 'ai' : 'all';
---

<AdminLayout title="Drivers">
  <div class="reveal flex flex-wrap items-center justify-between gap-3">
    <h1 class="font-display text-4xl">Drivers</h1>
    <div class="flex flex-wrap items-center gap-2">
      <form method="POST" data-astro-reload>
        <input type="hidden" name="intent" value="sync-statuses" />
        <button
          type="submit"
          data-confirm="Re-derive every driver's status (New/Active/Inactive) and rookie flag from race activity and sign-up dates right now, instead of waiting for the next time this page happens to load it in the background. Continue?"
          class="rounded-lg bg-white/5 px-5 py-2.5 font-semibold text-white/80 ring-1 ring-white/10 transition hover:bg-white/10"
        >
          Sync Statuses
        </button>
      </form>
      <form method="POST" data-astro-reload>
        <input type="hidden" name="intent" value="sync-results-roster" />
        <button
          type="submit"
          data-confirm="Scan every real (non-exhibition) race result on file for drivers who raced but have no matching roster entry, and either link them onto an existing same-named driver or create a new roster entry for them. Exhibition rounds/seasons are skipped, so AI and one-off exhibition drivers won't get synced in. Continue?"
          class="rounded-lg bg-white/5 px-5 py-2.5 font-semibold text-white/80 ring-1 ring-white/10 transition hover:bg-white/10"
        >
          Sync Results with Roster
        </button>
      </form>
      <a href="/admin/drivers/new" class="rounded-lg bg-brand-primary px-5 py-2.5 font-semibold transition hover:brightness-110">
        New Driver
      </a>
    </div>
  </div>

  {error && (
    <p class="reveal mt-6 rounded-lg border border-brand-pink/30 bg-brand-pink/10 p-4 text-sm text-white/80">{error}</p>
  )}
  {saved && !error && (
    <p class="reveal mt-6 rounded-lg border border-brand-primary/30 bg-brand-primary/10 p-4 text-sm text-white/80">Saved.</p>
  )}
  {(syncedStatuses !== null || syncedRookies !== null) && !error && (
    <p class="reveal mt-6 rounded-lg border border-brand-primary/30 bg-brand-primary/10 p-4 text-sm text-white/80">
      Sync complete — {syncedStatuses} status{Number(syncedStatuses) === 1 ? '' : 'es'} changed, {syncedRookies} driver
      {Number(syncedRookies) === 1 ? '' : 's'} lost rookie status.
    </p>
  )}
  {(syncedCreated !== null || syncedLinked !== null) && !error && (
    <div class="reveal mt-6 rounded-lg border border-brand-primary/30 bg-brand-primary/10 p-4 text-sm text-white/80">
      <p>
        Sync complete — {syncedCreated} new roster {Number(syncedCreated) === 1 ? 'entry' : 'entries'} created,{' '}
        {syncedLinked} existing {Number(syncedLinked) === 1 ? 'driver' : 'drivers'} linked to their results
        {Number(syncedRounds) > 0 && (
          <>, {syncedRounds} historical {Number(syncedRounds) === 1 ? 'round' : 'rounds'} recalculated for them</>
        )}.
      </p>
      {syncedNames && (
        <p class="mt-1 text-white/50">
          {syncedNames}
          {Number(syncedMore) > 0 && ` (+${syncedMore} more)`}
        </p>
      )}
      {Number(syncedRecalcFailed) > 0 && (
        <p class="mt-2 text-brand-pink">
          {syncedRecalcFailed} round{Number(syncedRecalcFailed) === 1 ? '' : 's'} couldn't be recalculated (no
          ruleset assigned yet, standings locked, etc.) — see the Activity Log entry for this sync for exactly which
          ones, then recalculate them by hand once resolved.
        </p>
      )}
      {Number(syncedCreated) > 0 && (
        <p class="mt-2 text-xs text-white/40">
          Newly created entries default to the lowest class and status "New" — open each one to confirm their name,
          set a real class/team, and double check they aren't actually a duplicate of an existing driver under a
          different spelling.
        </p>
      )}
    </div>
  )}

  <div class="reveal mt-8 flex flex-wrap gap-1.5" style="transition-delay: 40ms">
    <a
      href="/admin/drivers"
      class={`rounded-lg px-3 py-1.5 text-xs font-semibold transition ${activeFilter === 'all' ? 'bg-brand-primary text-white' : 'bg-white/5 text-white/60 ring-1 ring-white/10 hover:bg-white/10'}`}
    >
      All
    </a>
    <a
      href="/admin/drivers?filter=ai"
      class={`rounded-lg px-3 py-1.5 text-xs font-semibold transition ${activeFilter === 'ai' ? 'bg-brand-primary text-white' : 'bg-white/5 text-white/60 ring-1 ring-white/10 hover:bg-white/10'}`}
    >
      AI
    </a>
  </div>

  <div data-admin-drivers-list data-fragment-url={`/admin/drivers/fragment?filter=${activeFilter}`}>
    <div class="mt-3 flex flex-col gap-4" aria-live="polite" aria-busy="true">
      <span class="sr-only">Loading drivers…</span>
      <div class="h-24 animate-pulse rounded-xl border border-white/10 bg-white/[0.03]"></div>
      <div class="h-96 animate-pulse rounded-xl border border-white/10 bg-white/[0.02]"></div>
    </div>
  </div>
</AdminLayout>

<script>
  document.addEventListener('astro:page-load', () => {
    document.querySelectorAll<HTMLButtonElement>('[data-confirm]').forEach((btn) => {
      btn.addEventListener('click', (e) => {
        if (!confirm(btn.dataset.confirm || 'Are you sure?')) e.preventDefault();
      });
    });
  });

  // Same fetch-fragment-then-drop-in pattern as admin/index.astro/
  // driver-stats.astro — see admin/drivers/fragment.astro's own top-of-file
  // comment for the full reasoning (astro:page-load re-dispatch included so
  // sortable-table.ts binds the newly-inserted table).
  function initAdminDriversList() {
    const container = document.querySelector<HTMLElement>('[data-admin-drivers-list]');
    const url = container?.dataset.fragmentUrl;
    if (!container || !url) return;
    delete container.dataset.fragmentUrl;

    fetch(url)
      .then((res) => {
        if (!res.ok) throw new Error(`Admin drivers fragment request failed (${res.status})`);
        return res.text();
      })
      .then((html) => {
        container.innerHTML = html;
        document.dispatchEvent(new Event('astro:page-load'));
      })
      .catch((err) => {
        console.error('Failed to load admin drivers list:', err);
        container.innerHTML =
          '<p class="mt-8 rounded-lg border border-brand-pink/30 bg-brand-pink/10 p-4 text-sm text-white/80">Couldn’t load drivers right now — try refreshing the page.</p>';
      });
  }

  document.addEventListener('astro:page-load', initAdminDriversList);
</script>
