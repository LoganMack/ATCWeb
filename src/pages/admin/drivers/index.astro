---
export const prerender = false;

import AdminLayout from '../../../layouts/AdminLayout.astro';
import DriverFlag from '../../../components/DriverFlag.astro';
import {
  resolveSupabaseEnv,
  getDrivers,
  getSiteSettings,
  upsertSiteSetting,
  syncDriverStatuses,
  syncRookieStatus,
  syncResultsWithRoster,
  getAllDriverLastRaces,
  buildInactivityNote,
  formatDate,
} from '../../../lib/supabase';
import {
  PROBATION_DAYS_KEY,
  PROBATION_ROUNDS_KEY,
  INACTIVITY_DAYS_KEY,
  INACTIVITY_ROUNDS_KEY,
  siteSettingInt,
} from '../../../lib/siteSettings';
import { logActivity, actorNameFor } from '../../../lib/activityLog';

const supabaseEnv = resolveSupabaseEnv(Astro.locals);
const accessToken = Astro.locals.session!.accessToken;
const actor = { id: Astro.locals.session!.user.id, name: actorNameFor(Astro.locals.session!) };

let error: string | null = null;
let saved = false;

// How many names to actually list out in the post-sync banner below — a
// season or two of backlog can mean dozens of newly-linked/created drivers,
// which would otherwise make for an unreasonably long redirect URL (see the
// redirect below, which is what actually carries this list across the
// POST-then-render-same-page pattern every other admin page here uses).
const SYNC_NAMES_SHOWN = 20;

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const intent = String(form.get('intent') ?? 'save-settings');

  if (intent === 'sync-results-roster') {
    try {
      const outcome = await syncResultsWithRoster(supabaseEnv, accessToken);
      const allNames = [...outcome.created, ...outcome.linked];
      if (allNames.length > 0) {
        await logActivity(supabaseEnv, accessToken, actor, {
          action: outcome.created.length > 0 ? 'add' : 'edit',
          entity_type: 'driver',
          entity_label: 'Sync Results with Roster',
          details: `${outcome.created.length} created, ${outcome.linked.length} linked: ${allNames.slice(0, SYNC_NAMES_SHOWN).join(', ')}${allNames.length > SYNC_NAMES_SHOWN ? ` (+${allNames.length - SYNC_NAMES_SHOWN} more)` : ''}`,
        });
      }
      const params = new URLSearchParams({
        synced_created: String(outcome.created.length),
        synced_linked: String(outcome.linked.length),
        synced_names: allNames.slice(0, SYNC_NAMES_SHOWN).join(', '),
        synced_more: String(Math.max(0, allNames.length - SYNC_NAMES_SHOWN)),
      });
      return Astro.redirect(`/admin/drivers?${params.toString()}`, 302);
    } catch (err) {
      console.error('Failed to sync results with roster:', err);
      error = err instanceof Error ? err.message : 'Failed to sync results with roster.';
    }
  } else {
    // Blank/non-numeric/negative just falls back to the field's own default
    // via siteSettingInt on the next load, same tolerant handling as reading
    // these values back — a stray bad value here can't wedge the automation.
    function readIntField(name: string): string {
      const raw = String(form.get(name) ?? '').trim();
      const n = Number(raw);
      return raw && Number.isFinite(n) && n > 0 ? String(Math.round(n)) : '';
    }
    try {
      await Promise.all([
        upsertSiteSetting(supabaseEnv, accessToken, { setting_key: PROBATION_DAYS_KEY, value: readIntField('probation_days') || null }),
        upsertSiteSetting(supabaseEnv, accessToken, { setting_key: PROBATION_ROUNDS_KEY, value: readIntField('probation_rounds') || null }),
        upsertSiteSetting(supabaseEnv, accessToken, { setting_key: INACTIVITY_DAYS_KEY, value: readIntField('inactivity_days') || null }),
        upsertSiteSetting(supabaseEnv, accessToken, { setting_key: INACTIVITY_ROUNDS_KEY, value: readIntField('inactivity_rounds') || null }),
      ]);
      await logActivity(supabaseEnv, accessToken, actor, {
        action: 'edit',
        entity_type: 'site_property',
        entity_label: 'Driver Settings (probation/inactivity)',
      });
      saved = true;
    } catch (err) {
      console.error('Failed to save driver settings:', err);
      error = err instanceof Error ? err.message : 'Failed to save driver settings.';
    }
  }
}

// Sync result banner — query-string carried (see the redirect above), same
// convention as Admin > Import's imported/skipped counts.
const syncedCreated = Astro.url.searchParams.get('synced_created');
const syncedLinked = Astro.url.searchParams.get('synced_linked');
const syncedNames = Astro.url.searchParams.get('synced_names');
const syncedMore = Astro.url.searchParams.get('synced_more');

let probationDays = 45;
let probationRounds = 4;
let inactivityDays = 90;
let inactivityRounds = 12;
try {
  const settings = await getSiteSettings(supabaseEnv);
  probationDays = siteSettingInt(settings, PROBATION_DAYS_KEY);
  probationRounds = siteSettingInt(settings, PROBATION_ROUNDS_KEY);
  inactivityDays = siteSettingInt(settings, INACTIVITY_DAYS_KEY);
  inactivityRounds = siteSettingInt(settings, INACTIVITY_ROUNDS_KEY);
} catch (err) {
  console.error('Failed to load driver settings:', err);
  if (!error) error = 'Failed to load current driver settings.';
}

// No cron/scheduled-worker infrastructure in this app — status and rookie
// automation both run opportunistically here, the one admin page every
// admin visits before touching any individual driver. Best-effort: a sync
// failure shouldn't block the page from showing the (possibly stale)
// driver list.
try {
  await syncDriverStatuses(supabaseEnv, accessToken);
} catch (err) {
  console.error('Failed to sync driver statuses:', err);
}
try {
  await syncRookieStatus(supabaseEnv, accessToken);
} catch (err) {
  console.error('Failed to sync rookie status:', err);
}

let drivers: Awaited<ReturnType<typeof getDrivers>> = [];
let loadError = false;
try {
  drivers = await getDrivers(supabaseEnv);
} catch (err) {
  console.error('Failed to load drivers for admin:', err);
  loadError = true;
}

// Status hover tooltip — same message the edit page shows next to the
// Status pill (see buildInactivityNote's own doc comment), reused verbatim
// here rather than re-derived. One bulk driver_last_race query for the
// whole roster instead of one getDriverLastRace() call per row.
let lastRaceByDriverId = new Map<string, { last_race_at: string | null; rounds_since_last_race: number | null }>();
try {
  const lastRaces = await getAllDriverLastRaces(supabaseEnv);
  lastRaceByDriverId = new Map(lastRaces.map((r) => [r.driver_id, r]));
} catch (err) {
  console.error('Failed to load driver_last_race for admin drivers list:', err);
}
---

<AdminLayout title="Drivers">
  <div class="reveal flex flex-wrap items-center justify-between gap-3">
    <h1 class="font-display text-4xl">Drivers</h1>
    <div class="flex flex-wrap items-center gap-2">
      <form method="POST" data-astro-reload>
        <input type="hidden" name="intent" value="sync-results-roster" />
        <button
          type="submit"
          data-confirm="Scan every real (non-exhibition) race result on file for drivers who raced but have no matching roster entry, and either link them onto an existing same-named driver or create a new roster entry for them. Exhibition rounds/seasons are skipped, so AI and one-off exhibition drivers won't get synced in. Continue?"
          class="rounded-lg bg-white/5 px-5 py-2.5 font-semibold text-white/80 ring-1 ring-white/10 transition hover:bg-white/10"
        >
          Sync Results with Roster
        </button>
      </form>
      <a href="/admin/drivers/new" class="rounded-lg bg-brand-primary px-5 py-2.5 font-semibold transition hover:brightness-110">
        New Driver
      </a>
    </div>
  </div>

  {error && (
    <p class="reveal mt-6 rounded-lg border border-brand-pink/30 bg-brand-pink/10 p-4 text-sm text-white/80">{error}</p>
  )}
  {saved && !error && (
    <p class="reveal mt-6 rounded-lg border border-brand-primary/30 bg-brand-primary/10 p-4 text-sm text-white/80">Saved.</p>
  )}
  {(syncedCreated !== null || syncedLinked !== null) && !error && (
    <div class="reveal mt-6 rounded-lg border border-brand-primary/30 bg-brand-primary/10 p-4 text-sm text-white/80">
      <p>
        Sync complete — {syncedCreated} new roster {Number(syncedCreated) === 1 ? 'entry' : 'entries'} created,{' '}
        {syncedLinked} existing {Number(syncedLinked) === 1 ? 'driver' : 'drivers'} linked to their results.
      </p>
      {syncedNames && (
        <p class="mt-1 text-white/50">
          {syncedNames}
          {Number(syncedMore) > 0 && ` (+${syncedMore} more)`}
        </p>
      )}
      {Number(syncedCreated) > 0 && (
        <p class="mt-2 text-xs text-white/40">
          Newly created entries default to the lowest class and status "New" — open each one to confirm their name,
          set a real class/team, and double check they aren't actually a duplicate of an existing driver under a
          different spelling.
        </p>
      )}
    </div>
  )}

  <details class="reveal mt-8 rounded-xl border border-white/10 bg-white/[0.03] p-5" style="transition-delay: 40ms">
    <summary class="cursor-pointer font-semibold text-white/80">Driver Settings</summary>
    <form method="POST" data-astro-reload class="mt-4 grid gap-4 sm:grid-cols-2">
      <input type="hidden" name="intent" value="save-settings" />
      <div class="flex flex-col gap-1.5 text-sm">
        <span class="text-white/70">Probation length</span>
        <div class="flex items-center gap-2">
          <input
            type="number"
            name="probation_days"
            min="1"
            step="1"
            value={probationDays}
            class="w-24 rounded-md border border-white/15 bg-white/5 px-3 py-2 text-white outline-none focus:border-brand-primary"
          />
          <span class="text-white/50">days, and</span>
          <input
            type="number"
            name="probation_rounds"
            min="1"
            step="1"
            value={probationRounds}
            class="w-20 rounded-md border border-white/15 bg-white/5 px-3 py-2 text-white outline-none focus:border-brand-primary"
          />
          <span class="text-white/50">rounds</span>
        </div>
      </div>
      <div class="flex flex-col gap-1.5 text-sm">
        <span class="text-white/70">Time to become inactive</span>
        <div class="flex items-center gap-2">
          <input
            type="number"
            name="inactivity_days"
            min="1"
            step="1"
            value={inactivityDays}
            class="w-24 rounded-md border border-white/15 bg-white/5 px-3 py-2 text-white outline-none focus:border-brand-primary"
          />
          <span class="text-white/50">days, and</span>
          <input
            type="number"
            name="inactivity_rounds"
            min="1"
            step="1"
            value={inactivityRounds}
            class="w-20 rounded-md border border-white/15 bg-white/5 px-3 py-2 text-white outline-none focus:border-brand-primary"
          />
          <span class="text-white/50">rounds</span>
        </div>
      </div>
      <div class="sm:col-span-2">
        <button
          type="submit"
          class="rounded-lg bg-brand-primary px-5 py-2 text-sm font-semibold transition hover:brightness-110"
        >
          Save
        </button>
      </div>
    </form>
  </details>

  {loadError && (
    <p class="mt-8 rounded-lg border border-brand-pink/30 bg-brand-pink/10 p-4 text-sm text-white/80">
      Couldn't load drivers.
    </p>
  )}

  <div class="reveal mt-8 overflow-x-auto rounded-xl border border-white/10" style="transition-delay: 80ms">
    <table class="w-full border-collapse" data-sortable>
      <thead>
        <tr class="border-b border-white/10 text-left text-xs uppercase tracking-wide text-white/40">
          <th class="py-3 pl-6 pr-2 font-medium" data-sort-key="number">#</th>
          <th class="py-3 pr-3 font-medium" data-sort-key="name">Driver</th>
          <th class="py-3 pr-3 font-medium" data-sort-key="team">Team</th>
          <th class="py-3 pr-3 font-medium" data-sort-key="class">Class</th>
          <th class="py-3 pr-3 font-medium" data-sort-key="nationality">Nationality</th>
          <th class="py-3 pr-3 font-medium" data-sort-key="signup">Sign-up</th>
          <th class="py-3 pr-3 font-medium" data-sort-key="status">Status</th>
          <th class="py-3 pr-6 font-medium"></th>
        </tr>
      </thead>
      <tbody>
        {drivers.map((driver) => (
          <tr class="border-b border-white/5 text-sm transition hover:bg-white/[0.03]">
            <td class="py-3 pl-6 pr-2 font-display text-xl text-white/60" data-col="number" data-sort-value={driver.car_number ?? Number.MAX_SAFE_INTEGER}>
              {driver.car_number !== null ? `#${driver.car_number}` : '—'}
            </td>
            <td class="py-3 pr-3 font-semibold" data-col="name">{driver.name}</td>
            <td class="py-3 pr-3 text-white/60" data-col="team">{driver.teams?.name ?? '—'}</td>
            <td class="py-3 pr-3 text-white/60" data-col="class">{driver.driver_classes?.name}</td>
            <td class="py-3 pr-3" data-col="nationality">
              {driver.nationality_1 ? (
                <DriverFlag nationality1={driver.nationality_1} nationality2={driver.nationality_2} />
              ) : (
                <span class="text-white/30">—</span>
              )}
            </td>
            <td class="py-3 pr-3 text-white/60" data-col="signup" data-sort-value={driver.sign_up_date ?? ''}>
              {driver.sign_up_date ? formatDate(driver.sign_up_date) : '—'}
            </td>
            <td
              class="py-3 pr-3 text-white/60"
              data-col="status"
              title={buildInactivityNote(driver.driver_statuses?.name ?? null, lastRaceByDriverId.get(driver.id), inactivityDays, inactivityRounds) ?? undefined}
            >
              {driver.driver_statuses?.name}
            </td>
            <td class="py-3 pr-6 text-right">
              <a href={`/admin/drivers/${driver.id}`} class="text-sm font-semibold text-brand-primary hover:underline">Edit</a>
            </td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
</AdminLayout>

<script>
  document.addEventListener('astro:page-load', () => {
    document.querySelectorAll<HTMLButtonElement>('[data-confirm]').forEach((btn) => {
      btn.addEventListener('click', (e) => {
        if (!confirm(btn.dataset.confirm || 'Are you sure?')) e.preventDefault();
      });
    });
  });
</script>
