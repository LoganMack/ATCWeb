---
export const prerender = false;

import AdminLayout from '../../../layouts/AdminLayout.astro';
import {
  resolveSupabaseEnv,
  getDriverById,
  createDriver,
  updateDriver,
  deleteDriver,
  getDriverStatuses,
  getDriverClasses,
  getDriversForNumberCheck,
  getDriversBasic,
  getDriverLastRace,
  setDriverCarNumber,
  getSiteSettings,
  getSeasons,
  getDriverSeasonClassesForDriver,
  upsertDriverSeasonClass,
  deleteDriverSeasonClass,
  uploadToStorage,
  formatDate,
  type DriverRecord,
  type Season,
  type DriverSeasonClass,
} from '../../../lib/supabase';
import { getAllProfiles } from '../../../lib/auth';
import { COUNTRIES } from '../../../lib/countries';
import { INACTIVITY_DAYS_KEY, INACTIVITY_ROUNDS_KEY, siteSettingInt } from '../../../lib/siteSettings';

const supabaseEnv = resolveSupabaseEnv(Astro.locals);
const accessToken = Astro.locals.session!.accessToken;
const { id } = Astro.params;
const isNew = id === 'new';

let error: string | null = null;
let seasonClassError: string | null = null;

function extFromFile(file: File): string {
  const fromName = file.name.split('.').pop();
  if (fromName && fromName.length <= 5) return fromName.toLowerCase();
  const map: Record<string, string> = {
    'image/png': 'png',
    'image/jpeg': 'jpg',
    'image/webp': 'webp',
    'image/svg+xml': 'svg',
  };
  return map[file.type] ?? 'png';
}

// car_number, status_id, is_rookie, appearances/starts/seasons_count/
// penalty_points(-max), car, and team_id are all deliberately absent here —
// see the template for why each one is no longer a plain form field:
//   - car_number: goes through setDriverCarNumber() separately below, not
//     a plain field on this payload, since it needs the conflict-resolution
//     logic that function implements (see its own doc comment)
//   - status_id: fully automatic (sync_driver_statuses(), called from the
//     Drivers list page)
//   - is_rookie: fully automatic (sync_rookie_status()) — every new driver
//     starts a rookie (set directly in the create call below), and it's
//     only ever cleared by that sync, never set here
//   - appearances/starts/seasons_count/penalty_points/penalty_points_max:
//     only ever computed by other logic (results/penalties pages)
//   - car: "totally irrelevant" per Logan — determined by race results, not
//     something this roster record should claim to know in advance
//   - team_id: team roster assignment lives solely on the Teams admin page
//     now, not duplicated here
function readForm(form: FormData): Partial<DriverRecord> {
  const iratingRaw = String(form.get('starting_irating') ?? '').trim();
  return {
    name: String(form.get('name') ?? '').trim(),
    class_id: Number(form.get('class_id')),
    starting_irating: iratingRaw ? Number(iratingRaw) : null,
    bio: String(form.get('bio') ?? '').trim() || null,
    // Only ever present on the edit form (see template) — absent on create
    // just reads back as false/null here, which are exactly the right
    // defaults for a driver who was never on probation and has no override
    // sign-up date typed in yet.
    on_probation: form.get('on_probation') === 'on',
    probation_started_at: String(form.get('probation_started_at') ?? '').trim() || null,
    is_hall_of_fame: form.get('is_hall_of_fame') === 'on',
    nationality_1: String(form.get('nationality_1') ?? '').trim() || null,
    // A second nationality only means anything once a first is set — clear
    // it too if the first was cleared, rather than leaving an orphaned
    // nationality_2 no flag would ever render with nationality_1 blank.
    nationality_2: form.get('nationality_1') ? String(form.get('nationality_2') ?? '').trim() || null : null,
  };
}

function readCarNumber(form: FormData): number | null {
  const raw = String(form.get('car_number') ?? '').trim();
  return raw ? Number(raw) : null;
}

/**
 * File upload takes priority over the fallback URL field, which takes
 * priority over leaving the existing photo untouched. There's no "clear the
 * photo" affordance here (both being empty just means "don't change it") —
 * a driver going photo-less isn't something this form needs to support.
 */
async function resolvePhotoUrl(
  form: FormData,
  pathId: string,
  existing: string | null
): Promise<string | null> {
  const file = form.get('photo');
  if (file instanceof File && file.size > 0) {
    const path = `driver-${pathId}-${Date.now()}.${extFromFile(file)}`;
    return await uploadToStorage(supabaseEnv, accessToken, 'photos', path, file);
  }
  const typedUrl = String(form.get('photo_url') ?? '').trim();
  if (typedUrl) return typedUrl;
  return existing;
}

const [statuses, classes, seasons] = await Promise.all([
  getDriverStatuses(supabaseEnv),
  getDriverClasses(supabaseEnv),
  getSeasons(supabaseEnv),
]);
const newStatusId = statuses.find((s) => s.name === 'New')?.id ?? statuses[0]?.id;

// Which classes existed in a given season — Alpha has always existed;
// Gamma/Delta are opt-in per season (see seasons.gamma_enabled/
// delta_enabled, 0037_class_and_scoring_fixes.sql). Powers both the radio
// options below and server-side validation that a submitted class_id
// actually existed in the season it's being set for.
function classesForSeason(season: Season) {
  return classes.filter(
    (c) => c.name === 'Alpha' || (c.name === 'Gamma' && season.gamma_enabled) || (c.name === 'Delta' && season.delta_enabled)
  );
}

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const intent = String(form.get('intent') ?? 'save');

  if (intent === 'delete' && !isNew && id) {
    try {
      await deleteDriver(supabaseEnv, accessToken, id);
      return Astro.redirect('/admin/drivers', 302);
    } catch (err) {
      console.error('Failed to delete driver:', err);
      error = 'Failed to delete this driver.';
    }
  } else if ((intent === 'set-season-class' || intent === 'clear-season-class') && !isNew && id) {
    const seasonId = String(form.get('season_id') ?? '');
    if (seasonId) {
      try {
        if (intent === 'clear-season-class') {
          await deleteDriverSeasonClass(supabaseEnv, accessToken, id, seasonId);
        } else {
          const classId = Number(form.get('class_id'));
          const season = seasons.find((s) => s.id === seasonId);
          if (!season || !classesForSeason(season).some((c) => c.id === classId)) {
            seasonClassError = "That class didn't exist in the selected season.";
          } else {
            await upsertDriverSeasonClass(supabaseEnv, accessToken, { driver_id: id, season_id: seasonId, class_id: classId });
          }
        }
        if (!seasonClassError) return Astro.redirect(`/admin/drivers/${id}`, 302);
      } catch (err) {
        console.error('Failed to update driver season class:', err);
        seasonClassError = err instanceof Error ? err.message : "Failed to save that season's class.";
      }
    }
  } else {
    const data = readForm(form);
    const carNumber = readCarNumber(form);
    if (!data.name) {
      error = 'Name is required.';
    } else if (
      (await getDriversBasic(supabaseEnv)).some(
        (other) => other.name.trim().toLowerCase() === data.name!.toLowerCase() && other.id !== id
      )
    ) {
      error = `A driver named "${data.name}" already exists.`;
    } else {
      try {
        if (isNew) {
          let photo_url: string | null = null;
          try {
            photo_url = await resolvePhotoUrl(form, 'new', null);
          } catch (photoErr) {
            console.error('Failed to upload driver photo:', photoErr);
            error = 'Failed to upload that photo.';
          }
          if (!error) {
            // Created with no car_number — set separately below via
            // setDriverCarNumber() so the same conflict-resolution logic
            // (block if held by anyone not Inactive, free it up if they
            // are) applies on creation exactly like it does on every later
            // edit, instead of a plain insert bypassing it. is_rookie:true
            // and today's sign_up_date are set directly here since neither
            // is a visible field on the create form (see the template).
            const created = await createDriver(supabaseEnv, accessToken, {
              ...data,
              status_id: newStatusId,
              is_rookie: true,
              sign_up_date: new Date().toISOString().slice(0, 10),
              photo_url,
            });
            try {
              await setDriverCarNumber(supabaseEnv, accessToken, created.id, carNumber);
            } catch (numErr) {
              // Driver row already exists at this point (no real
              // cross-request transaction here, same tradeoff this
              // codebase already accepts elsewhere, e.g. setCurrentSeason).
              // Land them on the new driver's own edit page instead of a
              // dead end, so fixing the number is a one-field retry.
              return Astro.redirect(
                `/admin/drivers/${created.id}?error=${encodeURIComponent(numErr instanceof Error ? numErr.message : String(numErr))}`,
                302
              );
            }
            return Astro.redirect(`/admin/drivers/${created.id}`, 302);
          }
        } else if (id) {
          const existing = await getDriverById(supabaseEnv, id);
          let photo_url: string | null = existing?.photo_url ?? null;
          try {
            photo_url = await resolvePhotoUrl(form, id, existing?.photo_url ?? null);
          } catch (photoErr) {
            console.error('Failed to upload driver photo:', photoErr);
            error = 'Failed to upload that photo.';
          }
          if (!error) {
            // Car number set FIRST, deliberately — it's the one part of
            // this save that can fail on a conflict (see
            // setDriverCarNumber's own doc comment), and this driver row
            // already exists either way, so checking/claiming the number
            // before touching anything else means a conflict blocks the
            // whole save atomically instead of silently committing the
            // other field changes (name, bio, etc.) while only the number
            // change gets rejected.
            await setDriverCarNumber(supabaseEnv, accessToken, id, carNumber);
            await updateDriver(supabaseEnv, accessToken, id, {
              ...data,
              // sign_up_date isn't in readForm's return (it's edit-only,
              // read separately here) — only overwritten if the field was
              // actually present on this form (it always is on the edit
              // page), so this never accidentally blanks it.
              sign_up_date: String(form.get('sign_up_date') ?? '').trim() || null,
              photo_url,
            });
            return Astro.redirect(`/admin/drivers/${id}`, 302);
          }
        }
      } catch (err) {
        console.error('Failed to save driver:', err);
        error = err instanceof Error ? err.message : 'Failed to save changes.';
      }
    }
  }
}

let driver: DriverRecord | null = null;
if (!isNew && id) {
  driver = await getDriverById(supabaseEnv, id);
  if (!driver) return Astro.redirect('/admin/drivers', 302);
}

// Query-string error — see the redirect above for why creation surfaces its
// car_number failure this way instead of re-rendering the form inline.
if (!error) {
  const qsError = Astro.url.searchParams.get('error');
  if (qsError) error = qsError;
}

const d: Partial<DriverRecord> = driver ?? {
  name: '',
  car_number: null,
  status_id: newStatusId,
  class_id: classes[0]?.id,
  is_rookie: true,
  is_hall_of_fame: false,
  appearances: 0,
  starts: 0,
  seasons_count: 0,
  penalty_points: 0,
  penalty_points_max: 11,
  starting_irating: null,
  photo_url: '',
  bio: '',
  on_probation: false,
  probation_started_at: null,
  nationality_1: null,
  nationality_2: null,
};

const statusName = statuses.find((s) => s.id === d.status_id)?.name ?? null;

// Per-season class overrides — see driver_season_classes
// (0037_class_and_scoring_fixes.sql). A season with no row here just falls
// back to the driver's primary class (d.class_id) above.
let driverSeasonClasses: DriverSeasonClass[] = [];
if (!isNew && id) {
  try {
    driverSeasonClasses = await getDriverSeasonClassesForDriver(supabaseEnv, id);
  } catch (err) {
    console.error('Failed to load driver season classes:', err);
  }
}
const seasonClassOverrideBySeasonId = new Map(driverSeasonClasses.map((r) => [r.season_id, r.class_id]));

// Inactivity threshold is admin-editable now (0041_driver_settings.sql) —
// loaded here purely so this note can quote the real configured numbers
// instead of hardcoding what used to be a fixed 90/12.
let inactivityDays = 90;
let inactivityRounds = 12;
try {
  const settings = await getSiteSettings(supabaseEnv);
  inactivityDays = siteSettingInt(settings, INACTIVITY_DAYS_KEY);
  inactivityRounds = siteSettingInt(settings, INACTIVITY_ROUNDS_KEY);
} catch (err) {
  console.error('Failed to load driver settings for inactivity note:', err);
}

// Countdown note — same "both configured thresholds since their last race"
// rule sync_driver_statuses() itself uses (see driver_last_race's own doc
// comment / 0041_driver_settings.sql). Both thresholds have to be crossed —
// whichever takes longer is effectively what's being waited on. Always the
// same "progress toward both thresholds" wording/format regardless of
// which threshold(s) are already met — a single-line, semicolon-separated
// summary — rather than switching to different phrasing per case, which
// just made an already-simple status harder to scan for no real benefit.
// Only meaningful for New/Active (Veteran is exempt; Inactive already IS
// inactive) and only once the driver actually exists (a not-yet-created
// driver has no id to look up race history for).
let inactivityNote: string | null = null;
if (!isNew && driver && (statusName === 'New' || statusName === 'Active')) {
  const { last_race_at: lastRaceAt, rounds_since_last_race: roundsSince } = await getDriverLastRace(
    supabaseEnv,
    driver.id
  );
  if (lastRaceAt) {
    const daysSince = Math.floor((Date.now() - new Date(lastRaceAt).getTime()) / (1000 * 60 * 60 * 24));
    const rounds = roundsSince ?? 0;
    inactivityNote = `Last raced ${formatDate(lastRaceAt)}; ${rounds}/${inactivityRounds} rounds absent; ${daysSince}/${inactivityDays} days absent`;
  } else {
    inactivityNote = `Inactive if absent ${inactivityDays} days and ${inactivityRounds} rounds after sign-up.`;
  }
}

// Live "is this number taken?" lookup — fetched once, matched client-side
// as the admin types (see the script below), rather than a round trip per
// keystroke. Excludes this driver's own current number so editing a driver
// without changing their number never flags itself as a conflict.
const numberLookup = (await getDriversForNumberCheck(supabaseEnv)).filter((r) => r.id !== d.id);

let profileNameById = new Map<string, string>();
if (!isNew && driver && (driver.created_by || driver.updated_by)) {
  try {
    const profiles = await getAllProfiles(supabaseEnv, accessToken);
    profileNameById = new Map(profiles.map((p) => [p.id, p.display_name || p.iracing_name || 'Unknown admin']));
  } catch (err) {
    console.error('Failed to load profiles for driver audit info:', err);
  }
}
---

<AdminLayout title={isNew ? 'New Driver' : d.name || 'Edit Driver'}>
  <div class="reveal flex items-start justify-between gap-4">
    <h1 class="font-display text-4xl">{isNew ? 'New Driver' : d.name}</h1>
    {!isNew && (
      <div class="flex flex-col items-end gap-1 text-right">
        <div class="rounded-md border border-white/10 bg-white/[0.03] px-3 py-1.5 text-sm font-semibold text-white/80">
          {statusName ?? '—'}
        </div>
        {inactivityNote && <span class="max-w-xs text-xs text-white/40">{inactivityNote}</span>}
        {!inactivityNote && statusName && (
          <span class="max-w-xs text-xs text-white/40">
            {statusName === 'Veteran'
              ? 'Veterans are exempt from inactivity.'
              : 'Inactive until next appearance.'}
          </span>
        )}
      </div>
    )}
  </div>

  {error && (
    <p class="reveal mt-6 break-words rounded-lg border border-brand-pink/30 bg-brand-pink/10 p-4 text-sm text-white/80">{error}</p>
  )}

  <form
    method="POST"
    data-astro-reload
    enctype="multipart/form-data"
    class="reveal mt-8 grid max-w-2xl gap-4 sm:grid-cols-2"
    style="transition-delay: 80ms"
  >
    <label class="flex flex-col gap-1.5 text-sm sm:col-span-2">
      <span class="text-white/70">Name</span>
      <input
        type="text"
        name="name"
        required
        value={d.name}
        class="rounded-md border border-white/15 bg-white/5 px-3 py-2 text-white outline-none focus:border-brand-primary"
      />
    </label>

    <label class="flex flex-col gap-1.5 text-sm">
      <span class="text-white/70">Car number</span>
      <input
        type="number"
        name="car_number"
        id="car_number_input"
        value={d.car_number ?? ''}
        class="rounded-md border border-white/15 bg-white/5 px-3 py-2 text-white outline-none focus:border-brand-primary"
      />
      <span id="car_number_hint" class="text-xs text-white/40"></span>
    </label>

    <label class="flex flex-col gap-1.5 text-sm sm:col-span-2">
      <span class="text-white/70">Photo</span>
      <div class="flex items-center gap-3">
        {d.photo_url && (
          <img src={d.photo_url} alt="" class="h-14 w-14 flex-none rounded-full object-cover ring-1 ring-white/10" />
        )}
        <input
          type="file"
          name="photo"
          accept="image/png,image/jpeg,image/webp"
          class="w-full text-xs text-white/60 file:mr-2 file:rounded-lg file:border-0 file:bg-white/10 file:px-3 file:py-1.5 file:text-xs file:text-white"
        />
      </div>
      <input
        type="text"
        name="photo_url"
        placeholder="...or paste an image URL instead of uploading"
        class="mt-1 rounded-md border border-white/15 bg-white/5 px-3 py-2 text-xs text-white outline-none focus:border-brand-primary"
      />
    </label>

    <label class="flex flex-col gap-1.5 text-sm sm:col-span-2">
      <span class="text-white/70">Bio</span>
      <textarea
        name="bio"
        rows="4"
        class="rounded-md border border-white/15 bg-white/5 px-3 py-2 text-white outline-none focus:border-brand-primary"
      >{d.bio}</textarea>
    </label>

    <label class="flex flex-col gap-1.5 text-sm">
      <span class="text-white/70">Starting iRating</span>
      <input
        type="number"
        name="starting_irating"
        min="0"
        max="20000"
        step="1"
        value={d.starting_irating ?? ''}
        placeholder="e.g. 2500"
        class="rounded-md border border-white/15 bg-white/5 px-3 py-2 text-white outline-none focus:border-brand-primary"
      />
    </label>

    <label class="flex flex-col gap-1.5 text-sm">
      <span class="text-white/70">Class</span>
      <select
        name="class_id"
        class="rounded-md border border-white/15 bg-white/5 px-3 py-2 text-white outline-none focus:border-brand-primary"
      >
        {classes.map((c) => (
          <option value={c.id} selected={c.id === d.class_id} class="bg-brand-ink text-white">{c.name}</option>
        ))}
      </select>
    </label>

    <label class="flex flex-col gap-1.5 text-sm">
      <span class="text-white/70">Nationality</span>
      <select
        name="nationality_1"
        class="rounded-md border border-white/15 bg-white/5 px-3 py-2 text-white outline-none focus:border-brand-primary"
      >
        <option value="" class="bg-brand-ink text-white">None</option>
        {COUNTRIES.map((c) => (
          <option value={c.code} selected={c.code === d.nationality_1} class="bg-brand-ink text-white">{c.name}</option>
        ))}
      </select>
    </label>
    <label class="flex flex-col gap-1.5 text-sm">
      <span class="text-white/70">Second nationality (optional)</span>
      <select
        name="nationality_2"
        class="rounded-md border border-white/15 bg-white/5 px-3 py-2 text-white outline-none focus:border-brand-primary"
      >
        <option value="" class="bg-brand-ink text-white">None</option>
        {COUNTRIES.map((c) => (
          <option value={c.code} selected={c.code === d.nationality_2} class="bg-brand-ink text-white">{c.name}</option>
        ))}
      </select>
    </label>

    {!isNew && (
      <>
        <label class="flex flex-col gap-1.5 text-sm">
          <span class="text-white/70">Sign-up date</span>
          <input
            type="date"
            name="sign_up_date"
            value={d.sign_up_date ?? ''}
            class="rounded-md border border-white/15 bg-white/5 px-3 py-2 text-white outline-none focus:border-brand-primary"
          />
        </label>

        <label class="flex flex-col gap-1.5 text-sm">
          <span class="text-white/70">Probation started</span>
          <input
            type="date"
            name="probation_started_at"
            value={d.probation_started_at ?? ''}
            class="rounded-md border border-white/15 bg-white/5 px-3 py-2 text-white outline-none focus:border-brand-primary"
          />
        </label>
        <label class="flex items-center gap-2 text-sm">
          <input type="checkbox" name="on_probation" checked={d.on_probation} />
          <span class="text-white/70">On probation</span>
        </label>

        <label class="flex items-center gap-2 text-sm">
          <input type="checkbox" name="is_hall_of_fame" checked={d.is_hall_of_fame} />
          <span class="text-white/70">Hall of Fame member</span>
        </label>

        <div class="flex flex-col gap-1.5 text-sm sm:col-span-2">
          <span class="text-white/70">Career stats</span>
          <div class="grid grid-cols-2 gap-x-4 gap-y-1 rounded-md border border-white/10 bg-white/[0.03] px-3 py-2 text-white/70 sm:grid-cols-5">
            <div><span class="text-white/40">Appearances</span> <span class="font-semibold text-white/90">{d.appearances}</span></div>
            <div><span class="text-white/40">Starts</span> <span class="font-semibold text-white/90">{d.starts}</span></div>
            <div><span class="text-white/40">Seasons</span> <span class="font-semibold text-white/90">{d.seasons_count}</span></div>
            <div><span class="text-white/40">PP (season)</span> <span class="font-semibold text-white/90">{d.penalty_points}</span></div>
            <div><span class="text-white/40">PP max</span> <span class="font-semibold text-white/90">{d.penalty_points_max}</span></div>
          </div>
        </div>

        {driver && (driver.created_by || driver.updated_by) && (
          <p class="text-xs text-white/30 sm:col-span-2">
            {driver.created_by && (
              <>Created by {profileNameById.get(driver.created_by) ?? 'an admin'} on {formatDate(driver.created_at)}. </>
            )}
            {driver.updated_by && (
              <>Last updated by {profileNameById.get(driver.updated_by) ?? 'an admin'} on {formatDate(driver.updated_at)}.</>
            )}
          </p>
        )}
      </>
    )}

    <div class="mt-2 flex gap-3 sm:col-span-2">
      <button
        type="submit"
        name="intent"
        value="save"
        class="rounded-lg bg-brand-primary px-6 py-3 font-semibold transition hover:brightness-110"
      >
        {isNew ? 'Create Driver' : 'Save Changes'}
      </button>
      <a href="/admin/drivers" class="rounded-lg bg-white/5 px-6 py-3 font-semibold ring-1 ring-white/10 transition hover:bg-white/10">
        Cancel
      </a>
    </div>
  </form>

  {!isNew && (
    <div class="reveal mt-10 max-w-2xl border-t border-white/10 pt-6" style="transition-delay: 90ms">
      <h2 class="text-lg font-semibold">Driver Class by Season</h2>

      {seasonClassError && (
        <p class="mt-4 rounded-lg border border-brand-pink/30 bg-brand-pink/10 p-3 text-sm text-white/80">{seasonClassError}</p>
      )}

      {seasons.length === 0 ? (
        <p class="mt-4 text-sm text-white/40">No seasons yet — add one under Seasons first.</p>
      ) : (
        <ul class="mt-4 flex flex-col gap-2">
          {seasons
            .slice()
            .sort((a, b) => b.number - a.number)
            .map((season) => {
              const options = classesForSeason(season);
              const hasOverride = seasonClassOverrideBySeasonId.has(season.id);
              const effectiveClassId = seasonClassOverrideBySeasonId.get(season.id) ?? d.class_id;
              return (
                <li class="flex flex-wrap items-center gap-3 rounded-md bg-white/5 px-3 py-2 text-sm ring-1 ring-white/10">
                  <span class="min-w-[8rem] font-semibold">{season.name}</span>
                  <form method="POST" data-astro-reload class="flex flex-wrap items-center gap-3">
                    <input type="hidden" name="intent" value="set-season-class" />
                    <input type="hidden" name="season_id" value={season.id} />
                    {options.map((c) => (
                      <label class="flex items-center gap-1.5 text-xs text-white/60">
                        <input
                          type="radio"
                          name="class_id"
                          value={c.id}
                          checked={c.id === effectiveClassId}
                          onchange="this.form.submit()"
                          class="h-3.5 w-3.5 border-white/20 bg-white/5 accent-brand-primary"
                        />
                        {c.name}{!hasOverride && c.id === d.class_id ? ' (primary)' : ''}
                      </label>
                    ))}
                  </form>
                  {hasOverride && (
                    <form method="POST" data-astro-reload>
                      <input type="hidden" name="intent" value="clear-season-class" />
                      <input type="hidden" name="season_id" value={season.id} />
                      <button type="submit" class="text-xs font-semibold text-white/40 transition hover:text-brand-pink">Reset to primary</button>
                    </form>
                  )}
                </li>
              );
            })}
        </ul>
      )}
    </div>
  )}

  {!isNew && (
    <form method="POST" data-astro-reload class="reveal mt-10 max-w-2xl border-t border-white/10 pt-6" style="transition-delay: 100ms">
      <input type="hidden" name="intent" value="delete" />
      <button
        type="submit"
        data-confirm="Delete this driver? This can't be undone."
        class="rounded-lg bg-brand-pink/10 px-5 py-2.5 text-sm font-semibold text-brand-pink ring-1 ring-brand-pink/30 transition hover:bg-brand-pink/20"
      >
        Delete Driver
      </button>
    </form>
  )}
</AdminLayout>

<script type="application/json" id="car-number-lookup-data" set:html={JSON.stringify(numberLookup)} />
<script>
  document.addEventListener('astro:page-load', () => {
    document.querySelectorAll<HTMLButtonElement>('[data-confirm]').forEach((btn) => {
      btn.addEventListener('click', (e) => {
        if (!confirm(btn.dataset.confirm || 'Are you sure?')) e.preventDefault();
      });
    });

    const input = document.getElementById('car_number_input') as HTMLInputElement | null;
    const hint = document.getElementById('car_number_hint');
    const dataEl = document.getElementById('car-number-lookup-data');
    if (!input || !hint || !dataEl) return;
    let lookup: { car_number: number; name: string; driver_statuses: { name: string } | null }[] = [];
    try {
      lookup = JSON.parse(dataEl.textContent || '[]');
    } catch {
      lookup = [];
    }

    function updateHint() {
      const raw = input!.value.trim();
      if (!raw) {
        hint!.textContent = '';
        return;
      }
      const num = Number(raw);
      const match = lookup.find((d) => d.car_number === num);
      if (!match) {
        hint!.textContent = 'Available.';
        hint!.className = 'text-xs text-brand-primary';
        return;
      }
      const status = match.driver_statuses?.name ?? 'unknown status';
      if (status === 'Inactive') {
        hint!.textContent = `Car #${num} was last used by ${match.name} (Inactive) — saving will free it up from them.`;
        hint!.className = 'text-xs text-brand-gold';
      } else {
        hint!.textContent = `Car #${num} is currently used by ${match.name} (${status}).`;
        hint!.className = 'text-xs text-brand-pink';
      }
    }

    input.addEventListener('input', updateHint);
    updateHint();
  });
</script>
