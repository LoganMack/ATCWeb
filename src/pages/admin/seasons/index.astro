---
export const prerender = false;

import AdminLayout from '../../../layouts/AdminLayout.astro';
import {
  resolveSupabaseEnv,
  getSeasons,
  updateSeasonLogo,
  updateSeasonRuleset,
  setCurrentSeason,
  uploadToStorage,
  getScoringRulesets,
  resolveSeasonRuleset,
  recalculateSeasonScores,
  type ScoringRuleset,
  type SeasonRecalcResult,
} from '../../../lib/supabase';

const supabaseEnv = resolveSupabaseEnv(Astro.locals);
const accessToken = Astro.locals.session!.accessToken;

let error: string | null = null;
// Set only by the "recalculate" intent below, and deliberately NOT followed
// by a redirect the way every other intent on this page is — a redirect
// would throw away the per-round results before they could ever be shown,
// and the whole point of recalculate_season_scores() returning a row per
// round (see its own doc comment) is to surface exactly which rounds
// failed and why, right here, instead of a single pass/fail toast.
let recalcResult: { seasonId: string; results: SeasonRecalcResult[] } | null = null;

function extFromFile(file: File): string {
  const fromName = file.name.split('.').pop();
  if (fromName && fromName.length <= 5) return fromName.toLowerCase();
  const map: Record<string, string> = {
    'image/png': 'png',
    'image/jpeg': 'jpg',
    'image/webp': 'webp',
    'image/svg+xml': 'svg',
  };
  return map[file.type] ?? 'png';
}

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const intent = String(form.get('intent') ?? 'save');
  const seasonId = String(form.get('season_id') ?? '');

  if (!seasonId) {
    error = 'Missing season.';
  } else if (intent === 'remove') {
    try {
      await updateSeasonLogo(supabaseEnv, accessToken, seasonId, null);
    } catch (err) {
      console.error('Failed to remove season logo:', err);
      error = 'Failed to remove that logo.';
    }
    if (!error) return Astro.redirect('/admin/seasons', 302);
  } else if (intent === 'recalculate') {
    try {
      const results = await recalculateSeasonScores(supabaseEnv, accessToken, seasonId);
      recalcResult = { seasonId, results };
    } catch (err) {
      console.error('Failed to recalculate season scores:', err);
      error = err instanceof Error ? err.message : 'Failed to recalculate this season.';
    }
    // No redirect — see recalcResult's own doc comment above.
  } else if (intent === 'set-current') {
    try {
      await setCurrentSeason(supabaseEnv, accessToken, seasonId);
    } catch (err) {
      console.error('Failed to set current season:', err);
      error = 'Failed to set that season as current.';
    }
    if (!error) return Astro.redirect('/admin/seasons', 302);
  } else if (intent === 'set-ruleset') {
    const rulesetId = String(form.get('scoring_ruleset_id') ?? '').trim() || null;
    try {
      await updateSeasonRuleset(supabaseEnv, accessToken, seasonId, rulesetId);
    } catch (err) {
      console.error('Failed to set season ruleset:', err);
      error = 'Failed to save that ruleset assignment.';
    }
    if (!error) return Astro.redirect('/admin/seasons', 302);
  } else {
    const logoUrlField = String(form.get('logo_url') ?? '').trim();
    const logoFile = form.get('logo');

    try {
      let logo_url = logoUrlField || null;
      if (logoFile instanceof File && logoFile.size > 0) {
        const path = `season-${seasonId}-${Date.now()}.${extFromFile(logoFile)}`;
        logo_url = await uploadToStorage(supabaseEnv, accessToken, 'logos', path, logoFile);
      }
      if (!logo_url) {
        error = 'Provide a logo file or a logo URL.';
      } else {
        await updateSeasonLogo(supabaseEnv, accessToken, seasonId, logo_url);
        return Astro.redirect('/admin/seasons', 302);
      }
    } catch (err) {
      console.error('Failed to save season logo:', err);
      error = err instanceof Error ? err.message : 'Failed to save this logo.';
    }
  }
}

let seasons: Awaited<ReturnType<typeof getSeasons>> = [];
try {
  seasons = await getSeasons(supabaseEnv);
} catch (err) {
  console.error('Failed to load seasons:', err);
}

let rulesets: ScoringRuleset[] = [];
try {
  rulesets = await getScoringRulesets(supabaseEnv);
} catch (err) {
  console.error('Failed to load scoring rulesets:', err);
}
const defaultRuleset = rulesets.find((r) => r.is_default) ?? null;
---

<AdminLayout title="Seasons">
  <h1 class="reveal font-display text-4xl">Seasons</h1>
  <p class="reveal mt-2 max-w-2xl text-sm text-white/60" style="transition-delay: 40ms">
    Each season can have its own logo — the branding gets a small refresh every season, and this is where that
    shows up: next to the season picker on Standings/Team Standings/Race Results, and next to the season on each
    Champions card. A season with no logo set just shows its name with no image, same as before this existed.
    The season marked <span class="font-semibold text-brand-primary">Current</span> is also what every season
    picker across the site defaults to — use "Set as Current" below to change it.
  </p>

  {error && (
    <p class="reveal mt-6 rounded-lg border border-brand-pink/30 bg-brand-pink/10 p-4 text-sm text-white/80">{error}</p>
  )}

  <div class="reveal mt-8 flex flex-col gap-3" style="transition-delay: 60ms">
    {seasons.length === 0 && <p class="text-sm text-white/40">No results.</p>}
    {seasons.map((season) => (
      <>
      <div class="flex flex-wrap items-center gap-3 rounded-lg bg-white/5 p-3 ring-1 ring-white/10">
        {season.logo_url ? (
          <img src={season.logo_url} alt="" class="h-10 w-10 flex-none rounded object-contain" />
        ) : (
          <div class="h-10 w-10 flex-none rounded bg-white/10"></div>
        )}
        <span class="min-w-[10rem] font-semibold">
          {season.name}
          {season.is_current && <span class="ml-2 text-xs font-normal text-brand-primary">Current</span>}
        </span>
        <form method="POST" data-astro-reload enctype="multipart/form-data" class="flex flex-wrap items-center gap-2">
          <input type="hidden" name="intent" value="save" />
          <input type="hidden" name="season_id" value={season.id} />
          <input
            type="text"
            name="logo_url"
            placeholder="Logo URL (optional if uploading a file)"
            class="w-56 rounded-md border border-white/15 bg-white/5 px-2 py-1.5 text-xs text-white outline-none focus:border-brand-primary"
          />
          <input
            type="file"
            name="logo"
            accept="image/png,image/jpeg,image/webp,image/svg+xml"
            class="w-56 text-xs text-white/60 file:mr-2 file:rounded-lg file:border-0 file:bg-white/10 file:px-3 file:py-1.5 file:text-xs file:text-white"
          />
          <button
            type="submit"
            class="rounded-lg bg-brand-primary px-3 py-1.5 text-xs font-semibold transition hover:brightness-110"
          >
            Save
          </button>
        </form>
        {season.logo_url && (
          <form method="POST" data-astro-reload>
            <input type="hidden" name="intent" value="remove" />
            <input type="hidden" name="season_id" value={season.id} />
            <button type="submit" class="text-xs font-semibold text-white/40 transition hover:text-brand-pink">Remove</button>
          </form>
        )}
        {!season.is_current && (
          <form method="POST" data-astro-reload>
            <input type="hidden" name="intent" value="set-current" />
            <input type="hidden" name="season_id" value={season.id} />
            <button
              type="submit"
              class="rounded-lg bg-white/5 px-3 py-1.5 text-xs font-semibold text-white/70 ring-1 ring-white/10 transition hover:bg-white/10"
            >
              Set as Current
            </button>
          </form>
        )}
        <form method="POST" data-astro-reload class="flex items-center gap-2">
          <input type="hidden" name="intent" value="set-ruleset" />
          <input type="hidden" name="season_id" value={season.id} />
          <label class="flex items-center gap-1.5 text-xs text-white/60">
            Ruleset
            <select
              name="scoring_ruleset_id"
              onchange="this.form.submit()"
              class="rounded-md border border-white/15 bg-white/5 px-2 py-1.5 text-xs text-white outline-none focus:border-brand-primary"
            >
              <option value="" class="bg-brand-ink text-white" selected={!season.scoring_ruleset_id}>
                {defaultRuleset ? `(use default — ${defaultRuleset.name})` : '(use default — none set)'}
              </option>
              {rulesets.map((r) => (
                <option value={r.id} class="bg-brand-ink text-white" selected={r.id === season.scoring_ruleset_id}>
                  {r.name}
                </option>
              ))}
            </select>
          </label>
        </form>
        {!resolveSeasonRuleset(season, rulesets) && (
          <span class="text-xs font-semibold text-brand-pink">No ruleset resolved — scoring will fail until one is assigned or a default is set</span>
        )}
        <form
          method="POST"
          data-astro-reload
          onsubmit={`return confirm(${JSON.stringify(
            `Recalculate every round in ${season.name}? This rescoring uses whatever ruleset is currently assigned and overwrites that season's existing race_scores.`
          )});`}
        >
          <input type="hidden" name="intent" value="recalculate" />
          <input type="hidden" name="season_id" value={season.id} />
          <button
            type="submit"
            class="rounded-lg bg-white/5 px-3 py-1.5 text-xs font-semibold text-white/70 ring-1 ring-white/10 transition hover:bg-white/10"
          >
            Recalculate
          </button>
        </form>
      </div>

      {recalcResult && recalcResult.seasonId === season.id && (() => {
        const failures = recalcResult.results.filter((r) => r.error_message !== null);
        const successes = recalcResult.results.filter((r) => r.error_message === null);
        return (
          <div class="ml-1 flex flex-col gap-1.5 rounded-lg border border-white/10 bg-white/[0.03] p-3 text-xs">
            <p class={failures.length === 0 ? 'font-semibold text-brand-primary' : 'font-semibold text-brand-gold'}>
              Recalculated {recalcResult.results.length} round{recalcResult.results.length === 1 ? '' : 's'} —{' '}
              {successes.length} succeeded{failures.length > 0 && `, ${failures.length} failed`}.
            </p>
            {failures.length > 0 && (
              <ul class="flex flex-col gap-1 text-white/60">
                {failures.map((f) => (
                  <li>
                    <span class="font-mono text-white/80">{f.subsession_id}</span>: {f.error_message}
                  </li>
                ))}
              </ul>
            )}
          </div>
        );
      })()}
      </>
    ))}
  </div>
</AdminLayout>
