---
export const prerender = false;

import AdminLayout from '../../../layouts/AdminLayout.astro';
import { resolveSupabaseEnv } from '../../../lib/db/client';
import {
  getSeasons,
  getSeasonById,
  updateSeasonLogo,
  updateSeasonRuleset,
  updateSeasonClassFlags,
  setCurrentSeason,
  getScoringRulesets,
  resolveSeasonRuleset,
  recalculateSeasonScores,
  createSeason,
  CreateSeasonError,
  type ScoringRuleset,
  type SeasonRecalcResult,
} from '../../../lib/db/seasons';
import {
  DUPLICATE_SEASON_MESSAGE,
  newSeasonDefaults,
  parseNewSeasonForm,
  nameForNumberInput,
  seasonRowSaveSummary,
  type NewSeasonValues,
} from '../../../lib/seasonForm';
import { uploadToStorage } from '../../../lib/db/assets';
import { logActivity, actorNameFor } from '../../../lib/activityLog';
import { requireFullAdmin } from '../../../lib/auth';

// A restricted area (BR2.7): full Admin only.
const admin = requireFullAdmin(Astro);
if (admin instanceof Response) return admin;

const supabaseEnv = resolveSupabaseEnv(Astro.locals);
const accessToken = admin.accessToken;
const actor = { id: admin.user.id, name: actorNameFor(admin) };

let error: string | null = null;
// Set by "recalculate" only, which re-renders instead of redirecting so the per-round results from
// rescore_season() (which rounds failed and why) can be shown.
let recalcResult: { seasonId: string; results: SeasonRecalcResult[] } | null = null;
// The New season form's values after a refused create, so the form shows what was typed.
let newSeasonValues: NewSeasonValues | null = null;

function extFromFile(file: File): string {
  const fromName = file.name.split('.').pop();
  if (fromName && fromName.length <= 5) return fromName.toLowerCase();
  const map: Record<string, string> = {
    'image/png': 'png',
    'image/jpeg': 'jpg',
    'image/webp': 'webp',
    'image/svg+xml': 'svg',
  };
  return map[file.type] ?? 'png';
}

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const intent = String(form.get('intent') ?? 'save');
  const seasonId = String(form.get('season_id') ?? '');

  // seasons (below) isn't loaded yet at this point — this POST-handling
  // block runs before that section — so fetch a fresh copy here for every
  // branch's activity_log entry label.
  const seasonForLog = seasonId ? await getSeasonById(supabaseEnv, seasonId) : null;

  if (intent === 'create') {
    // New season (FR10). The page is full-admin only, and the insert policy enforces it again (BR10.1).
    try {
      const [existingSeasons, existingRulesets] = await Promise.all([
        getSeasons(supabaseEnv),
        getScoringRulesets(supabaseEnv),
      ]);
      const parsed = parseNewSeasonForm(form, {
        seasonNumbers: existingSeasons.map((s) => s.number),
        rulesetIds: existingRulesets.map((r) => r.id),
      });
      if (!parsed.ok) {
        error = parsed.error;
        newSeasonValues = parsed.values;
      } else {
        const created = await createSeason(supabaseEnv, accessToken, parsed.input);
        await logActivity(supabaseEnv, accessToken, actor, {
          action: 'add',
          entity_type: 'season',
          entity_label: `Created season ${created.name}`,
          entity_id: created.id,
        });
        return Astro.redirect('/admin/seasons', 302);
      }
    } catch (err) {
      console.error('Failed to create season:', err);
      const reason = err instanceof CreateSeasonError ? err.reason : 'failed';
      error =
        reason === 'duplicate'
          ? DUPLICATE_SEASON_MESSAGE
          : reason === 'forbidden'
            ? 'Only full admins can create a season.'
            : 'Failed to create the season.';
      newSeasonValues = null;
    }
    if (error && !newSeasonValues) {
      // Keep what was typed after a database refusal too.
      newSeasonValues = {
        number: String(form.get('number') ?? ''),
        name: nameForNumberInput(String(form.get('number') ?? '')),
        rulesetId: String(form.get('scoring_ruleset_id') ?? ''),
        gamma: form.get('gamma_enabled') === 'on',
        delta: form.get('delta_enabled') === 'on',
        deltaTeam: form.get('delta_team_enabled') === 'on',
      };
    }
  } else if (!seasonId) {
    error = 'Missing season.';
  } else if (intent === 'remove' || intent === 'remove-light') {
    const field = intent === 'remove' ? 'logo_url' : 'logo_url_light';
    try {
      await updateSeasonLogo(supabaseEnv, accessToken, seasonId, { [field]: null });
      await logActivity(supabaseEnv, accessToken, actor, {
        action: 'edit',
        entity_type: 'season',
        entity_label: `${seasonForLog?.name ?? 'Season'} — ${intent === 'remove' ? 'dark' : 'light'} logo removed`,
        entity_id: seasonId,
      });
    } catch (err) {
      console.error('Failed to remove season logo:', err);
      error = 'Failed to remove that logo.';
    }
    if (!error) return Astro.redirect('/admin/seasons', 302);
  } else if (intent === 'recalculate') {
    try {
      const results = await recalculateSeasonScores(supabaseEnv, accessToken, seasonId);
      recalcResult = { seasonId, results };
      const rulesetsForLog = await getScoringRulesets(supabaseEnv);
      const resolvedRuleset = seasonForLog ? resolveSeasonRuleset(seasonForLog, rulesetsForLog) : null;
      const failures = results.filter((r) => r.error_message !== null);
      await logActivity(supabaseEnv, accessToken, actor, {
        action: 'edit',
        entity_type: 'season',
        entity_label: `${seasonForLog?.name ?? 'Season'} — recalculated`,
        entity_id: seasonId,
        details: `Ruleset: ${resolvedRuleset?.name ?? 'none resolved'}. ${results.length} round${results.length === 1 ? '' : 's'}, ${failures.length} failed.`,
      });
    } catch (err) {
      console.error('Failed to recalculate season scores:', err);
      error = err instanceof Error ? err.message : 'Failed to recalculate this season.';
    }
    // No redirect — see recalcResult's own doc comment above.
  } else if (intent === 'set-current') {
    try {
      await setCurrentSeason(supabaseEnv, accessToken, seasonId);
      await logActivity(supabaseEnv, accessToken, actor, {
        action: 'edit',
        entity_type: 'season',
        entity_label: `Current season set to ${seasonForLog?.name ?? seasonId}`,
        entity_id: seasonId,
      });
    } catch (err) {
      console.error('Failed to set current season:', err);
      error = 'Failed to set that season as current.';
    }
    if (!error) return Astro.redirect('/admin/seasons', 302);
  } else if (intent === 'set-ruleset') {
    const rulesetId = String(form.get('scoring_ruleset_id') ?? '').trim() || null;
    try {
      await updateSeasonRuleset(supabaseEnv, accessToken, seasonId, rulesetId);
      await logActivity(supabaseEnv, accessToken, actor, {
        action: 'edit',
        entity_type: 'season',
        entity_label: `${seasonForLog?.name ?? 'Season'} — ruleset assignment`,
        entity_id: seasonId,
      });
    } catch (err) {
      console.error('Failed to set season ruleset:', err);
      error = 'Failed to save that ruleset assignment.';
    }
    if (!error) return Astro.redirect('/admin/seasons', 302);
  } else if (intent === 'set-class-flags') {
    // Checkboxes only submit a value when checked — an unchecked box's
    // field is simply absent from the form data, not sent as "false".
    const gamma_enabled = form.get('gamma_enabled') === '1';
    const delta_enabled = form.get('delta_enabled') === '1';
    const delta_team_enabled = form.get('delta_team_enabled') === '1';
    try {
      await updateSeasonClassFlags(supabaseEnv, accessToken, seasonId, { gamma_enabled, delta_enabled, delta_team_enabled });
      await logActivity(supabaseEnv, accessToken, actor, {
        action: 'edit',
        entity_type: 'season',
        entity_label: `${seasonForLog?.name ?? 'Season'} — class settings`,
        entity_id: seasonId,
        details: `Gamma: ${gamma_enabled ? 'on' : 'off'}, Delta: ${delta_enabled ? 'on' : 'off'}, Delta Team: ${delta_team_enabled ? 'on' : 'off'}`,
      });
    } catch (err) {
      console.error('Failed to set season class flags:', err);
      error = 'Failed to save those class settings.';
    }
    if (!error) return Astro.redirect('/admin/seasons', 302);
  } else {
    // The row's Save (FR3.2): new logos (each optional), the ruleset and the class switches, together.
    const logoUrlField = String(form.get('logo_url') ?? '').trim();
    const logoFile = form.get('logo');
    const logoUrlLightField = String(form.get('logo_url_light') ?? '').trim();
    const logoLightFile = form.get('logo_light');
    const rulesetId = String(form.get('scoring_ruleset_id') ?? '').trim() || null;
    // Checkboxes only submit a value when checked.
    const flags = {
      gamma_enabled: form.get('gamma_enabled') === '1',
      delta_enabled: form.get('delta_enabled') === '1',
      delta_team_enabled: form.get('delta_team_enabled') === '1',
    };

    try {
      const logos: { logo_url?: string | null; logo_url_light?: string | null } = {};

      let logo_url = logoUrlField || null;
      if (logoFile instanceof File && logoFile.size > 0) {
        const path = `season-${seasonId}-${Date.now()}.${extFromFile(logoFile)}`;
        logo_url = await uploadToStorage(supabaseEnv, accessToken, 'logos', path, logoFile);
      }
      if (logo_url) logos.logo_url = logo_url;

      let logo_url_light = logoUrlLightField || null;
      if (logoLightFile instanceof File && logoLightFile.size > 0) {
        const path = `season-${seasonId}-light-${Date.now()}.${extFromFile(logoLightFile)}`;
        logo_url_light = await uploadToStorage(supabaseEnv, accessToken, 'logos', path, logoLightFile);
      }
      if (logo_url_light) logos.logo_url_light = logo_url_light;

      if (Object.keys(logos).length > 0) await updateSeasonLogo(supabaseEnv, accessToken, seasonId, logos);
      const rulesetChanged = (seasonForLog?.scoring_ruleset_id ?? null) !== rulesetId;
      if (rulesetChanged) await updateSeasonRuleset(supabaseEnv, accessToken, seasonId, rulesetId);
      const flagsChanged =
        !seasonForLog ||
        seasonForLog.gamma_enabled !== flags.gamma_enabled ||
        seasonForLog.delta_enabled !== flags.delta_enabled ||
        seasonForLog.delta_team_enabled !== flags.delta_team_enabled;
      if (flagsChanged) await updateSeasonClassFlags(supabaseEnv, accessToken, seasonId, flags);

      if (Object.keys(logos).length > 0 || rulesetChanged || flagsChanged) {
        await logActivity(supabaseEnv, accessToken, actor, {
          action: 'edit',
          entity_type: 'season',
          entity_label: `${seasonForLog?.name ?? 'Season'} — saved`,
          entity_id: seasonId,
          details: seasonRowSaveSummary({
            darkLogo: 'logo_url' in logos,
            lightLogo: 'logo_url_light' in logos,
            rulesetChanged,
            flags: flagsChanged ? flags : null,
          }),
        });
      }
      return Astro.redirect('/admin/seasons', 302);
    } catch (err) {
      console.error('Failed to save season:', err);
      error = err instanceof Error ? err.message : 'Failed to save this season.';
    }
  }
}

let seasons: Awaited<ReturnType<typeof getSeasons>> = [];
try {
  seasons = await getSeasons(supabaseEnv);
} catch (err) {
  console.error('Failed to load seasons:', err);
}

let rulesets: ScoringRuleset[] = [];
try {
  rulesets = await getScoringRulesets(supabaseEnv);
} catch (err) {
  console.error('Failed to load scoring rulesets:', err);
}
const defaultRuleset = rulesets.find((r) => r.is_default) ?? null;
const newSeason = newSeasonValues ?? newSeasonDefaults(seasons, rulesets);
const inputClass =
  'rounded-md border border-white/15 bg-white/5 px-2 py-1.5 text-xs text-white outline-none focus:border-brand-primary';
---

<AdminLayout title="Seasons">
  {error && (
    <p class="reveal mt-6 rounded-lg border border-brand-pink/30 bg-brand-pink/10 p-4 text-sm text-white/80">{error}</p>
  )}

  {/* Add Season (FR1): the next number after the current season, and its name, which is never typed (FR1.2). */}
  <form
    method="POST"
    data-astro-reload
    class="reveal mt-8 flex flex-col gap-3 rounded-lg bg-brand-ink p-3 ring-1 ring-white/10"
    data-new-season-form
  >
    <input type="hidden" name="intent" value="create" />
    <span class="text-sm font-semibold">Add Season</span>
    <div class="flex flex-wrap items-end gap-3">
      <label class="flex flex-col gap-1 text-xs text-white/60">
        Number
        <input type="number" name="number" min="1" step="1" required value={newSeason.number} data-season-number class={`w-24 ${inputClass}`} />
      </label>
      <label class="flex flex-col gap-1 text-xs text-white/60">
        Name
        <input
          type="text"
          name="name"
          readonly
          tabindex="-1"
          value={newSeason.name}
          data-season-name
          class={`w-32 cursor-default ${inputClass} text-white/60`}
        />
      </label>
      <label class="flex flex-col gap-1 text-xs text-white/60">
        Ruleset
        <select name="scoring_ruleset_id" required class={inputClass}>
          {rulesets.map((r) => (
            <option value={r.id} class="bg-brand-ink text-white" selected={r.id === newSeason.rulesetId}>
              {r.name}
            </option>
          ))}
        </select>
      </label>
      <label class="flex items-center gap-1.5 pb-1.5 text-xs text-white/60">
        <input type="checkbox" name="gamma_enabled" checked={newSeason.gamma} class="h-3.5 w-3.5 rounded border-white/20 bg-white/5 accent-brand-primary" />
        Gamma
      </label>
      <label class="flex items-center gap-1.5 pb-1.5 text-xs text-white/60">
        <input type="checkbox" name="delta_enabled" checked={newSeason.delta} class="h-3.5 w-3.5 rounded border-white/20 bg-white/5 accent-brand-primary" />
        Delta
      </label>
      <label class="flex items-center gap-1.5 pb-1.5 text-xs text-white/60">
        <input type="checkbox" name="delta_team_enabled" checked={newSeason.deltaTeam} class="h-3.5 w-3.5 rounded border-white/20 bg-white/5 accent-brand-primary" />
        Delta Team
      </label>
    </div>
    <div class="flex justify-end">
      <button type="submit" class="btn btn-primary btn-sm">Save</button>
    </div>
  </form>

  <div class="reveal mt-8 flex flex-col gap-3" style="transition-delay: 60ms">
    {seasons.length === 0 && <p class="text-sm text-white/40">No results.</p>}
    {seasons.map((season) => (
      <>
      {/*
        One card per season (FR3). Its fields belong to the hidden Save form through the `form` attribute, so the
        logo removers, Set as Current and Recalculate can stay separate forms without nesting.
      */}
      <div class="flex flex-col gap-3 rounded-lg bg-brand-ink p-3 ring-1 ring-white/10" data-season-row>
        <div class="flex flex-wrap items-center gap-3">
          <div class="flex flex-none items-center gap-1.5">
            <div class="flex flex-col items-center gap-0.5">
              {season.logo_url ? (
                <button
                  type="submit"
                  form={`remove-dark-${season.id}`}
                  class="group relative h-10 w-10 flex-none rounded"
                  aria-label={`Remove dark logo for ${season.name}`}
                  title="Remove dark logo"
                  data-remove-logo="dark"
                >
                  <img src={season.logo_url} alt="" class="h-10 w-10 rounded bg-brand-ink object-contain transition group-hover:opacity-40 group-focus-visible:opacity-40 [@media(hover:none)]:opacity-40" />
                  <span aria-hidden="true" class="pointer-events-none absolute inset-0 flex items-center justify-center text-2xl leading-none text-white/70 opacity-0 transition group-hover:opacity-100 group-focus-visible:opacity-100 [@media(hover:none)]:opacity-100">×</span>
                </button>
              ) : (
                <div class="h-10 w-10 flex-none rounded bg-white/10"></div>
              )}
              <span class="text-[9px] font-semibold uppercase tracking-wide text-white/30">Dark</span>
            </div>
            <div class="flex flex-col items-center gap-0.5">
              {season.logo_url_light ? (
                <button
                  type="submit"
                  form={`remove-light-${season.id}`}
                  class="group relative h-10 w-10 flex-none rounded"
                  aria-label={`Remove light logo for ${season.name}`}
                  title="Remove light logo"
                  data-remove-logo="light"
                >
                  <img src={season.logo_url_light} alt="" class="h-10 w-10 rounded bg-white object-contain transition group-hover:opacity-40 group-focus-visible:opacity-40 [@media(hover:none)]:opacity-40" />
                  <span aria-hidden="true" class="pointer-events-none absolute inset-0 flex items-center justify-center text-2xl leading-none text-white/70 opacity-0 transition group-hover:opacity-100 group-focus-visible:opacity-100 [@media(hover:none)]:opacity-100">×</span>
                </button>
              ) : (
                <div class="h-10 w-10 flex-none rounded bg-white/10"></div>
              )}
              <span class="text-[9px] font-semibold uppercase tracking-wide text-white/30">Light</span>
            </div>
          </div>
          <span class="min-w-[10rem] font-semibold">
            {season.name}
            {season.is_current && <span class="ml-2 text-xs font-normal text-brand-primary">Current</span>}
          </span>
          {!season.is_current && (
            <form method="POST" data-astro-reload>
              <input type="hidden" name="intent" value="set-current" />
              <input type="hidden" name="season_id" value={season.id} />
              <button type="submit" class="btn btn-neutral btn-sm">Set as Current</button>
            </form>
          )}
        </div>

        <div class="flex flex-wrap items-center gap-3">
          <div class="flex flex-wrap items-center gap-1.5">
            <span class="text-[10px] font-semibold uppercase tracking-wide text-white/40">Dark</span>
            <input
              type="text"
              name="logo_url"
              form={`save-${season.id}`}
              placeholder="Logo URL (optional if uploading a file)"
              class="w-48 rounded-md border border-white/15 bg-white/5 px-2 py-1.5 text-xs text-white outline-none focus:border-brand-primary"
            />
            <input
              type="file"
              name="logo"
              form={`save-${season.id}`}
              accept="image/png,image/jpeg,image/webp,image/svg+xml"
              class="w-48 text-xs text-white/60 file:mr-2 file:rounded-lg file:border-0 file:bg-white/10 file:px-3 file:py-1.5 file:text-xs file:text-white"
            />
          </div>
          <div class="flex flex-wrap items-center gap-1.5">
            <span class="text-[10px] font-semibold uppercase tracking-wide text-white/40">Light</span>
            <input
              type="text"
              name="logo_url_light"
              form={`save-${season.id}`}
              placeholder="Logo URL (optional if uploading a file)"
              class="w-48 rounded-md border border-white/15 bg-white/5 px-2 py-1.5 text-xs text-white outline-none focus:border-brand-primary"
            />
            <input
              type="file"
              name="logo_light"
              form={`save-${season.id}`}
              accept="image/png,image/jpeg,image/webp,image/svg+xml"
              class="w-48 text-xs text-white/60 file:mr-2 file:rounded-lg file:border-0 file:bg-white/10 file:px-3 file:py-1.5 file:text-xs file:text-white"
            />
          </div>
          <label class="flex items-center gap-1.5 text-xs text-white/60">
            Ruleset
            <select
              name="scoring_ruleset_id"
              form={`save-${season.id}`}
              class="rounded-md border border-white/15 bg-white/5 px-2 py-1.5 text-xs text-white outline-none focus:border-brand-primary"
            >
              <option value="" class="bg-brand-ink text-white" selected={!season.scoring_ruleset_id}>
                {defaultRuleset ? `(use default — ${defaultRuleset.name})` : '(use default — none set)'}
              </option>
              {rulesets.map((r) => (
                <option value={r.id} class="bg-brand-ink text-white" selected={r.id === season.scoring_ruleset_id}>
                  {r.name}
                </option>
              ))}
            </select>
          </label>
          {!resolveSeasonRuleset(season, rulesets) && (
            <span class="text-xs font-semibold text-brand-pink">No ruleset resolved — scoring will fail until one is assigned or a default is set</span>
          )}
          <label class="flex items-center gap-1.5 text-xs text-white/60">
            <input
              type="checkbox"
              name="gamma_enabled"
              value="1"
              form={`save-${season.id}`}
              checked={season.gamma_enabled}
              class="h-3.5 w-3.5 rounded border-white/20 bg-white/5 accent-brand-primary"
            />
            Gamma
          </label>
          <label class="flex items-center gap-1.5 text-xs text-white/60">
            <input
              type="checkbox"
              name="delta_enabled"
              value="1"
              form={`save-${season.id}`}
              checked={season.delta_enabled}
              class="h-3.5 w-3.5 rounded border-white/20 bg-white/5 accent-brand-primary"
            />
            Delta
          </label>
          <label class="flex items-center gap-1.5 text-xs text-white/60" title="The separate Delta TEAM championship — distinct from the Delta class above. Didn't exist until ATC10.">
            <input
              type="checkbox"
              name="delta_team_enabled"
              value="1"
              form={`save-${season.id}`}
              checked={season.delta_team_enabled}
              class="h-3.5 w-3.5 rounded border-white/20 bg-white/5 accent-brand-primary"
            />
            Delta Team
          </label>
        </div>

        {/* Bottom right (FR3.1): Recalculate, then Save. */}
        <div class="flex justify-end gap-2" data-season-actions>
          <button type="submit" form={`recalc-${season.id}`} class="btn btn-neutral btn-sm">Recalculate</button>
          <button type="submit" form={`save-${season.id}`} class="btn btn-primary btn-sm">Save</button>
        </div>

        <form id={`save-${season.id}`} method="POST" data-astro-reload enctype="multipart/form-data" class="hidden">
          <input type="hidden" name="intent" value="save" />
          <input type="hidden" name="season_id" value={season.id} />
        </form>
        <form
          id={`recalc-${season.id}`}
          method="POST"
          data-astro-reload
          class="hidden"
          data-confirm={`Recalculate every round in ${season.name}? This rescoring uses whatever ruleset is currently assigned and overwrites that season's stored race results and points.`}
        >
          <input type="hidden" name="intent" value="recalculate" />
          <input type="hidden" name="season_id" value={season.id} />
        </form>
        {season.logo_url && (
          <form id={`remove-dark-${season.id}`} method="POST" data-astro-reload class="hidden">
            <input type="hidden" name="intent" value="remove" />
            <input type="hidden" name="season_id" value={season.id} />
          </form>
        )}
        {season.logo_url_light && (
          <form id={`remove-light-${season.id}`} method="POST" data-astro-reload class="hidden">
            <input type="hidden" name="intent" value="remove-light" />
            <input type="hidden" name="season_id" value={season.id} />
          </form>
        )}
      </div>

      {recalcResult && recalcResult.seasonId === season.id && (() => {
        const failures = recalcResult.results.filter((r) => r.error_message !== null);
        const successes = recalcResult.results.filter((r) => r.error_message === null);
        return (
          <div class="ml-1 flex flex-col gap-1.5 rounded-lg border border-white/10 bg-brand-ink p-3 text-xs">
            <p class={failures.length === 0 ? 'font-semibold text-brand-primary' : 'font-semibold text-brand-gold'}>
              Recalculated {recalcResult.results.length} round{recalcResult.results.length === 1 ? '' : 's'} —{' '}
              {successes.length} succeeded{failures.length > 0 && `, ${failures.length} failed`}.
            </p>
            {failures.length > 0 && (
              <ul class="flex flex-col gap-1 text-white/60">
                {failures.map((f) => (
                  <li>
                    <span class="font-mono text-white/80">{f.subsession_id}</span>: {f.error_message}
                  </li>
                ))}
              </ul>
            )}
          </div>
        );
      })()}
      </>
    ))}
  </div>
</AdminLayout>

<script>
  import '../../../scripts/seasonNameSync';
</script>
