---
export const prerender = false;

import AdminLayout from '../../../layouts/AdminLayout.astro';
import {
  resolveSupabaseEnv,
  getScoringRulesets,
  createScoringRuleset,
  updateScoringRuleset,
  deleteScoringRuleset,
  setDefaultScoringRuleset,
  type ScoringRuleset,
} from '../../../lib/supabase';

const supabaseEnv = resolveSupabaseEnv(Astro.locals);
const accessToken = Astro.locals.session!.accessToken;

let error: string | null = null;

/**
 * Pretty-prints a ruleset's `rules` for the edit textarea. This is a parsed
 * JSON value (an object) straight from Supabase, not a string — jsonb
 * columns always come back as native JSON on read (see ScoringRuleset.rules'
 * own doc comment for why). Running that object through JSON.parse (the old
 * bug here) throws, since JSON.parse needs a string; the catch block then
 * returned the object itself, and the textarea rendered its default
 * `[object Object]` stringification instead of the JSON.
 *
 * Still handles a value that genuinely arrives as a string (e.g. a row
 * poked in by hand outside this UI) by parsing-then-re-stringifying it for
 * consistent indentation, falling back to the raw string if that fails.
 */
function prettyJson(value: unknown): string {
  if (typeof value === 'string') {
    try {
      return JSON.stringify(JSON.parse(value), null, 2);
    } catch {
      return value;
    }
  }
  return JSON.stringify(value, null, 2);
}

/**
 * Every field a `rules` value can carry, for Admin > Rulesets' "copy as a
 * starting point" block. Built from what's actually live in the 5 real
 * rulesets on file as of 2026-08 (ATC12/13/15/16, "ATC 18.3") — drops,
 * teams, probation, pp_penalties, classification, incident_limits, and
 * season_pp_limit are IDENTICAL, verbatim, across every one of them, so
 * this template uses those real values rather than placeholders. Only
 * base_points/class_podium/classified_minimum/race_overrides actually vary
 * per season and are LEFT AS PLACEHOLDER SHAPES (descending N..1 arrays)
 * for whoever's building a new ruleset to overwrite with real numbers.
 *
 * Split into two groups so the shape itself documents which half
 * `recalculate_race_scores()` (see supabase/migrations/0046 and 0048)
 * actually reads:
 *
 * READ BY THE SCORING ENGINE: base_points (+ sprint_race2), race_overrides
 * (0048_race_number_points_overrides.sql — base_points/classified_minimum
 * only; race_overrides.qualifying_points is RESERVED, not read by
 * anything yet — see that migration's own header comment for why),
 * class_podium, classified_minimum, bonuses.sublime_finesse/class_pole/
 * naked_aggression's sprint/endurance/max_incidents values.
 *
 * REFERENCE ONLY, transcribed from the rulebook for admins/stewards but
 * NOT read by any code: drops (except .base, which only an unused legacy
 * DB view reads — see 0033_naked_aggression_bonus.sql), teams, probation,
 * pp_penalties, incident_limits, season_pp_limit, and — easy to miss —
 * classification.min_distance_pct: the actual 50%-of-leader's-laps
 * classification rule is HARDCODED in recalculate_race_scores() (§2.25),
 * not read from here. Editing this field does nothing.
 */
const descendingPlaceholder = (length: number) => Array.from({ length }, (_, i) => length - i);
const rulesTemplate = {
  drops: { base: 2, locked_by: ['points_deduction', 'dsq'], applies_to_teams: false, steward_max_extra: 1, absence_is_droppable: true },
  teams: {
    max_roster: 3,
    championships: {
      Alpha: { classes: ['Alpha', 'Gamma'], counting_drivers: 2, class_bonus_counts: false },
      Delta: { classes: ['Delta'], counting_drivers: 2, class_bonus_counts: true },
    },
    eligible_from_round: 2,
    negative_points_count: false,
  },
  bonuses: {
    sublime_finesse: { per: 'race', sprint: 2, endurance: 4, max_incidents: 3, requires_classified: true },
    class_pole: { per: 'round', source: 'qualifying', sprint: 4, endurance: 4 },
    naked_aggression: { per: 'race', sprint: 2, endurance: 4 },
  },
  probation: { days: 45, rounds: 4, doubling: 'manual' },
  base_points: {
    sprint: descendingPlaceholder(40),
    endurance: descendingPlaceholder(40),
    sprint_race2: descendingPlaceholder(40),
  },
  // See 0048_race_number_points_overrides.sql — only takes effect for a
  // round whose subsession_id is listed in subsession_ids; leave that
  // array empty (as here) to keep this whole block inert.
  race_overrides: {
    subsession_ids: [],
    base_points: { '1': descendingPlaceholder(30), '2': descendingPlaceholder(30), '3': descendingPlaceholder(30) },
    classified_minimum: { '1': 0, '2': 0, '3': 0 },
    // RESERVED — not read anywhere yet. See the migration's header comment.
    qualifying_points: { '1': descendingPlaceholder(30) },
  },
  class_podium: {
    per: 'race',
    applies_to: ['Gamma', 'Delta'],
    sprint: descendingPlaceholder(3),
    endurance: descendingPlaceholder(3),
    sprint_race2: descendingPlaceholder(3),
  },
  pp_penalties: {
    '1': { seconds: 5 },
    '2': { seconds: 10 },
    '3': { seconds: 20 },
    '4': { seconds: 40 },
    '5': { quali_ban: true },
    '6': { laps: 1, points: -10, pit_start: true },
    '7': { laps: 1, points: -50, pit_start: true },
    '8': { laps: 1, points: -100, race_ban: true },
  },
  classification: { min_distance_pct: 50 },
  incident_limits: { dsq: 30, warning: 15 },
  season_pp_limit: 11,
  classified_minimum: { sprint: 0, endurance: 0 },
};
const rulesTemplateJson = JSON.stringify(rulesTemplate, null, 2);

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const intent = String(form.get('intent') ?? 'save');
  const id = String(form.get('id') ?? '');

  if (intent === 'delete') {
    if (id) {
      try {
        await deleteScoringRuleset(supabaseEnv, accessToken, id);
      } catch (err) {
        console.error('Failed to delete scoring ruleset:', err);
        error = err instanceof Error ? err.message : 'Failed to remove that ruleset.';
      }
    }
    if (!error) return Astro.redirect('/admin/rulesets', 302);
  } else if (intent === 'set-default') {
    if (id) {
      try {
        await setDefaultScoringRuleset(supabaseEnv, accessToken, id);
      } catch (err) {
        console.error('Failed to set default scoring ruleset:', err);
        error = 'Failed to set that ruleset as the default.';
      }
    }
    if (!error) return Astro.redirect('/admin/rulesets', 302);
  } else {
    const name = String(form.get('name') ?? '').trim();
    const rulebook = String(form.get('rulebook') ?? '').trim() || null;
    const notes = String(form.get('notes') ?? '').trim() || null;
    const rulesRaw = String(form.get('rules') ?? '').trim();

    if (!name) {
      error = 'Name is required.';
    } else if (!rulesRaw) {
      error = 'Rules JSON is required.';
    } else {
      // Parse and keep the PARSED OBJECT — not a re-stringified JSON
      // string — to validate it's real JSON before it ever reaches the
      // database (recalculate_race_scores() reads this column directly, so
      // a typo here — a trailing comma, an unquoted key — should fail
      // loudly on THIS form, not silently break scoring the next time a
      // round gets recalculated) AND because sending the object itself,
      // not a string, is what makes PostgREST write it into the jsonb
      // column as an actual object. Sending a JSON string here (the
      // previous version of this code, via JSON.stringify) does NOT get
      // re-parsed on the way in — it silently corrupts the column into a
      // jsonb STRING SCALAR that only reads back valid on the surface;
      // every rules->'...' lookup in recalculate_race_scores() then
      // evaluates to NULL, which doesn't fail until the next recalculation
      // hits a NOT NULL constraint. See ScoringRuleset.rules' own doc
      // comment in src/lib/supabase.ts for the full story — this exact bug
      // corrupted the live "ATC 18.3" ruleset in production.
      let rules: unknown;
      try {
        rules = JSON.parse(rulesRaw);
      } catch (err) {
        error = `Rules must be valid JSON: ${err instanceof Error ? err.message : String(err)}`;
        rules = null;
      }
      if (!error) {
        try {
          if (id) {
            await updateScoringRuleset(supabaseEnv, accessToken, id, { name, rulebook, notes, rules });
          } else {
            await createScoringRuleset(supabaseEnv, accessToken, { name, rulebook, notes, rules });
          }
          return Astro.redirect('/admin/rulesets', 302);
        } catch (err) {
          console.error('Failed to save scoring ruleset:', err);
          error = err instanceof Error ? err.message : 'Failed to save this ruleset.';
        }
      }
    }
  }
}

let rulesets: ScoringRuleset[] = [];
try {
  rulesets = await getScoringRulesets(supabaseEnv);
} catch (err) {
  console.error('Failed to load scoring rulesets:', err);
}
---

<AdminLayout title="Rulesets">
  <h1 class="reveal font-display text-4xl">Scoring Rulesets</h1>
  <p class="reveal mt-2 max-w-2xl text-sm text-white/60" style="transition-delay: 40ms">
    Each season on <a href="/admin/seasons" class="underline decoration-white/30 hover:text-white">Admin &gt; Seasons</a>
    can be assigned one of these. A season left unassigned uses whichever ruleset is marked
    <span class="font-semibold text-brand-primary">Default</span> below. The <code>rules</code> JSON is what the
    scoring engine reads when (re)computing a round's points — base points per finish position, class-podium
    bonuses, Sublime Finesse, Class Pole, penalty-point deductions, and drop-week count. Editing it here only
    changes what a <em>future</em> recalculation produces; it doesn't retroactively touch points already scored.
  </p>

  {error && (
    <p class="reveal mt-6 rounded-lg border border-brand-pink/30 bg-brand-pink/10 p-4 text-sm text-white/80">{error}</p>
  )}

  <details class="reveal mt-6 rounded-lg border border-white/10 bg-white/[0.03] p-4" style="transition-delay: 50ms">
    <summary class="cursor-pointer list-none text-sm font-semibold text-white/80">
      Full <code>rules</code> template (every field) — copy as a starting point
    </summary>
    <div class="mt-3 flex flex-col gap-3 text-sm text-white/60">
      <p>
        Fields the scoring engine actually reads: <code>base_points</code> (and <code>sprint_race2</code>),{' '}
        <code>race_overrides</code>, <code>class_podium</code>, <code>classified_minimum</code>, and{' '}
        <code>bonuses.sublime_finesse</code>/<code>class_pole</code>/<code>naked_aggression</code>. Everything else
        (<code>drops</code>, <code>teams</code>, <code>probation</code>, <code>pp_penalties</code>,{' '}
        <code>classification</code>, <code>incident_limits</code>, <code>season_pp_limit</code>) is reference-only —
        transcribed from the rulebook for stewards to read here, not enforced by any code.{' '}
        <span class="text-white/80">Easy one to miss: <code>classification.min_distance_pct</code> does nothing —</span>{' '}
        the real 50%-of-leader's-laps rule is hardcoded in the scoring function, not read from this JSON.
      </p>
      <p>
        <code>race_overrides</code> lets one specific round score races 1/2/3 off entirely different points tables —
        built for a special event where, say, race 1 pays one table, race 2 another, race 3 a third. It only takes
        effect for a round whose <code>subsession_id</code> is listed in <code>race_overrides.subsession_ids</code> —
        leave that array empty (as in this template) and the whole block is inert, so it's safe to paste into a
        ruleset other seasons already share. Its <code>qualifying_points</code> field is reserved for a future
        qualifying-based bonus and isn't read by anything yet.
      </p>
      <p>
        Every array below is a placeholder shape (descending N..1) standing in for a real points table — replace with
        actual numbers before using this for real scoring.
      </p>
      <div class="relative">
        <button
          type="button"
          data-copy-template
          class="absolute right-2 top-2 rounded-md bg-white/10 px-2.5 py-1 text-xs font-semibold text-white/80 transition hover:bg-white/20"
        >
          Copy
        </button>
        <pre class="max-h-[32rem] overflow-auto rounded-md border border-white/10 bg-black/30 p-3 pr-16 font-mono text-xs text-white/80" set:text={rulesTemplateJson} />
      </div>
    </div>
  </details>

  <div class="reveal mt-8 flex flex-col gap-3" style="transition-delay: 60ms">
    {rulesets.length === 0 && <p class="text-sm text-white/40">No rulesets yet.</p>}
    {rulesets.map((r) => (
      <details class="rounded-lg bg-white/5 p-4 ring-1 ring-white/10">
        <summary class="flex cursor-pointer list-none flex-wrap items-center gap-3">
          <span class="font-semibold">{r.name}</span>
          {r.is_default && (
            <span class="rounded-lg bg-brand-primary/15 px-2 py-0.5 text-[10px] font-semibold uppercase tracking-wide text-brand-primary">
              Default
            </span>
          )}
          {r.rulebook && <span class="text-xs text-white/40">{r.rulebook}</span>}
        </summary>

        <form method="POST" data-astro-reload class="mt-4 flex flex-col gap-3">
          <input type="hidden" name="intent" value="save" />
          <input type="hidden" name="id" value={r.id} />
          <div class="grid gap-3 sm:grid-cols-2">
            <label class="flex flex-col gap-1.5 text-sm">
              <span class="text-white/60">Name</span>
              <input
                type="text"
                name="name"
                required
                value={r.name}
                class="rounded-md border border-white/15 bg-white/5 px-3 py-2 text-white outline-none focus:border-brand-primary"
              />
            </label>
            <label class="flex flex-col gap-1.5 text-sm">
              <span class="text-white/60">Rulebook reference (optional)</span>
              <input
                type="text"
                name="rulebook"
                value={r.rulebook ?? ''}
                placeholder="e.g. ATC Rulebook 18.3"
                class="rounded-md border border-white/15 bg-white/5 px-3 py-2 text-white outline-none focus:border-brand-primary"
              />
            </label>
          </div>
          <label class="flex flex-col gap-1.5 text-sm">
            <span class="text-white/60">Notes (optional)</span>
            <input
              type="text"
              name="notes"
              value={r.notes ?? ''}
              class="rounded-md border border-white/15 bg-white/5 px-3 py-2 text-white outline-none focus:border-brand-primary"
            />
          </label>
          <label class="flex flex-col gap-1.5 text-sm">
            <span class="text-white/60">Rules (JSON)</span>
            <textarea
              name="rules"
              required
              rows="16"
              class="w-full rounded-md border border-white/15 bg-white/5 px-3 py-2 font-mono text-xs text-white outline-none focus:border-brand-primary"
              set:text={prettyJson(r.rules)}
            />
          </label>
          <div class="flex flex-wrap gap-2">
            <button type="submit" class="rounded-lg bg-brand-primary px-4 py-2 text-sm font-semibold transition hover:brightness-110">
              Save
            </button>
          </div>
        </form>

        <div class="mt-3 flex flex-wrap gap-4 border-t border-white/10 pt-3">
          {!r.is_default && (
            <form method="POST" data-astro-reload>
              <input type="hidden" name="intent" value="set-default" />
              <input type="hidden" name="id" value={r.id} />
              <button type="submit" class="text-xs font-semibold text-white/50 transition hover:text-brand-primary">
                Set as default
              </button>
            </form>
          )}
          <form method="POST" data-astro-reload onsubmit="return confirm('Delete this ruleset? Any season assigned to it will fall back to the default.');">
            <input type="hidden" name="intent" value="delete" />
            <input type="hidden" name="id" value={r.id} />
            <button type="submit" class="text-xs font-semibold text-white/40 transition hover:text-brand-pink">Delete</button>
          </form>
        </div>
      </details>
    ))}
  </div>

  <details class="reveal relative mt-8" style="transition-delay: 80ms">
    <summary class="cursor-pointer list-none rounded-lg bg-white/5 px-4 py-2 text-sm font-semibold text-white/70 ring-1 ring-white/10 transition hover:bg-white/10">
      Add a ruleset
    </summary>
    <form method="POST" data-astro-reload class="mt-3 flex max-w-2xl flex-col gap-3 rounded-lg border border-white/10 bg-white/[0.03] p-4">
      <input type="hidden" name="intent" value="save" />
      <div class="grid gap-3 sm:grid-cols-2">
        <label class="flex flex-col gap-1.5 text-sm">
          <span class="text-white/60">Name</span>
          <input
            type="text"
            name="name"
            required
            class="rounded-md border border-white/15 bg-white/5 px-3 py-2 text-white outline-none focus:border-brand-primary"
          />
        </label>
        <label class="flex flex-col gap-1.5 text-sm">
          <span class="text-white/60">Rulebook reference (optional)</span>
          <input
            type="text"
            name="rulebook"
            placeholder="e.g. ATC Rulebook 18.3"
            class="rounded-md border border-white/15 bg-white/5 px-3 py-2 text-white outline-none focus:border-brand-primary"
          />
        </label>
      </div>
      <label class="flex flex-col gap-1.5 text-sm">
        <span class="text-white/60">Notes (optional)</span>
        <input
          type="text"
          name="notes"
          class="rounded-md border border-white/15 bg-white/5 px-3 py-2 text-white outline-none focus:border-brand-primary"
        />
      </label>
      <label class="flex flex-col gap-1.5 text-sm">
        <span class="text-white/60">Rules (JSON) — copy an existing ruleset above as a starting point</span>
        <textarea
          name="rules"
          required
          rows="10"
          placeholder={`{"base_points": {"sprint": [100, 95, ...]}, ...}`}
          class="w-full rounded-md border border-white/15 bg-white/5 px-3 py-2 font-mono text-xs text-white outline-none focus:border-brand-primary"
        ></textarea>
      </label>
      <button type="submit" class="mt-1 self-start rounded-lg bg-brand-primary px-5 py-2 text-sm font-semibold transition hover:brightness-110">
        Add Ruleset
      </button>
    </form>
  </details>
</AdminLayout>

<script>
  document.addEventListener('astro:page-load', () => {
    document.querySelectorAll<HTMLButtonElement>('[data-copy-template]').forEach((btn) => {
      const pre = btn.parentElement?.querySelector('pre');
      if (!pre) return;
      btn.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(pre.textContent ?? '');
          const original = btn.textContent;
          btn.textContent = 'Copied!';
          setTimeout(() => {
            btn.textContent = original;
          }, 1500);
        } catch (err) {
          console.error('Failed to copy rules template:', err);
        }
      });
    });
  });
</script>
