</section>

<section class="mt-12">
  <h2 class="font-display text-2xl uppercase tracking-widest text-white/50">Site Analytics</h2>

  {pageViewStats ? (
    <div class="mt-4 space-y-6">
      <div class="rounded-xl border border-white/10 bg-white/[0.03] p-5">
        <dl class="grid grid-cols-1 gap-x-4 gap-y-5 sm:grid-cols-3">
          <StatBlock
            label="Visitors Today"
            value={pageViewStats.visitorsToday}
            sub={`${pageViewStats.viewsToday} page view${pageViewStats.viewsToday === 1 ? '' : 's'}`}
          />
          <StatBlock
            label="Visitors (7 days)"
            value={pageViewStats.visitors7d}
            sub={`${pageViewStats.views7d} page views`}
          />
          <StatBlock
            label="Visitors (30 days)"
            value={pageViewStats.visitors30d}
            sub={`${pageViewStats.views30d} page views`}
          />
        </dl>
      </div>

      <div class="grid gap-4 lg:grid-cols-2">
        <div class="rounded-xl border border-white/10 bg-white/[0.03] p-5">
          <h3 class="text-xs uppercase tracking-wide text-white/40">Top Regions (30 days)</h3>
          {topCountries.length > 0 ? (
            <ul class="mt-3 space-y-2.5">
              {topCountries.map((c) => (
                <li>
                  <div class="flex items-center justify-between text-sm">
                    <span class="text-white/80">{countryName(c.country)}</span>
                    <span class="text-white/50">{c.visitors}</span>
                  </div>
                  <div class="mt-1 h-1.5 rounded-full bg-white/5">
                    <div
                      class="h-1.5 rounded-full bg-brand-primary"
                      style={`width: ${Math.max(4, Math.round((c.visitors / maxCountryVisitors) * 100))}%`}
                    />
                  </div>
                </li>
              ))}
            </ul>
          ) : (
            <p class="mt-3 text-sm text-white/40">No visits recorded yet.</p>
          )}
        </div>

        <div class="rounded-xl border border-white/10 bg-white/[0.03] p-5">
          {/* Today's hourly shape stacked directly above the 30-day
              rollup, in one card — get_page_view_stats()' hourlyToday key
              (0083_page_views_hourly_today.sql), same bar shape as the
              30-day chart below it, just scoped to today (America/
              New_York) so a real-time-ish traffic shape isn't smoothed
              away by 30 days of averaging. */}
          <h3 class="text-xs uppercase tracking-wide text-white/40">Traffic by Hour (Today, ET)</h3>
          <div class="mt-4 flex h-24 items-stretch gap-1">
            {hourlyToday.map((h) => (
              <div class="relative h-full flex-1 rounded-t bg-white/5">
                <div
                  class="absolute bottom-0 w-full rounded-t bg-brand-primary/70 transition hover:bg-brand-primary"
                  style={`height: ${Math.round((h.views / maxHourlyTodayViews) * 100)}%`}
                  title={`${formatHour(h.hour)} ET — ${h.views} view${h.views === 1 ? '' : 's'}`}
                />
              </div>
            ))}
          </div>
          <div class="mt-1 flex justify-between text-[10px] text-white/30">
            <span>12am</span>
            <span>6am</span>
            <span>12pm</span>
            <span>6pm</span>
            <span>12am</span>
          </div>

          <h3 class="mt-5 border-t border-white/10 pt-4 text-xs uppercase tracking-wide text-white/40">Traffic by Hour (30 days, ET)</h3>
          <div class="mt-4 flex h-24 items-stretch gap-1">
            {hourly.map((h) => (
              <div class="relative h-full flex-1 rounded-t bg-white/5">
                <div
                  class="absolute bottom-0 w-full rounded-t bg-brand-primary/70 transition hover:bg-brand-primary"
                  style={`height: ${Math.round((h.views / maxHourlyViews) * 100)}%`}
                  title={`${formatHour(h.hour)} ET — ${h.views} view${h.views === 1 ? '' : 's'}`}
                />
              </div>
            ))}
          </div>
          <div class="mt-1 flex justify-between text-[10px] text-white/30">
            <span>12am</span>
            <span>6am</span>
            <span>12pm</span>
            <span>6pm</span>
            <span>12am</span>
          </div>
        </div>
      </div>

      <div class="grid gap-4 lg:grid-cols-2">
        <div class="rounded-xl border border-white/10 bg-white/[0.03] p-5">
          <h3 class="text-xs uppercase tracking-wide text-white/40">Most Popular Pages by Views (30 days)</h3>
          {topPages.length > 0 ? (
            <ul class="mt-3 space-y-2.5">
              {topPages.map((p) => (
                <li>
                  <div class="flex items-center justify-between gap-3 text-sm">
                    <span class="truncate text-white/80" title={p.path}>{p.path}</span>
                    <span class="shrink-0 text-white/50">{p.views}</span>
                  </div>
                  <div class="mt-1 h-1.5 rounded-full bg-white/5">
                    <div
                      class="h-1.5 rounded-full bg-brand-primary"
                      style={`width: ${Math.max(4, Math.round((p.views / maxPageViews) * 100))}%`}
                    />
                  </div>
                </li>
              ))}
            </ul>
          ) : (
            <p class="mt-3 text-sm text-white/40">No page views recorded yet.</p>
          )}
        </div>

        <div class="rounded-xl border border-white/10 bg-white/[0.03] p-5">
          <h3 class="text-xs uppercase tracking-wide text-white/40">Most Common Errors (30 days)</h3>
          {topErrors.length > 0 ? (
            <ul class="mt-3 space-y-2.5">
              {topErrors.map((e) => (
                <li>
                  <div class="flex items-center justify-between gap-3 text-sm">
                    <span class="truncate text-white/80" title={e.path}>
                      <span class="mr-1.5 rounded bg-red-500/20 px-1.5 py-0.5 text-xs font-semibold text-red-300">{e.status}</span>
                      {e.path}
                    </span>
                    <span class="shrink-0 text-white/50">{e.occurrences}</span>
                  </div>
                  <div class="mt-1 h-1.5 rounded-full bg-white/5">
                    <div
                      class="h-1.5 rounded-full bg-red-400/70"
                      style={`width: ${Math.max(4, Math.round((e.occurrences / maxErrorOccurrences) * 100))}%`}
                    />
                  </div>
                </li>
              ))}
            </ul>
          ) : (
            <p class="mt-3 text-sm text-white/40">No errors recorded in the last 30 days.</p>
          )}
        </div>
      </div>
    </div>
  ) : (
    <p class="mt-4 text-sm text-white/50">Analytics aren't available right now.</p>
  )}
</section>

<section class="mt-12">
  <h2 class="font-display text-2xl uppercase tracking-widest text-white/50">Utilities</h2>

  <div class="mt-4 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
    {utilities.map((card) => (
      <a
        href={card.href}
        class="group rounded-xl border border-white/10 bg-white/[0.03] p-6 transition hover:border-white/20 hover:bg-white/[0.06]"
      >
        <h3 class="flex items-center gap-3 font-display text-2xl">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="h-6 w-6 flex-none text-brand-primary" aria-hidden="true">
            {(ICONS[card.label] ?? []).map((d) => <path d={d} />)}
          </svg>
          {card.label}
        </h3>
        <p class="mt-1 text-sm text-white/60">{card.detail}</p>
      </a>
    ))}
  </div>
</section>
