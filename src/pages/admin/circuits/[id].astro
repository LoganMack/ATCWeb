---
export const prerender = false;

import AdminLayout from '../../../layouts/AdminLayout.astro';
import {
  resolveSupabaseEnv,
  getCircuitById,
  createCircuit,
  updateCircuit,
  deleteCircuit,
  uploadToStorage,
  getCircuitLayouts,
  createCircuitLayout,
  updateCircuitLayout,
  deleteCircuitLayout,
  getTrackGuidesForLayout,
  createTrackGuide,
  deleteTrackGuide,
  formatLapTime,
  formatDate,
  displayLayoutName,
  type Circuit,
  type CircuitLayout,
  type TrackGuide,
} from '../../../lib/supabase';
import { logActivity, actorNameFor } from '../../../lib/activityLog';

const supabaseEnv = resolveSupabaseEnv(Astro.locals);
const accessToken = Astro.locals.session!.accessToken;
const actor = { id: Astro.locals.session!.user.id, name: actorNameFor(Astro.locals.session!) };
const { id } = Astro.params;
const isNew = id === 'new';

let error: string | null = null;
let layoutError: string | null = null;

function extFromFile(file: File): string {
  const fromName = file.name.split('.').pop();
  if (fromName && fromName.length <= 5) return fromName.toLowerCase();
  const map: Record<string, string> = {
    'image/png': 'png',
    'image/jpeg': 'jpg',
    'image/webp': 'webp',
    'image/svg+xml': 'svg',
  };
  return map[file.type] ?? 'png';
}

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const intent = String(form.get('intent') ?? 'save');
  // circuit (below) isn't loaded yet at this point in the script — this
  // POST-handling block runs before that section — so fetch a fresh copy
  // here for any branch below that needs the circuit's current name for its
  // activity_log entry.
  const circuitForLog = !isNew && id ? await getCircuitById(supabaseEnv, id) : null;

  if (intent === 'add-layout' || intent === 'update-layout') {
    if (!isNew && id) {
      const layoutName = String(form.get('layout_name') ?? '').trim();
      const lengthKmRaw = String(form.get('length_km') ?? '').trim();
      const cornersRaw = String(form.get('corners') ?? '').trim();
      const lapRecordSecondsRaw = String(form.get('lap_record_seconds') ?? '').trim();
      const lapRecordHolder = String(form.get('lap_record_holder') ?? '').trim();
      const lapRecordDate = String(form.get('lap_record_date') ?? '').trim();
      const layoutId = String(form.get('layout_id') ?? '');
      const layoutImageFile = form.get('layout_image');

      if (!layoutName) {
        layoutError = 'Layout name is required.';
      } else {
        const data: Partial<CircuitLayout> = {
          name: layoutName,
          length_km: lengthKmRaw ? Number(lengthKmRaw) : null,
          corners: cornersRaw ? Number(cornersRaw) : null,
          lap_record_seconds: lapRecordSecondsRaw ? Number(lapRecordSecondsRaw) : null,
          lap_record_holder: lapRecordHolder || null,
          lap_record_date: lapRecordDate || null,
        };
        try {
          let savedLayoutId: string | null = null;
          if (intent === 'add-layout') {
            const created = await createCircuitLayout(supabaseEnv, accessToken, { ...data, circuit_id: id });
            savedLayoutId = created.id;
          } else if (layoutId) {
            await updateCircuitLayout(supabaseEnv, accessToken, layoutId, data);
            savedLayoutId = layoutId;
          }

          if (savedLayoutId && layoutImageFile instanceof File && layoutImageFile.size > 0) {
            const path = `circuit-layout-${savedLayoutId}-${Date.now()}.${extFromFile(layoutImageFile)}`;
            const image_url = await uploadToStorage(supabaseEnv, accessToken, 'logos', path, layoutImageFile);
            await updateCircuitLayout(supabaseEnv, accessToken, savedLayoutId, { image_url });
          }

          await logActivity(supabaseEnv, accessToken, actor, {
            action: intent === 'add-layout' ? 'add' : 'edit',
            entity_type: 'circuit',
            entity_label: `${circuitForLog?.name ?? 'Circuit'} — ${layoutName} (layout)`,
            entity_id: savedLayoutId,
          });

          return Astro.redirect(`/admin/circuits/${id}`, 302);
        } catch (err) {
          console.error('Failed to save circuit layout:', err);
          layoutError = err instanceof Error ? err.message : 'Failed to save this layout.';
        }
      }
    }
  } else if (intent === 'delete-layout' && !isNew && id) {
    const layoutId = String(form.get('layout_id') ?? '');
    if (layoutId) {
      try {
        await deleteCircuitLayout(supabaseEnv, accessToken, layoutId);
        await logActivity(supabaseEnv, accessToken, actor, {
          action: 'delete',
          entity_type: 'circuit',
          entity_label: `${circuitForLog?.name ?? 'Circuit'} — layout`,
          entity_id: layoutId,
        });
      } catch (err) {
        console.error('Failed to delete circuit layout:', err);
        layoutError = 'Failed to delete this layout.';
      }
    }
    return Astro.redirect(`/admin/circuits/${id}`, 302);
  } else if (intent === 'add-track-guide' && !isNew && id) {
    const layoutId = String(form.get('layout_id') ?? '');
    const guideUrl = String(form.get('url') ?? '').trim();
    const guideTitle = String(form.get('title') ?? '').trim();
    if (!layoutId || !guideUrl) {
      layoutError = 'A layout and a URL are required to add a track guide.';
    } else {
      try {
        await createTrackGuide(supabaseEnv, accessToken, { layout_id: layoutId, url: guideUrl, title: guideTitle || null });
        await logActivity(supabaseEnv, accessToken, actor, {
          action: 'add',
          entity_type: 'circuit',
          entity_label: `${circuitForLog?.name ?? 'Circuit'} — track guide`,
          entity_id: layoutId,
        });
      } catch (err) {
        console.error('Failed to add track guide:', err);
        layoutError = err instanceof Error ? err.message : 'Failed to add this track guide.';
      }
    }
    return Astro.redirect(`/admin/circuits/${id}`, 302);
  } else if (intent === 'delete-track-guide' && !isNew && id) {
    const trackGuideId = String(form.get('track_guide_id') ?? '');
    if (trackGuideId) {
      try {
        await deleteTrackGuide(supabaseEnv, accessToken, trackGuideId);
        await logActivity(supabaseEnv, accessToken, actor, {
          action: 'delete',
          entity_type: 'circuit',
          entity_label: `${circuitForLog?.name ?? 'Circuit'} — track guide`,
        });
      } catch (err) {
        console.error('Failed to delete track guide:', err);
        layoutError = 'Failed to delete this track guide.';
      }
    }
    return Astro.redirect(`/admin/circuits/${id}`, 302);
  } else if (intent === 'delete' && !isNew && id) {
    try {
      await deleteCircuit(supabaseEnv, accessToken, id);
      await logActivity(supabaseEnv, accessToken, actor, {
        action: 'delete',
        entity_type: 'circuit',
        entity_label: circuitForLog?.name,
        entity_id: id,
      });
      return Astro.redirect('/admin/circuits', 302);
    } catch (err) {
      console.error('Failed to delete circuit:', err);
      error = 'Failed to delete this circuit. Events still referencing it may need reassigning first.';
    }
  } else {
    const name = String(form.get('name') ?? '').trim();
    const location = String(form.get('location') ?? '').trim() || null;
    const logoFile = form.get('logo');

    if (!name) {
      error = 'Circuit name is required.';
    } else {
      try {
        let circuitId = isNew ? null : id!;
        if (isNew) {
          const created = await createCircuit(supabaseEnv, accessToken, { name, location });
          circuitId = created.id;
        } else {
          await updateCircuit(supabaseEnv, accessToken, circuitId!, { name, location });
        }

        if (logoFile instanceof File && logoFile.size > 0) {
          const path = `circuit-${circuitId}-${Date.now()}.${extFromFile(logoFile)}`;
          const logo_url = await uploadToStorage(supabaseEnv, accessToken, 'logos', path, logoFile);
          await updateCircuit(supabaseEnv, accessToken, circuitId!, { logo_url });
        }

        await logActivity(supabaseEnv, accessToken, actor, {
          action: isNew ? 'add' : 'edit',
          entity_type: 'circuit',
          entity_label: name,
          entity_id: circuitId,
        });

        return Astro.redirect(`/admin/circuits/${circuitId}`, 302);
      } catch (err) {
        console.error('Failed to save circuit:', err);
        error = err instanceof Error ? err.message : 'Failed to save changes.';
      }
    }
  }
}

let circuit: Circuit | null = null;
if (!isNew && id) {
  circuit = await getCircuitById(supabaseEnv, id);
  if (!circuit) return Astro.redirect('/admin/circuits', 302);
}

const c: Partial<Circuit> = circuit ?? { name: '', logo_url: null, location: null };

let layouts: CircuitLayout[] = [];
let trackGuidesByLayoutId = new Map<string, TrackGuide[]>();
if (!isNew && id) {
  try {
    layouts = await getCircuitLayouts(supabaseEnv, id);
    const guideLists = await Promise.all(layouts.map((l) => getTrackGuidesForLayout(supabaseEnv, l.id)));
    layouts.forEach((l, i) => trackGuidesByLayoutId.set(l.id, guideLists[i]));
  } catch (err) {
    console.error('Failed to load circuit layouts:', err);
  }
}
---

<AdminLayout title={isNew ? 'New Circuit' : c.name || 'Edit Circuit'}>
  <h1 class="reveal font-display text-4xl">{isNew ? 'New Circuit' : c.name}</h1>

  {error && (
    <p class="reveal mt-6 rounded-lg border border-brand-pink/30 bg-brand-pink/10 p-4 text-sm text-white/80">{error}</p>
  )}

  <form method="POST" data-astro-reload enctype="multipart/form-data" class="reveal mt-8 flex max-w-xl flex-col gap-4" style="transition-delay: 80ms">
    <label class="flex flex-col gap-1.5 text-sm">
      <span class="text-white/70">Circuit name</span>
      <input
        type="text"
        name="name"
        required
        value={c.name}
        class="rounded-md border border-white/15 bg-white/5 px-3 py-2 text-white outline-none focus:border-brand-primary"
      />
    </label>

    <label class="flex flex-col gap-1.5 text-sm">
      <span class="text-white/70">Location</span>
      <input
        type="text"
        name="location"
        placeholder="Le Mans, France"
        value={c.location ?? ''}
        class="rounded-md border border-white/15 bg-white/5 px-3 py-2 text-white outline-none focus:border-brand-primary"
      />
    </label>

    <div class="flex flex-col gap-1.5 text-sm">
      <span class="text-white/70">Logo</span>
      {c.logo_url && (
        <img src={c.logo_url} alt="" class="mb-2 h-16 w-16 rounded object-contain ring-1 ring-white/10" />
      )}
      <input
        type="file"
        name="logo"
        accept="image/png,image/jpeg,image/webp,image/svg+xml"
        class="rounded-md border border-white/15 bg-white/5 px-3 py-2 text-white outline-none file:mr-3 file:rounded-lg file:border-0 file:bg-white/10 file:px-3 file:py-1.5 file:text-white"
      />
      <span class="text-xs text-white/40">PNG, JPG, WebP, or SVG. Uploading a new file replaces the current logo.</span>
    </div>

    <div class="mt-2 flex gap-3">
      <button
        type="submit"
        name="intent"
        value="save"
        class="rounded-lg bg-brand-primary px-6 py-3 font-semibold transition hover:brightness-110"
      >
        {isNew ? 'Create Circuit' : 'Save Changes'}
      </button>
      <a href="/admin/circuits" class="rounded-lg bg-white/5 px-6 py-3 font-semibold ring-1 ring-white/10 transition hover:bg-white/10">
        Cancel
      </a>
    </div>
  </form>

  {!isNew && (
    <div class="reveal mt-10 max-w-xl border-t border-white/10 pt-6" style="transition-delay: 90ms">
      <h2 class="text-lg font-semibold">Layouts</h2>
      <p class="mt-1 text-sm text-white/50">
        A circuit can be run in more than one configuration — each layout keeps its own lap record.
      </p>

      {layoutError && (
        <p class="mt-4 rounded-lg border border-brand-pink/30 bg-brand-pink/10 p-3 text-sm text-white/80">{layoutError}</p>
      )}

      <ul class="mt-4 flex flex-col gap-3">
        {layouts.length === 0 && <li class="text-sm text-white/40">No results.</li>}
        {layouts.map((layout) => (
          <li class="rounded-lg bg-white/5 p-3 text-sm ring-1 ring-white/10">
            <div class="flex flex-wrap items-center justify-between gap-3">
              <div class="flex items-center gap-3">
                {layout.image_url ? (
                  <img src={layout.image_url} alt="" class="h-10 w-10 flex-none rounded object-cover ring-1 ring-white/10" />
                ) : (
                  <div class="h-10 w-10 flex-none rounded bg-white/10"></div>
                )}
                <div>
                  <p class="font-semibold">{displayLayoutName(layout.name)}</p>
                  <p class="mt-0.5 text-xs text-white/50">
                    {layout.length_km !== null ? `${layout.length_km} km` : 'Length not set'}
                    {layout.corners !== null && ` · ${layout.corners} corners`}
                    {layout.lap_record_seconds !== null && ` · Record ${formatLapTime(layout.lap_record_seconds)}`}
                    {layout.lap_record_holder && ` — ${layout.lap_record_holder}`}
                    {layout.lap_record_date && ` (${formatDate(layout.lap_record_date)})`}
                    {(trackGuidesByLayoutId.get(layout.id)?.length ?? 0) > 0 &&
                      ` · ${trackGuidesByLayoutId.get(layout.id)!.length} track guide${trackGuidesByLayoutId.get(layout.id)!.length === 1 ? '' : 's'}`}
                  </p>
                </div>
              </div>
              <div class="flex items-center gap-2">
                <details class="relative">
                  <summary class="cursor-pointer list-none rounded-lg bg-white/5 px-3 py-1 text-xs font-semibold text-white/60 ring-1 ring-white/10 transition hover:bg-white/10">
                    Edit
                  </summary>
                  <form
                    method="POST"
                    data-astro-reload
                    enctype="multipart/form-data"
                    class="absolute right-0 z-10 mt-2 flex w-72 flex-col gap-2 rounded-lg border border-white/10 bg-brand-ink p-4 shadow-xl"
                  >
                    <input type="hidden" name="intent" value="update-layout" />
                    <input type="hidden" name="layout_id" value={layout.id} />
                    <label class="flex flex-col gap-1 text-[11px] text-white/50">
                      Layout name
                      <input
                        type="text"
                        name="layout_name"
                        required
                        value={layout.name}
                        class="rounded-md border border-white/15 bg-white/5 px-2 py-1.5 text-xs text-white outline-none focus:border-brand-primary"
                      />
                    </label>
                    <label class="flex flex-col gap-1 text-[11px] text-white/50">
                      Length (km)
                      <input
                        type="number"
                        step="0.001"
                        name="length_km"
                        value={layout.length_km ?? ''}
                        class="rounded-md border border-white/15 bg-white/5 px-2 py-1.5 text-xs text-white outline-none focus:border-brand-primary"
                      />
                    </label>
                    <label class="flex flex-col gap-1 text-[11px] text-white/50">
                      Corners
                      <input
                        type="number"
                        step="1"
                        min="0"
                        name="corners"
                        value={layout.corners ?? ''}
                        class="rounded-md border border-white/15 bg-white/5 px-2 py-1.5 text-xs text-white outline-none focus:border-brand-primary"
                      />
                    </label>
                    <label class="flex flex-col gap-1 text-[11px] text-white/50">
                      Lap record (seconds)
                      <input
                        type="number"
                        step="0.001"
                        name="lap_record_seconds"
                        placeholder="102.512"
                        value={layout.lap_record_seconds ?? ''}
                        class="rounded-md border border-white/15 bg-white/5 px-2 py-1.5 text-xs text-white outline-none focus:border-brand-primary"
                      />
                      {layout.lap_record_seconds !== null && (
                        <span class="text-white/40">= {formatLapTime(layout.lap_record_seconds)}</span>
                      )}
                    </label>
                    <label class="flex flex-col gap-1 text-[11px] text-white/50">
                      Record holder
                      <input
                        type="text"
                        name="lap_record_holder"
                        value={layout.lap_record_holder ?? ''}
                        class="rounded-md border border-white/15 bg-white/5 px-2 py-1.5 text-xs text-white outline-none focus:border-brand-primary"
                      />
                    </label>
                    <label class="flex flex-col gap-1 text-[11px] text-white/50">
                      Record date
                      <input
                        type="date"
                        name="lap_record_date"
                        value={layout.lap_record_date ?? ''}
                        class="rounded-md border border-white/15 bg-white/5 px-2 py-1.5 text-xs text-white outline-none focus:border-brand-primary"
                      />
                    </label>
                    <label class="flex flex-col gap-1 text-[11px] text-white/50">
                      Layout image
                      <input
                        type="file"
                        name="layout_image"
                        accept="image/png,image/jpeg,image/webp,image/svg+xml"
                        class="rounded-md border border-white/15 bg-white/5 px-2 py-1.5 text-xs text-white outline-none file:mr-2 file:rounded-md file:border-0 file:bg-white/10 file:px-2 file:py-1 file:text-white"
                      />
                      <span class="text-white/40">Uploading a new file replaces this layout's current image. Falls back to the circuit logo if unset.</span>
                    </label>
                    <button
                      type="submit"
                      class="mt-1 rounded-lg bg-brand-primary px-3 py-1.5 text-xs font-semibold transition hover:brightness-110"
                    >
                      Save
                    </button>
                  </form>
                </details>
                <form method="POST" data-astro-reload>
                  <input type="hidden" name="intent" value="delete-layout" />
                  <input type="hidden" name="layout_id" value={layout.id} />
                  <button type="submit" class="text-xs font-semibold text-white/40 transition hover:text-brand-pink">Remove</button>
                </form>
              </div>
            </div>

            <div class="mt-3 border-t border-white/10 pt-3">
              <p class="text-xs font-semibold text-white/50">Track Guides</p>
              {(trackGuidesByLayoutId.get(layout.id)?.length ?? 0) === 0 && (
                <p class="mt-1 text-xs text-white/30">None on file.</p>
              )}
              {(trackGuidesByLayoutId.get(layout.id)?.length ?? 0) > 0 && (
                <ul class="mt-1.5 flex flex-col gap-1">
                  {trackGuidesByLayoutId.get(layout.id)!.map((guide) => (
                    <li class="flex flex-wrap items-center justify-between gap-2 rounded-md bg-white/5 px-2.5 py-1.5 text-xs">
                      <a href={guide.url} target="_blank" rel="noopener noreferrer" class="text-brand-primary hover:underline">
                        {guide.title || guide.url}
                      </a>
                      <form method="POST" data-astro-reload>
                        <input type="hidden" name="intent" value="delete-track-guide" />
                        <input type="hidden" name="track_guide_id" value={guide.id} />
                        <button type="submit" class="font-semibold text-white/40 transition hover:text-brand-pink">Remove</button>
                      </form>
                    </li>
                  ))}
                </ul>
              )}
              <details class="relative mt-2">
                <summary class="cursor-pointer list-none text-xs font-semibold text-white/50 transition hover:text-white/80">
                  + Add a track guide
                </summary>
                <form method="POST" data-astro-reload class="mt-2 flex flex-col gap-2 rounded-lg border border-white/10 bg-white/[0.03] p-3">
                  <input type="hidden" name="intent" value="add-track-guide" />
                  <input type="hidden" name="layout_id" value={layout.id} />
                  <label class="flex flex-col gap-1 text-[11px] text-white/50">
                    Title (optional)
                    <input
                      type="text"
                      name="title"
                      placeholder="e.g. Full Course Guide"
                      class="rounded-md border border-white/15 bg-white/5 px-2 py-1.5 text-xs text-white outline-none focus:border-brand-primary"
                    />
                  </label>
                  <label class="flex flex-col gap-1 text-[11px] text-white/50">
                    YouTube URL
                    <input
                      type="url"
                      name="url"
                      required
                      placeholder="https://youtube.com/watch?v=…"
                      class="rounded-md border border-white/15 bg-white/5 px-2 py-1.5 text-xs text-white outline-none focus:border-brand-primary"
                    />
                  </label>
                  <button
                    type="submit"
                    class="self-start rounded-lg bg-brand-primary px-3 py-1.5 text-xs font-semibold transition hover:brightness-110"
                  >
                    Add
                  </button>
                </form>
              </details>
            </div>
          </li>
        ))}
      </ul>

      <details class="relative mt-4">
        <summary class="cursor-pointer list-none rounded-lg bg-white/5 px-4 py-2 text-sm font-semibold text-white/70 ring-1 ring-white/10 transition hover:bg-white/10">
          Add a layout
        </summary>
        <form method="POST" data-astro-reload enctype="multipart/form-data" class="mt-3 flex flex-col gap-2 rounded-lg border border-white/10 bg-white/[0.03] p-4">
          <input type="hidden" name="intent" value="add-layout" />
          <label class="flex flex-col gap-1.5 text-sm">
            <span class="text-white/60">Layout name</span>
            <input
              type="text"
              name="layout_name"
              required
              placeholder="Full Course"
              class="rounded-md border border-white/15 bg-white/5 px-3 py-2 text-white outline-none focus:border-brand-primary"
            />
          </label>
          <label class="flex flex-col gap-1.5 text-sm">
            <span class="text-white/60">Length (km)</span>
            <input
              type="number"
              step="0.001"
              name="length_km"
              class="rounded-md border border-white/15 bg-white/5 px-3 py-2 text-white outline-none focus:border-brand-primary"
            />
          </label>
          <label class="flex flex-col gap-1.5 text-sm">
            <span class="text-white/60">Corners</span>
            <input
              type="number"
              step="1"
              min="0"
              name="corners"
              class="rounded-md border border-white/15 bg-white/5 px-3 py-2 text-white outline-none focus:border-brand-primary"
            />
          </label>
          <label class="flex flex-col gap-1.5 text-sm">
            <span class="text-white/60">Lap record (seconds)</span>
            <input
              type="number"
              step="0.001"
              name="lap_record_seconds"
              placeholder="102.512"
              class="rounded-md border border-white/15 bg-white/5 px-3 py-2 text-white outline-none focus:border-brand-primary"
            />
          </label>
          <label class="flex flex-col gap-1.5 text-sm">
            <span class="text-white/60">Record holder</span>
            <input
              type="text"
              name="lap_record_holder"
              class="rounded-md border border-white/15 bg-white/5 px-3 py-2 text-white outline-none focus:border-brand-primary"
            />
          </label>
          <label class="flex flex-col gap-1.5 text-sm">
            <span class="text-white/60">Record date</span>
            <input
              type="date"
              name="lap_record_date"
              class="rounded-md border border-white/15 bg-white/5 px-3 py-2 text-white outline-none focus:border-brand-primary"
            />
          </label>
          <label class="flex flex-col gap-1.5 text-sm">
            <span class="text-white/60">Layout image</span>
            <input
              type="file"
              name="layout_image"
              accept="image/png,image/jpeg,image/webp,image/svg+xml"
              class="rounded-md border border-white/15 bg-white/5 px-3 py-2 text-white outline-none file:mr-3 file:rounded-lg file:border-0 file:bg-white/10 file:px-3 file:py-1.5 file:text-white"
            />
            <span class="text-xs text-white/40">Optional — falls back to the circuit logo if left unset.</span>
          </label>
          <button
            type="submit"
            class="mt-1 self-start rounded-lg bg-brand-primary px-5 py-2 text-sm font-semibold transition hover:brightness-110"
          >
            Add Layout
          </button>
        </form>
      </details>
    </div>
  )}

  {!isNew && (
    <form method="POST" data-astro-reload class="reveal mt-10 max-w-xl border-t border-white/10 pt-6" style="transition-delay: 100ms">
      <input type="hidden" name="intent" value="delete" />
      <button
        type="submit"
        data-confirm="Delete this circuit? Events still referencing it, and its layouts, may need reassigning first."
        class="rounded-lg bg-brand-pink/10 px-5 py-2.5 text-sm font-semibold text-brand-pink ring-1 ring-brand-pink/30 transition hover:bg-brand-pink/20"
      >
        Delete Circuit
      </button>
    </form>
  )}
</AdminLayout>

<script>
  document.addEventListener('astro:page-load', () => {
    document.querySelectorAll<HTMLButtonElement>('[data-confirm]').forEach((btn) => {
      btn.addEventListener('click', (e) => {
        if (!confirm(btn.dataset.confirm || 'Are you sure?')) e.preventDefault();
      });
    });
  });
</script>
