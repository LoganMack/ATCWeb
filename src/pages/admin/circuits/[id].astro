---
export const prerender = false;

import AdminLayout from '../../../layouts/AdminLayout.astro';
import CircuitLayoutDialog from '../../../components/CircuitLayoutDialog.astro';
import {
  getCircuitLogoBackgrounds,
  logoBgAttrs,
  type LogoBackground,
  getCircuitById,
  getCircuitCoordinates,
  createCircuit,
  updateCircuit,
  deleteCircuit,
  getCircuitLayouts,
  createCircuitLayout,
  updateCircuitLayout,
  deleteCircuitLayout,
  getTrackGuidesForLayout,
  createTrackGuide,
  deleteTrackGuide,
  displayLayoutName,
  type Circuit,
  type CircuitLayout,
  type TrackGuide,
} from '../../../lib/db/circuits';
import {
  parseCircuitForm,
  parseLayoutForm,
  layoutSaveOutcome,
  layoutFormStateFor,
  emptyLayoutFormState,
  CIRCUIT_EDITOR_MESSAGES,
  type CircuitFormState,
  type LayoutFormState,
  type LogoBackgroundMode,
} from '../../../lib/circuitEditorForm';
import {
  LAYOUT_CATEGORY_LABELS,
  formatLayoutSubtitle,
  isLayoutCategory,
  isStoredLogoColour,
  normaliseLogoColour,
} from '../../../lib/circuitCategory';
import { resolveSupabaseEnv } from '../../../lib/db/client';
import { uploadToStorage } from '../../../lib/db/assets';
import { logActivity, actorNameFor } from '../../../lib/activityLog';
import { requireFullAdmin } from '../../../lib/auth';

// A restricted area (BR2.7): full Admin only.
const admin = requireFullAdmin(Astro);
if (admin instanceof Response) return admin;

const supabaseEnv = resolveSupabaseEnv(Astro.locals);
const accessToken = admin.accessToken;
const actor = { id: admin.user.id, name: actorNameFor(admin) };
const { id } = Astro.params;
const isNew = id === 'new';

let error: string | null = null;
let layoutError: string | null = null;
/** The typed circuit form after a refusal, so it re-renders as typed (circuit-editor BR1.7). */
let circuitFormState: CircuitFormState | null = null;
/** The refused layout dialog's typed values and message; its dialogKey picks the dialog to reopen (BR1.19). */
let layoutFormError: LayoutFormState | null = null;

function extFromFile(file: File): string {
  const fromName = file.name.split('.').pop();
  if (fromName && fromName.length <= 5) return fromName.toLowerCase();
  const map: Record<string, string> = {
    'image/png': 'png',
    'image/jpeg': 'jpg',
    'image/webp': 'webp',
    'image/svg+xml': 'svg',
  };
  return map[file.type] ?? 'png';
}

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const intent = String(form.get('intent') ?? 'save');
  // The circuit isn't loaded yet when the POST runs, so fetch it for the activity log name.
  const circuitForLog = !isNew && id ? await getCircuitById(supabaseEnv, id) : null;

  if (intent === 'add-layout' || intent === 'update-layout') {
    if (!isNew && id) {
      // Every rule runs before any write; a refusal reopens the same dialog with what was typed.
      const { state, write } = parseLayoutForm(form);
      const layoutId = String(form.get('layout_id') ?? '');
      const layoutImageFile = form.get('layout_image');

      if (!write) {
        layoutFormError = state;
      } else {
        try {
          let savedLayoutId: string | null = null;
          if (intent === 'add-layout') {
            const created = await createCircuitLayout(supabaseEnv, accessToken, { ...write, circuit_id: id });
            savedLayoutId = created.id;
          } else {
            // A PATCH on a layout deleted in another tab matches no row and resolves to undefined.
            const saved = layoutId ? await updateCircuitLayout(supabaseEnv, accessToken, layoutId, write) : undefined;
            const outcome = layoutSaveOutcome(saved);
            if (outcome.ok) savedLayoutId = layoutId;
            else layoutFormError = { ...state, error: { field: null, message: outcome.error } };
          }

          if (savedLayoutId) {
            if (layoutImageFile instanceof File && layoutImageFile.size > 0) {
              const path = `circuit-layout-${savedLayoutId}-${Date.now()}.${extFromFile(layoutImageFile)}`;
              const image_url = await uploadToStorage(supabaseEnv, accessToken, 'logos', path, layoutImageFile);
              await updateCircuitLayout(supabaseEnv, accessToken, savedLayoutId, { image_url });
            }

            await logActivity(supabaseEnv, accessToken, actor, {
              action: intent === 'add-layout' ? 'add' : 'edit',
              entity_type: 'circuit',
              entity_label: `${circuitForLog?.name ?? 'Circuit'} — ${write.name} (layout)`,
              entity_id: savedLayoutId,
            });

            return Astro.redirect(`/admin/circuits/${id}`, 302);
          }
        } catch (err) {
          console.error('Failed to save circuit layout:', err);
          const message = err instanceof Error ? err.message : 'Failed to save this layout.';
          layoutFormError = { ...state, error: { field: null, message } };
        }
      }
    }
  } else if (intent === 'delete-layout' && !isNew && id) {
    const layoutId = String(form.get('layout_id') ?? '');
    if (layoutId) {
      try {
        await deleteCircuitLayout(supabaseEnv, accessToken, layoutId);
        await logActivity(supabaseEnv, accessToken, actor, {
          action: 'delete',
          entity_type: 'circuit',
          entity_label: `${circuitForLog?.name ?? 'Circuit'} — layout`,
          entity_id: layoutId,
        });
      } catch (err) {
        console.error('Failed to delete circuit layout:', err);
        layoutError = 'Failed to delete this layout.';
      }
    }
    return Astro.redirect(`/admin/circuits/${id}`, 302);
  } else if (intent === 'add-track-guide' && !isNew && id) {
    const layoutId = String(form.get('layout_id') ?? '');
    const guideUrl = String(form.get('url') ?? '').trim();
    const guideTitle = String(form.get('title') ?? '').trim();
    if (!layoutId || !guideUrl) {
      layoutError = 'A layout and a URL are required to add a track guide.';
    } else {
      try {
        await createTrackGuide(supabaseEnv, accessToken, { layout_id: layoutId, url: guideUrl, title: guideTitle || null });
        await logActivity(supabaseEnv, accessToken, actor, {
          action: 'add',
          entity_type: 'circuit',
          entity_label: `${circuitForLog?.name ?? 'Circuit'} — track guide`,
          entity_id: layoutId,
        });
      } catch (err) {
        console.error('Failed to add track guide:', err);
        layoutError = err instanceof Error ? err.message : 'Failed to add this track guide.';
      }
    }
    return Astro.redirect(`/admin/circuits/${id}`, 302);
  } else if (intent === 'delete-track-guide' && !isNew && id) {
    const trackGuideId = String(form.get('track_guide_id') ?? '');
    if (trackGuideId) {
      try {
        await deleteTrackGuide(supabaseEnv, accessToken, trackGuideId);
        await logActivity(supabaseEnv, accessToken, actor, {
          action: 'delete',
          entity_type: 'circuit',
          entity_label: `${circuitForLog?.name ?? 'Circuit'} — track guide`,
        });
      } catch (err) {
        console.error('Failed to delete track guide:', err);
        layoutError = 'Failed to delete this track guide.';
      }
    }
    return Astro.redirect(`/admin/circuits/${id}`, 302);
  } else if (intent === 'delete' && !isNew && id) {
    try {
      await deleteCircuit(supabaseEnv, accessToken, id);
      await logActivity(supabaseEnv, accessToken, actor, {
        action: 'delete',
        entity_type: 'circuit',
        entity_label: circuitForLog?.name,
        entity_id: id,
      });
      return Astro.redirect('/admin/circuits', 302);
    } catch (err) {
      console.error('Failed to delete circuit:', err);
      error = 'Failed to delete this circuit. Events still referencing it may need reassigning first.';
    }
  } else {
    // Name, then coordinates, then logo background: nothing is written unless all three pass (BR1.7).
    const parsed = parseCircuitForm(form);
    const logoFile = form.get('logo');
    if (!parsed.write) {
      error = parsed.error;
      circuitFormState = parsed.state;
    } else {
      const { write } = parsed;
      // One request; coordinates and the plate are only sent when set or changed (BR1.8).
      const data = {
        name: write.name,
        location: write.location,
        ...(write.coords ?? {}),
        ...(write.logoBackground !== undefined ? { logo_background: write.logoBackground } : {}),
      };
      try {
        let circuitId = isNew ? null : id!;
        if (isNew) {
          const created = await createCircuit(supabaseEnv, accessToken, data);
          circuitId = created.id;
        } else {
          await updateCircuit(supabaseEnv, accessToken, circuitId!, data);
        }

        if (logoFile instanceof File && logoFile.size > 0) {
          const path = `circuit-${circuitId}-${Date.now()}.${extFromFile(logoFile)}`;
          const logo_url = await uploadToStorage(supabaseEnv, accessToken, 'logos', path, logoFile);
          await updateCircuit(supabaseEnv, accessToken, circuitId!, { logo_url });
        }

        await logActivity(supabaseEnv, accessToken, actor, {
          action: isNew ? 'add' : 'edit',
          entity_type: 'circuit',
          entity_label: write.name,
          entity_id: circuitId,
        });

        return Astro.redirect(`/admin/circuits/${circuitId}`, 302);
      } catch (err) {
        console.error('Failed to save circuit:', err);
        error = err instanceof Error ? err.message : 'Failed to save changes.';
        circuitFormState = parsed.state;
      }
    }
  }
}

let circuit: Circuit | null = null;
if (!isNew && id) {
  circuit = await getCircuitById(supabaseEnv, id);
  if (!circuit) return Astro.redirect('/admin/circuits', 302);
}

const c: Partial<Circuit> = circuit ?? { name: '', logo_url: null, location: null };
let currentLogoBg: LogoBackground | '' = '';
if (!isNew && id) {
  currentLogoBg = (await getCircuitLogoBackgrounds(supabaseEnv))[id] ?? '';
}
let coordsRow: { latitude: number | null; longitude: number | null } | null = null;
if (!isNew && id) {
  coordsRow = (await getCircuitCoordinates(supabaseEnv)).find((r) => r.id === id) ?? null;
}

let layouts: CircuitLayout[] = [];
let trackGuidesByLayoutId = new Map<string, TrackGuide[]>();
if (!isNew && id) {
  try {
    layouts = await getCircuitLayouts(supabaseEnv, id);
    const guideLists = await Promise.all(layouts.map((l) => getTrackGuidesForLayout(supabaseEnv, l.id)));
    layouts.forEach((l, i) => trackGuidesByLayoutId.set(l.id, guideLists[i]));
  } catch (err) {
    console.error('Failed to load circuit layouts:', err);
  }
}

const storedMode: LogoBackgroundMode =
  currentLogoBg === 'light' || currentLogoBg === 'dark'
    ? currentLogoBg
    : isStoredLogoColour(currentLogoBg)
      ? 'custom'
      : 'none';
const formState: CircuitFormState = circuitFormState ?? {
  name: c.name ?? '',
  location: c.location ?? '',
  latitude: coordsRow?.latitude != null ? String(coordsRow.latitude) : '',
  longitude: coordsRow?.longitude != null ? String(coordsRow.longitude) : '',
  logoBackgroundMode: storedMode,
  logoBackgroundText: storedMode === 'custom' ? currentLogoBg : '',
};
const logoBgError = error === CIRCUIT_EDITOR_MESSAGES.logoBackground;
// The picker needs a valid #rrggbb; brand blue is only its starting position until a colour is typed.
const DEFAULT_PICKER_COLOUR = '#4369f5';
const pickerColour = normaliseLogoColour(formState.logoBackgroundText) ?? DEFAULT_PICKER_COLOUR;
const customText =
  formState.logoBackgroundMode === 'custom' ? formState.logoBackgroundText : formState.logoBackgroundText || pickerColour;
const logoBgOptions: { value: string; mode: LogoBackgroundMode; label: string }[] = [
  { value: '', mode: 'none', label: 'None' },
  { value: 'light', mode: 'light', label: 'Light' },
  { value: 'dark', mode: 'dark', label: 'Dark' },
  { value: 'custom', mode: 'custom', label: 'Custom' },
];
const fieldClass =
  'rounded-md border border-white/15 bg-white/5 px-3 py-2 text-white outline-none focus:border-brand-primary';

// A refused layout save reopens its dialog; when that layout is gone (deleted elsewhere), the banner says so.
const refusedDialogShown =
  layoutFormError !== null &&
  (layoutFormError.dialogKey === 'new' || layouts.some((l) => l.id === layoutFormError!.dialogKey));
const layoutBanner =
  layoutError ?? (layoutFormError && !refusedDialogShown ? (layoutFormError.error?.message ?? null) : null);
const dialogStateFor = (key: string, fallback: () => LayoutFormState) =>
  layoutFormError?.dialogKey === key ? layoutFormError : fallback();
---

<AdminLayout title={isNew ? 'New Circuit' : c.name || 'Edit Circuit'} heading={isNew ? 'New Circuit' : c.name || 'Edit Circuit'}>
  {error && (
    <p class="reveal mt-6 rounded-lg border border-brand-pink/30 bg-brand-pink/10 p-4 text-sm text-white/80">{error}</p>
  )}

  <form method="POST" data-astro-reload data-circuit-form enctype="multipart/form-data" class="reveal mt-8 flex max-w-xl flex-col gap-4" style="transition-delay: 80ms">
    <label class="flex flex-col gap-1.5 text-sm">
      <span class="text-white/70">Circuit Name</span>
      <input type="text" name="name" required value={formState.name} class={fieldClass} />
    </label>

    <label class="flex flex-col gap-1.5 text-sm">
      <span class="text-white/70">Location</span>
      <input type="text" name="location" placeholder="Le Mans, France" value={formState.location} class={fieldClass} />
    </label>

    <div class="flex flex-col gap-1.5 text-sm">
      <span class="text-white/70">Map Position</span>
      <div class="flex gap-3">
        <input
          type="text"
          inputmode="decimal"
          name="latitude"
          placeholder="Latitude, e.g. 50.4372"
          aria-label="Latitude"
          value={formState.latitude}
          class={`w-full ${fieldClass}`}
        />
        <input
          type="text"
          inputmode="decimal"
          name="longitude"
          placeholder="Longitude, e.g. 5.9714"
          aria-label="Longitude"
          value={formState.longitude}
          class={`w-full ${fieldClass}`}
        />
      </div>
      <input type="hidden" name="had_coords" value={coordsRow?.latitude != null ? '1' : '0'} />
    </div>

    <div class="flex flex-col gap-1.5 text-sm">
      <span class="text-white/70">Logo</span>
      {c.logo_url && (
        <img src={c.logo_url} alt="" data-logo-preview {...logoBgAttrs(currentLogoBg || null)} class="mb-2 h-16 w-16 rounded object-contain ring-1 ring-white/10" />
      )}
      <input
        type="file"
        name="logo"
        accept="image/png,image/jpeg,image/webp,image/svg+xml"
        class="rounded-md border border-white/15 bg-white/5 px-3 py-2 text-white outline-none file:mr-3 file:rounded-lg file:border-0 file:bg-white/10 file:px-3 file:py-1.5 file:text-white"
      />
    </div>

    <fieldset
      class="flex flex-col gap-1.5 text-sm"
      data-logo-bg-fieldset
      {...(logoBgError ? { 'aria-describedby': 'logo-bg-error' } : {})}
    >
      <legend class="mb-1.5 text-white/70">Logo Background</legend>
      <div class="flex flex-wrap gap-4">
        {logoBgOptions.map((option) => (
          <label class="flex items-center gap-2 text-white/80">
            <input
              type="radio"
              name="logo_background"
              value={option.value}
              checked={formState.logoBackgroundMode === option.mode}
              {...(option.mode === 'custom' ? { 'data-logo-bg-custom-radio': '' } : {})}
            />
            {option.label}
          </label>
        ))}
      </div>
      <div
        data-logo-bg-custom-row
        class="flex items-center gap-2"
        {...(formState.logoBackgroundMode === 'custom' ? {} : { hidden: true })}
      >
        <input
          type="color"
          aria-label="Pick custom colour"
          value={pickerColour}
          class="h-9 w-12 rounded-md border border-white/15 bg-white/5"
        />
        <label class="flex flex-col gap-1">
          <span class="sr-only">Custom colour</span>
          <input
            type="text"
            name="logo_background_hex"
            value={customText}
            placeholder="#4369f5"
            spellcheck="false"
            autocomplete="off"
            {...(logoBgError ? { 'aria-describedby': 'logo-bg-error', 'aria-invalid': 'true' } : {})}
            class={fieldClass}
          />
        </label>
      </div>
      {logoBgError && (
        <p id="logo-bg-error" class="text-xs text-brand-pink">{CIRCUIT_EDITOR_MESSAGES.logoBackground}</p>
      )}
      <input type="hidden" name="had_logo_background" value={currentLogoBg} />
    </fieldset>

    <div class="mt-2 flex gap-3">
      <button
        type="submit"
        name="intent"
        value="save"
        class="btn btn-primary btn-lg"
      >
        {isNew ? 'Create Circuit' : 'Save Changes'}
      </button>
      <a href="/admin/circuits" class="btn btn-neutral btn-lg">
        Cancel
      </a>
    </div>
  </form>

  {!isNew && id && (
    <div class="reveal mt-10 max-w-xl border-t border-white/10 pt-6" style="transition-delay: 90ms">
      <div class="flex items-center justify-between gap-3">
        <h2 class="text-lg font-semibold">Layouts</h2>
        <button
          type="button"
          aria-label="Add Layout"
          title="Add Layout"
          data-open-dialog="layout-dialog-new"
          class="btn btn-sm btn-neutral relative !px-2 after:absolute after:-inset-1.5 after:content-['']"
        >
          <svg aria-hidden="true" viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 5v14M5 12h14" /></svg>
        </button>
      </div>

      {layoutBanner && (
        <p class="mt-4 rounded-lg border border-brand-pink/30 bg-brand-pink/10 p-3 text-sm text-white/80">{layoutBanner}</p>
      )}

      <ul class="mt-4 flex flex-col gap-3">
        {layouts.length === 0 && <li class="text-sm text-white/40">No results.</li>}
        {layouts.map((layout) => {
          const guides = trackGuidesByLayoutId.get(layout.id) ?? [];
          const subtitle = formatLayoutSubtitle(layout.length_km, layout.corners);
          return (
            <li class="rounded-lg bg-brand-ink p-3 text-sm ring-1 ring-white/10">
              <div class="flex flex-wrap items-center justify-between gap-3">
                <div class="flex items-center gap-3">
                  {layout.image_url ? (
                    <img src={layout.image_url} alt="" class="h-10 w-10 flex-none rounded object-cover ring-1 ring-white/10" />
                  ) : (
                    <div class="h-10 w-10 flex-none rounded bg-white/10"></div>
                  )}
                  <div>
                    <p class="flex flex-wrap items-center gap-2 font-semibold">
                      {displayLayoutName(layout.name)}
                      {isLayoutCategory(layout.category) && (
                        <span class="rounded-md border border-white/15 px-1.5 text-xs font-normal text-white/70">
                          {LAYOUT_CATEGORY_LABELS[layout.category]}
                        </span>
                      )}
                    </p>
                    {subtitle && <p class="mt-0.5 text-xs text-white/50">{subtitle}</p>}
                  </div>
                </div>
                <div class="flex items-center gap-2">
                  <a href={`/admin/circuits/${id}/map/${layout.id}`} class="btn btn-neutral btn-sm">Map &amp; Pins</a>
                  <button type="button" class="btn btn-neutral btn-sm" data-open-dialog={`layout-dialog-${layout.id}`}>
                    Edit
                  </button>
                  <form method="POST" data-astro-reload>
                    <input type="hidden" name="intent" value="delete-layout" />
                    <input type="hidden" name="layout_id" value={layout.id} />
                    <button type="submit" class="text-xs font-semibold text-white/40 transition hover:text-brand-pink">Remove</button>
                  </form>
                </div>
              </div>

              <div class="mt-3 border-t border-white/10 pt-3">
                <div class="flex items-center justify-between gap-3">
                  <p class="text-xs font-semibold text-white/50">Track Guides</p>
                  <button
                    type="button"
                    aria-label="Add Track Guide"
                    title="Add Track Guide"
                    data-open-dialog="track-guide-dialog"
                    data-layout-id={layout.id}
                    class="btn btn-sm btn-neutral relative !px-2 after:absolute after:-inset-1.5 after:content-['']"
                  >
                    <svg aria-hidden="true" viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 5v14M5 12h14" /></svg>
                  </button>
                </div>
                {guides.length === 0 && <p class="mt-1 text-xs text-white/50">No track guides.</p>}
                {guides.length > 0 && (
                  <ul class="mt-1.5 flex flex-col gap-1">
                    {guides.map((guide) => (
                      <li class="flex flex-wrap items-center justify-between gap-2 rounded-md bg-white/5 px-2.5 py-1.5 text-xs">
                        <a href={guide.url} target="_blank" rel="noopener noreferrer" class="text-brand-primary hover:underline">
                          {guide.title || guide.url}
                        </a>
                        <form method="POST" data-astro-reload>
                          <input type="hidden" name="intent" value="delete-track-guide" />
                          <input type="hidden" name="track_guide_id" value={guide.id} />
                          <button type="submit" class="font-semibold text-white/40 transition hover:text-brand-pink">Remove</button>
                        </form>
                      </li>
                    ))}
                  </ul>
                )}
              </div>
            </li>
          );
        })}
      </ul>

      <CircuitLayoutDialog
        state={dialogStateFor('new', emptyLayoutFormState)}
        circuitId={id}
        openOnLoad={layoutFormError?.dialogKey === 'new'}
      />
      {layouts.map((layout) => (
        <CircuitLayoutDialog
          state={dialogStateFor(layout.id, () => layoutFormStateFor(layout))}
          circuitId={id}
          openOnLoad={layoutFormError?.dialogKey === layout.id}
        />
      ))}

      <dialog
        id="track-guide-dialog"
        aria-labelledby="track-guide-dialog-title"
        class="w-full max-w-md rounded-xl border border-white/10 bg-brand-ink p-0 text-white backdrop:bg-black/60"
      >
        <form method="POST" data-astro-reload class="flex flex-col gap-3 p-5">
          <input type="hidden" name="intent" value="add-track-guide" />
          <input type="hidden" name="layout_id" value="" />
          <div class="flex items-center justify-between">
            <h2 id="track-guide-dialog-title" class="font-display text-xl">Add track guide</h2>
            <button type="button" data-close-dialog aria-label="Close" class="text-white/40 hover:text-white">✕</button>
          </div>
          <label class="flex flex-col gap-1 text-[11px] text-white/50">
            Title (optional)
            <input
              type="text"
              name="title"
              placeholder="e.g. Full Course Guide"
              data-first-field
              class="rounded-md border border-white/15 bg-white/5 px-2 py-1.5 text-sm text-white outline-none focus:border-brand-primary"
            />
          </label>
          <label class="flex flex-col gap-1 text-[11px] text-white/50">
            YouTube URL
            <input
              type="url"
              name="url"
              required
              placeholder="https://youtube.com/watch?v=…"
              class="rounded-md border border-white/15 bg-white/5 px-2 py-1.5 text-sm text-white outline-none focus:border-brand-primary"
            />
          </label>
          <div class="mt-1 flex justify-end gap-2">
            <button type="button" data-close-dialog class="btn btn-neutral">Cancel</button>
            <button type="submit" class="btn btn-primary">Add</button>
          </div>
        </form>
      </dialog>
    </div>
  )}

  {!isNew && (
    <form method="POST" data-astro-reload class="reveal mt-10 max-w-xl border-t border-white/10 pt-6" style="transition-delay: 100ms">
      <input type="hidden" name="intent" value="delete" />
      <button
        type="submit"
        data-confirm="Delete this circuit? Events still referencing it, and its layouts, may need reassigning first."
        class="btn btn-danger"
      >
        Delete Circuit
      </button>
    </form>
  )}
</AdminLayout>

<script>
  import '../../../scripts/circuitEditor';
</script>
