---
export const prerender = false;

// Best Racecraft and Most Improved — the two Awards-page entries that are
// steward judgment calls rather than something computed from race_scores
// (see computeSeasonAwardsHistory in src/lib/results.ts for the other ten,
// and src/pages/awards/fragment.astro's own two new sections for how these
// two get merged in alongside those). This page is the only place either
// one is ever set — there's no "recalculate" for a manual pick.
import AdminLayout from '../../../layouts/AdminLayout.astro';
import {
  resolveSupabaseEnv,
  getSeasons,
  getDriversBasic,
  getManualAwardsForSeason,
  addManualAward,
  removeManualAward,
  type Season,
  type DriverOption,
  type ManualAward,
  type ManualAwardKey,
} from '../../../lib/supabase';
import { logActivity, actorNameFor } from '../../../lib/activityLog';

const supabaseEnv = resolveSupabaseEnv(Astro.locals);
const accessToken = Astro.locals.session!.accessToken;
const actor = { id: Astro.locals.session!.user.id, name: actorNameFor(Astro.locals.session!) };

const AWARD_DEFS: { key: ManualAwardKey; label: string; description: string }[] = [
  { key: 'best_racecraft', label: 'Best Racecraft', description: 'Cleanest, most respectful wheel-to-wheel racing this season.' },
  { key: 'most_improved', label: 'Most Improved', description: "Biggest step forward from last season." },
];

let error: string | null = null;
let formSeasonId: string | null = null;

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const intent = String(form.get('intent') ?? '');

  if (intent === 'add-winner') {
    const seasonId = String(form.get('season_id') ?? '');
    const awardKey = String(form.get('award_key') ?? '');
    const driverId = String(form.get('driver_id') ?? '');
    formSeasonId = seasonId || null;
    const isValidKey = awardKey === 'best_racecraft' || awardKey === 'most_improved';
    if (!seasonId || !isValidKey || !driverId) {
      error = 'Pick a season, award, and driver.';
    } else {
      try {
        await addManualAward(supabaseEnv, accessToken, { season_id: seasonId, award_key: awardKey as ManualAwardKey, driver_id: driverId });
        const [seasons, drivers] = await Promise.all([getSeasons(supabaseEnv), getDriversBasic(supabaseEnv)]);
        const seasonName = seasons.find((s) => s.id === seasonId)?.name ?? 'season';
        const driverName = drivers.find((d) => d.id === driverId)?.name ?? 'driver';
        const awardLabel = AWARD_DEFS.find((a) => a.key === awardKey)?.label ?? awardKey;
        await logActivity(supabaseEnv, accessToken, actor, {
          action: 'add',
          entity_type: 'award',
          entity_label: `${awardLabel} — ${seasonName}: ${driverName}`,
          entity_id: driverId,
        });
        return Astro.redirect(`/admin/awards?season=${seasonId}`, 302);
      } catch (err) {
        console.error('Failed to add manual award winner:', err);
        // The unique constraint (manual_awards_unique_winner) is the most
        // likely real-world failure here — this driver's already a winner
        // of this exact award for this exact season.
        error = 'Failed to add this winner — they may already be on the list.';
      }
    }
  } else if (intent === 'remove-winner') {
    const awardId = String(form.get('award_id') ?? '');
    const seasonId = String(form.get('season_id') ?? '');
    formSeasonId = seasonId || null;
    if (awardId) {
      try {
        await removeManualAward(supabaseEnv, accessToken, awardId);
        const driverIdForLog = String(form.get('driver_id') ?? '');
        const [seasons, drivers] = await Promise.all([getSeasons(supabaseEnv), getDriversBasic(supabaseEnv)]);
        const seasonName = seasons.find((s) => s.id === seasonId)?.name ?? 'season';
        const driverName = drivers.find((d) => d.id === driverIdForLog)?.name ?? 'driver';
        const awardKey = String(form.get('award_key') ?? '');
        const awardLabel = AWARD_DEFS.find((a) => a.key === awardKey)?.label ?? awardKey;
        await logActivity(supabaseEnv, accessToken, actor, {
          action: 'delete',
          entity_type: 'award',
          entity_label: `${awardLabel} — ${seasonName}: ${driverName}`,
          entity_id: driverIdForLog || null,
        });
        return Astro.redirect(`/admin/awards?season=${seasonId}`, 302);
      } catch (err) {
        console.error('Failed to remove manual award winner:', err);
        error = 'Failed to remove this winner.';
      }
    }
  }
}

let seasons: Season[] = [];
let drivers: DriverOption[] = [];
let loadError: string | null = null;
try {
  [seasons, drivers] = await Promise.all([getSeasons(supabaseEnv), getDriversBasic(supabaseEnv)]);
} catch (err) {
  console.error('Failed to load admin awards filters:', err);
  loadError = err instanceof Error ? err.message : String(err);
}
const driversSorted = drivers.slice().sort((a, b) => a.name.localeCompare(b.name));

const requestedSeasonId = formSeasonId ?? Astro.url.searchParams.get('season');
const selectedSeasonId =
  (requestedSeasonId && seasons.some((s) => s.id === requestedSeasonId) ? requestedSeasonId : null) ??
  seasons.find((s) => s.is_current)?.id ??
  seasons[0]?.id ??
  null;

let seasonAwards: ManualAward[] = [];
if (!loadError && selectedSeasonId) {
  try {
    seasonAwards = await getManualAwardsForSeason(supabaseEnv, selectedSeasonId);
  } catch (err) {
    console.error('Failed to load manual awards for season:', err);
    loadError = err instanceof Error ? err.message : String(err);
  }
}
const driverById = new Map(drivers.map((d) => [d.id, d]));
const winnersByKey = new Map<ManualAwardKey, ManualAward[]>();
for (const a of seasonAwards) {
  if (!winnersByKey.has(a.award_key)) winnersByKey.set(a.award_key, []);
  winnersByKey.get(a.award_key)!.push(a);
}
---

<AdminLayout title="Awards">
  <h1 class="reveal font-display text-4xl">Awards</h1>
  <p class="reveal mt-2 text-sm text-white/60" style="transition-delay: 60ms">
    Best Racecraft and Most Improved aren't computed from race results — pick the winner(s) here, per season. Every
    other award on the public Awards page is derived automatically from race data and isn't editable from this page.
  </p>

  {loadError && (
    <p class="reveal mt-6 rounded-lg border border-brand-pink/30 bg-brand-pink/10 p-4 text-sm text-white/80">
      Couldn't load Awards.
      <br /><span class="mt-1 block text-white/50">{loadError}</span>
    </p>
  )}

  {!loadError && seasons.length === 0 && (
    <p class="reveal mt-8 text-sm text-white/60" style="transition-delay: 80ms">No seasons yet — add one under Seasons first.</p>
  )}

  {!loadError && seasons.length > 0 && (
    <>
      <form method="GET" class="reveal mt-6" style="transition-delay: 70ms">
        <label class="flex max-w-xs flex-col gap-1.5 text-sm">
          <span class="text-white/60">Season</span>
          <select
            name="season"
            onchange="this.form.submit()"
            class="rounded-md border border-white/15 bg-white/5 px-3 py-2 text-white outline-none focus:border-brand-primary"
          >
            {seasons.map((s) => (
              <option value={s.id} selected={s.id === selectedSeasonId} class="bg-brand-ink text-white">{s.name}</option>
            ))}
          </select>
        </label>
      </form>

      {error && (
        <p class="reveal mt-6 max-w-xl rounded-lg border border-brand-pink/30 bg-brand-pink/10 p-4 text-sm text-white/80">{error}</p>
      )}

      {selectedSeasonId && (
        <div class="mt-8 flex flex-col gap-10">
          {AWARD_DEFS.map((def) => {
            const winners = winnersByKey.get(def.key) ?? [];
            const alreadyWonIds = new Set(winners.map((w) => w.driver_id));
            const availableDrivers = driversSorted.filter((d) => !alreadyWonIds.has(d.id));
            return (
              <div class="reveal max-w-xl border-t border-white/10 pt-6" style="transition-delay: 90ms">
                <h2 class="text-lg font-semibold">{def.label}</h2>
                <p class="mt-1 text-sm text-white/50">{def.description}</p>

                {winners.length === 0 ? (
                  <p class="mt-4 text-sm text-white/40">No winner set for this season yet.</p>
                ) : (
                  <ul class="mt-4 flex flex-col gap-2">
                    {winners.map((w) => {
                      const driver = driverById.get(w.driver_id);
                      return (
                        <li class="flex items-center justify-between gap-3 rounded-md bg-white/5 px-3 py-2 text-sm ring-1 ring-white/10">
                          <span>
                            {driver?.name ?? 'Unknown driver'}
                            {driver?.car_number != null && <span class="text-white/40"> #{driver.car_number}</span>}
                          </span>
                          <form method="POST" data-astro-reload>
                            <input type="hidden" name="intent" value="remove-winner" />
                            <input type="hidden" name="award_id" value={w.id} />
                            <input type="hidden" name="season_id" value={selectedSeasonId} />
                            <input type="hidden" name="award_key" value={def.key} />
                            <input type="hidden" name="driver_id" value={w.driver_id} />
                            <button type="submit" class="text-xs font-semibold text-white/40 transition hover:text-brand-pink">
                              Remove
                            </button>
                          </form>
                        </li>
                      );
                    })}
                  </ul>
                )}

                {availableDrivers.length === 0 ? (
                  <p class="mt-4 text-xs text-white/40">Every driver on the roster already has this award for this season.</p>
                ) : (
                  <form method="POST" data-astro-reload class="mt-4 flex flex-wrap items-end gap-3">
                    <input type="hidden" name="intent" value="add-winner" />
                    <input type="hidden" name="season_id" value={selectedSeasonId} />
                    <input type="hidden" name="award_key" value={def.key} />
                    <label class="flex flex-col gap-1.5 text-sm">
                      <span class="text-white/60">Add winner</span>
                      <select
                        name="driver_id"
                        required
                        class="min-w-[14rem] rounded-md border border-white/15 bg-white/5 px-3 py-2 text-white outline-none focus:border-brand-primary"
                      >
                        <option value="" class="bg-brand-ink text-white">— Select a driver —</option>
                        {availableDrivers.map((d) => (
                          <option value={d.id} class="bg-brand-ink text-white">
                            {d.name}{d.car_number !== null ? ` #${d.car_number}` : ''}
                          </option>
                        ))}
                      </select>
                    </label>
                    <button
                      type="submit"
                      class="rounded-lg bg-white/5 px-4 py-2 text-sm font-semibold ring-1 ring-white/10 transition hover:bg-white/10"
                    >
                      Add
                    </button>
                  </form>
                )}
                <p class="mt-2 text-xs text-white/40">More than one driver can win the same award in the same season — add each one.</p>
              </div>
            );
          })}
        </div>
      )}
    </>
  )}
</AdminLayout>
