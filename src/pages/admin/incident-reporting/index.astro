---
export const prerender = false;

// Admin → Incident Reporting: per round, report counts by state, a "Posted" toggle (publishes the incident
// report and the results page button; 0092) and an Edit link to the round's incident page.
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { resolveSupabaseEnv, restGetAuthed } from '../../../lib/db/client';
import { getStandingsExcludedRoundIds } from '../../../lib/db/rounds';
import { getAllRounds, computeDisplayRoundNumbers } from '../../../lib/results/rounds';
import {
  getRoundPostingStatuses,
  parsePostChoice,
  postDateCell,
  postingLogLabel,
  setRoundPosted,
} from '../../../lib/incidentReports';
import { formatDate } from '../../../lib/db/circuits';
import { logActivity, actorNameFor } from '../../../lib/activityLog';
import { requireAdmin } from '../../../lib/auth';

const admin = requireAdmin(Astro);
if (admin instanceof Response) return admin;

const supabaseEnv = resolveSupabaseEnv(Astro.locals);
const accessToken = admin.accessToken;
const actor = { id: admin.user.id, name: actorNameFor(admin) };

let error: string | null = null;

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  if (String(form.get('intent') ?? '') === 'set-posted') {
    const subsessionId = Number(form.get('subsession_id'));
    const posted = String(form.get('posted') ?? '') === 'true';
    // The re-post popup sends Reset or Keep original date; with no script nothing is sent, which is a Reset.
    const choice = parsePostChoice(form);
    if (Number.isFinite(subsessionId)) {
      try {
        const result = await setRoundPosted(supabaseEnv, accessToken, subsessionId, {
          posted,
          resetDate: choice === 'reset',
        });
        const rounds = await getAllRounds(supabaseEnv);
        const round = rounds.find((r) => r.subsession_id === subsessionId);
        await logActivity(supabaseEnv, accessToken, actor, {
          action: 'edit',
          entity_type: 'incident_report',
          entity_label: postingLogLabel(
            posted,
            !result.firstPost,
            result.reset ? 'reset' : 'keep',
            round?.track_name ?? String(subsessionId),
          ),
          entity_id: String(subsessionId),
        });
        const keep = new URL(Astro.request.url).searchParams.get('all') === '1' ? '?all=1' : '';
        return Astro.redirect(`/admin/incident-reporting${keep}`, 302);
      } catch (err) {
        console.error('Failed to update posted flag:', err);
        error =
          err instanceof Error && /Only an admin or staff member can post a round/.test(err.message)
            ? 'Only an admin or staff member can post a round.'
            : err instanceof Error
              ? err.message
              : 'Failed to update posted status.';
      }
    }
  }
}

const showAll = Astro.url.searchParams.get('all') === '1';
const DEFAULT_LIMIT = 25;

interface Row {
  subsessionId: number;
  label: string;
  trackName: string;
  startTime: string;
  reported: number;
  pending: number;
  dismissed: number;
  logged: number;
  posted: boolean;
  /** Posted before (now or earlier), so turning Posted on asks whether to reset the date (BR1.1). */
  postedBefore: boolean;
  postDate: { date: string; muted: boolean } | null;
}

let rows: Row[] = [];
let totalRounds = 0;
let loadError: string | null = null;
try {
  const [allRoundRows, excluded, postingStatuses, reports] = await Promise.all([
    getAllRounds(supabaseEnv),
    getStandingsExcludedRoundIds(supabaseEnv),
    getRoundPostingStatuses(supabaseEnv),
    // Admin token — RLS only lets admins read every report.
    restGetAuthed<{ subsession_id: number; status: 'open' | 'logged' | 'dismissed' }[]>(
      supabaseEnv,
      accessToken,
      'incident_reports?select=subsession_id,status&limit=10000'
    ),
  ]);

  // Same set the public Race Results page lists: it only shows rounds that
  // belong to a season, so a round still waiting to be linked to one (an
  // "orphan" — see lib/orphanRounds.ts) is left out here too.
  const rounds = allRoundRows.filter((r) => r.season_id);

  const counts = new Map<number, { open: number; logged: number; dismissed: number }>();
  for (const r of reports) {
    const c = counts.get(r.subsession_id) ?? { open: 0, logged: 0, dismissed: 0 };
    if (r.status === 'open') c.open++;
    else if (r.status === 'logged') c.logged++;
    else if (r.status === 'dismissed') c.dismissed++;
    counts.set(r.subsession_id, c);
  }

  // Round numbers are per season.
  const bySeason = new Map<string, typeof rounds>();
  for (const r of rounds) {
    if (!bySeason.has(r.season_id)) bySeason.set(r.season_id, []);
    bySeason.get(r.season_id)!.push(r);
  }
  const displayNumber = new Map<number, number | null>();
  for (const seasonRounds of bySeason.values()) {
    for (const [id, n] of computeDisplayRoundNumbers(seasonRounds, excluded, new Set())) displayNumber.set(id, n);
  }

  totalRounds = rounds.length;
  rows = [...rounds]
    .sort((a, b) => new Date(b.start_time).getTime() - new Date(a.start_time).getTime())
    .map((r) => {
      const c = counts.get(r.subsession_id) ?? { open: 0, logged: 0, dismissed: 0 };
      const n = displayNumber.get(r.subsession_id);
      const status = postingStatuses.get(r.subsession_id);
      const season = r.season_label ?? '';
      // "ATC18, Round 3" — then the table adds ": Track Name".
      const label = `${season ? season + ', ' : ''}${n != null ? `Round ${n}` : 'Exhibition'}`;
      return {
        subsessionId: r.subsession_id,
        label,
        trackName: r.track_name,
        startTime: r.start_time,
        reported: c.open + c.logged + c.dismissed,
        pending: c.open,
        dismissed: c.dismissed,
        logged: c.logged,
        posted: status?.posted === true,
        postedBefore: !!(status?.first_posted_at || status?.posted_at),
        postDate: postDateCell(status),
      };
    });
} catch (err) {
  console.error('Failed to load incident reporting overview:', err);
  loadError = err instanceof Error ? err.message : String(err);
}

const visibleRows = showAll ? rows : rows.slice(0, DEFAULT_LIMIT);
---

<AdminLayout title="Incident Reporting">

  {(error || loadError) && (
    <p class="reveal mt-6 break-words rounded-lg border border-brand-pink/30 bg-brand-pink/10 p-4 text-sm text-white/80">{error ?? loadError}</p>
  )}

  {/* Phones (BR1.11): the track name and the four count columns hide below `sm`, and the table only takes a
     fixed minimum width from `sm` up, so Round, Posted, Post Date and the links fit without sideways scrolling. */}
  <div class="reveal mt-8 overflow-x-auto rounded-xl border border-white/10" style="transition-delay: 80ms">
    <table class="w-full text-left text-sm sm:min-w-[880px]">
      <thead class="bg-brand-ink text-xs uppercase tracking-wide text-white/50">
        <tr>
          <th class="px-4 py-3 font-semibold">Round</th>
          <th class="hidden px-3 py-3 text-center font-semibold sm:table-cell">Reported</th>
          <th class="hidden px-3 py-3 text-center font-semibold sm:table-cell">Pending</th>
          <th class="hidden px-3 py-3 text-center font-semibold sm:table-cell">Dismissed</th>
          <th class="hidden px-3 py-3 text-center font-semibold sm:table-cell">Logged</th>
          <th class="px-3 py-3 text-center font-semibold">Posted</th>
          <th class="px-3 py-3 font-semibold">Post Date</th>
          <th class="px-4 py-3 text-right font-semibold"></th>
        </tr>
      </thead>
      <tbody>
        {visibleRows.map((r) => (
          <tr class={`border-t border-white/5 ${r.posted ? 'text-white/40' : ''}`}>
            <td class="px-4 py-3">
              <div class={`font-semibold ${r.posted ? 'text-white/40' : 'text-white'}`}>
                {r.label}<span class="hidden sm:inline">: {r.trackName}</span>
              </div>
            </td>
            <td class="hidden px-3 py-3 text-center tabular-nums sm:table-cell">{r.reported}</td>
            <td class={`hidden px-3 py-3 text-center tabular-nums sm:table-cell ${r.pending > 0 && !r.posted ? 'font-semibold text-brand-gold' : ''}`}>{r.pending}</td>
            <td class="hidden px-3 py-3 text-center tabular-nums sm:table-cell">{r.dismissed}</td>
            <td class="hidden px-3 py-3 text-center tabular-nums sm:table-cell">{r.logged}</td>
            <td class="px-3 py-3 text-center">
              {/* data-first-posted: turning Posted back on asks whether to reset the date (repostDialog.ts). */}
              <form
                method="POST"
                data-astro-reload
                action={showAll ? '?all=1' : undefined}
                class="inline-flex"
                data-post-switch
                data-first-posted={r.postedBefore && !r.posted ? 'true' : undefined}
              >
                <input type="hidden" name="intent" value="set-posted" />
                <input type="hidden" name="subsession_id" value={r.subsessionId} />
                <input type="hidden" name="posted" value={r.posted ? 'false' : 'true'} />
                <input type="hidden" name="date" value="reset" data-post-date-choice />
                <button
                  type="submit"
                  role="switch"
                  aria-checked={r.posted ? 'true' : 'false'}
                  aria-label={`${r.posted ? 'Unpost' : 'Post'} ${r.trackName} incident report`}
                  class={`relative h-6 w-11 rounded-full transition ${r.posted ? 'bg-brand-primary text-fixed-white' : 'bg-fixed-white/15'}`}
                >
                  <span class={`absolute top-0.5 h-5 w-5 rounded-full bg-white transition-all ${r.posted ? 'left-[22px]' : 'left-0.5'}`}></span>
                </button>
              </form>
            </td>
            {/* A round unposted after posting keeps its last date, shown muted (BR1.10). */}
            <td class={`whitespace-nowrap px-3 py-3 tabular-nums ${!r.postDate || r.postDate.muted ? 'text-white/40' : ''}`}>
              {r.postDate ? formatDate(r.postDate.date) : '—'}
            </td>
            <td class="whitespace-nowrap px-4 py-3 text-right">
              {/* Two fixed-width slots so "View Incidents" never shifts with the width of "View Report" / "Edit Report"; stacked on phones. ?view=reports switches the round's incident page to its submitted-reports view (it says so itself when a round has no reports). */}
              <span class="inline-flex flex-col items-end gap-1 sm:flex-row sm:gap-4">
                <a
                  href={`/results/${r.subsessionId}/incidents?view=reports`}
                  class={`inline-block w-28 text-left font-semibold hover:underline ${r.posted ? 'text-white/40 hover:text-white/70' : 'text-brand-primary'}`}
                >View Incidents</a>
                <a
                  href={`/results/${r.subsessionId}/incidents`}
                  class={`inline-block w-28 text-left font-semibold hover:underline ${r.posted ? 'text-white/40 hover:text-white/70' : 'text-brand-primary'}`}
                >{r.posted ? 'View Report' : 'Edit Report'}</a>
              </span>
            </td>
          </tr>
        ))}
        {visibleRows.length === 0 && (
          <tr><td colspan="8" class="px-4 py-6 text-center text-white/50">No rounds yet.</td></tr>
        )}
      </tbody>
    </table>
  </div>

  {/* Re-posting a round that was posted before (BR1.1, BR1.10): reset the post date, which restarts the
     incident reporting and appeal windows, or keep the original one. Cancel leaves the round unposted. */}
  <dialog
    data-repost-dialog
    class="w-full max-w-md rounded-xl border border-white/10 bg-brand-ink p-0 text-white backdrop:bg-black/60"
  >
    <div class="flex flex-col gap-4 p-5">
      <h4 class="font-display text-lg">Reset post date for incident reporting and appeal windows?</h4>
      <p class="text-sm text-white/60">
        Reset starts both windows again from now. Keep original date leaves them where they were, so they may
        already be closed.
      </p>
      <div class="flex flex-wrap justify-end gap-2">
        <button type="button" data-repost-cancel class="btn btn-neutral">Cancel</button>
        <button type="button" data-repost-choice="keep" class="btn btn-neutral">Keep original date</button>
        <button type="button" data-repost-choice="reset" class="btn btn-primary">Reset</button>
      </div>
    </div>
  </dialog>

  <script>
    import '../../../scripts/repostDialog';
  </script>

  {!showAll && totalRounds > DEFAULT_LIMIT && (
    <p class="mt-4 text-sm"><a href="?all=1" class="text-brand-primary hover:underline">Show all {totalRounds} rounds</a></p>
  )}
</AdminLayout>
