---
export const prerender = false;

// Admin → Incident Reporting: per round, report counts by state, the post date and links to the round's
// incident pages. Rounds are posted from the Incident Report's Post Report button.
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { resolveSupabaseEnv, restGetAuthed } from '../../../lib/db/client';
import { getStandingsExcludedRoundIds } from '../../../lib/db/rounds';
import { getAllRounds, computeDisplayRoundNumbers } from '../../../lib/results/rounds';
import { getRoundPostingStatuses, postDateCell } from '../../../lib/incidentReports';
import {
  formatDate,
  getCircuits,
  getCircuitLogoBackgrounds,
  logoBgAttrs,
  type LogoBackground,
} from '../../../lib/db/circuits';
import { resizedImageUrl } from '../../../lib/db/drivers';
import { normalizeTrackOrLayoutName } from '../../../lib/results/layouts';
import { requireAdmin } from '../../../lib/auth';
import { REPORTING_ORIGIN, withIncidentOrigin } from '../../../lib/incidentPageOrigin';

const admin = requireAdmin(Astro);
if (admin instanceof Response) return admin;

const supabaseEnv = resolveSupabaseEnv(Astro.locals);
const accessToken = admin.accessToken;

const showAll = Astro.url.searchParams.get('all') === '1';
const DEFAULT_LIMIT = 25;

interface Row {
  subsessionId: number;
  label: string;
  trackName: string;
  startTime: string;
  reported: number;
  pending: number;
  dismissed: number;
  logged: number;
  posted: boolean;
  postDate: { date: string; muted: boolean } | null;
  logoUrl: string | null;
  logoBg: LogoBackground | null;
}

// Track logos, matched by track name as on the results list (BR3.3). A failed read leaves the cells empty.
let trackLogoByName = new Map<string, string | null>();
let trackLogoBgByName = new Map<string, LogoBackground>();
try {
  const [circuits, logoBackgrounds] = await Promise.all([
    getCircuits(supabaseEnv),
    getCircuitLogoBackgrounds(supabaseEnv),
  ]);
  trackLogoByName = new Map(circuits.map((c) => [normalizeTrackOrLayoutName(c.name), c.logo_url ?? null]));
  for (const c of circuits) {
    const bg = logoBackgrounds[c.id];
    if (bg) trackLogoBgByName.set(normalizeTrackOrLayoutName(c.name), bg);
  }
} catch (err) {
  console.error('Failed to load circuits for incident reporting logos:', err);
}

let rows: Row[] = [];
let totalRounds = 0;
let loadError: string | null = null;
try {
  const [allRoundRows, excluded, postingStatuses, reports] = await Promise.all([
    getAllRounds(supabaseEnv),
    getStandingsExcludedRoundIds(supabaseEnv),
    getRoundPostingStatuses(supabaseEnv),
    // Admin token — RLS only lets admins read every report.
    restGetAuthed<{ subsession_id: number; status: 'open' | 'logged' | 'dismissed' }[]>(
      supabaseEnv,
      accessToken,
      'incident_reports?select=subsession_id,status&limit=10000'
    ),
  ]);

  // Same set the public Race Results page lists: it only shows rounds that
  // belong to a season, so a round still waiting to be linked to one (an
  // "orphan" — see lib/orphanRounds.ts) is left out here too.
  const rounds = allRoundRows.filter((r) => r.season_id);

  const counts = new Map<number, { open: number; logged: number; dismissed: number }>();
  for (const r of reports) {
    const c = counts.get(r.subsession_id) ?? { open: 0, logged: 0, dismissed: 0 };
    if (r.status === 'open') c.open++;
    else if (r.status === 'logged') c.logged++;
    else if (r.status === 'dismissed') c.dismissed++;
    counts.set(r.subsession_id, c);
  }

  // Round numbers are per season.
  const bySeason = new Map<string, typeof rounds>();
  for (const r of rounds) {
    if (!bySeason.has(r.season_id)) bySeason.set(r.season_id, []);
    bySeason.get(r.season_id)!.push(r);
  }
  const displayNumber = new Map<number, number | null>();
  for (const seasonRounds of bySeason.values()) {
    for (const [id, n] of computeDisplayRoundNumbers(seasonRounds, excluded, new Set())) displayNumber.set(id, n);
  }

  totalRounds = rounds.length;
  rows = [...rounds]
    .sort((a, b) => new Date(b.start_time).getTime() - new Date(a.start_time).getTime())
    .map((r) => {
      const c = counts.get(r.subsession_id) ?? { open: 0, logged: 0, dismissed: 0 };
      const n = displayNumber.get(r.subsession_id);
      const status = postingStatuses.get(r.subsession_id);
      const season = r.season_label ?? '';
      // "ATC18, Round 3" or "ATC18, Exhibition"; the track shows only as the logo (BR3.2).
      const label = `${season ? season + ', ' : ''}${n != null ? `Round ${n}` : 'Exhibition'}`;
      const trackKey = normalizeTrackOrLayoutName(r.track_name);
      return {
        subsessionId: r.subsession_id,
        label,
        trackName: r.track_name,
        startTime: r.start_time,
        reported: c.open + c.logged + c.dismissed,
        pending: c.open,
        dismissed: c.dismissed,
        logged: c.logged,
        posted: status?.posted === true,
        postDate: postDateCell(status),
        logoUrl: resizedImageUrl(trackLogoByName.get(trackKey) ?? null, { width: 96 }),
        logoBg: trackLogoBgByName.get(trackKey) ?? null,
      };
    });
} catch (err) {
  console.error('Failed to load incident reporting overview:', err);
  loadError = err instanceof Error ? err.message : String(err);
}

const visibleRows = showAll ? rows : rows.slice(0, DEFAULT_LIMIT);
---

<AdminLayout title="Incident Reporting">

  {loadError && (
    <p class="reveal mt-6 break-words rounded-lg border border-brand-pink/30 bg-brand-pink/10 p-4 text-sm text-white/80">{loadError}</p>
  )}

  {/* Phones (BR1.11, BR3.4): the four count columns and Post Date hide below `sm` and the logo below `lg`, and
     the table only takes a fixed minimum width from `sm` up, so Round and the links fit on a phone. */}
  <div class="reveal mt-8 overflow-x-auto rounded-xl border border-white/10" style="transition-delay: 80ms">
    <table class="data-table w-full text-left text-sm sm:min-w-[880px]">
      <thead class="bg-brand-ink text-xs uppercase tracking-wide text-white/50">
        <tr>
          <th class="px-4 py-3 font-semibold">Round</th>
          <th class="hidden px-3 py-3 font-semibold lg:table-cell"><span class="sr-only">Logo</span></th>
          <th class="hidden px-3 py-3 text-center font-semibold sm:table-cell">Reported</th>
          <th class="hidden px-3 py-3 text-center font-semibold sm:table-cell">Pending</th>
          <th class="hidden px-3 py-3 text-center font-semibold sm:table-cell">Dismissed</th>
          <th class="hidden px-3 py-3 text-center font-semibold sm:table-cell">Logged</th>
          <th class="hidden px-3 py-3 font-semibold sm:table-cell">Post Date</th>
          <th class="px-4 py-3 text-right font-semibold"></th>
        </tr>
      </thead>
      <tbody>
        {visibleRows.map((r) => (
          <tr class={`border-t border-white/5 ${r.posted ? 'text-white/40' : ''}`}>
            <td class="px-4 py-3">
              <div class={`font-semibold ${r.posted ? 'text-white/40' : 'text-white'}`}>{r.label}</div>
            </td>
            <td class="hidden px-3 py-2 lg:table-cell" data-testid="incident-reporting-logo">
              {r.logoUrl && (
                <img
                  src={r.logoUrl}
                  alt={r.trackName}
                  title={r.trackName}
                  loading="lazy"
                  class={`h-8 w-8 rounded object-contain ${r.posted ? 'opacity-50' : ''}`}
                  {...logoBgAttrs(r.logoBg)}
                />
              )}
            </td>
            <td class="hidden px-3 py-3 text-center tabular-nums sm:table-cell">{r.reported}</td>
            <td class={`hidden px-3 py-3 text-center tabular-nums sm:table-cell ${r.pending > 0 && !r.posted ? 'font-semibold text-brand-gold' : ''}`}>{r.pending}</td>
            <td class="hidden px-3 py-3 text-center tabular-nums sm:table-cell">{r.dismissed}</td>
            <td class="hidden px-3 py-3 text-center tabular-nums sm:table-cell">{r.logged}</td>
            {/* A round unposted after posting keeps its last date, shown muted (BR1.10). */}
            <td class={`hidden whitespace-nowrap px-3 py-3 tabular-nums sm:table-cell ${!r.postDate || r.postDate.muted ? 'text-white/40' : ''}`}>
              {r.postDate ? formatDate(r.postDate.date) : '—'}
            </td>
            <td class="whitespace-nowrap px-4 py-3 text-right">
              {/* Two fixed-width slots so "Review Submissions" never shifts with the width of "View Report" / "Preview Report". ?view=reports switches the round's incident page to its submitted-reports view; from=reporting gives it a link back here (BR2.7). Phones show only the first link (BR3.1). */}
              <span class="inline-flex items-center gap-4">
                <a
                  href={withIncidentOrigin(`/results/${r.subsessionId}/incidents?view=reports`, REPORTING_ORIGIN)}
                  class={`inline-block text-left font-semibold hover:underline sm:w-40 ${r.posted ? 'text-white/40 hover:text-white/70' : 'text-brand-primary'}`}
                  data-testid="incident-reporting-review-link"
                >Review Submissions</a>
                <a
                  href={withIncidentOrigin(`/results/${r.subsessionId}/incidents`, REPORTING_ORIGIN)}
                  class={`hidden w-28 text-left font-semibold hover:underline sm:inline-block ${r.posted ? 'text-white/40 hover:text-white/70' : 'text-brand-primary'}`}
                  data-testid="incident-reporting-report-link"
                >{r.posted ? 'View Report' : 'Preview Report'}</a>
              </span>
            </td>
          </tr>
        ))}
        {visibleRows.length === 0 && (
          <tr><td colspan="8" class="px-4 py-6 text-center text-white/50">No rounds yet.</td></tr>
        )}
      </tbody>
    </table>
  </div>

  {!showAll && totalRounds > DEFAULT_LIMIT && (
    <p class="mt-4 text-sm"><a href="?all=1" class="text-brand-primary hover:underline">Show all {totalRounds} rounds</a></p>
  )}
</AdminLayout>
