---
export const prerender = false;

import Layout from '../../layouts/Layout.astro';
import { resolveSupabaseEnv } from '../../lib/supabase';
import {
  signInWithPassword,
  ACCESS_TOKEN_COOKIE,
  REFRESH_TOKEN_COOKIE,
  authCookieOptions,
} from '../../lib/auth';

const supabaseEnv = resolveSupabaseEnv(Astro.locals);
const next = Astro.url.searchParams.get('next') || '/admin';
const session = Astro.locals.session;

// Already signed in as an admin? Skip straight past the form.
if (session?.profile?.role === 'admin') {
  return Astro.redirect(next, 302);
}

// Signed in, but not an admin — this is the case that used to look exactly
// like a failed login: the middleware would silently bounce a request for
// any /admin/* page back to this page, with nothing on screen to explain
// why (sign-in itself had already succeeded). Surface it directly instead,
// with the exact SQL to fix it for this account.
const signedInButNotAdmin = Boolean(session && session.profile?.role !== 'admin');

let error: string | null = null;

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const email = String(form.get('email') ?? '').trim();
  const password = String(form.get('password') ?? '');

  if (!email || !password) {
    error = 'Enter both an email and a password.';
  } else {
    try {
      const newSession = await signInWithPassword(supabaseEnv, email, password);
      const cookieOptions = authCookieOptions(Astro.url);
      Astro.cookies.set(ACCESS_TOKEN_COOKIE, newSession.accessToken, { ...cookieOptions, maxAge: 60 * 60 });
      Astro.cookies.set(REFRESH_TOKEN_COOKIE, newSession.refreshToken, {
        ...cookieOptions,
        maxAge: 60 * 60 * 24 * 30,
      });
      return Astro.redirect(next, 302);
    } catch (err) {
      // Surfacing Supabase's actual error text (not a generic "incorrect
      // password") on purpose — it's the fastest way to tell "wrong
      // password" apart from "this account's email was never confirmed"
      // (a common gotcha when a user is created via the Supabase dashboard
      // without checking "Auto Confirm User") apart from a genuine
      // config/network problem. Once real accounts are in normal use, this
      // is worth swapping back to a generic message.
      console.error('Login failed:', err);
      error = err instanceof Error ? err.message : 'Login failed for an unknown reason.';
    }
  }
}
---

<Layout title="Admin Login">
  <section class="mx-auto flex max-w-sm flex-col px-6 pb-24 pt-28 sm:pt-36">
    <h1 class="reveal font-display text-4xl">Admin Login</h1>
    <p class="reveal mt-2 text-sm text-white/60" style="transition-delay: 60ms">
      Interim login while ATC's "Login with iRacing" integration waits on iRacing re-opening OAuth client registration.
    </p>

    {error && (
      <p class="mt-6 rounded-xl border border-brand-pink/30 bg-brand-pink/10 p-4 text-sm text-white/80">{error}</p>
    )}

    {signedInButNotAdmin && session && (
      <div class="mt-6 rounded-xl border border-brand-tertiary/30 bg-brand-tertiary/10 p-4 text-sm text-white/80">
        <p>
          You're signed in as <strong>{session.user.email}</strong>, but this account doesn't have admin access yet.
        </p>
        <p class="mt-2">
          {session.profile
            ? 'Run this in the Supabase SQL editor to promote it:'
            : "No profile row exists yet for this account (it was likely created before the admin system was set up) — run this in the Supabase SQL editor:"}
        </p>
        <pre class="mt-2 overflow-x-auto rounded-lg bg-black/30 p-3 text-xs text-white/90"><code>{session.profile
            ? `update profiles set role = 'admin' where id = '${session.user.id}';`
            : `insert into profiles (id, role, display_name)\nvalues ('${session.user.id}', 'admin', '${session.user.email ?? ''}')\non conflict (id) do update set role = 'admin';`}</code></pre>
        <p class="mt-2 text-white/60">Then just reload this page — no need to sign in again.</p>
        <form method="POST" action="/api/logout" class="mt-3">
          <button
            type="submit"
            class="rounded-full bg-white/5 px-4 py-2 text-sm font-semibold ring-1 ring-white/10 transition hover:bg-white/10"
          >
            Sign out
          </button>
        </form>
      </div>
    )}

    {!signedInButNotAdmin && (
      <form method="POST" data-astro-reload class="reveal mt-8 flex flex-col gap-4" style="transition-delay: 120ms">
        <label class="flex flex-col gap-1.5 text-sm">
          <span class="text-white/70">Email</span>
          <input
            type="email"
            name="email"
            required
            autocomplete="email"
            class="rounded-lg border border-white/15 bg-white/5 px-3 py-2 text-white outline-none focus:border-brand-primary"
          />
        </label>
        <label class="flex flex-col gap-1.5 text-sm">
          <span class="text-white/70">Password</span>
          <input
            type="password"
            name="password"
            required
            autocomplete="current-password"
            class="rounded-lg border border-white/15 bg-white/5 px-3 py-2 text-white outline-none focus:border-brand-primary"
          />
        </label>
        <button
          type="submit"
          class="mt-2 rounded-full bg-brand-primary px-6 py-3 font-semibold transition hover:brightness-110"
        >
          Sign In
        </button>
      </form>
    )}
  </section>
</Layout>
