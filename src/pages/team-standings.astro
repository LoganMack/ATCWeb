---
export const prerender = false;

import Layout from '../layouts/Layout.astro';
import HistoryTabs from '../components/HistoryTabs.astro';
import TeamLogo from '../components/TeamLogo.astro';
import PageBanner from '../components/PageBanner.astro';
import {
  resolveSupabaseEnv,
  getSeasons,
  getExhibitionRoundIds,
  getDriverClasses,
  displayDriverName,
  getPageBanners,
} from '../lib/supabase';
import {
  computeTeamSeasonStandings,
  computeOverallSeasonStandings,
  isChampionshipSeason,
  type TeamSeasonStanding,
  type DriverSeasonStanding,
} from '../lib/results';
import { bannerUrlFor } from '../lib/pageBanners';

const supabaseEnv = resolveSupabaseEnv(Astro.locals);

let seasons: Awaited<ReturnType<typeof getSeasons>> = [];
let loadError: string | null = null;
try {
  seasons = await getSeasons(supabaseEnv);
} catch (err) {
  console.error('Failed to load team standings page filters:', err);
  loadError = err instanceof Error ? err.message : String(err);
}

// Exhibition seasons never have standings (computeTeamSeasonStandings
// returns [] for them — see isChampionshipSeason), so the picker only
// offers real championship seasons in the first place.
const championshipSeasons = seasons.filter((s) => isChampionshipSeason(s.name));

const requestedSeasonNumber = Astro.url.searchParams.get('season');
const activeSeason =
  championshipSeasons.find((s) => String(s.number) === requestedSeasonNumber) ??
  championshipSeasons.find((s) => s.is_current) ??
  championshipSeasons[0];

// Same "Overall combines every class, [class] is its own separate
// competition" idea the news recap's topTeamOverall/topTeamDelta already
// draws — see computeTeamSeasonStandings' own doc comment. Defaults to
// Overall for the same reason the driver Standings page defaults there.
const view = Astro.url.searchParams.get('view') === 'delta' ? 'delta' : 'overall';

let standings: TeamSeasonStanding[] = [];
// Keyed by driver id — powers each team row's expanded roster detail
// (overall championship position/points/starts for every driver on the
// team), joined in here rather than inside computeTeamSeasonStandings
// itself since "overall standing" is a season-wide concept, not a
// team-scoped one. Deliberately always the cross-class overall standing
// regardless of which team view is showing — the roster detail's own job
// is "where does this driver sit in the championship," not a per-view stat.
let overallStandingByDriverId = new Map<string, DriverSeasonStanding>();
if (!loadError && activeSeason) {
  try {
    const [exhibitionRoundIds, classes] = await Promise.all([getExhibitionRoundIds(supabaseEnv), getDriverClasses(supabaseEnv)]);
    const deltaClassId = view === 'delta' ? classes.find((c) => c.name === 'Delta')?.id : undefined;
    const [teamStandings, overallStandings] = await Promise.all([
      computeTeamSeasonStandings(supabaseEnv, activeSeason, exhibitionRoundIds, deltaClassId),
      computeOverallSeasonStandings(supabaseEnv, activeSeason, undefined, exhibitionRoundIds),
    ]);
    standings = teamStandings;
    overallStandingByDriverId = new Map(overallStandings.map((s) => [s.driver.id, s]));
  } catch (err) {
    console.error('Failed to compute team standings:', err);
    loadError = err instanceof Error ? err.message : String(err);
  }
}

let bannerUrl: string | null = null;
try {
  bannerUrl = bannerUrlFor(await getPageBanners(supabaseEnv), 'team-standings');
} catch (err) {
  console.error('Failed to load page banner:', err);
}

Astro.response.headers.set('Cache-Control', 'public, s-maxage=60, stale-while-revalidate=300');
---

<Layout title="Team Standings" description="Full season team standings for every Alpha Touring Challenge season.">
  <section class="relative mx-auto max-w-5xl overflow-hidden px-6 pb-24 pt-28 sm:pt-36">
    <PageBanner imageUrl={bannerUrl} />
    <h1 class="reveal font-display text-5xl">Team Standings</h1>

    <HistoryTabs active="teamStandings" />

    {loadError && (
      <p class="mt-4 rounded-lg border border-brand-pink/30 bg-brand-pink/10 p-4 text-sm text-white/80">
        Couldn't load team standings right now. If this mentions permission/RLS, race_scores or curated_race_results
        likely still need the public-read policy from <code>supabase/migrations/0004_champions.sql</code> —
        it has to be run manually in the Supabase SQL editor.
        <br /><span class="mt-1 block text-white/50">{loadError}</span>
      </p>
    )}

    {!loadError && (
      <div class="mt-8 flex flex-wrap items-end justify-between gap-4">
        <form method="GET" class="flex flex-wrap items-end gap-4">
          <input type="hidden" name="view" value={view} />
          <label class="flex flex-col gap-1.5 text-sm">
            <span class="text-white/60">Season</span>
            <div class="flex items-center gap-2">
              <select
                name="season"
                onchange="this.form.submit()"
                class="rounded-md border border-white/15 bg-white/5 px-3 py-2 text-white outline-none focus:border-brand-primary"
              >
                {championshipSeasons.map((s) => (
                  <option value={s.number} selected={s.id === activeSeason?.id} class="bg-brand-ink text-white">{s.name}</option>
                ))}
              </select>
              {activeSeason?.logo_url && (
                <img src={activeSeason.logo_url} alt="" class="h-9 w-9 flex-none rounded object-contain" />
              )}
            </div>
          </label>
        </form>

        <div class="flex gap-2">
          <a
            href={`/team-standings?view=overall${activeSeason ? `&season=${activeSeason.number}` : ''}`}
            class={`rounded-lg px-4 py-1.5 text-sm font-semibold ring-1 ring-white/15 transition ${
              view === 'overall' ? 'bg-white text-brand-ink' : 'text-white/80 hover:bg-white/10'
            }`}
          >
            Overall
          </a>
          <a
            href={`/team-standings?view=delta${activeSeason ? `&season=${activeSeason.number}` : ''}`}
            class={`rounded-lg px-4 py-1.5 text-sm font-semibold ring-1 ring-white/15 transition ${
              view === 'delta' ? 'bg-white text-brand-ink' : 'text-white/80 hover:bg-white/10'
            }`}
          >
            Delta
          </a>
        </div>
      </div>
    )}

    {!loadError && standings.length === 0 && (
      <p class="mt-10 text-white/60">No results.</p>
    )}

    {!loadError && standings.length > 0 && (
      <div class="mt-8 overflow-x-auto rounded-xl border border-white/10">
        <table class="w-full border-collapse" data-sortable>
          <thead>
            <tr class="border-b border-white/10 text-left text-xs uppercase tracking-wide text-white/40">
              <th class="py-3 pl-4 pr-2 font-medium" data-sort-key="position">Pos</th>
              <th class="py-3 pr-3 font-medium" data-sort-key="team">Team</th>
              <th class="py-3 pr-3 text-center font-medium" data-sort-key="points">Points</th>
              <th class="hidden py-3 pr-3 text-center font-medium sm:table-cell" data-sort-key="starts">Starts</th>
              <th class="py-3 pr-4 text-center font-medium" data-sort-key="appearances">Apps</th>
            </tr>
          </thead>
          <tbody>
            {standings.map((row) => {
              const roster = row.driverIds
                .map((driverId) => overallStandingByDriverId.get(driverId))
                .filter((s): s is DriverSeasonStanding => s !== undefined)
                .sort((a, b) => a.position - b.position);
              return (
              <>
              <tr
                data-expand-row
                tabindex="0"
                role="button"
                aria-expanded="false"
                class="cursor-pointer border-b border-white/5 text-sm transition hover:bg-white/[0.04]"
              >
                <td class="py-2.5 pl-4 pr-2 font-display text-lg leading-none text-white/70" data-col="position">{row.position}</td>
                <td class="py-2.5 pr-3 font-semibold" data-col="team" data-sort-value={row.teamName}>
                  <div class="flex items-center gap-2">
                    <span
                      data-chevron
                      class="inline-block shrink-0 text-[9px] text-white/30 transition-transform duration-150"
                      aria-hidden="true"
                    >
                      &#9654;
                    </span>
                    <TeamLogo name={row.teamName} logoUrl={row.logoUrl} size="h-6 w-6" />
                    <span>{row.teamName}</span>
                  </div>
                </td>
                <td class="py-2.5 pr-3 text-center font-semibold" data-col="points">{row.totalPoints}</td>
                <td class="hidden py-2.5 pr-3 text-center text-white/60 sm:table-cell" data-col="starts">{row.starts}</td>
                <td class="py-2.5 pr-4 text-center text-white/60" data-col="appearances">{row.appearances}</td>
              </tr>
              <tr data-detail-row class="hidden border-b border-white/5 bg-white/[0.02] text-xs">
                <td colspan={5} class="px-4 py-4 sm:pl-11">
                  {roster.length === 0 ? (
                    <p class="text-white/40">No driver data available.</p>
                  ) : (
                    <div class="grid gap-x-4 gap-y-2 sm:grid-cols-2 lg:grid-cols-3">
                      {roster.map((driverStanding) => (
                        <div class="flex items-center justify-between gap-3 rounded-lg border border-white/10 bg-white/[0.03] px-3 py-2">
                          <span class="font-semibold text-white/90">
                            {displayDriverName(driverStanding.driver.name)}
                            {driverStanding.driver.car_number !== null && (
                              <span class="text-white/40"> #{driverStanding.driver.car_number}</span>
                            )}
                          </span>
                          <span class="whitespace-nowrap text-white/50">
                            P{driverStanding.position} — {driverStanding.totalPoints} pts — {driverStanding.starts} starts
                          </span>
                        </div>
                      ))}
                    </div>
                  )}
                </td>
              </tr>
              </>
              );
            })}
          </tbody>
        </table>
      </div>
    )}
  </section>
</Layout>
