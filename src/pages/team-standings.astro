---
export const prerender = false;

// The Team Standings tab was folded into /standings (Championship dropdown →
// Teams). Old links and bookmarks land there, keeping season/mode, and the old
// `?view=delta` becomes the Class dropdown's "Delta".
const params = new URLSearchParams();
params.set('championship', 'teams');
const season = Astro.url.searchParams.get('season');
if (season) params.set('season', season);
if (Astro.url.searchParams.get('mode') === 'matrix') params.set('mode', 'matrix');
if (Astro.url.searchParams.get('view') === 'delta') params.set('class', 'Delta');
return Astro.redirect(`/standings?${params.toString()}`, 301);
