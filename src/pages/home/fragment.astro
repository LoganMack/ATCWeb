---
export const prerender = false;

import NewsCard from '../../components/NewsCard.astro';
import UpcomingEventCard from '../../components/UpcomingEventCard.astro';
import CarLogos from '../../components/CarLogos.astro';
import TeamLogo from '../../components/TeamLogo.astro';
import DriverFlag from '../../components/DriverFlag.astro';
import DriverLink from '../../components/DriverLink.astro';
import { getNewsPosts, resolveSupabaseEnv } from '../../lib/db/client';
import { getUpcomingEvents } from '../../lib/db/events';
import {
  getAllCircuitLayouts,
  getCircuitLogoBackgrounds,
  displayLayoutName,
  shortDriverName,
  formatDate,
} from '../../lib/db/circuits';
import { getScoringRulesets, getSeasons, type SeasonLogoPair } from '../../lib/db/seasons';
import { getDriverClasses } from '../../lib/db/lookups';
import { getStandingsExcludedRoundIds } from '../../lib/db/rounds';
import { getCarLogos } from '../../lib/db/assets';
import { getAllNewsPostTags, type NewsTag } from '../../lib/db/news';
import type { TeamSeasonStanding } from '../../lib/results/teamStandings';
import type { DriverSeasonExtras } from '../../lib/results/seasonCarTeam';
import { getTeamsBasic, getAllTeamSeasonLogosSafe, driversSelect } from '../../lib/results/rows';
import { loadHomeStandings, type StandingsViewRefs } from '../../lib/results/standingsView';
import { isChampionshipSeason } from '../../lib/results/shared';
import { getPreviousResultWidget } from '../../lib/results/previousResult';
import { getAllBroadcastVideos, getBroadcastRoundDetails } from '../../lib/results/broadcasts';
import type { DriverSeasonStanding } from '../../lib/results/standingsCore';
import { youtubeEmbedUrl } from '../../lib/siteSettings';
import { classTagFull } from '../../lib/classColors';
import { getReportingWindowForRound, getReportingPeriodHours, isReportingOpen, isRoundPosted } from '../../lib/incidentReports';

const supabaseEnv = resolveSupabaseEnv(Astro.locals);

// Fetch 16 rather than the 4 this page used to show: 1 goes into the new
// hero-row "latest story" slot, the other 15 fill the plain text "more news"
// list right below it (see the template below).
let latestNews: Awaited<ReturnType<typeof getNewsPosts>> = [];
let upcomingEvents: Awaited<ReturnType<typeof getUpcomingEvents>> = [];
// Just for eventImageUrl() below, so a layout's own image (once one's on
// file) takes priority over the circuit's generic logo on the "Next Up"
// card, same as everywhere else an event shows a circuit image.
let eventLayouts: Awaited<ReturnType<typeof getAllCircuitLayouts>> = [];
let logoBackgrounds: Awaited<ReturnType<typeof getCircuitLogoBackgrounds>> = {};
const loadTopSection = async () => {
  try {
    [latestNews, upcomingEvents, eventLayouts, logoBackgrounds] = await Promise.all([
      getNewsPosts(supabaseEnv, 16),
      getUpcomingEvents(supabaseEnv, 4),
      getAllCircuitLayouts(supabaseEnv),
      getCircuitLogoBackgrounds(supabaseEnv),
    ]);
  } catch (err) {
    // Supabase not configured yet / unreachable at build time — render the
    // page gracefully instead of failing the whole request.
    console.error('Failed to load homepage data:', err);
  }
};

// season_label on a post is freeform text (see NewsPost's own doc comment),
// not an FK to `seasons` — this is a best-effort name match so NewsCard can
// show that season's logo next to its tag, same as the champion cards do.
let seasons: Awaited<ReturnType<typeof getSeasons>> = [];
let logoBySeasonLabel = new Map<string, SeasonLogoPair>();
const loadSeasonLogos = async () => {
  try {
    seasons = await getSeasons(supabaseEnv);
    logoBySeasonLabel = new Map(
      seasons.filter((s) => s.logo_url).map((s) => [s.name, { dark: s.logo_url!, light: s.logo_url_light }])
    );
  } catch (err) {
    console.error('Failed to load seasons for news card logos:', err);
  }
};

// Bulk "fetch once, map by id", as news/index.astro does; only the featured post shows tags.
let tagsByPostId = new Map<string, NewsTag[]>();
const loadNewsTags = async () => {
  try {
    const links = await getAllNewsPostTags(supabaseEnv);
    for (const link of links) {
      if (!link.news_tags) continue;
      if (!tagsByPostId.has(link.post_id)) tagsByPostId.set(link.post_id, []);
      tagsByPostId.get(link.post_id)!.push(link.news_tags);
    }
  } catch (err) {
    console.error('Failed to load news tags for the featured news card:', err);
  }
};

// --- Previous Broadcast + hero banner: fetched with the other cheap loads, which all finish before the
// standings widget's costly fetches start, so the widget can't starve them of the subrequest budget. The
// broadcast is the latest race result with a broadcast link (getAllBroadcastVideos()[0]).
let previousBroadcast = null as Awaited<ReturnType<typeof getAllBroadcastVideos>>[number] | null;
let broadcastEmbedUrl: string | null = null;
// "ATC18: Round 3 at Charlotte Motor Speedway, Roval No Chicanes" — built
// from the broadcast's round (season label, display round number, track,
// layout); each piece is simply dropped when it isn't known.
let broadcastSubtitle = '';
const loadPreviousBroadcast = async () => {
  try {
    const videos = await getAllBroadcastVideos(supabaseEnv);
    previousBroadcast = videos[0] ?? null;
    broadcastEmbedUrl = previousBroadcast ? youtubeEmbedUrl(previousBroadcast.broadcast_url) : null;
    if (previousBroadcast && broadcastEmbedUrl) {
      const details = await getBroadcastRoundDetails(supabaseEnv, previousBroadcast.subsession_id, previousBroadcast.season_id);
      const trackAndLayout = [previousBroadcast.track_name, details.layout ? displayLayoutName(details.layout) : null]
        .filter(Boolean)
        .join(', ');
      const where = details.roundNumber !== null ? `Round ${details.roundNumber} at ${trackAndLayout}` : trackAndLayout;
      broadcastSubtitle = previousBroadcast.season_label ? `${previousBroadcast.season_label}: ${where}` : where;
    }
  } catch (err) {
    console.error('Failed to load previous broadcast:', err);
  }
};

// --- Previous Result card: styled like the Standings widget but for the latest round, with a session
// dropdown. getPreviousResultWidget() is cheap compared with the widget.
let previousResult = null as Awaited<ReturnType<typeof getPreviousResultWidget>>;
// The link beside "Full race result": the round's incident report once stewards
// have posted it, "Submit Incident Report" while the reporting window is still
// open, and nothing in between (window closed, report not posted yet).
let previousIncidentLink = null as { href: string; label: string } | null;
const loadPreviousResult = async () => {
  // The reporting period is read alongside the widget, and the posted flag alongside the window: two stages
  // where the link used to take four sequential reads (BR4.2).
  const [widget, hours] = await Promise.all([
    getPreviousResultWidget(supabaseEnv).catch((err) => {
      console.error('Failed to load previous result widget:', err);
      return null;
    }),
    getReportingPeriodHours(supabaseEnv),
  ]);
  previousResult = widget;
  if (!previousResult) return;
  try {
    const id = previousResult.subsessionId;
    const [posted, window] = await Promise.all([
      isRoundPosted(supabaseEnv, id),
      getReportingWindowForRound(supabaseEnv, id, previousResult.startTime, hours),
    ]);
    if (posted) {
      previousIncidentLink = { href: `/results/${id}/incidents`, label: 'Incident Report' };
    } else if (isReportingOpen(window)) {
      previousIncidentLink = { href: `/results/${id}?submit=incident`, label: 'Submit Incident Report' };
    }
  } catch (err) {
    console.error('Failed to work out the previous result incident link:', err);
  }
};

// The standings widget's reference reads are as cheap as the loads above, so they join them.
let standingsRefs = null as Omit<StandingsViewRefs, 'circuits' | 'layouts'> | null;
const loadStandingsRefs = async () => {
  try {
    const [classesResult, drivers, excludedIds, rulesets, teams, carLogos, seasonLogoRows] = await Promise.all([
      getDriverClasses(supabaseEnv),
      driversSelect(supabaseEnv),
      getStandingsExcludedRoundIds(supabaseEnv),
      getScoringRulesets(supabaseEnv),
      getTeamsBasic(supabaseEnv),
      getCarLogos(supabaseEnv),
      getAllTeamSeasonLogosSafe(supabaseEnv),
    ]);
    standingsRefs = { classes: classesResult, drivers, excludedIds, rulesets, teams, carLogos, seasonLogoRows };
  } catch (err) {
    console.error('Failed to load homepage standings widget:', err);
  }
};

// All independent, so they run concurrently; awaiting them before the standings widget's stored read keeps
// the ordering above.
await Promise.all([
  loadTopSection(),
  loadSeasonLogos(),
  loadNewsTags(),
  loadPreviousBroadcast(),
  loadPreviousResult(),
  loadStandingsRefs(),
]);

const featuredNews = latestNews[0] ?? null;
const moreNews = latestNews.slice(1, 16);

// The Previous Result card opens on the first race session, else the first session on file (Logan).
const defaultPreviousResultSessionKey =
  previousResult?.sessions.find((s) => s.key.startsWith('race-'))?.key ?? previousResult?.sessions[0]?.key ?? null;

// --- Top 5 standings widget: Overall, the three classes, and Alpha and Delta team standings. Every view is
// computed up front and switched with show/hide, so one season context (getSeasonOverallContext) is shared by
// every compute*Standings call.
type StandingsTab =
  | { key: string; label: string; type: 'driver'; rows: DriverSeasonStanding[] }
  | { key: string; label: string; type: 'team'; rows: TeamSeasonStanding[] };

let classes: Awaited<ReturnType<typeof getDriverClasses>> = [];
let standingsTabs: StandingsTab[] = [];
// Per-driver car/team logos for the driver-standings tabs (see
// getSeasonCarTeamStats' own doc comment) — keyed by driver id.
let carTeamExtrasByDriverId = new Map<string, DriverSeasonExtras>();
try {
  const championshipSeasons = seasons.filter((s) => isChampionshipSeason(s.name));
  const activeSeason = championshipSeasons.find((s) => s.is_current) ?? championshipSeasons[0];

  if (activeSeason && standingsRefs) {
    const refs: Omit<StandingsViewRefs, 'circuits' | 'layouts'> = standingsRefs;
    classes = refs.classes;
    const alphaClassId = classes.find((c) => c.name === 'Alpha')?.id;
    const deltaClassId = classes.find((c) => c.name === 'Delta')?.id;

    // Delta Team only when the current season runs that championship (0052; ATC10 onward).
    const teamTabDefs = [
      { key: 'alpha-team', label: 'Alpha Team', classId: alphaClassId },
      ...(activeSeason.delta_team_enabled ? [{ key: 'delta-team', label: 'Delta Team', classId: deltaClassId }] : []),
    ].filter((t): t is { key: string; label: string; classId: number } => t.classId !== undefined);

    // One stored read of the season feeds every tab (BR2.2); each class's own team competition, as before.
    const home = await loadHomeStandings(supabaseEnv, activeSeason, teamTabDefs.map((t) => t.classId), refs);
    carTeamExtrasByDriverId = home.extras;

    standingsTabs = [
      { key: 'overall', label: 'Overall', type: 'driver', rows: home.overall.slice(0, 5) },
      ...classes.map((c) => ({
        key: c.name,
        label: c.name,
        type: 'driver' as const,
        rows: (home.byClass.find((b) => b.classId === c.id)?.rows ?? []).slice(0, 5),
      })),
      ...teamTabDefs.map((t) => ({
        key: t.key,
        label: t.label,
        type: 'team' as const,
        rows: (home.teams.find((h) => h.classId === t.classId)?.rows ?? []).slice(0, 5),
      })),
    ];
  }
} catch (err) {
  console.error('Failed to load homepage standings widget:', err);
}

// Cache this on Cloudflare's edge for a minute so most visits are served
// instantly, while still picking up Supabase edits within ~60s.
Astro.response.headers.set('Cache-Control', 'public, s-maxage=60, stale-while-revalidate=300');
---

    <div class="mx-auto mt-6 grid max-w-6xl gap-12 lg:grid-cols-2 lg:items-start lg:gap-16">
      <!-- min-w-0 on both grid columns: a grid item's `min-width: auto` takes a `w-full` image's
           intrinsic size, which pushed the page wider than the viewport on mobile. -->
      <div class="min-w-0">
        <!-- The page's one <h1>, styled like the Standings heading. -->
        <h1 class="sr-only">Featured Story</h1>

        {featuredNews ? (
          <NewsCard
            post={featuredNews}
            index={0}
            sizes="(min-width: 1024px) 520px, calc(100vw - 48px)"
            logoBySeasonLabel={logoBySeasonLabel}
            tagsByPostId={tagsByPostId}
          />
        ) : (
          <p class="reveal text-sm text-white/50" style="transition-delay: 80ms">
            No news yet.
          </p>
        )}

        <!-- Hidden on mobile only (Logan) — same sm: breakpoint Nav.astro's
             own mobile/desktop split uses. -->
        <div class="mt-12 hidden sm:block">
          <h2 class="mb-6 font-display text-3xl">More News</h2>

          {moreNews.length === 0 ? (
            <p class="text-sm text-white/50">No more news yet.</p>
          ) : (
            <>
              <ul class="divide-y divide-white/10">
                {moreNews.map((post) => (
                  <li>
                    <a
                      href={`/news/${post.slug}`}
                      class="flex items-baseline justify-between gap-4 py-3 text-white/80 transition hover:text-white"
                    >
                      <span class="truncate font-semibold">{post.title}</span>
                      <span class="flex-none text-xs text-white/40">{formatDate(post.published_at)}</span>
                    </a>
                  </li>
                ))}
              </ul>
              <a href="/news" class="mt-4 inline-block text-sm text-white/60 hover:text-white">View all &rarr;</a>
            </>
          )}
        </div>
      </div>

      <div class="min-w-0">
        <h2 class="sr-only">Upcoming Events</h2>

        {upcomingEvents.length === 0 && (
          <p class="reveal text-sm text-white/50" style="transition-delay: 80ms">
            No results.
          </p>
        )}

        <div class="space-y-3">
          {upcomingEvents.map((event, i) => <UpcomingEventCard event={event} featured={i === 0} index={i} layouts={eventLayouts} logoBackgrounds={logoBackgrounds} />)}
        </div>

        {upcomingEvents.length > 0 && (
          <div class="reveal mt-4 flex flex-wrap items-center gap-4" style={`transition-delay: ${80 + upcomingEvents.length * 60}ms`}>
            <a href="/calendar" class="text-sm text-white/60 hover:text-white">
              Full calendar &rarr;
            </a>
          </div>
        )}

        <div class="mt-12">
          {!previousResult ? (
            <>
              <h2 class="mb-6 font-display text-3xl">Previous Result</h2>
              <p class="text-sm text-white/50">No results yet.</p>
            </>
          ) : (
            <>
              {previousResult.sessions.length === 0 ? (
                <>
                  <h2 class="mb-6 font-display text-3xl">Previous Result</h2>
                  <p class="text-sm text-white/50">No classified results yet.</p>
                </>
              ) : (
                <div data-previous-result-widget>
                  <!-- Title left, filters right (Logan): a session dropdown and, per session, its own
                       result-type <select> (team tabs exist only on races); JS shows the active one, as
                       in the Standings widget. -->
                  <div class="flex flex-wrap items-center justify-between gap-3">
                    <h2 class="font-display text-3xl">Previous Result</h2>

                    <div class="flex flex-wrap justify-end gap-2">
                      <select
                        data-session-select
                        class="rounded-lg border border-white/15 bg-white/5 px-3 py-1.5 text-xs font-semibold text-white outline-none transition hover:bg-white/10 focus:border-brand-primary"
                      >
                        {previousResult.sessions.map((session) => (
                          <option value={session.key} selected={session.key === defaultPreviousResultSessionKey} class="bg-brand-ink text-white">
                            {session.label}
                          </option>
                        ))}
                      </select>

                      {previousResult.sessions.map((session) => (
                        <select
                          data-result-type-select
                          data-session={session.key}
                          class={`rounded-lg border border-white/15 bg-white/5 px-3 py-1.5 text-xs font-semibold text-white outline-none transition hover:bg-white/10 focus:border-brand-primary ${session.key === defaultPreviousResultSessionKey ? '' : 'hidden'}`}
                        >
                          {session.tabs.map((tab, j) => (
                            <option value={tab.key} selected={j === 0} class="bg-brand-ink text-white">
                              {tab.label}
                            </option>
                          ))}
                        </select>
                      ))}
                    </div>
                  </div>

                  <div class="mt-4 overflow-hidden rounded-xl border border-white/10 bg-brand-ink">
                    {previousResult.sessions.map((session) => (
                      <div data-session-panel={session.key} class={session.key === defaultPreviousResultSessionKey ? '' : 'hidden'}>
                        {session.tabs.map((tab, j) => (
                          <ol data-result-panel={tab.key} class={j === 0 ? '' : 'hidden'}>
                            {tab.rows.length === 0 ? (
                              <li class="p-4 text-sm text-white/50">No results yet.</li>
                            ) : tab.type === 'driver' ? (
                              tab.rows.map((row) => {
                                const rowClassName = row.classId != null ? classes.find((c) => c.id === row.classId)?.name : undefined;
                                return (
                                  <li class="flex items-center gap-3 border-b border-white/5 px-4 py-3 last:border-none">
                                    <span class="w-5 flex-none text-center font-display text-lg text-white/50">{row.position ?? '—'}</span>
                                    {/* "F. Lastname": this card is narrow at every width. */}
                                    <span class="min-w-0 flex-1 truncate font-semibold">
                                      <DriverLink id={row.driver.id} hidden={row.driver.is_hidden}>{shortDriverName(row.driver.name)}</DriverLink>
                                      {row.driver.car_number !== null && <span class="text-white/40"> #{row.driver.car_number}</span>}
                                    </span>
                                    {/* Flag / car / team sit in FIXED-WIDTH slots, same as ResultsTable.astro's row: a driver with no flag, car or team still gets an empty slot, so everything else lines up row to row. Car/team logos hidden on mobile (Logan) — this card is narrow enough that they crowd the row. */}
                                    <span class="flex h-5 w-6 flex-none items-center justify-center">
                                      <DriverFlag nationality1={row.driver.nationality_1} nationality2={row.driver.nationality_2} />
                                    </span>
                                    <span class="hidden h-5 w-5 flex-none items-center justify-center sm:flex">
                                      {row.car && <TeamLogo name={row.car.name} logoUrl={row.car.logoUrl} size="h-5 w-5" tint />}
                                    </span>
                                    <span class="hidden h-5 w-5 flex-none items-center justify-center sm:flex">
                                      {row.team && <TeamLogo name={row.team.name} logoUrl={row.team.logoUrl} size="h-5 w-5" />}
                                    </span>
                                    {rowClassName && (
                                      <span class={classTagFull(rowClassName)}>
                                        {rowClassName}
                                      </span>
                                    )}
                                    <span class="w-[4.5rem] flex-none text-right text-sm tabular-nums text-white/60">{row.metricLabel}</span>
                                  </li>
                                );
                              })
                            ) : (
                              tab.rows.map((row) => (
                                <li class="flex items-center gap-3 border-b border-white/5 px-4 py-3 last:border-none">
                                  <span class="w-5 flex-none text-center font-display text-lg text-white/50">{row.position}</span>
                                  <TeamLogo name={row.teamName} logoUrl={row.teamLogoUrl} size="h-6 w-6" />
                                  <span class="min-w-0 flex-1 truncate font-semibold">{row.teamName}</span>
                                  <span class="w-[4.5rem] flex-none text-right text-sm tabular-nums text-white/60">{row.points} pts</span>
                                </li>
                              ))
                            )}
                          </ol>
                        ))}
                      </div>
                    ))}
                  </div>
                </div>
              )}
            </>
          )}

          {previousResult && (
            <div class="mt-4 flex flex-wrap items-center gap-x-5 gap-y-1 text-sm">
              <a href={`/results/${previousResult.subsessionId}`} class="text-white/60 hover:text-white">
                Full race result &rarr;
              </a>
              {previousIncidentLink && (
                <a href={previousIncidentLink.href} class="text-white/60 hover:text-white">
                  {previousIncidentLink.label} &rarr;
                </a>
              )}
            </div>
          )}
        </div>

        <div class="mt-12">
        {standingsTabs.length === 0 ? (
          <>
            <h2 class="mb-6 font-display text-3xl">Standings</h2>
            <p class="text-sm text-white/50">No standings yet.</p>
          </>
        ) : (
          <div data-standings-widget>
            <!-- Title left, filter right (Logan). Client-side show/hide only, so no request and no
                 progress bar. -->
            <div class="flex flex-wrap items-center justify-between gap-3">
              <h2 class="font-display text-3xl">Standings</h2>
              <div class="flex flex-wrap justify-end gap-2">
              <select
                data-standings-select
                class="rounded-lg border border-white/15 bg-white/5 px-3 py-1.5 text-xs font-semibold text-white outline-none transition hover:bg-white/10 focus:border-brand-primary"
              >
                {standingsTabs.map((tab, i) => (
                  <option value={tab.key} selected={i === 0} class="bg-brand-ink text-white">
                    {tab.label}
                  </option>
                ))}
              </select>
              </div>
            </div>

            <div class="mt-4 overflow-hidden rounded-xl border border-white/10 bg-brand-ink">
              {standingsTabs.map((tab, i) => (
                <ol data-standings-panel={tab.key} class={i === 0 ? '' : 'hidden'}>
                  {tab.rows.length === 0 ? (
                    <li class="p-4 text-sm text-white/50">No results yet.</li>
                  ) : tab.type === 'driver' ? (
                    tab.rows.map((row) => {
                      const rowClassName = row.classId != null ? classes.find((c) => c.id === row.classId)?.name : undefined;
                      // Only the primary (most-raced) car and team, to keep rows compact.
                      const extras = carTeamExtrasByDriverId.get(row.driver.id);
                      const primaryTeam = extras?.teams[0];
                      return (
                        <li class="flex items-center gap-3 border-b border-white/5 px-4 py-3 last:border-none">
                          <span class="w-5 flex-none text-center font-display text-lg text-white/50">{row.position}</span>
                          {/* Same short-name treatment as the Previous Result widget's driver rows above — narrow fixed-width card. */}
                          <span class="min-w-0 flex-1 truncate font-semibold">
                            <DriverLink id={row.driver.id} hidden={row.driver.is_hidden}>{shortDriverName(row.driver.name)}</DriverLink>
                            {row.driver.car_number !== null && <span class="text-white/40"> #{row.driver.car_number}</span>}
                          </span>
                          {/* Same fixed-width flag / car / team slots as the Previous Result widget's driver rows above (car/team hidden on mobile). */}
                          <span class="flex h-5 w-6 flex-none items-center justify-center">
                            <DriverFlag nationality1={row.driver.nationality_1} nationality2={row.driver.nationality_2} />
                          </span>
                          <span class="hidden h-5 w-5 flex-none items-center justify-center sm:flex">
                            {extras && extras.cars.length > 0 && <CarLogos cars={extras.cars} size="h-5 w-5" />}
                          </span>
                          <span class="hidden h-5 w-5 flex-none items-center justify-center sm:flex">
                            {primaryTeam && <TeamLogo name={primaryTeam.teamName} logoUrl={primaryTeam.logoUrl} size="h-5 w-5" />}
                          </span>
                          {rowClassName && (
                            <span class={classTagFull(rowClassName)}>
                              {rowClassName}
                            </span>
                          )}
                          <span class="w-[4.5rem] flex-none text-right text-sm tabular-nums text-white/60">{row.totalPoints} pts</span>
                        </li>
                      );
                    })
                  ) : (
                    tab.rows.map((row) => (
                      <li class="flex items-center gap-3 border-b border-white/5 px-4 py-3 last:border-none">
                        <span class="w-5 flex-none text-center font-display text-lg text-white/50">{row.position}</span>
                        <TeamLogo name={row.teamName} logoUrl={row.logoUrl} size="h-6 w-6" />
                        <span class="min-w-0 flex-1 truncate font-semibold">{row.teamName}</span>
                        <span class="w-[4.5rem] flex-none text-right text-sm tabular-nums text-white/60">{row.totalPoints} pts</span>
                      </li>
                    ))
                  )}
                </ol>
              ))}
            </div>
          </div>
        )}

        <a href="/standings" class="mt-4 inline-block text-sm text-white/60 hover:text-white">Full standings &rarr;</a>
      </div>
    </div>
    </div>

    {broadcastEmbedUrl && previousBroadcast && (
      <div class="mx-auto mt-16 max-w-6xl">
        <h2 class="font-display text-3xl">Previous Broadcast</h2>
        <p class="mb-6 mt-1 text-sm text-white/50">
          {broadcastSubtitle}
        </p>
        <div class="aspect-video w-full overflow-hidden rounded-xl border border-white/10 bg-black">
          <iframe
            class="h-full w-full"
            src={broadcastEmbedUrl}
            title="Previous Broadcast"
            loading="lazy"
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
            allowfullscreen
          ></iframe>
        </div>
        <a href={`/results/${previousBroadcast.subsession_id}`} class="mt-3 inline-block text-sm text-white/60 hover:text-white">
          Full race result &rarr;
        </a>
      </div>
    )}
