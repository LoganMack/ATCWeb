---
export const prerender = false;
import LoadError from '../../../components/LoadError.astro';
import TeamLogo from '../../../components/TeamLogo.astro';
import { markUncacheable } from '../../../lib/security';
import { resolveSupabaseEnv } from '../../../lib/db/client';
import { linePath, type LineupBoard, type Seat } from '../../../lib/lineups/board';
import { loadLineups } from '../../../lib/lineups/load';

/**
 * Lineup Changes for the advanced-stats.astro shell (U9, design A): the board from 768px up, team cards below
 * that, or one message. All data comes from loadLineups; driver ids stay on the server, so seats carry only a
 * board-local key and a profile link for visible drivers. The highlight is src/scripts/lineupBoard.ts, which
 * the shell imports (a script in fetched fragment HTML never runs). Never linked directly.
 */

const supabaseEnv = resolveSupabaseEnv(Astro.locals);

let loadError: string | null = null;
let board: LineupBoard = { kind: 'message', text: '' };
try {
  board = await loadLineups(supabaseEnv, Astro.url.searchParams.get('season'));
} catch (err) {
  console.error('Failed to load the lineups (fragment):', err);
  loadError = err instanceof Error ? err.message : String(err);
}

// A team colour reaches markup only as this validated custom property (BR1.20); fallbacks use the --fg token.
const teamStyle = (colour: string | null) => (colour ? `--team:${colour}` : undefined);
const stripe = 'self-stretch border-[color:var(--team,rgb(var(--fg)/0.2))]';
const tagClass = 'flex-none rounded-md border border-white/15 px-1.5 text-xs text-white/70';
const fade = 'motion-safe:transition-opacity motion-safe:duration-150';
// A changed driver with no profile link still needs a keyboard stop for the highlight (NFR5.1).
const seatTabIndex = (seat: Seat) => (seat.key && !seat.href ? '0' : undefined);

Astro.response.headers.set('Cache-Control', 'public, s-maxage=60, stale-while-revalidate=300');
if (loadError) markUncacheable(Astro);
---

{loadError && <LoadError />}

{!loadError && (
  <section class="mt-8" aria-labelledby="lineups-heading" data-lineups>
    <h2 id="lineups-heading" class="font-display text-2xl sm:text-3xl">Lineup Changes</h2>

    {board.kind === 'message' && <p class="mt-6 text-white/60" data-testid="lineups-message">{board.text}</p>}

    {board.kind === 'board' && (
      <>
        <figure class="mt-6 hidden md:block" data-lineup-board>
          <p class="h-5 text-sm text-white/80" aria-hidden="true" data-lineup-label></p>
          <div class="mt-2 grid grid-cols-[minmax(0,1fr)_3rem_minmax(0,1fr)] lg:grid-cols-[minmax(0,1fr)_6rem_minmax(0,1fr)]">
            <h3 class="col-start-1 row-start-1 mb-2 font-display text-xl">{board.previousLabel}</h3>
            <h3 class="col-start-3 row-start-1 mb-2 text-right font-display text-xl">{board.currentLabel}</h3>
            {[
              { side: 'left', label: board.previousLabel, column: board.left },
              { side: 'right', label: board.currentLabel, column: board.right },
            ].map(({ side, label, column }) => (
              <ul
                aria-label={`${label} lineups`}
                class:list={['row-start-2', side === 'left' ? 'col-start-1' : 'col-start-3']}
              >
                {column.groups.map((group) => (
                  <li data-group style={teamStyle(group.colour)} class="mt-3 first:mt-0">
                    {group.kind !== 'team' && (
                      <p class="flex h-9 items-center px-2 text-xs font-semibold uppercase tracking-wide text-white/60">
                        {group.name}
                      </p>
                    )}
                    <ul aria-label={group.name}>
                      {group.seats.map((seat, i) => (
                        <li
                          data-seat
                          data-key={seat.key ?? undefined}
                          data-label={seat.label || undefined}
                          tabindex={seatTabIndex(seat)}
                          class:list={[
                            'list-row flex h-9 items-center gap-2 px-2',
                            fade,
                            seat.status === 'stayed' && 'text-white/60',
                          ]}
                        >
                          {side === 'left' && (
                            <span
                              aria-hidden="true"
                              class:list={[stripe, 'border-l-4', seat.status === 'stayed' && 'opacity-40']}
                            ></span>
                          )}
                          {group.kind === 'team' && i === 0 ? (
                            <TeamLogo name={group.name} logoUrl={group.logoUrl} size="h-6 w-6" />
                          ) : (
                            <span class="h-6 w-6 flex-none" aria-hidden="true"></span>
                          )}
                          <span class="w-7 flex-none text-right tabular-nums text-white/60">{seat.number ?? ''}</span>
                          <span class="min-w-0 truncate">
                            {seat.href ? (
                              <a href={seat.href} class="driver-link" title="Click to view profile">{seat.name}</a>
                            ) : (
                              seat.name
                            )}
                          </span>
                          {seat.srText && <span class="sr-only">{seat.srText}</span>}
                          {group.kind === 'joined' && seat.tag === 'returning' && <span class={tagClass}>returning</span>}
                          {group.kind === 'team' && i === 0 && (
                            <span class="ml-auto min-w-0 truncate text-xs text-white/60" title={group.name}>{group.name}</span>
                          )}
                          {side === 'right' && (
                            <span
                              aria-hidden="true"
                              class:list={[stripe, 'border-r-4', group.kind === 'team' && i === 0 ? 'ml-2' : 'ml-auto', seat.status === 'stayed' && 'opacity-40']}
                            ></span>
                          )}
                        </li>
                      ))}
                    </ul>
                  </li>
                ))}
              </ul>
            ))}
            <div class="relative col-start-2 row-start-2" aria-hidden="true">
              <svg
                aria-hidden="true"
                class="absolute inset-0 h-full w-full"
                viewBox={`0 0 100 ${board.height}`}
                preserveAspectRatio="none"
              >
                {board.lines.map((line) => (
                  <path
                    data-line={line.key}
                    d={linePath(line)}
                    fill="none"
                    stroke-width="2"
                    stroke-dasharray={line.dashed ? '4 4' : undefined}
                    vector-effect="non-scaling-stroke"
                    style={teamStyle(line.colour)}
                    class:list={['stroke-[color:var(--team,rgb(var(--fg)/0.3))]', fade]}
                  />
                ))}
              </svg>
            </div>
          </div>
          <figcaption class="mt-4 text-sm text-white/60">{board.summary}</figcaption>
        </figure>

        <div class="mt-6 space-y-3 md:hidden" data-lineup-cards>
          {board.cards.map((card) => (
            <section
              style={teamStyle(card.colour)}
              class="rounded-xl border border-t-4 border-white/10 border-t-[color:var(--team,rgb(var(--fg)/0.2))] bg-white/[0.02] p-3"
            >
              <h3 class="flex items-center gap-2 font-semibold">
                <TeamLogo name={card.name} logoUrl={card.logoUrl} size="h-6 w-6" />
                <span class="min-w-0 truncate">{card.name}</span>
              </h3>
              <ul class="mt-2 space-y-1 text-sm">
                {card.seats.map((seat) => (
                  <li class:list={['flex items-center gap-2', seat.status === 'stayed' && 'text-white/60']}>
                    <span class="w-8 flex-none tabular-nums text-white/60">{seat.number !== null ? `#${seat.number}` : ''}</span>
                    <span class="min-w-0 truncate">
                      {seat.href ? <a href={seat.href} class="driver-link">{seat.name}</a> : seat.name}
                    </span>
                    {seat.tag && <span class={tagClass}>{seat.tag}</span>}
                  </li>
                ))}
              </ul>
            </section>
          ))}
          {board.leftCard.length > 0 && (
            <section class="rounded-xl border border-t-4 border-white/10 border-t-white/20 bg-white/[0.02] p-3">
              <h3 class="font-semibold">Left ATC</h3>
              <ul class="mt-2 space-y-1 text-sm">
                {board.leftCard.map((seat) => (
                  <li class="flex items-center gap-2">
                    <span class="w-8 flex-none tabular-nums text-white/60">{seat.number !== null ? `#${seat.number}` : ''}</span>
                    <span class="min-w-0 truncate">
                      {seat.href ? <a href={seat.href} class="driver-link">{seat.name}</a> : seat.name}
                    </span>
                    {seat.tag && <span class={tagClass}>{seat.tag}</span>}
                  </li>
                ))}
              </ul>
            </section>
          )}
          <p class="text-sm text-white/60">{board.summary}</p>
        </div>
      </>
    )}
  </section>
)}
