---
export const prerender = false;
import LoadError from '../../../components/LoadError.astro';
import { markUncacheable, safeJson } from '../../../lib/security';

import { resolveSupabaseEnv } from '../../../lib/db/client';
import {
  getRatingTimeline,
  getSeriesRatings,
  MIN_RATED_RACES,
  RATING_KIND_LABELS,
  RATING_KIND_PARAMS,
  resolveRatingKind,
  type SeriesRatingRow,
} from '../../../lib/db/seriesRatings';
import { TREND_HEIGHT, TREND_WIDTH, trendLine } from '../../../lib/rating/trend';
import type { TimelineSlot } from '../../../lib/rating/timeline';

/**
 * Series iRating's table for the advanced-stats.astro shell (FR7; NFR1, NFR2): one rating kind read from the
 * masked view, drivers with at least MIN_RATED_RACES races only, at most 20 trend values per driver, no rating
 * maths here. Hidden drivers arrive masked ("Hidden Driver", no id), so they get no link. Sorting, the search
 * box in the shell's filter card and each row's history chart (fetched from advanced-stats/ratings/history
 * when the row opens) run in the browser (src/scripts/seriesRatings.ts). It also embeds the shared round slot
 * list for the charts, read with the list; either read failing fails the fragment. Never linked directly.
 */

const supabaseEnv = resolveSupabaseEnv(Astro.locals);
const kind = resolveRatingKind(Astro.url.searchParams.get('class'));

let loadError: string | null = null;
let rows: SeriesRatingRow[] = [];
let timeline: TimelineSlot[] = [];
try {
  const [list, slots] = await Promise.all([getSeriesRatings(supabaseEnv, kind), getRatingTimeline(supabaseEnv)]);
  rows = list;
  timeline = slots;
} catch (err) {
  console.error('Failed to load the Series iRating (fragment):', err);
  loadError = err instanceof Error ? err.message : String(err);
}

const signed = (n: number) => (n > 0 ? `+${n}` : n < 0 ? `−${Math.abs(n)}` : '0');
const headers = [
  { key: 'rank', label: '#', numeric: true },
  { key: 'name', label: 'Driver', numeric: false },
  { key: 'current', label: 'iRating', numeric: true },
  { key: 'last', label: 'Last', numeric: true },
  { key: 'min', label: 'Min', numeric: true },
  { key: 'max', label: 'Max', numeric: true },
  { key: 'races', label: 'Races', numeric: true },
];
const columns = headers.length + 2;

Astro.response.headers.set('Cache-Control', 'public, s-maxage=60, stale-while-revalidate=300');
if (loadError) markUncacheable(Astro);
---

{loadError && <LoadError />}

{!loadError && (
  <section
    class="mt-8"
    aria-labelledby="series-rating-heading"
    data-series-ratings
    data-rating-class={RATING_KIND_PARAMS[kind] ?? ''}
    data-rating-kind-label={RATING_KIND_LABELS[kind]}
  >
    <h2 id="series-rating-heading" class="font-display text-2xl sm:text-3xl">Series iRating</h2>

    {rows.length === 0 && (
      <p class="mt-6 text-white/60" data-testid="ratings-empty">No driver has {MIN_RATED_RACES} rated races in this class yet.</p>
    )}

    {rows.length > 0 && (
      <>
        <p class="sr-only" role="status" aria-live="polite" data-rating-count></p>
        <p class="mt-4 hidden text-white/60" data-rating-no-match>
          <span data-rating-no-match-text></span>
          <button type="button" class="btn btn-sm ml-2" data-rating-clear>Clear search</button>
        </p>
        <div class="mt-4 overflow-x-auto rounded-xl border border-white/10" data-rating-table-wrap>
          <table class="data-table w-full min-w-[680px] text-sm" aria-labelledby="series-rating-heading" data-rating-table>
            <thead>
              <tr class="border-b border-white/10 text-xs uppercase tracking-wide text-white/60">
                <th scope="col" class="w-8 px-1 py-2"><span class="sr-only">Rating history</span></th>
                {headers.map((h) => (
                  <th
                    scope="col"
                    class:list={['px-2 py-2 font-semibold', h.numeric ? 'text-right' : 'text-left', h.key === 'name' && 'sticky left-0 z-10 bg-brand-ink']}
                    aria-sort={h.key === 'current' ? 'descending' : 'none'}
                    data-sort-col={h.key}
                  >
                    <button type="button" class="rounded-md border border-transparent px-1 py-0.5 uppercase outline-none hover:bg-white/5 focus:border-brand-primary" data-sort={h.key}>
                      {h.label}
                    </button>
                  </th>
                ))}
                <th scope="col" class="px-2 py-2 text-left font-semibold">Trend (last 20)</th>
              </tr>
            </thead>
            <tbody>
              {rows.map((row, i) => {
                const trend = trendLine(row.trend);
                const detailId = `rating-history-${i + 1}`;
                return (
                  <>
                    <tr
                      class="border-b border-white/5 last:border-0"
                      data-rating-row
                      data-key={row.key}
                      data-rank={i + 1}
                      data-name={row.name}
                      data-current={row.current}
                      data-last={row.lastChange}
                      data-min={row.minimum}
                      data-max={row.maximum}
                      data-races={row.races}
                    >
                      <td class="px-1 py-1.5 text-center">
                        <button
                          type="button"
                          class="inline-flex h-7 w-7 items-center justify-center rounded-md border border-transparent text-white/60 outline-none hover:bg-white/5 focus:border-brand-primary"
                          aria-expanded="false"
                          aria-controls={detailId}
                          aria-label={`Rating history for ${row.name}`}
                          data-rating-toggle
                        >
                          <span data-chevron class="inline-block text-[9px] motion-safe:transition-transform motion-safe:duration-150" aria-hidden="true">&#9654;</span>
                        </button>
                      </td>
                      <td class="px-2 py-1.5 text-right font-display text-base" data-rank-cell>{i + 1}</td>
                      <th scope="row" class="sticky left-0 z-10 bg-brand-ink px-2 py-1.5 text-left font-normal">
                        {row.driverId ? <a href={`/drivers/${row.driverId}`} class="driver-link" title="Click to view profile">{row.name}</a> : <span>{row.name}</span>}
                      </th>
                      <td class="px-2 py-1.5 text-right font-semibold tabular-nums">{row.current}</td>
                      <td class:list={['px-2 py-1.5 text-right tabular-nums', row.lastChange > 0 && 'text-brand-blue', row.lastChange < 0 && 'text-brand-pink']}>{signed(row.lastChange)}</td>
                      <td class="px-2 py-1.5 text-right tabular-nums text-white/60">{row.minimum}</td>
                      <td class="px-2 py-1.5 text-right tabular-nums text-white/60">{row.maximum}</td>
                      <td class="px-2 py-1.5 text-right tabular-nums">{row.races}</td>
                      <td class="px-2 py-1.5">
                        <svg
                          width={TREND_WIDTH}
                          height={TREND_HEIGHT}
                          viewBox={`0 0 ${TREND_WIDTH} ${TREND_HEIGHT}`}
                          role="img"
                          aria-label={trend.label}
                          data-trend={trend.direction}
                        >
                          {trend.runs.map((run) => (
                            <polyline points={run.points} class={run.direction === 'down' ? 'text-brand-pink' : 'text-brand-blue'} data-dir={run.direction} fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" stroke-linecap="round" />
                          ))}
                          {trend.dot && <circle cx={trend.dot.x} cy={trend.dot.y} r="1.5" class="text-brand-blue" fill="currentColor" />}
                        </svg>
                      </td>
                    </tr>
                    <tr id={detailId} hidden data-no-stripe data-rating-detail>
                      <td colspan={columns} class="px-3 py-3">
                        <div data-rating-chart></div>
                      </td>
                    </tr>
                  </>
                );
              })}
            </tbody>
          </table>
        </div>
        <script type="application/json" id="rating-timeline" data-rating-timeline set:html={safeJson(timeline)} />
      </>
    )}
  </section>
)}
