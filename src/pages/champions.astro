---
export const prerender = false;
import LoadError from '../components/LoadError.astro';
import { markUncacheable } from '../lib/security';

import Layout from '../layouts/Layout.astro';
import HistoryTabs from '../components/HistoryTabs.astro';
import PageBanner from '../components/PageBanner.astro';
import { resolveSupabaseEnv } from '../lib/db/client';
import { getDriverClasses } from '../lib/db/lookups';
import { getSeasons } from '../lib/db/seasons';
import { getPageBanners } from '../lib/db/assets';
import { bannerUrlFor } from '../lib/pageBanners';

// Shell: fetches only classes and seasons for the filter tabs and renders a skeleton; the cards come from
// champions/fragment.astro after this paints.

const supabaseEnv = resolveSupabaseEnv(Astro.locals);

// Started now and awaited when needed, so the banner fetch overlaps the rest.
const pageBannersPromise = getPageBanners(supabaseEnv);

let classes: Awaited<ReturnType<typeof getDriverClasses>> = [];
let seasons: Awaited<ReturnType<typeof getSeasons>> = [];
// The real error message, not a boolean: these tables have narrower grants (00041_champions.sql), so RLS
// problems need telling apart.
let loadError: string | null = null;
try {
  [classes, seasons] = await Promise.all([getDriverClasses(supabaseEnv), getSeasons(supabaseEnv)]);
} catch (err) {
  console.error('Failed to load champions page filters:', err);
  loadError = err instanceof Error ? err.message : String(err);
}

// Gamma/Delta exist only in seasons that enable them (0037): a class tab shows if any season does, and its
// champions only cover those seasons. Alpha is in every championship season.
function classIsEnabledFor(className: string, season: Awaited<ReturnType<typeof getSeasons>>[number]): boolean {
  if (className === 'Gamma') return season.gamma_enabled;
  if (className === 'Delta') return season.delta_enabled;
  return true;
}
const visibleClasses = classes.filter((c) => seasons.some((s) => classIsEnabledFor(c.name, s)));

// Defaults to Alpha. Class switching is a real navigation (?class=Gamma)
// rather than a client-side toggle — computing a season's standings isn't
// free, so it only happens for the class actually being viewed.
const requestedClassName = Astro.url.searchParams.get('class');
const activeClass =
  visibleClasses.find((c) => c.name === requestedClassName) ?? visibleClasses.find((c) => c.name === 'Alpha') ?? visibleClasses[0];

// Team champion filters: "Alpha Team" is the class-blind overall team competition (relabelled, Logan), "Delta
// Team" that class's own. Plain links (?team=), exclusive with `class`. Gated on delta_team_enabled (the team
// championship began at ATC10), not delta_enabled.
const deltaEnabledAnySeason = seasons.some((s) => s.delta_team_enabled);
const requestedTeam = Astro.url.searchParams.get('team');
const activeTeamView: 'alpha' | 'delta' | null =
  requestedTeam === 'delta' && deltaEnabledAnySeason ? 'delta' : requestedTeam === 'alpha' ? 'alpha' : null;

let bannerUrl: string | null = null;
try {
  bannerUrl = bannerUrlFor(await pageBannersPromise, 'champions');
} catch (err) {
  console.error('Failed to load page banner:', err);
}

Astro.response.headers.set('Cache-Control', 'public, s-maxage=60, stale-while-revalidate=300');
if (loadError) markUncacheable(Astro);
---

<Layout title="Champions" description="Past Alpha Touring Challenge season champions.">
  <section class="relative mx-auto max-w-5xl overflow-hidden px-6 pb-24 pt-8">
    <PageBanner imageUrl={bannerUrl} />
    <h1 class="reveal font-display text-2xl sm:text-5xl">Champions</h1>

    {loadError && <LoadError />}

    {!loadError && (
      <div class="reveal mt-12 relative z-30 rounded-xl border border-white/10 bg-brand-ink p-4">
       <div class="flex flex-wrap items-end gap-3">
        <HistoryTabs active="champions" />
        {/* Each option's value is its destination URL; onchange just navigates there. */}
        <label class="flex flex-col gap-1.5 sm:w-44">
        <span class="text-xs font-semibold uppercase tracking-wide text-white/40">Class</span>
        <select aria-label="Class or team" class="h-9 w-full rounded-md border border-white/15 bg-transparent px-3 text-sm text-white outline-none hover:bg-white/5 focus:border-brand-primary focus:bg-white/5" data-navigate-on-change>
          {visibleClasses.map((c) => (
            <option value={`/champions?class=${encodeURIComponent(c.name)}`} selected={!activeTeamView && c.id === activeClass?.id} class="bg-brand-ink text-white">{c.name}</option>
          ))}
          <option value="/champions?team=alpha" selected={activeTeamView === 'alpha'} class="bg-brand-ink text-white">Alpha Team</option>
          {deltaEnabledAnySeason && (
            <option value="/champions?team=delta" selected={activeTeamView === 'delta'} class="bg-brand-ink text-white">Delta Team</option>
          )}
        </select>
        </label>
       </div>
      </div>
    )}

    {!loadError && (
      <div data-champions-results data-fragment-url={`/champions/fragment${Astro.url.search}`}>
        <div class="mt-6 flex flex-col gap-5" aria-live="polite" aria-busy="true">
          <span class="sr-only">Loading champions…</span>
          <div class="h-40 animate-pulse rounded-xl border border-white/10 bg-white/[0.03]"></div>
          <div class="h-40 animate-pulse rounded-xl border border-white/10 bg-white/[0.03]"></div>
          <div class="h-40 animate-pulse rounded-xl border border-white/10 bg-white/[0.03]"></div>
        </div>
      </div>
    )}
  </section>
</Layout>

<script>
  import { bindFragment } from '../scripts/fragmentLoader';

  // Runs on every soft navigation, including switching class/team tabs: those
  // are real ?class=/?team= navigations, each landing with its own skeleton.
  // This page never re-dispatches astro:page-load, so the URL is left in place.
  bindFragment('[data-champions-results]', {
    label: 'Champions',
    logMessage: 'Failed to load champions results:',
    errorHtml: '<p class="mt-10 text-white/60">Couldn’t load champions right now — try refreshing the page.</p>',
    reveal: true,
    clearUrl: false,
    dispatch: false,
  });

  // Loads a champion's season the first time their card opens (expandRows.ts toggles it). Delegated and bound
  // once because the cards arrive in the fragment; reads aria-expanded after a tick so listener order doesn't
  // matter.
  async function loadSeasonResults(row: HTMLElement) {
    const url = row.dataset.seasonResultsUrl;
    const body = row.nextElementSibling?.querySelector<HTMLElement>('[data-season-results-body]');
    if (!url || !body || row.dataset.resultsLoaded === 'true') return;
    row.dataset.resultsLoaded = 'true';
    try {
      const res = await fetch(url);
      if (!res.ok) throw new Error(`Request failed: ${res.status}`);
      body.innerHTML = await res.text();
    } catch (err) {
      console.error('Failed to load champion season results:', err);
      body.innerHTML = '<p class="text-xs text-white/40">Couldn’t load this season’s results right now.</p>';
      row.dataset.resultsLoaded = 'false'; // let the next open retry
    }
  }
  function maybeLoadSeasonResults(target: EventTarget | null) {
    const row = (target as HTMLElement | null)?.closest<HTMLElement>('[data-expand-row][data-season-results-url]');
    if (!row) return;
    setTimeout(() => {
      if (row.getAttribute('aria-expanded') === 'true') void loadSeasonResults(row);
    }, 0);
  }
  document.addEventListener('click', (e) => maybeLoadSeasonResults(e.target));
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Enter' || e.key === ' ') maybeLoadSeasonResults(e.target);
  });
</script>
