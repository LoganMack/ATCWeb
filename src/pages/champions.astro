---
export const prerender = false;

import Layout from '../layouts/Layout.astro';
import HistoryTabs from '../components/HistoryTabs.astro';
import PageBanner from '../components/PageBanner.astro';
import { resolveSupabaseEnv, getDriverClasses, getSeasons, getPageBanners } from '../lib/supabase';
import { bannerUrlFor } from '../lib/pageBanners';

// Pilot for the sitewide "shell renders instantly, data fills in after"
// pattern (PERFORMANCE_AUDIT.md #5). This page used to await the full
// cross-season champions/team-champions computation right here in its own
// frontmatter — since Astro's client router waits for a page's whole HTML
// response before swapping the DOM, that meant clicking into /champions
// left the browser sitting on the OLD page for ~5+ seconds with nothing
// but the top progress bar to show for it.
//
// Now this page only fetches what it actually needs to render immediately
// (driver classes + seasons, for the filter tabs — cheap, same as any
// other page's reference-table lookups) and renders a loading skeleton in
// place of the cards. The expensive part moved to champions/fragment.astro,
// fetched client-side by the <script> below once this shell has already
// painted. See that file for the full explanation of why it re-resolves
// the class/team query params itself instead of receiving them passed in.

const supabaseEnv = resolveSupabaseEnv(Astro.locals);

// Kicked off immediately, in parallel with everything else below — the
// banner doesn't depend on classes/seasons/champions data at all, but this
// page used to `await` it dead last, after the (much more expensive)
// champions/team-champions computation had already fully finished. Started
// here and awaited only once it's actually needed, near the bottom, so it
// overlaps with all of that instead of adding its own round trip on top.
const pageBannersPromise = getPageBanners(supabaseEnv);

let classes: Awaited<ReturnType<typeof getDriverClasses>> = [];
let seasons: Awaited<ReturnType<typeof getSeasons>> = [];
// Holds the actual thrown error message (not just a boolean) — the tables
// this page reads (race_scores, curated_race_results) are newer/narrower
// grants than the rest of the site's public data, so "something went
// wrong" isn't precise enough to self-diagnose an RLS/policy problem vs. a
// genuine misconfiguration. See supabase/migrations/0004_champions.sql.
let loadError: string | null = null;
try {
  [classes, seasons] = await Promise.all([getDriverClasses(supabaseEnv), getSeasons(supabaseEnv)]);
} catch (err) {
  console.error('Failed to load champions page filters:', err);
  loadError = err instanceof Error ? err.message : String(err);
}

// Gamma/Delta didn't exist for every season (seasons.gamma_enabled/
// delta_enabled, 0037_class_and_scoring_fixes.sql) — a class tab only shows
// at all if at least one season actually enables it, and the seasons that
// class's champion list considers are narrowed to just the enabled ones,
// so e.g. Gamma never shows a "champion" for a season before it existed.
// Alpha has no flag — every championship season has it.
function classIsEnabledFor(className: string, season: Awaited<ReturnType<typeof getSeasons>>[number]): boolean {
  if (className === 'Gamma') return season.gamma_enabled;
  if (className === 'Delta') return season.delta_enabled;
  return true;
}
const visibleClasses = classes.filter((c) => seasons.some((s) => classIsEnabledFor(c.name, s)));

// Defaults to Alpha. Class switching is a real navigation (?class=Gamma)
// rather than a client-side toggle — computing a season's standings isn't
// free, so it only happens for the class actually being viewed.
const requestedClassName = Astro.url.searchParams.get('class');
const activeClass =
  visibleClasses.find((c) => c.name === requestedClassName) ?? visibleClasses.find((c) => c.name === 'Alpha') ?? visibleClasses[0];

// Two more filters alongside the driver-class ones above: team champions,
// not driver champions. "Alpha Team" is the same class-blind OVERALL team
// competition already live on /team-standings' "Overall" tab (just
// relabeled here, per Logan — there's no genuinely separate Alpha-only team
// competition anywhere else in the app), "Delta Team" is that class's own
// separate competition, same split computeTeamSeasonStandings documents.
// A real navigation (?team=alpha / ?team=delta), same reasoning as the
// class tabs — mutually exclusive with the `class` param (whichever query
// param combination the link sets wins, since these are plain <a href>
// full-page navigations).
const deltaEnabledAnySeason = seasons.some((s) => s.delta_enabled);
const requestedTeam = Astro.url.searchParams.get('team');
const activeTeamView: 'alpha' | 'delta' | null =
  requestedTeam === 'delta' && deltaEnabledAnySeason ? 'delta' : requestedTeam === 'alpha' ? 'alpha' : null;

let bannerUrl: string | null = null;
try {
  bannerUrl = bannerUrlFor(await pageBannersPromise, 'champions');
} catch (err) {
  console.error('Failed to load page banner:', err);
}

Astro.response.headers.set('Cache-Control', 'public, s-maxage=60, stale-while-revalidate=300');
---

<Layout title="Champions" description="Past Alpha Touring Challenge season champions.">
  <section class="relative mx-auto max-w-5xl overflow-hidden px-6 pb-24 pt-28 sm:pt-36">
    <PageBanner imageUrl={bannerUrl} />
    <h1 class="reveal font-display text-5xl">Champions</h1>

    <HistoryTabs active="champions" />

    {loadError && (
      <p class="mt-4 rounded-lg border border-brand-pink/30 bg-brand-pink/10 p-4 text-sm text-white/80">
        Couldn't load champions right now. If this mentions permission/RLS, race_scores or curated_race_results
        likely still need the public-read policy from <code>supabase/migrations/0004_champions.sql</code> —
        it has to be run manually in the Supabase SQL editor.
        <br /><span class="mt-1 block text-white/50">{loadError}</span>
      </p>
    )}

    {!loadError && (
      <div class="flex flex-wrap gap-2">
        {visibleClasses.map((c) => (
          <a
            href={`/champions?class=${encodeURIComponent(c.name)}`}
            class={`rounded-lg px-4 py-1.5 text-sm font-semibold ring-1 ring-white/15 transition ${
              !activeTeamView && c.id === activeClass?.id ? 'bg-white text-brand-ink' : 'text-white/80 hover:bg-white/10'
            }`}
          >
            {c.name}
          </a>
        ))}
        <a
          href="/champions?team=alpha"
          class={`rounded-lg px-4 py-1.5 text-sm font-semibold ring-1 ring-white/15 transition ${
            activeTeamView === 'alpha' ? 'bg-white text-brand-ink' : 'text-white/80 hover:bg-white/10'
          }`}
        >
          Alpha Team
        </a>
        {deltaEnabledAnySeason && (
          <a
            href="/champions?team=delta"
            class={`rounded-lg px-4 py-1.5 text-sm font-semibold ring-1 ring-white/15 transition ${
              activeTeamView === 'delta' ? 'bg-white text-brand-ink' : 'text-white/80 hover:bg-white/10'
            }`}
          >
            Delta Team
          </a>
        )}
      </div>
    )}

    {!loadError && (
      <div data-champions-results data-fragment-url={`/champions/fragment${Astro.url.search}`}>
        <div class="mt-8 flex flex-col gap-5" aria-live="polite" aria-busy="true">
          <span class="sr-only">Loading champions…</span>
          <div class="h-40 animate-pulse rounded-xl border border-white/10 bg-white/[0.03]"></div>
          <div class="h-40 animate-pulse rounded-xl border border-white/10 bg-white/[0.03]"></div>
          <div class="h-40 animate-pulse rounded-xl border border-white/10 bg-white/[0.03]"></div>
        </div>
      </div>
    )}
  </section>
</Layout>

<script>
  // Pilot for the sitewide "shell renders instantly, data fills in after"
  // pattern — see champions.astro's own top-of-file comment and
  // champions/fragment.astro for the full explanation. This runs on every
  // soft navigation (including switching class/team tabs, since those are
  // real ?class=/?team= navigations, not client-side toggles — each lands
  // here fresh with its own skeleton already in the server-rendered shell).
  function initChampionsResults() {
    const container = document.querySelector<HTMLElement>('[data-champions-results]');
    const url = container?.dataset.fragmentUrl;
    if (!container || !url) return;

    fetch(url)
      .then((res) => {
        if (!res.ok) throw new Error(`Champions fragment request failed (${res.status})`);
        return res.text();
      })
      .then((html) => {
        container.innerHTML = html;
        // reveal.ts's IntersectionObserver only ever looks at `.reveal`
        // elements that exist in the DOM at astro:page-load time — these
        // cards land well after that, via this fetch, so without this
        // they'd sit at opacity:0 forever (see global.css's `.reveal`
        // rule). Marking them visible immediately (rather than replicating
        // reveal.ts's scroll-triggered observer here) is the right call
        // anyway: this content is appearing because a load just finished,
        // not because the user scrolled to it.
        container.querySelectorAll('.reveal').forEach((el) => el.classList.add('is-visible'));
      })
      .catch((err) => {
        console.error('Failed to load champions results:', err);
        container.innerHTML = '<p class="mt-10 text-white/60">Couldn’t load champions right now — try refreshing the page.</p>';
      });
  }

  document.addEventListener('astro:page-load', initChampionsResults);
</script>
