                      <td class="py-2 pr-2 text-center text-white/70" data-col="starts">{r.starts}</td>
                      <td class="py-2 pr-2 text-center font-semibold text-white/90" data-col="classPos">{r.classPosition}</td>
                      <td class="py-2 pr-2 text-center text-white/70" data-col="overallPos">{r.overallPosition ?? '—'}</td>
                    </tr>
                  );
