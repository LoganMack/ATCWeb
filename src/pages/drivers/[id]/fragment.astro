---
export const prerender = false;
import LoadError from '../../../components/LoadError.astro';
import { markUncacheable } from '../../../lib/security';

import CarLogos from '../../../components/CarLogos.astro';
import TeamLogo from '../../../components/TeamLogo.astro';
import NewsCard from '../../../components/NewsCard.astro';
import { resolveSupabaseEnv } from '../../../lib/db/client';
import { formatDateShort } from '../../../lib/db/circuits';
import { classBadgeLetter, classTextColorClass, classTagShort } from '../../../lib/classColors';
import { loadDriverPage } from '../../../lib/driverPage/load';
import { buildDriverPageGroups } from '../../../lib/driverPage/groups';
import { incidentDriverLabel } from '../../../lib/driverPage/helpers';

/**
 * The expensive part of the driver profile page — see drivers/[id].astro's
 * own doc comment for the full shell/fragment split explanation.
 * computeDriverCareerStats() in particular recomputes standings for every
 * driver across every season/class just to pick one driver's rows back out
 * (the same cost hall-of-fame/driver-stats already pay), which is what was
 * making this page slow.
 *
 * Returns a bare HTML fragment — no <Layout>, no header — meant only to be
 * dropped into drivers/[id].astro's results container via
 * `container.innerHTML = await res.text()`. Never linked to directly.
 */

const supabaseEnv = resolveSupabaseEnv(Astro.locals);
const driverId = String(Astro.params.id ?? '');
// Hall of Fame status is threaded through from the shell (drivers/[id].astro)
// as a query param rather than re-fetched here — this fragment has no
// access to that page's in-memory `driver` row (see this file's own doc
// comment above), and it's cheaper than a second profile lookup for one
// boolean. Shown as its own pinned row atop the Awards card below instead
// of a header badge.
const isHallOfFame = Astro.url.searchParams.get('hof') === '1';

const {
  loadError,
  career,
  raceHistory,
  relatedPosts,
  relatedLogoBySeasonLabel,
  relatedTagsByPostId,
  careerMoves,
  classMoves,
  awardEntries,
  driverIncidents,
} = await loadDriverPage(supabaseEnv, driverId);
const { awardGroups, raceCountBySubsession, splitGroupsOverall, splitGroupsClass, layoutBests } = buildDriverPageGroups(
  raceHistory,
  awardEntries
);
if (loadError) markUncacheable(Astro);
---

{loadError && <LoadError class="mt-8" />}

{!loadError && (
  <>
  <div class="mt-8 grid gap-8 lg:grid-cols-3">
    <div class="flex flex-col gap-8 lg:col-span-2">
      <!-- Seasons / Races / Splits / Bests — one card, four tabs, instead of
           three separate always-visible collapsible cards (plus the new
           Bests tab) per Logan. Same delegated tab-button pattern as
           incidents.astro's All Incidents / By Driver / By Offense switch —
           see that file's own markup comment for why the click listener has
           to live in the shell (drivers/[id].astro) rather than a <script>
           here: this fragment is injected via `container.innerHTML =`, and
           a <script> tag added that way never executes. Splits' own
           internal Overall/Class radio toggle and per-split-type <details>
           are untouched by this — only the outer "three separate cards"
           shell became "one card, tab-selected panels." -->
      <div class="reveal rounded-xl border border-white/10 bg-brand-ink p-4" data-driver-tabs>
        <div class="mb-3 flex flex-wrap gap-2" role="tablist">
          <button
            type="button"
            role="tab"
            data-driver-tab="seasons"
            aria-selected="true"
            data-active="true"
            class="btn btn-neutral"
          >
            {/* No separate color class on this count — it inherits whatever
                color the tab-switch script gives its parent button (white
                when active, white/60 when not), so it doesn't stay dim after
                this tab becomes the active one. Same for every count below. */}
            Seasons <span>({career?.seasons.length ?? 0})</span>
          </button>
          <button
            type="button"
            role="tab"
            data-driver-tab="races"
            aria-selected="false"
            data-active="false"
            class="btn btn-neutral"
          >
            Races <span>({raceHistory.length})</span>
          </button>
          <button
            type="button"
            role="tab"
            data-driver-tab="splits"
            aria-selected="false"
            data-active="false"
            class="btn btn-neutral"
          >
            Splits
          </button>
          <button
            type="button"
            role="tab"
            data-driver-tab="bests"
            aria-selected="false"
            data-active="false"
            class="btn btn-neutral"
          >
            Bests <span>({layoutBests.length})</span>
          </button>
          <button
            type="button"
            role="tab"
            data-driver-tab="incidents"
            aria-selected="false"
            data-active="false"
            class="btn btn-neutral"
          >
            Incidents <span>({driverIncidents.length})</span>
          </button>
        </div>

        <div data-driver-panel="seasons">
        {!career || career.seasons.length === 0 ? (
          <p class="text-sm text-white/40">No season history yet.</p>
        ) : (
          <div class="max-h-[32rem] overflow-auto">
            <table class="w-full border-collapse text-xs" data-sortable>
              <thead>
                <tr class="sticky top-0 z-10 border-b border-white/10 bg-brand-ink text-left align-middle text-[10px] uppercase tracking-wide text-white/30">
                  <th class="py-2 pl-2 pr-2 font-medium align-middle" data-sort-key="season">Season</th>
                  <th class="py-2 pr-2 font-medium align-middle" data-sort-key="class">Class</th>
                  <th class="py-2 pr-2 font-medium align-middle" data-sort-key="cars">Car(s)</th>
                  <th class="py-2 pr-2 font-medium align-middle" data-sort-key="teams">Team(s)</th>
                  <th class="py-2 pr-2 text-center font-medium align-middle" data-sort-key="wins">Wins</th>
                  <th class="py-2 pr-2 text-center font-medium align-middle" data-sort-key="poles">Poles</th>
                  <th class="py-2 pr-2 text-center font-medium align-middle" data-sort-key="podiums">Podiums</th>
                  <th class="py-2 pr-2 text-center font-medium align-middle" data-sort-key="top5s">Top 5s</th>
                  <th class="py-2 pr-2 text-center font-medium align-middle" data-sort-key="laps">Laps</th>
                  <th class="py-2 pr-2 text-center font-medium align-middle" data-sort-key="lapsLed">Led</th>
                  <th class="py-2 pr-2 text-center font-medium align-middle" data-sort-key="cpi">CPI</th>
                  <th class="py-2 pr-2 text-center font-medium align-middle" data-sort-key="starts">Starts</th>
                  <th class="py-2 pr-2 text-center font-medium align-middle" data-sort-key="classPos">Class Pos</th>
                  <th class="py-2 pr-2 text-center font-medium align-middle" data-sort-key="overallPos">Overall Pos</th>
                </tr>
              </thead>
              <tbody>
                {career.seasons.map((r) => {
                  const seasonCpi = r.totalCorners !== null && r.incidents > 0 ? r.totalCorners / r.incidents : null;
                  return (
                    <tr class="border-b border-white/5">
                      <td class="py-2 pr-2 font-semibold text-white/90" data-col="season" data-sort-value={r.season?.number ?? ''}>
                        <!--
                          Trophy is absolutely positioned inside a
                          permanently-reserved left gutter (pl-4 on this
                          span), not a flex sibling of the season name — a
                          flex layout would push the name itself further
                          right on trophy rows only, misaligning every
                          season name in the column depending on whether
                          that particular row won a championship. Reserving
                          the gutter unconditionally means the name always
                          starts at the same x whether or not a trophy is
                          drawn into it.
                        -->
                        <span class="relative inline-block pl-4">
                          {/* Not r.season.is_current — no trophy for a still-in-progress
                              season's current P1, per Logan (same gate the Awards card
                              above and driver-stats/team-stats use). */}
                          {r.classPosition === 1 && !r.season.is_current && (
                            <svg
                              xmlns="http://www.w3.org/2000/svg"
                              viewBox="0 0 24 24"
                              fill="none"
                              stroke="currentColor"
                              stroke-width="2"
                              stroke-linecap="round"
                              stroke-linejoin="round"
                              class={`absolute left-0 top-1/2 h-3 w-3 flex-none -translate-y-1/2 ${classTextColorClass(r.className)}`}
                              {...{ title: `${r.className} Champion` }}
                            >
                              <path d="M6 9H4.5a2.5 2.5 0 0 1 0-5H6" />
                              <path d="M18 9h1.5a2.5 2.5 0 0 0 0-5H18" />
                              <path d="M4 22h16" />
                              <path d="M10 14.66V17c0 .55-.47.98-.97 1.21C7.85 18.75 7 20.24 7 22" />
                              <path d="M14 14.66V17c0 .55.47.98.97 1.21C16.15 18.75 17 20.24 17 22" />
                              <path d="M18 2H6v7a6 6 0 0 0 12 0V2Z" />
                            </svg>
                          )}
                          {r.season.name}
                        </span>
                      </td>
                      <td class="py-2 pr-2" data-col="class" data-sort-value={r.classId}>
                        <span
                          class={classTagShort(r.className)}
                          title={r.className}
                        >
                          {classBadgeLetter(r.className)}
                        </span>
                      </td>
                      <td class="py-2 pr-2" data-col="cars" data-sort-value={r.cars.map((c) => c.carName).join(', ')}>
                        <CarLogos cars={r.cars} empty="dash" />
                      </td>
                      <td class="py-2 pr-2" data-col="teams" data-sort-value={r.teams.map((t) => t.teamName).join(', ')}>
                        <div class="flex flex-wrap items-center gap-1">
                          {r.teams.map((t) => (
                            <TeamLogo
                              name={t.teamName}
                              logoUrl={t.logoUrl}
                              size="h-5 w-5"
                              title={`${t.teamName} — ${t.racesUnderTeam} race${t.racesUnderTeam === 1 ? '' : 's'} under this team`}
                            />
                          ))}
                          {r.teams.length === 0 && <span class="text-white/30">—</span>}
                        </div>
                      </td>
                      <td class="py-2 pr-2 text-center text-white/70" data-col="wins">{r.wins}</td>
                      <td class="py-2 pr-2 text-center text-white/70" data-col="poles">{r.poles}</td>
                      <td class="py-2 pr-2 text-center text-white/70" data-col="podiums">{r.podiums}</td>
                      <td class="py-2 pr-2 text-center text-white/70" data-col="top5s">{r.top5s}</td>
                      <td class="py-2 pr-2 text-center text-white/70" data-col="laps">{r.laps}</td>
                      <td class="py-2 pr-2 text-center text-white/70" data-col="lapsLed">{r.lapsLed}</td>
                      <td class="py-2 pr-2 text-center text-white/70" data-col="cpi">{seasonCpi !== null ? seasonCpi.toFixed(1) : '—'}</td>
                      <td class="py-2 pr-2 text-center text-white/70" data-col="starts">{r.starts}</td>
                      <td class="py-2 pr-2 text-center font-semibold text-white/90" data-col="classPos">{r.classPosition}</td>
                      <td class="py-2 pr-2 text-center text-white/70" data-col="overallPos">{r.overallPosition ?? '—'}</td>
                    </tr>
                  );
                })}
              </tbody>
            </table>
          </div>
        )}
        </div>

        <div data-driver-panel="races" class="hidden">
        {raceHistory.length === 0 ? (
          <p class="text-sm text-white/40">No races on file yet.</p>
        ) : (
          <div class="max-h-[32rem] overflow-auto">
            <table class="w-full border-collapse text-xs" data-sortable>
              <thead>
                <tr class="sticky top-0 z-10 border-b border-white/10 bg-brand-ink text-left text-[10px] uppercase tracking-wide text-white/30">
                  <th class="py-2 pl-2 pr-2 font-medium" data-sort-key="season">Season</th>
                  <th class="py-2 pr-2 font-medium" data-sort-key="round">Round</th>
                  <th class="py-2 pr-2 font-medium" data-sort-key="class">Class</th>
                  <th class="py-2 pr-2 font-medium" data-sort-key="car">Car</th>
                  <th class="py-2 pr-2 font-medium" data-sort-key="team">Team</th>
                  <th class="py-2 pr-2 text-center font-medium" data-sort-key="start">Start</th>
                  <th class="py-2 pr-2 text-center font-medium" data-sort-key="finish">Finish</th>
                  <th class="py-2 pr-2 text-center font-medium" data-sort-key="margin">Margin</th>
                  <th class="py-2 pr-2 text-center font-medium" data-sort-key="inc">Inc</th>
                  <th class="py-2 pr-2 text-center font-medium" data-sort-key="laps">Laps</th>
                  <th class="py-2 pr-2 text-center font-medium" data-sort-key="led">Led</th>
                  <th class="py-2 pr-2 text-center font-medium" data-sort-key="points">Points</th>
                </tr>
              </thead>
              <tbody>
                {raceHistory.map((r) => (
                  <tr class="border-b border-white/5">
                    <td class="py-2 pr-2 font-semibold text-white/90" data-col="season" data-sort-value={r.season?.number ?? ''}>{r.season?.name ?? '—'}</td>
                    <td class="py-2 pr-2" data-col="round" data-sort-value={r.startTime}>
                      <a href={`/results/${r.subsessionId}`} class="text-brand-primary hover:underline">
                        {r.displayRoundNumber !== null ? `Round ${r.displayRoundNumber}` : r.trackName}
                        {(raceCountBySubsession.get(r.subsessionId) ?? 1) > 1 && ` (Race ${r.raceNumber})`}
                      </a>
                      <div class="text-[10px] text-white/40">{formatDateShort(r.startTime.slice(0, 10))}</div>
                    </td>
                    <td class="py-2 pr-2" data-col="class" data-sort-value={r.classId}>
                      <span
                        class={classTagShort(r.className)}
                        title={r.className}
                      >
                        {classBadgeLetter(r.className)}
                      </span>
                    </td>
                    <td class="py-2 pr-2" data-col="car" data-sort-value={r.car?.name ?? ''}>
                      {r.car ? <TeamLogo name={r.car.name} logoUrl={r.car.logoUrl} size="h-5 w-5" tint /> : <span class="text-white/30">—</span>}
                    </td>
                    <td class="py-2 pr-2" data-col="team" data-sort-value={r.team?.name ?? ''}>
                      {r.team ? <TeamLogo name={r.team.name} logoUrl={r.team.logoUrl} size="h-5 w-5" title={r.team.name} /> : <span class="text-white/30">N/A</span>}
                    </td>
                    <td class="py-2 pr-2 text-center text-white/70" data-col="start">{r.classStartingPosition ?? r.startingPosition ?? '—'}</td>
                    <td class="py-2 pr-2 text-center text-white/90" data-col="finish" data-sort-value={r.dsq ? 9999 : (r.classPosition ?? r.finishPosition)}>
                      <!--
                        The penalty asterisk is absolutely-positioned off the
                        RIGHT edge of a relatively-positioned wrapper sized
                        to the number alone, rather than sitting inline next
                        to it — an inline asterisk widens the centered
                        content every time it toggles on/off, shifting the
                        number's own visual center (same class of bug the NC
                        tag used to have here, and that ResultsTable.astro's
                        header comment describes for the driver-name case).
                        Taking the asterisk out of flow like this means
                        Tailwind's centering only ever measures the number.
                        The number itself is this driver's CLASS-relative
                        finish (classPosition), not the raw overall running
                        order — see DriverRaceHistoryRow.classPosition's doc
                        comment in results.ts for why those two differ for
                        anyone not in Alpha. data-sort-value above mirrors
                        the same number (DSQ pushed to the bottom of an
                        ascending sort via a large sentinel) so the asterisk
                        glyph itself never leaks into the sort comparison —
                        see sortable-table.ts's own doc comment for why that
                        matters.
                      -->
                      <span class="relative inline-block">
                        {r.dsq ? <span class="text-brand-pink">DSQ</span> : (r.classPosition ?? r.finishPosition)}
                        {r.wasAdjusted && (
                          <sup
                            class={`absolute left-full top-0 ml-0.5 text-[10px] font-sans ${r.gainedPositions ? 'text-brand-blue' : 'text-brand-pink'}`}
                            title={r.gainedPositions ? 'Gained position(s) by penalty' : 'Adjusted by penalty'}
                          >
                            *
                          </sup>
                        )}
                      </span>
                    </td>
                    <td class="py-2 pr-2 text-center text-white/70" data-col="margin">{r.margin}</td>
                    <td class="py-2 pr-2 text-center text-white/70" data-col="inc">{r.incidents ?? '—'}</td>
                    <td class="py-2 pr-2 text-center text-white/70" data-col="laps">{r.laps ?? '—'}</td>
                    <td class="py-2 pr-2 text-center text-white/70" data-col="led">{r.lapsLed ?? '—'}</td>
                    <td class="py-2 pr-2 text-center font-semibold text-white/90" data-col="points">{r.totalPoints}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        )}
        </div>

        <!-- Splits: per-Month/Round/Car aggregate stats. Each split group is
             its own nested collapsible (default collapsed), independent of
             the other four and of the outer panel's own tab visibility. The
             Overall/Class toggle below is pure CSS (paired radio inputs +
             Tailwind's peer-checked variant, same "no JS needed" approach as
             the <details> collapses) — this fragment is injected via
             `innerHTML` by drivers/[id].astro, and a <script> tag added that
             way never executes, so both row sets are rendered once up front
             and the toggle just switches which one is visible.

             Each mode's row-set is its own independent DOM subtree (below),
             so a <details> a visitor opens under Overall isn't the same
             element as its counterpart under Class — CSS alone can't keep
             them showing the same open/closed state across a toggle. Each
             <details> here carries data-split-name (matching by split group
             name, e.g. "Month"), and drivers/[id].astro's shell script (the
             one place a <script> in this page actually runs — see above)
             mirrors open/closed state between the two same-named elements on
             every toggle event, so opening either one opens both. -->
        <div data-driver-panel="splits" class="hidden">
        {raceHistory.length === 0 ? (
          <p class="text-sm text-white/40">No races on file yet.</p>
        ) : (
          <>
            <!--
              The radios, labels, hint text, and both row-set <div>s below
              are all deliberately kept as DIRECT siblings of one another
              (all children of this one flex-wrap container) — Tailwind's
              peer-checked variant only ever matches a TRUE sibling of the
              checked input via CSS's `~` combinator, not "a sibling of an
              ancestor," so nesting the radios inside their own wrapper row
              would silently break every peer-checked reference below.
              `w-full` on the two content divs is what pushes them onto
              their own line within this same flex-wrap row, giving a
              normal-looking "toggle row, then content" layout without
              actually nesting anything.
            -->
            <div class="mb-3 flex flex-wrap items-center gap-1 text-xs">
              <input type="radio" name="splits-mode" id="splits-mode-overall" class="peer/overall sr-only" checked />
              <input type="radio" name="splits-mode" id="splits-mode-class" class="peer/class sr-only" />
              <label
                for="splits-mode-overall"
                class="cursor-pointer rounded-lg px-2.5 py-1 font-semibold uppercase tracking-wide text-white/50 peer-checked/overall:bg-white/10 peer-checked/overall:text-white"
              >
                Overall
              </label>
              <label
                for="splits-mode-class"
                class="cursor-pointer rounded-lg px-2.5 py-1 font-semibold uppercase tracking-wide text-white/50 peer-checked/class:bg-white/10 peer-checked/class:text-white"
                title="This driver's own position within whichever class they raced, not their raw overall running order — a month split between two classes still shows as one combined row."
              >
                Class
              </label>

              <div class="mt-3 flex w-full flex-col gap-3 peer-checked/class:hidden" data-splits-rows="overall">
              {splitGroupsOverall.map((g) => (
                <details class="group/split rounded-lg border border-white/10 bg-brand-ink" data-split-name={g.name}>
                  <summary class="flex cursor-pointer list-none items-center justify-between gap-2 px-3 py-2 text-sm font-semibold text-white/80">
                    <span class="flex items-center gap-2">
                      {g.name}
                      <span class="text-sm text-white/40">{g.rows.length}</span>
                    </span>
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4 flex-none text-white/40 transition-transform group-open/split:rotate-90" aria-hidden="true">
                      <polyline points="9 6 15 12 9 18" />
                    </svg>
                  </summary>
                  <div class="border-t border-white/10 p-3" data-sticky-thead>
                    <table class="w-full border-collapse text-xs" data-sortable>
                      <thead>
                        <tr class="border-b border-white/10 text-left text-[10px] uppercase tracking-wide text-white/30">
                          <th class="py-2 pl-2 pr-2 font-medium" data-sort-key="label">{g.name}</th>
                          <th class="py-2 pr-2 text-center font-medium" data-sort-key="starts">Starts</th>
                          <th class="py-2 pr-2 text-center font-medium" data-sort-key="wins">Wins</th>
                          <th class="py-2 pr-2 text-center font-medium" data-sort-key="podiums">Podiums</th>
                          <th class="py-2 pr-2 text-center font-medium" data-sort-key="top5s">Top 5s</th>
                          <th class="py-2 pr-2 text-center font-medium" data-sort-key="avgFinish" title="Avg Finish">AVG F</th>
                          <th class="py-2 pr-2 text-center font-medium" data-sort-key="avgQualify" title="Avg Qualify">AVG Q</th>
                          <th class="py-2 pr-2 text-center font-medium" data-sort-key="cpi">CPI</th>
                          <th class="py-2 pr-2 text-center font-medium" data-sort-key="lapsLed">Led</th>
                          <th class="py-2 pr-2 text-center font-medium" data-sort-key="points">Points</th>
                        </tr>
                      </thead>
                      <tbody>
                        {g.rows.map((row) => (
                          <tr class="border-b border-white/5">
                            <td class="py-2 pr-2 font-semibold text-white/90" data-col="label">
                              <span class="flex items-center gap-1.5">
                                {row.logoUrl && <img src={row.logoUrl} alt="" class="h-4 w-4 flex-none rounded-sm object-contain" loading="lazy" />}
                                {row.label}
                              </span>
                            </td>
                            <td class="py-2 pr-2 text-center text-white/70" data-col="starts">{row.starts}</td>
                            <td class="py-2 pr-2 text-center text-white/70" data-col="wins">{row.wins}</td>
                            <td class="py-2 pr-2 text-center text-white/70" data-col="podiums">{row.podiums}</td>
                            <td class="py-2 pr-2 text-center text-white/70" data-col="top5s">{row.top5s}</td>
                            <td class="py-2 pr-2 text-center text-white/70" data-col="avgFinish">{row.avgFinish}</td>
                            <td class="py-2 pr-2 text-center text-white/70" data-col="avgQualify">{row.avgQualify}</td>
                            <td class="py-2 pr-2 text-center text-white/70" data-col="cpi">{row.cpi}</td>
                            <td class="py-2 pr-2 text-center text-white/70" data-col="lapsLed">{row.lapsLed}</td>
                            <td class="py-2 pr-2 text-center font-semibold text-white/90" data-col="points">{row.points}</td>
                          </tr>
                        ))}
                        {g.rows.length === 0 && (
                          <tr>
                            <td colspan="10" class="py-2 pr-2 text-white/30">No data.</td>
                          </tr>
                        )}
                      </tbody>
                    </table>
                  </div>
                </details>
              ))}
            </div>

            <div class="mt-3 hidden w-full flex-col gap-3 peer-checked/class:flex" data-splits-rows="class">
              {splitGroupsClass.map((g) => (
                <details class="group/split rounded-lg border border-white/10 bg-brand-ink" data-split-name={g.name}>
                  <summary class="flex cursor-pointer list-none items-center justify-between gap-2 px-3 py-2 text-sm font-semibold text-white/80">
                    <span class="flex items-center gap-2">
                      {g.name}
                      <span class="text-sm text-white/40">{g.rows.length}</span>
                    </span>
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4 flex-none text-white/40 transition-transform group-open/split:rotate-90" aria-hidden="true">
                      <polyline points="9 6 15 12 9 18" />
                    </svg>
                  </summary>
                  <div class="border-t border-white/10 p-3" data-sticky-thead>
                    <table class="w-full border-collapse text-xs" data-sortable>
                      <thead>
                        <tr class="border-b border-white/10 text-left text-[10px] uppercase tracking-wide text-white/30">
                          <th class="py-2 pl-2 pr-2 font-medium" data-sort-key="label">{g.name}</th>
                          <th class="py-2 pr-2 text-center font-medium" data-sort-key="starts">Starts</th>
                          <th class="py-2 pr-2 text-center font-medium" data-sort-key="wins">Wins</th>
                          <th class="py-2 pr-2 text-center font-medium" data-sort-key="podiums">Podiums</th>
                          <th class="py-2 pr-2 text-center font-medium" data-sort-key="top5s">Top 5s</th>
                          <th class="py-2 pr-2 text-center font-medium" data-sort-key="avgFinish" title="Avg Finish">AVG F</th>
                          <th class="py-2 pr-2 text-center font-medium" data-sort-key="avgQualify" title="Avg Qualify">AVG Q</th>
                          <th class="py-2 pr-2 text-center font-medium" data-sort-key="cpi">CPI</th>
                          <th class="py-2 pr-2 text-center font-medium" data-sort-key="lapsLed">Led</th>
                          <th class="py-2 pr-2 text-center font-medium" data-sort-key="points">Points</th>
                        </tr>
                      </thead>
                      <tbody>
                        {g.rows.map((row) => (
                          <tr class="border-b border-white/5">
                            <td class="py-2 pr-2 font-semibold text-white/90" data-col="label">
                              <span class="flex items-center gap-1.5">
                                {row.logoUrl && <img src={row.logoUrl} alt="" class="h-4 w-4 flex-none rounded-sm object-contain" loading="lazy" />}
                                {row.label}
                              </span>
                            </td>
                            <td class="py-2 pr-2 text-center text-white/70" data-col="starts">{row.starts}</td>
                            <td class="py-2 pr-2 text-center text-white/70" data-col="wins">{row.wins}</td>
                            <td class="py-2 pr-2 text-center text-white/70" data-col="podiums">{row.podiums}</td>
                            <td class="py-2 pr-2 text-center text-white/70" data-col="top5s">{row.top5s}</td>
                            <td class="py-2 pr-2 text-center text-white/70" data-col="avgFinish">{row.avgFinish}</td>
                            <td class="py-2 pr-2 text-center text-white/70" data-col="avgQualify">{row.avgQualify}</td>
                            <td class="py-2 pr-2 text-center text-white/70" data-col="cpi">{row.cpi}</td>
                            <td class="py-2 pr-2 text-center text-white/70" data-col="lapsLed">{row.lapsLed}</td>
                            <td class="py-2 pr-2 text-center font-semibold text-white/90" data-col="points">{row.points}</td>
                          </tr>
                        ))}
                        {g.rows.length === 0 && (
                          <tr>
                            <td colspan="10" class="py-2 pr-2 text-white/30">No data.</td>
                          </tr>
                        )}
                      </tbody>
                    </table>
                  </div>
                </details>
              ))}
            </div>
            </div>
          </>
        )}
        </div>

        <!-- Bests: one row per layout this driver has ever raced, sorted
             alphabetically by track then layout — see the layoutBests
             computation above for exactly how Personal Best/Track Record are
             derived. -->
        <div data-driver-panel="bests" class="hidden">
        {layoutBests.length === 0 ? (
          <p class="text-sm text-white/40">No races on file yet.</p>
        ) : (
          <div class="max-h-[32rem] overflow-auto">
            <table class="w-full border-collapse text-xs" data-sortable>
              <thead>
                <tr class="sticky top-0 z-10 border-b border-white/10 bg-brand-ink text-left text-[10px] uppercase tracking-wide text-white/30">
                  <th class="py-2 pl-2 pr-2 font-medium" data-sort-key="track">Track</th>
                  <th class="py-2 pr-2 font-medium" data-sort-key="layout">Layout</th>
                  <th class="py-2 pr-2 text-center font-medium" data-sort-key="pb">Personal Best</th>
                  <th class="py-2 pr-2 text-center font-medium" data-sort-key="record">Track Record</th>
                </tr>
              </thead>
              <tbody>
                {layoutBests.map((r) => (
                  <tr class="border-b border-white/5">
                    <td class="py-2 pr-2 font-semibold text-white/90" data-col="track" data-sort-value={r.trackName}>{r.trackName}</td>
                    <td class="py-2 pr-2 text-white/70" data-col="layout" data-sort-value={r.layoutText}>{r.layoutText}</td>
                    <td
                      class="py-2 pr-2 text-center text-base font-bold text-white/90"
                      data-col="pb"
                      data-sort-value={r.personalBestTenThousandths ?? ''}
                    >
                      {r.personalBestFormatted}
                    </td>
                    <td
                      class="py-2 pr-2 text-center text-base text-white/70"
                      data-col="record"
                      data-sort-value={r.trackRecordSeconds ?? ''}
                      title="circuit_layouts.lap_record_seconds — the same curated Track Record shown on the Circuits and Event Briefing pages, not necessarily an ATC-only figure."
                    >
                      {r.trackRecordFormatted}
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        )}
        </div>

        <!-- Incidents: every steward-logged incident this driver appears in
             at all (penalized party OR just tagged as involved), newest
             first — see driverIncidents' own doc comment above for where
             this comes from (getAllIncidents()'s byDriver rollup, the same
             source History → Incidents' By Driver tab reads). "Penalized"
             shows who actually took the PP/time/points on THIS incident —
             brighter/bold when it was this driver themselves (the common
             case), dimmer when it was someone else and this driver is only
             tagged as involved (e.g. the other car in a contact incident
             that got judged in their favor). -->
        <div data-driver-panel="incidents" class="hidden">
        {driverIncidents.length === 0 ? (
          <p class="text-sm text-white/40">No incidents on file yet.</p>
        ) : (
          <div class="max-h-[32rem] overflow-auto">
            <table class="w-full border-collapse text-xs" data-sortable>
              <thead>
                <tr class="sticky top-0 z-10 border-b border-white/10 bg-brand-ink text-left text-[10px] uppercase tracking-wide text-white/30">
                  <th class="py-2 pl-2 pr-2 font-medium" data-sort-key="round">Round</th>
                  <th class="py-2 pr-2 font-medium" data-sort-key="penalized">Penalized</th>
                  <th class="py-2 pr-2 font-medium" data-sort-key="offenses">Offense(s)</th>
                  <th class="py-2 pr-2 text-center font-medium" data-sort-key="pp">PP</th>
                  <th class="py-2 pr-2 text-center font-medium" data-sort-key="time">Time</th>
                  <th class="py-2 pr-2 text-center font-medium" data-sort-key="pts">Pts</th>
                </tr>
              </thead>
              <tbody>
                {driverIncidents.map((row) => (
                  <tr class="border-b border-white/5">
                    <td class="py-2 pr-2" data-col="round" data-sort-value={row.startTime}>
                      <a href={`/results/${row.subsessionId}`} class="text-brand-primary hover:underline">
                        {row.displayRoundNumber !== null ? `Round ${row.displayRoundNumber}` : row.trackName}
                      </a>
                      <div class="text-[10px] text-white/40">{formatDateShort(row.startTime)}</div>
                    </td>
                    <td
                      class={row.driver?.id === driverId ? 'py-2 pr-2 font-semibold text-white/90' : 'py-2 pr-2 text-white/60'}
                      data-col="penalized"
                      data-sort-value={incidentDriverLabel(row)}
                    >
                      {incidentDriverLabel(row)}
                    </td>
                    <td class="py-2 pr-2 text-white/70" data-col="offenses" data-sort-value={row.offenseNames.join(', ')}>
                      {row.offenseNames.length > 0 ? row.offenseNames.join(', ') : '—'}
                    </td>
                    <td class="py-2 pr-2 text-center text-white/70" data-col="pp">{row.penaltyPoints || '—'}</td>
                    <td class="py-2 pr-2 text-center text-white/70" data-col="time">
                      {row.timePenaltySeconds ? `+${row.timePenaltySeconds}s` : '—'}
                    </td>
                    <td class="py-2 pr-2 text-center text-white/70" data-col="pts">{row.pointsPenalty || '—'}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        )}
        </div>
      </div>
    </div>

    <div class="flex flex-col gap-8">
      <!-- Awards (Hall of Fame pinned at the top, if applicable) -->
      <div class="reveal rounded-xl border border-white/10 bg-brand-ink p-4">
        <details class="group">
          <summary class="mb-3 flex cursor-pointer list-none items-center justify-between gap-2">
            <span class="flex items-center gap-2">
              <h2 class="font-display text-2xl">Awards</h2>
              <span class="font-display text-2xl text-white/40">{awardEntries.length + (isHallOfFame ? 1 : 0)}</span>
            </span>
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4 flex-none text-white/40 transition-transform group-open:rotate-90" aria-hidden="true">
              <polyline points="9 6 15 12 9 18" />
            </svg>
          </summary>
        {isHallOfFame && (
          <div class="mb-3 rounded-lg border border-brand-gold/30 bg-brand-gold/10 px-3 py-2 text-sm font-semibold uppercase tracking-wide text-brand-gold">
            Hall of Fame
          </div>
        )}
        {awardGroups.length === 0 ? (
          !isHallOfFame && <p class="text-sm text-white/40">No awards on file yet.</p>
        ) : (
          <div class="flex flex-col gap-4">
            {awardGroups.map((g) => (
              <div>
                <h3 class="mb-1.5 text-[10px] font-semibold uppercase tracking-wide text-white/40">{g.seasonName}</h3>
                <ul class="flex flex-col gap-1.5 text-xs">
                  {g.awards.map((a) => (
                    <li class="border-b border-white/5 pb-1.5 last:border-0 last:pb-0">
                      <!-- Same absolute-gutter trophy treatment as the Seasons table above — a reserved pl-4 gutter, not a flex sibling, so the label always starts at the same x whether or not this award gets a trophy. -->
                      <span class="relative inline-block pl-4 font-semibold text-white/90">
                        {a.className && (
                          <svg
                            xmlns="http://www.w3.org/2000/svg"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="2"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            class={`absolute left-0 top-1/2 h-3 w-3 flex-none -translate-y-1/2 ${classTextColorClass(a.className)}`}
                            aria-hidden="true"
                          >
                            <path d="M6 9H4.5a2.5 2.5 0 0 1 0-5H6" />
                            <path d="M18 9h1.5a2.5 2.5 0 0 0 0-5H18" />
                            <path d="M4 22h16" />
                            <path d="M10 14.66V17c0 .55-.47.98-.97 1.21C7.85 18.75 7 20.24 7 22" />
                            <path d="M14 14.66V17c0 .55.47.98.97 1.21C16.15 18.75 17 20.24 17 22" />
                            <path d="M18 2H6v7a6 6 0 0 0 12 0V2Z" />
                          </svg>
                        )}
                        {a.label}
                      </span>
                      {a.detail && <span class="ml-1.5 text-[10px] text-white/40">{a.detail}</span>}
                    </li>
                  ))}
                </ul>
              </div>
            ))}
          </div>
        )}
        </details>
      </div>

      <!-- Career Moves -->
      <div class="reveal rounded-xl border border-white/10 bg-brand-ink p-4">
        <details class="group">
          <summary class="mb-3 flex cursor-pointer list-none items-center justify-between gap-2">
            <span class="flex items-center gap-2">
              <h2 class="font-display text-2xl">Career Moves</h2>
              <span class="font-display text-2xl text-white/40">{careerMoves.length}</span>
            </span>
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4 flex-none text-white/40 transition-transform group-open:rotate-90" aria-hidden="true">
              <polyline points="9 6 15 12 9 18" />
            </svg>
          </summary>
        {careerMoves.length === 0 ? (
          <p class="text-sm text-white/40">No team history yet.</p>
        ) : (
          <div data-sticky-thead>
            <table class="w-full border-collapse text-xs">
              <thead>
                <tr class="border-b border-white/10 text-left text-[10px] uppercase tracking-wide text-white/30">
                  <th class="py-2 pr-2 font-medium">Season</th>
                  <th class="py-2 pr-2 font-medium">From</th>
                  <th class="py-2 pr-2 font-medium">To</th>
                </tr>
              </thead>
              <tbody>
                {careerMoves.map((m) => (
                  <tr class="border-b border-white/5">
                    <td class="py-2 pr-2 font-semibold text-white/90">{m.seasonName}</td>
                    <td class="py-2 pr-2 text-white/60">
                      <span class="flex items-center gap-1.5">
                        {m.fromLogoUrl && <TeamLogo name={m.from} logoUrl={m.fromLogoUrl} size="h-4 w-4" />}
                        {m.from}
                      </span>
                    </td>
                    <td class="py-2 pr-2 text-white/80">
                      <span class="flex items-center gap-1.5">
                        {m.toLogoUrl && <TeamLogo name={m.to} logoUrl={m.toLogoUrl} size="h-4 w-4" />}
                        {m.to}
                      </span>
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        )}
        </details>
      </div>

      <!-- Class Moves: same shape as Career Moves, but diffing each season's
           class instead of primary team — see this file's frontmatter for
           why the driver's debut season never gets an entry here. -->
      <div class="reveal rounded-xl border border-white/10 bg-brand-ink p-4">
        <details class="group">
          <summary class="mb-3 flex cursor-pointer list-none items-center justify-between gap-2">
            <span class="flex items-center gap-2">
              <h2 class="font-display text-2xl">Class Moves</h2>
              <span class="font-display text-2xl text-white/40">{classMoves.length}</span>
            </span>
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4 flex-none text-white/40 transition-transform group-open:rotate-90" aria-hidden="true">
              <polyline points="9 6 15 12 9 18" />
            </svg>
          </summary>
        {classMoves.length === 0 ? (
          <p class="text-sm text-white/40">No class changes yet.</p>
        ) : (
          <div data-sticky-thead>
            <table class="w-full border-collapse text-xs">
              <thead>
                <tr class="border-b border-white/10 text-left text-[10px] uppercase tracking-wide text-white/30">
                  <th class="py-2 pr-2 font-medium">Season</th>
                  <th class="py-2 pr-2 font-medium">From</th>
                  <th class="py-2 pr-2 font-medium">To</th>
                </tr>
              </thead>
              <tbody>
                {classMoves.map((m) => (
                  <tr class="border-b border-white/5">
                    <td class="py-2 pr-2 font-semibold text-white/90">{m.seasonName}</td>
                    <td class="py-2 pr-2 text-white/60">
                      <span class="flex items-center gap-1.5">
                        <span class={classTagShort(m.from)}>
                          {classBadgeLetter(m.from)}
                        </span>
                        {m.from}
                      </span>
                    </td>
                    <td class="py-2 pr-2 text-white/80">
                      <span class="flex items-center gap-1.5">
                        <span class={classTagShort(m.to)}>
                          {classBadgeLetter(m.to)}
                        </span>
                        {m.to}
                      </span>
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        )}
        </details>
      </div>
    </div>
  </div>

  <!-- Related News: every published post that tags this driver or links to
       a round they raced (see the isolated try/catch above) — same
       NewsCard component + 3-column grid the News page itself uses. -->
  <div class="reveal mt-8 border-t border-white/10 pt-8">
    <h2 class="font-display text-3xl">Related News</h2>
    {relatedPosts.length === 0 ? (
      <p class="mt-4 text-sm text-white/40">No related news yet.</p>
    ) : (
      <div class="mt-6 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {relatedPosts.map((post, i) => (
          <NewsCard post={post} index={i} logoBySeasonLabel={relatedLogoBySeasonLabel} tagsByPostId={relatedTagsByPostId} />
        ))}
      </div>
    )}
  </div>
  </>
)}
