                  <div class="overflow-x-auto border-t border-white/10 p-3">
                    <table class="w-full border-collapse text-xs" data-sortable>
                      <thead>
                        <tr class="border-b border-white/10 text-left text-[10px] uppercase tracking-wide text-white/30">
                          <th class="py-2 pr-2 font-medium" data-sort-key="label">{g.name}</th>
                          <th class="py-2 pr-2 text-center font-medium" data-sort-key="starts">Starts</th>
                          <th class="py-2 pr-2 text-center font-medium" data-sort-key="wins">Wins</th>
                          <th class="py-2 pr-2 text-center font-medium" data-sort-key="podiums">Podiums</th>
                          <th class="py-2 pr-2 text-center font-medium" data-sort-key="top5s">Top 5s</th>
                          <th class="py-2 pr-2 text-center font-medium" data-sort-key="avgFinish" title="Avg Finish">AVG F</th>
                          <th class="py-2 pr-2 text-center font-medium" data-sort-key="avgQualify" title="Avg Qualify">AVG Q</th>
                          <th class="py-2 pr-2 text-center font-medium" data-sort-key="cpi">CPI</th>
                          <th class="py-2 pr-2 text-center font-medium" data-sort-key="lapsLed">Led</th>
