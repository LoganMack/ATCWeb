---
export const prerender = false;

import TeamLogo from '../../../components/TeamLogo.astro';
import NewsCard from '../../../components/NewsCard.astro';
import {
  resolveSupabaseEnv,
  getDriverClasses,
  getSeasons,
  getStandingsExcludedRoundIds,
  getManualAwards,
  formatDateShort,
  getNewsPosts,
  getAllNewsPostDrivers,
  getAllNewsPostTags,
  type NewsPost,
  type NewsTag,
} from '../../../lib/supabase';
import {
  computeDriverCareerStats,
  getDriverRaceHistory,
  computeSeasonAwardsHistory,
  type DriverCareerStats,
  type DriverRaceHistoryRow,
} from '../../../lib/results';
import { classBadgeClasses, classBadgeLetter, classTextColorClass } from '../../../lib/classColors';

/**
 * The expensive part of the driver profile page — see drivers/[id].astro's
 * own doc comment for the full shell/fragment split explanation.
 * computeDriverCareerStats() in particular recomputes standings for every
 * driver across every season/class just to pick one driver's rows back out
 * (the same cost hall-of-fame/driver-stats already pay), which is what was
 * making this page slow.
 *
 * Returns a bare HTML fragment — no <Layout>, no header — meant only to be
 * dropped into drivers/[id].astro's results container via
 * `container.innerHTML = await res.text()`. Never linked to directly.
 */

const supabaseEnv = resolveSupabaseEnv(Astro.locals);
const driverId = String(Astro.params.id ?? '');
// Hall of Fame status is threaded through from the shell (drivers/[id].astro)
// as a query param rather than re-fetched here — this fragment has no
// access to that page's in-memory `driver` row (see this file's own doc
// comment above), and it's cheaper than a second profile lookup for one
// boolean. Shown as its own pinned row atop the Awards card below instead
// of a header badge.
const isHallOfFame = Astro.url.searchParams.get('hof') === '1';

let loadError: string | null = null;
let career: DriverCareerStats | null = null;
let raceHistory: DriverRaceHistoryRow[] = [];

// Related News (see the isolated try/catch near the end of the main block
// below, after raceHistory/seasons are both available) — every published
// post that either explicitly tags this driver or links to a round this
// driver actually raced.
let relatedPosts: NewsPost[] = [];
let relatedLogoBySeasonLabel = new Map<string, string>();
let relatedTagsByPostId = new Map<string, NewsTag[]>();

interface CareerMove {
  seasonName: string;
  from: string;
  to: string;
  fromLogoUrl: string | null;
  toLogoUrl: string | null;
}
const careerMoves: CareerMove[] = [];

interface ClassMove {
  seasonName: string;
  from: string;
  to: string;
}
const classMoves: ClassMove[] = [];

interface AwardEntry {
  seasonNumber: number;
  seasonName: string;
  label: string;
  detail: string | null;
  /** Set only on a "<Class> Champion" entry — drives the trophy icon shown next to it (see the Awards card template below), tinted via classTextColorClass. Every other award type leaves this null/undefined. */
  className?: string | null;
}
const awardEntries: AwardEntry[] = [];
interface AwardGroup {
  seasonNumber: number;
  seasonName: string;
  awards: AwardEntry[];
}

function trimNum(n: number, maxDecimals: number): string {
  const str = n.toFixed(maxDecimals);
  return str.includes('.') ? str.replace(/\.?0+$/, '').replace(/\.$/, '') : str;
}
function signedNum(n: number): string {
  const rounded = Math.round(n);
  return rounded > 0 ? `+${rounded}` : `${rounded}`;
}

try {
  const [classes, seasons, exhibitionRoundIds] = await Promise.all([
    getDriverClasses(supabaseEnv),
    getSeasons(supabaseEnv),
    getStandingsExcludedRoundIds(supabaseEnv),
  ]);

  const [careerStatsAll, history, seasonAwardsList, manualAwards] = await Promise.all([
    computeDriverCareerStats(supabaseEnv, seasons, classes, exhibitionRoundIds),
    getDriverRaceHistory(supabaseEnv, driverId),
    computeSeasonAwardsHistory(supabaseEnv, seasons),
    getManualAwards(supabaseEnv),
  ]);

  career = careerStatsAll.find((c) => c.driver.id === driverId) ?? null;
  raceHistory = history;

  // --- Career Moves: walk this driver's seasons oldest-first, recording
  // every time their PRIMARY team (highest racesUnderTeam that season —
  // getSeasonCarTeamStats already sorts teams[] descending by that, so
  // teams[0] is it) changed from the season before. "Independent" stands
  // in for no team on either side — an intra-season team switch can't be
  // ordered from this data (DriverTeamStat has no date field), so this is
  // season-granularity only, same limitation the season table itself has.
  if (career) {
    const chronological = [...career.seasons].sort((a, b) => a.season.number - b.season.number);
    let prevTeamName: string | null = null;
    let prevLogoUrl: string | null = null;
    for (const s of chronological) {
      const primary = s.teams[0] ?? null;
      const currentTeamName = primary?.teamName ?? null;
      const currentLogoUrl = primary?.logoUrl ?? null;
      if (currentTeamName !== prevTeamName) {
        careerMoves.push({
          seasonName: s.season.name,
          from: prevTeamName ?? 'Independent',
          to: currentTeamName ?? 'Independent',
          fromLogoUrl: prevLogoUrl,
          toLogoUrl: currentLogoUrl,
        });
        prevTeamName = currentTeamName;
        prevLogoUrl = currentLogoUrl;
      }
    }
    careerMoves.reverse(); // newest first, matching every other table on this page
  }

  // --- Class Moves: same walk as Career Moves above, but diffing each
  // season's class instead of primary team. Unlike Career Moves, the
  // driver's very first season on file does NOT get an entry here — that
  // table intentionally documents "joined as Independent -> Team X" on
  // debut, but a debut isn't a class *change*, so this list only starts
  // recording once there's an actual prior season to compare against.
  if (career) {
    const chronological = [...career.seasons].sort((a, b) => a.season.number - b.season.number);
    let prevClassName: string | null = null;
    chronological.forEach((s, i) => {
      if (i === 0) {
        prevClassName = s.className;
        return;
      }
      if (s.className !== prevClassName) {
        classMoves.push({ seasonName: s.season.name, from: prevClassName ?? '—', to: s.className });
        prevClassName = s.className;
      }
    });
    classMoves.reverse(); // newest first, matching every other table on this page
  }

  // --- Awards: championships + team championships (straight off this
  // driver's own season rows), the 12 auto-computed season awards
  // (filtered down to seasons this driver actually won), and the 2
  // steward-picked manual awards. Hall of Fame induction (isHallOfFame,
  // above) isn't season-scoped, so it's rendered as its own pinned row at
  // the top of the Awards card in the template below rather than grouped
  // into awardGroups here.
  if (career) {
    for (const s of career.seasons) {
      if (s.classPosition === 1) {
        awardEntries.push({ seasonNumber: s.season.number, seasonName: s.season.name, label: `${s.className} Champion`, detail: null, className: s.className });
      }
      if (s.teamPosition === 1) {
        awardEntries.push({
          seasonNumber: s.season.number,
          seasonName: s.season.name,
          label: 'Team Champion',
          detail: s.teams[0]?.teamName ?? null,
          // Tinted by this driver's OWN class that season (there's no
          // single "team class" to key off — a roster can mix classes) —
          // same trophy treatment as the class-championship entry above.
          className: s.className,
        });
      }
      if (s.deltaTeamPosition === 1) {
        awardEntries.push({
          seasonNumber: s.season.number,
          seasonName: s.season.name,
          label: 'Delta Team Champion',
          detail: s.teams[0]?.teamName ?? null,
          className: s.className,
        });
      }
    }
  }

  for (const sa of seasonAwardsList) {
    const seasonNumber = sa.season.number;
    const seasonName = sa.season.name;

    if (sa.rookieOfTheSeason?.drivers.some((d) => d.id === driverId)) {
      awardEntries.push({ seasonNumber, seasonName, label: 'Rookie of the Season', detail: `${trimNum(sa.rookieOfTheSeason.value, 1)} pts` });
    }
    if (sa.sublimeFinesse?.drivers.some((d) => d.id === driverId)) {
      awardEntries.push({ seasonNumber, seasonName, label: 'Sublime Finesse', detail: `${trimNum(sa.sublimeFinesse.value, 1)} corners/incident` });
    }
    if (sa.leader?.drivers.some((d) => d.id === driverId)) {
      awardEntries.push({ seasonNumber, seasonName, label: 'Leader', detail: `${trimNum(sa.leader.value, 0)} laps led` });
    }
    if (sa.ironman?.drivers.some((d) => d.id === driverId)) {
      awardEntries.push({ seasonNumber, seasonName, label: 'Ironman', detail: `${trimNum(sa.ironman.value, 1)} km` });
    }
    if (sa.consistency?.drivers.some((d) => d.id === driverId)) {
      awardEntries.push({ seasonNumber, seasonName, label: 'Consistency', detail: `${trimNum(sa.consistency.value, 2)} avg finish` });
    }
    if (sa.bonusFeature?.drivers.some((d) => d.id === driverId)) {
      awardEntries.push({ seasonNumber, seasonName, label: 'Bonus Feature', detail: `${trimNum(sa.bonusFeature.value, 1)} bonus pts` });
    }
    if (sa.nakedAggression?.drivers.some((d) => d.id === driverId)) {
      awardEntries.push({ seasonNumber, seasonName, label: 'Naked Aggression', detail: `${signedNum(sa.nakedAggression.value)} net positions` });
    }
    if (sa.speedDemon?.drivers.some((d) => d.id === driverId)) {
      const v = sa.speedDemon.value;
      awardEntries.push({ seasonNumber, seasonName, label: 'Speed Demon', detail: `${v} fastest lap${v === 1 ? '' : 's'}` });
    }
    if (sa.enduranceSpecialist?.drivers.some((d) => d.id === driverId)) {
      awardEntries.push({ seasonNumber, seasonName, label: 'Endurance Specialist', detail: `${trimNum(sa.enduranceSpecialist.value, 1)} pts` });
    }
    if (sa.sprintSpecialist?.drivers.some((d) => d.id === driverId)) {
      awardEntries.push({ seasonNumber, seasonName, label: 'Sprint Specialist', detail: `${trimNum(sa.sprintSpecialist.value, 1)} pts` });
    }
    for (const e of sa.dominator?.entries ?? []) {
      if (e.driver.id === driverId) {
        const marginText = `${(sa.dominator!.value / 10000).toFixed(3)}s`;
        const raceText = `${e.trackName}${e.raceNumber > 1 ? ` (Race ${e.raceNumber})` : ''}`;
        awardEntries.push({ seasonNumber, seasonName, label: 'Dominator', detail: `${marginText} — ${raceText}` });
      }
    }
    for (const e of sa.defender?.entries ?? []) {
      if (e.driver.id === driverId) {
        const marginText = `${(sa.defender!.value / 10000).toFixed(3)}s`;
        const raceText = `${e.trackName}${e.raceNumber > 1 ? ` (Race ${e.raceNumber})` : ''}`;
        awardEntries.push({ seasonNumber, seasonName, label: 'Defender', detail: `${marginText} — ${raceText}` });
      }
    }
  }

  for (const ma of manualAwards) {
    if (ma.driver_id !== driverId) continue;
    const season = seasons.find((s) => s.id === ma.season_id);
    awardEntries.push({
      seasonNumber: season?.number ?? -1,
      seasonName: season?.name ?? 'Unknown season',
      label: ma.award_key === 'best_racecraft' ? 'Best Racecraft' : 'Most Improved',
      detail: null,
    });
  }

  awardEntries.sort((a, b) => (b.seasonNumber - a.seasonNumber) || a.label.localeCompare(b.label));

  // --- Related News: isolated in its own try/catch (rather than just
  // living in this outer block) so a hiccup fetching news data can't take
  // down Seasons/Races/Splits/Awards/etc., none of which depend on it.
  // "Mentions this driver" covers two cases: the post explicitly tags them
  // (news_post_drivers, 0082_news_post_drivers.sql), or the post links to a
  // round (news_posts.round_subsession_id) that's one of THIS driver's own
  // raceHistory rows — i.e. the recap is about a round they actually raced,
  // rather than a literal text search of the live-computed recap's
  // highlighted names (top-3/fastest-lap/etc.), which would mean
  // recomputing every linked post's full recap (computeRoundRecap, ~8
  // queries each) on every driver page view just to check membership.
  try {
    const [allPosts, driverLinks, tagLinks] = await Promise.all([
      getNewsPosts(supabaseEnv),
      getAllNewsPostDrivers(supabaseEnv),
      getAllNewsPostTags(supabaseEnv),
    ]);
    const taggedPostIds = new Set(driverLinks.filter((l) => l.drivers?.id === driverId).map((l) => l.post_id));
    const racedSubsessionIds = new Set(raceHistory.map((r) => r.subsessionId));
    relatedPosts = allPosts
      .filter((p) => taggedPostIds.has(p.id) || (p.round_subsession_id !== null && racedSubsessionIds.has(p.round_subsession_id)))
      .sort((a, b) => new Date(b.published_at).getTime() - new Date(a.published_at).getTime());
    relatedLogoBySeasonLabel = new Map(seasons.filter((s) => s.logo_url).map((s) => [s.name, s.logo_url!]));
    for (const link of tagLinks) {
      if (!link.news_tags) continue;
      if (!relatedTagsByPostId.has(link.post_id)) relatedTagsByPostId.set(link.post_id, []);
      relatedTagsByPostId.get(link.post_id)!.push(link.news_tags);
    }
  } catch (err) {
    console.error('Failed to load related news for driver profile:', err);
  }
} catch (err) {
  console.error('Failed to load driver profile data:', err);
  loadError = err instanceof Error ? err.message : String(err);
}

// Awards are displayed grouped by season (one heading per season, its
// awards listed underneath) rather than repeating the season name on every
// row. awardEntries is already sorted newest-season-first, so grouping is
// just a run-length pass over consecutive matching seasonNumber/seasonName.
const awardGroups: AwardGroup[] = [];
for (const a of awardEntries) {
  const last = awardGroups[awardGroups.length - 1];
  if (last && last.seasonNumber === a.seasonNumber && last.seasonName === a.seasonName) {
    last.awards.push(a);
  } else {
    awardGroups.push({ seasonNumber: a.seasonNumber, seasonName: a.seasonName, awards: [a] });
  }
}

// How many of THIS driver's own races share a subsession_id — a round with
// more than one counts as a multi-race (sprint) round for them, so every
// race in it (including race 1) gets its own "(Race N)" suffix in the
// Races table below; a round where they only have one row shows just the
// round number, nothing to disambiguate.
const raceCountBySubsession = new Map<number, number>();
for (const r of raceHistory) {
  raceCountBySubsession.set(r.subsessionId, (raceCountBySubsession.get(r.subsessionId) ?? 0) + 1);
}

// --- Splits: raceHistory regrouped by Month / Round bucket / Car, each
// producing the same handful of aggregate stat columns. Built straight off
// raceHistory (no extra fetch) — every column here is something already on
// DriverRaceHistoryRow, aggregated per group rather than per race. "Starts"
// counts every race_scores row regardless of classified/DSQ status (same
// convention computeSeasonStandings uses — see its own "Starts, appearances,
// poles, and points come straight from race_scores" comment); Wins/Podiums/
// Top 5s/Avg Finish all exclude DSQ rows (a DSQ'd finishPosition is a
// fallback display value, not a real result — see the Races table's own
// `r.dsq ? 'DSQ' : r.finishPosition` rendering) but do NOT additionally
// exclude unclassified (NC) rows, since the Races table already shows an
// NC row's raw finishPosition as its result.
interface SplitRow {
  label: string;
  /** Set only on Car-split rows (the car's own logo) — used to show a small logo to the left of the car name in that split's table specifically. Undefined/null for every other split (Month/Round/Team/Layout). */
  logoUrl?: string | null;
  starts: number;
  wins: number;
  podiums: number;
  top5s: number;
  avgFinish: string;
  /** Average of qualPosition/classQualPosition (whichever this row's mode uses) across every race in the group that has one — races 2/3 of a round (no real qualifying, see DriverRaceHistoryRow.qualPosition's own doc comment) simply don't contribute a value, rather than dragging the average down with a fabricated one. "—" when nothing in the group qualified at all. */
  avgQualify: string;
  /** Corners-per-incident for the group — summed totalCorners across every race that resolved one, divided by summed incidents across ALL races in the group (same "sum first, divide once" approach aggregateDriverCareerStats uses for career CPI, rather than averaging each race's own ratio). "—" if no race in the group resolved a corner count, or there were 0 incidents to divide by. */
  cpi: string;
  lapsLed: number;
  points: number;
}
interface SplitGroup {
  name: string;
  rows: SplitRow[];
}

// The Splits card can rank Wins/Podiums/Top 5s/Avg Finish/Avg Qualify either
// OVERALL (raw cross-class running order, r.finishPosition/r.qualPosition) or
// by CLASS (this driver's own position within whichever class they ran that
// race, r.classPosition/r.classQualPosition — see their own doc comments in
// results.ts for why a Gamma/Delta driver's overall running order is a poor
// stand-in for their class result). The toggle in the template below
// switches between the two full precomputed row sets rather than re-deriving
// anything client-side — grouping (which month/round-bucket/car a race falls
// under) is identical either way, only the position used for ranking
// changes, so a month where this driver ran both Delta and Gamma still shows
// as ONE combined row in both modes, just scored differently.
function overallPos(r: DriverRaceHistoryRow): number {
  return r.finishPosition;
}
function classPos(r: DriverRaceHistoryRow): number {
  return r.classPosition ?? r.finishPosition;
}
function overallQualPos(r: DriverRaceHistoryRow): number | null {
  return r.qualPosition;
}
function classQualPos(r: DriverRaceHistoryRow): number | null {
  return r.classQualPosition ?? r.qualPosition;
}

function buildSplitRows(
  groups: Map<string, DriverRaceHistoryRow[]>,
  posFn: (r: DriverRaceHistoryRow) => number,
  qualPosFn: (r: DriverRaceHistoryRow) => number | null,
  order?: string[]
): SplitRow[] {
  const keys = order ? order.filter((k) => groups.has(k)) : [...groups.keys()];
  return keys.map((label) => {
    const rows = groups.get(label)!;
    const scored = rows.filter((r) => !r.dsq);
    const finishSum = scored.reduce((sum, r) => sum + posFn(r), 0);

    let totalIncidents = 0;
    let totalCorners = 0;
    let anyCornersResolved = false;
    for (const r of rows) {
      totalIncidents += r.incidents ?? 0;
      if (r.totalCorners !== null) {
        totalCorners += r.totalCorners;
        anyCornersResolved = true;
      }
    }

    const qualValues = rows.map(qualPosFn).filter((q): q is number => q !== null);

    return {
      label,
      starts: rows.length,
      wins: scored.filter((r) => posFn(r) === 1).length,
      podiums: scored.filter((r) => posFn(r) <= 3).length,
      top5s: scored.filter((r) => posFn(r) <= 5).length,
      avgFinish: scored.length > 0 ? (finishSum / scored.length).toFixed(1) : '—',
      avgQualify: qualValues.length > 0 ? (qualValues.reduce((a, b) => a + b, 0) / qualValues.length).toFixed(1) : '—',
      cpi: anyCornersResolved && totalIncidents > 0 ? (totalCorners / totalIncidents).toFixed(1) : '—',
      lapsLed: rows.reduce((sum, r) => sum + (r.lapsLed ?? 0), 0),
      points: rows.reduce((sum, r) => sum + r.totalPoints, 0),
    };
  });
}

const MONTH_NAMES = [
  'January', 'February', 'March', 'April', 'May', 'June',
  'July', 'August', 'September', 'October', 'November', 'December',
];
const monthGroups = new Map<string, DriverRaceHistoryRow[]>();
for (const r of raceHistory) {
  if (!r.startTime) continue;
  const label = MONTH_NAMES[new Date(r.startTime).getUTCMonth()];
  if (!monthGroups.has(label)) monthGroups.set(label, []);
  monthGroups.get(label)!.push(r);
}

// 1-3 / 4-6 / 7-9 / 10+ — a round with no display number (exhibition/test,
// or a non-championship season) can't be bucketed and is left out of this
// split entirely, same as it's left out of computeDisplayRoundNumbers'
// numbering in the first place.
const ROUND_BUCKETS = ['Rounds 1–3', 'Rounds 4–6', 'Rounds 7–9', 'Rounds 10+'];
function roundBucketLabel(n: number): string {
  if (n <= 3) return ROUND_BUCKETS[0];
  if (n <= 6) return ROUND_BUCKETS[1];
  if (n <= 9) return ROUND_BUCKETS[2];
  return ROUND_BUCKETS[3];
}
const roundGroups = new Map<string, DriverRaceHistoryRow[]>();
for (const r of raceHistory) {
  if (r.displayRoundNumber === null) continue;
  const label = roundBucketLabel(r.displayRoundNumber);
  if (!roundGroups.has(label)) roundGroups.set(label, []);
  roundGroups.get(label)!.push(r);
}

const carGroups = new Map<string, DriverRaceHistoryRow[]>();
for (const r of raceHistory) {
  const label = r.car?.name ?? 'Unknown';
  if (!carGroups.has(label)) carGroups.set(label, []);
  carGroups.get(label)!.push(r);
}

// Team split — grouped by the team this driver raced FOR in each individual
// race (race_scores.team_id, same per-race provenance DriverRaceHistoryRow.
// team already carries), not by season-roster membership. A race with no
// team assigned counts as "Independent" rather than being dropped, per the
// request that time spent as an independent get its own row.
const teamGroups = new Map<string, DriverRaceHistoryRow[]>();
for (const r of raceHistory) {
  const label = r.team?.name ?? 'Independent';
  if (!teamGroups.has(label)) teamGroups.set(label, []);
  teamGroups.get(label)!.push(r);
}

// Layout split — grouped by DriverRaceHistoryRow.layoutLabel (trackName plus
// this round's specific circuit_layouts configuration when curated_rounds.
// layout resolves one), so e.g. Monza's "Grand Prix" and "Junior" configs
// don't get lumped into one Monza row the way a plain track-name split would.
const layoutGroups = new Map<string, DriverRaceHistoryRow[]>();
for (const r of raceHistory) {
  const label = r.layoutLabel;
  if (!layoutGroups.has(label)) layoutGroups.set(label, []);
  layoutGroups.get(label)!.push(r);
}

// Alphabetical-by-name default order, for splits with no natural fixed
// ordering (unlike Month/Round, which use MONTH_NAMES/ROUND_BUCKETS) — this
// is just the ROWS' initial order; every column in the rendered table
// (including this one) is also click-to-sort via data-sortable, so a
// visitor can still re-sort by Starts/Wins/etc. `label` doesn't depend on
// posFn/qualPosFn, so row order is identical in both Overall/Class modes.
function buildUnorderedRows(
  groups: Map<string, DriverRaceHistoryRow[]>,
  posFn: (r: DriverRaceHistoryRow) => number,
  qualPosFn: (r: DriverRaceHistoryRow) => number | null
): SplitRow[] {
  return buildSplitRows(groups, posFn, qualPosFn).sort((a, b) => a.label.localeCompare(b.label));
}

// Car split rows additionally carry the car's own logo, for the small logo
// shown to the left of the car name in that split specifically.
function buildCarRows(posFn: (r: DriverRaceHistoryRow) => number, qualPosFn: (r: DriverRaceHistoryRow) => number | null): SplitRow[] {
  return buildUnorderedRows(carGroups, posFn, qualPosFn).map((row) => ({
    ...row,
    logoUrl: carGroups.get(row.label)?.[0]?.car?.logoUrl ?? null,
  }));
}

const splitGroupsOverall: SplitGroup[] = [
  { name: 'Month', rows: buildSplitRows(monthGroups, overallPos, overallQualPos, MONTH_NAMES) },
  { name: 'Round', rows: buildSplitRows(roundGroups, overallPos, overallQualPos, ROUND_BUCKETS) },
  { name: 'Car', rows: buildCarRows(overallPos, overallQualPos) },
  { name: 'Team', rows: buildUnorderedRows(teamGroups, overallPos, overallQualPos) },
  { name: 'Layout', rows: buildUnorderedRows(layoutGroups, overallPos, overallQualPos) },
];
const splitGroupsClass: SplitGroup[] = [
  { name: 'Month', rows: buildSplitRows(monthGroups, classPos, classQualPos, MONTH_NAMES) },
  { name: 'Round', rows: buildSplitRows(roundGroups, classPos, classQualPos, ROUND_BUCKETS) },
  { name: 'Car', rows: buildCarRows(classPos, classQualPos) },
  { name: 'Team', rows: buildUnorderedRows(teamGroups, classPos, classQualPos) },
  { name: 'Layout', rows: buildUnorderedRows(layoutGroups, classPos, classQualPos) },
];
---

{loadError && (
  <p class="mt-8 rounded-lg border border-brand-pink/30 bg-brand-pink/10 p-4 text-sm text-white/80">
    Couldn't load this driver's stats right now.
    <br /><span class="mt-1 block text-white/50">{loadError}</span>
  </p>
)}

{!loadError && (
  <>
  <div class="mt-8 grid gap-8 lg:grid-cols-3">
    <div class="flex flex-col gap-8 lg:col-span-2">
      <!-- Season stats -->
      <div class="reveal rounded-xl border border-white/10 bg-white/[0.03] p-4">
        <details class="group">
          <summary class="mb-3 flex cursor-pointer list-none items-center justify-between gap-2">
            <span class="flex items-center gap-2">
              <h2 class="font-display text-2xl">Seasons</h2>
              <span class="font-display text-2xl text-white/40">{career?.seasons.length ?? 0}</span>
            </span>
