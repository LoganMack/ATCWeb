---
export const prerender = false;
import LoadError from '../../components/LoadError.astro';
import { markUncacheable } from '../../lib/security';

// Public driver profile, reached from the Roster. Shell: fetches only the header's driver row and status,
// renders a skeleton, then loads drivers/[id]/fragment.astro for the tables.

import Layout from '../../layouts/Layout.astro';
import TeamLogo from '../../components/TeamLogo.astro';
import DriverFlag from '../../components/DriverFlag.astro';
import { resolveSupabaseEnv, getDriverProfileById } from '../../lib/db/client';
import { getSiteSettings } from '../../lib/db/assets';
import { getEvents } from '../../lib/db/events';
import {
  getDriverLastRace,
  resizedImageUrl,
  buildInactivityNote,
  roundsSinceDate,
  uploadDriverAvatar,
  updateMyDriverProfile,
  DRIVER_BIO_MAX,
  DRIVER_AVATAR_MAX_BYTES,
  DRIVER_AVATAR_TYPES,
} from '../../lib/db/drivers';
import { displayDriverName } from '../../lib/db/circuits';
import { getSeasons } from '../../lib/db/seasons';
import { getTeamRosterWithTeamsForSeason } from '../../lib/db/teams';
import { getOfficialRoundStartTimes } from '../../lib/results/rounds';
import { isOnProbationNow } from '../../lib/penalties/penaltyPoints';
import { classBadgeClasses, classBadgeLetter } from '../../lib/classColors';
import {
  PROBATION_DAYS_KEY,
  PROBATION_ROUNDS_KEY,
  INACTIVITY_DAYS_KEY,
  INACTIVITY_ROUNDS_KEY,
  siteSettingInt,
} from '../../lib/siteSettings';

const supabaseEnv = resolveSupabaseEnv(Astro.locals);
const driverId = String(Astro.params.id ?? '');

// A user linked to this driver can edit their own photo and bio
// (supabase/migrations/archive/0105_driver_self_service_profile.sql). Signed-in responses are never
// edge-cached (middleware.ts), so rendering the edit controls server-side is safe.
const session = Astro.locals.session;
const isOwner = Boolean(session && session.profile?.driver_id && session.profile.driver_id === driverId);

if (Astro.request.method === 'POST') {
  const back = (code: string) => Astro.redirect(`/drivers/${driverId}?${code}`, 303);
  if (!isOwner || !session) return Astro.redirect(`/drivers/${driverId}`, 303);
  try {
    const form = await Astro.request.formData();
    const bio = String(form.get('bio') ?? '').trim();
    if (bio.length > DRIVER_BIO_MAX) return back('profile_error=bio-too-long');

    let photoUrl: string | undefined;
    const photo = form.get('photo');
    if (photo instanceof File && photo.size > 0) {
      if (!DRIVER_AVATAR_TYPES[photo.type]) return back('profile_error=photo-type');
      if (photo.size > DRIVER_AVATAR_MAX_BYTES) return back('profile_error=photo-size');
      photoUrl = await uploadDriverAvatar(supabaseEnv, session.accessToken, driverId, photo);
    }
    await updateMyDriverProfile(supabaseEnv, session.accessToken, { bio: bio || null, photoUrl });
    return back('saved=1');
  } catch (err) {
    console.error('Failed to save driver profile:', err);
    return back('profile_error=failed');
  }
}

const PROFILE_ERRORS: Record<string, string> = {
  'bio-too-long': `Your bio can be at most ${DRIVER_BIO_MAX} characters.`,
  'photo-type': 'Profile photos must be PNG, JPG or WebP images.',
  'photo-size': `Profile photos can be at most ${DRIVER_AVATAR_MAX_BYTES / 1024 / 1024} MB.`,
  failed: "Couldn't save your profile. Try again in a moment.",
};
const profileFlash: { kind: 'ok' | 'error'; message: string } | null = !isOwner
  ? null
  : Astro.url.searchParams.get('saved')
    ? { kind: 'ok', message: 'Profile updated.' }
    : PROFILE_ERRORS[Astro.url.searchParams.get('profile_error') ?? '']
      ? { kind: 'error', message: PROFILE_ERRORS[Astro.url.searchParams.get('profile_error') ?? ''] }
      : null;

let loadError: string | null = null;
let driver: Awaited<ReturnType<typeof getDriverProfileById>> = null;

try {
  driver = await getDriverProfileById(supabaseEnv, driverId);
} catch (err) {
  console.error('Failed to load driver profile:', err);
  loadError = err instanceof Error ? err.message : String(err);
}

// No matching (or AI-flagged/excluded) driver — same "redirect back to the
// list" convention getRoundBySubsessionId's callers use for a missing round.
if (!loadError && !driver) {
  return Astro.redirect('/roster', 302);
}

let onProbationNow = false;
let statusTooltip: string | undefined;

if (!loadError && driver) {
  try {
    const [settings, events, officialRounds, lastRace, seasons] = await Promise.all([
      getSiteSettings(supabaseEnv),
      getEvents(supabaseEnv),
      getOfficialRoundStartTimes(supabaseEnv),
      getDriverLastRace(supabaseEnv, driverId),
      getSeasons(supabaseEnv),
    ]);
    const probationDays = siteSettingInt(settings, PROBATION_DAYS_KEY);
    const probationRounds = siteSettingInt(settings, PROBATION_ROUNDS_KEY);
    const inactivityDays = siteSettingInt(settings, INACTIVITY_DAYS_KEY);
    const inactivityRounds = siteSettingInt(settings, INACTIVITY_ROUNDS_KEY);
    onProbationNow = isOnProbationNow(driver, events, new Date(), probationDays, probationRounds);
    statusTooltip =
      buildInactivityNote(
        driver.driver_statuses?.name ?? null,
        lastRace,
        inactivityDays,
        inactivityRounds,
        driver.sign_up_date,
        // Officially scored rounds, as sync_driver_statuses() counts them, not the calendar events
        // isOnProbationNow() uses (see roundsSinceDate).
        driver.sign_up_date ? roundsSinceDate(officialRounds, driver.sign_up_date) : null
      ) ?? undefined;

    // The current season's team from team_rosters, not the possibly stale drivers.team_id; no roster entry
    // means Independent.
    const currentSeason = seasons.find((s) => s.is_current) ?? seasons[0];
    if (currentSeason) {
      const entries = await getTeamRosterWithTeamsForSeason(supabaseEnv, currentSeason.id);
      const mine = entries.find((e) => e.driver_id === driverId);
      driver.teams = mine?.teams ?? null;
    }
  } catch (err) {
    // Best-effort, same as roster.astro's identical fetch — a hiccup here
    // just means no probation badge/status breakdown text, not a broken page.
    console.error('Failed to load driver status info:', err);
  }
}

const HeaderTag = isOwner ? 'form' : 'div';
const displayName = driver ? displayDriverName(driver.name) : '';
const photoUrl = driver ? resizedImageUrl(driver.photo_url, { width: 320 }) : null;
const statusName = driver?.driver_statuses?.name ?? '—';
const className = driver?.driver_classes?.name ?? '';

Astro.response.headers.set('Cache-Control', 'public, s-maxage=60, stale-while-revalidate=300');
if (loadError) markUncacheable(Astro);
---

<Layout title={driver ? displayName : 'Driver'} description={driver ? `${displayName}'s driver profile, stats, and race history.` : 'Driver profile.'}>
  <section class="relative mx-auto max-w-7xl px-6 pb-24 pt-8">
    {loadError && <LoadError class="mt-0" />}

    {!loadError && driver && (
      <>
        {profileFlash && (
          <p class={`mb-4 rounded-lg border p-3 text-sm text-white/80 ${profileFlash.kind === 'ok' ? 'border-brand-primary/30 bg-brand-primary/10' : 'border-brand-pink/30 bg-brand-pink/10'}`}>
            {profileFlash.message}
          </p>
        )}
        <!-- Header. For the driver themselves this is a form: the nav's Edit button switches it into edit mode (see the script below). -->
        <HeaderTag
          class="reveal relative grid gap-6 rounded-xl border border-white/10 bg-brand-ink p-6 sm:grid-cols-[176px_1fr] sm:p-8"
          {...(isOwner ? { method: 'post', enctype: 'multipart/form-data', 'data-profile-form': '' } : {})}
        >
          <!-- Activity status, top right; hidden on mobile (Logan), where the name column has no gutter for it
               (sm:pr-32). -->
          <div class="absolute right-6 top-6 hidden flex-col items-end gap-1 text-right sm:right-8 sm:top-8 sm:flex">
            <div class="flex flex-wrap items-center justify-end gap-2">
              <span class="text-sm font-semibold text-white/90">{statusName}</span>
              {onProbationNow && (
                <span class="text-[10px] font-semibold uppercase tracking-wide text-brand-pink">Probation</span>
              )}
            </div>
            {statusTooltip && (
              // buildInactivityNote()'s shared "a; b; c" string (src/lib/db/drivers.ts), shown one segment
              // per line here only; other statuses have no semicolons and stay one line.
              <div class="max-w-[12rem]">
                {statusTooltip.split('; ').map((line) => (
                  <p class="text-xs text-white/40">{line}</p>
                ))}
                {statusName === 'Veteran' && <p class="text-xs text-white/40">Earned after 75 appearances.</p>}
              </div>
            )}
          </div>

          <div class="relative h-40 w-40 flex-none sm:h-44 sm:w-44">
            {photoUrl ? (
              <img src={photoUrl} alt={displayName} class="h-full w-full rounded-xl object-cover" />
            ) : (
              <div class="flex h-full w-full items-center justify-center rounded-xl bg-white/5 font-display text-5xl text-white/20">
                {driver.car_number !== null ? `#${driver.car_number}` : displayName.charAt(0)}
              </div>
            )}
            {isOwner && (
              <>
                <img data-photo-preview alt="" class="absolute inset-0 hidden h-full w-full rounded-xl object-cover" />
                {/* Edit mode only: click the photo to pick a new one. */}
                <label data-edit-only class="absolute inset-0 hidden cursor-pointer items-center justify-center rounded-xl bg-black/55 text-center text-sm font-semibold text-white transition hover:bg-black/65 focus-within:ring-2 focus-within:ring-brand-primary">
                  <span class="px-2">Click to change photo</span>
                  <input type="file" name="photo" accept="image/png,image/jpeg,image/webp" data-photo-input class="sr-only" />
                </label>
              </>
            )}
          </div>

          <div class="min-w-0 sm:pr-32">
            <div class="flex flex-wrap items-center gap-2">
              <h1 class="font-display text-4xl leading-none sm:text-5xl">
                {displayName}
                {driver.car_number !== null && <span class="whitespace-nowrap text-white/40">#{driver.car_number}</span>}
              </h1>
              {driver.is_rookie && (
                <span class="rounded bg-white/10 px-1.5 py-0.5 text-[10px] font-semibold uppercase tracking-wide text-white/60">Rookie</span>
              )}
            </div>

            <div class="mt-3 flex flex-wrap items-center gap-4 text-sm text-white/70">
              {className && (
                <span
                  class={`flex h-6 w-6 flex-none items-center justify-center text-xs font-bold ${classBadgeClasses(className)}`}
                  title={className}
                >
                  {classBadgeLetter(className)}
                </span>
              )}
              <DriverFlag nationality1={driver.nationality_1} nationality2={driver.nationality_2} showLabel />
              <span class="flex items-center gap-2">
                {driver.teams && <TeamLogo name={driver.teams.name} logoUrl={driver.teams.logo_url} size="h-6 w-6" />}
                <span>{driver.teams?.name ?? 'Independent'}</span>
              </span>
            </div>

            {driver.bio && <p data-view-only class="mt-4 max-w-2xl whitespace-pre-line text-sm text-white/70">{driver.bio}</p>}

            {isOwner && (
              <div data-edit-only class="mt-4 hidden max-w-2xl">
                <label class="flex flex-col gap-1.5 text-sm">
                  <span class="text-xs font-semibold uppercase tracking-wide text-white/40">Bio</span>
                  <textarea
                    name="bio"
                    rows="5"
                    maxlength={DRIVER_BIO_MAX}
                    data-bio-input
                    placeholder="Tell people a bit about yourself…"
                    class="w-full rounded-md border border-white/15 bg-transparent px-3 py-2 text-sm text-white outline-none hover:bg-white/5 focus:border-brand-primary focus:bg-white/5"
                  >{driver.bio ?? ''}</textarea>
                </label>
                <div class="mt-1 flex items-center justify-between gap-3 text-xs text-white/40">
                  <span data-photo-error class="text-brand-pink"></span>
                  <span><span data-bio-count>0</span> / {DRIVER_BIO_MAX}</span>
                </div>
                <div class="mt-4 flex gap-2">
                  <button type="submit" class="btn btn-primary">Save</button>
                  <button type="button" data-profile-cancel class="btn btn-neutral">Cancel</button>
                </div>
              </div>
            )}
          </div>
        </HeaderTag>

        <!-- The tables come from drivers/[id]/fragment.astro; Hall of Fame status is passed as a query
             param. -->
        <div data-driver-results data-fragment-url={`/drivers/${driverId}/fragment?hof=${driver.is_hall_of_fame ? 1 : 0}`}>
          <div class="mt-8 grid gap-8 lg:grid-cols-3" aria-live="polite" aria-busy="true">
            <span class="sr-only">Loading driver stats…</span>
            <!-- One skeleton block, not two — Seasons/Races/Splits/Bests now
                 render as a single tabbed card (see fragment.astro), not
                 separate stacked cards. -->
            <div class="flex flex-col gap-8 lg:col-span-2">
              <div class="h-[34rem] animate-pulse rounded-xl border border-white/10 bg-white/[0.03]"></div>
            </div>
            <div class="flex flex-col gap-8">
              <div class="h-40 animate-pulse rounded-xl border border-white/10 bg-white/[0.03]"></div>
              <div class="h-40 animate-pulse rounded-xl border border-white/10 bg-white/[0.02]"></div>
            </div>
          </div>
        </div>
      </>
    )}
  </section>

  <script>
    import { bindFragment } from '../../scripts/fragmentLoader';

    // Keeps the Splits Overall/Class <details> in step: toggling one sets its same-named counterpart. Setting
    // .open to its current value fires no event, so it doesn't loop.
    function initSplitsSync() {
      const overallRows = document.querySelector<HTMLElement>('[data-splits-rows="overall"]');
      const classRows = document.querySelector<HTMLElement>('[data-splits-rows="class"]');
      if (!overallRows || !classRows) return;
      if (overallRows.dataset.splitsSyncInit === 'true') return;
      overallRows.dataset.splitsSyncInit = 'true';

      overallRows.querySelectorAll<HTMLDetailsElement>('details[data-split-name]').forEach((el) => {
        const name = el.dataset.splitName;
        if (!name) return;
        const counterpart = classRows.querySelector<HTMLDetailsElement>(`details[data-split-name="${CSS.escape(name)}"]`);
        if (!counterpart) return;
        el.addEventListener('toggle', () => {
          counterpart.open = el.open;
        });
        counterpart.addEventListener('toggle', () => {
          el.open = counterpart.open;
        });
      });
    }

    bindFragment('[data-driver-results]', {
      label: 'Driver profile',
      logMessage: 'Failed to load driver profile data:',
      errorHtml:
        '<p class="mt-10 text-white/60">Couldn’t load this driver’s stats right now — try refreshing the page.</p>',
    });
    document.addEventListener('astro:page-load', initSplitsSync);

    // Own-profile editing. The nav's Edit button (only rendered on your own driver
    // page) toggles the header between view and edit mode; delegated listeners on
    // `document` so it keeps working across page swaps without rebinding.
    const AVATAR_TYPES = ['image/png', 'image/jpeg', 'image/webp'];
    const AVATAR_MAX_BYTES = 5 * 1024 * 1024;

    function profileForm(): HTMLFormElement | null {
      return document.querySelector<HTMLFormElement>('form[data-profile-form]');
    }
    function updateBioCount(form: HTMLFormElement) {
      const input = form.querySelector<HTMLTextAreaElement>('[data-bio-input]');
      const count = form.querySelector<HTMLElement>('[data-bio-count]');
      if (!input || !count) return;
      count.textContent = String(input.value.length);
      count.classList.toggle('text-brand-pink', input.value.length > input.maxLength);
    }
    function setProfileEditing(form: HTMLFormElement, editing: boolean) {
      form.querySelectorAll<HTMLElement>('[data-edit-only]').forEach((el) => {
        el.classList.toggle('hidden', !editing);
        // The photo overlay is a flex box when shown, everything else is block.
        if (el.tagName === 'LABEL') el.classList.toggle('flex', editing);
      });
      form.querySelectorAll<HTMLElement>('[data-view-only]').forEach((el) => el.classList.toggle('hidden', editing));
      document.querySelectorAll<HTMLElement>('[data-profile-edit-toggle]').forEach((b) => b.setAttribute('aria-pressed', String(editing)));
      form.dataset.editing = editing ? 'true' : 'false';
      if (editing) updateBioCount(form);
    }
    function resetProfileForm(form: HTMLFormElement) {
      form.reset();
      const preview = form.querySelector<HTMLImageElement>('[data-photo-preview]');
      if (preview) {
        if (preview.src.startsWith('blob:')) URL.revokeObjectURL(preview.src);
        preview.removeAttribute('src');
        preview.classList.add('hidden');
      }
      const err = form.querySelector<HTMLElement>('[data-photo-error]');
      if (err) err.textContent = '';
    }

    document.addEventListener('click', (e) => {
      const target = e.target as HTMLElement;
      const form = profileForm();
      if (!form) return;
      if (target.closest('[data-profile-edit-toggle]')) {
        const next = form.dataset.editing !== 'true';
        if (!next) resetProfileForm(form);
        setProfileEditing(form, next);
        return;
      }
      if (target.closest('[data-profile-cancel]')) {
        resetProfileForm(form);
        setProfileEditing(form, false);
      }
    });
    document.addEventListener('input', (e) => {
      const input = (e.target as HTMLElement).closest<HTMLTextAreaElement>('[data-bio-input]');
      const form = input?.closest<HTMLFormElement>('form[data-profile-form]');
      if (form) updateBioCount(form);
    });
    document.addEventListener('change', (e) => {
      const input = (e.target as HTMLElement).closest<HTMLInputElement>('[data-photo-input]');
      const form = input?.closest<HTMLFormElement>('form[data-profile-form]');
      if (!input || !form) return;
      const err = form.querySelector<HTMLElement>('[data-photo-error]');
      const preview = form.querySelector<HTMLImageElement>('[data-photo-preview]');
      const file = input.files?.[0];
      if (err) err.textContent = '';
      if (!file) return;
      if (!AVATAR_TYPES.includes(file.type)) {
        if (err) err.textContent = 'Photos must be PNG, JPG or WebP.';
        input.value = '';
        return;
      }
      if (file.size > AVATAR_MAX_BYTES) {
        if (err) err.textContent = 'Photos can be at most 5 MB.';
        input.value = '';
        return;
      }
      if (preview) {
        if (preview.src.startsWith('blob:')) URL.revokeObjectURL(preview.src);
        preview.src = URL.createObjectURL(file);
        preview.classList.remove('hidden');
      }
    });

    // The tab switch is a delegated listener here in the shell: the fragment's buttons don't exist yet, and
    // its scripts never run. Bound once at module scope.
    document.addEventListener('click', (e) => {
      const tab = (e.target as HTMLElement).closest<HTMLElement>('[data-driver-tab]');
      if (!tab) return;
      const widget = tab.closest<HTMLElement>('[data-driver-tabs]');
      if (!widget) return;
      const key = tab.dataset.driverTab;

      widget.querySelectorAll<HTMLElement>('[data-driver-tab]').forEach((t) => {
        const active = t === tab;
        t.setAttribute('aria-selected', active ? 'true' : 'false');
        t.dataset.active = active ? 'true' : 'false'; // .btn[data-active] styles the selected tab (global.css)
      });
      widget.querySelectorAll<HTMLElement>('[data-driver-panel]').forEach((panel) => {
        panel.classList.toggle('hidden', panel.dataset.driverPanel !== key);
      });
    });
  </script>
</Layout>
