---
export const prerender = false;

// Public driver profile page — reached by clicking a row on the Roster
// (see src/components/DriverRow.astro / src/pages/roster.astro).
//
// Same shell-then-spinner split as champions.astro/driver-stats.astro/
// team-stats.astro/hall-of-fame.astro (PERFORMANCE_AUDIT.md #5) — this page
// used to await computeDriverCareerStats() (every driver's whole
// season-by-season history, just to pick one out), getDriverRaceHistory(),
// and computeSeasonAwardsHistory() all right here in its own frontmatter,
// which blocked Astro's client router from swapping the DOM until every
// bit of that finished. This shell now only fetches what the HEADER needs
// (the driver's own profile row, plus their probation/inactivity status —
// all cheap, single-row-scoped queries) and renders a loading skeleton in
// place of the season/race/career-moves/awards tables. That expensive part
// moved to drivers/[id]/fragment.astro, fetched client-side by the
// <script> below once this shell has already painted.

import Layout from '../../layouts/Layout.astro';
import TeamLogo from '../../components/TeamLogo.astro';
import DriverFlag from '../../components/DriverFlag.astro';
import {
  resolveSupabaseEnv,
  getDriverProfileById,
  getSiteSettings,
  getEvents,
  getDriverLastRace,
  displayDriverName,
  resizedImageUrl,
  buildInactivityNote,
  getSeasons,
  getTeamRosterWithTeamsForSeason,
} from '../../lib/supabase';
import { isOnProbationNow } from '../../lib/penalties';
import { classBadgeClasses } from '../../lib/classColors';
import {
  PROBATION_DAYS_KEY,
  PROBATION_ROUNDS_KEY,
  INACTIVITY_DAYS_KEY,
  INACTIVITY_ROUNDS_KEY,
  siteSettingInt,
} from '../../lib/siteSettings';

const supabaseEnv = resolveSupabaseEnv(Astro.locals);
const driverId = String(Astro.params.id ?? '');

let loadError: string | null = null;
let driver: Awaited<ReturnType<typeof getDriverProfileById>> = null;

try {
  driver = await getDriverProfileById(supabaseEnv, driverId);
} catch (err) {
  console.error('Failed to load driver profile:', err);
  loadError = err instanceof Error ? err.message : String(err);
}

// No matching (or AI-flagged/excluded) driver — same "redirect back to the
// list" convention getRoundBySubsessionId's callers use for a missing round.
if (!loadError && !driver) {
  return Astro.redirect('/roster', 302);
}

let onProbationNow = false;
let statusTooltip: string | undefined;

if (!loadError && driver) {
  try {
    const [settings, events, lastRace, seasons] = await Promise.all([
      getSiteSettings(supabaseEnv),
      getEvents(supabaseEnv),
      getDriverLastRace(supabaseEnv, driverId),
      getSeasons(supabaseEnv),
    ]);
    const probationDays = siteSettingInt(settings, PROBATION_DAYS_KEY);
    const probationRounds = siteSettingInt(settings, PROBATION_ROUNDS_KEY);
    const inactivityDays = siteSettingInt(settings, INACTIVITY_DAYS_KEY);
    const inactivityRounds = siteSettingInt(settings, INACTIVITY_ROUNDS_KEY);
    onProbationNow = isOnProbationNow(driver, events, new Date(), probationDays, probationRounds);
    statusTooltip =
      buildInactivityNote(driver.driver_statuses?.name ?? null, lastRace, inactivityDays, inactivityRounds) ?? undefined;

    // Same fix as roster.astro: show this driver's real CURRENT-season team
    // (team_rosters), not the possibly-stale drivers.team_id getDriverProfileById
    // embeds — see getTeamRosterWithTeamsForSeason's doc comment for why the
    // two can drift. No team_rosters entry for the current season means
    // Independent, not a fallback to the stale value.
    const currentSeason = seasons.find((s) => s.is_current) ?? seasons[0];
    if (currentSeason) {
      const entries = await getTeamRosterWithTeamsForSeason(supabaseEnv, currentSeason.id);
      const mine = entries.find((e) => e.driver_id === driverId);
      driver.teams = mine?.teams ?? null;
    }
  } catch (err) {
    // Best-effort, same as roster.astro's identical fetch — a hiccup here
    // just means no probation badge/status breakdown text, not a broken page.
    console.error('Failed to load driver status info:', err);
  }
}

const displayName = driver ? displayDriverName(driver.name) : '';
const photoUrl = driver ? resizedImageUrl(driver.photo_url, { width: 320 }) : null;
const statusName = driver?.driver_statuses?.name ?? '—';
const className = driver?.driver_classes?.name ?? '';

Astro.response.headers.set('Cache-Control', 'public, s-maxage=60, stale-while-revalidate=300');
---

<Layout title={driver ? displayName : 'Driver'} description={driver ? `${displayName}'s driver profile, stats, and race history.` : 'Driver profile.'}>
  <section class="relative mx-auto max-w-7xl overflow-hidden px-6 pb-24 pt-28 sm:pt-36">
    {loadError && (
      <p class="rounded-lg border border-brand-pink/30 bg-brand-pink/10 p-4 text-sm text-white/80">
        Couldn't load this driver's profile right now.
        <br /><span class="mt-1 block text-white/50">{loadError}</span>
      </p>
    )}

    {!loadError && driver && (
      <>
        <!-- Header -->
        <div class="reveal grid gap-6 rounded-xl border border-white/10 bg-white/[0.03] p-6 sm:grid-cols-[176px_1fr] sm:p-8">
          {photoUrl ? (
            <img src={photoUrl} alt={displayName} class="h-40 w-40 flex-none rounded-xl object-cover sm:h-44 sm:w-44" />
          ) : (
            <div class="flex h-40 w-40 flex-none items-center justify-center rounded-xl bg-white/5 font-display text-5xl text-white/20 sm:h-44 sm:w-44">
              {driver.car_number !== null ? `#${driver.car_number}` : displayName.charAt(0)}
            </div>
          )}

          <div class="min-w-0">
            <div class="flex flex-wrap items-center gap-2">
              <h1 class="font-display text-4xl leading-none sm:text-5xl">
                {displayName} {driver.car_number !== null && <span class="text-white/40">#{driver.car_number}</span>}
              </h1>
              <DriverFlag nationality1={driver.nationality_1} nationality2={driver.nationality_2} />
              {driver.is_rookie && (
                <span class="rounded bg-white/10 px-1.5 py-0.5 text-[10px] font-semibold uppercase tracking-wide text-white/60">Rookie</span>
              )}
              {driver.is_hall_of_fame && (
                <span class="rounded bg-brand-gold/15 px-1.5 py-0.5 text-[10px] font-semibold uppercase tracking-wide text-brand-gold">
                  Hall of Fame
                </span>
              )}
            </div>

            <div class="mt-3 flex flex-wrap items-center gap-4 text-sm text-white/70">
              {className && (
                <span class={`rounded-lg border px-2 py-0.5 text-xs font-semibold uppercase tracking-wide ${classBadgeClasses(className)}`}>
                  {className}
                </span>
              )}
              <span class="flex items-center gap-2">
                {driver.teams && <TeamLogo name={driver.teams.name} logoUrl={driver.teams.logo_url} size="h-6 w-6" />}
                <span>{driver.teams?.name ?? 'Independent'}</span>
              </span>
            </div>

            <div class="mt-3 flex flex-col gap-1">
              <div class="flex flex-wrap items-center gap-2">
                <span class="text-sm font-semibold text-white/90">{statusName}</span>
                {onProbationNow && (
                  <span class="text-[10px] font-semibold uppercase tracking-wide text-brand-pink">Probation</span>
                )}
              </div>
              {statusTooltip && <p class="text-xs text-white/40">{statusTooltip}</p>}
            </div>

            {driver.bio && <p class="mt-4 max-w-2xl text-sm text-white/70">{driver.bio}</p>}
          </div>
        </div>

        <!-- Body: season/race/career-moves/awards tables live in
             drivers/[id]/fragment.astro — fetched client-side below. -->
        <div data-driver-results data-fragment-url={`/drivers/${driverId}/fragment`}>
          <div class="mt-8 grid gap-8 lg:grid-cols-3" aria-live="polite" aria-busy="true">
            <span class="sr-only">Loading driver stats…</span>
            <div class="flex flex-col gap-8 lg:col-span-2">
              <div class="h-64 animate-pulse rounded-xl border border-white/10 bg-white/[0.03]"></div>
              <div class="h-64 animate-pulse rounded-xl border border-white/10 bg-white/[0.02]"></div>
            </div>
            <div class="flex flex-col gap-8">
              <div class="h-40 animate-pulse rounded-xl border border-white/10 bg-white/[0.03]"></div>
              <div class="h-40 animate-pulse rounded-xl border border-white/10 bg-white/[0.02]"></div>
            </div>
          </div>
        </div>
      </>
    )}
  </section>

  <script>
    // Fetches drivers/[id]/fragment.astro (the expensive
    // computeDriverCareerStats/getDriverRaceHistory/computeSeasonAwardsHistory
    // work) client-side once this shell has already painted — see this
    // file's top-of-file comment and the fragment's own doc comment.
    function initDriverResults() {
      const container = document.querySelector<HTMLElement>('[data-driver-results]');
      const url = container?.dataset.fragmentUrl;
      if (!container || !url) return;
      // Cleared immediately, before the fetch even resolves — same guard
      // as every other history page's shell (this function re-runs on the
      // synthetic astro:page-load dispatched below once the fragment
      // lands, and without this it would refetch forever).
      delete container.dataset.fragmentUrl;

      fetch(url)
        .then((res) => {
          if (!res.ok) throw new Error(`Driver profile fragment request failed (${res.status})`);
          return res.text();
        })
        .then((html) => {
          container.innerHTML = html;
          // Same reasoning as hall-of-fame.astro/driver-stats.astro:
          // reveal.ts's IntersectionObserver only ever looked at what
          // existed in the DOM at the real astro:page-load — this content
          // lands well after that. Re-dispatching is the codebase's
          // established fix (see hard-form-submit.ts's doc comment).
          document.dispatchEvent(new Event('astro:page-load'));
        })
        .catch((err) => {
          console.error('Failed to load driver profile data:', err);
          container.innerHTML =
            '<p class="mt-10 text-white/60">Couldn’t load this driver’s stats right now — try refreshing the page.</p>';
        });
    }

    document.addEventListener('astro:page-load', initDriverResults);
  </script>
</Layout>
