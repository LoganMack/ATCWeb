---
import { ViewTransitions } from 'astro:transitions';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { THEME_INIT_SCRIPT } from '../lib/csp';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  /**
   * Absolute image URL for link previews; omitted rather than defaulted, since a generic logo on every embed
   * is worse than none. Only news posts pass one (the cover image).
   */
  image?: string | null;
  /** og:type — 'article' for a news post (also gets its own byline-less article treatment from some embedders), 'website' for everything else. */
  type?: 'website' | 'article';
  /** The shell's own `data-fragment-url`, character for character, so the preloaded response is reused. */
  preloadFragment?: string;
}

const {
  title,
  description = "iRacing's premier NA TCR series.",
  image = null,
  type = 'website',
  preloadFragment,
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <!-- Sets the light theme before the stylesheet paints, so returning light-mode visitors see no dark
         flash. View Transitions keep <html>, so it needn't re-run on navigation. -->
    <!-- The text lives in src/lib/csp.ts next to its CSP hash, so the two can't drift apart. -->
    <script is:inline set:html={THEME_INIT_SCRIPT} />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" sizes="16x16 32x32 48x48" />
    <link rel="icon" type="image/png" sizes="192x192" href="/favicon-192.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta name="description" content={description} />
    <title>{title} · Alpha Touring Challenge</title>

    <!-- Open Graph + Twitter Card for link previews. og:title is the bare title, since og:site_name
         carries the site name. og:url comes from the live request, so it's right on any deployment. -->
    <meta property="og:site_name" content="Alpha Touring Challenge" />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={Astro.url.href} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {image && <meta property="og:image" content={image} />}
    <meta name="twitter:card" content={image ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {image && <meta name="twitter:image" content={image} />}

    <!--
      Teko (display) + Roboto (body), self-hosted (the @font-face rules and licence notes are in
      src/styles/global.css). Preloading the latin files for headings and body text starts them with the HTML
      instead of after the stylesheet; crossorigin matches how fonts are fetched, so each downloads once.
      Persisted across client-side navigations, so the router does not re-add an already-used preload.
    -->
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      crossorigin
      href="/fonts/teko-latin-v1.woff2"
      data-astro-transition-persist="font-preload-teko"
    />
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      crossorigin
      href="/fonts/roboto-latin-v1.woff2"
      data-astro-transition-persist="font-preload-roboto"
    />
    <!-- A shell's fragment starts downloading now; fragmentLoader's fetch of the same URL then reuses it. -->
    {preloadFragment && <link rel="preload" as="fetch" crossorigin="anonymous" href={preloadFragment} />}

    <ViewTransitions />
  </head>
  <body>
    <Nav />
    <main>
      <slot />
    </main>
    <Footer />
    <!-- Site-wide scripts only. A script for one feature is imported by the pages that render its hook. -->
    <script src="../scripts/pageProgress.ts"></script>
    <script src="../scripts/reveal.ts"></script>
    <script src="../scripts/hard-form-submit.ts"></script>
    <script src="../scripts/sortable-table.ts"></script>
    <script src="../scripts/expandRows.ts"></script>
    <script src="../scripts/theme.ts"></script>
    <script src="../scripts/delegatedControls.ts"></script>
  </body>
</html>
