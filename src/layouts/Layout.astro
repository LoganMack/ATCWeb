---
import { ViewTransitions } from 'astro:transitions';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  /**
   * Absolute image URL for link-preview embeds (Discord, Slack, Twitter/X,
   * iMessage, …) — omitted (no og:image/twitter:image at all) rather than
   * falling back to a site-wide default, since a generic logo slapped on
   * every embed is worse than no image for a page that doesn't have one
   * (most pages). news/[slug].astro is the one caller that passes this
   * today (a post's cover_image_url, already an absolute Supabase storage
   * URL — see NewsPost's own doc comment).
   */
  image?: string | null;
  /** og:type — 'article' for a news post (also gets its own byline-less article treatment from some embedders), 'website' for everything else. */
  type?: 'website' | 'article';
}

const { title, description = "iRacing's premier NA TCR series.", image = null, type = 'website' } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" sizes="16x16 32x32 48x48" />
    <link rel="icon" type="image/png" sizes="192x192" href="/favicon-192.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta name="description" content={description} />
    <title>{title} · Alpha Touring Challenge</title>

    <!--
      Open Graph + Twitter Card — what a link-preview embed (Discord, Slack,
      Twitter/X, iMessage, etc.) actually reads, completely independent of
      the <title>/<meta name="description"> above (an embedder never renders
      those). og:title deliberately uses the bare `title` prop, not the
      "· Alpha Touring Challenge"-suffixed page <title> — og:site_name below
      already carries that, so suffixing both would just repeat it in the
      embed. `Astro.url.href` for og:url is the same "build it from the live
      request, never hardcode a domain" convention already used elsewhere on
      this site (see signup.astro/forgot-password.astro's Astro.url.origin
      usage) — correct in production and any preview/staging deploy alike.
    -->
    <meta property="og:site_name" content="Alpha Touring Challenge" />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={Astro.url.href} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {image && <meta property="og:image" content={image} />}
    <meta name="twitter:card" content={image ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {image && <meta name="twitter:image" content={image} />}

    <!--
      Fonts: Teko (display/headlines) + Roboto (body), loaded from Google
      Fonts. This needs no npm package and no local font files, so it works
      as soon as this deploys — see the licensing note in the README for why
      Teko stands in for Cuatra for now. If you'd rather self-host for
      privacy/perf reasons later, swap this for Fontsource packages.
    -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Roboto:wght@400;500;700&family=Teko:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />

    <ViewTransitions />
  </head>
  <body>
    <Nav />
    <main>
      <slot />
    </main>
    <Footer />
    <script src="../scripts/pageProgress.ts"></script>
    <script src="../scripts/reveal.ts"></script>
    <script src="../scripts/hard-form-submit.ts"></script>
    <script src="../scripts/sortable-table.ts"></script>
    <script src="../scripts/expandRows.ts"></script>
    <script src="../scripts/addToCalendar.ts"></script>
    <script src="../scripts/localTime.ts"></script>
    <script src="../scripts/lightbox.ts"></script>
    <script src="../scripts/tableCsvExport.ts"></script>
  </body>
</html>
