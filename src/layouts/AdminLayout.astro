---
// Shared chrome for /admin/* pages. src/middleware.ts already redirects non-admins, so the session here is a
// signed-in admin. The dashboard (/admin) links to every admin page, so the other pages carry only a link
// back to it (driver-profile-polish FR10.3).
import Layout from './Layout.astro';
import { userDisplayName } from '../lib/auth';

interface Props {
  title: string;
}

const { title } = Astro.props;
const session = Astro.locals.session;
const onDashboard = Astro.url.pathname.replace(/\/+$/, '') === '/admin';
---

<Layout title={`Admin · ${title}`}>
  <div class="mx-auto max-w-6xl px-6 pb-24 pt-28 sm:pt-36">
    <div class="reveal flex flex-wrap items-center justify-between gap-4 border-b border-white/10 pb-6">
      {!onDashboard && (
        <a
          href="/admin"
          class="text-sm font-semibold text-white/60 transition hover:text-white hover:underline"
          data-testid="admin-back-to-dashboard-link"
        >
          ← Back to dashboard
        </a>
      )}
      <div class="ml-auto flex items-center gap-3 text-sm text-white/60">
        <span>{userDisplayName(session?.profile, session?.user.email)}</span>
        <form method="POST" data-astro-reload action="/api/logout">
          <button
            type="submit"
            class="btn btn-neutral"
          >
            Log Out
          </button>
        </form>
      </div>
    </div>

    <div class="mt-10">
      <slot />
    </div>
  </div>
</Layout>
