---
// The own profile's editing tabs (U3 profile-settings; contract C4; mockups M6, M6a, M6b). Rendered only for
// the driver themselves, inside the profile form, so the five checkboxes are saved by Save Profile with the
// photo and bio; the email buttons act at once, in place (src/scripts/profileEditing.ts). U5 and U6 fill the
// Incident Management and Interviews panels.
import type { AccountSettingColumn, AccountSettings, InPlaceResult } from '../lib/driverAccount';
import type { IncidentManagementView } from '../lib/incidents';
import IncidentManagementPanel from './IncidentManagementPanel.astro';

interface Props {
  /** U5's Incident Management tab: the list (null when it couldn't be loaded) and a no-JavaScript result. */
  incidents: {
    view: IncidentManagementView | null;
    viewableIds: string[];
    notice: { ok: boolean; message: string } | null;
  };
  /** The tab shown first; a no-JavaScript incident action comes back on its own tab. */
  activeTab?: 'tab-privacy' | 'tab-notifications' | 'tab-incidents' | 'tab-interviews';
  email: string | null;
  pendingEmail: string | null;
  settings: AccountSettings;
  /** False when the saved choices couldn't be read: the boxes are disabled and Save keeps the stored values. */
  settingsLoaded: boolean;
  saveError: string | null;
  /** The no-JavaScript fallback's result of an email change or password reset. */
  emailNotice: InPlaceResult | null;
  passwordNotice: InPlaceResult | null;
}

const {
  email,
  pendingEmail,
  settings,
  settingsLoaded,
  saveError,
  emailNotice,
  passwordNotice,
  incidents,
  activeTab = 'tab-privacy',
} = Astro.props;
const panelClass = (id: string, layout: string) => (id === activeTab ? layout : `hidden ${layout}`);

const TABS = [
  { id: 'tab-privacy', label: 'Profile & Privacy Settings' },
  { id: 'tab-notifications', label: 'Email Notifications' },
  { id: 'tab-incidents', label: 'Incident Management' },
  { id: 'tab-interviews', label: 'Interviews' },
] as const;

type Setting = { name: AccountSettingColumn; label: string; help: string; note?: string };
const PRIVACY: Setting[] = [
  {
    name: 'hide_profile',
    label: 'Hide Profile from Anonymous Users',
    help: 'Only signed-in league drivers can see your profile.',
  },
  {
    name: 'hide_name',
    label: 'Hide Driver Name from Anonymous Users',
    help: 'Shows "Hidden Driver" instead of your name, photo and profile link to anyone not signed in as a league driver, including in news and incident text.',
    // BR9.8: free text is matched by name, not by driver.
    note: 'In news and incident text, another driver with exactly the same full name is hidden too.',
  },
];
const NOTIFICATIONS: Setting[] = [
  {
    name: 'notify_appeal_reviewed',
    label: 'Appeal Marked Reviewed',
    help: 'When admins finish reviewing an appeal you submitted.',
  },
  {
    name: 'notify_report_posted',
    label: 'Incident Report Posted',
    help: 'When the incident report is posted for a round you raced.',
  },
  { name: 'notify_event_reminders', label: 'Event Reminders', help: "12 hours before an event's first session starts." },
];

const inputClass =
  'rounded-md border border-white/15 bg-white/5 px-3 py-2 text-white outline-none focus:border-brand-primary';
const noticeClass = (notice: InPlaceResult | null) =>
  `text-sm ${notice && !notice.ok ? 'text-brand-pink' : 'text-white/70'}`;
---

<div data-profile-tabs-root class="mt-8 hidden">
  <p class="sr-only" aria-live="polite" data-profile-live></p>
  {saveError && (
    <p role="alert" data-profile-save-error class="mb-4 rounded-lg border border-brand-pink/30 bg-brand-pink/10 p-3 text-sm text-white/80">
      {saveError}
    </p>
  )}

  <div class="reveal rounded-xl border border-white/10 bg-brand-ink p-4">
    <div class="mb-3 flex flex-wrap gap-2" role="tablist" aria-label="Edit your profile" data-profile-tabs>
      {TABS.map((tab, i) => (
        <button
          type="button"
          role="tab"
          id={`${tab.id}-tab`}
          aria-controls={tab.id}
          aria-selected={tab.id === activeTab ? 'true' : 'false'}
          tabindex={tab.id === activeTab ? '0' : '-1'}
          data-active={tab.id === activeTab ? 'true' : 'false'}
          data-profile-tab={tab.id}
          data-testid={`profile-${tab.id}`}
          class="btn btn-neutral"
        >
          {tab.label}
        </button>
      ))}
    </div>
    <p data-profile-unsaved class="mb-3 hidden text-xs font-semibold text-brand-gold">Unsaved changes</p>

    <div role="tabpanel" id="tab-privacy" aria-labelledby="tab-privacy-tab" data-profile-panel="tab-privacy" class={panelClass('tab-privacy', 'flex flex-col gap-6')}>
      <section class="flex flex-col gap-2">
        <h2 class="font-display text-2xl">Email</h2>
        <p class="text-sm text-white/70">{email ?? 'This account has no email address.'}</p>
        {pendingEmail && (
          <p data-pending-email class="text-sm text-white/70">
            Waiting for you to confirm {pendingEmail}. Click the link we emailed there (and the one sent to your current
            address, if one arrived).
          </p>
        )}
        <div data-in-place="change-email" class="flex flex-col gap-2 sm:flex-row sm:items-end">
          <label class="flex flex-1 flex-col gap-1.5 text-sm">
            <span class="text-white/70">New email</span>
            <input
              type="email"
              name="new_email"
              autocomplete="email"
              maxlength="254"
              class={inputClass}
              data-testid="profile-new-email"
            />
          </label>
          <button
            type="submit"
            name="intent"
            value="change-email"
            formnovalidate
            class="btn btn-neutral"
            data-in-place-intent="change-email"
            data-testid="profile-change-email"
          >
            Send confirmation link
          </button>
        </div>
        <p class="text-xs text-white/40">ⓘ We'll email a link to the new address. Your email changes once you click it.</p>
        <p data-in-place-status="change-email" role="status" class={noticeClass(emailNotice)}>{emailNotice?.message}</p>
      </section>

      <section class="flex flex-col gap-2">
        <h2 class="font-display text-2xl">Password</h2>
        <div data-in-place="reset-password">
          <button
            type="submit"
            name="intent"
            value="reset-password"
            formnovalidate
            class="btn btn-neutral"
            data-in-place-intent="reset-password"
            data-testid="profile-reset-password"
          >
            Send password reset email
          </button>
        </div>
        <p data-in-place-status="reset-password" role="status" class={noticeClass(passwordNotice)}>{passwordNotice?.message}</p>
      </section>

      <section class="flex flex-col gap-3">
        <h2 class="font-display text-2xl">Privacy</h2>
        {!settingsLoaded && (
          <p role="alert" class="text-sm text-brand-pink">Couldn't load your settings. Try refreshing the page.</p>
        )}
        {PRIVACY.map((s) => (
          <div class="flex items-start gap-3">
            <input
              type="checkbox"
              id={`setting-${s.name}`}
              name={s.name}
              checked={settings[s.name]}
              disabled={!settingsLoaded}
              aria-describedby={`setting-${s.name}-help`}
              data-held-setting
              class="mt-1 accent-brand-primary"
            />
            <div>
              <label for={`setting-${s.name}`} class="text-sm font-semibold text-white/90">{s.label}</label>
              <p id={`setting-${s.name}-help`} class="text-xs text-white/40">{s.help}</p>
              {s.note && <p class="text-xs text-white/40" data-setting-note={s.name}>{s.note}</p>}
            </div>
          </div>
        ))}
        <p class="text-xs text-white/40">ⓘ Changes may take a few minutes to apply everywhere.</p>
        <p class="text-xs text-white/40">ⓘ A league driver is any account linked to a driver.</p>
      </section>
    </div>

    <div role="tabpanel" id="tab-notifications" aria-labelledby="tab-notifications-tab" data-profile-panel="tab-notifications" class={panelClass('tab-notifications', 'flex flex-col gap-3')}>
      {!settingsLoaded && (
        <p role="alert" class="text-sm text-brand-pink">Couldn't load your settings. Try refreshing the page.</p>
      )}
      {NOTIFICATIONS.map((s) => (
        <div class="flex items-start gap-3">
          <input
            type="checkbox"
            id={`setting-${s.name}`}
            name={s.name}
            checked={settings[s.name]}
            disabled={!settingsLoaded}
            aria-describedby={`setting-${s.name}-help`}
            data-held-setting
            class="mt-1 accent-brand-primary"
          />
          <div>
            <label for={`setting-${s.name}`} class="text-sm font-semibold text-white/90">{s.label}</label>
            <p id={`setting-${s.name}-help`} class="text-xs text-white/40">{s.help}</p>
          </div>
        </div>
      ))}
      <p class="text-sm text-white/70">{email ? `Emails go to ${email}.` : 'This account has no email address.'}</p>
    </div>

    <div role="tabpanel" id="tab-incidents" aria-labelledby="tab-incidents-tab" data-profile-panel="tab-incidents" class={panelClass('tab-incidents', 'flex flex-col gap-3')}>
      <IncidentManagementPanel view={incidents.view} viewableIds={incidents.viewableIds} notice={incidents.notice} />
    </div>

    <div role="tabpanel" id="tab-interviews" aria-labelledby="tab-interviews-tab" data-profile-panel="tab-interviews" class={panelClass('tab-interviews', 'flex flex-col gap-3')}>
      <p class="text-sm text-white/60">You haven't uploaded any interviews yet.</p>
    </div>
  </div>

  <dialog
    data-profile-discard-dialog
    aria-labelledby="profile-discard-title"
    class="w-full max-w-md rounded-xl border border-white/10 bg-brand-ink p-0 text-white backdrop:bg-black/60"
    data-testid="profile-discard-dialog"
  >
    <div class="flex flex-col gap-4 p-5">
      <h2 id="profile-discard-title" class="font-display text-2xl">Discard your unsaved changes?</h2>
      <p class="text-sm text-white/70">Your photo, bio and settings go back to what was last saved.</p>
      <div class="flex justify-end gap-2">
        <button type="button" class="btn btn-neutral" data-profile-keep-editing data-testid="profile-keep-editing">
          Keep editing
        </button>
        <button type="button" class="btn btn-danger" data-profile-discard data-testid="profile-discard">Discard</button>
      </div>
    </div>
  </dialog>
</div>
