---
// The shared Class filter (FR3.1, BR3.1): Overall, Combined, Alpha, Gamma, Delta from classFilterOptions,
// each option's value its destination address. By default the site-wide navigate-on-change handler follows
// it; Compare passes `compareNav` so its own script can carry the slot picks to the new address.
import type { ClassFilterOption } from '../lib/results/classFilter';

interface Props {
  options: ClassFilterOption[];
  compareNav?: boolean;
}

const { options, compareNav = false } = Astro.props;
---

<label class="flex flex-col gap-1.5 sm:w-44">
  <span class="text-xs font-semibold uppercase tracking-wide text-white/40">Class</span>
  <select
    aria-label="Class"
    class="h-9 w-full rounded-md border border-white/15 bg-transparent px-3 text-sm text-white outline-none hover:bg-white/5 focus:border-brand-primary focus:bg-white/5"
    data-navigate-on-change={compareNav ? undefined : ''}
    data-compare-nav={compareNav ? '' : undefined}
    data-testid="class-filter-select"
  >
    {options.map((o) => (
      <option value={o.href} selected={o.selected} class="bg-brand-ink text-white">{o.label}</option>
    ))}
  </select>
</label>
