---
// Plain inline SVG, no icon library dependency — matches the rest of the
// project's "no unnecessary dependencies" approach (see Nav.astro's
// hamburger icon for the same pattern).
//
// Bold outline, two-tone: the sun is always gold, rain is always blue, and
// clouds follow the page's text colour (so they stay readable in the light
// theme too); overcast is two clouds, the back one dimmer.
import { WEATHER_LABELS, type Weather } from '../lib/eventFormatting';

interface Props {
  condition: Weather | null;
  class?: string;
}

const { condition, class: className = '' } = Astro.props;
const label = condition ? WEATHER_LABELS[condition] : 'Not set';
---

{condition === 'clear' && (
  <svg
    role="img"
    aria-label={label}
    class={`inline-block ${className}`}
    xmlns="http://www.w3.org/2000/svg"
    viewBox="0 0 24 24"
    fill="none"
    stroke-width="2.2"
    stroke-linecap="round"
    stroke-linejoin="round"
    width="1em"
    height="1em"
  >
    <title>{label}</title>
    <g stroke="rgb(245 198 66)"><circle cx="12" cy="12" r="4" /><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41" /></g>
  </svg>
)}

{condition === 'partly_cloudy' && (
  <svg
    role="img"
    aria-label={label}
    class={`inline-block ${className}`}
    xmlns="http://www.w3.org/2000/svg"
    viewBox="0 0 24 24"
    fill="none"
    stroke-width="2.2"
    stroke-linecap="round"
    stroke-linejoin="round"
    width="1em"
    height="1em"
  >
    <title>{label}</title>
    <g stroke="rgb(245 198 66)"><circle cx="8.5" cy="8.5" r="3.2" /><path d="M8.5 1.8v1.4M2 8.5h1.4M3.9 3.9l1 1M13.1 3.9l-1 1" /></g>
    <path d="M18 21H9.5a5 5 0 1 1 1.4-9.8A5 5 0 0 1 18 11.5a4.75 4.75 0 0 1 0 9.5Z" stroke="currentColor" class="text-white/80" opacity="1" />
  </svg>
)}

{condition === 'overcast' && (
  <svg
    role="img"
    aria-label={label}
    class={`inline-block ${className}`}
    xmlns="http://www.w3.org/2000/svg"
    viewBox="0 0 24 24"
    fill="none"
    stroke-width="2.2"
    stroke-linecap="round"
    stroke-linejoin="round"
    width="1em"
    height="1em"
  >
    <title>{label}</title>
    <path d="M21 13h-5.5a3.5 3.5 0 0 1-.4-7A4.5 4.5 0 0 1 21 13Z" stroke="currentColor" class="text-white/80" opacity=".5" />
    <path d="M18 21H8a5 5 0 1 1 1.4-9.8A5 5 0 0 1 18 11.5a4.75 4.75 0 0 1 0 9.5Z" stroke="currentColor" class="text-white/80" opacity=".8" />
  </svg>
)}

{condition === 'raining' && (
  <svg
    role="img"
    aria-label={label}
    class={`inline-block ${className}`}
    xmlns="http://www.w3.org/2000/svg"
    viewBox="0 0 24 24"
    fill="none"
    stroke-width="2.2"
    stroke-linecap="round"
    stroke-linejoin="round"
    width="1em"
    height="1em"
  >
    <title>{label}</title>
    <path d="M18 15.5H8a4.5 4.5 0 1 1 1.3-8.8A5 5 0 0 1 18 7a4.25 4.25 0 0 1 0 8.5Z" stroke="currentColor" class="text-white/80" opacity="1" />
    <path d="M8 18.5l-1 3M12.5 18.5l-1 3M17 18.5l-1 3" stroke="rgb(67 105 245)" />
  </svg>
)}

{condition === 'mixed' && (
  <svg
    role="img"
    aria-label={label}
    class={`inline-block ${className}`}
    xmlns="http://www.w3.org/2000/svg"
    viewBox="0 0 24 24"
    fill="none"
    stroke-width="2.2"
    stroke-linecap="round"
    stroke-linejoin="round"
    width="1em"
    height="1em"
  >
    <title>{label}</title>
    <g stroke="rgb(245 198 66)"><circle cx="7" cy="7" r="2.6" /><path d="M7 1v1.2M1 7h1.2M2.8 2.8l.9.9M11.2 2.8l-.9.9" /></g>
    <path d="M19 16H10a3.8 3.8 0 1 1 1.1-7.4A4.5 4.5 0 0 1 19 10a3 3 0 0 1 0 6Z" stroke="currentColor" class="text-white/80" opacity="1" />
    <path d="M11 18.5l-.8 2.5M15 18.5l-.8 2.5" stroke="rgb(67 105 245)" />
  </svg>
)}

{!condition && <span class={`text-white/30 ${className}`} title="Not set">—</span>}
