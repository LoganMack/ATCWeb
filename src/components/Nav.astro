---
import { resolveSiteLinks } from '../lib/links';
import { isAdminView } from '../lib/auth';
import { resolveSupabaseEnv, getSeasons } from '../lib/supabase';
import { getLiveBannerInfo } from '../lib/liveEvent';
import SeasonLogo from './SeasonLogo.astro';

const { discordUrl, redbubbleUrl } = resolveSiteLinks(Astro.locals);

const RULEBOOK_URL = 'https://docs.google.com/document/d/1a05Enq9lvnon3qBNnxeHhCUFmlDlBXC0K3R9SXMKFoM/edit?usp=sharing';

const supabaseEnv = resolveSupabaseEnv(Astro.locals);

// "Happening Now" banner (attached to the bottom of this nav, below) — Nav
// renders on every single page via Layout.astro, so this has to be
// best-effort: a failure here degrades to "no banner," never a broken page.
// See src/lib/liveEvent.ts for how "currently happening" is determined.
const liveBannerPromise = getLiveBannerInfo(supabaseEnv).catch((err) => {
  console.error('Failed to compute the "Happening Now" nav banner:', err);
  return null;
});

// Top-left site logo: pulls from the current season's own logo (dark/light
// pair) when one is set, same best-effort shape as the banner above — Nav
// renders on every page, so a lookup failure here must degrade to the
// static fallback logo, never a broken page.
const currentSeasonPromise = getSeasons(supabaseEnv)
  .then((seasons) => seasons.find((s) => s.is_current) ?? null)
  .catch((err) => {
    console.error('Failed to load the current season for the nav logo:', err);
    return null;
  });

const [liveBanner, currentSeason] = await Promise.all([liveBannerPromise, currentSeasonPromise]);

// Falls back to the static logo file wholesale (both dark and light) unless
// the current season has actually set its own dark-mode logo — pairing a
// season's light-mode variant with the generic static dark fallback would
// be a mismatched set that was never actually uploaded together.
const navLogoDarkUrl = currentSeason?.logo_url ?? '/logos/atc18-white.png';
const navLogoLightUrl = currentSeason?.logo_url ? (currentSeason.logo_url_light ?? null) : null;

// Top-right button: a signed-in driver has already joined the league, so the
// Discord "Sign-Up" link becomes a link to their own driver page instead. A
// login that isn't linked to a roster driver (Admin > Users > Driver) may not
// have joined yet, so it still gets Sign-Up.
const myDriverId = Astro.locals.session?.profile?.driver_id ?? null;
// On your own driver page the profile icon becomes an Edit button (the page's own script toggles edit mode).
const onOwnProfile = Boolean(myDriverId) && Astro.url.pathname.replace(/\/+$/, '') === `/drivers/${myDriverId}`;
// Admin Panel shortcut beside the profile button. isAdminView, not isRealAdmin, so it hides while
// previewing as a visitor (the footer's View as Visitor toggle is what switches back).
const showAdminLink = isAdminView(Astro.locals);

// `menu` = a hover dropdown on the desktop nav (the mobile nav stays a flat list
// of the top-level links). `rounds` = the Results menu, whose rounds are fetched
// from /api/nav-rounds the first time it's hovered (see the script below).
type NavLink = { href: string; label: string; external?: boolean; menu?: { href: string; label: string }[]; rounds?: boolean };
const links: NavLink[] = [
  { href: '/news', label: 'News' },
  {
    href: '/calendar',
    label: 'Calendar',
    menu: [
      { href: '/calendar?view=list', label: 'List' },
      { href: '/calendar?view=calendar', label: 'Calendar' },
      { href: '/calendar?view=map', label: 'Map' },
    ],
  },
  { href: '/results', label: 'Results', rounds: true },
  {
    href: '/standings',
    label: 'Standings',
    menu: [
      { href: '/standings?championship=drivers', label: 'Drivers' },
      { href: '/standings?championship=teams', label: 'Teams' },
    ],
  },
  { href: '/roster', label: 'Drivers' },
  { href: '/teams', label: 'Teams' },
  {
    href: '/media',
    label: 'Media',
    menu: [
      { href: '/media?tab=videos', label: 'Video' },
      { href: '/media?tab=race-photos', label: 'Photos' },
      { href: '/media?tab=posters', label: 'Posters' },
      { href: '/media?tab=replays', label: 'Replays' },
      { href: '/media?tab=meetups', label: 'Meetups' },
    ],
  },
  {
    href: '/champions',
    label: 'History',
    menu: [
      { href: '/champions', label: 'Champions' },
      { href: '/driver-stats', label: 'Driver Stats' },
      { href: '/team-stats', label: 'Team Stats' },
      { href: '/hall-of-fame', label: 'Hall of Fame' },
      { href: '/awards', label: 'Awards' },
      { href: '/circuits', label: 'Circuits' },
      { href: '/incidents', label: 'Incidents' },
    ],
  },
  { href: RULEBOOK_URL, label: 'Rulebook', external: true },
  { href: redbubbleUrl, label: 'Shop', external: true },
];
---

<header class="sticky top-0 z-50 border-b border-white/10 bg-brand-ink/80 backdrop-blur">
  <div class="mx-auto flex max-w-6xl items-center justify-between gap-6 px-6 py-4">
    <a href="/" class="relative flex items-center" transition:name="site-logo">
      <SeasonLogo
        darkUrl={navLogoDarkUrl}
        lightUrl={navLogoLightUrl}
        alt="Alpha Touring Challenge"
        class="h-9 w-auto object-contain"
      />
      <span class="absolute -bottom-1 -right-2 rounded bg-brand-primary px-1 py-px text-[8px] font-display font-semibold uppercase leading-none tracking-wide text-white sm:-right-2.5 sm:text-[9px]">
        Beta
      </span>
    </a>

    {/* The full link row needs ~1000px, so below lg it collapses into the hamburger menu, and its gaps tighten until xl. */}
    <nav class="hidden items-center gap-5 font-display text-lg uppercase tracking-widest lg:flex xl:gap-8">
      {links.map((link) =>
        link.menu || link.rounds ? (
          // Hover/keyboard dropdown. The panel's outer wrapper adds top padding so
          // the pointer can travel from the link to the panel without leaving the
          // group, and there's deliberately no arrow next to the label.
          <div class="group relative" data-nav-menu data-nav-rounds-menu={link.rounds ? '' : undefined}>
            <a href={link.href} class="text-white/80 transition hover:text-white group-hover:text-white group-focus-within:text-white">
              {link.label}
            </a>
            <div class="invisible absolute left-0 top-full z-50 -ml-3 pt-3 opacity-0 transition duration-150 group-hover:visible group-hover:opacity-100 group-focus-within:visible group-focus-within:opacity-100">
              <div class="min-w-[11rem] rounded-[10px] border border-white/10 bg-brand-ink p-1.5 font-sans text-sm normal-case tracking-normal shadow-xl">
                {link.menu?.map((item) => (
                  <a href={item.href} class="block whitespace-nowrap rounded-md px-3 py-2 text-white/80 transition hover:bg-white/[0.06] hover:text-white">{item.label}</a>
                ))}
                {link.rounds && (
                  <div data-nav-rounds class="max-h-80 min-w-[17rem] overflow-y-auto">
                    <p class="px-3 py-2 text-white/40">Loading…</p>
                  </div>
                )}
              </div>
            </div>
          </div>
        ) : (
          <a
            href={link.href}
            target={link.external ? '_blank' : undefined}
            rel={link.external ? 'noopener noreferrer' : undefined}
            class="text-white/80 transition hover:text-white"
          >
            {link.label}
          </a>
        )
      )}
    </nav>

    <div class="flex items-center gap-2 sm:gap-3">
      {myDriverId ? (
        // Icon-only for a signed-in driver; "My Profile" shows on hover/keyboard focus (same tooltip look as the results page's icon buttons).
        <span class="group relative">
          {onOwnProfile ? (
            <button type="button" data-profile-edit-toggle aria-pressed="false" class="btn btn-primary !px-2.5" aria-label="Edit Profile">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-5 w-5" aria-hidden="true">
                <path d="M12 20h9" />
                <path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4Z" />
              </svg>
            </button>
          ) : (
            <a href={`/drivers/${myDriverId}`} class="btn btn-primary !px-2.5" aria-label="My Profile">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-5 w-5" aria-hidden="true">
                <path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2" />
                <circle cx="12" cy="7" r="4" />
              </svg>
            </a>
          )}
          <span class="pointer-events-none absolute left-1/2 top-full z-30 mt-1.5 w-max -translate-x-1/2 rounded-md bg-brand-ink px-2 py-1 text-[11px] font-semibold text-white opacity-0 shadow-lg ring-1 ring-white/15 transition-opacity group-hover:opacity-100 group-focus-within:opacity-100" role="tooltip">{onOwnProfile ? 'Edit Profile' : 'My Profile'}</span>
        </span>
      ) : (
        <a
          href={discordUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="btn btn-primary"
        >
          Sign-Up
        </a>
      )}

      {showAdminLink && (
        <span class="group relative">
          <a href="/admin" class="btn btn-neutral relative !px-2.5" aria-label="Admin Panel" data-admin-gear>
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-5 w-5" aria-hidden="true">
              <path d="M12.22 2h-.44a2 2 0 0 0-2 2v.18a2 2 0 0 1-1 1.73l-.43.25a2 2 0 0 1-2 0l-.15-.08a2 2 0 0 0-2.73.73l-.22.38a2 2 0 0 0 .73 2.73l.15.1a2 2 0 0 1 1 1.72v.51a2 2 0 0 1-1 1.74l-.15.09a2 2 0 0 0-.73 2.73l.22.38a2 2 0 0 0 2.73.73l.15-.08a2 2 0 0 1 2 0l.43.25a2 2 0 0 1 1 1.73V20a2 2 0 0 0 2 2h.44a2 2 0 0 0 2-2v-.18a2 2 0 0 1 1-1.73l.43-.25a2 2 0 0 1 2 0l.15.08a2 2 0 0 0 2.73-.73l.22-.39a2 2 0 0 0-.73-2.73l-.15-.08a2 2 0 0 1-1-1.74v-.5a2 2 0 0 1 1-1.74l.15-.09a2 2 0 0 0 .73-2.73l-.22-.38a2 2 0 0 0-2.73-.73l-.15.08a2 2 0 0 1-2 0l-.43-.25a2 2 0 0 1-1-1.73V4a2 2 0 0 0-2-2z" />
              <circle cx="12" cy="12" r="3" />
            </svg>
            {/* Pending sign-ups count, filled in by the script below from /api/pending-signups (#64). */}
            <span
              data-pending-signups-badge
              class="absolute -right-1.5 -top-1.5 hidden min-w-[1.1rem] rounded-full bg-brand-gold px-1 text-center text-[10px] font-bold leading-[1.1rem] text-brand-ink"
            ></span>
          </a>
          <span class="pointer-events-none absolute left-1/2 top-full z-30 mt-1.5 w-max -translate-x-1/2 rounded-md bg-brand-ink px-2 py-1 text-[11px] font-semibold text-white opacity-0 shadow-lg ring-1 ring-white/15 transition-opacity group-hover:opacity-100 group-focus-within:opacity-100" role="tooltip">Admin Panel</span>
        </span>
      )}

      <button
        type="button"
        id="mobile-nav-toggle"
        aria-expanded="false"
        aria-controls="mobile-nav"
        aria-label="Toggle navigation menu"
        class="btn btn-neutral h-9 w-9 !p-0 lg:hidden"
      >
        <svg id="icon-open" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" class="h-5 w-5">
          <line x1="3" y1="6" x2="21" y2="6"></line>
          <line x1="3" y1="12" x2="21" y2="12"></line>
          <line x1="3" y1="18" x2="21" y2="18"></line>
        </svg>
        <svg id="icon-close" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" class="hidden h-5 w-5">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
    </div>
  </div>

  {liveBanner && (
    // overflow-x-hidden ONLY (not the overflow-hidden shorthand, which also
    // clips the Y axis) — this bar only ever needs to clip horizontally for
    // the scroll effect; clipping Y too risked cutting the text off
    // vertically outright on any sub-pixel line-height/font-metric mismatch
    // (e.g. before the Teko webfont swaps in), which is exactly the "text
    // doesn't show up" symptom Logan reported.
    <div class="overflow-x-hidden bg-white" data-marquee-viewport>
      <a href="/calendar" class="group block py-2 transition hover:bg-black/5">
        <div
          class="flex w-max shrink-0 animate-marquee items-center whitespace-nowrap font-display text-base uppercase tracking-widest text-black group-hover:[animation-play-state:paused]"
          data-marquee-track
        >
          {/* Server-rendered as two copies for the seamless CSS-loop
              technique (see the animate-marquee keyframes in
              tailwind.config.mjs: the track is translated left by exactly
              -50% of its own width, and since both halves are identical,
              the loop never visibly "jumps"). That only holds up when a
              single copy is at least as wide as the visible strip — on a
              wide monitor with short banner text, two copies can be
              narrower than the window, so partway through the scroll
              there's simply no content left to show until the loop wraps
              back to the start (this is the "text doesn't scroll in, it
              just pops in once there's room" bug Logan reported). The
              client script below re-measures the real copy width against
              the real viewport width on load (and on resize, and again
              once webfonts finish swapping in) and clones this content as
              many times as needed per half so the track always has enough
              real content to fill the strip throughout the whole
              animation — this SSR-rendered pair is just the no-JS/
              first-paint fallback. Every copy beyond the first is marked
              aria-hidden so screen readers only ever read the banner once;
              shrink-0 on the track and each copy keeps every copy at its
              full natural width no matter what. */}
          {/* Segments are separated by 7 literal non-breaking spaces (not a
              visible glyph, and not the flex `gap` utility) per Logan —
              plain spaces would collapse under whitespace:nowrap same as
              they would in normal text, so this uses   (a non-breaking,
              non-collapsing space) repeated 7 times to get an exact, fixed
              gap. */}
          {[0, 1].map((copyIndex) => (
            <span class="flex shrink-0 items-center pr-3" aria-hidden={copyIndex === 1 ? 'true' : undefined}>
              <span class="pl-6 font-semibold">Happening Now</span>
              <span>{' '.repeat(7)}</span>
              <span>{liveBanner.roundLabel}</span>
              <span>{' '.repeat(7)}</span>
              <span>
                {liveBanner.sessionLabel} at {liveBanner.trackName}
                {liveBanner.layoutName && `, ${liveBanner.layoutName}`}
              </span>
              <span>{' '.repeat(7)}</span>
              <span data-live-remaining data-session-end={liveBanner.sessionEndUtcIso}>
                {liveBanner.remainingMinutes} minute{liveBanner.remainingMinutes === 1 ? '' : 's'} remaining
              </span>
              <span>{' '.repeat(7)}</span>
              <span>{liveBanner.nextSessionLabel ? `Next Session: ${liveBanner.nextSessionLabel}` : 'Final Session'}</span>
            </span>
          ))}
        </div>
      </a>
    </div>
  )}

  <nav
    id="mobile-nav"
    class="hidden flex-col border-t border-white/10 bg-brand-ink px-6 py-4 font-display text-lg uppercase tracking-widest lg:hidden"
  >
    {links.map((link) => (
      <a
        href={link.href}
        target={link.external ? '_blank' : undefined}
        rel={link.external ? 'noopener noreferrer' : undefined}
        class="border-b border-white/5 py-3 text-white/80 transition last:border-none hover:text-white"
      >
        {link.label}
      </a>
    ))}
  </nav>
</header>

<script>
  function initMobileNav() {
    const toggle = document.getElementById('mobile-nav-toggle');
    const panel = document.getElementById('mobile-nav');
    const iconOpen = document.getElementById('icon-open');
    const iconClose = document.getElementById('icon-close');
    if (!toggle || !panel || !iconOpen || !iconClose) return;
    // astro:page-load fires a second time on every page that loads its content
    // as a fragment (the loader scripts re-dispatch it), and without this
    // guard the toggle got a second click listener — two toggles per tap, so
    // the menu opened and instantly closed again.
    if (toggle.dataset.navInit === 'true') return;
    toggle.dataset.navInit = 'true';

    function setOpen(open: boolean) {
      panel!.classList.toggle('hidden', !open);
      panel!.classList.toggle('flex', open);
      iconOpen!.classList.toggle('hidden', open);
      iconClose!.classList.toggle('hidden', !open);
      toggle!.setAttribute('aria-expanded', String(open));
    }

    toggle.addEventListener('click', () => {
      setOpen(panel!.classList.contains('hidden'));
    });

    // Collapse the menu whenever a link inside it is used to navigate.
    panel.querySelectorAll('a').forEach((a) => {
      a.addEventListener('click', () => setOpen(false));
    });

    // Reset to closed on every page load (covers back/forward + view
    // transitions landing on a page with the menu previously left open).
    setOpen(false);
  }

  document.addEventListener('astro:page-load', initMobileNav);

  // Results dropdown: fetch the current season's rounds the first time the menu is
  // hovered or focused, then keep them for the rest of the visit. Delegated on the
  // document so it survives page swaps without rebinding.
  type NavRound = { id: number; round: number | null; track: string };
  let navRounds: NavRound[] | null = null;
  let navRoundsLoading = false;

  function renderNavRounds(list: HTMLElement, state: 'ok' | 'error') {
    list.replaceChildren();
    if (state === 'error' || !navRounds || navRounds.length === 0) {
      const p = document.createElement('p');
      p.className = 'px-3 py-2 text-white/40';
      p.textContent = state === 'error' ? "Couldn't load rounds." : 'No rounds yet.';
      list.appendChild(p);
      return;
    }
    for (const r of navRounds) {
      const a = document.createElement('a');
      a.href = `/results/${r.id}`;
      a.className = 'flex items-baseline gap-2.5 whitespace-nowrap rounded-md px-3 py-2 text-white/80 transition hover:bg-white/[0.06] hover:text-white';
      if (r.round !== null) {
        const num = document.createElement('span');
        num.className = 'min-w-[3.75rem] text-white/40';
        num.textContent = `Round ${r.round}`;
        a.appendChild(num);
      }
      const track = document.createElement('span');
      track.textContent = r.track;
      a.appendChild(track);
      list.appendChild(a);
    }
  }

  async function loadNavRounds(menu: HTMLElement) {
    const list = menu.querySelector<HTMLElement>('[data-nav-rounds]');
    if (!list) return;
    if (navRounds) {
      if (!list.dataset.rendered) {
        renderNavRounds(list, 'ok');
        list.dataset.rendered = 'true';
      }
      return;
    }
    if (navRoundsLoading) return;
    navRoundsLoading = true;
    try {
      const res = await fetch('/api/nav-rounds');
      if (!res.ok) throw new Error(String(res.status));
      navRounds = (await res.json()) as NavRound[];
      renderNavRounds(list, 'ok');
      list.dataset.rendered = 'true';
    } catch {
      renderNavRounds(list, 'error');
    } finally {
      navRoundsLoading = false;
    }
  }

  function onNavMenuIntent(e: Event) {
    const menu = (e.target as HTMLElement | null)?.closest?.<HTMLElement>('[data-nav-rounds-menu]');
    if (menu) void loadNavRounds(menu);
  }
  document.addEventListener('mouseover', onNavMenuIntent);
  document.addEventListener('focusin', onNavMenuIntent);

  // Admin Panel gear: a badge with the number of sign-up requests waiting on a
  // decision (#64). Only the gear's presence says the viewer is an admin, so
  // nothing is fetched for anyone else. Re-checked on every page load so it
  // drops once requests are handled; a failed fetch just leaves it hidden.
  async function loadPendingSignups() {
    const gear = document.querySelector<HTMLAnchorElement>('[data-admin-gear]');
    const badge = gear?.querySelector<HTMLElement>('[data-pending-signups-badge]');
    if (!gear || !badge || gear.dataset.pendingSignupsInit === 'true') return;
    gear.dataset.pendingSignupsInit = 'true';
    try {
      const res = await fetch('/api/pending-signups');
      if (!res.ok) return;
      const { count } = (await res.json()) as { count: number };
      if (!count) return;
      badge.textContent = count > 9 ? '9+' : String(count);
      badge.classList.remove('hidden');
      gear.setAttribute('aria-label', `Admin Panel (${count} pending sign-up${count === 1 ? '' : 's'})`);
    } catch {
      /* leave the badge hidden */
    }
  }
  document.addEventListener('astro:page-load', loadPendingSignups);

  // "Happening Now" banner: fills the marquee track with enough real
  // copies to cover any viewport width (see the long comment on the
  // data-marquee-track element in the markup above for why two static
  // copies alone aren't always enough), and drives the live countdown.
  //
  // The server only computes "which session, how many minutes remaining"
  // once per page render (see src/lib/liveEvent.ts), so without the
  // countdown timer below the number would just freeze until the
  // visitor's next navigation. Same data-attribute-driven pattern as
  // src/scripts/localTime.ts: the server embeds an absolute UTC
  // end-instant, and this just re-derives "remaining" from it on a timer
  // — re-queried fresh every tick (not a cached NodeList) since
  // layoutMarquee() below can change how many copies of that element
  // exist in the DOM at any moment.
  let liveBannerInterval: ReturnType<typeof setInterval> | undefined;
  let marqueeResizeTimeout: ReturnType<typeof setTimeout> | undefined;
  let marqueeResizeListenerAttached = false;

  function tickLiveBanner() {
    document.querySelectorAll<HTMLElement>('[data-live-remaining]').forEach((el) => {
      const endIso = el.dataset.sessionEnd;
      if (!endIso) return;
      const endMs = new Date(endIso).getTime();
      if (Number.isNaN(endMs)) return;
      const minutes = Math.max(0, Math.round((endMs - Date.now()) / 60_000));
      el.textContent = `${minutes} minute${minutes === 1 ? '' : 's'} remaining`;
    });
  }

  // Rebuilds the marquee track from scratch every time it's called, so
  // repeated calls (on resize, or once webfonts finish loading) stay
  // correct instead of compounding a previous rebuild's clones. Always
  // measures the CURRENT first child before touching the DOM — after the
  // very first run that's one of this function's own clones rather than
  // the server-rendered original, but it's an exact, still-attached,
  // still-correctly-laid-out copy of the same content, so it's just as
  // valid a template and measurement source as the original was.
  function layoutMarquee() {
    const track = document.querySelector<HTMLElement>('[data-marquee-track]');
    const viewport = document.querySelector<HTMLElement>('[data-marquee-viewport]');
    if (!track || !viewport || track.children.length === 0) return;

    const firstCopy = track.children[0] as HTMLElement;
    const copyWidth = firstCopy.getBoundingClientRect().width;
    const viewportWidth = viewport.getBoundingClientRect().width;
    if (!copyWidth || !viewportWidth) return;

    const template = firstCopy.cloneNode(true) as HTMLElement;
    template.removeAttribute('aria-hidden');

    // Each HALF of the track (not the whole track) needs to be at least
    // as wide as the visible strip — the CSS animation only ever
    // translates by -50%, i.e. by exactly one half's width — so there's
    // always real content on screen no matter where in the loop it is.
    const copiesPerHalf = Math.max(1, Math.ceil(viewportWidth / copyWidth));

    track.innerHTML = '';
    for (let half = 0; half < 2; half++) {
      for (let i = 0; i < copiesPerHalf; i++) {
        const clone = template.cloneNode(true) as HTMLElement;
        if (half !== 0 || i !== 0) clone.setAttribute('aria-hidden', 'true');
        track.appendChild(clone);
      }
    }

    tickLiveBanner();
  }

  function initLiveBanner() {
    if (liveBannerInterval) clearInterval(liveBannerInterval);
    if (!document.querySelector('[data-marquee-track]')) return;

    layoutMarquee();
    // A minute-granularity countdown doesn't need per-second polling —
    // 30s keeps the displayed number honest without any visible lag.
    liveBannerInterval = setInterval(tickLiveBanner, 30_000);

    // Google Fonts loads with display=swap (see Layout.astro), so the
    // very first layoutMarquee() call above may measure the fallback
    // font's (wider) metrics rather than Teko's real (narrower,
    // condensed) ones — re-measuring once fonts are actually ready
    // catches that instead of under-filling the track.
    if (document.fonts && document.fonts.ready) {
      document.fonts.ready.then(() => layoutMarquee());
    }

    // Attached once for the page's whole lifetime (not per navigation) —
    // Astro's view-transition navigations reuse the same `window` without
    // reloading it, so re-adding this on every astro:page-load would pile
    // up a new listener per navigation instead of replacing the old one.
    if (!marqueeResizeListenerAttached) {
      marqueeResizeListenerAttached = true;
      window.addEventListener('resize', () => {
        clearTimeout(marqueeResizeTimeout);
        marqueeResizeTimeout = setTimeout(layoutMarquee, 200);
      });
    }
  }

  document.addEventListener('astro:page-load', initLiveBanner);

  // Frozen table headers (src/styles/global.css: `[data-sticky-thead]
  // thead th`) stick just below THIS header as the page scrolls — but this
  // header's own real height isn't a fixed number: the "Happening Now"
  // banner above adds to it on some page loads and not others, and the
  // logo (h-9 vs h-11) changes size at the sm: breakpoint. Rather than
  // hardcode a value that would either leave a gap or let a frozen table
  // header sit half-covered depending on the page, this measures the
  // header's actual rendered height and exposes it as a CSS custom
  // property every table's sticky `top` reads. Re-measured on the same
  // triggers as layoutMarquee() above and for the same reasons: once
  // Google Fonts' display=swap finishes replacing the fallback font
  // metrics, and on resize (its own debounced listener, kept separate
  // from the marquee's own since that one is only attached when a live
  // banner is present — this needs to run on every page).
  let stickyOffsetResizeTimeout: ReturnType<typeof setTimeout> | undefined;
  let stickyOffsetResizeListenerAttached = false;

  function updateStickyHeaderOffset() {
    const header = document.querySelector('header');
    if (!header) return;
    const height = Math.ceil(header.getBoundingClientRect().height);
    document.documentElement.style.setProperty('--sticky-header-offset', `${height}px`);
  }

  function initStickyHeaderOffset() {
    updateStickyHeaderOffset();

    if (document.fonts && document.fonts.ready) {
      document.fonts.ready.then(() => updateStickyHeaderOffset());
    }

    if (!stickyOffsetResizeListenerAttached) {
      stickyOffsetResizeListenerAttached = true;
      window.addEventListener('resize', () => {
        clearTimeout(stickyOffsetResizeTimeout);
        stickyOffsetResizeTimeout = setTimeout(updateStickyHeaderOffset, 200);
      });
    }
  }

  document.addEventListener('astro:page-load', initStickyHeaderOffset);
</script>
