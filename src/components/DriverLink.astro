---
/**
 * A driver's name linking to /drivers/:id, styled to look exactly like the surrounding text (`.driver-link`).
 * Public pages only; never nest it inside another link or a button.
 */
export interface Props {
  /** The driver's id (drivers.id). With no id there's nothing to link to, so the name renders as plain text. */
  id: string | null | undefined;
}
const { id } = Astro.props;
---

{id ? <a href={`/drivers/${id}`} class="driver-link" title="Click to view profile"><slot /></a> : <slot />}
