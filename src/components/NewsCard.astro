---
import type { NewsPost } from '../lib/db/client';
import type { NewsTag } from '../lib/db/news';
import type { SeasonLogoPair } from '../lib/db/seasons';
import { formatDate } from '../lib/db/circuits';
import { resizedImageSrcset, resizedImageUrl } from '../lib/db/drivers';
import SeasonLogo from './SeasonLogo.astro';

interface Props {
  post: NewsPost;
  index?: number;
  featured?: boolean;
  /** season_label -> season logo pair, for the small logo next to the season tag. season_label is freeform text (see NewsPost's own doc comment), not an FK to `seasons`, so this is a best-effort name match built by the caller (see news/index.astro / index.astro) rather than a join. */
  logoBySeasonLabel?: Map<string, SeasonLogoPair>;
  /** post id -> its assigned tags (0055_news_tags.sql) — bulk-fetched once per page by the caller (getAllNewsPostTags(), grouped by post_id) and passed in here, same "fetch once, map by id" convention as logoBySeasonLabel. */
  tagsByPostId?: Map<string, NewsTag[]>;
  /** The cover's `sizes`; the default is a card in the News page's 1/2/3-column grid (px-6, gap-6). */
  sizes?: string;
  /** Load the cover eagerly at high priority: the first card a page shows near the top, often its largest paint. */
  priority?: boolean;
}

const {
  post,
  index = 0,
  featured = false,
  logoBySeasonLabel,
  tagsByPostId,
  sizes = '(min-width: 1024px) 400px, (min-width: 640px) calc(50vw - 36px), calc(100vw - 48px)',
  priority = false,
} = Astro.props;

// Covers are uploaded up to 2048px wide; the srcset lets each card fetch about its drawn width instead.
const COVER_WIDTHS = [320, 480, 640, 960, 1280];
// The featured card's cover is half of max-w-6xl beside the text from sm up, full width below.
const coverSizes = featured ? '(min-width: 1152px) 552px, (min-width: 640px) calc(50vw - 24px), calc(100vw - 48px)' : sizes;
const coverSrcset = resizedImageSrcset(post.cover_image_url, COVER_WIDTHS);
const coverSrc = resizedImageUrl(post.cover_image_url, { width: 960 });

const date = formatDate(post.published_at);
const seasonLogo = post.season_label ? logoBySeasonLabel?.get(post.season_label) : undefined;
const tags = tagsByPostId?.get(post.id) ?? [];
---

<a
  href={`/news/${post.slug}`}
  class={`reveal group block overflow-hidden rounded-xl border border-white/10 bg-brand-ink transition hover:border-white/20 hover:bg-white/[0.03] ${
    featured ? 'sm:flex sm:flex-row' : ''
  }`}
  style={`transition-delay: ${Math.min(index, 4) * 30}ms`}
>
  {post.cover_image_url && (
    <div class={featured ? 'aspect-[16/9] w-full overflow-hidden sm:aspect-auto sm:w-1/2' : 'aspect-[16/9] w-full overflow-hidden'}>
      <img
        src={coverSrc}
        srcset={coverSrcset ?? undefined}
        sizes={coverSrcset ? coverSizes : undefined}
        alt={post.title}
        class="h-full w-full object-cover transition duration-500 group-hover:scale-105"
        loading={priority ? 'eager' : 'lazy'}
        fetchpriority={priority ? 'high' : undefined}
      />
    </div>
  )}
  <div class={featured ? 'flex flex-col justify-center p-6 sm:w-1/2 sm:p-8' : 'p-6'}>
    <p class="flex flex-wrap items-center gap-2 text-xs uppercase tracking-widest text-white/50">
      <span>{date}</span>
      {post.season_label && (
        <span class="flex items-center gap-1 rounded bg-white/10 px-1.5 py-0.5 text-[10px] font-semibold text-white/50">
          {post.season_label}
          {seasonLogo && <SeasonLogo darkUrl={seasonLogo.dark} lightUrl={seasonLogo.light} class="h-3 w-3 flex-none rounded-sm object-contain" />}
        </span>
      )}
      {post.round_subsession_id !== null && (
        <span class="rounded bg-brand-primary/15 px-1.5 py-0.5 text-[10px] font-semibold text-brand-primary">RESULTS</span>
      )}
      {tags.map((tag) => (
        <span class="rounded bg-white/10 px-1.5 py-0.5 text-[10px] font-semibold text-white/50">{tag.name}</span>
      ))}
    </p>
    <h3 class={featured ? 'mt-2 font-display text-3xl sm:text-4xl' : 'mt-2 font-display text-2xl'}>{post.title}</h3>
    {post.excerpt && <p class="mt-2 text-white/70">{post.excerpt}</p>}
  </div>
</a>
