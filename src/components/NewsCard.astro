---
import type { NewsPost, NewsTag } from '../lib/supabase';
import { formatDate } from '../lib/supabase';

interface Props {
  post: NewsPost;
  index?: number;
  featured?: boolean;
  /** season_label -> season logo_url, for the small logo next to the season tag. season_label is freeform text (see NewsPost's own doc comment), not an FK to `seasons`, so this is a best-effort name match built by the caller (see news/index.astro / index.astro) rather than a join. */
  logoBySeasonLabel?: Map<string, string>;
  /** post id -> its assigned tags (0055_news_tags.sql) — bulk-fetched once per page by the caller (getAllNewsPostTags(), grouped by post_id) and passed in here, same "fetch once, map by id" convention as logoBySeasonLabel. */
  tagsByPostId?: Map<string, NewsTag[]>;
}

const { post, index = 0, featured = false, logoBySeasonLabel, tagsByPostId } = Astro.props;

const date = formatDate(post.published_at);
const seasonLogoUrl = post.season_label ? logoBySeasonLabel?.get(post.season_label) : undefined;
const tags = tagsByPostId?.get(post.id) ?? [];
---

<a
  href={`/news/${post.slug}`}
  class={`reveal group block overflow-hidden rounded-xl border border-white/10 bg-white/[0.03] transition hover:border-white/20 hover:bg-white/[0.06] ${
    featured ? 'sm:flex sm:flex-row' : ''
  }`}
  style={`transition-delay: ${Math.min(index, 4) * 30}ms`}
>
  {post.cover_image_url && (
    <div class={featured ? 'aspect-[16/9] w-full overflow-hidden sm:aspect-auto sm:w-1/2' : 'aspect-[16/9] w-full overflow-hidden'}>
      <img
        src={post.cover_image_url}
        alt={post.title}
        class="h-full w-full object-cover transition duration-500 group-hover:scale-105"
        loading="lazy"
      />
    </div>
  )}
  <div class={featured ? 'flex flex-col justify-center p-6 sm:w-1/2 sm:p-8' : 'p-6'}>
    <p class="flex flex-wrap items-center gap-2 text-xs uppercase tracking-widest text-white/50">
      <span>{date}</span>
      {post.season_label && (
        <span class="flex items-center gap-1 rounded bg-white/10 px-1.5 py-0.5 text-[10px] font-semibold text-white/50">
          {post.season_label}
          {seasonLogoUrl && <img src={seasonLogoUrl} alt="" class="h-3 w-3 flex-none rounded-sm object-contain" />}
        </span>
      )}
      {post.round_subsession_id !== null && (
        <span class="rounded bg-brand-primary/15 px-1.5 py-0.5 text-[10px] font-semibold text-brand-primary">RESULTS</span>
      )}
      {tags.map((tag) => (
        <span class="rounded bg-white/10 px-1.5 py-0.5 text-[10px] font-semibold text-white/50">{tag.name}</span>
      ))}
    </p>
    <h3 class={featured ? 'mt-2 font-display text-3xl sm:text-4xl' : 'mt-2 font-display text-2xl'}>{post.title}</h3>
    {post.excerpt && <p class="mt-2 text-white/70">{post.excerpt}</p>}
  </div>
</a>
