---
import type { EventWithCircuit, CircuitLayout } from '../lib/supabase';
import { displayLayoutName, formatDate, eventImageUrl, resizedImageUrl } from '../lib/supabase';
import {
  formatEventDate,
  formatSessionTime,
  FORMAT_BADGE_CLASSES,
  FORMAT_LABELS,
  CATEGORY_BADGE_CLASSES,
  CATEGORY_LABELS,
  getEventSessions,
} from '../lib/eventFormatting';
import type { LayoutRoundSummary, RoundSummary } from '../lib/results';
import { buildEventIcsBlock } from '../lib/ics';
import { slugify } from '../lib/slug';
import WeatherIcon from './WeatherIcon.astro';

interface Props {
  event: EventWithCircuit;
  index?: number;
  /**
   * Every historical round ever run at this event's own circuit+layout,
   * newest first — see src/lib/results.ts's findRoundsForLayout(). Computed
   * ONCE per page (calendar.astro) and passed in per card rather than
   * fetched here, since a page can show many cards that repeat the same
   * circuit. Optional/omittable for any future caller that doesn't have
   * this data on hand — the collapsible below simply doesn't render without
   * it, same as any other optional section on this card.
   */
  layoutRounds?: LayoutRoundSummary[];
  /**
   * Which curated_rounds row this specific event represents, if any — see
   * getEventRound()'s own doc comment in src/lib/results.ts for how this
   * resolves (season_id+round_number auto-match, or the subsession_id
   * manual override). Null for an event with no season/round set, one
   * that's upcoming, or one whose round hasn't had results imported yet.
   * Computed by the caller (calendar.astro), same "once per page, not once
   * per card" reasoning as layoutRounds above.
   */
  linkedRound?: RoundSummary | null;
  /**
   * Every circuit_layouts row on file — used to look up this event's own
   * layout image (by circuit_id + layout name, since events.layout has no
   * FK) so it can take priority over the circuit's generic logo. Same
   * "computed/fetched once per page, passed in per card" reasoning as
   * layoutRounds above. Optional — falls back to just the circuit logo
   * (the old behavior) if a caller doesn't have this on hand.
   */
  layouts?: Pick<CircuitLayout, 'circuit_id' | 'name' | 'image_url'>[];
}

const { event, index = 0, layoutRounds = [], linkedRound = null, layouts = [] } = Astro.props;
const sessions = getEventSessions(event);
const imageUrl = resizedImageUrl(eventImageUrl(event, event.circuits, layouts), { width: 96 });

// "Add to Calendar" only makes sense for an event that hasn't happened yet
// — same plain string comparison calendar.astro's own upcoming/past split
// uses, since event_date is always 'YYYY-MM-DD'.
const todayStr = new Date().toISOString().slice(0, 10);
const isUpcoming = event.event_date >= todayStr;
const icsBlock = isUpcoming ? buildEventIcsBlock(event, layouts) : null;
const icsFilename = `atc-${slugify(event.circuits?.name ?? 'event')}-${event.event_date}.ics`;
---

<article
  class="reveal rounded-xl border border-white/10 bg-white/[0.03] p-6"
  style={`transition-delay: ${Math.min(index, 4) * 30}ms`}
  data-event-date={event.event_date}
>
  <div class="flex flex-wrap items-start justify-between gap-4">
    <div class="flex items-center gap-4">
      {imageUrl && (
        <img src={imageUrl} alt="" loading="lazy" class="h-12 w-12 flex-none rounded object-contain" />
      )}
      <div>
        <h3 class="font-display text-2xl leading-none">{event.circuits?.name ?? 'TBA'}</h3>
        {event.layout && <p class="mt-1 text-sm text-white/50">{displayLayoutName(event.layout)}</p>}
        {event.season_id && event.round_number !== null && (
          <p class="mt-1 text-sm text-white/50">
            {event.seasons?.name ?? 'Season'} — Round {event.round_number}
          </p>
        )}
      </div>
    </div>
    <div class="flex flex-col items-end gap-2">
      <div class="flex flex-wrap items-center justify-end gap-1.5">
        {event.category === 'test' ? (
          // Test Session events don't use the format field at all (see
          // eventFormatting.ts) — the badge shows the category label with
          // the same neutral styling the category badge would've used,
          // rather than a second/duplicate "Test Session" pill below.
          <span class={`rounded-lg px-2.5 py-1 text-xs font-semibold uppercase tracking-wide ${CATEGORY_BADGE_CLASSES.test}`}>
            {CATEGORY_LABELS.test}
          </span>
        ) : (
          <span class={`rounded-lg px-2.5 py-1 text-xs font-semibold uppercase tracking-wide ${FORMAT_BADGE_CLASSES[event.format]}`}>
            {FORMAT_LABELS[event.format]}
          </span>
        )}
        {event.category !== 'championship' && event.category !== 'test' && (
          <span class={`rounded-lg px-2.5 py-1 text-xs font-semibold uppercase tracking-wide ${CATEGORY_BADGE_CLASSES[event.category]}`}>
            {CATEGORY_LABELS[event.category]}
          </span>
        )}
      </div>
      <p class="text-sm text-white/60">{formatEventDate(event.event_date)}</p>
    </div>
  </div>

  <div class="mt-5 grid gap-2 sm:grid-cols-2 lg:grid-cols-5">
    {sessions.map((s) => (
      <div class="rounded-lg border border-white/10 bg-white/[0.02] p-3">
        <div class="flex items-center justify-between">
          <p class="text-xs font-semibold uppercase tracking-wide text-white/50">{s.label}</p>
          <WeatherIcon condition={s.weather} class="text-lg" />
        </div>
        <p class="mt-1 text-sm font-semibold">
          {s.startTime ? (
            <span data-utc-time={s.startTimeUtcIso ?? undefined}>{formatSessionTime(s.startTime)} ET</span>
          ) : (
            'TBD'
          )}
        </p>
        {s.simTime && <p class="text-xs text-white/50">In-sim {formatSessionTime(s.simTime)}</p>}
        {s.detail && <p class="text-xs text-white/50">{s.detail}</p>}
      </div>
    ))}
  </div>

  {(event.fuel_limit_pct !== null || event.results_url || linkedRound) && (
    <div class="mt-4 flex flex-wrap items-center gap-x-6 gap-y-2 text-sm text-white/60">
      {event.fuel_limit_pct !== null && (
        <span class="flex items-center gap-1">
          <svg
            role="img"
            aria-label="Fuel limit"
            class="inline-block text-white/50"
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            width="1em"
            height="1em"
          >
            <title>Fuel limit</title>
            <line x1="3" y1="22" x2="15" y2="22" />
            <line x1="4" y1="9" x2="14" y2="9" />
            <path d="M14 22V4a2 2 0 0 0-2-2H6a2 2 0 0 0-2 2v18" />
            <path d="M14 13h2a2 2 0 0 1 2 2v2a2 2 0 0 0 2 2 2 2 0 0 0 2-2V9.83a2 2 0 0 0-.59-1.42L18 5" />
          </svg>
          {event.fuel_limit_pct}%
        </span>
      )}
      {linkedRound && (
        <a href={`/results/${linkedRound.subsession_id}`} class="text-brand-primary hover:underline">
          View Results &rarr;
        </a>
      )}
      {event.results_url && (
        <a href={event.results_url} target="_blank" rel="noopener noreferrer" class="text-brand-primary hover:underline">
          iRacing Results &rarr;
        </a>
      )}
    </div>
  )}

  {layoutRounds.length > 0 && (
    <details class="mt-4 border-t border-white/10 pt-4">
      <summary class="cursor-pointer list-none text-sm font-semibold text-white/60 transition hover:text-white">
        Race Recaps at this Layout ({layoutRounds.length})
      </summary>
      <div class="mt-3 flex flex-col gap-2">
        {layoutRounds.map((r) => (
          <details data-round-recap={r.subsessionId} class="rounded-lg border border-white/10 bg-white/[0.02] px-3 py-2">
            <summary class="cursor-pointer list-none text-xs font-semibold text-white/60 transition hover:text-white">
              {formatDate(r.startTime)}{r.seasonLabel ? ` — ${r.seasonLabel}` : ''} — {r.trackName}
            </summary>
            <div class="mt-2" data-recap-body></div>
          </details>
        ))}
      </div>
    </details>
  )}

  {icsBlock && (
    <div class="mt-4 flex justify-end">
      <button
        type="button"
        data-ics-download
        data-ics-event={icsBlock}
        data-ics-filename={icsFilename}
        class="flex items-center gap-1 rounded-lg bg-white/5 px-2.5 py-1 text-xs font-semibold text-white/60 ring-1 ring-white/10 transition hover:bg-white/10 hover:text-white"
      >
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="1em" height="1em" aria-hidden="true">
          <rect x="3" y="4" width="18" height="18" rx="2" />
          <line x1="16" y1="2" x2="16" y2="6" />
          <line x1="8" y1="2" x2="8" y2="6" />
          <line x1="3" y1="10" x2="21" y2="10" />
          <line x1="12" y1="14" x2="12" y2="18" />
          <line x1="10" y1="16" x2="14" y2="16" />
        </svg>
        Add to Calendar
      </button>
    </div>
  )}
</article>
