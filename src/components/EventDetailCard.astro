---
import type { EventWithCircuit } from '../lib/supabase';
import { displayLayoutName, formatDate } from '../lib/supabase';
import { formatEventDate, formatSessionTime, FORMAT_BADGE_CLASSES, FORMAT_LABELS, getEventSessions } from '../lib/eventFormatting';
import type { LayoutRoundSummary } from '../lib/results';
import WeatherIcon from './WeatherIcon.astro';

interface Props {
  event: EventWithCircuit;
  index?: number;
  /**
   * Every historical round ever run at this event's own circuit+layout,
   * newest first — see src/lib/results.ts's findRoundsForLayout(). Computed
   * ONCE per page (calendar.astro) and passed in per card rather than
   * fetched here, since a page can show many cards that repeat the same
   * circuit. Optional/omittable for any future caller that doesn't have
   * this data on hand — the collapsible below simply doesn't render without
   * it, same as any other optional section on this card.
   */
  layoutRounds?: LayoutRoundSummary[];
}

const { event, index = 0, layoutRounds = [] } = Astro.props;
const sessions = getEventSessions(event);
---

<article
  class="reveal rounded-xl border border-white/10 bg-white/[0.03] p-6"
  style={`transition-delay: ${Math.min(index, 4) * 30}ms`}
  data-event-date={event.event_date}
>
  <div class="flex flex-wrap items-start justify-between gap-4">
    <div class="flex items-center gap-4">
      {event.circuits?.logo_url && (
        <img src={event.circuits.logo_url} alt="" class="h-12 w-12 flex-none rounded object-contain" />
      )}
      <div>
        <h3 class="font-display text-2xl leading-none">{event.circuits?.name ?? 'TBA'}</h3>
        {event.layout && <p class="mt-1 text-sm text-white/50">{displayLayoutName(event.layout)}</p>}
      </div>
    </div>
    <div class="flex flex-col items-end gap-2">
      <span class={`rounded-lg px-2.5 py-1 text-xs font-semibold uppercase tracking-wide ${FORMAT_BADGE_CLASSES[event.format]}`}>
        {FORMAT_LABELS[event.format]}
      </span>
      <p class="text-sm text-white/60">{formatEventDate(event.event_date)}</p>
    </div>
  </div>

  <div class="mt-5 grid gap-2 sm:grid-cols-2 lg:grid-cols-5">
    {sessions.map((s) => (
      <div class="rounded-lg border border-white/10 bg-white/[0.02] p-3">
        <div class="flex items-center justify-between">
          <p class="text-xs font-semibold uppercase tracking-wide text-white/50">{s.label}</p>
          <WeatherIcon condition={s.weather} class="text-lg" />
        </div>
        <p class="mt-1 text-sm font-semibold">
          {s.startTime ? (
            <span data-utc-time={s.startTimeUtcIso ?? undefined}>{formatSessionTime(s.startTime)} ET</span>
          ) : (
            'TBD'
          )}
        </p>
        {s.simTime && <p class="text-xs text-white/50">In-sim {formatSessionTime(s.simTime)}</p>}
        {s.detail && <p class="text-xs text-white/50">{s.detail}</p>}
      </div>
    ))}
  </div>

  {(event.fuel_limit_pct !== null || event.results_url) && (
    <div class="mt-4 flex flex-wrap items-center gap-x-6 gap-y-2 text-sm text-white/60">
      {event.fuel_limit_pct !== null && <span>Fuel limit: {event.fuel_limit_pct}%</span>}
      {event.results_url && (
        <a href={event.results_url} target="_blank" rel="noopener noreferrer" class="text-brand-primary hover:underline">
          iRacing Results &rarr;
        </a>
      )}
    </div>
  )}

  {layoutRounds.length > 0 && (
    <details class="mt-4 border-t border-white/10 pt-4">
      <summary class="cursor-pointer list-none text-sm font-semibold text-white/60 transition hover:text-white">
        Race Recaps at this Layout ({layoutRounds.length})
      </summary>
      <div class="mt-3 flex flex-col gap-2">
        {layoutRounds.map((r) => (
          <details data-round-recap={r.subsessionId} class="rounded-lg border border-white/10 bg-white/[0.02] px-3 py-2">
            <summary class="cursor-pointer list-none text-xs font-semibold text-white/60 transition hover:text-white">
              {formatDate(r.startTime)}{r.seasonLabel ? ` — ${r.seasonLabel}` : ''} — {r.trackName}
            </summary>
            <div class="mt-2" data-recap-body></div>
          </details>
        ))}
      </div>
    </details>
  )}
</article>
