---
// Race links (iRacing Results / Replay / Broadcast / Photo Album) — one set
// per ROUND, not per race (a round's races all share the same iRacing
// session/broadcast/photo album in practice — see this migration's own
// header comment on why this used to be modeled per-race:
// 0007_race_links.sql). Always saved/read against the round's first race
// number as the canonical row; the table's schema is unchanged, this is
// just no longer shown/edited per race.
//
// Split out of src/pages/results/[subsessionId].astro into its own
// component so it can be slotted into the first race table's title line
// (see that page's `slot="race-links"` usage on <ResultsTable>) rather than
// sitting in the page header, per Logan — the markup itself is unchanged,
// only where it renders moved.
import { iracingResultsUrl } from '../lib/results';
import type { RaceLinks } from '../lib/supabase';

interface Props {
  links: RaceLinks | null;
  isAdmin: boolean;
  subsessionId: number;
  canonicalRaceNumber: number;
}

const { links, isAdmin, subsessionId, canonicalRaceNumber } = Astro.props;
// The iRacing Results link is derived, not edited: a real pipeline round's
// own `subsession_id` IS iRacing's subsession id (always positive), so the
// button can just link straight to it. A manually-imported round instead
// carries a synthetic NEGATIVE subsession_id (see raceResultsImport.ts) that
// means nothing to iRacing, so those fall back to whatever legacy
// `race_links.iracing_subsession_id` was saved before this field stopped
// being editable (null when none — no button in that case).
const iracingSubsessionId = subsessionId > 0 ? subsessionId : links?.iracing_subsession_id ?? null;
const hasAnyLink = iracingSubsessionId || links?.replay_url || links?.broadcast_url || links?.photo_album_url;
const dialogId = `edit-links-dialog-${subsessionId}`;
---

{(hasAnyLink || isAdmin) && (
  <div class="flex flex-wrap items-center gap-2">
    {iracingSubsessionId && (
      <a
        href={iracingResultsUrl(iracingSubsessionId)}
        target="_blank"
        rel="noopener noreferrer"
        class="rounded-lg bg-brand-primary px-3 py-1 text-[11px] font-semibold text-white transition hover:brightness-110"
      >
        iRacing Results
      </a>
    )}
    {links?.replay_url && (
      <a
        href={links.replay_url}
        target="_blank"
        rel="noopener noreferrer"
        class="hidden rounded-lg bg-brand-primary px-3 py-1 text-[11px] font-semibold text-white transition hover:brightness-110 sm:inline-block"
      >
        Download Replay
      </a>
    )}
    {links?.broadcast_url && (
      <a
        href={links.broadcast_url}
        target="_blank"
        rel="noopener noreferrer"
        class="rounded-lg bg-brand-primary px-3 py-1 text-[11px] font-semibold text-white transition hover:brightness-110"
      >
        Watch Broadcast
      </a>
    )}
    {links?.photo_album_url && (
      <a
        href={links.photo_album_url}
        target="_blank"
        rel="noopener noreferrer"
        class="rounded-lg bg-brand-primary px-3 py-1 text-[11px] font-semibold text-white transition hover:brightness-110"
      >
        Photo Album
      </a>
    )}
    {isAdmin && (
      <>
        <button
          type="button"
          data-open-edit-links={dialogId}
          class="cursor-pointer rounded-lg bg-white/5 px-3 py-1 text-[11px] font-semibold text-white/50 ring-1 ring-white/10 transition hover:bg-white/10"
        >
          Edit links
        </button>
        {/* A native modal <dialog> (same pattern as the site's other dialogs
            — incidents.astro, admin/rulesets) instead of the absolutely-
            positioned popover this used to be: showModal() renders in the
            browser's top layer, above the sticky site header (z-50) and every
            transformed `.reveal` ancestor's own stacking context, which is
            exactly what was trapping the old popover underneath the header. */}
        <dialog
          id={dialogId}
          class="w-full max-w-sm rounded-xl border border-white/10 bg-brand-ink p-0 text-white backdrop:bg-black/60"
        >
          <form method="POST" data-astro-reload class="flex flex-col gap-3 p-5">
            <input type="hidden" name="intent" value="save-race-links" />
            <input type="hidden" name="subsession_id" value={subsessionId} />
            <input type="hidden" name="race_number" value={canonicalRaceNumber} />
            <div class="flex items-center justify-between">
              <h4 class="font-display text-xl">Edit Links</h4>
              <button type="button" data-close-edit-links class="text-white/40 hover:text-white" aria-label="Close">✕</button>
            </div>
            <label class="flex flex-col gap-1 text-[11px] text-white/50">
              Replay download URL
              <input
                type="url"
                name="replay_url"
                value={links?.replay_url ?? ''}
                class="rounded-md border border-white/15 bg-white/5 px-2 py-1.5 text-xs text-white outline-none focus:border-brand-primary"
              />
            </label>
            <label class="flex flex-col gap-1 text-[11px] text-white/50">
              Broadcast video URL
              <input
                type="url"
                name="broadcast_url"
                value={links?.broadcast_url ?? ''}
                class="rounded-md border border-white/15 bg-white/5 px-2 py-1.5 text-xs text-white outline-none focus:border-brand-primary"
              />
            </label>
            <label class="flex flex-col gap-1 text-[11px] text-white/50">
              Photo album URL
              <input
                type="url"
                name="photo_album_url"
                value={links?.photo_album_url ?? ''}
                class="rounded-md border border-white/15 bg-white/5 px-2 py-1.5 text-xs text-white outline-none focus:border-brand-primary"
              />
            </label>
            <button
              type="submit"
              class="mt-1 rounded-lg bg-brand-primary px-3 py-1.5 text-xs font-semibold transition hover:brightness-110"
            >
              Save
            </button>
          </form>
        </dialog>
      </>
    )}
  </div>
)}

<script>
  // One delegated listener (registered once) so it keeps working across
  // client-side navigations without re-binding.
  function initEditLinksDialog() {
    if (document.body.dataset.editLinksInit === 'true') return;
    document.body.dataset.editLinksInit = 'true';
    document.addEventListener('click', (e) => {
      const target = e.target as HTMLElement;
      const opener = target.closest<HTMLElement>('[data-open-edit-links]');
      if (opener) {
        const dialog = document.getElementById(opener.dataset.openEditLinks ?? '');
        if (dialog instanceof HTMLDialogElement && !dialog.open) dialog.showModal();
        return;
      }
      if (target.closest('[data-close-edit-links]')) {
        target.closest('dialog')?.close();
        return;
      }
      // Clicking the backdrop (the <dialog> element itself, outside its form) closes it.
      if (target instanceof HTMLDialogElement && target.id.startsWith('edit-links-dialog-')) target.close();
    });
  }
  initEditLinksDialog();
  document.addEventListener('astro:page-load', initEditLinksDialog);
</script>
