---
// Race links (iRacing Results / Replay / Broadcast / Photo Album) — one set
// per ROUND, not per race (a round's races all share the same iRacing
// session/broadcast/photo album in practice — see this migration's own
// header comment on why this used to be modeled per-race:
// 0007_race_links.sql). Always saved/read against the round's first race
// number as the canonical row; the table's schema is unchanged, this is
// just no longer shown/edited per race.
//
// Renders as ONE blue "Race Links" button (on desktop and mobile alike) that
// opens a dialog listing the individual link buttons — used to be a row of
// inline buttons on the first race table's title line. Admins also get an
// "Edit links" form inside that same dialog.
import { iracingResultsUrl } from '../lib/results';
import type { RaceLinks } from '../lib/supabase';

interface Props {
  links: RaceLinks | null;
  isAdmin: boolean;
  subsessionId: number;
  canonicalRaceNumber: number;
}

const { links, isAdmin, subsessionId, canonicalRaceNumber } = Astro.props;
// The iRacing Results link is derived, not edited: a real pipeline round's
// own `subsession_id` IS iRacing's subsession id (always positive), so the
// button can just link straight to it. A manually-imported round instead
// carries a synthetic NEGATIVE subsession_id (see raceResultsImport.ts) that
// means nothing to iRacing, so those fall back to whatever legacy
// `race_links.iracing_subsession_id` was saved before this field stopped
// being editable (null when none — no button in that case).
const iracingSubsessionId = subsessionId > 0 ? subsessionId : links?.iracing_subsession_id ?? null;
const hasAnyLink = iracingSubsessionId || links?.replay_url || links?.broadcast_url || links?.photo_album_url;
const dialogId = `race-links-dialog-${subsessionId}`;
---

{(hasAnyLink || isAdmin) && (
  <>
    <button
      type="button"
      data-open-race-links={dialogId}
      class="btn btn-primary flex items-center"
    >
      Race Links
    </button>
    {/* A native modal <dialog> (same pattern as the site's other dialogs —
        incidents.astro, admin/rulesets): showModal() renders in the
        browser's top layer, above the sticky site header (z-50) and every
        transformed `.reveal` ancestor's own stacking context. */}
    <dialog
      id={dialogId}
      data-race-links-dialog
      class="w-full max-w-sm rounded-xl border border-white/10 bg-brand-ink p-0 text-white backdrop:bg-black/60"
    >
      <div class="flex flex-col gap-3 p-5">
        <div class="flex items-center justify-between">
          <h4 class="font-display text-xl">Race Links</h4>
          <button type="button" data-close-race-links class="text-white/40 hover:text-white" aria-label="Close">✕</button>
        </div>

        <div class="flex flex-col gap-2">
          {iracingSubsessionId && (
            <a
              href={iracingResultsUrl(iracingSubsessionId)}
              target="_blank"
              rel="noopener noreferrer"
              class="btn btn-primary text-center"
            >
              iRacing Results
            </a>
          )}
          {links?.replay_url && (
            <a
              href={links.replay_url}
              target="_blank"
              rel="noopener noreferrer"
              class="btn btn-primary hidden text-center sm:block"
            >
              Download Replay
            </a>
          )}
          {links?.broadcast_url && (
            <a
              href={links.broadcast_url}
              target="_blank"
              rel="noopener noreferrer"
              class="btn btn-primary text-center"
            >
              Watch Broadcast
            </a>
          )}
          {links?.photo_album_url && (
            <a
              href={links.photo_album_url}
              target="_blank"
              rel="noopener noreferrer"
              class="btn btn-primary text-center"
            >
              Photo Album
            </a>
          )}
          {!hasAnyLink && <p class="text-sm text-white/50">No links have been added for this round yet.</p>}
        </div>

        {isAdmin && (
          <details class="border-t border-white/10 pt-3">
            <summary class="cursor-pointer list-none text-xs font-semibold text-white/50 hover:text-white/80">Edit links</summary>
            <form method="POST" data-astro-reload class="mt-3 flex flex-col gap-3">
              <input type="hidden" name="intent" value="save-race-links" />
              <input type="hidden" name="subsession_id" value={subsessionId} />
              <input type="hidden" name="race_number" value={canonicalRaceNumber} />
              <label class="flex flex-col gap-1 text-[11px] text-white/50">
                Replay download URL
                <input
                  type="url"
                  name="replay_url"
                  value={links?.replay_url ?? ''}
                  class="rounded-md border border-white/15 bg-white/5 px-2 py-1.5 text-xs text-white outline-none focus:border-brand-primary"
                />
              </label>
              <label class="flex flex-col gap-1 text-[11px] text-white/50">
                Broadcast video URL
                <input
                  type="url"
                  name="broadcast_url"
                  value={links?.broadcast_url ?? ''}
                  class="rounded-md border border-white/15 bg-white/5 px-2 py-1.5 text-xs text-white outline-none focus:border-brand-primary"
                />
              </label>
              <label class="flex flex-col gap-1 text-[11px] text-white/50">
                Photo album URL
                <input
                  type="url"
                  name="photo_album_url"
                  value={links?.photo_album_url ?? ''}
                  class="rounded-md border border-white/15 bg-white/5 px-2 py-1.5 text-xs text-white outline-none focus:border-brand-primary"
                />
              </label>
              <button
                type="submit"
                class="btn btn-primary btn-sm mt-1"
              >
                Save
              </button>
            </form>
          </details>
        )}
      </div>
    </dialog>
  </>
)}

<script>
  // One delegated listener (registered once) so it keeps working across
  // client-side navigations without re-binding.
  function initRaceLinksDialog() {
    if (document.body.dataset.raceLinksInit === 'true') return;
    document.body.dataset.raceLinksInit = 'true';
    document.addEventListener('click', (e) => {
      const target = e.target as HTMLElement;
      const opener = target.closest<HTMLElement>('[data-open-race-links]');
      if (opener) {
        const dialog = document.getElementById(opener.dataset.openRaceLinks ?? '');
        if (dialog instanceof HTMLDialogElement && !dialog.open) dialog.showModal();
        return;
      }
      if (target.closest('[data-close-race-links]')) {
        target.closest('dialog')?.close();
        return;
      }
      // Clicking the backdrop (the <dialog> element itself, outside its content) closes it.
      if (target instanceof HTMLDialogElement && target.hasAttribute('data-race-links-dialog')) target.close();
    });
  }
  initRaceLinksDialog();
  document.addEventListener('astro:page-load', initRaceLinksDialog);
</script>
