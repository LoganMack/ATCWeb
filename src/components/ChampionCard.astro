---
import type { ChampionEntry } from '../lib/results';
import { ordinal, pctOf } from '../lib/results';
import type { ChampionPhoto } from '../lib/supabase';
import StatBlock from './StatBlock.astro';

interface Props {
  entry: ChampionEntry;
  photos: ChampionPhoto[];
  index?: number;
}

const { entry, photos, index = 0 } = Astro.props;
const { season, standing: d } = entry;

const slots = [0, 1, 2].map((slot) => photos.find((p) => p.sort_order === slot) ?? null);
---

<article
  class="reveal overflow-hidden rounded-2xl border border-white/10 bg-white/[0.03]"
  style={`transition-delay: ${Math.min(index, 4) * 30}ms`}
>
  <div class="grid sm:grid-cols-[220px_1fr]">
    <div class="grid h-40 grid-cols-3 sm:h-auto sm:grid-cols-1 sm:grid-rows-3">
      {slots.map((photo, i) => (
        <div class="relative overflow-hidden bg-white/5">
          {photo ? (
            <img src={photo.image_url} alt={`${d.driver.name} — ${season.name}`} class="h-full w-full object-cover" loading="lazy" />
          ) : (
            <div class="flex h-full w-full items-center justify-center text-[10px] uppercase tracking-wide text-white/20">
              Photo {i + 1}
            </div>
          )}
        </div>
      ))}
    </div>

    <div class="p-6">
      <div class="flex flex-wrap items-start justify-between gap-3">
        <div>
          <p class="text-xs uppercase tracking-widest text-white/50">{season.name}</p>
          <h3 class="mt-1 font-display text-3xl leading-none">
            {d.driver.car_number !== null && <span class="text-white/40">#{d.driver.car_number}</span>} {d.driver.name}
          </h3>
        </div>
        <span class="rounded-full bg-brand-primary/15 px-3 py-1.5 text-xs font-semibold uppercase tracking-wide text-brand-primary">
          {ordinal(d.position)} · Champion
        </span>
      </div>

      <dl class="mt-6 grid grid-cols-2 gap-x-4 gap-y-5 sm:grid-cols-4">
        <StatBlock label="Total Points" value={d.totalPoints} />
        <StatBlock label="Class Wins" value={d.wins} sub={pctOf(d.wins, d.starts, 'starts')} />
        <StatBlock label="Poles" value={d.poles} sub={pctOf(d.poles, d.appearances, 'appearances')} />
        <StatBlock label="Podiums" value={d.podiums} sub={pctOf(d.podiums, d.starts, 'starts')} />
        <StatBlock label="Top 5s" value={d.top5s} sub={pctOf(d.top5s, d.starts, 'starts')} />
        <StatBlock label="Top 10s" value={d.top10s} sub={pctOf(d.top10s, d.starts, 'starts')} />
        <StatBlock label="Starts" value={d.starts} sub="races" />
        <StatBlock label="Appearances" value={d.appearances} sub="rounds" />
      </dl>
    </div>
  </div>
</article>
