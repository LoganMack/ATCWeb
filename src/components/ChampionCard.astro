---
import type { ChampionEntry, DriverSeasonExtras } from '../lib/results';
import { pctOf } from '../lib/results';
import type { ChampionPhoto } from '../lib/supabase';
import { displayDriverName, resizedImageUrl } from '../lib/supabase';
import StatBlock from './StatBlock.astro';
import CarLogos from './CarLogos.astro';
import TeamLogo from './TeamLogo.astro';
import DriverFlag from './DriverFlag.astro';
import PhotoGrid from './PhotoGrid.astro';
import SeasonLogo from './SeasonLogo.astro';

interface Props {
  entry: ChampionEntry;
  photos: ChampionPhoto[];
  extras?: DriverSeasonExtras;
  index?: number;
  /** Class this champion won — passed on to the season-results fetch so a driver who raced two classes in a season only sees the winning one's races. */
  classId?: number;
}

const { entry, photos, extras, index = 0, classId } = Astro.props;
const { season, standing: d } = entry;
const driverName = displayDriverName(d.driver.name);

function raceWord(n: number): string {
  return `${n} race${n === 1 ? '' : 's'}`;
}
---

<article
  class="reveal overflow-hidden rounded-xl border border-white/10 bg-brand-ink"
  style={`transition-delay: ${Math.min(index, 4) * 30}ms`}
>
  {/* Click the card to open this champion's race-by-race season (fetched on first open by the script in champions.astro; the open/close itself is expandRows.ts). */}
  <div
    data-expand-row
    data-season-results-url={`/champions/season-results/${season.id}/${d.driver.id}${classId ? `?class=${classId}` : ''}`}
    tabindex="0"
    role="button"
    aria-expanded="false"
    class="grid cursor-pointer transition hover:bg-white/[0.02] sm:grid-cols-[264px_1fr]"
  >
    <PhotoGrid photos={photos} altText={`${driverName} — ${season.name}`} />

    <div class="p-6">
      <div>
        <p class="flex items-center gap-1.5 text-xs uppercase tracking-widest text-white/50">
          <span data-chevron class="inline-block shrink-0 text-[9px] text-white/30 transition-transform duration-150" aria-hidden="true">&#9654;</span>
          <SeasonLogo
            darkUrl={resizedImageUrl(season.logo_url, { width: 32 })}
            lightUrl={resizedImageUrl(season.logo_url_light, { width: 32 })}
            loading="lazy"
            class="h-4 w-4 flex-none rounded-sm object-contain"
          />
          {season.name}
        </p>
        <div class="mt-1 flex flex-wrap items-center gap-2">
          <h3 class="font-display text-3xl leading-none">
            {driverName} {d.driver.car_number !== null && <span class="text-white/40">#{d.driver.car_number}</span>}
          </h3>
          <DriverFlag nationality1={d.driver.nationality_1} nationality2={d.driver.nationality_2} />
          {/* Cars first, teams second — every driver has a car, not every driver has a team. */}
          {extras && <CarLogos cars={extras.cars} size="h-6 w-6" />}
          {extras?.teams.map((t) => (
            <TeamLogo
              name={t.teamName}
              logoUrl={t.logoUrl}
              size="h-6 w-6"
              title={`${t.teamName} — ${raceWord(t.racesUnderTeam)} under this team, ${raceWord(t.racesScoredForTeam)} scored for the team`}
            />
          ))}
        </div>
      </div>

      <dl class="mt-6 grid grid-cols-2 gap-x-4 gap-y-5 sm:grid-cols-4">
        <StatBlock label="Total Points" value={d.totalPoints} />
        <StatBlock label="Class Wins" value={d.wins} sub={pctOf(d.wins, d.starts, 'starts')} />
        <StatBlock label="Poles" value={d.poles} sub={pctOf(d.poles, d.appearances, 'appearances')} />
        <StatBlock label="Podiums" value={d.podiums} sub={pctOf(d.podiums, d.starts, 'starts')} />
        <StatBlock label="Top 5" labelSuffixLower="s" value={d.top5s} sub={pctOf(d.top5s, d.starts, 'starts')} />
        <StatBlock label="Top 10" labelSuffixLower="s" value={d.top10s} sub={pctOf(d.top10s, d.starts, 'starts')} />
        <StatBlock label="Starts" value={d.starts} sub="races" />
        <StatBlock label="Appearances" value={d.appearances} sub="rounds" />
      </dl>
    </div>
  </div>

  <div data-detail-row class="hidden border-t border-white/10 bg-white/[0.02] p-4">
    <div data-season-results-body>
      <p class="text-xs text-white/40">Loading…</p>
    </div>
  </div>
</article>
