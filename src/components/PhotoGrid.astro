---
// One large photo plus two rows of two (up to 5), shared by the Champions card and Hall of Fame so they match
// (Logan). The second row gives the photo column enough height to match the text beside it.
import { resizedImageUrl } from '../lib/db/drivers';

interface PhotoLike {
  image_url: string;
  sort_order: number;
}

interface Props {
  photos: PhotoLike[];
  /** Alt text for every photo in this grid — callers pass something like `${name} — ${season.name}` or just `${name}`. */
  altText: string;
}

const { photos, altText } = Astro.props;
// Thumbnails are resized well down (the biggest images on the site); the lightbox gets up to 1600w.
const LARGE_THUMB_WIDTH = 640;
const SMALL_THUMB_WIDTH = 260;
const LIGHTBOX_WIDTH = 1600;

const slots = [0, 1, 2, 3, 4].map((slot) => photos.find((p) => p.sort_order === slot) ?? null);
const largePhoto = slots[0];
const smallPhotoRows = [
  [slots[1], slots[2]],
  [slots[3], slots[4]],
];
---

<div class="flex flex-col gap-1 p-1">
  {largePhoto ? (
    <button
      type="button"
      data-lightbox
      data-lightbox-src={resizedImageUrl(largePhoto.image_url, { width: LIGHTBOX_WIDTH })}
      data-lightbox-alt={altText}
      class="group relative block aspect-video w-full overflow-hidden rounded-md bg-white/5"
      aria-label={`Enlarge photo of ${altText}`}
    >
      <img
        src={resizedImageUrl(largePhoto.image_url, { width: LARGE_THUMB_WIDTH })}
        alt={altText}
        class="h-full w-full object-cover transition group-hover:scale-105"
        loading="lazy"
      />
    </button>
  ) : (
    <div class="flex aspect-video w-full items-center justify-center rounded-md bg-white/5 text-[10px] uppercase tracking-wide text-white/20">
      Photo 1
    </div>
  )}

  {smallPhotoRows.map((row, rowIndex) => (
    <div class="grid grid-cols-2 gap-1">
      {row.map((photo, i) =>
        photo ? (
          <button
            type="button"
            data-lightbox
            data-lightbox-src={resizedImageUrl(photo.image_url, { width: LIGHTBOX_WIDTH })}
            data-lightbox-alt={altText}
            class="group relative block aspect-video w-full overflow-hidden rounded-md bg-white/5"
            aria-label={`Enlarge photo of ${altText}`}
          >
            <img
              src={resizedImageUrl(photo.image_url, { width: SMALL_THUMB_WIDTH })}
              alt={altText}
              class="h-full w-full object-cover transition group-hover:scale-105"
              loading="lazy"
            />
          </button>
        ) : (
          <div class="flex aspect-video w-full items-center justify-center rounded-md bg-white/5 text-[10px] uppercase tracking-wide text-white/20">
            Photo {rowIndex * 2 + i + 2}
          </div>
        )
      )}
    </div>
  ))}
</div>
