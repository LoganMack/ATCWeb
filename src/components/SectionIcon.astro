---
/**
 * Stroke icons for the incident report section titles, in the site's inline icon style (24px viewBox, 2px
 * round strokes, currentColor).
 */
export interface Props {
  name: 'review' | 'reviewed' | 'open' | 'dismissed' | 'logged' | 'appeals' | 'pending';
  class?: string;
}
const { name, class: className = 'h-5 w-5' } = Astro.props;
---

<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class={className} aria-hidden="true">
  {name === 'review' && (<><path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7S2 12 2 12z" /><circle cx="12" cy="12" r="3" /></>)}
  {name === 'reviewed' && (<><path d="M22 11.1V12a10 10 0 1 1-5.9-9.1" /><polyline points="22 4 12 14 9 11" /></>)}
  {name === 'open' && (<><circle cx="12" cy="12" r="10" /><line x1="12" y1="8" x2="12" y2="12" /><line x1="12" y1="16" x2="12.01" y2="16" /></>)}
  {name === 'dismissed' && (<><circle cx="12" cy="12" r="10" /><line x1="15" y1="9" x2="9" y2="15" /><line x1="9" y1="9" x2="15" y2="15" /></>)}
  {name === 'logged' && (<><path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2" /><rect x="8" y="2" width="8" height="4" rx="1" /><polyline points="9 14 11 16 15 12" /></>)}
  {name === 'appeals' && (<><path d="M3 11l18-8v18L3 13" /><path d="M11.6 16.8a3 3 0 1 1-5.8-1.6" /></>)}
  {name === 'pending' && (<><circle cx="12" cy="12" r="10" /><polyline points="12 6 12 12 16 14" /></>)}
</svg>
