---
import { resolveSiteLinks } from '../lib/links';
import { isBroadcasterAccount } from '../lib/auth';

const { discordUrl, redbubbleUrl } = resolveSiteLinks(Astro.locals);

// "View as Visitor" lets Admin and Staff preview the site with admin UI hidden. It checks the real role (panel
// access), not isAdminView(), so the toggle stays visible to switch back.
const isRealAdmin = Astro.locals.isRealAdmin;
const viewAsVisitor = Astro.locals.viewAsVisitor;
const currentPath = `${Astro.url.pathname}${Astro.url.search}`;
const isSignedIn = Boolean(Astro.locals.session);

// "View as Broadcaster" — only for the signed-in Broadcaster (BR1.8). While on, the most recent round is
// hidden from every statistic (see src/middleware.ts) so a delayed broadcast has no spoilers.
const showBroadcasterToggle = isBroadcasterAccount(Astro.locals);
const broadcasterMode = Astro.locals.broadcasterMode;

// The Admin Panel link lives in the header now (Nav.astro, gear icon).
---

<footer class="border-t border-white/10 py-10">
  <div class="mx-auto max-w-6xl px-6 text-sm text-white/50">
    {/* Line 1: the league's name, centered. */}
    <p class="text-center">
      <span class="font-display text-base uppercase tracking-widest text-white/70">Alpha Touring Challenge</span>
      <span class="mt-1 block text-xs text-white/40">An iRacing league</span>
    </p>
    {/* Line 2: buttons on the left, links on the right. */}
    <div class="mt-6 flex flex-col items-center gap-4 sm:flex-row sm:justify-between">
      <div class="flex flex-wrap items-center justify-center gap-3 sm:justify-start">
      <button
        type="button"
        data-theme-toggle
        aria-pressed="false"
        title="Switch to light mode"
        class="btn btn-neutral !p-1.5"
      >
        <span class="sr-only">Toggle light/dark mode</span>
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="hidden h-4 w-4 [.light_&]:block">
          <circle cx="12" cy="12" r="4" /><path d="M12 2v2" /><path d="M12 20v2" /><path d="m4.93 4.93 1.41 1.41" /><path d="m17.66 17.66 1.41 1.41" /><path d="M2 12h2" /><path d="M20 12h2" /><path d="m6.34 17.66-1.41 1.41" /><path d="m19.07 4.93-1.41 1.41" />
        </svg>
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4 [.light_&]:hidden">
          <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z" />
        </svg>
      </button>
      {showBroadcasterToggle && (
        <form method="POST" action="/api/broadcaster-mode" data-astro-reload>
          <input type="hidden" name="next" value={currentPath} />
          <input type="hidden" name="mode" value={broadcasterMode ? 'off' : 'on'} />
          <button
            type="submit"
            title="Hide the most recent round from every statistic on the site, so a delayed broadcast has no spoilers."
            class={broadcasterMode
              ? 'btn btn-gold btn-sm'
              : 'btn btn-neutral btn-sm'}
          >
            {broadcasterMode ? 'Broadcaster View On' : 'View as Broadcaster'}
          </button>
        </form>
      )}
      {isRealAdmin && (
        <form method="POST" action="/api/view-mode" data-astro-reload>
          <input type="hidden" name="next" value={currentPath} />
          <input type="hidden" name="mode" value={viewAsVisitor ? 'admin' : 'visitor'} />
          <button
            type="submit"
            title="Preview the site with admin-only controls hidden, without signing out."
            class={viewAsVisitor
              ? 'btn btn-gold btn-sm'
              : 'btn btn-neutral btn-sm'}
          >
            {viewAsVisitor ? 'Previewing as Visitor — return to Admin View' : 'View as Visitor'}
          </button>
        </form>
      )}
      </div>
      <div class="flex flex-wrap items-center justify-center gap-x-6 gap-y-2 text-center sm:justify-end">
      <a
        href="https://paypal.me/loganmckinzie?country.x=US&locale.x=en_US"
        target="_blank"
        rel="noopener noreferrer"
        class="hover:text-white/80"
      >
        Donate
      </a>
      <a href={discordUrl} target="_blank" rel="noopener noreferrer" class="hover:text-white/80">Discord</a>
      <a href={redbubbleUrl} target="_blank" rel="noopener noreferrer" class="hover:text-white/80">Redbubble</a>
      {isSignedIn ? (
        <form method="POST" action="/api/logout" data-astro-reload>
          <button type="submit" class="cursor-pointer border-0 bg-transparent p-0 text-inherit hover:text-white/80">Logout</button>
        </form>
      ) : (
        <>
          <a href="/login" class="hover:text-white/80">Login</a>
          <a href="/signup" class="hover:text-white/80">Sign Up</a>
        </>
      )}
      </div>
    </div>
  </div>
  <p class="mx-auto mt-4 max-w-6xl px-6 text-center text-xs text-white/30">
    Photos by Jason Lin; All Rights Reserved;{' '}
    <a
      href="https://www.flickr.com/people/200558998@N08/"
      target="_blank"
      rel="noopener noreferrer"
      class="underline decoration-white/20 underline-offset-2 hover:text-white/60"
    >
      Glass &amp; Steel Photography and Design
    </a>
  </p>
</footer>
