---
/**
 * The results page's yellow incident button, in one of three states:
 *
 *  - 'report' — the reporting period is open: reads "Report Incident" and
 *    opens the Report Incident dialog (ReportIncidentDialog.astro, via
 *    [data-open-report-dialog]). Hovering shows "Incident reporting period
 *    ends in X hours." (X minutes once 2 hours or less remain) — computed
 *    server-side for first paint and re-computed live by the script below,
 *    since this page is edge-cached for up to a minute.
 *  - 'view' — the round's incident report has been posted (or the viewer is
 *    an admin): reads "Incident Report" and links to the incident page.
 *  - 'closed' — the period is over and the report isn't posted yet:
 *    disabled, reads "Incident Report", hover explains the stewards are
 *    still reviewing.
 */
import { reportingCountdownText } from '../lib/incidentReports';

interface Props {
  state: 'report' | 'view' | 'closed';
  incidentsHref: string;
  /** ISO time the reporting period ends — only used in the 'report' state. */
  closesAtIso?: string | null;
}
const { state, incidentsHref, closesAtIso = null } = Astro.props;

const btn = 'btn btn-gold';
const tip =
  'pointer-events-none absolute right-0 top-full z-30 mt-1.5 w-max max-w-[16rem] rounded-md bg-brand-ink px-2 py-1 text-[11px] font-semibold text-white opacity-0 shadow-lg ring-1 ring-white/15 transition-opacity group-hover:opacity-100 group-focus-within:opacity-100';
const closes = closesAtIso ? new Date(closesAtIso) : null;
---

{state === 'view' && (
  <a href={incidentsHref} class={btn}>Incident Report</a>
)}

{state === 'report' && (
  <span class="group relative">
    <button type="button" data-open-report-dialog class={btn}>Report Incident</button>
    <span class={tip} role="tooltip" data-incident-countdown data-closes-at={closesAtIso ?? undefined}>
      {closes ? reportingCountdownText(closes) : 'Incident reporting is open.'}
    </span>
  </span>
)}

{state === 'closed' && (
  <span class="group relative">
    <button
      type="button"
      disabled
      aria-disabled="true"
      class="btn btn-neutral"
    >
      Incident Report
    </button>
    <span class={tip} role="tooltip">The incident reporting period has closed. The stewards are currently reviewing.</span>
  </span>
)}

{/* Client behavior lives in src/scripts/incidentCountdown.ts (loaded by the results page shell — the markup here arrives via a fetched fragment, and scripts inside fetched HTML never run). */}
