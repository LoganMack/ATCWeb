---
// Shared small logo tile — an uploaded logo image when one exists,
// otherwise a placeholder tile with an acronym built from the name (see
// src/lib/teamLogo.ts). Despite the name, this is generic: used for team
// logos (roster, Teams page, race results/standings rows) and, identically,
// for car logos (race results/standings rows) — both just need "a name, an
// optional logo, show it small, and reveal the full name/label on hover."
import { teamInitials } from '../lib/teamLogo';

interface Props {
  name: string;
  logoUrl?: string | null;
  /** Tailwind size classes, e.g. "h-8 w-8" (Teams/roster tables) or "h-5 w-5" (inline in results rows). */
  size?: string;
  grayscale?: boolean;
  /** Hover text — defaults to `name`. Pass an override (e.g. "Apex Racing — 4 races") when the caller has more to say than just the name, like the standings page's per-team/per-car race counts. */
  title?: string;
}

const { name, logoUrl, size = 'h-6 w-6', grayscale = false, title } = Astro.props;
const hoverText = title ?? name;
---

{logoUrl ? (
  <img src={logoUrl} alt="" title={hoverText} class={`${size} flex-none rounded object-contain ${grayscale ? 'grayscale' : ''}`} />
) : (
  <div
    class={`${size} flex-none rounded bg-white/10 flex items-center justify-center text-[9px] font-bold uppercase tracking-wide text-white/50 ${grayscale ? 'opacity-60' : ''}`}
    title={hoverText}
  >
    {teamInitials(name)}
  </div>
)}
