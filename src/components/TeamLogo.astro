---
// Shared small logo tile — an uploaded logo image when one exists,
// otherwise a placeholder tile with an acronym built from the name (see
// src/lib/teamLogo.ts). Despite the name, this is generic: used for team
// logos (roster, Teams page, race results/standings rows) and, identically,
// for car logos (race results/standings rows) — both just need "a name, an
// optional logo, show it small, and reveal the full name/label on hover."
import { teamInitials } from '../lib/teamLogo';
import { resizedImageUrl } from '../lib/supabase';

interface Props {
  name: string;
  logoUrl?: string | null;
  /** Tailwind size classes, e.g. "h-8 w-8" (Teams/roster tables) or "h-5 w-5" (inline in results rows). */
  size?: string;
  grayscale?: boolean;
  /** Hover text — defaults to `name`. Pass an override (e.g. "Apex Racing — 4 races") when the caller has more to say than just the name, like the standings page's per-team/per-car race counts. */
  title?: string;
  /**
   * Pixel width to request from Cloudflare Transformations (resizedImageUrl)
   * — defaults to 96, comfortably covering every `size` this component is
   * actually used at (h-4 through h-10, i.e. 16-40px, even at 2x retina)
   * except TeamChampionCard's one large "h-28 w-28" (112px) champion-logo
   * usage, which passes a bigger value explicitly.
   */
  resizeWidth?: number;
  /**
   * Tints the logo solid black in light mode (see the `.light .theme-tint`
   * rule in global.css) — for CAR logos specifically, most of which are
   * light-colored artwork made to sit on the site's dark background and go
   * near-invisible on a light one. Real TEAM logos keep their own colors in
   * both themes (their usual callers never pass this); only pass `tint`
   * from a call site that's rendering a car's logo.
   */
  tint?: boolean;
}

const { name, logoUrl, size = 'h-6 w-6', grayscale = false, title, resizeWidth = 96, tint = false } = Astro.props;
const hoverText = title ?? name;
const resizedLogoUrl = resizedImageUrl(logoUrl, { width: resizeWidth });
---

{resizedLogoUrl ? (
  <img src={resizedLogoUrl} alt="" title={hoverText} loading="lazy" class={`${size} flex-none rounded object-contain ${grayscale ? 'grayscale' : ''} ${tint ? 'theme-tint' : ''}`} />
) : (
  <div
    class={`${size} flex-none rounded bg-white/10 flex items-center justify-center text-[9px] font-bold uppercase tracking-wide text-white/50 ${grayscale ? 'opacity-60' : ''}`}
    title={hoverText}
  >
    {teamInitials(name)}
  </div>
)}
