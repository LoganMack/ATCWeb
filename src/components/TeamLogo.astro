---
// Small logo tile, or a placeholder with initials (src/lib/teamLogo.ts). Used for both team and car logos,
// with the full name on hover.
import { teamInitials } from '../lib/teamLogo';
import { logoBgAttrs, type LogoBackground } from '../lib/db/circuits';
import { resizedImageUrl } from '../lib/db/drivers';
import IconTip from './IconTip.astro';

interface Props {
  name: string;
  logoUrl?: string | null;
  /** Tailwind size classes, e.g. "h-8 w-8" (Teams/roster tables) or "h-5 w-5" (inline in results rows). */
  size?: string;
  grayscale?: boolean;
  /** Hover text — defaults to `name`. Pass an override (e.g. "Apex Racing — 4 races") when the caller has more to say than just the name, like the standings page's per-team/per-car race counts. */
  title?: string;
  /**
   * Width requested from Cloudflare Transformations; 96 covers every size up to h-10 at 2x.
   * TeamChampionCard's 112px logo passes more.
   */
  resizeWidth?: number;
  /**
   * Tints the logo black in light mode (`.light .theme-tint`), for car logos, which are mostly light artwork.
   * Team logos keep their colours.
   */
  tint?: boolean;
  /** Light/dark plate behind the logo — for track logos (circuits.logo_background). Pass INSTEAD of `tint`, which would turn a plated logo black. */
  logoBg?: LogoBackground | null;
  /**
   * A named, focusable image (driver profile header): role="img" with the hover text as its aria-label, and
   * the name shown on keyboard focus.
   */
  labelled?: boolean;
}

const {
  name,
  logoUrl,
  size = 'h-6 w-6',
  grayscale = false,
  title,
  resizeWidth = 96,
  tint = false,
  logoBg = null,
  labelled = false,
} = Astro.props;
const hoverText = title ?? name;
const resizedLogoUrl = resizedImageUrl(logoUrl, { width: resizeWidth });
---

{labelled ? (
  <IconTip label={hoverText}>
    {resizedLogoUrl ? (
      <img
        src={resizedLogoUrl}
        alt={hoverText}
        role="img"
        aria-label={hoverText}
        title={hoverText}
        tabindex="0"
        loading="lazy"
        class={`${size} flex-none rounded object-contain ${grayscale ? 'grayscale' : ''} ${tint ? 'theme-tint' : ''}`}
        data-testid="team-logo-icon"
        {...logoBgAttrs(logoBg)}
      />
    ) : (
      <span
        role="img"
        aria-label={hoverText}
        title={hoverText}
        tabindex="0"
        class={`${size} flex flex-none items-center justify-center rounded bg-white/10 text-[9px] font-bold uppercase tracking-wide text-white/50`}
        data-testid="team-logo-icon"
      >
        <span aria-hidden="true">{teamInitials(name)}</span>
      </span>
    )}
  </IconTip>
) : resizedLogoUrl ? (
  <img src={resizedLogoUrl} alt="" title={hoverText} loading="lazy" class={`${size} flex-none rounded object-contain ${grayscale ? 'grayscale' : ''} ${tint ? 'theme-tint' : ''}`} {...logoBgAttrs(logoBg)} />
) : (
  <div
    class={`${size} flex-none rounded bg-white/10 flex items-center justify-center text-[9px] font-bold uppercase tracking-wide text-white/50 ${grayscale ? 'opacity-60' : ''}`}
    title={hoverText}
  >
    {teamInitials(name)}
  </div>
)}
