---
import type { Driver } from '../lib/supabase';
import { formatDate } from '../lib/supabase';
import { classBadgeClasses } from '../lib/classColors';
import TeamLogo from './TeamLogo.astro';

interface Props {
  driver: Driver;
  index?: number;
}

const { driver, index = 0 } = Astro.props;

const className = driver.driver_classes?.name ?? '';
const statusName = driver.driver_statuses?.name ?? '';
const badgeClasses = classBadgeClasses(className);
---

<tr
  class="border-b border-white/5 text-sm transition hover:bg-white/[0.04]"
  data-class={className}
  data-status={statusName}
>
  <td
    class="py-2.5 pl-4 pr-2 font-display text-lg leading-none text-white/70"
    data-col="number"
    data-sort-value={driver.car_number ?? Number.MAX_SAFE_INTEGER}
  >
    {driver.car_number !== null ? `#${driver.car_number}` : '—'}
  </td>
  <td class="py-2.5 pr-3" data-col="name">
    <div class="flex items-center gap-2">
      <span class="font-semibold">{driver.name}</span>
      {driver.is_rookie && (
        <span class="rounded bg-white/10 px-1.5 py-0.5 text-[10px] font-semibold uppercase tracking-wide text-white/60">
          Rookie
        </span>
      )}
    </div>
  </td>
  <td class="hidden py-2.5 pr-3 text-white/60 sm:table-cell" data-col="team">
    <div class="flex items-center gap-2">
      {driver.teams && <TeamLogo name={driver.teams.name} logoUrl={driver.teams.logo_url} size="h-5 w-5" />}
      <span>{driver.teams?.name ?? '—'}</span>
    </div>
  </td>
  <td class="py-2.5 pr-3" data-col="class">
    <span class={`rounded-lg border px-2 py-0.5 text-xs font-semibold uppercase tracking-wide ${badgeClasses}`}>
      {className}
    </span>
  </td>
  <td class="hidden py-2.5 pr-3 text-white/60 md:table-cell" data-col="status">{statusName}</td>
  <td
    class="hidden py-2.5 pr-3 text-white/60 lg:table-cell"
    data-col="signup"
    data-sort-value={driver.sign_up_date ?? ''}
  >
    {formatDate(driver.sign_up_date)}
  </td>
  <td class="hidden py-2.5 pr-3 text-center text-white/60 lg:table-cell" data-col="starts">{driver.starts}</td>
  <td class="hidden py-2.5 pr-3 text-center text-white/60 lg:table-cell" data-col="seasons">{driver.seasons_count}</td>
  <td class="py-2.5 pr-4 text-center font-semibold" data-col="penalty" data-sort-value={driver.penalty_points}>
    {driver.penalty_points}/{driver.penalty_points_max}
  </td>
</tr>
