---
import type { Driver } from '../lib/supabase';
import { formatDateShort, displayDriverName } from '../lib/supabase';
import { classBadgeClasses } from '../lib/classColors';
import TeamLogo from './TeamLogo.astro';
import DriverFlag from './DriverFlag.astro';

interface Props {
  driver: Driver;
  index?: number;
  /** Whether rulebook rules 57-62's probation window is currently active for this driver — computed once for the whole roster in roster.astro (see isOnProbationNow), not per-row, since it needs the full events calendar. Shown as a badge under the Status cell. */
  onProbation?: boolean;
  /** Hover text for the Status cell — the same buildInactivityNote() breakdown ("Last raced ...; N/M rounds absent; N/M days absent") the admin Drivers list shows, computed once for the whole roster in roster.astro. Undefined omits the title attribute entirely. */
  statusTooltip?: string;
}

const { driver, index = 0, onProbation = false, statusTooltip } = Astro.props;

const className = driver.driver_classes?.name ?? '';
const statusName = driver.driver_statuses?.name ?? '';
const badgeClasses = classBadgeClasses(className);
// Name + number + team, lowercased, for the roster search box (see
// roster.astro's initRosterFilters) — same data-attribute-driven
// client-side filter pattern as data-class/data-status above.
const searchText = [displayDriverName(driver.name), driver.car_number !== null ? `#${driver.car_number}` : '', driver.teams?.name ?? '']
  .join(' ')
  .toLowerCase();
---

<tr
  class="border-b border-white/5 text-sm transition hover:bg-white/[0.04]"
  data-class={className}
  data-status={statusName}
  data-unassigned={String(driver.car_number === null)}
  data-search={searchText}
  data-driver-id={driver.id}
>
  <td
    class="py-2.5 pl-4 pr-2 font-display text-lg leading-none text-white/70"
    data-col="number"
    data-sort-value={driver.car_number ?? Number.MAX_SAFE_INTEGER}
  >
    {driver.car_number !== null ? `#${driver.car_number}` : '—'}
  </td>
  <td class="py-2.5 pr-3" data-col="name">
    <div class="flex items-center gap-2">
      <DriverFlag nationality1={driver.nationality_1} nationality2={driver.nationality_2} />
      <span class="font-semibold">{displayDriverName(driver.name)}</span>
      {driver.is_rookie && (
        <span class="rounded bg-white/10 px-1.5 py-0.5 text-[10px] font-semibold uppercase tracking-wide text-white/60">
          Rookie
        </span>
      )}
    </div>
  </td>
  <td class="hidden py-2.5 pr-3 text-white/60 sm:table-cell" data-col="team">
    <div class="flex items-center gap-2">
      {driver.teams && <TeamLogo name={driver.teams.name} logoUrl={driver.teams.logo_url} size="h-5 w-5" />}
      <span>{driver.teams?.name ?? '—'}</span>
    </div>
  </td>
  <td class="py-2.5 pr-3" data-col="class">
    <span class={`rounded-lg border px-2 py-0.5 text-xs font-semibold uppercase tracking-wide ${badgeClasses}`}>
      {className}
    </span>
  </td>
  <td class="hidden py-2.5 pr-3 text-white/60 md:table-cell" data-col="status" title={statusTooltip}>
    <div class="flex flex-col">
      <span>{statusName}</span>
      {onProbation && <span class="text-[10px] font-semibold uppercase tracking-wide text-brand-pink">Probation</span>}
    </div>
  </td>
  <td
    class="hidden py-2.5 pr-3 text-white/60 lg:table-cell"
    data-col="signup"
    data-sort-value={driver.sign_up_date ?? ''}
  >
    {formatDateShort(driver.sign_up_date)}
  </td>
  <!--
    driver.starts is the stored column — only ever set by generate_seed.py's
    one-time CSV upsert, never kept in sync as new races get scored (see
    /api/driver-career-totals's own doc comment). It's rendered here as the
    immediate paint so the table isn't empty while that loads, then
    roster.astro's own script overwrites this cell (by this row's
    data-driver-id) with the live, always-correct number once the fetch
    resolves — same "stale-first, live-patch-after" pattern round-recap uses.
  -->
  <td class="hidden py-2.5 pr-4 text-center text-white/60 lg:table-cell" data-col="starts">{driver.starts}</td>
</tr>
