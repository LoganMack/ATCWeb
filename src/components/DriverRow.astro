---
import type { Driver } from '../lib/supabase';
import { formatDate, displayDriverName } from '../lib/supabase';
import { classBadgeClasses } from '../lib/classColors';
import TeamLogo from './TeamLogo.astro';
import DriverFlag from './DriverFlag.astro';

interface Props {
  driver: Driver;
  index?: number;
  /** Whether rulebook rules 57-62's probation window is currently active for this driver — computed once for the whole roster in roster.astro (see isOnProbationNow), not per-row, since it needs the full events calendar. */
  onProbation?: boolean;
  /** This driver's CURRENT SEASON penalty-points tally (rule 57), live-computed once for the whole roster in roster.astro (see computeSeasonPPState) rather than trusting driver.penalty_points as-is — falls back to that stored column if the live computation failed. */
  seasonPenaltyPoints?: number;
}

const { driver, index = 0, onProbation = false, seasonPenaltyPoints = driver.penalty_points } = Astro.props;

const className = driver.driver_classes?.name ?? '';
const statusName = driver.driver_statuses?.name ?? '';
const badgeClasses = classBadgeClasses(className);
// Name + number + team, lowercased, for the roster search box (see
// roster.astro's initRosterFilters) — same data-attribute-driven
// client-side filter pattern as data-class/data-status above.
const searchText = [displayDriverName(driver.name), driver.car_number !== null ? `#${driver.car_number}` : '', driver.teams?.name ?? '']
  .join(' ')
  .toLowerCase();
---

<tr
  class="border-b border-white/5 text-sm transition hover:bg-white/[0.04]"
  data-class={className}
  data-status={statusName}
  data-unassigned={String(driver.car_number === null && driver.appearances > 0)}
  data-search={searchText}
>
  <td
    class="py-2.5 pl-4 pr-2 font-display text-lg leading-none text-white/70"
    data-col="number"
    data-sort-value={driver.car_number ?? Number.MAX_SAFE_INTEGER}
  >
    {driver.car_number !== null ? `#${driver.car_number}` : '—'}
  </td>
  <td class="py-2.5 pr-3" data-col="name">
    <div class="flex items-center gap-2">
      <DriverFlag nationality1={driver.nationality_1} nationality2={driver.nationality_2} />
      <span class="font-semibold">{displayDriverName(driver.name)}</span>
      {driver.is_rookie && (
        <span class="rounded bg-white/10 px-1.5 py-0.5 text-[10px] font-semibold uppercase tracking-wide text-white/60">
          Rookie
        </span>
      )}
    </div>
  </td>
  <td class="hidden py-2.5 pr-3 text-white/60 sm:table-cell" data-col="team">
    <div class="flex items-center gap-2">
      {driver.teams && <TeamLogo name={driver.teams.name} logoUrl={driver.teams.logo_url} size="h-5 w-5" />}
      <span>{driver.teams?.name ?? '—'}</span>
    </div>
  </td>
  <td class="py-2.5 pr-3" data-col="class">
    <span class={`rounded-lg border px-2 py-0.5 text-xs font-semibold uppercase tracking-wide ${badgeClasses}`}>
      {className}
    </span>
  </td>
  <td class="hidden py-2.5 pr-3 text-white/60 md:table-cell" data-col="status">{statusName}</td>
  <td
    class="hidden py-2.5 pr-3 text-white/60 lg:table-cell"
    data-col="signup"
    data-sort-value={driver.sign_up_date ?? ''}
  >
    {formatDate(driver.sign_up_date)}
  </td>
  <td class="hidden py-2.5 pr-3 text-center text-white/60 lg:table-cell" data-col="starts">{driver.starts}</td>
  <td class="hidden py-2.5 pr-3 text-center text-white/60 lg:table-cell" data-col="seasons">{driver.seasons_count}</td>
  <td class="py-2.5 pr-4 text-center font-semibold" data-col="penalty" data-sort-value={seasonPenaltyPoints}>
    <div class="flex h-8 flex-col items-center justify-center">
      <div>{seasonPenaltyPoints}/{driver.penalty_points_max}</div>
      {onProbation && <div class="text-[10px] font-semibold uppercase tracking-wide text-brand-pink">Probation</div>}
    </div>
  </td>
</tr>
