---
// The Incident Management tab's popups (U5; BR11.6, BR11.8, BR11.14): Add Comment, Submit Appeal and the
// existing Incident Details popup for View Incident. Rendered for the owner only, after the profile form,
// because a form can't sit inside another. Without JavaScript the two forms post normally and the page
// redirects back with a status; with it, src/scripts/incidentManagement.ts posts them in place.
import IncidentDetailsDialog from './IncidentDetailsDialog.astro';
import IncidentCommentDialog from './IncidentCommentDialog.astro';
import type { IncidentRow } from '../lib/incidents';
import {
  APPEAL_ALLOWED_MIME_TYPES,
  APPEAL_MAX_FILE_BYTES,
  APPEAL_MAX_FILE_MB,
  APPEAL_MAX_FILES,
  APPEAL_MAX_MESSAGE_LENGTH,
} from '../lib/incidentAppeals';

interface Props {
  /** The owner's profile path, which both forms post to. */
  action: string;
  /** The owner's posted incidents, keyed by penalty id, for View Incident. */
  detailRows: IncidentRow[];
}

const { action, detailRows } = Astro.props;
const dialogClass =
  'w-full max-w-md rounded-xl border border-white/10 bg-brand-ink p-0 text-white backdrop:bg-black/60';
const errorClass = 'hidden rounded-md border border-brand-pink/30 bg-brand-pink/10 p-2 text-xs text-brand-pink/90';
---

{detailRows.length > 0 && <IncidentDetailsDialog rows={detailRows} />}

<IncidentCommentDialog action={action} />

<dialog data-incident-appeal-dialog aria-labelledby="incident-appeal-title" class={dialogClass} data-testid="incident-appeal-dialog">
  <form
    method="post"
    action={action}
    enctype="multipart/form-data"
    data-incident-appeal-form
    data-max-files={String(APPEAL_MAX_FILES)}
    data-max-file-bytes={String(APPEAL_MAX_FILE_BYTES)}
    data-max-file-mb={String(APPEAL_MAX_FILE_MB)}
    class="flex max-h-[85vh] flex-col gap-4 overflow-y-auto p-5"
  >
    <input type="hidden" name="intent" value="submit-appeal-from-profile" />
    <input type="hidden" name="penalty_id" data-incident-appeal-penalty />
    <div class="flex items-center justify-between">
      <h2 id="incident-appeal-title" class="font-display text-lg">Submit Appeal</h2>
      <button type="button" data-close-incident-dialog class="text-white/40 hover:text-white" aria-label="Close">✕</button>
    </div>
    <p data-incident-appeal-round class="text-sm font-semibold"></p>
    <label class="block text-sm">
      <span class="text-white/60">Describe your appeal.</span>
      <textarea
        name="message"
        required
        rows="6"
        maxlength={APPEAL_MAX_MESSAGE_LENGTH}
        class="mt-1 block w-full rounded-lg border border-white/10 bg-white/5 px-3 py-2 text-white"
      ></textarea>
    </label>
    <label class="block text-sm">
      <span class="text-white/60">Attachments (optional — up to {APPEAL_MAX_FILES} files, {APPEAL_MAX_FILE_MB} MB each)</span>
      <input
        type="file"
        name="files"
        multiple
        accept={APPEAL_ALLOWED_MIME_TYPES.join(',')}
        data-incident-appeal-files
        class="mt-1 block w-full text-xs text-white/60 file:mr-2 file:rounded file:border-0 file:bg-white/10 file:px-3 file:py-1.5 file:text-xs file:font-semibold file:text-white file:transition hover:file:bg-fixed-white/20"
      />
      <span class="mt-1 block text-[11px] text-white/30">Images, PDFs, videos (MP4/WebM/MOV) or text files.</span>
    </label>
    <p data-incident-dialog-error role="alert" class={errorClass}></p>
    <div class="flex justify-end gap-2">
      <button type="button" data-close-incident-dialog class="btn btn-neutral">Cancel</button>
      <button type="submit" class="btn btn-gold" data-incident-dialog-submit>Submit Appeal</button>
    </div>
  </form>
</dialog>
