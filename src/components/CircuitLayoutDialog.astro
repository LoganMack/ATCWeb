---
/**
 * The add or edit layout dialog on admin/circuits/[id] (circuit-editor BR1.14 to BR1.16, BR1.19), styled like
 * KudosDialog. Rendered from a LayoutFormState, so a refused save reopens with what was typed. There are no
 * lap record inputs: the app never writes those columns. Behaviour lives in src/scripts/circuitEditor.ts.
 */
import type { LayoutFormState } from '../lib/circuitEditorForm';
import { LAYOUT_CATEGORIES, LAYOUT_CATEGORY_LABELS, isLayoutCategory } from '../lib/circuitCategory';

interface Props {
  state: LayoutFormState;
  circuitId: string;
  openOnLoad: boolean;
}

const { state, circuitId, openOnLoad } = Astro.props;
const isNew = state.dialogKey === 'new';
const dialogId = `layout-dialog-${state.dialogKey}`;
const titleId = `${dialogId}-title`;
const errorId = `${dialogId}-error`;
const fieldClass =
  'rounded-md border border-white/15 bg-white/5 px-2 py-1.5 text-sm text-white outline-none focus:border-brand-primary';
const labelClass = 'flex flex-col gap-1 text-[11px] text-white/50';

/** aria-invalid and aria-describedby for the field the error names. */
const errorAttrs = (field: string): Record<string, string> =>
  state.error?.field === field ? { 'aria-invalid': 'true', 'aria-describedby': errorId } : {};
---

<dialog
  id={dialogId}
  aria-labelledby={titleId}
  data-layout-dialog
  data-circuit-id={circuitId}
  {...(openOnLoad ? { 'data-open-on-load': '' } : {})}
  class="w-full max-w-xl rounded-xl border border-white/10 bg-brand-ink p-0 text-white backdrop:bg-black/60"
>
  <form method="POST" data-astro-reload enctype="multipart/form-data" class="flex flex-col gap-3 p-5">
    <input type="hidden" name="intent" value={isNew ? 'add-layout' : 'update-layout'} />
    {!isNew && <input type="hidden" name="layout_id" value={state.dialogKey} />}
    <div class="flex items-center justify-between">
      <h2 id={titleId} class="font-display text-xl">{isNew ? 'Add layout' : 'Edit layout'}</h2>
      <button type="button" data-close-dialog aria-label="Close" class="text-white/40 hover:text-white">✕</button>
    </div>

    {state.error && (
      <p
        role="alert"
        id={errorId}
        class="rounded-lg border border-brand-pink/30 bg-brand-pink/10 p-3 text-sm text-white/80"
      >
        {state.error.message}
      </p>
    )}

    <label class={labelClass}>
      Layout Name
      <input
        type="text"
        name="layout_name"
        required
        value={state.name}
        placeholder="Full Course"
        data-first-field
        class={fieldClass}
        {...errorAttrs('layout_name')}
      />
    </label>

    <label class={labelClass}>
      Category
      <select name="category" required class={fieldClass} {...errorAttrs('category')}>
        <option value="" disabled hidden selected={!isLayoutCategory(state.category)} class="bg-brand-ink text-white">
          Choose a category
        </option>
        {LAYOUT_CATEGORIES.map((key) => (
          <option value={key} selected={state.category === key} class="bg-brand-ink text-white">
            {LAYOUT_CATEGORY_LABELS[key]}
          </option>
        ))}
      </select>
    </label>

    <div class="grid grid-cols-2 gap-3">
      <label class={labelClass}>
        Length (km)
        <input
          type="number"
          step="0.001"
          min="0"
          max="100"
          name="length_km"
          value={state.lengthKm}
          class={fieldClass}
          {...errorAttrs('length_km')}
        />
      </label>
      <label class={labelClass}>
        Corners
        <input
          type="number"
          step="1"
          min="0"
          max="200"
          name="corners"
          value={state.corners}
          class={fieldClass}
          {...errorAttrs('corners')}
        />
      </label>
    </div>

    <label class={labelClass}>
      Layout map
      <input
        type="file"
        name="layout_image"
        accept="image/png,image/jpeg,image/webp,image/svg+xml"
        class={`${fieldClass} file:mr-2 file:rounded-md file:border-0 file:bg-white/10 file:px-2 file:py-1 file:text-white`}
      />
      <span class="text-white/40">
        {isNew
          ? 'Optional — shown on the Event Briefing page, square.'
          : "Uploading a new file replaces this layout's current map. Shown on the Event Briefing page, square."}
      </span>
    </label>

    <div class="mt-1 flex justify-end gap-2">
      <button type="button" data-close-dialog class="btn btn-neutral">Cancel</button>
      <button type="submit" class="btn btn-primary">Save layout</button>
    </div>
  </form>
</dialog>
