---
// One fieldset per event session (practice/qualifying/race1-3), reused
// from the admin event form. Which extra inputs show depends on the
// session type: practice takes a minutes length, qualifying takes both
// minutes and laps, races take laps only.
interface Props {
  prefix: string; // form field name prefix, e.g. 'practice', 'race1'
  label: string;
  showMinutes?: boolean;
  showLaps?: boolean;
  required?: boolean;
  startTime: string | null;
  /** In-sim time of day (0023_event_sim_times.sql) — optional on every session type, unlike startTime which is required for race1. */
  simTime?: string | null;
  minutes?: number | null;
  laps?: number | null;
  weather: string | null;
}

const {
  prefix,
  label,
  showMinutes = false,
  showLaps = false,
  required = false,
  startTime,
  simTime = null,
  minutes = null,
  laps = null,
  weather,
} = Astro.props;
---

<fieldset class="rounded-lg border border-white/10 p-4">
  <legend class="px-1 text-sm font-semibold text-white/80">{label}{required && ' *'}</legend>
  <div class="mt-2 grid gap-3 sm:grid-cols-2 lg:grid-cols-5">
    <label class="flex flex-col gap-1.5 text-sm">
      <span class="text-white/60">Start time (Eastern)</span>
      <input
        type="time"
        name={`${prefix}_start_time`}
        required={required}
        value={startTime ?? ''}
        data-time-input
        class="rounded-md border border-white/15 bg-white/5 px-3 py-2 text-white outline-none focus:border-brand-primary"
      />
      <!-- Filled in client-side (see the script at the bottom of this
           component) once the browser knows both this value and the
           event's date — every time in this app is entered as Eastern
           (see src/lib/timezone.ts), so this is purely a "here's what
           that is in YOUR timezone" convenience, not a second input. -->
      <span data-time-local-preview class="text-xs text-white/40"></span>
    </label>

    <label class="flex flex-col gap-1.5 text-sm">
      <span class="text-white/60">In-sim time</span>
      <input
        type="time"
        name={`${prefix}_sim_time`}
        value={simTime ?? ''}
        class="rounded-md border border-white/15 bg-white/5 px-3 py-2 text-white outline-none focus:border-brand-primary"
      />
    </label>

    {showMinutes && (
      <label class="flex flex-col gap-1.5 text-sm">
        <span class="text-white/60">Length (minutes)</span>
        <input
          type="number"
          min="0"
          name={`${prefix}_minutes`}
          value={minutes ?? ''}
          class="rounded-md border border-white/15 bg-white/5 px-3 py-2 text-white outline-none focus:border-brand-primary"
        />
      </label>
    )}

    {showLaps && (
      <label class="flex flex-col gap-1.5 text-sm">
        <span class="text-white/60">Laps</span>
        <input
          type="number"
          min="0"
          name={`${prefix}_laps`}
          value={laps ?? ''}
          class="rounded-md border border-white/15 bg-white/5 px-3 py-2 text-white outline-none focus:border-brand-primary"
        />
      </label>
    )}

    <label class="flex flex-col gap-1.5 text-sm">
      <span class="text-white/60">Weather</span>
      <select
        name={`${prefix}_weather`}
        class="rounded-md border border-white/15 bg-white/5 px-3 py-2 text-white outline-none focus:border-brand-primary"
      >
        <option value="" selected={!weather} class="bg-brand-ink text-white">Not set</option>
        <option value="dry" selected={weather === 'dry'} class="bg-brand-ink text-white">Dry</option>
        <option value="mixed" selected={weather === 'mixed'} class="bg-brand-ink text-white">Mixed</option>
        <option value="wet" selected={weather === 'wet'} class="bg-brand-ink text-white">Wet</option>
      </select>
    </label>
  </div>
</fieldset>

<script>
  // This component is used up to 5 times per page (practice/qualifying/
  // race1-3) — Astro dedupes identical inline scripts across repeated
  // component instances automatically, so this runs once per page and
  // just operates on every matching element/form, not "this" instance.
  import { zonedTimeToUtc, LEAGUE_TIME_ZONE } from '../lib/timezone';

  function updatePreview(input: HTMLInputElement, eventDateValue: string) {
    const preview = input.parentElement?.querySelector<HTMLElement>('[data-time-local-preview]');
    if (!preview) return;
    if (!input.value || !eventDateValue) {
      preview.textContent = '';
      return;
    }
    const utc = zonedTimeToUtc(eventDateValue, input.value, LEAGUE_TIME_ZONE);
    if (!utc) {
      preview.textContent = '';
      return;
    }
    const local = utc.toLocaleTimeString(undefined, { hour: 'numeric', minute: '2-digit', timeZoneName: 'short' });
    preview.textContent = `= ${local} in your timezone`;
  }

  function initEventTimePreviews() {
    const dateInput = document.querySelector<HTMLInputElement>('input[name="event_date"]');
    const timeInputs = document.querySelectorAll<HTMLInputElement>('[data-time-input]');
    if (!dateInput || timeInputs.length === 0) return;
    if (dateInput.dataset.timePreviewBound === 'true') return;
    dateInput.dataset.timePreviewBound = 'true';

    const updateAll = () => timeInputs.forEach((input) => updatePreview(input, dateInput.value));

    dateInput.addEventListener('input', updateAll);
    timeInputs.forEach((input) => input.addEventListener('input', () => updatePreview(input, dateInput.value)));
    updateAll();
  }

  document.addEventListener('astro:page-load', initEventTimePreviews);
</script>
