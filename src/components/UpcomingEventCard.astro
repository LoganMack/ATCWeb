---
import type { EventWithCircuit } from '../lib/supabase';
import {
  formatEventDate,
  formatEventDateShort,
  formatSessionTime,
  FORMAT_BADGE_CLASSES,
  FORMAT_LABELS,
  getEventSessions,
} from '../lib/eventFormatting';
import WeatherIcon from './WeatherIcon.astro';

interface Props {
  event: EventWithCircuit;
  featured?: boolean;
  index?: number;
}

const { event, featured = false, index = 0 } = Astro.props;
const circuitName = event.circuits?.name ?? 'TBA';
const sessions = featured ? getEventSessions(event) : [];
---

{featured ? (
  <div
    class="reveal rounded-xl border border-brand-primary/40 bg-brand-primary/10 p-5"
    style={`transition-delay: ${280 + index * 60}ms`}
  >
    <div class="flex items-center justify-between gap-3">
      <p class="font-display text-sm uppercase tracking-widest text-brand-primary">Next Up</p>
      <span class={`rounded-lg px-2.5 py-1 text-xs font-semibold uppercase tracking-wide ${FORMAT_BADGE_CLASSES[event.format]}`}>
        {FORMAT_LABELS[event.format]}
      </span>
    </div>

    <div class="mt-3 flex items-center gap-3">
      {event.circuits?.logo_url && (
        <img src={event.circuits.logo_url} alt="" class="h-10 w-10 flex-none rounded object-contain" />
      )}
      <div>
        <h3 class="font-display text-2xl leading-none">{circuitName}</h3>
        {event.layout && <p class="text-sm text-white/50">{event.layout}</p>}
      </div>
    </div>

    <p class="mt-3 text-sm text-white/70">{formatEventDate(event.event_date)}</p>

    <ul class="mt-4 space-y-1.5 text-sm">
      {sessions.map((s) => (
        <li class="flex items-center justify-between gap-2 text-white/70">
          <span class="flex items-center gap-1.5">
            <WeatherIcon condition={s.weather} class="text-base" />
            {s.label}
          </span>
          <span class="text-white/50">
            {s.startTime && formatSessionTime(s.startTime)}
            {s.detail && ` · ${s.detail}`}
          </span>
        </li>
      ))}
    </ul>
  </div>
) : (
  <a
    href="/calendar"
    class="reveal flex items-center justify-between gap-3 rounded-lg border border-white/10 bg-white/[0.03] px-4 py-3 transition hover:border-white/20 hover:bg-white/[0.06]"
    style={`transition-delay: ${280 + index * 60}ms`}
  >
    <div class="flex items-center gap-3">
      {event.circuits?.logo_url && (
        <img src={event.circuits.logo_url} alt="" class="h-7 w-7 flex-none rounded object-contain" />
      )}
      <div>
        <p class="font-semibold">{circuitName}</p>
        <p class="text-xs text-white/50">{formatEventDateShort(event.event_date)}</p>
      </div>
    </div>
    <span class={`rounded-lg px-2 py-0.5 text-[10px] font-semibold uppercase tracking-wide ${FORMAT_BADGE_CLASSES[event.format]}`}>
      {FORMAT_LABELS[event.format]}
    </span>
  </a>
)}
