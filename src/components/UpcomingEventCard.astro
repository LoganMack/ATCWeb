---
import type { EventWithCircuit } from '../lib/db/events';
import type { CircuitLayout } from '../lib/db/circuits';
import { displayLayoutName, eventImageUrl, logoBgAttrs, type LogoBackground } from '../lib/db/circuits';
import { resizedImageUrl } from '../lib/db/drivers';
import {
  formatEventDate,
  formatEventDateShort,
  formatSessionTime,
  FORMAT_BADGE_CLASSES,
  EVENT_TAG_CLASSES, EVENT_TAG_COMPACT_CLASSES,
  FORMAT_LABELS,
  CATEGORY_BADGE_CLASSES,
  CATEGORY_LABELS,
  usesFormatBadge,
  getEventSessions,
  getEventCardClasses,
  getEventCardHoverClasses,
} from '../lib/eventFormatting';
import { buildEventIcsBlock } from '../lib/ics';
import { slugify } from '../lib/slug';
import WeatherIcon from './WeatherIcon.astro';
import TbdTile from './TbdTile.astro';
import { isTbdEvent, TBD_LABEL } from '../lib/eventTbd';

interface Props {
  event: EventWithCircuit;
  featured?: boolean;
  index?: number;
  /** See EventDetailCard.astro's own doc comment on this same prop — a layout's own image takes priority over the circuit's generic logo. Optional — falls back to just the circuit logo if a caller doesn't have this on hand. */
  layouts?: Pick<CircuitLayout, 'circuit_id' | 'name' | 'image_url'>[];
  /** Circuit id -> light/dark plate behind the track logo (getCircuitLogoBackgrounds). Optional — no plate if a caller doesn't pass it. */
  logoBackgrounds?: Record<string, LogoBackground>;
  /**
   * The homepage line "<date> - ATCn, Round n" (eventSubtitle in src/lib/eventSubtitle.ts, BR11.1). It replaces
   * the featured card's top date and the compact row's short date (BR11.2). Without it the dates show as before.
   */
  subtitle?: string | null;
}

const { event, featured = false, index = 0, layouts = [], logoBackgrounds = {}, subtitle = null } = Astro.props;
const circuitName = event.title ?? event.circuits?.name ?? TBD_LABEL;
// Circuit not known yet: a TBD championship shows no badge, a TBD exhibition its category; no briefing.
const tbd = isTbdEvent(event);
// The gradient is for the "TBD" name only, not a TBD event that has a title of its own (BR9.1).
const tbdName = tbd && circuitName === TBD_LABEL;
const showFormat = usesFormatBadge(event.category) && !tbd;
const showCategory = !usesFormatBadge(event.category) || (tbd && event.category !== 'championship');
const sessions = featured ? getEventSessions(event) : [];
const imageUrl = resizedImageUrl(eventImageUrl(event, event.circuits, layouts), { width: 80 });
// Only the featured card gets Add to Calendar: the compact rows are links, where a nested button is invalid.
const icsBlock = featured ? buildEventIcsBlock(event, layouts) : null;
const icsFilename = `atc-${slugify(circuitName)}-${event.event_date}.ics`;
---

{featured ? (
  <div
    class={`reveal rounded-xl border p-5 ${getEventCardClasses(event)}`}
    style={`transition-delay: ${280 + index * 60}ms`}
  >
    <div class="flex items-center justify-between gap-3">
      <p class="font-display text-sm uppercase tracking-widest text-white/60">{subtitle ?? formatEventDate(event.event_date)}</p>
      {showFormat && (
        <span class={`${EVENT_TAG_CLASSES} ${FORMAT_BADGE_CLASSES[event.format]}`}>
          {FORMAT_LABELS[event.format]}
        </span>
      )}
      {/* TEST/HOLIDAY/IRACING events don't use the format field (see eventFormatting.ts) — same override as
          EventDetailCard.astro. */}
      {showCategory && (
        <span class={`${EVENT_TAG_CLASSES} ${CATEGORY_BADGE_CLASSES[event.category]}`}>
          {CATEGORY_LABELS[event.category]}
        </span>
      )}
    </div>

    <div class="mt-3 flex items-center gap-3">
      {imageUrl ? (
        <img src={imageUrl} alt="" loading="lazy" class="h-10 w-10 flex-none rounded object-contain" {...logoBgAttrs(event.circuit_id ? logoBackgrounds[event.circuit_id] : null)} />
      ) : (
        tbd && <TbdTile class="h-10 w-10" />
      )}
      <div>
        <h3 class={`font-display text-2xl leading-none ${tbdName ? 'tbd-gradient' : ''}`}>{circuitName}</h3>
        {event.title ? (
          event.subtitle && <p class="text-sm text-white/50">{event.subtitle}</p>
        ) : (
          event.layout && <p class="text-sm text-white/50">{displayLayoutName(event.layout)}</p>
        )}
      </div>
    </div>

    {/* A borderless <table> so the ET time, in-sim time and detail line up across session rows. */}
    <table class="mt-4 w-full border-separate border-spacing-y-1.5 text-left text-sm">
      <tbody>
        {sessions.map((s) => (
          <tr class="text-white/70">
            <td class="align-middle">
              <span class="flex items-center gap-1.5">
                <WeatherIcon condition={s.weather} class="text-base" />
                {s.label}
              </span>
            </td>
            <td class="whitespace-nowrap pl-2 align-middle text-white/50">
              {s.startTime && (
                <span data-utc-time={s.startTimeUtcIso ?? undefined}>{formatSessionTime(s.startTime)} ET</span>
              )}
            </td>
            {/* In-sim timing hidden on mobile (Logan) — this card is narrow there and the IRL start time is the one people actually plan around. */}
            <td class="hidden whitespace-nowrap pl-2 align-middle text-white/50 sm:table-cell">
              {s.simTime && `${formatSessionTime(s.simTime)} iRacing`}
            </td>
            <td class="pl-2 align-middle text-white/50">
              {/* This card wants only qualifying's lap count, not the shared detail that also includes its
                 minutes. */}
              {s.label === 'Qualifying' ? (event.qualifying_laps ? `${event.qualifying_laps} laps` : null) : s.detail}
            </td>
          </tr>
        ))}
      </tbody>
    </table>

    {/* Event Briefing and Add to Calendar, only on the featured next event; the briefing goes left of Add
       to Calendar (Logan). */}
    <div class="mt-4 flex flex-wrap items-center gap-2">
      {!tbd && (
      <a
        href={`/briefing/${event.id}`}
        class="btn btn-neutral btn-sm flex items-center gap-1.5"
      >
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="1em" height="1em" aria-hidden="true">
          <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20" />
          <path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z" />
        </svg>
        Event Briefing
      </a>
      )}

      {icsBlock && (
        <button
          type="button"
          data-ics-download
          data-ics-event={icsBlock}
          data-ics-filename={icsFilename}
          class="btn btn-neutral btn-sm flex items-center gap-1.5"
        >
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="1em" height="1em" aria-hidden="true">
            <rect x="3" y="4" width="18" height="18" rx="2" />
            <line x1="16" y1="2" x2="16" y2="6" />
            <line x1="8" y1="2" x2="8" y2="6" />
            <line x1="3" y1="10" x2="21" y2="10" />
            <line x1="12" y1="14" x2="12" y2="18" />
            <line x1="10" y1="16" x2="14" y2="16" />
          </svg>
          Add to Calendar
        </button>
      )}
    </div>
  </div>
) : (
  <a
    href="/calendar"
    class={`reveal flex items-center justify-between gap-3 rounded-lg border px-4 py-3 transition ${getEventCardHoverClasses(event)}`}
    style={`transition-delay: ${280 + index * 60}ms`}
  >
    <div class="flex items-center gap-3">
      {imageUrl ? (
        <img src={imageUrl} alt="" loading="lazy" class="h-7 w-7 flex-none rounded object-contain" {...logoBgAttrs(event.circuit_id ? logoBackgrounds[event.circuit_id] : null)} />
      ) : (
        tbd && <TbdTile class="h-7 w-7" textClass="text-[10px]" />
      )}
      <div>
        <p class={`font-semibold ${tbdName ? 'tbd-gradient' : ''}`}>{circuitName}</p>
        <p class="text-xs text-white/50">{subtitle ?? formatEventDateShort(event.event_date)}</p>
      </div>
    </div>
    {showFormat && (
      <span class={`${EVENT_TAG_COMPACT_CLASSES} ${FORMAT_BADGE_CLASSES[event.format]}`}>
        {FORMAT_LABELS[event.format]}
      </span>
    )}
    {showCategory && (
      <span class={`${EVENT_TAG_COMPACT_CLASSES} ${CATEGORY_BADGE_CLASSES[event.category]}`}>
        {CATEGORY_LABELS[event.category]}
      </span>
    )}
  </a>
)}
