---
// One stat tile: a big number, a label above and an optional subtitle (poles use appearances as the
// denominator, everything else starts). The subtitle is hidden on mobile (Logan).
interface Props {
  label: string;
  value: string | number;
  sub?: string;
  /** Label tail rendered without `uppercase`, so "Top 5" + "s" reads "TOP 5s". */
  labelSuffixLower?: string;
}

const { label, value, sub, labelSuffixLower } = Astro.props;
---

<div>
  <dt class="text-xs uppercase tracking-wide text-white/40">
    {label}{labelSuffixLower && <span class="lowercase">{labelSuffixLower}</span>}
  </dt>
  <dd class="mt-1 font-display text-3xl leading-none">{value}</dd>
  {sub && <p class="mt-1 hidden text-[11px] text-white/40 sm:block">{sub}</p>}
</div>
