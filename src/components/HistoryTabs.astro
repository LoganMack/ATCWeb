---
// Shared sub-nav for the series-history pages. Kept as its own small tab
// bar rather than separate top-level Nav.astro links, since the main nav
// is already fairly full — Nav.astro only links to /champions ("History").
//
// Race Results, Standings, and Team Standings used to be tabs here too, but
// they've been promoted to their own top-level Nav.astro links (Results,
// Standings) and are no longer reachable from this History sub-nav — see
// results.astro/standings.astro/team-standings.astro, which now render
// StandingsTabs.astro (or nothing, for Results) instead of this component.
interface Props {
  active: 'champions' | 'driverStats' | 'teamStats' | 'hallOfFame' | 'circuits';
}

const { active } = Astro.props;

const tabs: { key: Props['active']; href: string; label: string }[] = [
  { key: 'champions', href: '/champions', label: 'Champions' },
  { key: 'driverStats', href: '/driver-stats', label: 'Driver Stats' },
  { key: 'teamStats', href: '/team-stats', label: 'Team Stats' },
  { key: 'hallOfFame', href: '/hall-of-fame', label: 'Hall of Fame' },
  { key: 'circuits', href: '/circuits', label: 'Circuits' },
];
---

<!-- mt-12 gives clear breathing room above the tabs regardless of what
     precedes them (a bare h1, or a round's date/format subtitle line). -->
<div class="reveal mb-8 mt-12 flex gap-1 border-b border-white/10">
  {tabs.map((tab) => (
    <a
      href={tab.href}
      class={`-mb-px rounded-t-md border-b-2 px-4 py-2.5 text-sm font-semibold transition ${
        tab.key === active
          ? 'border-brand-primary text-white'
          : 'border-transparent text-white/50 hover:text-white'
      }`}
    >
      {tab.label}
    </a>
  ))}
</div>
