---
// The history pages' section picker: a dropdown placed first in each page's filter card, shared so all nine
// pages stay in sync (the nav links only /champions). Each option's value is its URL.
interface Props {
  active:
    | 'champions'
    | 'driverStats'
    | 'teamStats'
    | 'hallOfFame'
    | 'awards'
    | 'circuits'
    | 'incidents'
    | 'kudos'
    | 'interviews';
}

const { active } = Astro.props;

const sections: { key: Props['active']; href: string; label: string }[] = [
  { key: 'champions', href: '/champions', label: 'Champions' },
  { key: 'driverStats', href: '/driver-stats', label: 'Driver Stats' },
  { key: 'teamStats', href: '/team-stats', label: 'Team Stats' },
  { key: 'hallOfFame', href: '/hall-of-fame', label: 'Hall of Fame' },
  { key: 'awards', href: '/awards', label: 'Awards' },
  { key: 'circuits', href: '/circuits', label: 'Circuits' },
  { key: 'incidents', href: '/incidents', label: 'Incidents' },
  { key: 'kudos', href: '/kudos', label: 'Kudos' },
  { key: 'interviews', href: '/interviews', label: 'Interviews' },
];
---

<label class="flex flex-col gap-1.5 sm:w-44">
  <span class="text-xs font-semibold uppercase tracking-wide text-white/40">History</span>
  <select
    aria-label="History section"
    class="h-9 w-full rounded-md border border-white/15 bg-transparent px-3 text-sm text-white outline-none hover:bg-white/5 focus:border-brand-primary focus:bg-white/5"
    data-navigate-on-change
  >
    {sections.map((s) => (
      <option value={s.href} selected={s.key === active} class="bg-brand-ink text-white">{s.label}</option>
    ))}
  </select>
</label>
