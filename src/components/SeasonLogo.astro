---
// A season's logo, theme-aware. Most seasons have no light logo, so the dark one shows in both themes; with
// both, both <img>s render and CSS shows one, so there's no flash and no JS needed.
interface Props {
  darkUrl: string | null;
  lightUrl?: string | null;
  /** Tailwind size/shape classes, e.g. "h-9 w-9 rounded object-contain". */
  class?: string;
  alt?: string;
  loading?: 'lazy' | 'eager';
}

const { darkUrl, lightUrl = null, class: className = 'h-9 w-9 flex-none rounded object-contain', alt = '', loading } = Astro.props;
---

{darkUrl && lightUrl ? (
  <>
    <img src={darkUrl} alt={alt} loading={loading} class={`${className} [.light_&]:hidden`} />
    <img src={lightUrl} alt={alt} loading={loading} class={`${className} hidden [.light_&]:block`} />
  </>
) : (
  darkUrl && <img src={darkUrl} alt={alt} loading={loading} class={className} />
)}
