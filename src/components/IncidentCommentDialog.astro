---
// The Add Comment popup for a pending incident report (U5; BR11.6), shared by the profile's Incident Management
// tab and the round's Incident Submissions page. It posts to the commenter's own profile; without JavaScript
// the post redirects there with a status, and with it src/scripts/incidentManagement.ts posts it in place.
import { INCIDENT_COMMENT_MAX_LENGTH } from '../lib/incidents';

interface Props {
  /** The commenter's profile path, which the form posts to. */
  action: string;
}

const { action } = Astro.props;
const dialogClass =
  'w-full max-w-md rounded-xl border border-white/10 bg-brand-ink p-0 text-white backdrop:bg-black/60';
const errorClass = 'hidden rounded-md border border-brand-pink/30 bg-brand-pink/10 p-2 text-xs text-brand-pink/90';
---

<dialog data-incident-comment-dialog aria-labelledby="incident-comment-title" class={dialogClass} data-testid="incident-comment-dialog">
  <form
    method="post"
    action={action}
    enctype="multipart/form-data"
    data-incident-comment-form
    data-max-length={String(INCIDENT_COMMENT_MAX_LENGTH)}
    class="flex max-h-[85vh] flex-col gap-4 overflow-y-auto p-5"
  >
    <input type="hidden" name="intent" value="add-incident-comment" />
    <input type="hidden" name="report_id" data-incident-comment-report />
    <div class="flex items-center justify-between">
      <h2 id="incident-comment-title" class="font-display text-lg">Add Comment</h2>
      <button type="button" data-close-incident-dialog class="text-white/40 hover:text-white" aria-label="Close">✕</button>
    </div>
    <dl class="grid grid-cols-2 gap-x-6 gap-y-3 text-sm">
      <div class="col-span-2">
        <dt class="text-[11px] uppercase tracking-wide text-white/40">Round</dt>
        <dd data-incident-comment-field="round" class="mt-0.5 font-semibold"></dd>
      </div>
      <div>
        <dt class="text-[11px] uppercase tracking-wide text-white/40">Race</dt>
        <dd data-incident-comment-field="session" class="mt-0.5"></dd>
      </div>
      <div>
        <dt class="text-[11px] uppercase tracking-wide text-white/40">Lap / Turn</dt>
        <dd data-incident-comment-field="lapturn" class="mt-0.5"></dd>
      </div>
      <div data-incident-comment-description-row class="col-span-2 hidden">
        <dt class="text-[11px] uppercase tracking-wide text-white/40">Description</dt>
        <dd data-incident-comment-field="description" class="mt-0.5 whitespace-pre-line text-white/70"></dd>
      </div>
    </dl>
    <label class="block text-sm">
      <span class="text-white/60">Your comment</span>
      <textarea
        name="body"
        required
        rows="6"
        maxlength={INCIDENT_COMMENT_MAX_LENGTH}
        class="mt-1 block w-full rounded-lg border border-white/10 bg-white/5 px-3 py-2 text-white"
      ></textarea>
    </label>
    <p class="text-xs text-white/40">ⓘ Your comment is final and only stewards can see it.</p>
    <p data-incident-dialog-error role="alert" class={errorClass}></p>
    <div class="flex justify-end gap-2">
      <button type="button" data-close-incident-dialog class="btn btn-neutral">Cancel</button>
      <button type="submit" class="btn btn-gold" data-incident-dialog-submit>Send Comment</button>
    </div>
  </form>
</dialog>
