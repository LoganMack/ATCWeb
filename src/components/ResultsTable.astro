---
// One race's results table for both the overall and per-class views. Columns: Pos, Driver / Number, Class
// (overall only), Margin, Start, Incidents, Laps, Led, Best, Class Pts; pole and penalty markers sit inline
// on Start/Pos and tags beside the name. Penalties are read-only here (managed on the Incident Report). Each
// row expands (expandRows.ts) to lap times, overall race time (rule 18.3.2) and a points breakdown.
import DriverLink from './DriverLink.astro';
import type { RaceResultRow } from '../lib/results/roundResults';
import type { Penalty } from '../lib/db/penalties';
import { displayDriverName, shortDriverName } from '../lib/db/circuits';
import {
  effectiveTimePenaltySeconds,
  effectivePointsPenalty,
  effectivePenaltyPoints,
  scoringRaceNumber,
} from '../lib/penalties/effective';
import { classTagFull } from '../lib/classColors';
import TeamLogo from './TeamLogo.astro';
import DriverFlag from './DriverFlag.astro';

/** `total_points` minus every bonus/deduction component — the base points this driver earned purely from their overall finishing position (see RaceResultRow.bonusPoints' own doc comment on the total_points formula). Shown as the "Base Points" row in the expanded detail panel's points-breakdown table. */
function finishPoints(row: RaceResultRow): number {
  return row.totalPoints - row.bonusPoints;
}

interface BreakdownLine {
  label: string;
  value: number;
}

/**
 * Every nonzero bonus component, itemized for the points breakdown (base points and penalties are separate
 * rows).
 */
function bonusPointsLines(row: RaceResultRow): BreakdownLine[] {
  const lines: BreakdownLine[] = [];
  if (row.classPoints !== 0) lines.push({ label: 'Class', value: row.classPoints });
  if (row.finesseBonus !== 0) lines.push({ label: 'Finesse', value: row.finesseBonus });
  if (row.poleBonus !== 0) lines.push({ label: 'Pole', value: row.poleBonus });
  if (row.aggressionBonus !== 0) lines.push({ label: 'Aggression', value: row.aggressionBonus });
  if (row.lapLedBonus !== 0) lines.push({ label: 'Lap Led', value: row.lapLedBonus });
  if (row.fewestIncidentsBonus !== 0) lines.push({ label: 'Fewest Incidents', value: row.fewestIncidentsBonus });
  if (row.fastestLapBonus !== 0) lines.push({ label: 'Fastest Lap', value: row.fastestLapBonus });
  if (row.sprintSweepBonus !== 0) lines.push({ label: 'Sprint Sweep', value: row.sprintSweepBonus });
  return lines;
}

/** How many total points this round's penalties (this driver's own, or a cascade from someone else's in the same race repositioning them) netted this driver, positive or negative — 0 for a row nothing here ever touched. This is a DELTA, not another component of the breakdown above (those already sum to `totalPoints`, which already has this baked in) — shown as its own callout so a penalized/benefiting driver's net points swing is clear at a glance rather than something you'd have to infer by comparing against a different round. See RaceResultRow.originalTotalPoints' own doc comment. */
function penaltyPointsDelta(row: RaceResultRow): number {
  return row.totalPoints - row.originalTotalPoints;
}

/**
 * The penalty tag label: a private copy of sharedPenaltyTagLabel (src/lib/penalties/effective.ts), because
 * importing that broke `astro check` for this file. Change both together.
 */
function penaltyTagLabel(rowPenalties: Penalty[]): string {
  if (rowPenalties.length === 0) return '';
  const totalPP = rowPenalties.reduce((sum, p) => sum + effectivePenaltyPoints(p), 0);
  if (totalPP > 0) return `${totalPP}PP`;
  if (rowPenalties.some((p) => p.is_warning)) return 'Warning';
  const hasTimeOrPointsEffect = rowPenalties.some(
    (p) => effectiveTimePenaltySeconds(p) !== 0 || effectivePointsPenalty(p) !== 0
  );
  return hasTimeOrPointsEffect ? 'Penalty' : 'Racing Incident';
}

/**
 * Pink when a time penalty moved this driver down, blue when another driver's penalty moved them up (Logan).
 */
function positionChangeClass(row: RaceResultRow): string {
  if (row.penaltyOldPosition === null || row.position === null) return 'text-brand-pink';
  return row.position < row.penaltyOldPosition ? 'text-brand-blue' : 'text-brand-pink';
}

interface Props {
  raceNumber: number;
  rows: RaceResultRow[];
  showClass?: boolean;
  classNameById?: Map<number, string>;
  /** Every penalty logged anywhere in this round — filtered down to this race below. Passed unfiltered so callers don't need to slice it per race themselves. */
  penalties?: Penalty[];
  /**
   * `${raceNumber}:${driverId}` -> points the driver contributed to their team that race (top 2 scorers
   * count; topTeamScorers() in src/lib/results/seasonCarTeam.ts), computed once per page. No entry: no team,
   * or not in the top 2.
   */
  teamPointsByRaceDriver?: Map<string, number>;
  /** This round's Incident Limit (item 6, 0067_ruleset_overhaul_and_bonuses.sql) — a PER-RACE cap, informational only, no scoring effect. Null when the season's ruleset has no limit configured for this round's format (or no ruleset resolves at all). Only used here for the marker's tooltip; see incidentLimitExceededDriverIds for who it's actually shown on. */
  incidentLimit?: number | null;
  /** Driver ids whose incidents in THIS SPECIFIC RACE exceed incidentLimit — computed once at the page level, per race_number (a driver who trips the limit in Race 1 isn't necessarily flagged in Race 2, and vice versa — see results/[subsessionId].astro's incidentTotalByRaceDriver), so only this table's own race gets the marker, not every race the driver ran this round. */
  incidentLimitExceededDriverIds?: Set<string>;
  /**
   * The round's layout corner count (resolveLayout() in src/lib/results/layouts.ts), for the Incidents
   * column's corners-per-incident hover. Null when unknown.
   */
  layoutCorners?: number | null;
  /**
   * driverId -> fastest lap at this track before this round (getDriverBestLapsAtTrack() in
   * src/lib/results/layoutLaps.ts), for the personal-best marker. No entry: no prior lap, or the lookup
   * failed.
   */
  driverBestLapsAtTrack?: Map<string, number>;
  /** The fastest lap of the whole race (ten-thousandths of a second), measured across every class — so it stays the same in the Per Class view. That lap's time is shown in ATC blue. Null/undefined when no lap times are on file. */
  raceBestLapTenThousandths?: number | null;
  /** False until stewards post this round's incident report — until then the penalty tag next to a driver's name ("1PP", "Warning", ...) is hidden so it can't spoil the unposted report. Defaults to true. */
  showPenaltyTags?: boolean;
}

const {
  raceNumber,
  rows,
  showClass = false,
  classNameById,
  penalties = [],
  teamPointsByRaceDriver,
  incidentLimit = null,
  incidentLimitExceededDriverIds = new Set(),
  layoutCorners = null,
  driverBestLapsAtTrack,
  raceBestLapTenThousandths = null,
  showPenaltyTags = true,
} = Astro.props;

/** Margins to the leader are shown with a leading "+" ("+1.234"); the "-1L" laps-down flag and the leader's "—" stay as they are. */
function displayMargin(margin: string): string {
  return /^\d/.test(margin) ? `+${margin}` : margin;
}

// By scoringRaceNumber, so qualifying/practice penalties (stored as race 0) show on race 1, where they score.
const racePenalties = penalties.filter((p) => scoringRaceNumber(p) === raceNumber);
// A Racing Incident entry (driver_id null) can't be attached to any
// driver's row here — it has no driver — so it's simply excluded from this
// map; it still shows up on the Incident Report page.
const penaltiesByDriver = new Map<string, Penalty[]>();
for (const p of racePenalties) {
  if (!p.driver_id) continue;
  if (!penaltiesByDriver.has(p.driver_id)) penaltiesByDriver.set(p.driver_id, []);
  penaltiesByDriver.get(p.driver_id)!.push(p);
}
---

<div class="mt-6">
  <div class="mt-2 rounded-xl border border-white/10" data-sticky-thead>
    <table class="w-full border-collapse">
      <thead>
        <tr class="border-b border-white/10 text-left text-xs uppercase tracking-wide text-white/40">
          <th class="py-3 pl-4 pr-2 font-medium">Pos</th>
          <th class="py-3 pr-3 font-medium">Driver / Number</th>
          {showClass && <th class="hidden py-3 pr-3 font-medium sm:table-cell">Class</th>}
          <th class="hidden py-3 pr-3 text-center font-medium md:table-cell">Margin</th>
          <th class="hidden py-3 pr-3 text-center font-medium sm:table-cell">Start</th>
          <th class="hidden py-3 pr-3 text-center font-medium sm:table-cell">Incidents</th>
          <th class="hidden py-3 pr-3 text-center font-medium md:table-cell">Laps</th>
          <th class="hidden py-3 pr-3 text-center font-medium lg:table-cell">Led</th>
          <th class="hidden py-3 pr-3 text-center font-medium lg:table-cell">Best</th>
          <th class="py-3 pr-4 text-center font-medium">Class Pts</th>
        </tr>
      </thead>
      <tbody>
        {rows.map((row) => {
          const rowPenalties = penaltiesByDriver.get(row.driver.id) ?? [];
          const tagLabel = showPenaltyTags ? penaltyTagLabel(rowPenalties) : '';
          const isRaceBestLap = raceBestLapTenThousandths !== null && row.bestLapTenThousandths !== null && row.bestLapTenThousandths === raceBestLapTenThousandths;
          // Everything but no tag and a bare "Racing Incident" counts as a real penalty (the label no longer
          // starts with "Penalty").
          const isRealPenalty = tagLabel !== '' && tagLabel !== 'Racing Incident';
          // Total effective time penalty, already included in the overall race time (applyPenaltyDisplay) and
          // itemized here; includes qualifying/practice penalties scored on this race.
          const timePenalty = rowPenalties.reduce((sum, p) => sum + (effectiveTimePenaltySeconds(p) ?? 0), 0);
          const bonusLines = bonusPointsLines(row);
          // Did this race's best lap beat the driver's best at this track from any earlier round? No
          // entry (no prior lap, or the lookup failed) hides the marker.
          const priorBestAtTrack = driverBestLapsAtTrack?.get(row.driver.id) ?? null;
          const beatPersonalBest =
            row.bestLapTenThousandths !== null && priorBestAtTrack !== null && row.bestLapTenThousandths < priorBestAtTrack;
          // Corners navigated ÷ incidents for this race (the season stat is getSeasonDriverExtendedStats);
          // null without a corner count, a lap count or any incidents.
          const cornersPerIncident =
            layoutCorners !== null && row.laps !== null && row.incidents !== null && row.incidents > 0
              ? (row.laps * layoutCorners) / row.incidents
              : null;
          return (
          <>
          <tr
            data-expand-row
            tabindex="0"
            role="button"
            aria-expanded="false"
            class={`cursor-pointer border-b border-white/5 text-sm transition hover:bg-white/[0.03] ${row.dsq || row.notInRoster ? 'opacity-50' : ''}`}
          >
            <td class="py-2.5 pl-4 pr-2 font-display text-lg leading-none text-white/70">
              <div class="flex h-8 flex-col items-start justify-center">
                <div class={row.penaltyOldPosition !== null ? 'text-white/40 line-through' : ''}>
                  {row.dsq ? 'DSQ' : (row.penaltyOldPosition ?? row.position)}
                  {row.wasAdjusted && row.penaltyOldPosition === null && (
                    <sup class="ml-0.5 text-[10px] font-sans text-brand-pink" title={`Finished ${row.finishPosition}, adjusted for a penalty`}>
                      *
                    </sup>
                  )}
                  {row.aggressionBonusWon && (
                    <sup class="ml-0.5 text-[10px] font-sans text-brand-primary" title="Naked Aggression bonus — most net positions gained this race">
                      A
                    </sup>
                  )}
                  {row.sprintSweepWon && (
                    <sup class="ml-0.5 text-[10px] font-sans text-brand-primary" title="Sprint Sweep bonus — won every sprint race this round">
                      SS
                    </sup>
                  )}
                </div>
                {row.penaltyOldPosition !== null && (
                  <div class={`text-[10px] font-sans font-semibold ${positionChangeClass(row)}`} title="Position after this round's penalties">
                    {row.position}
                  </div>
                )}
              </div>
            </td>
            <td class="py-2.5 pr-3 font-semibold">
              <div class="flex flex-wrap items-center gap-2">
                <span
                  data-chevron
                  class="inline-block shrink-0 text-[9px] text-white/30 transition-transform duration-150"
                  aria-hidden="true"
                >
                  &#9654;
                </span>
                {/* Full name at sm+, "F. Lastname" below, where the column is narrow. */}
                <span class="hidden sm:inline">
                  <DriverLink id={row.driver.id}>{displayDriverName(row.driver.name)}</DriverLink> {row.driver.car_number !== null && <span class="text-white/40">#{row.driver.car_number}</span>}
                </span>
                <span class="sm:hidden">
                  <DriverLink id={row.driver.id}>{shortDriverName(row.driver.name)}</DriverLink> {row.driver.car_number !== null && <span class="text-white/40">#{row.driver.car_number}</span>}
                </span>
                {/* Hidden on mobile (Logan); `sm:contents` keeps each tag its own flex item for the row's
                   gap. */}
                {/* Tags, then flag / car / team logo in fixed-width slots at the right edge, so they line
                   up row to row even when one is missing. Hidden on mobile. */}
                <span class="ml-auto hidden items-center gap-2 sm:flex">
                    {row.tags.length > 0 && (
                    <span class="contents">
                      {row.tags.map((tag) => (
                        <span
                          class="rounded bg-white/10 px-1.5 py-0.5 text-[10px] font-semibold uppercase tracking-wide text-white/50"
                          title={tag === 'Unclassified' ? 'Not classified. Completed less than 50% of race distance. No points scored.' : undefined}
                        >
                          {tag === 'Unclassified' ? 'NC' : tag}
                        </span>
                      ))}
                    </span>
                  )}
                  {tagLabel && (
                    <span class="contents">
                      <span
                        class={isRealPenalty
                          ? 'rounded bg-brand-gold/15 px-1.5 py-0.5 text-[10px] font-semibold uppercase tracking-wide text-brand-gold'
                          : 'rounded bg-white/10 px-1.5 py-0.5 text-[10px] font-semibold uppercase tracking-wide text-white/50'}
                        title="See the Incident Report for full details"
                      >
                        {tagLabel}
                      </span>
                    </span>
                  )}
                  <span class="flex h-5 w-6 flex-none items-center justify-center">
                    <DriverFlag nationality1={row.driver.nationality_1} nationality2={row.driver.nationality_2} />
                  </span>
                  {/* Car first, team second — every driver has a car, not every driver has a team. */}
                  <span class="flex h-5 w-5 flex-none items-center justify-center">
                    {row.car && <TeamLogo name={row.car.name} logoUrl={row.car.logoUrl} size="h-5 w-5" tint />}
                  </span>
                  <span class="flex h-5 w-5 flex-none items-center justify-center">
                    {row.team && <TeamLogo name={row.team.name} logoUrl={row.team.logoUrl} size="h-5 w-5" />}
                  </span>
                </span>
              </div>
            </td>
            {showClass && (
              <td class="hidden py-2.5 pr-3 sm:table-cell">
                <span class={classTagFull(classNameById?.get(row.classId) ?? '')}>
                  {classNameById?.get(row.classId) ?? '—'}
                </span>
              </td>
            )}
            <td class="hidden py-2.5 pr-3 text-center text-white/60 md:table-cell">{displayMargin(row.margin)}</td>
            <td class="hidden py-2.5 pr-3 text-center text-white/60 sm:table-cell">
              {/* The "P" badge is positioned off a wrapper around the number, so the number stays centred
                 whether or not a badge shows (same for the Incidents badges). */}
              <span class="relative inline-block">
                {row.startingPosition ?? '—'}
                {row.polePosition && (
                  <sup class="absolute left-full top-0 ml-0.5 text-[10px] font-sans text-brand-primary" title="Pole position">P</sup>
                )}
              </span>
            </td>
            <td
              class="hidden py-2.5 pr-3 text-center text-white/60 sm:table-cell"
              title={cornersPerIncident !== null ? `${cornersPerIncident.toFixed(1)} corners per incident` : undefined}
            >
              <span class="relative inline-block">
                {row.incidents ?? '—'}
                <span class="absolute left-full top-0 ml-0.5 inline-flex items-start gap-0.5">
                  {row.incidentsBonus && (
                    <sup class="text-[10px] font-sans text-brand-primary" title="3 incidents or less bonus">I</sup>
                  )}
                  {row.fewestIncidentsBonus > 0 && (
                    <sup class="text-[10px] font-sans text-brand-primary" title="Fewest Incidents bonus">FI</sup>
                  )}
                  {incidentLimitExceededDriverIds.has(row.driver.id) && (
                    <sup
                      class="text-[10px] font-sans text-brand-pink"
                      title={`Exceeded this race's incident limit${incidentLimit !== null ? ` (${incidentLimit})` : ''}`}
                    >
                      !
                    </sup>
                  )}
                </span>
              </span>
            </td>
            <td class="hidden py-2.5 pr-3 text-center text-white/60 md:table-cell">{row.laps ?? '—'}</td>
            <td class="hidden py-2.5 pr-3 text-center text-white/60 lg:table-cell">
              {row.lapsLed ?? 0}
              {row.lapLedWon && (
                <sup class="ml-0.5 text-[10px] font-sans text-brand-primary" title="Lap Led bonus — led at least one lap">LL</sup>
              )}
            </td>
            <td
              class={`hidden py-2.5 pr-3 text-center lg:table-cell ${isRaceBestLap ? 'font-semibold text-brand-primary' : 'text-white/60'}`}
              title={`Avg lap: ${row.averageLapFormatted}`}
            >
              {row.bestLapFormatted}
              {row.fastestLapWon && (
                <sup class="ml-0.5 text-[10px] font-sans text-brand-primary" title="Fastest Lap bonus">FL</sup>
              )}
            </td>
            <td class="py-2.5 pr-4 text-center font-semibold">{row.notInRoster ? '—' : row.totalPoints}</td>
          </tr>
          <tr data-detail-row class="hidden border-b border-white/5 bg-white/[0.02] text-xs">
            <td colspan={showClass ? 10 : 9} class="px-4 py-4 sm:pl-11">
              <div class="grid grid-cols-1 gap-x-8 gap-y-4 sm:grid-cols-2">
                <div>
                  <div class="text-[10px] uppercase tracking-wide text-white/30">Timings</div>
                  <table class="mt-1 w-full max-w-xs">
                    <tbody>
                      <tr class="border-b border-white/5">
                        <td class="py-1 text-white/50">Best Lap</td>
                        <td class="py-1 text-right text-white/90">
                          {beatPersonalBest && (
                            <sup class="mr-0.5 text-[10px] font-sans text-brand-primary" title="New personal best at this track">
                              PB
                            </sup>
                          )}
                          {row.bestLapFormatted}
                        </td>
                      </tr>
                      <tr class="border-b border-white/5">
                        <td class="py-1 text-white/50">Average Lap</td>
                        <td class="py-1 text-right text-white/90">{row.averageLapFormatted}</td>
                      </tr>
                      <tr class={timePenalty !== 0 ? 'border-b border-white/5' : ''}>
                        <td class="py-1 text-white/50">Race Time</td>
                        <td class="py-1 text-right text-white/90">{row.overallRaceTimeFormatted}</td>
                      </tr>
                      {timePenalty !== 0 && (
                        <tr>
                          <td class="py-1 text-white/50">Time Penalty</td>
                          <td class="py-1 text-right font-semibold text-brand-pink">+{timePenalty}s</td>
                        </tr>
                      )}
                    </tbody>
                  </table>
                </div>
                <div>
                  <div class="text-[10px] uppercase tracking-wide text-white/30">Points Breakdown</div>
                  {row.notInRoster ? (
                    // No roster entry, so no scored row and no breakdown; "Sync Results with Roster" (admin
                    // Drivers) adds them for the next rescore.
                    <p class="mt-1 text-white/40">
                      Not scored — this driver isn't on the roster yet, so no points were calculated for this result.
                    </p>
                  ) : (
                    <table class="mt-1 w-full max-w-xs">
                      <tbody>
                        <tr class="border-b border-white/5">
                          <td class="py-1 text-white/50">Base Points</td>
                          <td class="py-1 text-right font-semibold text-white/90">{finishPoints(row)}</td>
                        </tr>
                        {bonusLines.map((line) => (
                          <tr class="border-b border-white/5">
                            <td class="py-1 text-white/50">{line.label}</td>
                            <td class="py-1 text-right font-semibold text-white/90">
                              {line.value > 0 ? '+' : ''}
                              {line.value}
                            </td>
                          </tr>
                        ))}
                        {row.pointsDeduction !== 0 && (
                          <tr class="border-b border-white/5">
                            <td class="py-1 text-white/50">Points Deduction</td>
                            <td class="py-1 text-right font-semibold text-brand-pink">{row.pointsDeduction}</td>
                          </tr>
                        )}
                        {penaltyPointsDelta(row) !== 0 && (
                          <tr class="border-b border-white/5">
                            <td class="py-1 text-white/50">Penalty Adjustment</td>
                            <td class={`py-1 text-right font-semibold ${penaltyPointsDelta(row) > 0 ? 'text-brand-blue' : 'text-brand-pink'}`}>
                              {penaltyPointsDelta(row) > 0 ? '+' : ''}
                              {penaltyPointsDelta(row)}
                            </td>
                          </tr>
                        )}
                        <tr class="border-b border-white/5">
                          <td class="py-1 text-white/50">Class Point Total</td>
                          <td class="py-1 text-right font-semibold text-white/90">{row.totalPoints}</td>
                        </tr>
                        <tr>
                          <td class="py-1 text-white/50">Team Points</td>
                          <td class="py-1 text-right font-semibold text-white/90">
                            {row.team ? (teamPointsByRaceDriver?.get(`${raceNumber}:${row.driver.id}`) ?? 0) : '—'}
                          </td>
                        </tr>
                      </tbody>
                    </table>
                  )}
                </div>
              </div>
            </td>
          </tr>
          </>
          );
        })}
      </tbody>
    </table>
  </div>
</div>
