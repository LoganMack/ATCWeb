---
// One race's results table — shared by both the overall (cross-class) and
// per-class views on /results/[subsessionId]. Column order is fixed:
// Pos, Driver / Number, (Class, overall view only), Margin, Start,
// Incidents, Laps, Points. There's deliberately no separate "badges" column
// anymore — pole and the post-penalty adjustment flag are shown as small
// inline markers on Start/Pos instead, and a DNF-style reason is shown
// next to the driver's name, so the table stays to exactly these columns.
import { iracingResultsUrl, type RaceResultRow } from '../lib/results';
import type { RaceLinks } from '../lib/supabase';
import { classBadgeClasses } from '../lib/classColors';

/** e.g. "+4 class · -2 bonus" — omits either half when it's 0, and the whole line when both are. */
function pointsBreakdown(row: RaceResultRow): string | null {
  const parts: string[] = [];
  if (row.classPoints !== 0) parts.push(`${row.classPoints > 0 ? '+' : ''}${row.classPoints} class`);
  if (row.bonusPoints !== 0) parts.push(`${row.bonusPoints > 0 ? '+' : ''}${row.bonusPoints} bonus`);
  return parts.length > 0 ? parts.join(' · ') : null;
}

interface Props {
  subsessionId: number;
  raceNumber: number;
  rows: RaceResultRow[];
  showClass?: boolean;
  classNameById?: Map<number, string>;
  links?: RaceLinks | null;
  isAdmin?: boolean;
}

const { subsessionId, raceNumber, rows, showClass = false, classNameById, links, isAdmin = false } = Astro.props;

const hasAnyLink = links && (links.iracing_subsession_id || links.replay_url || links.broadcast_url);
---

<div class="mt-6">
  <div class="flex flex-wrap items-center justify-between gap-2">
    <h3 class="text-xs font-semibold uppercase tracking-widest text-white/40">Race {raceNumber}</h3>

    {(hasAnyLink || isAdmin) && (
      <div class="flex flex-wrap items-center gap-2">
        {links?.iracing_subsession_id && (
          <a
            href={iracingResultsUrl(links.iracing_subsession_id)}
            target="_blank"
            rel="noopener noreferrer"
            class="rounded-full bg-white/5 px-3 py-1 text-[11px] font-semibold text-white/70 ring-1 ring-white/10 transition hover:bg-white/10"
          >
            iRacing Results
          </a>
        )}
        {links?.replay_url && (
          <a
            href={links.replay_url}
            target="_blank"
            rel="noopener noreferrer"
            class="rounded-full bg-white/5 px-3 py-1 text-[11px] font-semibold text-white/70 ring-1 ring-white/10 transition hover:bg-white/10"
          >
            Download Replay
          </a>
        )}
        {links?.broadcast_url && (
          <a
            href={links.broadcast_url}
            target="_blank"
            rel="noopener noreferrer"
            class="rounded-full bg-white/5 px-3 py-1 text-[11px] font-semibold text-white/70 ring-1 ring-white/10 transition hover:bg-white/10"
          >
            Watch Broadcast
          </a>
        )}

        {isAdmin && (
          <details class="relative">
            <summary class="cursor-pointer list-none rounded-full bg-white/5 px-3 py-1 text-[11px] font-semibold text-white/50 ring-1 ring-white/10 transition hover:bg-white/10">
              Edit links
            </summary>
            <form
              method="POST"
              data-astro-reload
              class="absolute right-0 z-10 mt-2 flex w-64 flex-col gap-2 rounded-xl border border-white/10 bg-brand-ink p-4 shadow-xl"
            >
              <input type="hidden" name="intent" value="save-race-links" />
              <input type="hidden" name="subsession_id" value={subsessionId} />
              <input type="hidden" name="race_number" value={raceNumber} />
              <label class="flex flex-col gap-1 text-[11px] text-white/50">
                iRacing subsession ID
                <input
                  type="number"
                  name="iracing_subsession_id"
                  value={links?.iracing_subsession_id ?? ''}
                  class="rounded-lg border border-white/15 bg-white/5 px-2 py-1.5 text-xs text-white outline-none focus:border-brand-primary"
                />
              </label>
              <label class="flex flex-col gap-1 text-[11px] text-white/50">
                Replay download URL
                <input
                  type="url"
                  name="replay_url"
                  value={links?.replay_url ?? ''}
                  class="rounded-lg border border-white/15 bg-white/5 px-2 py-1.5 text-xs text-white outline-none focus:border-brand-primary"
                />
              </label>
              <label class="flex flex-col gap-1 text-[11px] text-white/50">
                Broadcast video URL
                <input
                  type="url"
                  name="broadcast_url"
                  value={links?.broadcast_url ?? ''}
                  class="rounded-lg border border-white/15 bg-white/5 px-2 py-1.5 text-xs text-white outline-none focus:border-brand-primary"
                />
              </label>
              <button
                type="submit"
                class="mt-1 rounded-full bg-brand-primary px-3 py-1.5 text-xs font-semibold transition hover:brightness-110"
              >
                Save
              </button>
            </form>
          </details>
        )}
      </div>
    )}
  </div>

  <div class="mt-2 overflow-x-auto rounded-2xl border border-white/10">
    <table class="w-full border-collapse">
      <thead>
        <tr class="border-b border-white/10 text-left text-xs uppercase tracking-wide text-white/40">
          <th class="py-3 pl-4 pr-2 font-medium">Pos</th>
          <th class="py-3 pr-3 font-medium">Driver / Number</th>
          {showClass && <th class="hidden py-3 pr-3 font-medium sm:table-cell">Class</th>}
          <th class="hidden py-3 pr-3 text-center font-medium md:table-cell">Margin</th>
          <th class="hidden py-3 pr-3 text-center font-medium sm:table-cell">Start</th>
          <th class="hidden py-3 pr-3 text-center font-medium sm:table-cell">Incidents</th>
          <th class="hidden py-3 pr-3 text-center font-medium md:table-cell">Laps</th>
          <th class="py-3 pr-4 text-center font-medium">Points</th>
        </tr>
      </thead>
      <tbody>
        {rows.map((row) => (
          <tr class={`border-b border-white/5 text-sm ${row.dsq ? 'opacity-50' : ''}`}>
            <td class="py-2.5 pl-4 pr-2 font-display text-lg leading-none text-white/70">
              {row.dsq ? 'DSQ' : row.position}
              {row.wasAdjusted && (
                <sup class="ml-0.5 text-[10px] font-sans text-brand-pink" title={`Finished ${row.finishPosition}, adjusted for a penalty`}>
                  *
                </sup>
              )}
            </td>
            <td class="py-2.5 pr-3 font-semibold">
              {row.driver.name} {row.driver.car_number !== null && <span class="text-white/40">#{row.driver.car_number}</span>}
              {row.reasonOut && row.reasonOut !== 'Running' && (
                <span class="ml-2 rounded bg-white/10 px-1.5 py-0.5 text-[10px] font-semibold uppercase tracking-wide text-white/50">
                  {row.reasonOut}
                </span>
              )}
            </td>
            {showClass && (
              <td class="hidden py-2.5 pr-3 sm:table-cell">
                <span class={`rounded-full border px-2 py-0.5 text-[11px] font-semibold uppercase tracking-wide ${classBadgeClasses(classNameById?.get(row.classId) ?? '')}`}>
                  {classNameById?.get(row.classId) ?? '—'}
                </span>
              </td>
            )}
            <td class="hidden py-2.5 pr-3 text-center text-white/60 md:table-cell">{row.margin}</td>
            <td class="hidden py-2.5 pr-3 text-center text-white/60 sm:table-cell">
              {row.startingPosition ?? '—'}
              {row.polePosition && (
                <sup class="ml-0.5 text-[10px] font-sans text-brand-gold" title="Pole position">P</sup>
              )}
            </td>
            <td class="hidden py-2.5 pr-3 text-center text-white/60 sm:table-cell">{row.incidents ?? '—'}</td>
            <td class="hidden py-2.5 pr-3 text-center text-white/60 md:table-cell">
              <div>{row.laps ?? '—'}</div>
              {row.lapsLed !== null && row.lapsLed > 0 && (
                <div class="text-[10px] text-white/30">{row.lapsLed} led</div>
              )}
            </td>
            <td class="py-2.5 pr-4 text-center">
              <div class="font-semibold">{row.totalPoints}</div>
              {pointsBreakdown(row) && <div class="text-[10px] text-white/30">{pointsBreakdown(row)}</div>}
            </td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
</div>
