---
// One race's results table — shared by both the overall (cross-class) and
// per-class views on /results/[subsessionId]. Column order is fixed:
// Pos, Driver / Number, (Class, overall view only), Margin, Start,
// Incidents, Laps, Class Points. There's deliberately no separate "badges"
// column anymore — pole and the post-penalty adjustment flag are shown as
// small inline markers on Start/Pos instead, and result tags (e.g.
// "Unclassified") are shown next to the driver's name, so the table stays
// to exactly these columns.
//
// v0.16: this table is READ-ONLY as far as penalties go — the tag next
// to a driver's name is just a static badge (no add/edit/remove). All of
// that (plus the full incident detail — description, offenses, involved
// cars, appeal result) lives on the dedicated Incident Report page
// (/results/[subsessionId]/incidents), reachable via the button above this
// table on the round page.
//
// v0.22: every row is click-to-expand (see the `[data-expand-row]`/
// `[data-detail-row]` pair below — the actual toggle behavior is the
// shared src/scripts/expandRows.ts, loaded globally in Layout.astro, not
// a script in this component) — clicking a
// driver's row reveals a detail panel with their average/best lap, overall
// race time (rule 18.3.2 — see src/lib/penalties.ts), and an itemized
// points breakdown. That's also why the old Laps-led and combined
// bonus-points subtext lines are gone from the default row (moved into the
// detail panel instead) — rows go back to a single fixed line each
// (`h-8` is now only needed on Pos, for the post-penalty old/new position
// stack).
import { iracingResultsUrl, type RaceResultRow } from '../lib/results';
import type { RaceLinks, Penalty } from '../lib/supabase';
import { displayDriverName } from '../lib/supabase';
import { effectiveTimePenaltySeconds, effectivePointsPenalty, effectivePenaltyPoints } from '../lib/penalties';
import { classBadgeClasses } from '../lib/classColors';
import TeamLogo from './TeamLogo.astro';
import DriverFlag from './DriverFlag.astro';

/** `total_points` minus every bonus/deduction component — the base points this driver earned purely from their overall finishing position (see RaceResultRow.bonusPoints' own doc comment on the total_points formula). Shown as its own line in the expanded detail panel. */
function finishPoints(row: RaceResultRow): number {
  return row.totalPoints - row.bonusPoints;
}

interface BreakdownLine {
  label: string;
  value: number;
}

/** Every nonzero component of this driver's points, itemized, for the expanded detail panel — a "better breakdown" than the old collapsed-row combined bonus figure. Finish points always shown (even 0); everything else only when nonzero. */
function pointsBreakdownLines(row: RaceResultRow): BreakdownLine[] {
  const lines: BreakdownLine[] = [{ label: 'Finish', value: finishPoints(row) }];
  if (row.classPoints !== 0) lines.push({ label: 'Class', value: row.classPoints });
  if (row.finesseBonus !== 0) lines.push({ label: 'Finesse', value: row.finesseBonus });
  if (row.poleBonus !== 0) lines.push({ label: 'Pole', value: row.poleBonus });
  if (row.pointsDeduction !== 0) lines.push({ label: 'Deduction', value: row.pointsDeduction });
  return lines;
}

/** How many total points this round's penalties (this driver's own, or a cascade from someone else's in the same race repositioning them) netted this driver, positive or negative — 0 for a row nothing here ever touched. This is a DELTA, not another component of the breakdown above (those already sum to `totalPoints`, which already has this baked in) — shown as its own callout so a penalized/benefiting driver's net points swing is clear at a glance rather than something you'd have to infer by comparing against a different round. See RaceResultRow.originalTotalPoints' own doc comment. */
function penaltyPointsDelta(row: RaceResultRow): number {
  return row.totalPoints - row.originalTotalPoints;
}

/**
 * "Penalty (1PP)" / "Penalty (Warning)" / "Penalty" / "Racing Incident" —
 * the tag's own label, so the headline is visible without visiting the
 * Incident Report page. Sums effective PP across every penalty logged
 * against this driver in this race; falls back to "(Warning)" only when
 * nothing carries PP but at least one entry is a warning. When a logged
 * entry carries no real effect at all (no PP, no warning, no time/points
 * penalty — e.g. reviewed and cleared, or appealed down to nothing), it
 * reads as "Racing Incident" instead of "Penalty" per Logan.
 *
 * Note this is a DIFFERENT "Racing Incident" than the literal one on the
 * Incident Report page (a penalty entry with no driver_id at all — see
 * 0020_penalty_racing_incident.sql). That kind can never reach this
 * function in the first place: `rowPenalties` only ever holds entries
 * already matched to THIS driver's id (see penaltiesByDriver below), and a
 * driverless entry can't match anyone's id.
 */
function penaltyTagLabel(rowPenalties: Penalty[]): string {
  if (rowPenalties.length === 0) return '';
  const totalPP = rowPenalties.reduce((sum, p) => sum + effectivePenaltyPoints(p), 0);
  if (totalPP > 0) return `Penalty (${totalPP}PP)`;
  if (rowPenalties.some((p) => p.is_warning)) return 'Penalty (Warning)';
  const hasTimeOrPointsEffect = rowPenalties.some(
    (p) => effectiveTimePenaltySeconds(p) !== 0 || effectivePointsPenalty(p) !== 0
  );
  return hasTimeOrPointsEffect ? 'Penalty' : 'Racing Incident';
}

/**
 * Pink when a time penalty (this driver's own, or a cascade from someone
 * else's) dropped them to a numerically worse position; blue when it's the
 * opposite — they benefited from another driver's penalty and moved up.
 * Per Logan: "blue if they actually gained positions due to another's
 * penalty."
 */
function positionChangeClass(row: RaceResultRow): string {
  if (row.penaltyOldPosition === null || row.position === null) return 'text-brand-pink';
  return row.position < row.penaltyOldPosition ? 'text-brand-blue' : 'text-brand-pink';
}

interface Props {
  subsessionId: number;
  raceNumber: number;
  rows: RaceResultRow[];
  showClass?: boolean;
  classNameById?: Map<number, string>;
  links?: RaceLinks | null;
  isAdmin?: boolean;
  /** Every penalty logged anywhere in this round — filtered down to this race below. Passed unfiltered so callers don't need to slice it per race themselves. */
  penalties?: Penalty[];
  /** `${raceNumber}:${driverId}` -> points that driver actually contributed toward their team's total for that race (only the team's top 2 scorers each race count — see results.ts's topTeamScorers()) — computed once at the page level from the round's overall (cross-class) rows, since a driver's team contribution is the same fact whether this table is the Overall or Per Class view. Missing entry (not just 0) means either no team or not one of the top 2 that race. */
  teamPointsByRaceDriver?: Map<string, number>;
}

const {
  subsessionId,
  raceNumber,
  rows,
  showClass = false,
  classNameById,
  links,
  isAdmin = false,
  penalties = [],
  teamPointsByRaceDriver,
} = Astro.props;

const hasAnyLink = links && (links.iracing_subsession_id || links.replay_url || links.broadcast_url || links.photo_album_url);
const racePenalties = penalties.filter((p) => p.race_number === raceNumber);
// A Racing Incident entry (driver_id null) can't be attached to any
// driver's row here — it has no driver — so it's simply excluded from this
// map; it still shows up on the Incident Report page.
const penaltiesByDriver = new Map<string, Penalty[]>();
for (const p of racePenalties) {
  if (!p.driver_id) continue;
  if (!penaltiesByDriver.has(p.driver_id)) penaltiesByDriver.set(p.driver_id, []);
  penaltiesByDriver.get(p.driver_id)!.push(p);
}
---

<div class="mt-6">
  <div class="flex flex-wrap items-center justify-between gap-2">
    <h3 class="text-xs font-semibold uppercase tracking-widest text-white/40">Race {raceNumber}</h3>

    {(hasAnyLink || isAdmin) && (
      <div class="flex flex-wrap items-center gap-2">
        {links?.iracing_subsession_id && (
          <a
            href={iracingResultsUrl(links.iracing_subsession_id)}
            target="_blank"
            rel="noopener noreferrer"
            class="rounded-lg bg-brand-primary px-3 py-1 text-[11px] font-semibold text-white transition hover:brightness-110"
          >
            iRacing Results
          </a>
        )}
        {links?.replay_url && (
          <a
            href={links.replay_url}
            target="_blank"
            rel="noopener noreferrer"
            class="rounded-lg bg-brand-primary px-3 py-1 text-[11px] font-semibold text-white transition hover:brightness-110"
          >
            Download Replay
          </a>
        )}
        {links?.broadcast_url && (
          <a
            href={links.broadcast_url}
            target="_blank"
            rel="noopener noreferrer"
            class="rounded-lg bg-brand-primary px-3 py-1 text-[11px] font-semibold text-white transition hover:brightness-110"
          >
            Watch Broadcast
          </a>
        )}
        {links?.photo_album_url && (
          <a
            href={links.photo_album_url}
            target="_blank"
            rel="noopener noreferrer"
            class="rounded-lg bg-brand-primary px-3 py-1 text-[11px] font-semibold text-white transition hover:brightness-110"
          >
            Photo Album
          </a>
        )}

        {isAdmin && (
          <details class="relative">
            <summary class="cursor-pointer list-none rounded-lg bg-white/5 px-3 py-1 text-[11px] font-semibold text-white/50 ring-1 ring-white/10 transition hover:bg-white/10">
              Edit links
            </summary>
            <form
              method="POST"
              data-astro-reload
              class="absolute right-0 z-10 mt-2 flex w-64 flex-col gap-2 rounded-lg border border-white/10 bg-brand-ink p-4 shadow-xl"
            >
              <input type="hidden" name="intent" value="save-race-links" />
              <input type="hidden" name="subsession_id" value={subsessionId} />
              <input type="hidden" name="race_number" value={raceNumber} />
              <label class="flex flex-col gap-1 text-[11px] text-white/50">
                iRacing subsession ID
                <input
                  type="number"
                  name="iracing_subsession_id"
                  value={links?.iracing_subsession_id ?? ''}
                  class="rounded-md border border-white/15 bg-white/5 px-2 py-1.5 text-xs text-white outline-none focus:border-brand-primary"
                />
              </label>
              <label class="flex flex-col gap-1 text-[11px] text-white/50">
                Replay download URL
                <input
                  type="url"
                  name="replay_url"
                  value={links?.replay_url ?? ''}
                  class="rounded-md border border-white/15 bg-white/5 px-2 py-1.5 text-xs text-white outline-none focus:border-brand-primary"
                />
              </label>
              <label class="flex flex-col gap-1 text-[11px] text-white/50">
                Broadcast video URL
                <input
                  type="url"
                  name="broadcast_url"
                  value={links?.broadcast_url ?? ''}
                  class="rounded-md border border-white/15 bg-white/5 px-2 py-1.5 text-xs text-white outline-none focus:border-brand-primary"
                />
              </label>
              <label class="flex flex-col gap-1 text-[11px] text-white/50">
                Photo album URL
                <input
                  type="url"
                  name="photo_album_url"
                  value={links?.photo_album_url ?? ''}
                  class="rounded-md border border-white/15 bg-white/5 px-2 py-1.5 text-xs text-white outline-none focus:border-brand-primary"
                />
              </label>
              <button
                type="submit"
                class="mt-1 rounded-lg bg-brand-primary px-3 py-1.5 text-xs font-semibold transition hover:brightness-110"
              >
                Save
              </button>
            </form>
          </details>
        )}
      </div>
    )}
  </div>

  <div class="mt-2 overflow-x-auto rounded-xl border border-white/10">
    <table class="w-full border-collapse">
      <thead>
        <tr class="border-b border-white/10 text-left text-xs uppercase tracking-wide text-white/40">
          <th class="py-3 pl-4 pr-2 font-medium">Pos</th>
          <th class="py-3 pr-3 font-medium">Driver / Number</th>
          {showClass && <th class="hidden py-3 pr-3 font-medium sm:table-cell">Class</th>}
          <th class="hidden py-3 pr-3 text-center font-medium md:table-cell">Margin</th>
          <th class="hidden py-3 pr-3 text-center font-medium sm:table-cell">Start</th>
          <th class="hidden py-3 pr-3 text-center font-medium sm:table-cell">Incidents</th>
          <th class="hidden py-3 pr-3 text-center font-medium md:table-cell">Laps</th>
          <th class="py-3 pr-4 text-center font-medium">Class Points</th>
        </tr>
      </thead>
      <tbody>
        {rows.map((row) => {
          const rowPenalties = penaltiesByDriver.get(row.driver.id) ?? [];
          const tagLabel = penaltyTagLabel(rowPenalties);
          const isRealPenalty = tagLabel.startsWith('Penalty');
          const breakdownLines = pointsBreakdownLines(row);
          return (
          <>
          <tr
            data-expand-row
            tabindex="0"
            role="button"
            aria-expanded="false"
            class={`cursor-pointer border-b border-white/5 text-sm transition hover:bg-white/[0.03] ${row.dsq ? 'opacity-50' : ''}`}
          >
            <td class="py-2.5 pl-4 pr-2 font-display text-lg leading-none text-white/70">
              <div class="flex h-8 flex-col items-start justify-center">
                <div class={row.penaltyOldPosition !== null ? 'text-white/40 line-through' : ''}>
                  {row.dsq ? 'DSQ' : (row.penaltyOldPosition ?? row.position)}
                  {row.wasAdjusted && row.penaltyOldPosition === null && (
                    <sup class="ml-0.5 text-[10px] font-sans text-brand-pink" title={`Finished ${row.finishPosition}, adjusted for a penalty`}>
                      *
                    </sup>
                  )}
                </div>
                {row.penaltyOldPosition !== null && (
                  <div class={`text-[10px] font-sans font-semibold ${positionChangeClass(row)}`} title="Position after this round's penalties">
                    {row.position}
                  </div>
                )}
              </div>
            </td>
            <td class="py-2.5 pr-3 font-semibold">
              <div class="flex flex-wrap items-center gap-2">
                <span
                  data-chevron
                  class="inline-block shrink-0 text-[9px] text-white/30 transition-transform duration-150"
                  aria-hidden="true"
                >
                  &#9654;
                </span>
                <span>
                  {displayDriverName(row.driver.name)} {row.driver.car_number !== null && <span class="text-white/40">#{row.driver.car_number}</span>}
                </span>
                <DriverFlag nationality1={row.driver.nationality_1} nationality2={row.driver.nationality_2} />
                {/* Car first, team second — every driver has a car, not every driver has a team. */}
                {row.car && <TeamLogo name={row.car.name} logoUrl={row.car.logoUrl} size="h-5 w-5" />}
                {row.team && <TeamLogo name={row.team.name} logoUrl={row.team.logoUrl} size="h-5 w-5" />}
                {row.tags.map((tag) => (
                  <span class="rounded bg-white/10 px-1.5 py-0.5 text-[10px] font-semibold uppercase tracking-wide text-white/50">
                    {tag}
                  </span>
                ))}
                {tagLabel && (
                  <span
                    class={isRealPenalty
                      ? 'rounded bg-brand-gold/15 px-1.5 py-0.5 text-[10px] font-semibold uppercase tracking-wide text-brand-gold'
                      : 'rounded bg-white/10 px-1.5 py-0.5 text-[10px] font-semibold uppercase tracking-wide text-white/50'}
                    title="See the Incident Report for full details"
                  >
                    {tagLabel}
                  </span>
                )}
              </div>
            </td>
            {showClass && (
              <td class="hidden py-2.5 pr-3 sm:table-cell">
                <span class={`rounded-lg border px-2 py-0.5 text-[11px] font-semibold uppercase tracking-wide ${classBadgeClasses(classNameById?.get(row.classId) ?? '')}`}>
                  {classNameById?.get(row.classId) ?? '—'}
                </span>
              </td>
            )}
            <td class="hidden py-2.5 pr-3 text-center text-white/60 md:table-cell">{row.margin}</td>
            <td class="hidden py-2.5 pr-3 text-center text-white/60 sm:table-cell">
              {row.startingPosition ?? '—'}
              {row.polePosition && (
                <sup class="ml-0.5 text-[10px] font-sans text-brand-gold" title="Pole position">P</sup>
              )}
            </td>
            <td class="hidden py-2.5 pr-3 text-center text-white/60 sm:table-cell">
              {row.incidents ?? '—'}
              {row.incidentsBonus && (
                <sup class="ml-0.5 text-[10px] font-sans text-brand-gold" title="3 incidents or less bonus">I</sup>
              )}
            </td>
            <td class="hidden py-2.5 pr-3 text-center text-white/60 md:table-cell">{row.laps ?? '—'}</td>
            <td class="py-2.5 pr-4 text-center font-semibold">{row.totalPoints}</td>
          </tr>
          <tr data-detail-row class="hidden border-b border-white/5 bg-white/[0.02] text-xs">
            <td colspan={showClass ? 8 : 7} class="px-4 py-4 sm:pl-11">
              <div class="grid grid-cols-2 gap-x-4 gap-y-3 sm:grid-cols-4">
                <div>
                  <div class="text-[10px] uppercase tracking-wide text-white/30">Average Lap</div>
                  <div class="mt-0.5 font-display text-sm text-white/90">{row.averageLapFormatted}</div>
                </div>
                <div>
                  <div class="text-[10px] uppercase tracking-wide text-white/30">Best Lap</div>
                  <div class="mt-0.5 font-display text-sm text-white/90">{row.bestLapFormatted}</div>
                </div>
                <div>
                  <div class="text-[10px] uppercase tracking-wide text-white/30">Overall Race Time</div>
                  <div class="mt-0.5 font-display text-sm text-white/90">{row.overallRaceTimeFormatted}</div>
                </div>
                <div>
                  <div class="text-[10px] uppercase tracking-wide text-white/30">Laps Led</div>
                  <div class="mt-0.5 font-display text-sm text-white/90">{row.lapsLed ?? 0}</div>
                </div>
                {row.team && (
                  <div>
                    <div class="text-[10px] uppercase tracking-wide text-white/30">Team Points</div>
                    <div class="mt-0.5 font-display text-sm text-white/90">
                      {teamPointsByRaceDriver?.get(`${raceNumber}:${row.driver.id}`) ?? 0}
                    </div>
                  </div>
                )}
              </div>
              <div class="mt-4">
                <div class="text-[10px] uppercase tracking-wide text-white/30">Points Breakdown</div>
                <div class="mt-1 flex flex-wrap gap-x-4 gap-y-1 text-white/60">
                  {breakdownLines.map((line) => (
                    <span>
                      {line.label}:{' '}
                      <span class="font-semibold text-white/90">
                        {line.value > 0 && line.label !== 'Finish' ? '+' : ''}
                        {line.value}
                      </span>
                    </span>
                  ))}
                  <span class="text-white/40">
                    Total: <span class="font-semibold text-white/90">{row.totalPoints}</span>
                  </span>
                </div>
                {penaltyPointsDelta(row) !== 0 && (
                  <div class={`mt-1.5 text-[11px] font-semibold ${penaltyPointsDelta(row) > 0 ? 'text-brand-blue' : 'text-brand-pink'}`}>
                    {penaltyPointsDelta(row) > 0 ? '+' : ''}{penaltyPointsDelta(row)} pt{Math.abs(penaltyPointsDelta(row)) === 1 ? '' : 's'} from this round's penalties
                  </div>
                )}
              </div>
            </td>
          </tr>
          </>
          );
        })}
      </tbody>
    </table>
  </div>
</div>
